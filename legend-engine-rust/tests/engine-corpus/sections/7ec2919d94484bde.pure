
Class test::Address
{
  zipCode : String[1];
  name:  String[1];
}

Class test::Street extends test::Address
{
  street: String[1];
}

Class test::City extends test::Address
{
  capital: String[1];
}

function my::test():Any[*]
{
  #{
    test::Address {
      zipCode,
        name,
      ->subType(@test::Street) {
        street
      },
      ->subType(@test::City) {
        name
      }
    }
  }#
}
