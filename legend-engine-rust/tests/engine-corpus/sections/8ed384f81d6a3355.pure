
Service meta::pure::myServiceMulti
{
  pattern: 'url/myUrl/';
  owners:
  [
    'ownerName'
  ];
  documentation: 'this is just for context';
  autoActivateUpdates: true;
  execution: Multi
  {
    query: |model::pure::mapping::modelToModel::test::shared::dest::Product.all()->graphFetchChecked(#{model::pure::mapping::modelToModel::test::shared::dest::Product{name}}#)->serialize(#{model::pure::mapping::modelToModel::test::shared::dest::Product{name}}#);
    key: 'env';
    executions['QA']:
    {
      mapping: meta::myMapping1;
      runtime: test::runtime;
    }
    executions['UAT']:
    {
      mapping: meta::myMapping2;
      runtime: meta::myRuntime;
    }
  }
}
