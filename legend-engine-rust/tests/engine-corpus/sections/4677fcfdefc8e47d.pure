
Service meta::pure::myServiceSingle
{
  pattern: '/url/myUrl/';
  documentation: 'doc';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |demo::Person.all()->project(~[name:p|$p.name]);
    mapping: meta::myMapping;
    runtime: meta::myRuntime;
  }
  testSuites:
  [
    testSuite_1
    (
      my::pkg::MyDataElement;
      test_1 =>
        ExternalFormat
        #{
          contentType: 'application/json';
          data: '[]';
        }#;
    )
  ]
}
