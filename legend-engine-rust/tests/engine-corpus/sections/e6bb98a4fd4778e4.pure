
Database simple::dbInc
(
  Table personTable
  (
    ID INTEGER PRIMARY KEY,
    FIRSTNAME VARCHAR(200),
    LASTNAME VARCHAR(200),
    AGE INTEGER,
    ADDRESSID INTEGER,
    FIRMID INTEGER,
    MANAGERID INTEGER
  )
  Table firmTable
  (
    ID INTEGER PRIMARY KEY,
    LEGALNAME VARCHAR(200),
    ADDRESSID INTEGER,
    CEOID INTEGER
  )
  Filter FirmFilter(firmTable.LEGALNAME = 'myevent')
  Filter FirmFilter(firmTable.ADDRESSID = 1)
)