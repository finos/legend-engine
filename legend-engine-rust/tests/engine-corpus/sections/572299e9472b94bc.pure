
function testfetch6::query(): Any[1]
{
  {|test::Person.all()
    ->graphFetch(#{
      test::Person {
        fullName,
        firm {
          name,
          address {
            name,
            street {
               streetId
            }
          }
        }
      }
    }#, 1)
    ->serialize(#{
      test::Person {
        fullName,
        firm {
          name,
          address {
            name,
            street {
               streetId
            }
          }
        }
      }
    }#)};
}