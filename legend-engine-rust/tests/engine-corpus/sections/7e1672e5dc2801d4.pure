
Mapping test::crossPropertyMappingWithLocalProperties
(
   test::Person[p]: Pure {
      ~src test::Person
      +firmId: Integer[1]: 1,
      name: $src.name
   }
   
   test::Firm[f]: Pure {
      ~src test::Firm
      id: $src.id,
      legalName: $src.legalName
   }

   test::Firm_Person: XStore {
      employer[p, f]: $this.firmId == $that.id,
      employees[f, p]: $this.id == $that.firmId
   }
)
