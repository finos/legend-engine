
function showcase::query(): Any[1]
{
   {|meta::external::store::service::showcase::domain::S_Trade.all()       ->filter(p | $p.s_tradeDetails == '30:100')
       ->graphFetch(#{
           meta::external::store::service::showcase::domain::S_Trade {
               s_tradeId,
               s_traderDetails,
               s_tradeDetails
           }
         }#)       ->serialize(#{
           meta::external::store::service::showcase::domain::S_Trade {
               s_tradeId,
               s_traderDetails,
               s_tradeDetails
           }
        }#)};
}