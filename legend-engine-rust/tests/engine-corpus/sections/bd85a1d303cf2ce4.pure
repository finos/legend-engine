
Mapping test::selfJoinMapping
(
   test::Employee[e]: Pure {
      ~src test::Employee
      id: $src.id,
      managerId: $src.managerId,
      name: $src.name
   }

   test::Employee_Manager: ModelJoin {
      {manager:test::Employee[1], reports:test::Employee[1]|$reports.managerId == $manager.id}
   }
)
