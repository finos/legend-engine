
Class test::Trade{   date : StrictDate[1];   quantity : Float[1];   id : Integer[1];}Class test::B{   z(){   test::Trade.all()       ->groupBy([x|$x.date->adjust(0, DurationUnit.DAYS)],       [ agg(x | $x.quantity, y | $y->sum()), agg(x | $x.id, y | $y->count())],       ['tradeDate','quantity','count'])       ->rowValueDifference(           test::Trade.all()               ->groupBy([x|$x.date->adjust(0, DurationUnit.DAYS)],               [ agg(x | $x.quantity, y | $y->sum()), agg(x | $x.id, y | $y->count())],               ['tradeDate','quantity','count']),           ['tradeDate'],['quantity','count'])   }:meta::pure::tds::TabularDataSet[1];}