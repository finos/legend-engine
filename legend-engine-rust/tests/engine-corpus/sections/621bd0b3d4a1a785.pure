
Database demo::relation::db::EmployeeDB
(
  Table EmployeeTable
  (
    ID         INTEGER PRIMARY KEY,
    FIRST_NAME VARCHAR(100) NOT NULL,
    LAST_NAME  VARCHAR(100) NOT NULL,
    FIRM_ID    INTEGER NOT NULL,
    EMP_TYPE   VARCHAR(20) NOT NULL,
    ACTIVE     BIT NOT NULL,
    HIRE_DATE  TIMESTAMP NOT NULL,
    SALARY     FLOAT,
    STREET     VARCHAR(100) NOT NULL,
    CITY       VARCHAR(100) NOT NULL,
    DEPARTMENT_ID  INTEGER,
    ACTIVE_STATUS  VARCHAR(20)
  )

  Table FirmTable
  (
    ID         INTEGER PRIMARY KEY,
    LEGAL_NAME VARCHAR(100) NOT NULL
  )

  Table DepartmentTable
  (
    ID         INTEGER PRIMARY KEY,
    FIRM_ID    INTEGER NOT NULL,
    NAME       VARCHAR(100) NOT NULL,
    CODE       VARCHAR(20) NOT NULL
  )

  Table PositionTable
  (
    ID         INTEGER PRIMARY KEY,
    ACC_NUM    INTEGER NOT NULL,
    GSN        VARCHAR(20) NOT NULL,
    PRODUCT_ID INTEGER NOT NULL,
    QTY        INTEGER NOT NULL
  )

  Table ProductTable
  (
    ID          INTEGER PRIMARY KEY,
    DESCRIPTION VARCHAR(100) NOT NULL
  )

  Table TemporalEmployeeTable
  (
    milestoning
    (
      processing(PROCESSING_IN = IN_Z, PROCESSING_OUT = OUT_Z)
    )
    ID         INTEGER PRIMARY KEY,
    FIRST_NAME VARCHAR(100) NOT NULL,
    SALARY     FLOAT,
    IN_Z       DATE NOT NULL,
    OUT_Z      DATE NOT NULL
  )

  Table BusinessTemporalEmployeeTable
  (
    milestoning
    (
      business(BUS_FROM = FROM_Z, BUS_THRU = THRU_Z)
    )
    ID         INTEGER PRIMARY KEY,
    FIRST_NAME VARCHAR(100) NOT NULL,
    SALARY     FLOAT,
    FROM_Z     DATE NOT NULL,
    THRU_Z     DATE NOT NULL
  )

  Table TemporalDepartmentTable
  (
    milestoning
    (
      processing(PROCESSING_IN = IN_Z, PROCESSING_OUT = OUT_Z)
    )
    ID          INTEGER PRIMARY KEY,
    NAME        VARCHAR(100) NOT NULL,
    EMPLOYEE_ID INTEGER NOT NULL,
    IN_Z        DATE NOT NULL,
    OUT_Z       DATE NOT NULL
  )

  Join EmployeeFirmJoin(EmployeeTable.FIRM_ID = FirmTable.ID)
  Join PositionProductJoin(PositionTable.PRODUCT_ID = ProductTable.ID)
  Join FirmDepartmentJoin(FirmTable.ID = DepartmentTable.FIRM_ID)
  Join DepartmentEmployeeJoin(DepartmentTable.ID = EmployeeTable.DEPARTMENT_ID)

  Filter FullTimeFilter(EmployeeTable.EMP_TYPE = 'FULL_TIME')
)
