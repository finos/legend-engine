
RelationalDatabaseConnection meta::mySimpleConnection
{
  store: model::firm::Person;
  type: H2;
  specification: LocalH2
  {
    testDataSetupCSV: 'testCSV';
  };
  auth: DefaultH2;
  postProcessors:
  [
    mapper
    {
      mappers:
      [
        table {from: 'a'; to: 'A'; schemaFrom: 'b'; schemaTo: 'B';},
        schema {from: 'c'; to: 'C';}
      ];
    },
    mapper
    {
      mappers:
      [
        schema {from: 'c'; to: 'C';},
        table {from: 'a'; to: 'A'; schemaFrom: 'b'; schemaTo: 'B';}
      ];
    }
  ];
}
