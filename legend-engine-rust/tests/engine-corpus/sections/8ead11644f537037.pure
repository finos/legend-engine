
Service test::Service
{
  pattern: 'url/myUrl/';
  owners: ['ownerName', 'ownerName2'];
  documentation: 'test';
  autoActivateUpdates: true;
  execution: Single
  {
    query: src: test::class[1]|$src.prop1;
    mapping: test::mapping;
    runtime: #{ connections: [ ModelStore: [ id1:       test::connection2, id2: #{
            JsonModelConnection
            {
              class: test::class;
              url: 'my_url';
            }
          }#
        ]
      ];
    }#;
  }
  test: Single
  {
    data: 'moreThanData';
  }
}
