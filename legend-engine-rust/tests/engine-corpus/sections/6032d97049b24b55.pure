
Database my::DB
(
  Table T
  (
    ID INTEGER PRIMARY KEY,
    DOC SEMISTRUCTURED,
    NAME VARCHAR(100)
  )
  View V
  (
    ID: T.ID PRIMARY KEY,
    N: array_size(array_filter(extractFromSemiStructured(T.DOC, 'divisions', 'INTEGER'), d | extractFromSemiStructured($d, 'headcount', 'INTEGER')))
  )
)
