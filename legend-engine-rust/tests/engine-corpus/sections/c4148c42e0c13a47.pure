
Persistence test::TestPersistence
{
  doc: 'This is test documentation.';
  trigger: Manual;
  service: test::Service;
  serviceOutputTargets:
  [
    TDS
    {
      keys:
      [
        foo, bar
      ]
      datasetType: Delta
      {
        actionIndicator: DeleteIndicator
        {
          deleteField: isDeleted;
          deleteValues: ['Y', '1', 'true'];
        }
      }
      deduplication: AnyVersion;
    }
    ->
    Relational
    #{
      table: TableA;
      database: test::Database;
      temporality: None
      {
        auditing: DateTime
        {
          dateTimeName: audit_timestamp;
        }
        updatesHandling: AppendOnly
        {
          appendStrategy: AllowDuplicates;
        }
      }
    }#,
    #/test::example::MyType/prop#
    {
      keys:
      [
        #/test::example::MyType/prop/foo#, #/test::example::MyType/prop/bar#
      ]
      datasetType: Snapshot
      {
        partitioning: None
        {
          emptyDatasetHandling: NoOp;
        }
      }
      deduplication: MaxVersion
      {
        versionField: #/test::example::MyType/prop/version#;
      }
    }
    ->
    Relational
    #{
      table: schemaA.TableB;
      database: test::Database;
      temporality: None
      {
        auditing: None;
        updatesHandling: Overwrite;
      }
    }#
  ];
}
