
Mapping test::hierarchyMapping
(
   test::SpecificEntity[e]: Pure {
      ~src test::SpecificEntity
      id: $src.id,
      name: $src.name
   }
   
   test::Order[o]: Pure {
      ~src test::Order
      entityId: $src.entityId,
      description: $src.description
   }

   test::BaseEntityOrder: ModelJoin {
      {e:test::BaseEntity[1], o:test::Order[1]|$e.id == $o.entityId}
   }
)
