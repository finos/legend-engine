
DataQualityValidation meta::external::dataquality::PersonDataQualityValidation
{
   context: fromDataSpace(meta::external::dataquality::PersonDataSpace, 'Local_Context');
   validationTree: $[
      Person{
        lastName,
        name,
        age,
        addresses{
          addressId
        }
      }
    ]$;
   filter: p: Person[1]|$p.age >= 18;
}