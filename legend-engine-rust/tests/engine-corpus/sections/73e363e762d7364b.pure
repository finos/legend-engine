
DataQualityRelationValidation meta::external::dataquality::testvalidation
{
    query: #>{my::Store.myTable}#->filter(c|$c.name == 'ok');
    validations: [
      {
         name: 'testValidation';
         description: 'test validation';
         assertion: row|$row.name != 'error';
      }
    ];
}