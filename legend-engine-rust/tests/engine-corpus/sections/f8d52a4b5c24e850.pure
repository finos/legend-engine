
function example::testMaxString():Any[0..1]
{
   ['string1', 'string2']->max();
}
function example::testMaxInteger():Any[0..1]
{
   [1,2]->max();
}
function example::testMaxFloat():Any[0..1]
{
   [1.0,2.0]->max();
}
function example::testMaxDate():Any[0..1]
{
   [%1999-01-01,%2000-01-01]->max();
}
