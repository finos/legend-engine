
Database demo::relation::dates::store::TradingDB
(
  Table PRODUCT
  (
    milestoning
    (
      business(BUS_FROM = FROM_Z, BUS_THRU = THRU_Z)
    )
    ID INTEGER PRIMARY KEY,
    NAME VARCHAR(100) NOT NULL,
    FROM_Z DATE PRIMARY KEY,
    THRU_Z DATE NOT NULL
  )

  Table ACCOUNT
  (
    milestoning
    (
      processing(PROCESSING_IN = IN_Z, PROCESSING_OUT = OUT_Z)
    )
    ID INTEGER PRIMARY KEY,
    STATUS VARCHAR(20) NOT NULL,
    IN_Z TIMESTAMP PRIMARY KEY,
    OUT_Z TIMESTAMP NOT NULL
  )

  Table RATING
  (
    milestoning
    (
      processing(PROCESSING_IN = IN_Z, PROCESSING_OUT = OUT_Z),
      business(BUS_FROM = FROM_Z, BUS_THRU = THRU_Z)
    )
    ISSUER VARCHAR(100) PRIMARY KEY,
    GRADE VARCHAR(10) NOT NULL,
    IN_Z TIMESTAMP PRIMARY KEY,
    OUT_Z TIMESTAMP NOT NULL,
    FROM_Z TIMESTAMP PRIMARY KEY,
    THRU_Z TIMESTAMP NOT NULL
  )

  Table TRADE
  (
    ID INTEGER PRIMARY KEY,
    PRODUCT_ID INTEGER NOT NULL,
    ACCOUNT_ID INTEGER NOT NULL,
    TRADE_DATE DATE NOT NULL,
    EXECUTED_AT TIMESTAMP NOT NULL,
    QUANTITY INTEGER NOT NULL
  )

  Join Trade_Product(TRADE.PRODUCT_ID = PRODUCT.ID)
  Join Trade_Account(TRADE.ACCOUNT_ID = ACCOUNT.ID)
)
