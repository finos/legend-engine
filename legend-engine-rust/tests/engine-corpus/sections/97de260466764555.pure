
function showcase::query(): Any[1]
{
   {|meta::external::store::service::showcase::domain::Trade.all()
       ->take(2)       ->graphFetch(#{
           meta::external::store::service::showcase::domain::Trade {
               tradeId,
               quantity,
               trader {
                   kerberos,
                   firstName,
                   lastName
               },
               product {
                   productId,
                   productName,
                   description,
                   synonyms {
                       name,
                       type
                   }
               }
           }
         }#)
       ->serialize(#{
           meta::external::store::service::showcase::domain::Trade {
               tradeId,
               quantity,
               trader {
                   kerberos,
                   firstName,
                   lastName
               },
               product {
                   productId,
                   productName,
                   description,
                   synonyms {
                       name,
                       type
                   }
               }
           }
        }#)};
}