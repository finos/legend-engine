
function showcase::query(): Any[1]
{
   {|meta::external::store::service::showcase::domain::Product.all()       ->graphFetch(#{
           meta::external::store::service::showcase::domain::Product {
               productId,
               productName,
               description
           }
         }#)       ->serialize(#{
           meta::external::store::service::showcase::domain::Product {
               productId,
               productName,
               description
           }
        }#)};
}