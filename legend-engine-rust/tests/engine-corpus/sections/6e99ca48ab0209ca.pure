
Service test::Service
{
  pattern: 'url/myUrl/';
  title: 'my Service';
  owners: ['ownerName'];
  documentation: 'test';
  autoActivateUpdates: true;
  execution: Single
  {
    query: src:    test::class[1]|$src.prop1;
      mapping: test::mapping;
      runtime: test::runtime;
  }
  test: Single
  {
    data: 'test';
    asserts:
    [
      {[list(['param']),'testparameter'],'testexpression'}
    ];
  }
}
