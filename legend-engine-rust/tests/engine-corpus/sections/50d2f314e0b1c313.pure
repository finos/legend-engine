        ModelStore:
        [
          id1: test::connection,
          id2: #{
            JsonModelConnection
            {
              class: test::class2;
              url: 'my_url';
            }
          }#
        ]
      ];
    }#;
  }
  test: Single
  {
    data: 'moreThanData';
    asserts:
    [
    ];
  }
}
