
Service test::Service
{
  pattern: 'url/myUrl/';
  owners: ['ownerName', 'ownerName2'];
  documentation: 'test';
  autoActivateUpdates: true;
  execution: Single
  {
    query: src: test::class[1]|$src.prop1;
    mapping: test::mapping;
    runtime: test::runtime;
  }
  test: Single
  {
    data: 'moreThanData';
    asserts:
    [
      { [], res:   Result<Any|*>[1]|$res.values->cast(@TabularDataSet).rows->size() == 1 }
    ];
  }
}
