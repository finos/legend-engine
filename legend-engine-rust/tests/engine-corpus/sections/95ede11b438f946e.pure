
ServiceStore test::testServiceStoreCompilationWithSingleService
(
  Service TestService
  (
    path : '/testService/{param2}';
    requestBody : test::Person <- test::TestBinding;
    method : POST;
    parameters :
    (
      param1 : String ( location = query, allowReserved = true ),
      param2 : String ( location = path, allowReserved = false )
    );
    response : test::Person <- test::TestBinding;
    security : [];
  )
)
