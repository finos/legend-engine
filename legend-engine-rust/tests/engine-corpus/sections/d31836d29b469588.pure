
Class main::Person
{
  name: String[1];
  firm: main::Firm[1];
}

Class <<temporal.businesstemporal>> main::Firm
{
  name: String[1];
  city: main::City[1];
}

Class <<temporal.bitemporal>> main::City
{
  name: String[1];
}

function main::walkTree(): Any[*]
{
   main::Person.all()->project([x| $x.firm(%2021-11-12).city(%2021-11-13).name], ['City name'])
}
