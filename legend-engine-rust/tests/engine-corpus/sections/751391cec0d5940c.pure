
function showcase::query(): Any[1]
{
   {|meta::external::store::service::showcase::domain::Trade.all()
       ->graphFetch(#{
           meta::external::store::service::showcase::domain::Trade {
               tradeId,
               quantity
           }
         }#)
       ->serialize(#{
           meta::external::store::service::showcase::domain::Trade {
               tradeId,
               quantity
           }
        }#)};
}