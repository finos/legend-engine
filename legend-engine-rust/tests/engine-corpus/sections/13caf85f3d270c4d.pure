
Class <<temporal.bitemporal>> main::Person
{
  name: String[1];
  firm: main::Firm[1];
}

Class <<temporal.bitemporal>> main::Firm
{
  name: String[1];
}

function main::walkTree(): main::Person[*]
{
  main::Person.all(%2020-12-12, %2020-12-13)
}

function main::walkTree1(): main::Person[*]
{
  main::Person.all(%latest, %latest)
}

function main::walkTree2(): main::Person[*]
{
  main::Person.all(%latest, %2020-12-12)
}

function main::walkTree3(): main::Firm[*]
{
  main::Person.all(%2020-12-12, %2020-12-13).firm(%2020-12-12, %2020-12-13)
}
