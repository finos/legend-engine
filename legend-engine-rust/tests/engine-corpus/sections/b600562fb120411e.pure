
function showcase::query(): Any[1]
{
   {|meta::external::store::service::showcase::domain::Firm.all()       ->graphFetch(#{
           meta::external::store::service::showcase::domain::Firm {
               legalName,
               addresses
               {
                   street,
                   city,
                   country
               }
           }
         }#)       ->serialize(#{
           meta::external::store::service::showcase::domain::Firm {
               legalName,
               addresses
               {
                   street,
                   city,
                   country
               }
           }
        }#)};
}