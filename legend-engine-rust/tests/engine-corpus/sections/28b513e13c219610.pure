
Mapping example::UnionOnSubTypeinclude
   (
 example::Firm : Pure
            {
               ~src example::_S_Firm

               legalName        : $src.name,
               employees[personUnion]     : $src.sourceEmployees
            }

   *example::Person[personUnion] : Operation {
      meta::pure::router::operations::union_OperationSetImplementation_1__SetImplementation_MANY_(R,A1,B)
   }
   example::Person[R]  : Pure
   {
      ~src example::_S_Person
      firstName : $src.fullName->substring(0, $src.fullName->indexOf(' '))+' Super',
      lastName : $src.fullName->substring($src.fullName->indexOf(' ') + 1, $src.fullName->length())

   }   example::Person[A1]  : Pure
   {
      ~src example::_S_PersonA
     ~filter $src.fullName  == 'A1 Person'
      firstName : $src.fullName->substring(0, $src.fullName->indexOf(' ')) + $src.aName,
      lastName : $src.fullName->substring($src.fullName->indexOf(' ') + 1, $src.fullName->length())

   }


    example::Person[B]  : Pure
   {
      ~src example::_S_PersonB
      firstName : $src.fullName->substring(0, $src.fullName->indexOf(' ')) + $src.bName,
      lastName : $src.fullName->substring($src.fullName->indexOf(' ') + 1, $src.fullName->length())

   }
)
