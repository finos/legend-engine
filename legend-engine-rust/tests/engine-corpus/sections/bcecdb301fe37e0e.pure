
Service meta::pure::myServiceMulti
{
  pattern: 'url/myUrl/{env}';
  owners:
  [
    'ownerName'
  ];
  documentation: 'this is just for context';
  autoActivateUpdates: true;
  execution: Multi
  {
    query: env: String[1]|model::pure::mapping::modelToModel::test::shared::dest::Product.all()->from(test::executionEnvironment->get($env))->graphFetchChecked(#{model::pure::mapping::modelToModel::test::shared::dest::Product{name}}#)->serialize(#{model::pure::mapping::modelToModel::test::shared::dest::Product{name}}#);
  }
  test: Multi
  {
    tests['QA']:
    {
      data: 'moreData';
      asserts:
      [
        { [], res: Result<Any|*>[1]|$res.values->cast(@TabularDataSet).rows->size() == 1 },
        { [], res: Result<Any|*>[1]|$res.values->cast(@TabularDataSet).rows->size() == 1 }
      ];
    }
    tests['UAT']:
    {
      data: 'moreData';
      asserts:
      [
        { [], res: Result<Any|*>[1]|$res.values->cast(@TabularDataSet).rows->size() == 1 },
        { [], res: Result<Any|*>[1]|$res.values->cast(@TabularDataSet).rows->size() == 1 }
      ];
    }
  }
}

Service meta::pure::myServiceMulti2
{
  pattern: 'url/myUrl/{env}';
  owners:
  [
    'ownerName'
  ];
  documentation: 'this is just for context';
  autoActivateUpdates: true;
  execution: Multi
  {
    query: {env: String[1], data: String[1]|model::pure::mapping::modelToModel::test::shared::dest::Product.all()->from(test::executionEnvironment->getWithRuntime($env, $data))->graphFetchChecked(#{model::pure::mapping::modelToModel::test::shared::dest::Product{name}}#)->serialize(#{model::pure::mapping::modelToModel::test::shared::dest::Product{name}}#)};
  }
}

ExecutionEnvironment test::executionEnvironment
{
  executions:
  [
    UAT:
    {
      mapping: test::myMapping1;
      runtime: test::myRuntime1;
    },
    PROD:
    {
      mapping: test::myMapping2;
      runtime: test::myRuntime2;
    }
  ];
}
