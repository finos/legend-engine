
function showcase::query(): Any[1]
{
   {|meta::external::store::service::showcase::domain::Person.all()       ->graphFetch(#{
           meta::external::store::service::showcase::domain::Person {
               firstName,
               lastName,
               middleName
           }
         }#)       ->serialize(#{
           meta::external::store::service::showcase::domain::Person {
               firstName,
               lastName,
               middleName
           }
        }#)};
}