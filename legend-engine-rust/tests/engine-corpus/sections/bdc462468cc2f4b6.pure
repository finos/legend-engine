
Mapping meta::pure::mapping::modelToModel::test::simple::simpleModelMapping
(
   MappingTests
   [
      test2
      (
         query: |model::domain::Target.all()->graphFetchChecked(#{model::domain::Target{name}}#)->serialize(#{model::domain::Target{name}}#);
         data: [                  <Relational, CSV, z::db, 'default\nPersonTable\nid,lastName\n1,Doe;\n2,Doe2\n\n\n\n'>               ];
         assert: '{"defects":[],"value":{"name":"oneName 99"},"source":{"defects":[],"value":{"oneName":"oneName 99"},"source":{"number":1,"record":"{\"oneName\":\"oneName 99\",\"anotherName\":\"anotherName 17\",\"oneDate\":\"2020-04-13\",\"anotherDate\":\"2020-02-25\",\"oneNumber\":27,\"anotherNumber\":28}"}}}';
      )
   ]
)
