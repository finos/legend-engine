
function showcase::query(): Any[1]
{
   {firstName:String[1], lastName:String[1], id:String[1], designation:String[1]|meta::external::store::service::showcase::domain::Employee.all()
       ->filter(e | $e.firstName == $firstName && $e.lastName == $lastName && $e.designation == $designation && $e.id == $id)
       ->graphFetch(#{
           meta::external::store::service::showcase::domain::Employee {
               firstName,
               lastName,
               kerberos,
               designation,
               id,
               age,
               addresses
               {
                   street,
                   city,
                   country
               }
           }
         }#)       ->serialize(#{
           meta::external::store::service::showcase::domain::Employee {
               firstName,
               lastName,
               kerberos,
               designation,
               id,
               age,
               addresses
               {
                   street,
                   city,
                   country
               }
           }
        }#)};
}