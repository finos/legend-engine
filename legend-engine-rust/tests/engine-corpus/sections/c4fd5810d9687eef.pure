
function xx::myFunc() : Boolean[1] {
   ^Pair<Integer,Integer>(first = 1, second = 5)->project([col(x|$x.first, 'student'), col(x|$x.second, 'score')])
               ->meta::pure::tds::extensions::columnValueDifference(
                       ^Pair<Integer,Integer>(first = 1, second = 6)->project([col(x|$x.first, 'student'), col(x|$x.second, 'score')]),
                       ['student'], ['score']);
   true;
}
