
Class test::Person
{
  fullName: String[1];
}

Class test::Firm
{
  name: String[1];
}

Class test::Address
{
  name: String[1];
}

Association test::Person_Firm
{
  employees: test::Person[*];
  firm: test::Firm[0..1];
}

Association test::Person_Address
{
  persons: test::Person[*];
  address: test::Address[0..1];  
}

Association test::Firm_Address
{
  firms: test::Firm[*];
  address: test::Address[0..1];  
}

