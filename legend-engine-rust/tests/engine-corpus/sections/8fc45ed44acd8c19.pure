
Service meta::pure::myServiceSingle
{
  pattern: 'url/myUrl/';
  owners:
  [
    'ownerName'
  ];
  documentation: 'this is just for context';
  autoActivateUpdates: true;
  execution: Single
  {
    query: p1: String[1]|service_parameters::_NPerson.all()->graphFetch(#{service_parameters::_NPerson{Age,Name}}#)->serialize(#{service_parameters::_NPerson{Age,Name,f1($p1)}}#);
    mapping: meta::myMapping;
    runtime: meta::myRuntime;
  }
  test: Single
  {
    data: 'moreThanData';
    asserts:
    [
      { ['StringParameter', [1, 2, 3], %23:12:8.54, Enum.Reference], res: Result<Any|*>[1]|$res.values->cast(@TabularDataSet).rows->size() == 1 },
      { ['parameter1', %23:12:8.54, true, 440, 13.23, 88, -54, 2.3, [1, 2], %2019-05-24T00:00:00, %2019-05-24], res: Result<Any|*>[1]|$res.values->cast(@TabularDataSet).rows->size() == 1 }
    ];
  }
}
