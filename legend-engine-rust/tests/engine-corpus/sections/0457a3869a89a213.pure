
// Every class reachable through the bound property must be listed, or the compiler
// rejects the mapping ("should be included in modelUnit for binding").
Binding demo::ssb::FirmBinding
{
  contentType: 'application/json';
  modelIncludes: [
    demo::ssb::Firm,
    demo::ssb::Address,
    demo::ssb::Geo
  ];
}
