
function test::fetch(): Any[1]
{
  {names:String[*], firmName:String[1], birthTime:DateTime[0..1]| test::Person.all()
                        ->filter(p:test::Person[1] | $p.fullName->in($names) && $p.firmName == $firmName && $p.birthTime == $birthTime)
                        ->project([x | $x.fullName], ['fullName'])}
}