
Database sample::test
(
  View SomeView
  (
    ~filter someFilter
    ~groupBy (data.SOMETHING.TEST, data.SOMETHING_ELSE.TEST)
    ~distinct
    id: test.prop PRIMARY KEY,
    name: test.prop,
    site_url_namespace: @sites | public.sites.url_namespace,
    prefix: plus('/prefix/t/', @sites | public.sites.url, '/w/', public.repository_url, '/')
  )
)
