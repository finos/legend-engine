
ServiceStore test::testServiceStoreGrammarWithSingleService
(
  Service TestService
  (
    path : '/testService/{param2}';
    requestBody : [ExampleClass <- tests::store::exampleBinding];
    method : POST;
    parameters :
    (
      param1 : String ( location = query ),
      param2 : String ( location = path )
    );
    response : ExampleClass <- tests::store::exampleBinding;
    security : [];
  )
  ServiceGroup TestServices
  (
    path : '/testServices';

    Service NestedService
    (
      path : '/testService';
      method : GET;
      parameters :
      (
        serializationFormat : String ( location = query )
      );
      response : ExampleClass <- tests::store::exampleBinding;
      security : [];
    )
  )
)
