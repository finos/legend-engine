
import anything::*;
import anything::else::*;
Mapping anything::A
(
  *goes[tiec]: Operation
  {
    meta::pure::router::operations::union_OperationSetImplementation_1__SetImplementation_MANY_(tiec,tiec)
  }
)
Mapping meta::pure::mapping::modelToModel::test::simple::simpleModelMapping
(
  include A
  *goes[anything_goes]: Operation
  {
    meta::pure::router::operations::union_OperationSetImplementation_1__SetImplementation_MANY_(anything_goes,tiec)
  }
  goes[cay]: Pure
  {
    ~src goes
    fullName: $src.fullName->substring(0, $src.fullName->indexOf(' ')),
    name: $src->cast(@goes).fullName->substring($src.fullName->indexOf(' ') + 1, $src.fullName->length())
  }

  goes2: EnumerationMapping TargetTradeTypeMapping2
  {
    b: [goes2.b]
  }

  MappingTests
  [
    test2
    (
      query: |goes.all()->graphFetchChecked(#{goes{name}}#)->serialize(#{goes{name}}#);
      data:
      [
        <Object, JSON, goes, '{"oneName":"oneName 2","anotherName":"anotherName 16","oneDate":"2020-02-05","anotherDate":"2020-04-13","oneNumber":24,"anotherNumber":29}'>,
        <Object, XML, goes, '{"oneName":"oneName 2","anotherName":"anotherName 16","oneDate":"2020-02-05","anotherDate":"2020-04-13","oneNumber":24,"anotherNumber":29}'>
      ];
      assert: '{"defects":[],"value":{"name":"oneName 99"},"source":{"defects":[],"value":{"oneName":"oneName 99"},"source":{"number":1,"record":"{\"oneName\":\"oneName 99\",\"anotherName\":\"anotherName 17\",\"oneDate\":\"2020-04-13\",\"anotherDate\":\"2020-02-25\",\"oneNumber\":27,\"anotherNumber\":28}"}}}';
    )
  ])
