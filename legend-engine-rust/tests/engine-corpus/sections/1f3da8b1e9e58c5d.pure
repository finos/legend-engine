
Persistence test::TestPersistence
{
  doc: 'This is test documentation.';
  trigger: Manual;
  service: test::Service;
  serviceOutputTargets:
  [
    TDS
    {
      keys:
      [
        foo, bar
      ]
      datasetType: Delta
      {
        actionIndicator: DeleteIndicator
        {
          deleteField: toBeDeleted;
          deleteValues: ['Yes', 'true'];
        }
      }
      deduplication: MaxVersion
      {
        versionField: version;
      }
    }
    ->
    {
    },
    #/test::example::MyType/prop#
    {
      keys:
      [
        #/test::example::MyType/prop/foo#, #/test::example::MyType/prop/bar#
      ]
      datasetType: Delta
      {
        actionIndicator: DeleteIndicator
        {
          deleteField: #/test::example::MyType/prop/toBeDeleted#;
          deleteValues: ['Yes', 'true'];
        }
      }
      deduplication: MaxVersion
      {
        versionField: #/test::example::MyType/prop/version#;
      }
    }
    ->
    {
    }
  ];
}
