
Service <<meta::pure::profiles::typemodifiers.abstract>> {doc.doc = 'something'} meta::pure::myServiceSingle
{
  pattern: 'url/myUrl/';
  owners:
  [
    'ownerName',
    'ownerName2'
  ];
  ownership: DID { identifier: '12345' };
  documentation: 'this is just for context';
  autoActivateUpdates: true;
  execution: Single
  {
    query: src: meta::transform::tests::Address[1]|$src.a;
    mapping: meta::myMapping;
    runtime: meta::myRuntime;
  }
  test: Single
  {
    data: 'moreThanData';
    asserts:
    [
      { [], res: Result<Any|*>[1]|$res.values->cast(@TabularDataSet).rows->size() == 1 },
      { [], res: Result<Any|*>[1]|$res.values->cast(@TabularDataSet).rows->size() == 1 }
    ];
  }
}

