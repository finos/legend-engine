
Database demo::PersonDB
(
  Table PERSON_TBL
  (
    ID INTEGER PRIMARY KEY,
    FULL_NAME VARCHAR(200),
    AGE INTEGER,
    EMAIL VARCHAR(200),
    SALARY DECIMAL(10, 2),
    DOB DATE
  )
  Table SAMPLE_VAL_TBL
  (
    ID INTEGER PRIMARY KEY,
    STR_COL VARCHAR(200),
    INT_COL INTEGER,
    FLOAT_COL FLOAT,
    DATE_COL DATE,
    BOOL_COL BIT
  )
)

