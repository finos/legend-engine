
DataQualityRelationValidation meta::external::dataquality::testvalidation
{
    query: #>{meta::dataquality::db.personTable}#->select(~FIRSTNAME)->from(meta::dataquality::DataQualityRuntime);
    validations: [
      {
         name: 'nonEmptyDataset';
         description: 'dataset cannot be empty';
         assertion: rel|$rel->assertRelationNotEmpty();
      }
    ];
}