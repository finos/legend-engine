
function testfetch3::query(): Any[1]
{
  {|test::Address.all()
    ->graphFetch(#{
      test::Address {
        name,
        persons {
          fullName
        }
      }
    }#, 1)
    ->serialize(#{
      test::Address {
        name,
        persons {
          fullName
        }
      }
    }#)};
}