
Class <<temporal.businesstemporal>> main::Person
{
  name: String[1];
  firm: main::Firm[1];
}

Class <<temporal.businesstemporal>> main::Firm
{
  name: String[1];
  city: main::City[1];
}

Class <<temporal.businesstemporal>> main::City
{
  name: String[1];
}

function main::walkTree(): String[*]
{
   main::Person.all(%2022-12-12)       ->graphFetch(#{main::Person{firm(%2020-12-12T00:00:00){name,city{name}}}}#)       ->from(main::dummyMapping, main::dummyRuntime)        ->serialize(#{main::Person{firm(%2020-12-12T00:00:00){name,city{name}}}}#)
}
