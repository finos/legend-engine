
Class <<temporal.businesstemporal>> main::Person
{
  name: String[1];
  firm: main::Firm[1];
}

Class <<temporal.businesstemporal>> main::Firm
{
  name: String[1];
}

function main::walkTree(bdate:DateTime[1]): String[*]
{
   main::Person.all($bdate)->graphFetch(#{main::Person{firm{name}}}#)->serialize(#{main::Person{firm{name}}}#)
}
