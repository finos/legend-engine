
Service test::firm::model::myService
{
  pattern: '/showcase/binding';
  title: 'my Service';
  documentation: 'Showcase service with binding';
  autoActivateUpdates: false;
  execution: Single
  {
    query: data: Byte[*]|test::firm::model::Firm->internalize(test::firm::model::TestBinding1, $data)->externalize(test::firm::model::TestBinding1, #{test::firm::model::Firm{name, ranking}}#);
  }
  testSuites:
  [
    testSuite1:
    {
      tests:
      [
        test1:
        {
          parameters:
          [
            data = toBytes('[{"street":"street A"}]')
          ]
          asserts:
          [
            assert1:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"street":"street A"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
