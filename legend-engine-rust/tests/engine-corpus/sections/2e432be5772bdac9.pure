
Mapping test::crossPropertyMappingIncludes
(
   include test::crossPropertyMappingWithLocalProperties
   test::Firm[f]: Pure {
      ~src test::Firm
      name: $src.name,
      addressName: $src.addressName
   }

   *test::Person[p2]: Pure {
      ~src test::Person
      +firmName: String[0..1] : '',
      fullName: $src.fullName,
      addressName: $src.addressName
   }

   test::Person[p3]: Pure {
      ~src test::Person
      fullName: $src.fullName->substring(
        0,
        $src.fullName->indexOf(' ')
      ),
      addressName: $src.addressName
   }
   test::Street[s]: Pure {
       ~src test::Street
       streetId: $src.streetId,
       +address: String[*] : ''
   }
   test::Person_Address: XStore {
      address[p, a]: $this.addressName == $that.name,
      persons[a, p]: $this.name == $that.addressName
   }
)
