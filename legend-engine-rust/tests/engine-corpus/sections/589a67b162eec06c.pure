  title: 'some title';
  description: 'some description';
  diagrams:
  [
    {
      title: 'Diag 1';
      description: 'some information about the context';
      diagram: model::SomeDiag1;
    },
    {
      title: 'Diag 2';
      diagram: model::SomeDiag2;
    }
  ];
  elements:
  [
    model::Class1,
    model::Class2,
