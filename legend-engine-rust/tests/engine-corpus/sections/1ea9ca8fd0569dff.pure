
import meta::*;
Service meta::pure::myServiceSingle
{
  pattern: 'url/myUrl/';
  documentation: 'this is just for context';
  autoActivateUpdates: true;
  execution: Single
  {
    query: src: meta::transform::tests::Address[1]|$src.a;
    mapping: mySimpleMapping;
    runtime: mySimpleRuntime;
  }
  test: Single
  {
    data: 'moreThanData';
    asserts:
    [
      { [], res: Result<Any|*>[1]|$res.values->cast(@TabularDataSet).rows->size() == 1 },
      { [], res: Result<Any|*>[1]|$res.values->cast(@TabularDataSet).rows->size() == 1 }
    ];
  }
}
