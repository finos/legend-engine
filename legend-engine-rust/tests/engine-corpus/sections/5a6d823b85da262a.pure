

Class model::LegalEntity 
{
   name: String[1];
}

Class model::Firm extends model::LegalEntity 
{
   legalName: String[1];
   address: Integer[1];
   employee: model::Person[0..1];
}

Class model::Person 
{
    firstName : String[1];
    lastName : String[1];
    otherNames : String[*];
    age: Integer[1];
}

Class model::OtherFirm extends model::LegalEntity 
{
   legalName: String[1];
   address: Integer[1];
   employee: model::Person[0..1];
}

Association model::Employment
{
    firm : model::Firm[0..1];
    employees : model::Person[*];
}