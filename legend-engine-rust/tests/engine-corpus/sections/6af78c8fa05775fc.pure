
function test::fetch(): String[1]
{
  test::Person.all()
    ->graphFetch(#{
      test::Person {
        fullName,
        firm {
          name,
          estDate
        }
      }
    }#, 1)
    ->serialize(#{
      test::Person {
        fullName,
        firm {
          name,
          estDate
        }
      }
    }#)
}