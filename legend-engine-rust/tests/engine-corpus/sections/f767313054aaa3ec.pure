
function showcase::query(): Any[1]
{
   {productId:String[1]|meta::external::store::service::showcase::domain::S_Product.all()
       ->filter(p | $p.s_productId == $productId)
       ->graphFetch(#{
           meta::external::store::service::showcase::domain::S_Product {
               s_productId,
               s_productName,
               s_description
           }
         }#)
       ->concatenate(meta::external::store::service::showcase::domain::S_Product.all()
         ->filter(p | $p.s_productName == 'product 30' && $p.s_description == 'product 30 description')
         ->graphFetch(#{
             meta::external::store::service::showcase::domain::S_Product {
                   s_productId,
                   s_productName,
                  s_description
             }
           }#)
       )
       ->serialize(#{
           meta::external::store::service::showcase::domain::S_Product {
               s_productId,
               s_productName,
               s_description
           }
        }#)};
}