
Mapping testing::mapping
(
  *testing::Person[testing_Person]: Pure
  {
    ~src testing::other::NPerson
    fullName: $src.firstName + ' ' + $src.lastName
  }

  MappingTests
  [
    test_1
    (
      query: |testing::Person.all()->graphFetchChecked(#{}#)->serialize(#{}#);
      data:
      [
        <Object, JSON, testing::other::NPerson, '{"firstName":"firstName 7","lastName":"lastName 55"}'>
      ];
      assert: '{}';
    )
  ]
)
