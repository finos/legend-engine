
Mapping test::unionModelJoinMapping
(
   test::Person[p1]: Pure {
      ~src test::Person
      name: $src.name
   }
   test::Person[p2]: Pure {
      ~src test::Person
      name: $src.name
   }
   *test::Person: Operation {
      meta::pure::router::operations::union_OperationSetImplementation_1__SetImplementation_MANY_(p1, p2)
   }
   *test::Firm[f]: Pure {
      ~src test::Firm
      legalName: $src.legalName
   }

   test::Firm_Person: ModelJoin {
      {employees:test::Person[1], employer:test::Firm[1]|$employees.name == $employer.legalName}
   }
)
