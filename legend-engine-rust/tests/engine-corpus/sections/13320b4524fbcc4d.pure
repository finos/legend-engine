
Service test::service::FirmService
{
  pattern: '/firm';
  title: 'my Service';
  documentation: 'doc';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |test::model::Firm.all()->project(~[name: f | $f.name]);
    mapping: test::mapping::FirmMapping;
    runtime: test::runtime::FirmRuntime;
  }
  testSuites:
  [
    testSuite_1
    (
      test::data::FirmData;
      test_1 =>
        Relation
        #{
          name
          Alice;
        }#;
    )
  ]
}
