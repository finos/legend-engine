
Class <<temporal.businesstemporal>> main::Person
{
  name: String[1];
  firm: main::Firm[1];
}

Class <<temporal.businesstemporal>> main::Firm
{
  name: String[1];
  city: main::City[1];
}

Class <<temporal.businesstemporal>> main::City
{
  name: String[1];
}

function main::walkTree(): String[*]
{
   main::Person.all(%2022-12-12)->graphFetch(#{main::Person{firmAllVersions{name,city{name}}}}#)->serialize(#{main::Person{firmAllVersions{name,city{name}}}}#)
}
