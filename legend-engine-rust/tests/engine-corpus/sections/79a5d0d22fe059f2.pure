
SchemaSet test::SchemaSet
{
  format: JSON;
  schemas: [ { location: 'test/model/A.json';
               content: '{\n  "$schema": "http:\\/\\/json-schema.org\\/draft-07\\/schema#",\n  "title": "test::model::A",\n  "type": "object",\n  "properties":   {\n    "name":     {\n      "type": "string"\n    },\n    "employed":     {\n      "type": "boolean"\n    },\n    "iq":     {\n      "type": "integer"\n    },\n    "weightKg":     {\n      "type": "number"\n    },\n    "heightM":     {\n      "type": "number"\n    },\n    "dateOfBirth":     {\n      "type": "string",\n      "format": "date"\n    },\n    "timeOfDeath":     {\n      "type": "string",\n      "format": "date-time"\n    }\n  },\n  "required": [\n"name",\n"heightM",\n"dateOfBirth",\n"timeOfDeath"\n  ]\n}\n'; } ];
}

Binding test::Binding
{
  schemaSet: test::SchemaSet;
  contentType: 'application/json';
  modelIncludes: [ test::model::A ];
}
