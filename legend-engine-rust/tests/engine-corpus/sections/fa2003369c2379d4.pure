
RelationalDatabaseConnection meta::mySimpleConnection
{
  store: store::Store;
  type: Snowflake;
  timezone: +3000;
  specification: Snowflake
  {
    name: 'test';
    account: 'account';
    warehouse: 'warehouseName';
    region: 'us-east2';
  };
  auth: SnowflakePublic
  {       publicUserName: 'name';
       privateKeyVaultReference: 'name';
       passPhraseVaultReference: 'name';
  };
}
