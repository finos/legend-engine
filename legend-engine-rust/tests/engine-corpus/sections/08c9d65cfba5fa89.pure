
function showcase::query(): Any[1]
{
   {|meta::external::store::service::showcase::domain::Trade.all()
       ->graphFetch(#{
           meta::external::store::service::showcase::domain::Trade {
               tradeId,
               quantity,
               trader {
                   kerberos,
                   firstName,
                   lastName
               },
               product {
                   productId,
                   productName,
                   description
               }
           }
         }#, 100)
       ->serialize(#{
           meta::external::store::service::showcase::domain::Trade {
               tradeId,
               quantity,
               trader {
                   kerberos,
                   firstName,
                   lastName
               },
               product {
                   productId,
                   productName,
                   description
               }
           }
        }#)};
}