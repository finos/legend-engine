
Database simple::dbInc
(
  Table personTable
  (
    ID INTEGER PRIMARY KEY,
    FIRSTNAME VARCHAR(200),
    LASTNAME VARCHAR(200),
    AGE INTEGER,
    ADDRESSID INTEGER,
    FIRMID INTEGER,
    MANAGERID INTEGER
  )
  Table firmTable
  (
    ID INTEGER PRIMARY KEY,
    LEGALNAME VARCHAR(200),
    ADDRESSID INTEGER,
    CEOID INTEGER
  )
   Table PersonToFirm(PERSONID INT PRIMARY KEY, FIRMID INT PRIMARY KEY)
  Join Firm_Person(firmTable.ID = personTable.FIRMID)
  Join Person_PersonFirm(personTable.ID = PersonToFirm.PERSONID)
  Join Firm_PersonFirm(firmTable.ID = PersonToFirm.FIRMID)
)

