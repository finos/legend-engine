
Mapping test::modelJoinMapping
(
   test::Person[p]: Pure {
      ~src test::Person
      +firmId: Integer[1]: 1,
      name: $src.name
   }
   
   test::Firm[f]: Pure {
      ~src test::Firm
      id: $src.id,
      legalName: $src.legalName
   }

   test::Firm_Person: ModelJoin {
      employer.id == employees.firmId
   }
)
