
DataSpace model::dataSpace
{
  executionContexts:
  [
    {
      name: 'Context 1';
      mapping: model::Mapping;
      defaultRuntime: model::Runtime;
    }
  ];
  defaultExecutionContext: 'Context 1';
  executables:
  [
    {
      id: 1;
