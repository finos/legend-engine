
Mapping demo::OtherwiseEmployeeMapping
(
  demo::otherwise::Firm[firmSet]: Relational
  {
    ~primaryKey
    (
      [demo::store::OtherwiseDB]FirmInfoTable.id
    )
    ~mainTable [demo::store::OtherwiseDB]FirmInfoTable
    legalName: [demo::store::OtherwiseDB]FirmInfoTable.name,
    otherInformation: [demo::store::OtherwiseDB]FirmInfoTable.other
  }

  *demo::otherwise::Employee[employeeSet]: Relational
  {
    ~primaryKey
    (
      [demo::store::OtherwiseDB]EmployeeFirmDenormTable.id
    )
    ~mainTable [demo::store::OtherwiseDB]EmployeeFirmDenormTable
    name: [demo::store::OtherwiseDB]EmployeeFirmDenormTable.name,
    firm
    (
      ~primaryKey
      (
        [demo::store::OtherwiseDB]EmployeeFirmDenormTable.legalName
      )
      legalName: [demo::store::OtherwiseDB]EmployeeFirmDenormTable.legalName
    ) Otherwise ( [firmSet]: [demo::store::OtherwiseDB]@EmployeeFirmJoin )
  }

  testSuites:
  [
    embeddedPathSuite:
    {
      function: |demo::otherwise::Employee.all()->sortBy(x|$x.name)->project([x|$x.name, x|$x.firm.legalName], ['Name', 'Firm']);
      tests:
      [
        satisfiedByEmbeddedColumns:
        {
          data:
          [
            demo::store::OtherwiseDB:
              Reference
              #{
                demo::data::OtherwiseEmployeeData
              }#
          ];
          asserts:
          [
            shouldUseDenormalizedColumn:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Name":"Jane Smith","Firm":"Firm B"},{"Name":"John Doe","Firm":"Firm A"}]';
                  }#;
              }#
          ];
        }
      ];
    },
    otherwisePathSuite:
    {
      function: |demo::otherwise::Employee.all()->sortBy(x|$x.name)->project([x|$x.name, x|$x.firm.otherInformation], ['Name', 'Other']);
      tests:
      [
        fallsBackToJoinedSet:
        {
          data:
          [
            demo::store::OtherwiseDB:
              Reference
              #{
                demo::data::OtherwiseEmployeeData
              }#
          ];
          asserts:
          [
            shouldResolveViaOtherwiseJoin:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Name":"Jane Smith","Other":"Info B"},{"Name":"John Doe","Other":"Info A"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
