
DataQualityRelationComparison meta::dataquality::TestRelationComparison
{
    source: #>{meta::dataquality::db.personTable}#->select(~[FIRSTNAME, SALARY, SCORE, BONUS])->from(meta::dataquality::DataQualityRuntime);
