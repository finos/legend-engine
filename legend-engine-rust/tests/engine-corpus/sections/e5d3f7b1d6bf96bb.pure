
Service test::service::FirmService
{
  pattern: '/firm';
  title: 'my Service';
  documentation: 'doc';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |test::model::Firm.all()->project(~[name: f | $f.name]);
    mapping: test::mapping::FirmMapping;
    runtime: test::runtime::TestRuntime;
  }
  testSuites:
  [
    testSuite_1
    (
      test::store::TestDB:
        Relation
        #{
          default.FIRM_TABLE:
            ID,NAME
            1,Alice;
          default.PERSON_TABLE:
            ID,FIRST_NAME
            10,Zoe;
        }#;
      test_1 =>
        Relation
        #{
          name
          Alice;
        }#;
    )
  ]
}
