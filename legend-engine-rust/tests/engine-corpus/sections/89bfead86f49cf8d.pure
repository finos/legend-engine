
function showcase::query(): Any[1]
{
   {name:String[1]|meta::external::store::service::showcase::domain::Firm.all()       ->filter(p | $p.legalName == $name)       ->graphFetch(#{
           meta::external::store::service::showcase::domain::Firm {
               legalName,
               addresses
               {
                   street,
                   city,
                   country
               }
           }
         }#)       ->serialize(#{
           meta::external::store::service::showcase::domain::Firm {
               legalName,
               addresses
               {
                   street,
                   city,
                   country
               }
           }
        }#)};
}