
Service meta::pure::myServiceSingle
{
  pattern: 'url/myUrl/';
  owners: ['ownerName', 'ownerName2'];
  documentation: 'this is just for context';
  autoActivateUpdates: true;
  execution: Single
  {
    query: p1: String[*]|service_parameters::_NPerson.all()->graphFetch(#{service_parameters::_NPerson{Age,Name}}#)->serialize(#{service_parameters::_NPerson{Age,Name,f1($p1)}}#);
    mapping: meta::myMapping;
    runtime:
    #{
      connections:
      [
        ModelStore:
        [
        ]
      ];
    }#;
  }
  test: Single
  {
    data: 'test';
    asserts:
    [
      {['parameter1', %23:12:8.54, true, 440, 13.23, 88, -54, 2.3, [1, 2], %2019-05-24T00:00:00, %2019-05-24, Enum.Reference],res: meta::pure::mapping::Result[1]|$res.values->toOne()->toString()->equalJsonStrings('{}')}
    ];
  }
}
