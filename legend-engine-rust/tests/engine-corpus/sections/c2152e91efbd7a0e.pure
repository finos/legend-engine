
SchemaSet test::SchemaSet
{
  format: FlatData;
  schemas: [ { content: 'section A: DelimitedWithHeadings\n{\n  scope.untilEof;\n  delimiter: \',\';\n\n  Record\n  {\n    \'alpha beta gamma\': STRING;\n    \'ALPHA BETA GAMMA\': STRING;\n  }\n}'; } ];
}

Binding test::Binding
{
  schemaSet: test::SchemaSet;
  contentType: 'application/x.flatdata';
  modelIncludes: [ test::model::A ];
}
