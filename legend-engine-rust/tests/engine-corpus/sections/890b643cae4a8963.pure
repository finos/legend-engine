

Class model::LegalEntity 
{
   name: String[1];
}

Class model::Firm extends model::LegalEntity 
{
   legalName: String[1];
   address: Integer[1];
   employee: model::Person[0..1];
}

Class model::Person 
{
    firstName : String[1];
    lastName : String[1];
    otherNames : String[*];
    age: Integer[1];
}

Class model::PersonExtended extends model::Person 
{
    firmID : String[1];
}