
Service test::service::FirmService
{
  pattern: '/firm';
  title: 'my Service';
  documentation: 'doc';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |test::model::Firm.all()->project(~[name: f | $f.legalName]);
    mapping: test::mapping::FirmMapping;
    runtime: test::runtime::FirmRuntime;
  }
  testSuites:
  [
    testSuite_1 'Happy path'
    (
      test_1 'first' =>
        ExternalFormat
        #{
          contentType: 'application/json';
          data: '[]';
        }#;
      test_2 'second' =>
        ExternalFormat
        #{
          contentType: 'application/json';
          data: '[]';
        }#;
    )
  ]
}
