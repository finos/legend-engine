
Mapping test::crossPropertyMappingWithLocalProperties
(
test::Firm[f]: Pure {
      ~src test::Firm
      name: $src.name,
      addressName: $src.addressName
   }

*test::Person[p]: Pure {
      ~src test::Person
      +firmName: String[0..1] : '',
      fullName: $src.fullName,
      addressName: $src.addressName
   }

test::Person[p2]: Pure {
      ~src test::Person
      fullName: $src.fullName,
      addressName: $src.addressName
   }

test::Person[p3]: Pure {
      ~src test::Person
      fullName: $src.fullName->substring(
        0,
        $src.fullName->indexOf(' ')
      ),
      addressName: $src.addressName
   }

   test::Firm_Person: XStore {
      employer: $this.firmName == $that.name,
      employees: $this.name == $that.firmName
   }
)
