
Mapping test::modelToModelMapping
(
    *test::changedModel: Pure
{
    ~src test::model
    name: $src.name,
    id: $src.id->parseInteger()
}
  testSuites:
  [
    testSuite1:
    {
      function: |test::changedModel.all()->graphFetch(#{test::changedModel{id,name}}#)->serialize(#{test::changedModel{id,name}}#);
      tests:
      [
        test1:
        {
          data:
          [
            ModelStore: ModelStore
            #{
               test::model:
                Reference 
                #{ 
                  test::data::MyData
                }#
            }#
          ];
        }
      ];
    }
  ]
)