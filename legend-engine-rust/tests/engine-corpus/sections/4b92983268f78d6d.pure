
Service meta::pure::myServiceSingle
{
  pattern: 'url/myUrl/';
  owners:
  [
    'ownerName',
    'ownerName2'
  ];
  documentation: 'this is just for context';
  autoActivateUpdates: true;
  execution: Single
  {
    query: param: String[1]|demo::_NPerson.all()->graphFetch(#{demo::_NPerson{Age,Name}}#)->serialize(#{demo::_NPerson{Age,Name}}#);
    mapping: meta::myMapping;
    runtime: meta::myRuntime;
  }
  testSuites:
  [
    testSuite1:
    {
      data:
      [
        connections:
        [
          connection1:
            ExternalFormat
            #{
              contentType: 'application/x.flatdata';
              data: 'FIRST_NAME,LAST_NAME\nFred,Bloggs\nJane,Doe';
            }#,
          connection2:
            ModelStore
            #{
              my::Person:
                [
                  ^my::Person(
                    givenNames = ['Fred', 'William'],
                    address = ^my::Address(street = 'A Road')
                  )
                ]
            }#
        ]
      ]
      tests:
      [
        test1:
        {
          parameters:
          [
            param = 'value1'
          ]
          asserts:
          [
            assert1:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{Age:12, Name:"dummy"}';
                  }#;
              }#,
            assert2:
              EqualTo
              #{
                expected:
                  'expected result content';
              }#
          ]
        },
        test2:
        {
          parameters:
          [
            param = 'value2'
          ]
          asserts:
          [
            assert1:
              EqualTo
              #{
                expected:
                  'expected result content';
              }#
          ]
        }
      ]
    },
    testSuite2:
    {
      data:
      [
        connections:
        [
          connection1:
            ExternalFormat
            #{
              contentType: 'application/x.flatdata';
              data: 'FIRST_NAME,LAST_NAME\nJohn,Doe\nfirstName,lastName';
            }#,
          connection2:
            ModelStore
            #{
              my::Person:
                [
                  ^my::Person(
                    givenNames = ['John', 'Doe'],
                    address = ^my::Address(street = 'A Street')
                  )
                ]
            }#
        ]
      ]
      tests:
      [
        test1:
        {
          parameters:
          [
            param = 'value1'
          ]
          asserts:
          [
            assert1:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{Age:12, Name:"dummy"}';
                  }#;
              }#,
            assert2:
              EqualTo
              #{
                expected:
                  'expected result content';
              }#
          ]
        },
        test2:
        {
          parameters:
          [
            param = 'value2'
          ]
          asserts:
          [
            assert1:
              EqualTo
              #{
                expected:
                  'expected result content';
              }#
          ]
        }
      ]
    }
  ]
}
