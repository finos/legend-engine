
Class modelA::Firm
{
  name: String[1];
}

Class modelA::Person
[
  [^modelA::Firm(name='Goldman Sachs'), ^modelA::Firm(name='Google')]->filter(t|$t.name == $this.firmName)->isNotEmpty()
]
{
  name: String[1];
  firmName: String[1];
}

Association modelA::Person_Firm
{
  employee: modelA::Person[*];
  employer: modelA::Firm[*];
}
