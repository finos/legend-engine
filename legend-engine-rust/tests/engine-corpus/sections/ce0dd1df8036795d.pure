
Binding demo::externalFormat::flatdata::bloomberg::bulkFiles::binding::BloombergBulkFileBinding
{
  schemaSet: demo::externalFormat::flatdata::bloomberg::singleFile::schemaSet::BloombergBulkFileSchemaSet;
