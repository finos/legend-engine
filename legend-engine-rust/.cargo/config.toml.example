# OPT-IN faster-linker config.
#
# Cargo merges every `.cargo/config.toml` it finds walking up the tree.
# `.cargo/config.toml.example` is checked in for reference; copy it to
# `.cargo/config.local.toml` (gitignored) to actually enable lld.
#
#     cp legend-engine-rust/.cargo/config.toml.example \
#        legend-engine-rust/.cargo/config.local.toml
#
# Prereqs:
#   macOS:   `brew install llvm` (gives /opt/homebrew/opt/llvm/bin/ld64.lld)
#   Linux:   `sudo apt install lld` or distro equivalent
#
# Expected impact: 10-30% off cold link time across the workspace.

[target.aarch64-apple-darwin]
linker = "clang"
rustflags = ["-C", "link-arg=-fuse-ld=/opt/homebrew/opt/llvm/bin/ld64.lld"]

[target.x86_64-apple-darwin]
linker = "clang"
rustflags = ["-C", "link-arg=-fuse-ld=/usr/local/opt/llvm/bin/ld64.lld"]

[target.x86_64-unknown-linux-gnu]
rustflags = ["-C", "link-arg=-fuse-ld=lld"]

[target.aarch64-unknown-linux-gnu]
rustflags = ["-C", "link-arg=-fuse-ld=lld"]
