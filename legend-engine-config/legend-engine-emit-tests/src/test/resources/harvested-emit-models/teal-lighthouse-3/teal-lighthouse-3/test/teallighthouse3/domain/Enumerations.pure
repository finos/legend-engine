###Pure
import meta::pure::profiles::*;

Enum {doc.doc = 'Closed set of access labels a digitised herbarium dataset or column can be published under.'} test::teallighthouse3::domain::AccessLabel
{
  OPEN,
  RESTRICTED,
  EMBARGOED,
  SEALED
}

Enum {doc.doc = 'Small closed set of shapes a dataset declaration can take.'} test::teallighthouse3::domain::SchemaKind
{
  TABULAR,
  HIERARCHICAL,
  RELATION
}

Enum {doc.doc = 'Large closed set of capability variants an environment can enable, spanning both the ingest side and the export side of the digitisation pipeline.'} test::teallighthouse3::domain::CapabilityFlag
{
  INGEST_SHEET_SCAN,
  INGEST_LABEL_TRANSCRIPTION,
  INGEST_GEOREFERENCE_LOOKUP,
  INGEST_TAXON_RECONCILIATION,
  INGEST_DUPLICATE_DETECTION,
  INGEST_BATCH_RESUME,
  INGEST_CHECKSUM_VERIFY,
  INGEST_QUARANTINE_HOLD,
  EXPORT_TABULAR_EXTRACT,
  EXPORT_IMAGE_DERIVATIVE,
  EXPORT_TAXON_TREE,
  EXPORT_OCCURRENCE_FEED,
  EXPORT_LABEL_TRANSCRIPT,
  EXPORT_COLLECTOR_INDEX,
  EXPORT_REDACTED_LOCALITY,
  EXPORT_BULK_ARCHIVE,
  PREVIEW_SHEET_THUMBNAIL,
  PREVIEW_SCHEMA_SAMPLE,
  PREVIEW_VALIDATION_REPORT
}
