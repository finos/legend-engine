###DataSpace
DataSpace test::gildedmeadow2::dataspace::SculptureSurveyDataSpace
{
  executionContexts:
  [
    {
      name: 'survey';
      description: 'Survey environment - the sculpture condition binding served through the survey warehouse.';
      mapping: test::gildedmeadow2::mapping::SculptureSurveyMapping;
      defaultRuntime: test::gildedmeadow2::runtime::SculptureSurveyRuntime;
    }
  ];
  defaultExecutionContext: 'survey';
  title: 'Gilded Meadow 2 Public Sculpture Condition Register';
  description: 'Discovery surface over the public sculpture condition register: the surveys held in the warehouse and the externally shaped intake and note records that arrive against them.';
  elements:
  [
    test::gildedmeadow2::domain::RawSculptureIntake,
    test::gildedmeadow2::domain::RawSurveyNote,
    test::gildedmeadow2::domain::SculptureSurvey
  ];
  executables:
  [
    {
      id: 1;
      title: 'Sculpture Condition Window';
      description: 'The closed-window condition board over the recorded sculpture surveys.';
      executable: test::gildedmeadow2::service::SculptureWindowBoard;
    }
  ];
  supportInfo: Combined
  {
    emails: ['sculpture-survey-desk', 'sculpture-collections-stewards'];
  };
}
