###ExternalFormat
Binding test::gildedmeadow2::external::SculptureIntakeBinding
{
  schemaSet: test::gildedmeadow2::external::SculptureJsonSchemas;
  schemaId: rawSculptureIntake;
  contentType: 'application/json';
  modelIncludes: [
    test::gildedmeadow2::domain::RawSculptureIntake,
    test::gildedmeadow2::domain::RawSurveyNote
  ];
}

SchemaSet test::gildedmeadow2::external::SculptureJsonSchemas
{
  format: JSON;
  schemas: [
    {
      id: rawSculptureIntake;
      location: 'RawSculptureIntake.json';
      content: '{\n  "title": "test::gildedmeadow2::domain::RawSculptureIntake",\n  "type": "object",\n  "required": ["sculptureCode", "sculptureTitle", "materialName"],\n  "properties": {\n    "sculptureCode":  { "type": "string" },\n    "sculptureTitle": { "type": "string" },\n    "materialName":   { "type": "string" }\n  }\n}';
    },
    {
      id: rawSurveyNote;
      location: 'RawSurveyNote.json';
      content: '{\n  "title": "test::gildedmeadow2::domain::RawSurveyNote",\n  "type": "object",\n  "required": ["surveyCode", "noteText"],\n  "properties": {\n    "surveyCode": { "type": "string" },\n    "noteText":   { "type": "string" }\n  }\n}';
    }
  ];
}
