Class {meta::pure::profiles::doc.doc = 'One condition survey recorded against a piece of public sculpture, carrying the grade awarded and the corrosion measured on the day.'} test::gildedmeadow2::domain::SculptureSurvey
{
  surveyCode: String[1];
  sculptureCode: String[1];
  wardCode: String[1];
  surveyedOn: StrictDate[1];
  conditionGrade: String[1];
  corrosionPct: Integer[1];
  notedAt: DateTime[1];
  requiresCleaning: Boolean[1];
}

Class {meta::pure::profiles::doc.doc = 'The externally supplied sculpture intake record, shaped by the published JSON schema rather than by a store.'} test::gildedmeadow2::domain::RawSculptureIntake
{
  sculptureCode: String[1];
  sculptureTitle: String[1];
  materialName: String[1];
}

Class {meta::pure::profiles::doc.doc = 'The externally supplied surveyor note, shaped by the published JSON schema rather than by a store.'} test::gildedmeadow2::domain::RawSurveyNote
{
  surveyCode: String[1];
  noteText: String[1];
}
