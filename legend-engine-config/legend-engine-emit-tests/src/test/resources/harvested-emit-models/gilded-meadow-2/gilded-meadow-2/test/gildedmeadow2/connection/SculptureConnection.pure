###Connection
RelationalDatabaseConnection test::gildedmeadow2::connection::SculptureSurveyConnection
{
  store: test::gildedmeadow2::store::SculptureSurveyDb;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'SCULPTURE_SURVEY_DB';
    account: 'sculpture_survey_account';
    warehouse: 'SCULPTURE_SURVEY_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    accountType: MultiTenant;
    organization: 'sculpture_survey_org';
    quotedIdentifiersIgnoreCase: false;
    enableQueryTags: true;
    role: 'SCULPTURE_SURVEY_READER';
  };
  auth: OAuth
  {
    oauthKey: 'sculpture_survey_oauth';
    scopeName: 'SESSION:ROLE:SCULPTURE_SURVEY_READER';
  };
}
