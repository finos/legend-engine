###Relational
Database test::gildedmeadow2::store::SculptureSurveyDb
(
  Schema SURVEY
  (
    Table SCULPTURE_SURVEY
    (
      SURVEY_CODE VARCHAR(20) PRIMARY KEY,
      SCULPTURE_CODE VARCHAR(20) NOT NULL,
      WARD_CODE VARCHAR(20) NOT NULL,
      SURVEYED_ON DATE NOT NULL,
      CONDITION_GRADE VARCHAR(20) NOT NULL,
      CORROSION_PCT INTEGER NOT NULL,
      NOTED_AT TIMESTAMP NOT NULL,
      REQUIRES_CLEANING BIT NOT NULL
    )
  )
)
