###Service
Service test::emberotter::service::SightingRegister
{
  pattern: '/otter/v1/sightings/{minOtterCount}';
  title: 'Sighting Register';
  documentation: 'Restricts the sighting register with a parameterised reach set, a minimum otter count, a cool-water ceiling and a pup-presence escape arm, then projects the register columns as a flat sorted row set.';
  autoActivateUpdates: true;
  owners:
  [
    'otter-survey',
    'river-stewards'
  ];
  execution: Single
  {
    query: {minOtterCount: Integer[1], reachCodes: String[*]|test::emberotter::domain::OtterSighting.all()->filter(
      s|(($reachCodes->isEmpty()) || ($s.reachCode->in($reachCodes))) && ((($s.otterCount >= $minOtterCount) && ($s.waterTemperatureCelsius <= 12.0)) || ($s.pupPresenceFlag == 'Y'))
    )->project(
      [
        s|$s.recordCode,
        s|$s.reachCode,
        s|$s.observerName,
        s|$s.otterCount,
        s|$s.waterTemperatureCelsius
      ],
      [
        'RecordCode',
        'ReachCode',
        'ObserverName',
        'OtterCount',
        'WaterTemperatureCelsius'
      ]
    )->sort(
      [
        asc('RecordCode')
      ]
    )};
    mapping: test::emberotter::mapping::OtterMapping;
    runtime: test::emberotter::runtime::OtterRuntime;
  }
  testSuites:
  [
    sightingRegisterSuite:
    {
      data:
      [
        connections:
        [
          otterConnection:
            Relational
            #{
              otter.otter_sighting:
                  'sighting_code,reach_code,observer_name,otter_count,water_temp_c,sighted_on,logged_at,pup_flag,holt_code\n'+
                  'OS-001,RE-01,Wren Halloway,3,8.5,2026-02-03,2026-02-03 07:15:00,Y,HO-01\n'+
                  'OS-002,RE-02,Ilse Barrow,1,11.25,2026-02-04,2026-02-04 06:40:00,N,HO-02\n'+
                  'OS-003,RE-02,,,,2026-02-05,2026-02-05 05:55:00,,HO-02\n'+
                  'OS-004,RE-03,Marek Loach,6,9.0,2026-02-06,2026-02-06 08:05:00,Y,HO-03\n'+
                  'OS-005,RE-01,Nell Cobb,2,14.5,2026-02-07,2026-02-07 09:30:00,N,HO-01\n';
              otter.holt_survey:
                  'survey_code,reach_code,observer_name,holt_code,chamber_count,shore_height_m,surveyed_on,substrate_label\n'+
                  'HS-001,RE-01,Wren Halloway,HO-01,3,1.75,2026-01-20,ROOT MAT\n'+
                  'HS-002,RE-02,,HO-02,,0.9,2026-01-21,SHINGLE\n'+
                  'HS-003,RE-03,Marek Loach,HO-03,5,2.25,2026-01-22,SANDY SHORE\n';
            }#
        ]
      ]
      tests:
      [
        boundedReachSet:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            minOtterCount = 3,
            reachCodes = ['RE-01', 'RE-02', 'RE-03']
          ]
          asserts:
          [
            rows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"RecordCode":"OS-001","ReachCode":"RE-01","ObserverName":"Wren Halloway","OtterCount":3,"WaterTemperatureCelsius":8.5},{"RecordCode":"OS-004","ReachCode":"RE-03","ObserverName":"Marek Loach","OtterCount":6,"WaterTemperatureCelsius":9.0}]';
                  }#;
              }#
          ]
        },
        narrowedReachSet:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            minOtterCount = 1,
            reachCodes = ['RE-01']
          ]
          asserts:
          [
            rows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"RecordCode":"OS-001","ReachCode":"RE-01","ObserverName":"Wren Halloway","OtterCount":3,"WaterTemperatureCelsius":8.5}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
