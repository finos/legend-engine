###ExternalFormat
SchemaSet test::emberotter::external::SightingDigestSchema
{
  format: JSON;
  schemas: [
    {
      id: sightingDigest;
      location: 'SightingDigest.json';
      content: '{"title":"test::emberotter::domain::SightingDigest","type":"object","properties":{"recordCode":{"type":"string"},"reachCode":{"type":"string"},"otterCount":{"type":"integer"},"waterTemperatureCelsius":{"type":"number"},"pupPresenceFlag":{"type":"string"}},"required":["recordCode"]}';
    }
  ];
}

Binding test::emberotter::external::SightingDigestJsonBinding
{
  schemaSet: test::emberotter::external::SightingDigestSchema;
  schemaId: sightingDigest;
  contentType: 'application/json';
  modelIncludes: [
    test::emberotter::domain::SightingDigest
  ];
}

