###Connection
RelationalDatabaseConnection test::emberotter::connection::OtterConnection
{
  store: test::emberotter::store::OtterDB;
  type: Snowflake;
  quoteIdentifiers: true;
  specification: Snowflake
  {
    name: 'OTTER_SURVEY';
    account: 'otter_survey_account';
    warehouse: 'OTTER_QUERY_WH';
    region: 'eu-west-1';
    cloudType: 'aws';
    accountType: MultiTenant;
    organization: 'otter_org';
    role: 'OTTER_READER';
  };
  auth: OAuth
  {
    oauthKey: 'otter_oauth_key';
    scopeName: 'SESSION:ROLE:OTTER_READER';
  };
}
