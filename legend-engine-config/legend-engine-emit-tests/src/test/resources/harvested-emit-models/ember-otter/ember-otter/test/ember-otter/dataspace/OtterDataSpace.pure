###DataSpace
DataSpace test::emberotter::dataspace::OtterSurveyDataSpace
{
  executionContexts:
  [
    {
      name: 'survey';
      description: 'Survey tier: the sighting and holt registers served through the warehouse connection the runtime keys to the store.';
      mapping: test::emberotter::mapping::OtterMapping;
      defaultRuntime: test::emberotter::runtime::OtterRuntime;
    }
  ];
  defaultExecutionContext: 'survey';
  title: 'Riverbank Otter Survey';
  description: 'Discovery surface over the riverbank otter survey: the sighting register, the holt structural survey and the registered queries published over them.';
  elements:
  [
    test::emberotter::domain::OtterSighting,
    test::emberotter::domain::HoltSurvey,
    test::emberotter::domain::SightingDigest,
    test::emberotter::domain::HoltDigest
  ];
  executables:
  [
    {
      id: 1;
      title: 'Sighting Register';
      description: 'The parameterised reach-bounded register query with its count and temperature arms.';
      executable: test::emberotter::service::SightingRegister;
    },
    {
      id: 2;
      title: 'Pup Presence';
      description: 'The collection-membership query over the caller-supplied pup flag set.';
      executable: test::emberotter::service::PupPresence;
    },
    {
      id: 3;
      title: 'Holt Register';
      description: 'The second-root holt query with its chamber floor.';
      executable: test::emberotter::service::HoltRegister;
    }
  ];
  supportInfo: Email
  {
    address: 'otter-survey-desk@otterstewards.invalid';
  };
}
