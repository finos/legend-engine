  inspectedOn: StrictDate[0..1];
  permittedOperations: String[*];
  recordStatus: String[1];
  recordVersion: Integer[1];
}

Class {meta::pure::profiles::doc.doc = 'A conservator working at a bench and leading treatment rounds; the second hop of the workshop chain.'} test::opalwillow2::domain::Conservator
{
