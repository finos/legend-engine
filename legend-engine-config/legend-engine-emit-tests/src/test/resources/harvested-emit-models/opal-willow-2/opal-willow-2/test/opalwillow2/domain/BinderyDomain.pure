Association {meta::pure::profiles::doc.doc = 'A workshop holds many benches; the first hop of the workshop chain.'} test::opalwillow2::domain::Workshop_Benches
{
  workshop: test::opalwillow2::domain::BinderyWorkshop[1];
  benches: test::opalwillow2::domain::Bench[*];
}

Association {meta::pure::profiles::doc.doc = 'A bench is worked by many conservators; chains onto the workshop association through the shared bench end.'} test::opalwillow2::domain::Bench_Conservators
{
  bench: test::opalwillow2::domain::Bench[0..1];
  conservators: test::opalwillow2::domain::Conservator[*];
}

Association {meta::pure::profiles::doc.doc = 'A conservator leads many treatment rounds; chains onto the bench association through the shared conservator end.'} test::opalwillow2::domain::Conservator_Rounds
{
  leadConservator: test::opalwillow2::domain::Conservator[0..1];
  ledRounds: test::opalwillow2::domain::TreatmentRound[*];
}

Association {meta::pure::profiles::doc.doc = 'A volume carries many treatment rounds; chains onto the conservator association through the shared round end, so a workshop reaches a volume in four hops.'} test::opalwillow2::domain::Volume_Rounds
{
  treatedVolume: test::opalwillow2::domain::Volume[1];
  treatmentRounds: test::opalwillow2::domain::TreatmentRound[*];
}

Association {meta::pure::profiles::doc.doc = 'A treatment round gathers many condition reports; the terminal hop of the workshop chain.'} test::opalwillow2::domain::Round_Reports
{
  reportedRound: test::opalwillow2::domain::TreatmentRound[0..1];
  conditionReports: test::opalwillow2::domain::ConditionReport[*];
}

Association {meta::pure::profiles::doc.doc = 'A volume owns the text blocks bound into it; chains onto the volume association through the shared volume end.'} test::opalwillow2::domain::Volume_TextBlocks
{
  blockVolume: test::opalwillow2::domain::Volume[0..1];
  textBlocks: test::opalwillow2::domain::TextBlock[*];
}

Association {meta::pure::profiles::doc.doc = 'A text block owns its folded gatherings; chains onto the text block association through the shared block end.'} test::opalwillow2::domain::TextBlock_Gatherings
{
  gatheringBlock: test::opalwillow2::domain::TextBlock[1];
  gatherings: test::opalwillow2::domain::Gathering[*];
