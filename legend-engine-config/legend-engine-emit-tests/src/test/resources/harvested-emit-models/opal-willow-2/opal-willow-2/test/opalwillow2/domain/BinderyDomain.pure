###Pure
Class {meta::pure::profiles::doc.doc = 'A conservation bindery workshop; the outermost hub of the register graph.'} test::opalwillow2::domain::BinderyWorkshop
{
  workshopCode: String[1];
  workshopName: String[1];
  buildingWing: String[1];
  floorLevel: Integer[1];
  benchPlaces: Integer[1];
  humidityTargetPercent: Integer[0..1];
  temperatureTargetCelsius: Integer[0..1];
  openedOn: StrictDate[1];
  refurbishedOn: StrictDate[0..1];
  disciplineLabels: String[*];
  stewardReference: String[1];
  recordStatus: String[1];
  recordVersion: Integer[1];
}

Class {meta::pure::profiles::doc.doc = 'A working bench inside a workshop; the intermediate hop from a workshop to the conservators standing at it.'} test::opalwillow2::domain::Bench
{
