###Pure
import test::embermeadow3::domain::*;

Class test::embermeadow3::domain::RingingSite
{
  siteCode: String[1];
  siteName: String[1];
  habitatDescription: String[0..1];
  hectares: Float[0..1];
}

Class test::embermeadow3::domain::Ringer
{
  permitNumber: String[1];
  displayName: String[1];
  trainerPermitNumber: String[0..1];
}

Class test::embermeadow3::domain::MarkedIndividual
{
  ringNumber: String[1];
  speciesName: String[1];
  firstMarkedOn: StrictDate[1];
}

Class test::embermeadow3::domain::Capture
{
  captureReference: String[1];
  capturedOn: StrictDate[1];
  ageClass: AgeClass[1];
  moult: MoultState[1];
  wingMillimetres: Float[0..1];
  massGrams: Float[0..1];
}

Class test::embermeadow3::domain::MistNetCapture extends Capture
{
  netMetres: Float[1];
  netShelfCount: Integer[0..1];
}

Class test::embermeadow3::domain::CannonNetCapture extends Capture
{
  chargeCount: Integer[1];
  catchArea: String[0..1];
}

Class test::embermeadow3::domain::Recapture extends MistNetCapture
{
  daysSinceFirstMarking: Integer[1];
  ringWearNote: String[0..1];
}
