###Pure
import test::cedarvineyard::domain::*;

Class test::cedarvineyard::domain::VineBlock
{
  blockCode: String[1];
  parcelName: String[1];
  trellisKind: String[1];
  rowSpacingCm: Integer[1];
}

Class test::cedarvineyard::domain::CanopyReading
{
  readingRef: String[1];
  blockCode: String[1];
  leafLayerCount: Integer[1];
  shadedLeafPct: Integer[1];
  readOn: StrictDate[1];
}

Class test::cedarvineyard::domain::InboundBlockRecord
{
  blockRef: String[1];
  parcelLabel: String[1];
  trellisLabel: String[0..1];
}
