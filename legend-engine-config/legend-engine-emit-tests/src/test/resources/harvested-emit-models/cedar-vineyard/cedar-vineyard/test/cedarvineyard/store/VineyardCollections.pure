###MongoDB
Database test::cedarvineyard::store::CanopyNoteCollections
(
  Collection canopy_note
  (
    jsonSchema: {
      "bsonType": "object",
      "required": ["noteRef", "blockCode"],
      "properties": {
        "noteRef": {
          "bsonType": "string"
        },
        "blockCode": {
          "bsonType": "string"
        },
        "noteText": {
          "bsonType": "string"
        }
      }
    };
  )
)

Database test::cedarvineyard::store::PruningLogCollections
(
  Collection pruning_log
  (
    jsonSchema: {
      "bsonType": "object",
      "required": ["logRef"],
      "properties": {
        "logRef": {
          "bsonType": "string"
        },
        "blockCode": {
          "bsonType": "string"
        },
        "canesRemoved": {
          "bsonType": "int"
        }
      }
    };
  )
)

Database test::cedarvineyard::store::IrrigationPulseCollections
(
  Collection irrigation_pulse
  (
    jsonSchema: {
      "bsonType": "object",
      "required": ["pulseRef"],
      "properties": {
        "pulseRef": {
          "bsonType": "string"
        },
        "blockCode": {
          "bsonType": "string"
        },
        "litresApplied": {
          "bsonType": "int"
        }
      }
    };
  )
)
