###Relational
Database test::cedarvineyard::store::VineyardDatabase
(
  Schema vineyard
  (
    Table vine_block
    (
      block_code VARCHAR(12) PRIMARY KEY,
      parcel_name VARCHAR(40) NOT NULL,
      trellis_kind VARCHAR(20) NOT NULL,
      row_spacing_cm INTEGER NOT NULL
    )
    Table canopy_reading
    (
      reading_ref VARCHAR(20) PRIMARY KEY,
      block_code VARCHAR(12) NOT NULL,
      leaf_layer_count INTEGER NOT NULL,
      shaded_leaf_pct INTEGER NOT NULL,
      read_on DATE NOT NULL
    )
  )
)
