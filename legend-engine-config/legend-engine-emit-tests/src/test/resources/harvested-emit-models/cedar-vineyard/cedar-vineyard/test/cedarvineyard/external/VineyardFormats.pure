###ExternalFormat
Binding test::cedarvineyard::external::InboundBlockJsonBinding
{
  schemaSet: test::cedarvineyard::external::InboundBlockSchemas;
  schemaId: inboundBlock;
  contentType: 'application/json';
  modelIncludes: [
    test::cedarvineyard::domain::InboundBlockRecord
  ];
}

SchemaSet test::cedarvineyard::external::InboundBlockSchemas
{
  format: JSON;
  schemas: [
    {
      id: inboundBlock;
      location: 'InboundBlockRecord.json';
      content: '{\n  "title": "test::cedarvineyard::domain::InboundBlockRecord",\n  "type": "object",\n  "required": ["blockRef", "parcelLabel"],\n  "properties": {\n    "blockRef":     { "type": "string" },\n    "parcelLabel":  { "type": "string" },\n    "trellisLabel": { "type": "string" }\n  }\n}';
    }
  ];
}

Binding test::cedarvineyard::external::CanopyReadingJsonBinding
{
  schemaSet: test::cedarvineyard::external::CanopyReadingSchemas;
  schemaId: canopyReading;
  contentType: 'application/json';
  modelIncludes: [
    test::cedarvineyard::domain::CanopyReading
  ];
}

SchemaSet test::cedarvineyard::external::CanopyReadingSchemas
{
  format: JSON;
  schemas: [
    {
      id: canopyReading;
      location: 'CanopyReading.json';
      content: '{\n  "title": "test::cedarvineyard::domain::CanopyReading",\n  "type": "object",\n  "required": ["readingRef", "blockCode", "leafLayerCount", "shadedLeafPct", "readOn"],\n  "properties": {\n    "readingRef":     { "type": "string" },\n    "blockCode":      { "type": "string" },\n    "leafLayerCount": { "type": "integer" },\n    "shadedLeafPct":  { "type": "integer" },\n    "readOn":         { "type": "string", "format": "date" }\n  }\n}';
    }
  ];
}
