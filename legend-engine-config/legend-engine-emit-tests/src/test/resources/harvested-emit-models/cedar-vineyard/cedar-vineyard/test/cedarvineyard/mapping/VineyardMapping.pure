###Mapping
Mapping test::cedarvineyard::mapping::VineyardMapping
(
  *test::cedarvineyard::domain::VineBlock[block]: Relational
  {
    ~primaryKey
    (
      [test::cedarvineyard::store::VineyardDatabase]vineyard.vine_block.block_code
    )
    ~mainTable [test::cedarvineyard::store::VineyardDatabase]vineyard.vine_block
    blockCode: [test::cedarvineyard::store::VineyardDatabase]vineyard.vine_block.block_code,
    parcelName: [test::cedarvineyard::store::VineyardDatabase]vineyard.vine_block.parcel_name,
    trellisKind: [test::cedarvineyard::store::VineyardDatabase]vineyard.vine_block.trellis_kind,
    rowSpacingCm: [test::cedarvineyard::store::VineyardDatabase]vineyard.vine_block.row_spacing_cm
  }

  *test::cedarvineyard::domain::CanopyReading[reading]: Relational
  {
    ~primaryKey
    (
      [test::cedarvineyard::store::VineyardDatabase]vineyard.canopy_reading.reading_ref
    )
    ~mainTable [test::cedarvineyard::store::VineyardDatabase]vineyard.canopy_reading
    readingRef: [test::cedarvineyard::store::VineyardDatabase]vineyard.canopy_reading.reading_ref,
    blockCode: [test::cedarvineyard::store::VineyardDatabase]vineyard.canopy_reading.block_code,
    leafLayerCount: [test::cedarvineyard::store::VineyardDatabase]vineyard.canopy_reading.leaf_layer_count,
    shadedLeafPct: [test::cedarvineyard::store::VineyardDatabase]vineyard.canopy_reading.shaded_leaf_pct,
    readOn: [test::cedarvineyard::store::VineyardDatabase]vineyard.canopy_reading.read_on
  }

  testSuites:
  [
    blockSuite:
    {
      function: |test::cedarvineyard::domain::VineBlock.all()->project(
  ~[
     Block: x|$x.blockCode,
     Parcel: x|$x.parcelName,
     Trellis: x|$x.trellisKind,
     Spacing: x|$x.rowSpacingCm
   ]
)->sort(~Block->ascending());
      tests:
      [
        allBlocks:
        {
          doc: 'Projects the primary-key-anchored vine block set so every directly bound column of the block table surfaces.';
          data:
          [
            test::cedarvineyard::store::VineyardDatabase:
              Relational
              #{
                vineyard.vine_block:
                  'block_code,parcel_name,trellis_kind,row_spacing_cm\n'+
                  'VB-01,Upper Terrace,VSP,180\n'+
                  'VB-02,Lower Terrace,PERGOLA,220\n';
              }#
          ];
          asserts:
          [
            blocks:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Block":"VB-01","Parcel":"Upper Terrace","Trellis":"VSP","Spacing":180},{"Block":"VB-02","Parcel":"Lower Terrace","Trellis":"PERGOLA","Spacing":220}]';
                  }#;
              }#
          ];
        }
      ];
    },
    readingSuite:
    {
      function: |test::cedarvineyard::domain::CanopyReading.all()->filter(
  r|$r.shadedLeafPct >= 30
)->project(
  ~[
     Reading: x|$x.readingRef,
     Block: x|$x.blockCode,
     Layers: x|$x.leafLayerCount,
     Shaded: x|$x.shadedLeafPct
   ]
)->sort(~Reading->ascending());
      tests:
      [
        shadedReadings:
        {
          doc: 'Only canopy readings whose shaded leaf share reaches thirty percent surface, so the sparse reading is dropped.';
          data:
          [
            test::cedarvineyard::store::VineyardDatabase:
              Relational
              #{
                vineyard.canopy_reading:
                  'reading_ref,block_code,leaf_layer_count,shaded_leaf_pct,read_on\n'+
                  'CR-01,VB-01,3,45,2026-06-01\n'+
                  'CR-02,VB-01,1,12,2026-06-02\n'+
                  'CR-03,VB-02,4,30,2026-06-03\n';
              }#
          ];
          asserts:
          [
            shaded:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Reading":"CR-01","Block":"VB-01","Layers":3,"Shaded":45},{"Reading":"CR-03","Block":"VB-02","Layers":4,"Shaded":30}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
