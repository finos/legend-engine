###Pure
import test::copperquokka::*;

Profile test::copperquokka::CurationProfile
{
  stereotypes: [curated, protected];
  tags: [sourceRegion, reviewNote];
}

Enum test::copperquokka::SeedColour
{
  PALE,
  AMBER,
  COPPER,
  DEEP_BROWN
}

Enum test::copperquokka::GerminationStatus
{
  UNTESTED,
  VIABLE,
  DORMANT,
  NONVIABLE
}

Enum test::copperquokka::HabitatKind
{
  COASTAL_DUNE,
  MONTANE_MEADOW,
  RIVERINE_WOODLAND,
  LIMESTONE_GROVE
}

Class test::copperquokka::SeedRecord
{
  recordCode: String[1];
  collectedOn: StrictDate[1];
  colour: SeedColour[1];
  habitat: HabitatKind[1];
}

Class <<test::copperquokka::CurationProfile.curated>> {test::copperquokka::CurationProfile.sourceRegion = 'Southern Ridge'} test::copperquokka::CollectedSeed extends SeedRecord
{
  collectorName: String[1];
  collectionSite: String[1];
  provenanceNote: String[0..1];
}

Class {test::copperquokka::CurationProfile.reviewNote = 'Botanical identity reviewed'} test::copperquokka::CataloguedSeed extends CollectedSeed
{
  botanicalName: String[1];
  germination: GerminationStatus[1];
  taxonomicRank: String[1];
  curationNotes: CurationNote[0..*];
}

Class <<test::copperquokka::CurationProfile.protected>> test::copperquokka::StoredSeed extends CataloguedSeed
{
  vaultShelf: String[1];
  storageTemperature: Float[1];
  sealed: Boolean[1];
  seedLot: SeedLot[1];
}

Class test::copperquokka::PropagatedSeed extends CataloguedSeed
{
  nurseryName: String[1];
  plantingDate: StrictDate[1];
  emergenceRate: Float[1];
  sourceHabitat: HabitatSample[0..1];
}

Class test::copperquokka::SeedLot
{
  lotCode: String[1];
  lotColour: SeedColour[1];
  lotStatus: GerminationStatus[1];
  habitat: HabitatKind[1];
  quantity: Integer[1];
  sourceRecord: SeedRecord[1];
}

Class test::copperquokka::HabitatSample
{
  sampleCode: String[1];
  habitat: HabitatKind[1];
  canopyDensity: Float[1];
  notes: String[0..1];
  sourceLot: SeedLot[0..1];
}

Class test::copperquokka::CurationNote
{
  noteCode: String[1];
  subject: SeedRecord[1];
  status: GerminationStatus[1];
  noteText: String[1];
}
