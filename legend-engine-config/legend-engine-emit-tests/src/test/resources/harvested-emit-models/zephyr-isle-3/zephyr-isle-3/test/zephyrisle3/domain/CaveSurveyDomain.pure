###Pure
import test::zephyrisle3::domain::*;

Class {meta::pure::profiles::doc.doc = 'A karst cave system as the survey register holds it: surface identity, access and publication vocabulary, and the stations and passage segments recorded beneath it.'} test::zephyrisle3::domain::CaveSystem
{
  systemCode: String[1];
  systemName: String[1];
  entrance: EntranceKind[1];
  hostRock: HostRock[1];
  permit: AccessPermit[1];
  projection: MapProjection[1];
  datum: DatumReference[1];
  window: SeasonWindow[1];
  roost: RoostGroup[0..1];
  surveyedLength: Float[1];
  deepestPoint: Float[0..1];
  stations: SurveyStation[*];
  segments: PassageSegment[*];
}

Class {meta::pure::profiles::doc.doc = 'A fixed survey station: the point measurements are read from, carrying the conditions the team recorded while standing there and an optional back-reference to its system.'} test::zephyrisle3::domain::SurveyStation
{
  stationCode: String[1];
  grade: SurveyGrade[1];
  method: SurveyMethod[1];
  hazard: HazardKind[0..1];
  visibility: VisibilityBand[1];
  airQuality: AirQualityBand[1];
  anchor: AnchorKind[0..1];
  lamp: LampKind[1];
  readerRole: TeamRole[1];
  depthBelowDatum: Float[1];
  readOn: StrictDate[1];
  system: CaveSystem[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A passage segment between two stations, holding the shape, water and kit vocabulary that applies along it; the far station is optional because a dead end is surveyed from one side only.'} test::zephyrisle3::domain::PassageSegment
{
  segmentCode: String[1];
  shape: PassageShape[1];
  water: WaterRegime[1];
  equipment: EquipmentClass[1];
  formation: FormationKind[0..1];
  lengthMetres: Float[1];
  averageWidth: Float[0..1];
  fromStation: SurveyStation[1];
  toStation: SurveyStation[0..1];
  system: CaveSystem[0..1];
}
