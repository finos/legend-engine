###ExternalFormat
SchemaSet test::jadefjord::external::SurveySchemas
{
  format: JSON;
  schemas: [
    {
      id: planktonSample;
      location: 'PlanktonSample.json';
      content: '{\n  "title": "test::jadefjord::domain::PlanktonSample",\n  "type": "object",\n  "required": ["sampleTag", "stationTag", "taxonGroup", "countPerLitre"],\n  "properties": {\n    "sampleTag":     { "type": "string" },\n    "stationTag":    { "type": "string" },\n    "taxonGroup":    { "type": "string" },\n    "countPerLitre": { "type": "integer", "minimum": 0 }\n  }\n}';
    }
  ];
}

Binding test::jadefjord::external::SurveyJsonBinding
{
  schemaSet: test::jadefjord::external::SurveySchemas;
  schemaId: planktonSample;
  contentType: 'application/json';
  modelIncludes: [
    test::jadefjord::domain::PlanktonSample
  ];
}
