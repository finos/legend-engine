###Service
Service test::borealwillow3::service::SwarmWatchRegister
{
  pattern: '/borealwillow3/swarmWatch/{yardCode}';
  title: 'Swarm Watch Register For One Yard';
  documentation: 'Restricts the bait-hive register to one stand and projects the banded catch outcome, the yard name reached over one hop and the steward tally reached two hops out onto the grouped steward view.';
  autoActivateUpdates: false;
  owners:
  [
    'apiary-register-desk'
  ];
  execution: Single
  {
    query: {yardCode: String[1]|test::borealwillow3::domain::SwarmTrap.all()->filter(
      t|$t.yardCode == $yardCode
    )->project(
      [
        t|$t.trapCode,
        t|$t.lureCode,
        t|$t.catchCount,
        t|$t.catchBand,
        t|$t.yardName,
        t|$t.stewardCount,
        t|$t.watchLabel
      ],
      [
        'Trap',
        'Lure',
        'Catches',
        'Band',
        'Yard',
        'Stewards',
        'Watch'
      ]
    )->sort([asc('Trap')])};
    mapping: test::borealwillow3::mapping::ApiaryMapping;
    runtime: test::borealwillow3::runtime::ApiaryH2Runtime;
  }
  testSuites:
  [
    swarmWatchSuite:
    {
      data:
      [
        connections:
        [
          apiaryH2Connection:
            Relational
            #{
              apiary.swarm_trap:
                'trap_code,yard_code,lure_code,catch_note,catch_count\n'+
                'T-01,Y-01,PR,prime cast taken,3\n'+
                'T-02,Y-01,DC,decoy left in place,0\n'+
                'T-03,Y-01,ZZ,unlisted lure fitted,0\n'+
                'T-04,Y-02,MD,medium cast hived,2\n';

              registry.yard:
                'yard_code,yard_name,district_code,forage_code\n'+
                'Y-01,North Ridge Yard,D-1,OR\n'+
                'Y-02,Willow Berm Yard,D-2,HE\n';

              registry.steward:
                'steward_code,yard_code,steward_name\n'+
                'S-1,Y-01,rowan tilbury\n'+
                'S-2,Y-01,mira colt\n'+
                'S-3,Y-02,dane orrel\n';
            }#
        ]
      ]
      tests:
      [
        registerForOneYard:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            yardCode = 'Y-01'
          ]
          asserts:
          [
            keyedRegister:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Trap":"T-01","Lure":"PR","Catches":3,"Band":"PRIME CAST","Yard":"North Ridge Yard","Stewards":2,"Watch":"SWARM WATCH ROTA"},{"Trap":"T-02","Lure":"DC","Catches":0,"Band":"DECOY ONLY","Yard":"North Ridge Yard","Stewards":2,"Watch":"SWARM WATCH ROTA"},{"Trap":"T-03","Lure":"ZZ","Catches":0,"Band":null,"Yard":"North Ridge Yard","Stewards":2,"Watch":"SWARM WATCH ROTA"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
