###Service
Service test::borealwillow3::service::YardWalkFeed
{
  pattern: '/borealwillow3/yardWalks';
  title: 'Yard Walk Feed Believed Now';
  documentation: 'Resolves the yard walk-round notes believed at the current processing instant, so the snapshot superseded by a later correction never reaches the feed, and projects the trimmed note text.';
  autoActivateUpdates: false;
  owners:
  [
    'apiary-register-desk'
  ];
  execution: Single
  {
    query: {processingDate: StrictDate[1]|test::borealwillow3::domain::YardVisitLog.all($processingDate)->project(
      [
        v|$v.visitId,
        v|$v.yardCode,
        v|$v.entryText
      ],
      [
        'Visit',
        'Yard',
        'Note'
      ]
    )->sort([asc('Visit')])};
    mapping: test::borealwillow3::mapping::ApiaryMapping;
    runtime: test::borealwillow3::runtime::ApiaryH2Runtime;
  }
  testSuites:
  [
    yardWalkSuite:
    {
      data:
      [
        connections:
        [
          apiaryH2Connection:
            Relational
            #{
              apiary.yard_visit:
                'visit_id,yard_code,entry_text,in_z,out_z\n'+
                '1,Y-01,entrance widened   ,2020-01-01,9999-12-31\n'+
                '2,Y-01,fence line cleared ,2020-01-01,9999-12-31\n'+
                '3,Y-02,water trough refilled,2020-01-01,9999-12-31\n'+
                '4,Y-02,superseded note,2020-01-01,2021-01-01\n'+
                '5,Y-03,stand levelled,2020-01-01,9999-12-31\n';
            }#
        ]
      ]
      tests:
      [
        walksBelievedNow:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            processingDate = %2022-06-01
          ]
          asserts:
          [
            openSnapshotsOnly:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Visit":1,"Yard":"Y-01","Note":"entrance widened"},{"Visit":2,"Yard":"Y-01","Note":"fence line cleared"},{"Visit":3,"Yard":"Y-02","Note":"water trough refilled"},{"Visit":5,"Yard":"Y-03","Note":"stand levelled"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
