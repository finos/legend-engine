###Connection
RelationalDatabaseConnection test::borealwillow3::connection::ApiaryRegisterConnection
{
  store: test::borealwillow3::store::ApiaryDb;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'APIARY_REGISTER_DB';
    account: 'apiary_register';
    warehouse: 'APIARY_QUERY_WH';
    region: 'eu-west-1';
    cloudType: 'aws';
    enableQueryTags: false;
    role: 'APIARY_READER';
  };
  auth: OAuth
  {
    oauthKey: 'APIARY_REGISTER_OAUTH';
    scopeName: 'SESSION:ROLE:APIARY_READER';
  };
}

