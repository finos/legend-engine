###Pure
import meta::pure::profiles::*;
import test::borealwillow3::domain::*;
import test::borealwillow3::profile::*;

Enum test::borealwillow3::domain::HiveStrain
{
  CARNIOLAN,
  ITALIAN,
  BUCKFAST,
  LOCAL_MONGREL
}

Enum test::borealwillow3::domain::TemperBand
{
  CALM,
  STEADY,
  DEFENSIVE
}

Enum test::borealwillow3::domain::ForageClass
{
  ORCHARD,
  HEATHER,
  CLOVER,
  LINDEN
}

Enum test::borealwillow3::domain::InspectionOutcome
{
  QUEEN_SEEN,
  BROOD_ONLY,
  QUEENLESS,
  ABANDONED
}

Class <<typemodifiers.abstract, ApiaryProfiles.apiaryRecord>> {doc.doc = 'Common shape of anything the apiary register keeps per yard: the code it is filed under and the yard it stands in.', ApiaryProfiles.custodian = 'apiary-register-desk'} test::borealwillow3::domain::ApiaryRecord
{
  recordCode: String[1];
  yardCode: String[1];
}

Class <<ApiaryProfiles.apiaryRecord, temporal.businesstemporal>> {doc.doc = 'A colony standing in a yard, versioned over the period it was the recognised colony on that stand.', ApiaryProfiles.reviewCycle = 'seasonal', ApiaryProfiles.subjectArea = 'colony-register'} test::borealwillow3::domain::Hive extends ApiaryRecord
{
  hiveCode: String[1];
  strain: HiveStrain[1];
  temper: TemperBand[1];
  frameCount: Integer[0..1];
  mitePressure: String[0..1];
  yardName: String[0..1];
  forageName: String[0..1];
  sampleCount: Integer[0..1];
  maxCellCount: Integer[0..1];
  registerLabel: String[1];
}

Class <<ApiaryProfiles.apiaryRecord, temporal.bitemporal>> {doc.doc = 'A hive inspection, corrected over processing time and effective over the beekeeping season it was written for.', ApiaryProfiles.reviewCycle = 'monthly'} test::borealwillow3::domain::HiveInspection
{
  inspectionId: Integer[1];
  hiveCode: String[1];
  inspectorName: String[1];
  outcome: InspectionOutcome[1];
  reviewLabel: String[1];
}

Class <<ApiaryProfiles.provisional, temporal.processingtemporal>> {doc.doc = 'A yard walk-round note, published as a snapshot of what was known at a processing instant.'} test::borealwillow3::domain::YardVisitLog
{
  visitId: Integer[1];
  yardCode: String[1];
  entryText: String[1];
}

Class {doc.doc = 'A stand of hives, its forage classification and the stewards answering for it.'} test::borealwillow3::domain::Yard
{
  yardCode: String[1];
  yardName: String[1];
  districtCode: String[0..1];
  forage: ForageClass[1];
  stewardCount: Integer[0..1];
  bloomLabel: String[0..1];
  trapCodes: String[*];
}

Class {doc.doc = 'A bait hive set out to catch swarms, banded by what the last check found in it.', ApiaryProfiles.subjectArea = 'swarm-capture'} test::borealwillow3::domain::SwarmTrap extends ApiaryRecord
{
  trapCode: String[1];
  lureCode: String[0..1];
  catchCount: Integer[0..1];
  catchBand: String[0..1];
  stewardCount: Integer[0..1];
  yardName: String[0..1];
  watchLabel: String[1];
}

Class {doc.doc = 'A forage classification with the bloom window it is named for.'} test::borealwillow3::domain::ForageRef
{
  forageCode: String[1];
  forageName: String[1];
  bloomNote: String[0..1];
}

Class {doc.doc = 'A person answering for one yard.'} test::borealwillow3::domain::Steward
{
  stewardCode: String[1];
  yardCode: String[1];
  stewardName: String[1];
}

Class {doc.doc = 'A single brood frame counted during a hive check.'} test::borealwillow3::domain::FrameSample
{
  sampleId: Integer[1];
  hiveCode: String[1];
  cellCount: Integer[0..1];
  gradeCode: String[0..1];
}

Class <<ApiaryProfiles.publishedView>> {doc.doc = 'Per-hive rollup of frame samples as the register publishes it.'} test::borealwillow3::domain::HiveSampleTally
{
  hiveCode: String[1];
  sampleCount: Integer[0..1];
  maxCellCount: Integer[0..1];
}
