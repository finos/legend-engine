###Mapping
Mapping test::borealwillow3::mapping::ApiaryBaseMapping
(
  include mapping test::borealwillow3::mapping::ApiaryEnumMappings

  *test::borealwillow3::domain::Yard[yard]: Relational
  {
    ~filter [test::borealwillow3::store::ApiaryDb]NamedYard
    ~primaryKey
    (
      [test::borealwillow3::store::ApiaryDb]registry.yard.yard_code
    )
    ~mainTable [test::borealwillow3::store::ApiaryDb]registry.yard
    yardCode: [test::borealwillow3::store::ApiaryDb]registry.yard.yard_code,
    yardName: [test::borealwillow3::store::ApiaryDb]registry.yard.yard_name,
    districtCode: [test::borealwillow3::store::ApiaryDb]registry.yard.district_code,
    forage: EnumerationMapping ForageMapping: case(
              equal([test::borealwillow3::store::ApiaryDb]registry.yard.forage_code, 'OR'),
              'OR',
              case(
                equal([test::borealwillow3::store::ApiaryDb]registry.yard.forage_code, 'HE'),
                'HE',
                case(
                  equal([test::borealwillow3::store::ApiaryDb]registry.yard.forage_code, 'CV'),
                  'CV',
                  case(
                    equal([test::borealwillow3::store::ApiaryDb]registry.yard.forage_code, 'CL'),
                    'CL',
                    'LI'
                  )
                )
              )
            ),
    stewardCount: [test::borealwillow3::store::ApiaryDb]@Yard_StewardTally | [test::borealwillow3::store::ApiaryDb]registry.yard_steward_tally.steward_count,
    bloomLabel: [test::borealwillow3::store::ApiaryDb]@Yard_ForageLabel | [test::borealwillow3::store::ApiaryDb]registry.forage_label_vw.bloom_label,
    trapCodes: [test::borealwillow3::store::ApiaryDb]@Yard_Trap | [test::borealwillow3::store::ApiaryDb]apiary.swarm_trap.trap_code
  }

  *test::borealwillow3::domain::SwarmTrap[swarmTrap]: Relational
