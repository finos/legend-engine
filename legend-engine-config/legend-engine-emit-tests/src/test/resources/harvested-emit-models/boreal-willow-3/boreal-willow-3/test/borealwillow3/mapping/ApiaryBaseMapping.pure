    catchCount: [test::borealwillow3::store::ApiaryDb]apiary.swarm_trap.catch_count,
    catchBand: case(
                 equal([test::borealwillow3::store::ApiaryDb]apiary.swarm_trap.lure_code, 'PR'),
                 'PRIME CAST',
                 case(
                   equal([test::borealwillow3::store::ApiaryDb]apiary.swarm_trap.lure_code, 'LG'),
                   'LARGE CAST',
                   case(
                     equal([test::borealwillow3::store::ApiaryDb]apiary.swarm_trap.lure_code, 'MD'),
                     'MEDIUM CAST',
                     case(
                       equal([test::borealwillow3::store::ApiaryDb]apiary.swarm_trap.lure_code, 'SM'),
                       'SMALL CAST',
                       case(
                         equal([test::borealwillow3::store::ApiaryDb]apiary.swarm_trap.lure_code, 'LT'),
                         'LATE CAST',
                         case(
                           equal([test::borealwillow3::store::ApiaryDb]apiary.swarm_trap.lure_code, 'EA'),
                           'EARLY CAST',
                           case(
                             equal([test::borealwillow3::store::ApiaryDb]apiary.swarm_trap.lure_code, 'DC'),
                             'DECOY ONLY',
