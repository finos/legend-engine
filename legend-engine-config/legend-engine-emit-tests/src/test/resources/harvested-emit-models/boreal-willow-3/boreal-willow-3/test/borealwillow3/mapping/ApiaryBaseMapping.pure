    recordCode: [test::borealwillow3::store::ApiaryDb]apiary.swarm_trap.trap_code,
    yardCode: [test::borealwillow3::store::ApiaryDb]apiary.swarm_trap.yard_code,
    trapCode: [test::borealwillow3::store::ApiaryDb]apiary.swarm_trap.trap_code,
