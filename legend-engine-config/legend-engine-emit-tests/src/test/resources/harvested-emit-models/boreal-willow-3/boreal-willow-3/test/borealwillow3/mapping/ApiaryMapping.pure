###Mapping
Mapping test::borealwillow3::mapping::ApiaryMapping
(
  include mapping test::borealwillow3::mapping::ApiaryBaseMapping

  *test::borealwillow3::domain::Hive[hive]: Relational
  {
    ~primaryKey
    (
      [test::borealwillow3::store::ApiaryDb]apiary.hive.hive_code
    )
    ~mainTable [test::borealwillow3::store::ApiaryDb]apiary.hive
    recordCode: [test::borealwillow3::store::ApiaryDb]apiary.hive.hive_code,
    yardCode: [test::borealwillow3::store::ApiaryDb]apiary.hive.yard_code,
    hiveCode: [test::borealwillow3::store::ApiaryDb]apiary.hive.hive_code,
    strain: EnumerationMapping StrainMapping: case(
              equal([test::borealwillow3::store::ApiaryDb]apiary.hive.strain_code, 'CAR'),
              'CAR',
              case(
                equal([test::borealwillow3::store::ApiaryDb]apiary.hive.strain_code, 'CN'),
                'CN',
                case(
                  equal([test::borealwillow3::store::ApiaryDb]apiary.hive.strain_code, 'IT'),
                  'IT',
                  case(
                    equal([test::borealwillow3::store::ApiaryDb]apiary.hive.strain_code, 'BF'),
                    'BF',
                    'LM'
                  )
                )
              )
            ),
    temper: EnumerationMapping TemperMapping: case(
              equal([test::borealwillow3::store::ApiaryDb]apiary.hive.temper_code, 'C'),
              'C',
              case(
                equal([test::borealwillow3::store::ApiaryDb]apiary.hive.temper_code, 'S'),
                'S',
                'H'
              )
            ),
    frameCount: [test::borealwillow3::store::ApiaryDb]apiary.hive.frame_count,
    mitePressure: case(
                    isEmpty([test::borealwillow3::store::ApiaryDb]apiary.hive.mite_note),
                    sqlNull(),
                    case(
                      equal([test::borealwillow3::store::ApiaryDb]apiary.hive.mite_note, 'heavy drop'),
                      'TREAT NOW',
                      case(
                        equal([test::borealwillow3::store::ApiaryDb]apiary.hive.mite_note, 'light drop'),
                        'WATCH',
                        'CLEAR'
                      )
                    )
                  ),
    yardName: [test::borealwillow3::store::ApiaryDb]@Hive_Yard | [test::borealwillow3::store::ApiaryDb]registry.yard.yard_name,
    forageName: [test::borealwillow3::store::ApiaryDb]@Hive_Yard > @Yard_Forage | [test::borealwillow3::store::ApiaryDb]registry.forage_ref.forage_name,
    sampleCount: [test::borealwillow3::store::ApiaryDb]@Hive_SampleTally | [test::borealwillow3::store::ApiaryDb]apiary.hive_sample_tally.sample_count,
    maxCellCount: [test::borealwillow3::store::ApiaryDb]@Hive_SampleTally | [test::borealwillow3::store::ApiaryDb]apiary.hive_sample_tally.max_cell_count,
    registerLabel: 'COLONY REGISTER'
  }

  *test::borealwillow3::domain::HiveInspection[hiveInspection]: Relational
  {
    ~primaryKey
    (
      [test::borealwillow3::store::ApiaryDb]apiary.hive_inspection.inspection_id
    )
    ~mainTable [test::borealwillow3::store::ApiaryDb]apiary.hive_inspection
    inspectionId: [test::borealwillow3::store::ApiaryDb]apiary.hive_inspection.inspection_id,
    hiveCode: [test::borealwillow3::store::ApiaryDb]apiary.hive_inspection.hive_code,
    inspectorName: toUpper([test::borealwillow3::store::ApiaryDb]apiary.hive_inspection.inspector_name),
    outcome: EnumerationMapping OutcomeMapping: case(
               equal([test::borealwillow3::store::ApiaryDb]apiary.hive_inspection.outcome_code, 'QS'),
               'QS',
               case(
                 equal([test::borealwillow3::store::ApiaryDb]apiary.hive_inspection.outcome_code, 'BO'),
                 'BO',
                 case(
                   equal([test::borealwillow3::store::ApiaryDb]apiary.hive_inspection.outcome_code, 'NQ'),
                   'NQ',
                   'AB'
                 )
               )
             ),
    reviewLabel: 'SEASON REVIEW'
  }

  *test::borealwillow3::domain::YardVisitLog[yardVisitLog]: Relational
  {
    ~primaryKey
    (
      [test::borealwillow3::store::ApiaryDb]apiary.yard_visit.visit_id
    )
    ~mainTable [test::borealwillow3::store::ApiaryDb]apiary.yard_visit
    visitId: [test::borealwillow3::store::ApiaryDb]apiary.yard_visit.visit_id,
    yardCode: [test::borealwillow3::store::ApiaryDb]apiary.yard_visit.yard_code,
    entryText: rtrim([test::borealwillow3::store::ApiaryDb]apiary.yard_visit.entry_text)
  }

  *test::borealwillow3::domain::HiveSampleTally[hiveSampleTally]: Relational
  {
    ~primaryKey
    (
      [test::borealwillow3::store::ApiaryDb]apiary.hive_sample_tally.hive_code
    )
    ~mainTable [test::borealwillow3::store::ApiaryDb]apiary.hive_sample_tally
    hiveCode: [test::borealwillow3::store::ApiaryDb]apiary.hive_sample_tally.hive_code,
    sampleCount: [test::borealwillow3::store::ApiaryDb]apiary.hive_sample_tally.sample_count,
    maxCellCount: [test::borealwillow3::store::ApiaryDb]apiary.hive_sample_tally.max_cell_count
  }

  testSuites:
  [
    trapBandSuite:
    {
      function: |test::borealwillow3::domain::SwarmTrap.all()->project(
        [
          t|$t.trapCode,
          t|$t.catchBand,
          t|$t.yardName,
          t|$t.stewardCount,
          t|$t.watchLabel
        ],
        [
          'Trap',
          'Band',
          'Yard',
          'Stewards',
          'Watch'
        ]
      )->sort([asc('Trap')]);
      tests:
      [
        everyLureArm:
        {
          doc: 'Drives one fixture row into each of the eight arms of the swarm-trap band conditional, plus a row whose lure code matches no arm and a row with no lure code at all so both fall through to the null sentinel, while the steward count is reached two hops out onto the grouped steward view.';
          data:
          [
            test::borealwillow3::store::ApiaryDb:
              Relational
              #{
                apiary.swarm_trap:
                  'trap_code,yard_code,lure_code,catch_note,catch_count\n'+
                  'T-01,Y-01,PR,prime cast taken,3\n'+
                  'T-02,Y-01,LG,large cast hived,2\n'+
                  'T-03,Y-02,MD,medium cast hived,2\n'+
                  'T-04,Y-02,SM,small cast hived,1\n'+
                  'T-05,Y-03,LT,late cast hived,1\n'+
                  'T-06,Y-03,EA,early cast hived,2\n'+
                  'T-07,Y-01,DC,decoy left in place,0\n'+
                  'T-08,Y-02,EM,nothing found,0\n'+
                  'T-09,Y-03,ZZ,unlisted lure fitted,0\n'+
                  'T-10,Y-01,,no lure fitted,0\n';

                registry.yard:
                  'yard_code,yard_name,district_code,forage_code\n'+
                  'Y-01,North Ridge Yard,D-1,OR\n'+
                  'Y-02,Willow Berm Yard,D-2,HE\n'+
                  'Y-03,Orchard End Yard,D-2,CV\n';

                registry.steward:
                  'steward_code,yard_code,steward_name\n'+
                  'S-1,Y-01,rowan tilbury\n'+
                  'S-2,Y-01,mira colt\n'+
                  'S-3,Y-02,dane orrel\n';
              }#
          ];
          asserts:
          [
            bandsAndTalliesResolve:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Trap":"T-01","Band":"PRIME CAST","Yard":"North Ridge Yard","Stewards":2,"Watch":"SWARM WATCH ROTA"},{"Trap":"T-02","Band":"LARGE CAST","Yard":"North Ridge Yard","Stewards":2,"Watch":"SWARM WATCH ROTA"},{"Trap":"T-03","Band":"MEDIUM CAST","Yard":"Willow Berm Yard","Stewards":1,"Watch":"SWARM WATCH ROTA"},{"Trap":"T-04","Band":"SMALL CAST","Yard":"Willow Berm Yard","Stewards":1,"Watch":"SWARM WATCH ROTA"},{"Trap":"T-05","Band":"LATE CAST","Yard":"Orchard End Yard","Stewards":null,"Watch":"SWARM WATCH ROTA"},{"Trap":"T-06","Band":"EARLY CAST","Yard":"Orchard End Yard","Stewards":null,"Watch":"SWARM WATCH ROTA"},{"Trap":"T-07","Band":"DECOY ONLY","Yard":"North Ridge Yard","Stewards":2,"Watch":"SWARM WATCH ROTA"},{"Trap":"T-08","Band":"EMPTY TRAP","Yard":"Willow Berm Yard","Stewards":1,"Watch":"SWARM WATCH ROTA"},{"Trap":"T-09","Band":null,"Yard":"Orchard End Yard","Stewards":null,"Watch":"SWARM WATCH ROTA"},{"Trap":"T-10","Band":null,"Yard":"North Ridge Yard","Stewards":2,"Watch":"SWARM WATCH ROTA"}]';
                  }#;
              }#
          ];
        }
      ];
    },
    yardRollupSuite:
    {
      function: |test::borealwillow3::domain::Yard.all()->project(
        [
          y|$y.yardCode,
          y|$y.yardName,
          y|$y.districtCode,
          y|$y.forage,
          y|$y.stewardCount,
          y|$y.bloomLabel
        ],
        [
          'Yard',
          'Name',
          'District',
          'Forage',
          'Stewards',
          'Bloom'
        ]
      )->sort([asc('Yard')]);
      tests:
      [
        forageDecodesAndViewLabelsResolve:
        {
          doc: 'Checks that the yard filter drops the unnamed stand, that four stored forage codes decode onto the enumeration constants including the two codes folded onto one constant, and that the steward tally and bloom label arrive from the two derived views.';
          data:
          [
            test::borealwillow3::store::ApiaryDb:
              Relational
              #{
                registry.yard:
                  'yard_code,yard_name,district_code,forage_code\n'+
                  'Y-01,North Ridge Yard,D-1,OR\n'+
                  'Y-02,Willow Berm Yard,D-2,HE\n'+
                  'Y-03,Orchard End Yard,D-2,CV\n'+
                  'Y-04,Lime Row Yard,,LI\n'+
                  'Y-05,,D-3,OR\n';

                registry.forage_ref:
                  'forage_code,forage_name,bloom_note\n'+
                  'OR,Orchard Blossom,april\n'+
                  'HE,Moor Heather,august\n'+
                  'CV,Field Clover,june\n'+
                  'LI,Lime Avenue,july\n';

                registry.steward:
                  'steward_code,yard_code,steward_name\n'+
                  'S-1,Y-01,rowan tilbury\n'+
                  'S-2,Y-01,mira colt\n'+
                  'S-3,Y-02,dane orrel\n';
              }#
          ];
          asserts:
          [
            namedYardsOnly:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Yard":"Y-01","Name":"North Ridge Yard","District":"D-1","Forage":"ORCHARD","Stewards":2,"Bloom":"BLOOM-april"},{"Yard":"Y-02","Name":"Willow Berm Yard","District":"D-2","Forage":"HEATHER","Stewards":1,"Bloom":"BLOOM-august"},{"Yard":"Y-03","Name":"Orchard End Yard","District":"D-2","Forage":"CLOVER","Stewards":null,"Bloom":"BLOOM-june"},{"Yard":"Y-04","Name":"Lime Row Yard","District":null,"Forage":"LINDEN","Stewards":null,"Bloom":"BLOOM-july"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
