}

Class <<meta::pure::profiles::temporal.bitemporal, test::kindlyquokka5::profile::RecordFamily.movementRecord>> {meta::pure::profiles::doc.doc = 'A move of one animal between enclosures, held bi-temporally so a mis-keyed destination can be corrected as at the day of the move.'} test::kindlyquokka5::domain::AnimalMove
{
