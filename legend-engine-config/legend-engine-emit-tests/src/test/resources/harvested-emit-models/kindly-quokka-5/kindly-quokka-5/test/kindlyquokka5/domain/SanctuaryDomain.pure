  animalCode: String[1];
  fromEnclosureCode: String[1];
  toEnclosureCode: String[1];
  permitCode: String[0..1];
  crated: Boolean[1];
}

Class <<meta::pure::profiles::temporal.bitemporal, test::kindlyquokka5::profile::RecordFamily.registerRecord>> {meta::pure::profiles::doc.doc = 'A census of one enclosure, held bi-temporally so a recount restates the census as at the census day.'} test::kindlyquokka5::domain::EnclosureCensus
{
