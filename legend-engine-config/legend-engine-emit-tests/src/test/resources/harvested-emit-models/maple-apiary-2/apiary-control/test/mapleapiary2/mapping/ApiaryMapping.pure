###Mapping
Mapping demo::mapleapiary2::mapping::ApiaryMapping
(
  *demo::mapleapiary2::domain::ColonyInspectionReport: Relational
  {
    ~primaryKey
    (
      [demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.EVENT_REF,
      [demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.EVENT_VERSION
    )
    ~mainTable [demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS
    eventRef: [demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.EVENT_REF,
    eventVersion: [demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.EVENT_VERSION,
    colonyRef: [demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.COLONY_REF,
    workItemRef: [demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.WORK_ITEM_REF,
    apiarySite: [demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.APIARY_SITE,
    inspectionStatus: [demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.INSPECTION_STATUS,
    completionState: [demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.COMPLETION_STATE,
    severityScore: [demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.SEVERITY_SCORE,
    careBand: case(
      and(
        equal([demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.INSPECTION_STATUS, 'OPEN'),
        greaterThanEqual([demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.SEVERITY_SCORE, 8)
      ),
      'CRITICAL-OPEN',
      case(
        and(
          equal([demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.INSPECTION_STATUS, 'OPEN'),
          greaterThanEqual([demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.SEVERITY_SCORE, 5)
        ),
        'MAJOR-OPEN',
        case(
          equal([demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.INSPECTION_STATUS, 'OPEN'),
          'ROUTINE-OPEN',
          case(
            and(
              equal([demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.INSPECTION_STATUS, 'PENDING'),
              equal([demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.COMPLETION_STATE, 'AWAITING_KEEPER')
            ),
            'BLOCKED-KEEPER',
            case(
              equal([demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.INSPECTION_STATUS, 'PENDING'),
              'PENDING-REVIEW',
              case(
                and(
                  equal([demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.INSPECTION_STATUS, 'CLOSED'),
                  equal([demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.COMPLETION_STATE, 'RESOLVED')
                ),
                'RESOLVED-CLOSED',
                case(
                  and(
                    equal([demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.INSPECTION_STATUS, 'CLOSED'),
                    equal([demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.COMPLETION_STATE, 'WITHDRAWN')
                  ),
                  'WITHDRAWN-CLOSED',
                  case(
                    equal([demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.INSPECTION_STATUS, 'SUPERSEDED'),
                    'SUPERSEDED-EVENT',
                    sqlNull()
                  )
                )
              )
            )
          )
        )
      )
    ),
    broodTag: case(
      equal([demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.BROOD_PATTERN, 'SOLID'),
      'dense-brood',
      coalesce(
        toLower([demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.BROOD_PATTERN),
        'unrecorded'
      )
    ),
    recordedOn: [demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.RECORDED_ON,
    recordedAt: [demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.RECORDED_AT,
    frameCount: [demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.FRAME_COUNT,
    regionLabel: [demo::mapleapiary2::store::ApiaryDatabase]@ColonyEvent_Task > @Task_Keeper > @Keeper_Team > @Team_Region | [demo::mapleapiary2::store::ApiaryDatabase]PRESENTATION.APIARY_REGION.REGION_LABEL,
    commentText: [demo::mapleapiary2::store::ApiaryDatabase]@ColonyEvent_Task > @Task_Comment | [demo::mapleapiary2::store::ApiaryDatabase]WORK_ITEM.TASK_COMMENT.COMMENT_TEXT,
    latestVersion: [demo::mapleapiary2::store::ApiaryDatabase]@ColonyEvent_LatestVersion | [demo::mapleapiary2::store::ApiaryDatabase]PRESENTATION.COLONY_EVENT_MAX_VERSION_VW.maxVersion,
    forageLabel: [demo::mapleapiary2::store::ApiaryDatabase]@ColonyEvent_ForageExtension | [demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.FORAGE_EXTENSION.FORAGE_LABEL,
    keeperData: Binding demo::mapleapiary2::external::KeeperDataBinding : [demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.KEEPER_DATA,
    systemData: Binding demo::mapleapiary2::external::SystemDataBinding : [demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.SYSTEM_DATA,
    rawContent: Binding demo::mapleapiary2::external::RawContentBinding : [demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.RAW_CONTENT,
    inspectionPayload: Binding demo::mapleapiary2::external::InspectionPayloadBinding : [demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.INSPECTION_PAYLOAD,
    hiveConditions: Binding demo::mapleapiary2::external::HiveConditionsBinding : extractFromSemiStructured([demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.INSPECTION_PAYLOAD, 'hive', 'VARCHAR'),
    queenRecord: Binding demo::mapleapiary2::external::QueenRecordBinding : extractFromSemiStructured([demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.INSPECTION_PAYLOAD, 'queen', 'VARCHAR'),
    feedingRecord: Binding demo::mapleapiary2::external::FeedingRecordBinding : extractFromSemiStructured([demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.INSPECTION_PAYLOAD, 'feeding', 'VARCHAR'),
    treatmentRecord: Binding demo::mapleapiary2::external::TreatmentRecordBinding : extractFromSemiStructured([demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.INSPECTION_PAYLOAD, 'treatment', 'VARCHAR')
  }

  *demo::mapleapiary2::domain::InspectionDerivedFields: Relational
  {
    ~primaryKey
    (
      [demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.EVENT_REF,
      [demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.EVENT_VERSION
    )
    ~mainTable [demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS
    eventRef: [demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.EVENT_REF,
    colonyRef: [demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.COLONY_REF,
    recordedOn: [demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.RECORDED_ON,
    recordedAt: [demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS.RECORDED_AT
  }

  *demo::mapleapiary2::domain::ColonyExceptionReport: Operation
  {
    meta::pure::router::operations::union_OperationSetImplementation_1__SetImplementation_MANY_(latestEventException, situationException)
  }

  demo::mapleapiary2::domain::ColonyExceptionReport[latestEventException]: Relational
  {
    ~primaryKey
    (
      [demo::mapleapiary2::store::ApiaryDatabase]PRESENTATION.COLONY_EVENT_MAX_VERSION_VW.eventRef
    )
    ~mainTable [demo::mapleapiary2::store::ApiaryDatabase]PRESENTATION.COLONY_EVENT_MAX_VERSION_VW
    exceptionRef: [demo::mapleapiary2::store::ApiaryDatabase]PRESENTATION.COLONY_EVENT_MAX_VERSION_VW.eventRef,
    apiarySite: [demo::mapleapiary2::store::ApiaryDatabase]PRESENTATION.COLONY_EVENT_MAX_VERSION_VW.latestSite,
    exceptionStatus: [demo::mapleapiary2::store::ApiaryDatabase]PRESENTATION.COLONY_EVENT_MAX_VERSION_VW.latestStatus,
    sourceKind: 'latest-event'
  }

  demo::mapleapiary2::domain::ColonyExceptionReport[situationException]: Relational
  {
    ~primaryKey
    (
      [demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.SITUATION_ALL_VERSIONS.SITUATION_REF,
      [demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.SITUATION_ALL_VERSIONS.SITUATION_VERSION
    )
    ~mainTable [demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.SITUATION_ALL_VERSIONS
    exceptionRef: [demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.SITUATION_ALL_VERSIONS.SITUATION_REF,
    apiarySite: [demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.SITUATION_ALL_VERSIONS.APIARY_SITE,
    exceptionStatus: [demo::mapleapiary2::store::ApiaryDatabase]HIVE_EVENT.SITUATION_ALL_VERSIONS.SITUATION_STATUS,
    sourceKind: 'situation'
  }

  testSuites:
  [
    careBandSuite:
    {
      function: |demo::mapleapiary2::domain::ColonyInspectionReport.all()->project(
        [
          r|$r.eventRef,
          r|$r.careBand,
          r|$r.broodTag
        ],
        [
          'Event Reference',
          'Care Band',
          'Brood Tag'
        ]
      )->sort(
        [
          asc('Event Reference')
        ]
      );
      tests:
      [
        conditionalArms:
        {
          doc: 'Every arm of the care-band conditional transform plus its null fallback, and the second conditional transform over the brood pattern.';
          data:
          [
            demo::mapleapiary2::store::ApiaryDatabase:
              Relational
              #{
                HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS:
                  'EVENT_REF,EVENT_VERSION,COLONY_REF,WORK_ITEM_REF,APIARY_SITE,INSPECTION_STATUS,COMPLETION_STATE,SEVERITY_SCORE,BROOD_PATTERN,FRAME_COUNT,RECORDED_ON,RECORDED_AT,KEEPER_DATA,SYSTEM_DATA,RAW_CONTENT,INSPECTION_PAYLOAD,BATCH_IN_ID,BATCH_OUT_ID,SOURCE_PARTITION,IS_WITHDRAWN\n'+
                  'CE-101,1,COL-11,WI-101,Meadow Ridge,OPEN,NEW,9,SOLID,12,2024-03-01,2024-03-01T08:15:00,,,,,41,,p01,N\n'+
                  'CE-102,1,COL-12,WI-102,Meadow Ridge,OPEN,NEW,6,Patchy,10,2024-03-02,2024-03-02T08:15:00,,,,,41,,p01,N\n'+
                  'CE-103,1,COL-13,WI-103,Willow Bend,OPEN,NEW,2,,9,2024-03-03,2024-03-03T08:15:00,,,,,41,,p01,N\n'+
                  'CE-104,1,COL-14,WI-104,Willow Bend,PENDING,AWAITING_KEEPER,4,,8,2024-03-04,2024-03-04T08:15:00,,,,,41,,p01,N\n'+
                  'CE-105,1,COL-15,WI-105,Clover Flat,PENDING,NEW,3,,7,2024-03-05,2024-03-05T08:15:00,,,,,41,,p01,N\n'+
                  'CE-106,1,COL-16,WI-106,Clover Flat,CLOSED,RESOLVED,1,,6,2024-03-06,2024-03-06T08:15:00,,,,,41,,p01,N\n'+
                  'CE-107,1,COL-17,WI-107,Clover Flat,CLOSED,WITHDRAWN,1,,5,2024-03-07,2024-03-07T08:15:00,,,,,41,,p01,N\n'+
                  'CE-108,1,COL-18,WI-108,Heather Row,SUPERSEDED,NEW,2,,4,2024-03-08,2024-03-08T08:15:00,,,,,41,,p01,N\n'+
                  'CE-109,1,COL-19,WI-109,Heather Row,ARCHIVED,NEW,,,3,2024-03-09,2024-03-09T08:15:00,,,,,41,,p01,N\n';
              }#
          ];
          asserts:
          [
            allArms:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Event Reference":"CE-101","Care Band":"CRITICAL-OPEN","Brood Tag":"dense-brood"},{"Event Reference":"CE-102","Care Band":"MAJOR-OPEN","Brood Tag":"patchy"},{"Event Reference":"CE-103","Care Band":"ROUTINE-OPEN","Brood Tag":"unrecorded"},{"Event Reference":"CE-104","Care Band":"BLOCKED-KEEPER","Brood Tag":"unrecorded"},{"Event Reference":"CE-105","Care Band":"PENDING-REVIEW","Brood Tag":"unrecorded"},{"Event Reference":"CE-106","Care Band":"RESOLVED-CLOSED","Brood Tag":"unrecorded"},{"Event Reference":"CE-107","Care Band":"WITHDRAWN-CLOSED","Brood Tag":"unrecorded"},{"Event Reference":"CE-108","Care Band":"SUPERSEDED-EVENT","Brood Tag":"unrecorded"},{"Event Reference":"CE-109","Care Band":null,"Brood Tag":"unrecorded"}]';
                  }#;
              }#
          ];
        }
      ];
    },
    derivedFieldsSuite:
    {
      function: |demo::mapleapiary2::domain::InspectionDerivedFields.all()->project(
        [
          d|$d.eventRef,
          d|$d.colonyLink,
          d|$d.settledInDays
        ],
        [
          'Event Reference',
          'Colony Link',
          'Settled In Days'
        ]
      )->sort(
        [
          asc('Event Reference')
        ]
      );
      tests:
      [
        derivedRows:
        {
          doc: 'Shared derived-fields class mapped over the same main table, covering the string-built link and a guarded date difference that yields nothing when the timestamp is absent.';
          data:
          [
            demo::mapleapiary2::store::ApiaryDatabase:
              Relational
              #{
                HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS:
                  'EVENT_REF,EVENT_VERSION,COLONY_REF,WORK_ITEM_REF,APIARY_SITE,INSPECTION_STATUS,COMPLETION_STATE,SEVERITY_SCORE,BROOD_PATTERN,FRAME_COUNT,RECORDED_ON,RECORDED_AT,KEEPER_DATA,SYSTEM_DATA,RAW_CONTENT,INSPECTION_PAYLOAD,BATCH_IN_ID,BATCH_OUT_ID,SOURCE_PARTITION,IS_WITHDRAWN\n'+
                  'CE-201,1,COL-21,WI-201,Meadow Ridge,OPEN,NEW,4,SOLID,12,2024-03-01,2024-03-04T08:15:00,,,,,41,,p01,N\n'+
                  'CE-202,1,COL-22,WI-202,Willow Bend,OPEN,NEW,4,SOLID,12,2024-03-02,,,,,,41,,p01,N\n';
              }#
          ];
          asserts:
          [
            derivedValues:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Event Reference":"CE-201","Colony Link":"apiary/colony/COL-21/event/CE-201","Settled In Days":3},{"Event Reference":"CE-202","Colony Link":"apiary/colony/COL-22/event/CE-202","Settled In Days":null}]';
                  }#;
              }#
          ];
        }
      ];
    },
    exceptionUnionSuite:
    {
      function: |demo::mapleapiary2::domain::ColonyExceptionReport.all()->project(
        [
          e|$e.exceptionRef,
          e|$e.exceptionStatus,
          e|$e.sourceKind
        ],
        [
          'Exception Reference',
          'Exception Status',
          'Source Kind'
        ]
      )->sort(
        [
          asc('Exception Reference')
        ]
      );
      tests:
      [
        unionBranches:
        {
          doc: 'Operation mapping unioning a latest-version view branch with an all-versions table branch, each carrying a literal source discriminator.';
          data:
          [
            demo::mapleapiary2::store::ApiaryDatabase:
              Relational
              #{
                HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS:
                  'EVENT_REF,EVENT_VERSION,COLONY_REF,WORK_ITEM_REF,APIARY_SITE,INSPECTION_STATUS,COMPLETION_STATE,SEVERITY_SCORE,BROOD_PATTERN,FRAME_COUNT,RECORDED_ON,RECORDED_AT,KEEPER_DATA,SYSTEM_DATA,RAW_CONTENT,INSPECTION_PAYLOAD,BATCH_IN_ID,BATCH_OUT_ID,SOURCE_PARTITION,IS_WITHDRAWN\n'+
                  'CE-301,1,COL-31,WI-301,Meadow Ridge,OPEN,NEW,4,SOLID,12,2024-03-01,2024-03-01T08:15:00,,,,,41,,p01,N\n'+
                  'CE-301,2,COL-31,WI-301,Meadow Ridge,PENDING,NEW,4,SOLID,12,2024-03-02,2024-03-02T08:15:00,,,,,41,,p01,N\n';

                HIVE_EVENT.SITUATION_ALL_VERSIONS:
                  'SITUATION_REF,SITUATION_VERSION,APIARY_SITE,SITUATION_STATUS,BATCH_IN_ID,SOURCE_PARTITION\n'+
                  'SI-401,1,Willow Bend,ESCALATED,41,p01\n';
              }#
          ];
          asserts:
          [
            unionRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Exception Reference":"CE-301","Exception Status":"PENDING","Source Kind":"latest-event"},{"Exception Reference":"SI-401","Exception Status":"ESCALATED","Source Kind":"situation"}]';
                  }#;
              }#
          ];
        }
      ];
    },
    payloadExtractSuite:
    {
      function: |demo::mapleapiary2::domain::ColonyInspectionReport.all()->project(
        [
          r|$r.eventRef,
          r|$r.hiveConditions.broodTemperatureBand,
          r|$r.queenRecord.queenMark,
          r|$r.feedingRecord.feedKind,
          r|$r.treatmentRecord.treatmentKind
        ],
        [
          'Event Reference',
          'Brood Temperature Band',
          'Queen Mark',
          'Feed Kind',
          'Treatment Kind'
        ]
      )->sort(
        [
          asc('Event Reference')
        ]
      );
      tests:
      [
        subDocumentExtraction:
        {
          doc: 'Each binding-backed property parses the sub-document extracted from the inspection payload at its own path; a payload without that path leaves the property empty.';
          data:
          [
            demo::mapleapiary2::store::ApiaryDatabase:
              Relational
              #{
                HIVE_EVENT.COLONY_EVENT_ALL_VERSIONS:
                  'EVENT_REF,EVENT_VERSION,COLONY_REF,WORK_ITEM_REF,APIARY_SITE,INSPECTION_STATUS,COMPLETION_STATE,SEVERITY_SCORE,BROOD_PATTERN,FRAME_COUNT,RECORDED_ON,RECORDED_AT,KEEPER_DATA,SYSTEM_DATA,RAW_CONTENT,INSPECTION_PAYLOAD,BATCH_IN_ID,BATCH_OUT_ID,SOURCE_PARTITION,IS_WITHDRAWN\n'+
                  'CE-501,1,COL-51,WI-501,Meadow Ridge,OPEN,NEW,4,SOLID,12,2024-03-01,2024-03-01T08:15:00,,,,{"hive":{"broodTemperatureBand":"WARM"}},41,,p01,N\n'+
                  'CE-502,1,COL-52,WI-502,Meadow Ridge,OPEN,NEW,4,SOLID,12,2024-03-02,2024-03-02T08:15:00,,,,{"queen":{"queenMark":"BLUE"}},41,,p01,N\n'+
                  'CE-503,1,COL-53,WI-503,Willow Bend,OPEN,NEW,4,SOLID,12,2024-03-03,2024-03-03T08:15:00,,,,{"feeding":{"feedKind":"SYRUP"}},41,,p01,N\n'+
                  'CE-504,1,COL-54,WI-504,Willow Bend,OPEN,NEW,4,SOLID,12,2024-03-04,2024-03-04T08:15:00,,,,{"treatment":{"treatmentKind":"OXALIC"}},41,,p01,N\n'+
                  'CE-505,1,COL-55,WI-505,Clover Flat,OPEN,NEW,4,SOLID,12,2024-03-05,2024-03-05T08:15:00,,,,{"frameNote":"calm"},41,,p01,N\n';
              }#
          ];
          asserts:
          [
            extractedSubDocuments:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Event Reference":"CE-501","Brood Temperature Band":"WARM","Queen Mark":null,"Feed Kind":null,"Treatment Kind":null},{"Event Reference":"CE-502","Brood Temperature Band":null,"Queen Mark":"BLUE","Feed Kind":null,"Treatment Kind":null},{"Event Reference":"CE-503","Brood Temperature Band":null,"Queen Mark":null,"Feed Kind":"SYRUP","Treatment Kind":null},{"Event Reference":"CE-504","Brood Temperature Band":null,"Queen Mark":null,"Feed Kind":null,"Treatment Kind":"OXALIC"},{"Event Reference":"CE-505","Brood Temperature Band":null,"Queen Mark":null,"Feed Kind":null,"Treatment Kind":null}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
