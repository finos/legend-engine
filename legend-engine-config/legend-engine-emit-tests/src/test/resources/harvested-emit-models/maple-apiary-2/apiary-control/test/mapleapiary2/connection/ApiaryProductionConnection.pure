###Connection
RelationalDatabaseConnection demo::mapleapiary2::connection::ApiaryProductionConnection
{
  store: demo::mapleapiary2::store::ApiaryDatabase;
  type: Snowflake;
  quoteIdentifiers: true;
  specification: Snowflake
  {
    name: 'APIARY_DB';
    account: 'apiary_control_account';
    warehouse: 'APIARY_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    role: 'APIARY_READER';
  };
  auth: OAuth
  {
    oauthKey: 'APIARY_OAUTH';
    scopeName: 'SESSION:ROLE:APIARY_READER';
  };
  postProcessors:
  [
    mapper
    {
      mappers:
      [
        schema {from: 'HIVE_EVENT'; to: 'HIVE_EVENT_PROD';},
        schema {from: 'WORK_ITEM'; to: 'WORK_ITEM_PROD';},
        schema {from: 'PRESENTATION'; to: 'PRESENTATION_PROD';},
        table {from: 'COLONY_EVENT_ALL_VERSIONS'; to: 'COLONY_EVENT_PROD'; schemaFrom: 'HIVE_EVENT'; schemaTo: 'HIVE_EVENT_PROD';},
        table {from: 'SITUATION_ALL_VERSIONS'; to: 'COLONY_EVENT_PROD'; schemaFrom: 'HIVE_EVENT'; schemaTo: 'HIVE_EVENT_PROD';},
        table {from: 'TASK_VERSION'; to: 'TASK_VERSION_PROD'; schemaFrom: 'WORK_ITEM'; schemaTo: 'WORK_ITEM_PROD';}
      ];
    }
  ];
}
