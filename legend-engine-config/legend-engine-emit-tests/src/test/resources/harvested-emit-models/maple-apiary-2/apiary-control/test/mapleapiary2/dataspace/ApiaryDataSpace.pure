###DataSpace
DataSpace demo::mapleapiary2::dataspace::ApiaryDataSpace
{
  executionContexts:
  [
    {
      name: 'production';
      description: 'Production apiary control reporting tier.';
      mapping: demo::mapleapiary2::mapping::ApiaryMapping;
      defaultRuntime: demo::mapleapiary2::runtime::ApiaryProductionRuntime;
    },
    {
      name: 'acceptance';
      description: 'Acceptance tier sharing the mapping and differing only in the rewritten physical names.';
      mapping: demo::mapleapiary2::mapping::ApiaryMapping;
      defaultRuntime: demo::mapleapiary2::runtime::ApiaryAcceptanceRuntime;
    }
  ];
  defaultExecutionContext: 'production';
  title: 'Apiary Control Reporting';
  description: 'A governed entry point over colony inspection events, their work items and keeper presentation views, wiring the shared relational mapping to one warehouse binding per environment.';
}
