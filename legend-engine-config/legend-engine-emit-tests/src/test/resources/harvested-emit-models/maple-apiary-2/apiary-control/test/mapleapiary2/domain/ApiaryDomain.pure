}

Class demo::mapleapiary2::domain::ColonyInspectionReport
{
  {meta::pure::profiles::doc.doc = 'Identifier of the colony inspection event.'} eventRef: String[1];
  {meta::pure::profiles::doc.doc = ''} eventVersion: Integer[1];
  {meta::pure::profiles::doc.doc = ''} colonyRef: String[1];
  {meta::pure::profiles::doc.doc = ''} workItemRef: String[0..1];
  {meta::pure::profiles::doc.doc = ''} apiarySite: String[0..1];
  {meta::pure::profiles::doc.doc = ''} inspectionStatus: String[0..1];
  {meta::pure::profiles::doc.doc = ''} completionState: String[0..1];
  {meta::pure::profiles::doc.doc = ''} severityScore: Integer[0..1];
  {meta::pure::profiles::doc.doc = ''} careBand: String[0..1];
  {meta::pure::profiles::doc.doc = ''} broodTag: String[0..1];
  {meta::pure::profiles::doc.doc = ''} recordedOn: StrictDate[1];
  {meta::pure::profiles::doc.doc = ''} recordedAt: DateTime[0..1];
  {meta::pure::profiles::doc.doc = ''} frameCount: Integer[0..1];
  {meta::pure::profiles::doc.doc = ''} regionLabel: String[0..1];
  {meta::pure::profiles::doc.doc = ''} forageLabel: String[0..1];
  {meta::pure::profiles::doc.doc = ''} latestVersion: Integer[0..1];
  {meta::pure::profiles::doc.doc = ''} commentText: String[0..1];
  {meta::pure::profiles::doc.doc = ''} keeperData: demo::mapleapiary2::domain::KeeperData[0..1];
  {meta::pure::profiles::doc.doc = ''} systemData: demo::mapleapiary2::domain::SystemData[0..1];
  {meta::pure::profiles::doc.doc = ''} rawContent: demo::mapleapiary2::domain::RawContent[0..1];
  {meta::pure::profiles::doc.doc = ''} inspectionPayload: demo::mapleapiary2::domain::InspectionPayload[0..1];
  {meta::pure::profiles::doc.doc = 'Brood-chamber conditions parsed from the hive sub-document of the inspection payload.'} hiveConditions: demo::mapleapiary2::domain::HiveConditions[0..1];
  {meta::pure::profiles::doc.doc = 'Queen sighting parsed from the queen sub-document of the inspection payload.'} queenRecord: demo::mapleapiary2::domain::QueenRecord[0..1];
  {meta::pure::profiles::doc.doc = 'Feeding parsed from the feeding sub-document of the inspection payload.'} feedingRecord: demo::mapleapiary2::domain::FeedingRecord[0..1];
  {meta::pure::profiles::doc.doc = 'Treatment parsed from the treatment sub-document of the inspection payload.'} treatmentRecord: demo::mapleapiary2::domain::TreatmentRecord[0..1];
  ageInDays() {$this.recordedOn->dateDiff(%2024-04-01, meta::pure::functions::date::DurationUnit.DAYS)}: Integer[1];
  recordedLabel() {$this.recordedOn->toString()}: String[1];
  reportLink() {'apiary/colony/' + $this.colonyRef}: String[1];
}

Class demo::mapleapiary2::domain::InspectionDerivedFields
{
  {meta::pure::profiles::doc.doc = ''} eventRef: String[1];
  {meta::pure::profiles::doc.doc = ''} colonyRef: String[1];
  {meta::pure::profiles::doc.doc = ''} recordedOn: StrictDate[1];
  {meta::pure::profiles::doc.doc = ''} recordedAt: DateTime[0..1];
  settledInDays() {if($this.recordedAt->isNotEmpty(), |$this.recordedOn->dateDiff($this.recordedAt->toOne(), meta::pure::functions::date::DurationUnit.DAYS), |[])}: Integer[0..1];
  ageInDays() {$this.recordedOn->dateDiff(%2024-04-01, meta::pure::functions::date::DurationUnit.DAYS)}: Integer[1];
  colonyLink() {'apiary/colony/' + $this.colonyRef + '/event/' + $this.eventRef}: String[1];
}

