###Pure
import meta::pure::profiles::*;

Enum {doc.doc = 'Temperament grade written against a hive at inspection.'} test::umberapiary3::domain::TemperGrade
{
  {doc.doc = 'Colony works the frames calmly.'} CALM,
  {doc.doc = 'Colony runs on the comb but does not fly up.'} RUNNY,
  {doc.doc = 'Colony flies up and follows the inspector.'} DEFENSIVE
}

Enum {doc.doc = 'Forage source the apiary records as dominant for a inspection week.'} test::umberapiary3::domain::ForageSource
{
  ORCHARD_BLOSSOM,
  HEATHER,
  CLOVER_LEY,
  LIME_AVENUE,
  MIXED_HEDGEROW
}
