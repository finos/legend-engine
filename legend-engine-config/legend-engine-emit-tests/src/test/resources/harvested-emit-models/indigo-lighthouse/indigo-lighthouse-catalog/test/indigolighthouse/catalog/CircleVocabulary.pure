Enum {meta::pure::profiles::doc.doc = 'Vocabulary of the roles a person can hold inside an exhibit circle.'} test::indigolighthouse::catalog::CircleRole
{
  LEAD_CURATOR,
  ASSISTANT_CURATOR,
  REGISTRAR,
  DOCENT
}

