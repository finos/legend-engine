###ExternalFormat
SchemaSet test::solarbeacon::binding::RegionSchemas
{
  format: JSON;
  schemas:
  [
    {
      id: region;
      location: 'Region.json';
      content: '{\n  "$schema": "http://json-schema.org/draft-07/schema#",\n  "title": "test::solarbeacon::domain::Region",\n  "type": "object",\n  "required": ["regionCode", "name", "panelCount"],\n  "properties": {\n    "regionCode": { "type": "string" },\n    "name": { "type": "string" },\n    "panelCount": { "type": "integer" }\n  }\n}';
    }
  ];
}
