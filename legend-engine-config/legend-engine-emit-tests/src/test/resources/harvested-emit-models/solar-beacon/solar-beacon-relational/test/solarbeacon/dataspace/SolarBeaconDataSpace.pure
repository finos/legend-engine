###DataSpace
DataSpace {meta::pure::profiles::doc.doc = 'A curated analytics entrypoint over the solar-monitoring model: irradiance readings, grid regions and solar stations.'} test::solarbeacon::dataspace::SolarBeaconDataSpace
{
  executionContexts:
  [
    {
      name: 'dev';
      description: 'Local development tier over the solar reading model.';
      mapping: test::solarbeacon::mapping::ReadingMapping;
      defaultRuntime: test::solarbeacon::runtime::SolarRuntime;
    }
  ];
  defaultExecutionContext: 'dev';
  title: 'Solar Beacon';
  description: 'A governed analytics entrypoint over the solar-monitoring network - business-temporal irradiance readings, grid regions with panel counts and the solar station roster - backed by the SolarDB relational store.';
  elements:
  [
    test::solarbeacon::domain
  ];
  executables:
  [
    {
      id: 1;
      title: 'Readings as of a business date';
      description: 'Projects reading code and irradiance for readings valid on a fixed business date.';
      query: |test::solarbeacon::domain::Reading.all(%2024-06-01)->project(
        [
          r|$r.readingCode,
          r|$r.irradiance
        ],
        [
          'Code',
          'Irradiance'
        ]
      );
      executionContextKey: 'dev';
    }
  ];
}
