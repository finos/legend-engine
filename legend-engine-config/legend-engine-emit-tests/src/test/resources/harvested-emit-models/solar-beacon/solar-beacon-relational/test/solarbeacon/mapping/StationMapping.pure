    name: [test::solarbeacon::store::SolarDB]solar.station_east.name,
    capacityKw: [test::solarbeacon::store::SolarDB]solar.station_east.capacity_kw
  }

  test::solarbeacon::domain::SolarStation[station_west]: Relational
