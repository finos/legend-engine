###Relational
Database test::solarbeacon::store::SolarDB
(
  Schema solar
  (
    Table region
    (
      region_code VARCHAR(20) PRIMARY KEY,
      name VARCHAR(200) NOT NULL
    )
    Table panel
    (
      panel_code VARCHAR(20) PRIMARY KEY,
      rated_kw DOUBLE NOT NULL,
      region_code VARCHAR(20) NOT NULL
    )
    Table station_east
    (
      station_code VARCHAR(20) PRIMARY KEY,
      name VARCHAR(200) NOT NULL,
      capacity_kw DOUBLE NOT NULL
    )
    Table station_west
    (
      station_code VARCHAR(20) PRIMARY KEY,
      name VARCHAR(200) NOT NULL,
      capacity_kw DOUBLE NOT NULL
    )
    Table reading
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z, INFINITY_DATE = %9999-12-31T00:00:00.000000+0000)
      )

      reading_code VARCHAR(20) PRIMARY KEY,
      irradiance DOUBLE NOT NULL,
      from_z TIMESTAMP NOT NULL,
      thru_z TIMESTAMP NOT NULL
    )

    View region_panel_stats
    (
      ~groupBy
      (
        solar.panel.region_code
      )
      region_code: solar.panel.region_code PRIMARY KEY,
      panel_count: count(solar.panel.panel_code)
    )
  )

  Join Region_Stats
  (
    [test::solarbeacon::store::SolarDB]solar.region.region_code = [test::solarbeacon::store::SolarDB]solar.region_panel_stats.region_code
  )
)
