###Service
Service test::solarbeacon::service::StationsByGrid
{
  pattern: '/solarbeacon/stationsByGrid';
  owners:
  [
    'solar-grid-ops'
  ];
  documentation: 'Projects solar stations (assembled from the east/west operation-union mapping, including properties inherited from the base observatory), routed per grid environment key to the matching runtime.';
  execution: Multi
  {
    query: {|test::solarbeacon::domain::SolarStation.all()->project(
      [
        s|$s.observatoryCode,
        s|$s.name,
        s|$s.capacityKw
      ],
      [
        'Code',
        'Name',
        'CapacityKw'
      ]
    )->sort([asc('Code')])};
    key: 'grid';
    executions['EAST']:
    {
      mapping: test::solarbeacon::mapping::StationMapping;
      runtime: test::solarbeacon::runtime::StationEastRuntime;
    }
    executions['WEST']:
    {
      mapping: test::solarbeacon::mapping::StationMapping;
      runtime: test::solarbeacon::runtime::StationWestRuntime;
    }
  }
}
