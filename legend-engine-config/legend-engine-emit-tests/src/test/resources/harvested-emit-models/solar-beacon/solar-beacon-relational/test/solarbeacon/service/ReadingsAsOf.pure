###Service
Service test::solarbeacon::service::ReadingsAsOf
{
  pattern: '/solarbeacon/readingsAsOf';
  owners:
  [
    'solar-observations'
  ];
  documentation: 'Returns solar irradiance readings as of a supplied business date, exercising business-temporal milestoning over the SolarDB store via ReadingMapping.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {businessDate: StrictDate[1]|test::solarbeacon::domain::Reading.all($businessDate)->project(
      [
        r|$r.readingCode,
        r|$r.irradiance
      ],
      [
        'Code',
        'Irradiance'
      ]
    )->sort([asc('Code')])};
    mapping: test::solarbeacon::mapping::ReadingMapping;
    runtime: test::solarbeacon::runtime::SolarRuntime;
  }
  testSuites:
  [
    readingsAsOfSuite:
    {
      data:
      [
        connections:
        [
          solarConnection:
            Relational
            #{
              solar.reading:
                'reading_code,irradiance,from_z,thru_z\n'+
                'RD-01,845.0,2020-01-01 00:00:00,9999-12-31 00:00:00\n'+
                'RD-02,912.5,2020-01-01 00:00:00,9999-12-31 00:00:00\n';
            }#
        ]
      ]
      tests:
      [
        asOf2024:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            businessDate = %2024-06-01
          ]
          asserts:
          [
            twoReadings:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Code":"RD-01","Irradiance":845.0},{"Code":"RD-02","Irradiance":912.5}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
