###Relational
Database test::westernprairie::store::PrairieDB
(
  Schema prairie
  (
    Table trail
    (
      trail_id INTEGER PRIMARY KEY,
      trail_name VARCHAR(200) NOT NULL,
      region_id INTEGER NOT NULL
    )
    Table region
    (
      region_id INTEGER PRIMARY KEY,
      region_name VARCHAR(200) NOT NULL
    )
  )

  Table trail_snapshot
  (
    ID INTEGER PRIMARY KEY,
    NAME VARCHAR(200),
    REGION VARCHAR(200),
    BATCH_IN INTEGER PRIMARY KEY,
    BATCH_OUT INTEGER
  )

  Join Trail_Region(prairie.trail.region_id = prairie.region.region_id)
)
