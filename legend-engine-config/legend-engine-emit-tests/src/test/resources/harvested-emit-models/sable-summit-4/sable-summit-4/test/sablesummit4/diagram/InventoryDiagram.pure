###Diagram
Diagram demo::sablesummit4::diagram::InventoryDiagram
{
  classView tree
  {
    class: demo::sablesummit4::domain::StreetTree;
    position: (60.0, 60.0);
    rectangle: (260.0, 180.0);
  }
  classView measurement
  {
    class: demo::sablesummit4::domain::CanopyMeasurement;
    position: (460.0, 60.0);
    rectangle: (280.0, 200.0);
  }
  propertyView
  {
    property: demo::sablesummit4::domain::Tree_Measurement.canopyMeasurements;
    source: tree;
    target: measurement;
    points: [(190.0, 150.0), (600.0, 130.0)];
  }
  propertyView
  {
    property: demo::sablesummit4::domain::Tree_Measurement.measuredTree;
    source: measurement;
    target: tree;
    points: [(600.0, 190.0), (190.0, 210.0)];
  }
}
