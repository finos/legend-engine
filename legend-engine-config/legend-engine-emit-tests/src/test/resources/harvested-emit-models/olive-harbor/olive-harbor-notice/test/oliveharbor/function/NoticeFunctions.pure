###Pure
import test::oliveharbor::function::*;

function test::oliveharbor::function::sectionEntries(payload: String[1], label: String[1]): String[*]
{
  $payload->split('|')->map(s | $s->trim())->filter(s | $s->toUpper()->startsWith($label->toUpper() + ':'))
}

function test::oliveharbor::function::sectionValue(payload: String[1], label: String[1]): String[1]
{
  if(sectionEntries($payload, $label)->isEmpty(),
     | '',
     | sectionEntries($payload, $label)->at(0)->substring($label->length() + 1, sectionEntries($payload, $label)->at(0)->length())->trim())
}

function test::oliveharbor::function::berthCodes(payload: String[1]): String[*]
{
  sectionValue($payload, 'BERTHS')->split(';')->map(b | $b->trim())->filter(b | $b != '')->map(b | $b->toUpper())
}

function test::oliveharbor::function::sailingNoticeDocument(payload: String[1]): String[1]
{
  '{"terminal":"' + sectionValue($payload, 'TERMINAL')->toUpper() + '","berthCount":' + berthCodes($payload)->size()->toString() + ',"berths":[' + berthCodes($payload)->map(b | '"' + $b + '"')->joinStrings(',') + '],"advisory":' + if(sectionValue($payload, 'NOTES') == '', | 'null', | '"' + sectionValue($payload, 'NOTES') + '"') + '}'
}
