###Mapping
Mapping test::emeraldmarsh4::mapping::NestQualificationMapping
(
  test::emeraldmarsh4::domain::NestTier: EnumerationMapping NestTierMap
  {
    GUARDED: ['G'],
    CROWDED: ['C'],
    OPEN: ['O']
  }

  *test::emeraldmarsh4::domain::QualifiedNest[qualifiedNest]: Pure
  {
    ~src test::emeraldmarsh4::domain::NestRecord
    reportRef: $src.reportRef,
    kindLabel: $src.kind->toString(),
    tier: EnumerationMapping NestTierMap: [if(test::emeraldmarsh4::function::isGuarded($src.observers.role),
                                              | 'G',
                                              | if(test::emeraldmarsh4::function::isCrowded($src.eggCount),
                                                   | 'C',
                                                   | 'O'))]->toOne(),
    guarded: test::emeraldmarsh4::function::isGuarded($src.observers.role),
    flooded: test::emeraldmarsh4::function::isFlooded($src.depthBand),
    zoneLabel: $src.zoneLabel,
    observerCount: $src.observers->size()
  }
)
