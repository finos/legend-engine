Enum test::emeraldmarsh4::domain::NestKind
{
  GROUND,
  REED,
  FLOATING,
  CAVITY,
  UNKNOWN
}

Enum test::emeraldmarsh4::domain::EggStage
{
  FRESH,
  INCUBATING,
  PIPPING,
  HATCHED,
  NONE
}

Enum test::emeraldmarsh4::domain::NestTier
{
  GUARDED,
  CROWDED,
  OPEN
}

Class test::emeraldmarsh4::domain::NestRecord
{
  reportRef: String[1];
  kind: test::emeraldmarsh4::domain::NestKind[1];
  zoneLabel: String[1];
  depthBand: String[0..1];
  firstEggStage: test::emeraldmarsh4::domain::EggStage[1];
  eggCount: Integer[1];
  leadAlias: String[1];
}

Class test::emeraldmarsh4::domain::ObserverRef
{
  role: String[1];
  alias: String[1];
}

Association test::emeraldmarsh4::domain::NestRecord_ObserverRef
{
  nest: test::emeraldmarsh4::domain::NestRecord[0..1];
  observers: test::emeraldmarsh4::domain::ObserverRef[*];
}

Class test::emeraldmarsh4::domain::QualifiedNest
{
  reportRef: String[1];
  kindLabel: String[1];
  tier: test::emeraldmarsh4::domain::NestTier[1];
  guarded: Boolean[1];
  flooded: Boolean[1];
  zoneLabel: String[1];
  observerCount: Integer[1];
}
