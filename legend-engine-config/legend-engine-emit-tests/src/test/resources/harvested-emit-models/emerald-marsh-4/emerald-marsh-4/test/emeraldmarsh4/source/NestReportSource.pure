Class test::emeraldmarsh4::source::NestReport
{
  reportRef: String[0..1];
  header: test::emeraldmarsh4::source::ReportHeader[0..1];
  site: test::emeraldmarsh4::source::SiteBlock[0..1];
  clutch: test::emeraldmarsh4::source::ClutchBlock[0..1];
  leadObserver: test::emeraldmarsh4::source::ObserverBlock[0..1];
  backupObserver: test::emeraldmarsh4::source::ObserverBlock[0..1];
}

Class test::emeraldmarsh4::source::ReportHeader
{
  kindCode: String[0..1];
  seasonWeek: Integer[0..1];
}

Class test::emeraldmarsh4::source::SiteBlock
{
  marshCode: String[0..1];
  zone: test::emeraldmarsh4::source::ZoneBlock[0..1];
}

Class test::emeraldmarsh4::source::ZoneBlock
{
  label: String[0..1];
  depthCm: Integer[0..1];
}

Class test::emeraldmarsh4::source::ClutchBlock
{
  eggs: test::emeraldmarsh4::source::EggBlock[*];
}

Class test::emeraldmarsh4::source::EggBlock
{
  stageCode: String[0..1];
  massGrams: Float[0..1];
}

Class test::emeraldmarsh4::source::ObserverBlock
{
  alias: String[0..1];
}
