###Runtime
Runtime test::emeraldmarsh4::runtime::NestDigestRuntime
{
  mappings:
  [
    test::emeraldmarsh4::mapping::NestQualificationMapping
  ];
  connections:
  [
    ModelStore:
    [
      nestChain:
      #{
        ModelChainConnection
        {
          mappings:
          [
            test::emeraldmarsh4::mapping::NestStandardMapping
          ];
        }
      }#,
      nestFeed:
      #{
        JsonModelConnection
        {
          class: test::emeraldmarsh4::source::NestReport;
          url: 'data:application/json,%7B%7D';
        }
      }#
    ]
  ];
}
