###Runtime
Runtime test::umberwillow2::runtime::WillowLakeRuntime
{
  mappings:
  [
    test::umberwillow2::mapping::WillowMapping
  ];
  connections:
  [
    test::umberwillow2::store::WillowDB:
    [
      willowLakeConnection: test::umberwillow2::connection::WillowLakeConnection
    ],
    test::umberwillow2::index::WillowObservationCluster:
    [
      willowIndexConnection: test::umberwillow2::connection::WillowIndexConnection
    ]
  ];
}
