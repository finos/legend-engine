###Connection
RelationalDatabaseConnection test::umberwillow2::connection::WillowLakeConnection
{
  store: test::umberwillow2::store::WillowDB;
  type: Snowflake;
  timezone: +0100;
  quoteIdentifiers: false;
  specification: Snowflake
  {
    name: 'WILLOW_DB';
    account: 'willow_reach_account';
    warehouse: 'WILLOW_WH';
    region: 'eu-west-1';
    cloudType: 'aws';
    accountType: MultiTenant;
    organization: 'willow_org';
    role: 'WILLOW_READER';
  };
  auth: OAuth
  {
    oauthKey: 'willow_oauth_key';
    scopeName: 'SESSION:ROLE:WILLOW_READER';
  };
  postProcessors:
  [
    mapper
    {
      mappers:
      [
        schema {from: 'riparian'; to: 'riparian_lake';}
      ];
    }
  ];
}
