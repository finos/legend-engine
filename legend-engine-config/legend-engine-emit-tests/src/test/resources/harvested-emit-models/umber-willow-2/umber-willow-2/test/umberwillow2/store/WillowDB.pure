###Relational
Database test::umberwillow2::store::WillowDB
(
  Schema riparian
  (
    Table scheme
    (
      scheme_id INTEGER PRIMARY KEY,
      scheme_name VARCHAR(60) NOT NULL,
      steward VARCHAR(60) NOT NULL
    )
    Table designation
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z),
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      designation_id INTEGER PRIMARY KEY,
      designation_code VARCHAR(20) NOT NULL,
      scheme_ref VARCHAR(20) NOT NULL,
      in_z DATE NOT NULL,
      out_z DATE NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
    Table stand
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      stand_id INTEGER PRIMARY KEY,
      stand_code VARCHAR(20) NOT NULL,
      clone_name VARCHAR(40) NOT NULL,
      canopy_height_m DOUBLE NOT NULL,
      reach_zone VARCHAR(20) NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
    Table section
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      section_id INTEGER PRIMARY KEY,
      section_code VARCHAR(20) NOT NULL,
      stem_count INTEGER NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
    Table reading
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )
      reading_id INTEGER PRIMARY KEY,
      reading_ref VARCHAR(20) NOT NULL,
      soil_moisture_pct DOUBLE NOT NULL,
      in_z DATE NOT NULL,
      out_z DATE NOT NULL
    )
    Table batch
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )
      batch_id INTEGER PRIMARY KEY,
      batch_ref VARCHAR(20) NOT NULL,
      cutting_count INTEGER NOT NULL,
      in_z DATE NOT NULL,
      out_z DATE NOT NULL
    )
  )
)
