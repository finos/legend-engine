###Elasticsearch
Elasticsearch7Cluster test::umberwillow2::index::WillowObservationCluster
{
  indices: [
    willow_observation: {
      properties: [
        observation_ref: Keyword,
        stand_code: Keyword,
        recorded_on: Date,
        soil_moisture_pct: Double,
        stem_count: Integer,
        observer_note: Text
      ];
    },
    willow_designation_audit: {
      properties: [
        designation_code: Keyword {
          fields: [
            asText: Text
          ];
        },
        corrected_on: Date,
        steward: Keyword
      ];
    }
  ];
}
