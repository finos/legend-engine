###DataSpace
DataSpace test::westernthicket3::dataspace::ThicketDataSpace
{
  executionContexts:
  [
    {
      name: 'wood';
      description: 'Wood tier - the cutting register, the stands it was cut on and the grove tallies behind them, served through the working wood warehouse.';
      mapping: test::westernthicket3::mapping::ThicketSurveyMapping;
      defaultRuntime: test::westernthicket3::runtime::ThicketWoodRuntime;
    },
    {
      name: 'archive';
      description: 'Archive tier - the same curated register bound to the archive warehouse the closed cutting cycles are kept in.';
      mapping: test::westernthicket3::mapping::ThicketSurveyMapping;
      defaultRuntime: test::westernthicket3::runtime::ThicketArchiveRuntime;
    },
    {
      name: 'reference';
      description: 'Reference tier - only the grove and stand books, bound to the working wood warehouse.';
      mapping: test::westernthicket3::mapping::ThicketRefMapping;
      defaultRuntime: test::westernthicket3::runtime::ThicketRefRuntime;
    }
  ];
  defaultExecutionContext: 'wood';
  title: 'Western Thicket Coppice Wood';
  description: 'A governed entry point over the coppice cutting register, the stands and groves it hangs off, the warden roster it is walked by and the banded tally sheets the wood writes down before anything is coded.';
  elements:
  [
    test::westernthicket3::domain::CutSurveyRecord,
    test::westernthicket3::domain::GroveRef,
    test::westernthicket3::domain::StandRef
  ];
  supportInfo: Email
  {
    address: 'coppice-survey-desk@thicketwood.invalid';
  };
}
