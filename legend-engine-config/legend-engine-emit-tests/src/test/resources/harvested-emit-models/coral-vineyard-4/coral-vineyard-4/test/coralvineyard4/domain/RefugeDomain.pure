import meta::pure::profiles::*;
import test::coralvineyard4::domain::*;
import test::coralvineyard4::feed::*;

Class {doc.doc = 'Any staffed or unstaffed point on the high-route network that walkers can navigate to. Carries the identity and reachability rules every published site must satisfy.'} test::coralvineyard4::domain::MountainSite
[
  altitudeSurveyed
  (
    ~function: !($this.altitudeMetres == 0)
    ~enforcementLevel: Error
    ~message: 'Site altitude is still the unsurveyed placeholder'
  ),
  reachableByPhoneOrRadio
  (
    ~function: $this.phone->isNotEmpty() || $this.radioChannels->isNotEmpty()
    ~enforcementLevel: Error
    ~message: 'Site needs a phone line or at least one radio channel'
  ),
  siteNamed
  (
    ~function: $this.siteName->isNotEmpty()
    ~enforcementLevel: Error
    ~message: 'Site must carry a published name'
  ),
  massifDeclared
  (
    ~function: $this.massif->isNotEmpty()
    ~enforcementLevel: Error
    ~message: 'Site must declare the massif it belongs to'
  )
]
{
  siteName: String[0..1];
  massif: String[0..1];
  altitudeMetres: Float[1];
  phone: String[0..1];
  radioChannels: String[*];
}

Class {doc.doc = 'A mountain refuge offering overnight dormitory beds along the high route.'} test::coralvineyard4::domain::Refuge extends MountainSite
{
  refugeCode: String[1];
  capacity: Integer[0..1];
  seasonLabel: String[0..1];
  dormitories: Dormitory[*];
}

Class {doc.doc = 'One sleeping room inside a refuge, holding a set of numbered bunks.'} test::coralvineyard4::domain::Dormitory
{
  roomName: String[0..1];
  heated: Boolean[0..1];
  bunks: Bunk[*];
}

Class test::coralvineyard4::domain::Bunk
{
  bunkNumber: Integer[0..1];
  tier: String[0..1];
  blanketCount: Integer[0..1];
  reservedFor: String[0..1];
  sizeLabel: String[0..1];
}

Class {doc.doc = 'The warden responsible for a refuge during its staffed season.'} test::coralvineyard4::domain::Keeper
{
  keeperName: String[0..1];
  refugeCode: String[0..1];
  season: String[0..1];
  languages: String[*];
}

Class test::coralvineyard4::domain::TrailStage
{
  stageCode: String[1];
  fromRefuge: String[0..1];
  toRefuge: String[0..1];
  ascentMetres: Integer[0..1];
  gradeLabel: String[0..1];
}

Class test::coralvineyard4::feed::RefugeFeed
{
  code: String[0..1];
  name: String[0..1];
  massif: String[0..1];
  altitude: Float[0..1];
  phone: String[0..1];
  channels: String[*];
  beds: Integer[0..1];
  opensMonth: Integer[0..1];
  closesMonth: Integer[0..1];
  rooms: DormFeed[*];
}

Class test::coralvineyard4::feed::DormFeed
{
  label: String[0..1];
  stove: Boolean[0..1];
  bunks: BunkFeed[*];
}

Class test::coralvineyard4::feed::BunkFeed
{
  number: Integer[0..1];
  upper: Boolean[0..1];
  blankets: Integer[0..1];
  guide: String[0..1];
  lengthCm: Integer[0..1];
}

Class test::coralvineyard4::feed::KeeperFeed
{
  name: String[0..1];
  refuge: String[0..1];
  season: String[0..1];
  speaks: String[*];
}

Class test::coralvineyard4::feed::StageFeed
{
  code: String[0..1];
  start: String[0..1];
  finish: String[0..1];
  climb: Integer[0..1];
  descent: Integer[0..1];
}
