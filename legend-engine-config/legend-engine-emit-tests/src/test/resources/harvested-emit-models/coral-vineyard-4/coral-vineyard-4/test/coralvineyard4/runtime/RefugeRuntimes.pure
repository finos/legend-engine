###Runtime
Runtime test::coralvineyard4::runtime::NetworkRuntime
{
  mappings:
  [
    test::coralvineyard4::mapping::RefugeMapping,
    test::coralvineyard4::mapping::KeeperMapping,
    test::coralvineyard4::mapping::StageMapping
  ];
  connections:
  [
    ModelStore:
    [
      refugeFeedConnection: test::coralvineyard4::connection::RefugeFeedConnection,
      keeperFeedConnection: test::coralvineyard4::connection::KeeperFeedConnection,
      stageFeedConnection: test::coralvineyard4::connection::StageFeedConnection
    ]
  ];
}

Runtime test::coralvineyard4::runtime::StageArchiveRuntime
{
  mappings:
  [
    test::coralvineyard4::mapping::StageMapping
  ];
  connections:
  [
    ModelStore:
    [
      stageArchiveConnection: test::coralvineyard4::connection::StageArchiveConnection
    ]
  ];
}

Runtime test::coralvineyard4::runtime::RefugeDirectoryRuntime
{
  mappings:
  [
    test::coralvineyard4::mapping::RefugeMapping
  ];
  connections:
  [
    ModelStore:
    [
      refugeFeedConnection: test::coralvineyard4::connection::RefugeFeedConnection
    ]
  ];
}
