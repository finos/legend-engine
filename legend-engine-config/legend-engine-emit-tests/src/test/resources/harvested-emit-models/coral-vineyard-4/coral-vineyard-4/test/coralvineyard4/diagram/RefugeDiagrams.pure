###Diagram
Diagram test::coralvineyard4::diagram::RefugeOverview
{
  classView siteView
  {
    class: test::coralvineyard4::domain::MountainSite;
    position: (100.0,40.0);
    rectangle: (220.0,110.0);
  }
  classView refugeView
  {
    class: test::coralvineyard4::domain::Refuge;
    position: (100.0,220.0);
    rectangle: (220.0,100.0);
  }
  classView dormitoryView
  {
    class: test::coralvineyard4::domain::Dormitory;
    position: (420.0,220.0);
    rectangle: (200.0,80.0);
  }
  classView bunkView
  {
    class: test::coralvineyard4::domain::Bunk;
    position: (720.0,220.0);
    rectangle: (200.0,110.0);
  }
  propertyView
  {
    property: test::coralvineyard4::domain::Refuge.dormitories;
    source: refugeView;
    target: dormitoryView;
    points: [(210.0,270.0),(520.0,260.0)];
  }
  propertyView
  {
    property: test::coralvineyard4::domain::Dormitory.bunks;
    source: dormitoryView;
    target: bunkView;
    points: [(520.0,260.0),(820.0,275.0)];
  }
  generalizationView
  {
    source: refugeView;
    target: siteView;
    points: [(210.0,270.0),(210.0,95.0)];
  }
}

