###Pure
import test::scarletdelta::domain::*;

Class test::scarletdelta::domain::SpecimenSheet
{
  sheetTag: String[1];
  herbariumName: String[1];
  collectedOn: DateTime[1];
  mountedBy: String[1];
  sheetWeightGrams: Integer[1];
  fragments: SheetFragment[2..*];
}

Class test::scarletdelta::domain::SheetFragment
{
  fragmentTag: String[1];
  organPart: String[1];
  lengthMillimetres: Integer[1];
  driedMassMilligrams: Integer[1];
  pressedFlat: Boolean[1];
}
