###MongoDB
Database test::scarletdelta::store::SheetCollections
(
  Collection specimenSheet
  (
    validationLevel: strict;
    validationAction: error;
    jsonSchema: {
      "bsonType": "object",
      "title": "Mounted herbarium specimen sheet",
      "required": ["sheetTag", "herbariumName", "collectionEvent", "mounting", "curation", "fragments"],
      "properties": {
        "sheetTag": {
          "bsonType": "string",
          "description": "accession tag stencilled on the mounted sheet",
          "minLength": 4
        },
        "herbariumName": {
          "bsonType": "string",
          "description": "herbarium holding the sheet"
        },
        "collectionEvent": {
          "bsonType": "object",
          "description": "field collection event the sheet was gathered on",
          "required": ["collectedOn"],
          "properties": {
            "collectedOn": {"bsonType": "date"},
            "collectorName": {"bsonType": "string"}
          },
          "additionalProperties": false
        },
        "mounting": {
          "bsonType": "object",
          "description": "who mounted the sheet and how",
          "required": ["mountedBy"],
          "properties": {
            "mountedBy": {"bsonType": "string"},
            "adhesiveKind": {"bsonType": "string"}
          },
          "additionalProperties": false
        },
        "curation": {
          "bsonType": "object",
          "description": "cabinet placement and dry weight of the sheet",
          "required": ["sheetWeightGrams"],
          "properties": {
            "sheetWeightGrams": {"bsonType": "int"},
            "cabinetCode": {"bsonType": "string"}
          },
          "additionalProperties": false
        },
        "fragments": {
          "bsonType": "array",
          "description": "detached plant fragments filed with the sheet",
          "minItems": 2,
          "items": {
            "bsonType": "object",
            "required": ["fragmentTag", "organPart"],
            "properties": {
              "fragmentTag": {"bsonType": "string"},
              "organPart": {"bsonType": "string"},
              "lengthMillimetres": {"bsonType": "int"},
              "driedMassMilligrams": {"bsonType": "int"},
              "pressedFlat": {"bsonType": "bool"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    };
  )
)
