###Service
Service test::wistfulestuary::service::ParcelTreeExport
{
  pattern: '/estuary/v1/parcel-trees/{treeName}/{parcelPath}';
  title: 'Wistful Estuary - Parcel Envelope Tree';
  owners:
  [
    'estuary-registry-office'
  ];
  documentation: 'Graph-fetches and serialises the remote parcel envelope together with its nested body, so the two-level tree resolves the discriminated document fields for one catalogue tree.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {treeName: String[1], parcelPath: String[1]|test::wistfulestuary::domain::ParcelEnvelope.all()->filter(e | ($e.treeName->toOne() == $treeName) && ($e.parcelPath == $parcelPath))->graphFetch(
      #{
        test::wistfulestuary::domain::ParcelEnvelope
        {
          parcelPath,
          classifierPath,
          content
          {
            contentKind,
            title,
            summaryText,
            stewardTag,
            revisionTag
          }
        }
      }#
    )->serialize(
      #{
        test::wistfulestuary::domain::ParcelEnvelope
        {
          parcelPath,
          classifierPath,
          content
          {
            contentKind,
            title,
            summaryText,
            stewardTag,
            revisionTag
          }
        }
      }#
    )};
    mapping: test::wistfulestuary::mapping::ReserveRegistryMapping;
    runtime: test::wistfulestuary::runtime::ReserveRegistryRuntime;
  }
}
