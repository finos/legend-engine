###ServiceStore
ServiceStore test::wistfulestuary::store::ArchiveApi
(
  description: 'Second remote parcel archive, declared for the registry surface but bound by no runtime.';

  ServiceGroup ArchiveServices
  (
    path: '/archive';

    Service ArchivedParcelFeedService
    (
      path: '/archived-parcel-feed';
      method: GET;
      security: [];
      response: [test::wistfulestuary::domain::ParcelEnvelope <- test::wistfulestuary::binding::ParcelEnvelopeBinding];
    )
  )
)
