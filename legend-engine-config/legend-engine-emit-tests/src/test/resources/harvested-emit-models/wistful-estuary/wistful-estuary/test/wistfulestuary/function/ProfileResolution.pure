###Pure
import test::wistfulestuary::domain::*;

function test::wistfulestuary::function::syncProfiles(): test::wistfulestuary::domain::SyncProfile[*]
{
  [
    ^test::wistfulestuary::domain::SyncProfile(
      visibility = ShareScope.SHARED,
      unit = StewardUnit.WETLAND_STEWARDS,
      profileKey = 'tideflat-sync',
      catalogueKey = 'cat-tideflat',
      endpointKey = 'ep-tideflat',
      registryKey = 'reg-estuary'
    ),
    ^test::wistfulestuary::domain::SyncProfile(
      visibility = ShareScope.PRIVATE,
      profileKey = 'saltmarsh-sync',
      catalogueKey = 'cat-saltmarsh',
      endpointKey = 'ep-saltmarsh',
      registryKey = 'reg-estuary'
    )
  ]
}

function test::wistfulestuary::function::syncProfileByKey(profileKey: String[1]): test::wistfulestuary::domain::SyncProfile[1]
{
  test::wistfulestuary::function::syncProfiles()->filter(p | $p.profileKey == $profileKey)->toOne()
}

function test::wistfulestuary::function::resolveCatalogueKey(treeName: String[1]): String[1]
{
  if($treeName->toUpper()->trim() == 'TIDEFLAT',
     | 'cat-tideflat',
     | if($treeName->toUpper()->trim() == 'SALTMARSH',
          | 'cat-saltmarsh',
          | ''))
}

function test::wistfulestuary::function::resolveEndpointKey(treeName: String[1]): String[1]
{
  if($treeName->toUpper()->trim() == 'TIDEFLAT',
     | 'ep-tideflat',
     | if($treeName->toUpper()->trim() == 'SALTMARSH',
          | 'ep-saltmarsh',
          | ''))
}
