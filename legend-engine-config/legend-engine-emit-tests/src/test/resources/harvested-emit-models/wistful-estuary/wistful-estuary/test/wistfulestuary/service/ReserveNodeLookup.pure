###Service
Service test::wistfulestuary::service::ReserveNodeLookup
{
  pattern: '/estuary/v1/reserve-nodes/{treeName}/{nodePath}';
  title: 'Wistful Estuary - Reserve Node Lookup';
  owners:
  [
    'estuary-registry-office'
  ];
  documentation: 'Graph-fetches the flat governed reserve node addressed by one catalogue tree and one node path, so the route parameters narrow the refined nodes through the two-parameter remote lookup and the registry key surfaces the constant the transform pins it to.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {treeName: String[1], nodePath: String[1]|test::wistfulestuary::domain::ReserveNode.all()->filter(n | ($n.treeName->toOne() == $treeName) && ($n.qualifiedPath == $nodePath))->graphFetch(
      #{
        test::wistfulestuary::domain::ReserveNode
        {
          qualifiedPath,
          nodeKey,
          summary
        }
      }#
    )->serialize(
      #{
        test::wistfulestuary::domain::ReserveNode
        {
          qualifiedPath,
          nodeKey,
          summary
        }
      }#
    )};
    mapping: test::wistfulestuary::mapping::ReserveRegistryMapping;
    runtime: test::wistfulestuary::runtime::ReserveRegistryRuntime;
  }
}
