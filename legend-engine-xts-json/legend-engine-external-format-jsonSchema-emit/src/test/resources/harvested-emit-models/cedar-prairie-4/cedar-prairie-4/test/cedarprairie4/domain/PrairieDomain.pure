Enum {meta::pure::profiles::doc.doc = 'The standing of a restoration plot in the prairie programme.'} test::cedarprairie4::domain::PlotStanding
{
  SEEDED,
  ESTABLISHING,
  ESTABLISHED,
  RETIRED
}

Class {meta::pure::profiles::doc.doc = 'A prairie restoration plot, optionally nested inside a wider parent plot.'} test::cedarprairie4::domain::RestorationPlot
{
  plotCode: String[1];
  plotName: String[1];
  regionName: String[1];
  hectares: Float[1];
  standing: test::cedarprairie4::domain::PlotStanding[1];
  parentPlotName: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A vegetation survey walked over a restoration plot, carrying its crew paperwork as a nested document.'} test::cedarprairie4::domain::PlotSurvey
{
  surveyCode: String[1];
  plotCode: String[1];
  coverPct: Float[1];
  surveyedOn: StrictDate[1];
  crewReport: test::cedarprairie4::report::CrewReport[0..1];
}

Class {meta::pure::profiles::doc.doc = 'The crew paperwork of a survey, read out of the nested document column.'} test::cedarprairie4::report::CrewReport
{
  reportRef: String[0..1];
  crew: test::cedarprairie4::report::CrewBlock[0..1];
}

Class {meta::pure::profiles::doc.doc = 'The crew block of a survey report.'} test::cedarprairie4::report::CrewBlock
{
  crewName: String[0..1];
  lead: test::cedarprairie4::report::LeadBlock[0..1];
}

Class {meta::pure::profiles::doc.doc = 'The crew lead named inside the crew block.'} test::cedarprairie4::report::LeadBlock
{
  leadName: String[0..1];
  wardenRef: String[0..1];
}
