###ExternalFormat
Binding test::indigotundra2::external::PermafrostReadingJsonBinding
{
  contentType: 'application/json';
  modelIncludes: [
    test::indigotundra2::domain::SurveyRecord,
    test::indigotundra2::domain::PermafrostReading,
    test::indigotundra2::domain::SeasonWindow,
    test::indigotundra2::domain::DataQualityFlag
  ];
}

Binding test::indigotundra2::external::SnowDepthReadingJsonBinding
{
  contentType: 'application/json';
  modelIncludes: [
    test::indigotundra2::domain::SurveyRecord,
    test::indigotundra2::domain::SnowDepthReading,
    test::indigotundra2::domain::SeasonWindow,
    test::indigotundra2::domain::DataQualityFlag
  ];
}

Binding test::indigotundra2::external::WindExposureReadingJsonBinding
{
  contentType: 'application/json';
  modelIncludes: [
    test::indigotundra2::domain::SurveyRecord,
    test::indigotundra2::domain::WindExposureReading,
    test::indigotundra2::domain::SeasonWindow,
    test::indigotundra2::domain::DataQualityFlag
  ];
}
