###Relational
Database test::westerndelta::store::DeltaRingDB
(
  Schema ringing
  (
    Table ring_record
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      record_id INTEGER PRIMARY KEY,
      ring_serial VARCHAR(20) NOT NULL,
      control_id INTEGER NOT NULL,
      reason_code VARCHAR(24) NOT NULL,
      sub_reason_code VARCHAR(24),
      created_at TIMESTAMP NOT NULL,
      due_at TIMESTAMP NOT NULL,
      completed_at TIMESTAMP,
      observer_id INTEGER NOT NULL,
      link_id INTEGER NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
    Table observer
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      observer_id INTEGER PRIMARY KEY,
      observer_name VARCHAR(40) NOT NULL,
      station_id INTEGER NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
    Table station
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      station_id INTEGER PRIMARY KEY,
      station_name VARCHAR(40) NOT NULL,
      zone_id INTEGER NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
    Table habitat_zone
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      zone_id INTEGER PRIMARY KEY,
      zone_name VARCHAR(40) NOT NULL,
      region_id INTEGER NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
    Table delta_region
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      region_id INTEGER PRIMARY KEY,
      region_name VARCHAR(40) NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
    Table sighting_link
    (
      link_id INTEGER PRIMARY KEY,
      link_kind VARCHAR(16) NOT NULL,
      link_ref VARCHAR(20) NOT NULL,
      marked_ref VARCHAR(20)
    )
  )

  Join Record_Observer(ringing.ring_record.observer_id = ringing.observer.observer_id)

  Join Observer_Station(ringing.observer.station_id = ringing.station.station_id)

  Join Station_Zone(ringing.station.zone_id = ringing.habitat_zone.zone_id)

  Join Zone_Region(ringing.habitat_zone.region_id = ringing.delta_region.region_id)

  Join Record_Link(ringing.ring_record.link_id = ringing.sighting_link.link_id)
)
