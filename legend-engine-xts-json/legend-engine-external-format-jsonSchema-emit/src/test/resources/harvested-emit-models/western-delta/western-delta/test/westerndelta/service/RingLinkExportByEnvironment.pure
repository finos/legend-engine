###Service
Service test::westerndelta::service::RingLinkExportByEnvironment
{
  pattern: '/westerndelta/v1/ring-links/{environment}';
  title: 'Western Delta - Ring Link Export By Environment';
  ownership: UserList { users: ['delta-ringing-governance'] };
  documentation: 'Environment-keyed export whose two keyed executions share the ringing mapping but bind the field and lab runtimes, and whose terminal stage serialises the fetched sighting links through a named external-format binding so the response contract is the binding rather than the fetch tree.';
  autoActivateUpdates: false;
  execution: Multi
  {
    query: {|test::westerndelta::domain::SightingLink.all()->graphFetch(
      #{
        test::westerndelta::domain::SightingLink
        {
          linkKind,
          linkRef
        }
      }#
    )->externalize(
      test::westerndelta::external::DeltaLinkBinding,
      #{
        test::westerndelta::domain::SightingLink
        {
          linkKind,
          linkRef
        }
      }#
    )};
    key: 'environment';
    executions['field']:
    {
      mapping: test::westerndelta::mapping::RingMapping;
      runtime: test::westerndelta::runtime::DeltaFieldRuntime;
    }
    executions['lab']:
    {
      mapping: test::westerndelta::mapping::RingMapping;
      runtime: test::westerndelta::runtime::DeltaLabRuntime;
    }
  }
}
