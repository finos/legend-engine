###Service
Service test::westerndelta::service::RingLineageDigest
{
  pattern: '/westerndelta/v1/ring-lineage/{businessDate}/{windowStart}/{windowEnd}';
  title: 'Western Delta - Ring Lineage Digest';
  ownership: UserList { users: ['delta-ringing-governance'] };
  documentation: 'Groups the ringing-exception extent resolved at one business date over a four-hop observer-to-region lineage in which the same date pins every hop, alongside the typed and untyped views of the record sighting link, and reports the record count and the highest control identifier per lineage.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: {businessDate: StrictDate[1], windowStart: StrictDate[1], windowEnd: StrictDate[1]|test::westerndelta::domain::RingRecord.all($businessDate)->filter(
      r|($r.createdAt >= $windowStart) && ($r.createdAt <= $windowEnd)
    )->groupBy(
      [
        r|$r.observer($businessDate).observerName,
        r|$r.observer($businessDate).station($businessDate).stationName,
        r|$r.observer($businessDate).station($businessDate).zone($businessDate).zoneName,
        r|$r.observer($businessDate).station($businessDate).zone($businessDate).region($businessDate).regionName,
        r|$r.primaryLink.linkKind,
        r|$r.primaryLink->cast(@test::westerndelta::domain::MarkedSightingLink).markedRef,
        r|$r.reasonCode
      ],
      [
        agg(
          r|$r.ringSerial,
          y|$y->count()
        ),
        agg(
          r|$r.controlId,
          y|$y->max()
        )
      ],
      [
        'Observer/Name',
        'Station/Name',
        'Zone/Name',
        'Region/Name',
        'Link/Kind',
        'Link/MarkedRef',
        'Reason/Code',
        'Record/Count',
        'Control/Highest'
      ]
    )->sort([asc('Observer/Name'), asc('Reason/Code')]);};
    mapping: test::westerndelta::mapping::RingMapping;
    runtime: test::westerndelta::runtime::DeltaFieldRuntime;
  }
  testSuites:
  [
    ringLineageDigestSuite:
    {
      data:
      [
        connections:
        [
          deltaFieldConnection: Reference
            #{
              test::westerndelta::data::DeltaSeedData
            }#
        ]
      ]
      tests:
      [
        lineagePinnedAtOneBusinessDate:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            businessDate = %2026-06-01,
            windowStart = %2026-03-01,
            windowEnd = %2026-03-31
          ]
          asserts:
          [
            oneRowPerLineageAndReason:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Observer/Name":"Reed Warden","Station/Name":"Reed Hide","Zone/Name":"Reedbed Zone","Region/Name":"Northern Delta","Link/Kind":"MARKED","Link/MarkedRef":"RF-900","Reason/Code":"COARSE-A","Record/Count":1,"Control/Highest":7},{"Observer/Name":"Reed Warden","Station/Name":"Reed Hide","Zone/Name":"Reedbed Zone","Region/Name":"Northern Delta","Link/Kind":"PLAIN","Link/MarkedRef":null,"Reason/Code":"COARSE-B","Record/Count":1,"Control/Highest":7},{"Observer/Name":"Reed Warden","Station/Name":"Reed Hide","Zone/Name":"Reedbed Zone","Region/Name":"Northern Delta","Link/Kind":"MARKED","Link/MarkedRef":"RF-900","Reason/Code":"COARSE-D","Record/Count":1,"Control/Highest":9},{"Observer/Name":"Saltpan Warden","Station/Name":"Saltpan Hide","Zone/Name":"Saltpan Zone","Region/Name":"Northern Delta","Link/Kind":"PLAIN","Link/MarkedRef":null,"Reason/Code":"COARSE-C","Record/Count":1,"Control/Highest":7}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
