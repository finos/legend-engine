###Relational
Database test::copperestuary3::store::KilnLogDb
(
  Schema kiln
  (
    Table firing_log
    (
      firing_code VARCHAR(24) PRIMARY KEY,
      kiln_name VARCHAR(60) NOT NULL,
      clay_body VARCHAR(40) NOT NULL,
      glaze_note VARCHAR(160),
      cone_number INTEGER NOT NULL,
      peak_temp_c FLOAT NOT NULL,
      started_at TIMESTAMP NOT NULL
    )
  )
)

###Relational
Database test::copperestuary3::store::KilnArchiveDb
(
  Schema archive
  (
    Table firing_archive
    (
      firing_code VARCHAR(24) PRIMARY KEY,
      kiln_name VARCHAR(60) NOT NULL,
      clay_body VARCHAR(40) NOT NULL,
      glaze_note VARCHAR(160),
      cone_number INTEGER NOT NULL,
      peak_temp_c FLOAT NOT NULL,
      started_at TIMESTAMP NOT NULL
    )
  )
)
