###Connection
RelationalDatabaseConnection test::copperestuary3::connection::KilnLogConnection
{
  store: test::copperestuary3::store::KilnLogDb;
  type: Snowflake;
  quoteIdentifiers: false;
  specification: Snowflake
  {
    name: 'EXAMPLE_KILN_DB';
    account: 'example_kiln_account';
    warehouse: 'EXAMPLE_KILN_WH';
    region: 'eu-west-1';
    cloudType: 'aws';
    role: 'EXAMPLE_KILN_READER';
  };
  auth: OAuth
  {
    oauthKey: 'exampleKilnLogOauthKey';
    scopeName: 'session:role:EXAMPLE_KILN_READER';
  };
}

RelationalDatabaseConnection test::copperestuary3::connection::KilnArchiveConnection
{
  store: test::copperestuary3::store::KilnArchiveDb;
  type: Snowflake;
  quoteIdentifiers: false;
  specification: Snowflake
  {
    name: 'EXAMPLE_KILN_ARCHIVE_DB';
    account: 'example_kiln_account';
    warehouse: 'EXAMPLE_KILN_ARCHIVE_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    role: 'EXAMPLE_KILN_ARCHIVIST';
  };
  auth: OAuth
  {
    oauthKey: 'exampleKilnArchiveOauthKey';
    scopeName: 'session:role:EXAMPLE_KILN_ARCHIVIST';
  };
}
