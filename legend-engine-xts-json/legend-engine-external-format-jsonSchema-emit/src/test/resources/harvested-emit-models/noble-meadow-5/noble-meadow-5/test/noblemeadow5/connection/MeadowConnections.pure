###Connection
RelationalDatabaseConnection test::noblemeadow5::connection::MeadowSurveyConnection
{
  store: test::noblemeadow5::store::MeadowDb;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'MEADOW_SURVEY_DB';
    account: 'example_meadow_account';
    warehouse: 'MEADOW_SURVEY_WH';
    region: 'us-east-1';
  };
  auth: OAuth
  {
    oauthKey: 'meadow_survey_oauth_key';
    scopeName: 'SESSION:ROLE:MEADOW_SURVEY_READER';
  };
}

###Connection
ModelChainConnection test::noblemeadow5::connection::PlotChainConnection
{
  mappings:
  [
    test::noblemeadow5::mapping::PlotBaseMapping
  ];
}
