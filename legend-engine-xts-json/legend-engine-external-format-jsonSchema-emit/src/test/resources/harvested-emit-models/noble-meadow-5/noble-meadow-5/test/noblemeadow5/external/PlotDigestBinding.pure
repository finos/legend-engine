###ExternalFormat
Binding test::noblemeadow5::external::PlotDigestJsonBinding
{
  schemaSet: test::noblemeadow5::external::PlotDigestJsonSchemas;
  schemaId: plotDigest;
  contentType: 'application/json';
  modelIncludes:
  [
    test::noblemeadow5::domain::PlotDigest
  ];
}

SchemaSet test::noblemeadow5::external::PlotDigestJsonSchemas
{
  format: JSON;
  schemas:
  [
    {
      id: plotDigest;
      location: 'PlotDigest.json';
      content: '{\n  "title": "test::noblemeadow5::domain::PlotDigest",\n  "type": "object",\n  "required": ["digestKey", "digestName", "habitatText", "visitText", "feedLabel"],\n  "properties": {\n    "digestKey":   { "type": "integer" },\n    "digestName":  { "type": "string" },\n    "habitatText": { "type": "string" },\n    "visitText":   { "type": "string" },\n    "wardenText":  { "type": "string" },\n    "feedLabel":   { "type": "string" }\n  }\n}';
    }
  ];
}
