###Mapping
Mapping test::noblemeadow5::mapping::PlotBaseMapping
(
  *test::noblemeadow5::domain::PollinatorPlot[plot]: Relational
  {
    ~primaryKey
    (
      [test::noblemeadow5::store::MeadowDb]survey.plot_visit.plot_id
    )
    ~mainTable [test::noblemeadow5::store::MeadowDb]survey.plot_visit
    plotId: [test::noblemeadow5::store::MeadowDb]survey.plot_visit.plot_id,
    plotName: concat(toUpper(replace([test::noblemeadow5::store::MeadowDb]survey.plot_visit.plot_name, '_', ' ')), ' MEADOW'),
    habitatLabel: concat('HAB-', toUpper(replace([test::noblemeadow5::store::MeadowDb]survey.plot_visit.habitat_code, '_', '-'))),
    visitTally: [test::noblemeadow5::store::MeadowDb]survey.plot_visit.visit_tally,
    wardenNote: [test::noblemeadow5::store::MeadowDb]survey.plot_visit.warden_note
  }

  testSuites:
  [
    plotBaseSuite:
    {
      function: |test::noblemeadow5::domain::PollinatorPlot.all()->project(
        [
          p|$p.plotId,
          p|$p.plotName,
          p|$p.habitatLabel,
          p|$p.visitTally
        ],
        [
          'PlotId',
          'PlotName',
          'HabitatLabel',
          'VisitTally'
        ]
      )->sort(
        [
          asc('PlotId')
        ]
      );
      tests:
      [
        transformedPlots:
        {
          doc: 'Projects the inherited plot identity together with the nested string-function transforms that normalise the plot name and the habitat code.';
          data:
          [
            test::noblemeadow5::store::MeadowDb:
              Relational
              #{
                survey.plot_visit:
                  'plot_id,plot_name,habitat_code,visit_tally,warden_note\n'+
                  '1,upper_corrie,dry_calcareous,44,early flowering\n'+
                  '2,tarn_shoulder,wet_flush,17,\n';
              }#
          ];
          asserts:
          [
            normalisedPlots:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"PlotId":1,"PlotName":"UPPER CORRIE MEADOW","HabitatLabel":"HAB-DRY-CALCAREOUS","VisitTally":44},{"PlotId":2,"PlotName":"TARN SHOULDER MEADOW","HabitatLabel":"HAB-WET-FLUSH","VisitTally":17}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
