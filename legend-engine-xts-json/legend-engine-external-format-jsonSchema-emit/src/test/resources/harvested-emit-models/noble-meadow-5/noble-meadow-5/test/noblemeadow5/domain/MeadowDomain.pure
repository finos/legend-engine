###Pure
import test::noblemeadow5::domain::*;

Class {meta::pure::profiles::doc.doc = 'Shared identity of any surveyed alpine meadow plot.'} test::noblemeadow5::domain::SurveyPlot
{
  plotId: Integer[1];
  plotName: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A meadow plot surveyed for pollinator visits; specialises the base plot identity with habitat and tally attributes.'} test::noblemeadow5::domain::PollinatorPlot extends SurveyPlot
{
  habitatLabel: String[1];
  visitTally: Integer[1];
  wardenNote: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'Published pollinator plot digest shape, produced from the relationally resolved plot and serialised through a JSON binding.'} test::noblemeadow5::domain::PlotDigest
{
  digestKey: Integer[1];
  digestName: String[1];
  habitatText: String[1];
  visitText: String[1];
  wardenText: String[0..1];
  feedLabel: String[1];
}
