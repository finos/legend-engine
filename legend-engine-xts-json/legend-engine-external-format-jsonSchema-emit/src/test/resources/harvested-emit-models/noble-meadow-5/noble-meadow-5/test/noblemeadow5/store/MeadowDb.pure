###Relational
Database test::noblemeadow5::store::MeadowDb
(
  Schema survey
  (
    Table plot_visit
    (
      plot_id INTEGER PRIMARY KEY,
      plot_name VARCHAR(80) NOT NULL,
      habitat_code VARCHAR(40) NOT NULL,
      visit_tally INTEGER NOT NULL,
      warden_note VARCHAR(120)
    )
  )
)
