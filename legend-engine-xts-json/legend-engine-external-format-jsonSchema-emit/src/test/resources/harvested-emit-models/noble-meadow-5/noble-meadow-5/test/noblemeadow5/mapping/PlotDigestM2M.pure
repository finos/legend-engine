###Mapping
Mapping test::noblemeadow5::mapping::PlotDigestM2M
(
  *test::noblemeadow5::domain::PlotDigest[digest]: Pure
  {
    ~src test::noblemeadow5::domain::PollinatorPlot
    digestKey: $src.plotId,
    digestName: $src.plotName,
    habitatText: $src.habitatLabel,
    visitText: $src.visitTally->toString(),
    wardenText: $src.wardenNote,
    feedLabel: 'MEADOW-POLLINATOR-FEED'
  }

  testSuites:
  [
    plotDigestSuite:
    {
      function: |test::noblemeadow5::domain::PlotDigest.all()->graphFetch(
        #{
          test::noblemeadow5::domain::PlotDigest{
            digestKey,
            digestName,
            habitatText,
            visitText,
            wardenText,
            feedLabel
          }
        }#
      )->serialize(
        #{
          test::noblemeadow5::domain::PlotDigest{
            digestKey,
            digestName,
            habitatText,
            visitText,
            wardenText,
            feedLabel
          }
        }#
      );
      tests:
      [
        digestFromResolvedPlot:
        {
          doc: 'Reshapes a plot instance produced by the relational layer into the published digest, renaming properties and stamping the constant feed label.';
          data:
          [
            ModelStore:
              ModelStore
              #{
                test::noblemeadow5::domain::PollinatorPlot:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"plotId":1,"plotName":"UPPER CORRIE MEADOW","habitatLabel":"HAB-DRY-CALCAREOUS","visitTally":44,"wardenNote":"early flowering"}';
                  }#
              }#
          ];
          asserts:
          [
            digestShape:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"digestKey":1,"digestName":"UPPER CORRIE MEADOW","habitatText":"HAB-DRY-CALCAREOUS","visitText":"44","wardenText":"early flowering","feedLabel":"MEADOW-POLLINATOR-FEED"}';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
