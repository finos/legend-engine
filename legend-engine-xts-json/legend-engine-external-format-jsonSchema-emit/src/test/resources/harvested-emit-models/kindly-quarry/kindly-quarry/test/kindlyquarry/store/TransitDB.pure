###Relational
Database demo::kindlyquarry::store::TransitDB
(
  Schema network
  (
    Table stop_point
    (
      stop_id INTEGER PRIMARY KEY,
      stop_code VARCHAR(32) NOT NULL,
      stop_name VARCHAR(120) NOT NULL,
      shelter_code CHAR(1) NOT NULL,
      corridor_id INTEGER NOT NULL,
      opened_on DATE NOT NULL
    )
    Table corridor
    (
      corridor_id INTEGER PRIMARY KEY,
      corridor_code VARCHAR(32) NOT NULL,
      corridor_name VARCHAR(120) NOT NULL
    )
  )

  Schema planning
  (
    Table proposed_corridor
    (
      corridor_id INTEGER PRIMARY KEY,
      corridor_code VARCHAR(32) NOT NULL,
      corridor_name VARCHAR(120) NOT NULL
    )
    Table patronage_count
    (
      count_id INTEGER PRIMARY KEY,
      stop_id INTEGER NOT NULL,
      counted_on DATE NOT NULL,
      boardings INTEGER NOT NULL
    )
  )

  Join Stop_Corridor(network.stop_point.corridor_id = network.corridor.corridor_id)
  Join Patronage_Stop(planning.patronage_count.stop_id = network.stop_point.stop_id)
)
