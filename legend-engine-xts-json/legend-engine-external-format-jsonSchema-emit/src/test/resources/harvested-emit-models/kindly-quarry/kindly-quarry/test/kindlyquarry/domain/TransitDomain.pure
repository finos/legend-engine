import demo::kindlyquarry::domain::*;
import meta::pure::profiles::*;

Class {doc.doc = 'A boarding point on the surface transit network, carrying the shelter fitment that decides its published access band.'} demo::kindlyquarry::domain::StopPoint
{
  stopCode: String[1];
  stopName: String[1];
  stopLabel: String[1];
  shelterCode: String[1];
  accessBand: String[0..1];
  corridorName: String[1];
  openedOn: StrictDate[1];
}

Class {doc.doc = 'A named transit corridor, either operating today or held in the planning register.'} demo::kindlyquarry::domain::Corridor
{
  corridorCode: String[1];
  corridorName: String[1];
  registerName: String[1];
}

Class {doc.doc = 'A counted boarding tally at one stop on one counting day, reaching its corridor across the stop it was counted at.'} demo::kindlyquarry::domain::PatronageCount
{
  stopCode: String[1];
  countedOn: StrictDate[1];
  boardings: Integer[1];
  corridorName: String[1];
}
