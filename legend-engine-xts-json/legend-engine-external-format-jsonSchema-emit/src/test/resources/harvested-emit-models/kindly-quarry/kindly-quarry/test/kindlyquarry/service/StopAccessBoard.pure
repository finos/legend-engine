###Service
Service demo::kindlyquarry::service::StopAccessBoard
{
  pattern: '/kindlyquarry/v1/stop-access-board/{shelterCodes}';
  title: 'Kindly Quarry - Stop Access Board';
  owners:
  [
    'transit-network-planning'
  ];
  documentation: 'Selects boarding points whose shelter fitment is in the requested set and which were opened before the reporting epoch, then projects the banded access surface as a relation, ordered by stop code and capped for publication.';
  autoActivateUpdates: true;
  execution: Multi
  {
    query: {shelterCodes: String[*]|demo::kindlyquarry::domain::StopPoint.all()->filter(
      s | $s.shelterCode->in($shelterCodes) && (dateDiff($s.openedOn, %2026-01-01, DurationUnit.DAYS) > 0)
    )->project(
      ~[
        stopCode: s|$s.stopCode,
        stopLabel: s|$s.stopLabel,
        accessBand: s|$s.accessBand,
        corridorName: s|$s.corridorName
      ]
    )->sort(~stopCode->ascending())->limit(20)};
    key: 'register';
    executions['published']:
    {
      mapping: demo::kindlyquarry::mapping::TransitMapping;
      runtime: demo::kindlyquarry::runtime::TransitWarehouseRuntime;
    }
    executions['inProcess']:
    {
      mapping: demo::kindlyquarry::mapping::TransitMapping;
      runtime: demo::kindlyquarry::runtime::TransitH2Runtime;
    }
  }
}
