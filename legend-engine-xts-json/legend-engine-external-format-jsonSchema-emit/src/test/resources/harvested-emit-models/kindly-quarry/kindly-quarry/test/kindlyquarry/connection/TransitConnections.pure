###Connection
RelationalDatabaseConnection demo::kindlyquarry::connection::TransitWarehouseConnection
{
  store: demo::kindlyquarry::store::TransitDB;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'TRANSIT_DB';
    account: 'transit_planning_account';
    warehouse: 'TRANSIT_WH';
    region: 'eu-west-1';
  };
  auth: OAuth
  {
    oauthKey: 'TRANSIT_OAUTH';
    scopeName: 'SESSION:ROLE:TRANSIT_READER';
  };
  postProcessors:
  [
    mapper
    {
      mappers:
      [
        schema {from: 'network'; to: 'NETWORK_PUBLISHED';},
        table {from: 'stop_point'; to: 'STOP_POINT_CURRENT'; schemaFrom: 'network'; schemaTo: 'NETWORK_PUBLISHED';}
      ];
    }
  ];
}


###Connection
RelationalDatabaseConnection demo::kindlyquarry::connection::TransitH2Connection
{
  store: demo::kindlyquarry::store::TransitDB;
  type: H2;
  specification: LocalH2 { testDataSetupSqls: []; };
  auth: DefaultH2;
}
