###Service
Service demo::kindlyquarry::service::CorridorPatronageRank
{
  pattern: '/kindlyquarry/v1/corridor-patronage-rank/{since}';
  title: 'Kindly Quarry - Corridor Patronage Rank';
  owners:
  [
    'transit-network-planning'
  ];
  documentation: 'Rolls counted boardings up to the corridor each count reaches across the count-to-stop-to-corridor path, ranks the corridors with a window function over the rolled-up totals and returns the busiest few.';
  autoActivateUpdates: true;
  execution: Multi
  {
    query: {since: StrictDate[1]|demo::kindlyquarry::domain::PatronageCount.all()->filter(
      p | dateDiff($since, $p.countedOn, DurationUnit.DAYS) >= 0
    )->project(
      ~[
        corridorName: p|$p.corridorName,
        boardings: p|$p.boardings
      ]
    )->groupBy(
      ~[corridorName],
      ~[totalBoardings: x|$x.boardings: y|$y->sum()]
    )->extend(
      ~corridorName->over(~totalBoardings->descending()),
      ~patronageRank: {p, w, r | $p->rowNumber($r)}
    )->sort(~totalBoardings->descending())->limit(3)};
    key: 'horizon';
    executions['published']:
    {
      mapping: demo::kindlyquarry::mapping::TransitMapping;
      runtime: demo::kindlyquarry::runtime::TransitWarehouseRuntime;
    }
    executions['inProcess']:
    {
      mapping: demo::kindlyquarry::mapping::TransitMapping;
      runtime: demo::kindlyquarry::runtime::TransitH2Runtime;
    }
  }
}
