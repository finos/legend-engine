###Connection
RelationalDatabaseConnection test::wistfulharbor3::connection::ColonySurveyConnection
{
  store: test::wistfulharbor3::store::ColonyDb;
  type: Snowflake;
  timezone: +0000;
  quoteIdentifiers: false;
  specification: Snowflake
  {
    name: 'COLONY_SURVEY_DB';
    account: 'colony_survey_account';
    warehouse: 'COLONY_SURVEY_WH';
    region: 'eu-west-2';
    cloudType: 'aws';
  };
  auth: OAuth
  {
    oauthKey: 'colonySurveyConnectionKey';
    scopeName: 'session:role-colony-survey-reader';
  };
  postProcessors:
  [
    mapper
    {
      mappers:
      [
        schema {from: 'census'; to: 'census_survey';}
      ];
    }
  ];
}

###Connection
RelationalDatabaseConnection test::wistfulharbor3::connection::ColonyArchiveConnection
{
  store: test::wistfulharbor3::store::ColonyDb;
  type: Snowflake;
  timezone: +0000;
  quoteIdentifiers: false;
  specification: Snowflake
  {
    name: 'COLONY_ARCHIVE_DB';
    account: 'colony_survey_account';
    warehouse: 'COLONY_ARCHIVE_WH';
    region: 'eu-west-2';
    cloudType: 'aws';
  };
  auth: OAuth
  {
    oauthKey: 'colonyArchiveConnectionKey';
    scopeName: 'session:role-colony-archive-reader';
  };
  postProcessors:
  [
    mapper
    {
      mappers:
      [
        schema {from: 'census'; to: 'census_archive';},
        table {from: 'nest_count'; to: 'nest_count_archive'; schemaFrom: 'census'; schemaTo: 'census_archive';}
      ];
    }
  ];
}
