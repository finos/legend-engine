###ExternalFormat
Binding test::wistfulharbor3::binding::NestCountBinding
{
  contentType: 'application/json';
  modelIncludes: [
    test::wistfulharbor3::domain::NestCount,
    test::wistfulharbor3::domain::Colony
  ];
}

Binding test::wistfulharbor3::binding::FledglingBinding
{
  contentType: 'application/json';
  modelIncludes: [
    test::wistfulharbor3::domain::FledglingTally,
    test::wistfulharbor3::domain::Observer
  ];
}
