###Relational
Database test::wistfulharbor3::store::ColonyDb
(
  Schema census
  (
    Table colony
    (
      colony_code VARCHAR(16) PRIMARY KEY,
      colony_name VARCHAR(80) NOT NULL,
      headland_name VARCHAR(80)
    )
    Table nest_count
    (
      record_code VARCHAR(16) PRIMARY KEY,
      survey_date DATE NOT NULL,
      colony_code VARCHAR(16) NOT NULL,
      species_name VARCHAR(80) NOT NULL,
      occupied_nests INTEGER NOT NULL
    )
    Table fledgling_tally
    (
      record_code VARCHAR(16) PRIMARY KEY,
      survey_date DATE NOT NULL,
      observer_code VARCHAR(16) NOT NULL,
      fledglings INTEGER NOT NULL
    )
    Table observer
    (
      observer_code VARCHAR(16) PRIMARY KEY,
      display_name VARCHAR(80) NOT NULL
    )
  )

  Join NestColony(census.nest_count.colony_code = census.colony.colony_code)
  Join TallyObserver(census.fledgling_tally.observer_code = census.observer.observer_code)
)
