###Pure
import test::wistfulharbor3::domain::*;

Class test::wistfulharbor3::domain::CensusRecord
{
  recordCode: String[1];
  surveyDate: StrictDate[1];
}

Class test::wistfulharbor3::domain::Observer
{
  observerCode: String[1];
  displayName: String[1];
}

Class test::wistfulharbor3::domain::Colony
{
  colonyCode: String[1];
  colonyName: String[1];
  headlandName: String[0..1];
}

Class test::wistfulharbor3::domain::NestCount extends CensusRecord
{
  speciesName: String[1];
  occupiedNests: Integer[1];
  colony: Colony[0..1];
}

Class test::wistfulharbor3::domain::FledglingTally extends CensusRecord
{
  fledglings: Integer[1];
  observer: Observer[0..1];
}
