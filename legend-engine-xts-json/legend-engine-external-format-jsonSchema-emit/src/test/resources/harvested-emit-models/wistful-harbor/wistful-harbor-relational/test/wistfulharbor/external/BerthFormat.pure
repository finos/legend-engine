###ExternalFormat
Binding test::wistfulharbor::external::BerthJsonBinding
{
  schemaSet: test::wistfulharbor::external::BerthJsonSchemas;
  schemaId: berth;
  contentType: 'application/json';
  modelIncludes: [
    test::wistfulharbor::domain::Berth
  ];
}

SchemaSet test::wistfulharbor::external::BerthJsonSchemas
{
  format: JSON;
  schemas: [
    {
      id: berth;
      location: 'Berth.json';
      content: '{\n  "title": "test::wistfulharbor::domain::Berth",\n  "type": "object",\n  "required": ["berthId", "label", "slots"],\n  "properties": {\n    "berthId": { "type": "integer" },\n    "label":   { "type": "string" },\n    "slots":   { "type": "integer", "minimum": 0 }\n  }\n}';
    }
  ];
}
