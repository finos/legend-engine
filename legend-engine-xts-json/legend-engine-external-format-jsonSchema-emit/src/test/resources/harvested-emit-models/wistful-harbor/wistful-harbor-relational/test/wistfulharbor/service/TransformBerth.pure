###Service
Service test::wistfulharbor::service::TransformBerth
{
  pattern: '/harbor/v1/berth/transform';
  title: 'Harbor - Transform Berth (M2M)';
  owners:
  [
    'harbour-registry-platform',
    'marine-eng'
  ];
  documentation: 'Single-execution model-to-model service that accepts an inbound berth feed record as JSON and returns the graph-fetched berth object tree.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |test::wistfulharbor::domain::Berth.all()->graphFetch(
      #{
        test::wistfulharbor::domain::Berth{
          berthId,
          label,
          slots
        }
      }#
    )->serialize(
      #{
        test::wistfulharbor::domain::Berth{
          berthId,
          label,
          slots
        }
      }#
    );
    mapping: test::wistfulharbor::mapping::BerthM2M;
    runtime: test::wistfulharbor::runtime::BerthRuntime;
  }
  testSuites:
  [
    transformBerthSuite:
    {
      data:
      [
        connections:
        [
          berthFeedConnection:
            ExternalFormat
            #{
              contentType: 'application/json';
              data: '{"id":9,"lbl":"North Quay","n":21}';
            }#
        ]
      ]
      tests:
      [
        northQuay:
        {
          asserts:
          [
            transformed:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":{"berthId":9,"label":"North Quay","slots":21}}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
