###Mapping
Mapping test::wistfulharbor::mapping::HarborMapping
(
  test::wistfulharbor::domain::Propulsion: EnumerationMapping PropulsionMap
  {
    Sail: ['S'],
    Steam: ['T'],
    Diesel: ['D']
  }

  *test::wistfulharbor::domain::Ferry[ferry]: Relational
  {
    ~primaryKey
    (
      [test::wistfulharbor::store::HarborDb]fleet.ferry.vessel_id
    )
    ~mainTable [test::wistfulharbor::store::HarborDb]fleet.ferry
    vesselId: [test::wistfulharbor::store::HarborDb]fleet.ferry.vessel_id,
    name: [test::wistfulharbor::store::HarborDb]fleet.ferry.name,
    propulsion: EnumerationMapping PropulsionMap: [test::wistfulharbor::store::HarborDb]fleet.ferry.propulsion_code,
    capacity: [test::wistfulharbor::store::HarborDb]fleet.ferry.capacity
  }

  testSuites:
  [
    ferryProjectionSuite:
    {
      function: |test::wistfulharbor::domain::Ferry.all()->filter(
        f|$f.propulsion == test::wistfulharbor::domain::Propulsion.Diesel
      )->project(
        [
          f|$f.vesselId,
          f|$f.name,
          f|$f.capacity
        ],
        [
          'VesselId',
          'Name',
          'Capacity'
        ]
      )->sort(
        [
          asc('VesselId')
        ]
      );
      tests:
      [
        dieselFerries:
        {
          doc: 'Projects an inherited base-class property and subclass properties for ferries filtered by an enum-mapped propulsion class.';
          data:
          [
            test::wistfulharbor::store::HarborDb:
              Relational
              #{
                fleet.ferry:
                  'vessel_id,name,propulsion_code,capacity\n'+
                  '1,Harbour Star,D,180\n'+
                  '2,Bay Breeze,S,60\n'+
                  '3,Tide Runner,D,240\n';
              }#
          ];
          asserts:
          [
            diesel:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"VesselId":1,"Name":"Harbour Star","Capacity":180},{"VesselId":3,"Name":"Tide Runner","Capacity":240}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
