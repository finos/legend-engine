Profile test::wistfulharbor::domain::HarborProfile
{
  stereotypes: [charted];
  tags: [origin];
}

Enum {meta::pure::profiles::doc.doc = 'Dominant propulsion class of a harbour vessel.'} test::wistfulharbor::domain::Propulsion
{
  Sail,
  Steam,
  Diesel
}

Class {meta::pure::profiles::doc.doc = 'Base identity for a harbour vessel.'} test::wistfulharbor::domain::Vessel
{
  vesselId: Integer[1];
  name: String[1];
}

Class <<test::wistfulharbor::domain::HarborProfile.charted>> {meta::pure::profiles::doc.doc = 'A ferry specialising a vessel with a propulsion class and a passenger capacity.', test::wistfulharbor::domain::HarborProfile.origin = 'harbour-registry'} test::wistfulharbor::domain::Ferry extends test::wistfulharbor::domain::Vessel
{
  propulsion: test::wistfulharbor::domain::Propulsion[1];
  capacity: Integer[1];
}

Class {meta::pure::profiles::doc.doc = 'A mooring berth surfaced by a model-to-model service.'} test::wistfulharbor::domain::Berth
{
  berthId: Integer[1];
  label: String[1];
  slots: Integer[1];
}

Class {meta::pure::profiles::doc.doc = 'Inbound denormalised berth feed record (non-relational source shape).'} test::wistfulharbor::domain::BerthFeed
{
  id: Integer[1];
  lbl: String[1];
  n: Integer[1];
}
