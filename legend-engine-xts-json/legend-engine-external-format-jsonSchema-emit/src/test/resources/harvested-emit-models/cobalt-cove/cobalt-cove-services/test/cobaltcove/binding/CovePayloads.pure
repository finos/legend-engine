import demo::cobaltcove::payload::*;

Class {meta::pure::profiles::doc.doc = 'Wire shape of one row of the district dock-audit response.'} demo::cobaltcove::payload::StationAuditRow
{
  stationCode: String[1];
  districtCode: String[1];
  districtName: String[1];
  capacity: Integer[1];
  capacityBand: String[1];
}

Class {meta::pure::profiles::doc.doc = 'Wire shape of one row of the single-station detail response.'} demo::cobaltcove::payload::StationDetailRow
{
  stationCode: String[1];
  capacity: Integer[1];
  capacityBand: String[1];
  blockedInspections: Integer[1];
}

Class {meta::pure::profiles::doc.doc = 'Wire shape of one row of the inspection log response.'} demo::cobaltcove::payload::InspectionLogRow
{
  inspectionRef: String[1];
  conditionLabel: String[1];
  faultCount: Integer[1];
  stationCode: String[1];
}

###ExternalFormat
Binding demo::cobaltcove::binding::StationAuditBinding
{
  contentType: 'application/json';
  modelIncludes:
  [
    demo::cobaltcove::payload::StationAuditRow
  ];
}

Binding demo::cobaltcove::binding::StationDetailBinding
{
  contentType: 'application/json';
  modelIncludes:
  [
    demo::cobaltcove::payload::StationDetailRow
  ];
}

Binding demo::cobaltcove::binding::InspectionLogBinding
{
  contentType: 'application/json';
  modelIncludes:
  [
    demo::cobaltcove::payload::InspectionLogRow
  ];
}
