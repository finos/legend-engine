###Mapping
Mapping demo::cobaltcove::mapping::CoveMapping
(
  demo::cobaltcove::domain::DockCondition: EnumerationMapping DockConditionMapping
  {
    SERVICEABLE: ['SERVICEABLE'],
    WORN: ['WORN'],
    BLOCKED: ['BLOCKED']
  }

  *demo::cobaltcove::domain::District[district]: Relational
  {
    ~primaryKey
    (
      [demo::cobaltcove::store::CoveDB]civic.district.district_id
    )
    ~mainTable [demo::cobaltcove::store::CoveDB]civic.district
    districtCode: [demo::cobaltcove::store::CoveDB]civic.district.district_code,
    districtName: [demo::cobaltcove::store::CoveDB]civic.district.district_name
  }

  *demo::cobaltcove::domain::DockStation[dockStation]: Relational
  {
    ~primaryKey
    (
      [demo::cobaltcove::store::CoveDB]civic.dock_station.station_id
    )
    ~mainTable [demo::cobaltcove::store::CoveDB]civic.dock_station
    stationCode: [demo::cobaltcove::store::CoveDB]civic.dock_station.station_code,
    capacity: [demo::cobaltcove::store::CoveDB]civic.dock_station.capacity,
    statusCode: [demo::cobaltcove::store::CoveDB]civic.dock_station.status_code,
    districtCode: [demo::cobaltcove::store::CoveDB]@Station_District | civic.district.district_code
  }

  *demo::cobaltcove::domain::DockInspection[dockInspection]: Relational
  {
    ~primaryKey
    (
      [demo::cobaltcove::store::CoveDB]civic.dock_inspection.inspection_id
    )
    ~mainTable [demo::cobaltcove::store::CoveDB]civic.dock_inspection
    inspectionRef: [demo::cobaltcove::store::CoveDB]civic.dock_inspection.inspection_ref,
    condition: EnumerationMapping DockConditionMapping: [demo::cobaltcove::store::CoveDB]civic.dock_inspection.condition_code,
    faultCount: [demo::cobaltcove::store::CoveDB]civic.dock_inspection.fault_count
  }

  demo::cobaltcove::domain::Station_District: Relational
  {
    AssociationMapping
    (
      district[dockStation, district]: [demo::cobaltcove::store::CoveDB]@Station_District,
      station[district, dockStation]: [demo::cobaltcove::store::CoveDB]@Station_District
    )
  }

  demo::cobaltcove::domain::Station_Inspection: Relational
  {
    AssociationMapping
    (
      inspections[dockStation, dockInspection]: [demo::cobaltcove::store::CoveDB]@Station_Inspection,
      station[dockInspection, dockStation]: [demo::cobaltcove::store::CoveDB]@Station_Inspection
    )
  }
)
