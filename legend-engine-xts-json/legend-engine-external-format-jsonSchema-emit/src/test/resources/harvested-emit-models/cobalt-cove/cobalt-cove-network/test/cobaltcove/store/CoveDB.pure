###Relational
Database demo::cobaltcove::store::CoveDB
(
  Schema civic
  (
    Table district
    (
      district_id INTEGER PRIMARY KEY,
      district_code VARCHAR(20) NOT NULL,
      district_name VARCHAR(120) NOT NULL
    )
    Table dock_station
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      station_id INTEGER PRIMARY KEY,
      station_code VARCHAR(20) NOT NULL,
      capacity INTEGER NOT NULL,
      status_code VARCHAR(20) NOT NULL,
      district_id INTEGER NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
    Table dock_inspection
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z),
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      inspection_id INTEGER PRIMARY KEY,
      inspection_ref VARCHAR(20) NOT NULL,
      condition_code VARCHAR(20) NOT NULL,
      fault_count INTEGER NOT NULL,
      station_id INTEGER NOT NULL,
      in_z DATE NOT NULL,
      out_z DATE NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
  )

  Join Station_District(civic.dock_station.district_id = civic.district.district_id)

  Join Station_Inspection(civic.dock_station.station_id = civic.dock_inspection.station_id)
)
