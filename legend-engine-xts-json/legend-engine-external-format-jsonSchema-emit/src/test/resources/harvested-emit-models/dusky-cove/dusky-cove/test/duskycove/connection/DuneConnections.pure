###Connection
RelationalDatabaseConnection test::duskycove::connection::DuneSurveyConnection
{
  store: test::duskycove::store::DunePlantingDatabase;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [];
  };
  auth: DefaultH2;
}

###Connection
RelationalDatabaseConnection test::duskycove::connection::DuneRegisterConnection
{
  store: test::duskycove::store::DunePlantingDatabase;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'DUNE_PLANTING_DB';
    account: 'example_dune_account';
    warehouse: 'DUNE_PLANTING_WH';
    region: 'us-east-1';
  };
  auth: OAuth
  {
    oauthKey: 'dune_planting_oauth_key';
    scopeName: 'SESSION:ROLE:DUNE_PLANTING_READER';
  };
}
