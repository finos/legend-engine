###Relational
Database test::quietdelta3::store::GreenhouseDb
(
  Schema nursery
  (
    Table bloom_log
    (
      log_id INTEGER PRIMARY KEY,
      bench_code VARCHAR(8) NOT NULL,
      stage_code VARCHAR(16),
      note_text VARCHAR(64),
      petal_count INTEGER NOT NULL,
      vigour_code VARCHAR(1)
    )
    Table bench_row
    (
      bench_code VARCHAR(8) PRIMARY KEY,
      house_code VARCHAR(8) NOT NULL
    )
    Table glass_house
    (
      house_code VARCHAR(8) PRIMARY KEY,
      site_code VARCHAR(8) NOT NULL
    )
    Table grow_site
    (
      site_code VARCHAR(8) PRIMARY KEY,
      site_name VARCHAR(32) NOT NULL,
      opened_at TIMESTAMP NOT NULL
    )
  )

  Join Bloom_Bench(nursery.bloom_log.bench_code = nursery.bench_row.bench_code)
  Join Bench_House(nursery.bench_row.house_code = nursery.glass_house.house_code)
  Join House_Site(nursery.glass_house.site_code = nursery.grow_site.site_code)
)
