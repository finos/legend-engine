###Connection
RelationalDatabaseConnection test::quietdelta3::connection::GreenhouseWarehouseConnection
{
  store: test::quietdelta3::store::GreenhouseDb;
  type: Snowflake;
  timezone: 'UTC';
  specification: Snowflake
  {
    name: 'GREENHOUSE_BLOOMS';
    account: 'greenhouse_blooms_account';
    warehouse: 'GREENHOUSE_BLOOMS_WH';
    region: 'us-east-1';
    cloudType: 'aws';
  };
  auth: OAuth
  {
    oauthKey: 'greenhouse_blooms_oauth_key';
    scopeName: 'SESSION:ROLE-ANY';
  };
  postProcessors:
  [
    mapper
    {
      mappers:
      [
        schema {from: 'nursery'; to: 'nursery_curated';}
      ];
    }
  ];
}

RelationalDatabaseConnection test::quietdelta3::connection::GreenhouseArchiveConnection
{
  store: test::quietdelta3::store::GreenhouseDb;
  type: DB2;
  specification: Static
  {
    name: 'GREENHOUSE_ARCHIVE_DB';
    host: 'greenhouse-archive-host.example.invalid';
    port: 50000;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'greenhousearchiveprincipal';
  };
}
