###Pure
Enum {meta::pure::profiles::doc.doc = 'Vigour grade a grower assigns to a flowering plant at each bloom log.'} test::quietdelta3::domain::Vigour
{
  Robust,
  Steady,
  Weak
}

Class {meta::pure::profiles::doc.doc = 'One bloom log entry for an orchid on a greenhouse bench, carrying its decoded flowering stage and the opening time of the grow site reached through bench and glasshouse.'} test::quietdelta3::domain::BloomLog
{
  {meta::pure::profiles::doc.doc = 'Sequence number of the log entry.'} logId: Integer[1];
  {meta::pure::profiles::doc.doc = 'Bench the plant stands on.'} benchCode: String[1];
  {meta::pure::profiles::doc.doc = 'Glasshouse the bench belongs to, reached over one hop.'} houseCode: String[0..1];
  {meta::pure::profiles::doc.doc = 'Opening time of the grow site, reached over bench, glasshouse and site.'} siteOpenedAt: DateTime[0..1];
  {meta::pure::profiles::doc.doc = 'Flowering stage decoded from the normalised stage code, absent for unknown codes.'} stageLabel: String[0..1];
  {meta::pure::profiles::doc.doc = 'Whether the grower left a note, decoded from the normalised note text.'} noteFlag: String[1];
  {meta::pure::profiles::doc.doc = 'Open petals counted at the log.'} petalCount: Integer[1];
  {meta::pure::profiles::doc.doc = 'Vigour grade decoded from the single-letter vigour code.'} vigour: test::quietdelta3::domain::Vigour[0..1];
}

Class {meta::pure::profiles::doc.doc = 'One grow site that hosts glasshouses.'} test::quietdelta3::domain::GrowSite
{
  {meta::pure::profiles::doc.doc = 'Short code of the site.'} siteCode: String[1];
  {meta::pure::profiles::doc.doc = 'Display name of the site with underscores turned into spaces.'} siteName: String[1];
}

Class {meta::pure::profiles::doc.doc = 'Flat bloom tally serialised for the grower newsletter.'} test::quietdelta3::domain::BloomTally
{
  benchCode: String[1];
  openBlooms: Integer[1];
  meanPetals: Float[0..1];
}

Class {meta::pure::profiles::doc.doc = 'Flat exception raised when a bloom log cannot be decoded.'} test::quietdelta3::domain::BloomException
{
  logId: Integer[1];
  reason: String[1];
}
