###ExternalFormat
Binding test::noblewarren2::external::SurveyorRosterBinding
{
  schemaSet: test::noblewarren2::external::SurveyorRosterSchemas;
  contentType: 'application/x.flatdata';
  modelIncludes: [
    test::noblewarren2::source::WarrenSurveyor
  ];
}

Binding test::noblewarren2::external::BurrowSiteBinding
{
  schemaSet: test::noblewarren2::external::BurrowSiteSchemas;
  contentType: 'application/x.flatdata';
  modelIncludes: [
    test::noblewarren2::source::BurrowSite
  ];
}

SchemaSet test::noblewarren2::external::SurveyorRosterSchemas
{
  format: FlatData;
  schemas: [
    {
      id: surveyorRoster;
      location: 'surveyor-roster.csv';
      content: 'section roster: DelimitedWithHeadings\n{\n  scope.untilEof;\n  delimiter: \',\';\n  Record\n  {\n    givenName  : STRING;\n    familyName : STRING;\n  }\n}';
    }
  ];
}

SchemaSet test::noblewarren2::external::BurrowSiteSchemas
{
  format: FlatData;
  schemas: [
    {
      id: burrowSites;
      location: 'burrow-sites.csv';
      content: 'section sites: DelimitedWithHeadings\n{\n  scope.untilEof;\n  delimiter: \',\';\n  Record\n  {\n    siteCode : STRING;\n    siteName : STRING;\n  }\n}';
    }
  ];
}
