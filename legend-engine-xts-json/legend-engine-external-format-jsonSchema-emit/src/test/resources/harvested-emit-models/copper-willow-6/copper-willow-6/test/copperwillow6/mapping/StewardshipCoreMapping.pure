###Mapping
Mapping test::copperwillow6::mapping::StewardshipCoreMapping
(
  *test::copperwillow6::domain::WorkDirective[directive]: Relational
  {
    ~primaryKey
    (
      [test::copperwillow6::store::StewardshipCoreDB]directive.work_directive.directive_code
    )
    ~mainTable [test::copperwillow6::store::StewardshipCoreDB]directive.work_directive
    directiveCode: [test::copperwillow6::store::StewardshipCoreDB]directive.work_directive.directive_code,
    titleText: [test::copperwillow6::store::StewardshipCoreDB]directive.work_directive.title_text,
    regionCode: [test::copperwillow6::store::StewardshipCoreDB]directive.work_directive.region_code,
    stewardLabel: concat(concat(toUpper(substring(trim([test::copperwillow6::store::StewardshipCoreDB]directive.work_directive.region_code), 1, 3)), ' / '), trim([test::copperwillow6::store::StewardshipCoreDB]directive.work_directive.title_text)),
    effortHours: [test::copperwillow6::store::StewardshipCoreDB]directive.work_directive.effort_hours,
    leadVolunteerName: [test::copperwillow6::store::StewardshipCoreDB]@DirectiveLeadVolunteer | participant.volunteer.full_name
  }

  *test::copperwillow6::domain::DirectiveStep[step]: Relational
  {
    ~primaryKey
    (
      [test::copperwillow6::store::StewardshipCoreDB]directive.directive_step.step_code
    )
    ~mainTable [test::copperwillow6::store::StewardshipCoreDB]directive.directive_step
    stepCode: [test::copperwillow6::store::StewardshipCoreDB]directive.directive_step.step_code,
    directiveCode: [test::copperwillow6::store::StewardshipCoreDB]directive.directive_step.directive_code,
    stepOrder: [test::copperwillow6::store::StewardshipCoreDB]directive.directive_step.step_order,
    stepNote: [test::copperwillow6::store::StewardshipCoreDB]directive.directive_step.step_note
  }

  *test::copperwillow6::domain::Volunteer[volunteer]: Relational
  {
    ~primaryKey
    (
      [test::copperwillow6::store::StewardshipCoreDB]participant.volunteer.volunteer_id,
      [test::copperwillow6::store::StewardshipCoreDB]participant.volunteer.batch_in_id
    )
    ~mainTable [test::copperwillow6::store::StewardshipCoreDB]participant.volunteer
    volunteerId: [test::copperwillow6::store::StewardshipCoreDB]participant.volunteer.volunteer_id,
    fullName: [test::copperwillow6::store::StewardshipCoreDB]participant.volunteer.full_name,
    clubCode: [test::copperwillow6::store::StewardshipCoreDB]participant.volunteer.club_code
  }

  *test::copperwillow6::domain::StewardClub[club]: Relational
  {
    ~primaryKey
    (
      [test::copperwillow6::store::StewardshipCoreDB]participant.steward_club.club_code
    )
    ~mainTable [test::copperwillow6::store::StewardshipCoreDB]participant.steward_club
    clubCode: [test::copperwillow6::store::StewardshipCoreDB]participant.steward_club.club_code,
    clubName: [test::copperwillow6::store::StewardshipCoreDB]participant.steward_club.club_name
  }

  test::copperwillow6::domain::Directive_Steps: Relational
  {
    AssociationMapping
    (
      stepDirective[step, directive]: [test::copperwillow6::store::StewardshipCoreDB]@DirectiveStepOwner,
      steps[directive, step]: [test::copperwillow6::store::StewardshipCoreDB]@DirectiveStepOwner
    )
  }

  test::copperwillow6::domain::Club_Volunteers: Relational
  {
    AssociationMapping
    (
      club[volunteer, club]: [test::copperwillow6::store::StewardshipCoreDB]@ClubVolunteer,
      members[club, volunteer]: [test::copperwillow6::store::StewardshipCoreDB]@ClubVolunteer
    )
  }

  testSuites:
  [
    directiveSuite:
    {
      function: |test::copperwillow6::domain::WorkDirective.all()->project(~[directiveCode: d|$d.directiveCode, stewardLabel: d|$d.stewardLabel, effortHours: d|$d.effortHours, leadVolunteerName: d|$d.leadVolunteerName])->sort(~directiveCode->ascending());
      tests:
      [
        openBatchLeadAndRegionLabel:
        {
          doc: 'The steward label upper-cases the first three letters of the trimmed region code and appends the trimmed title; the lead volunteer join only reaches the open-batch volunteer version, so a lead with only a closed version and an unknown lead both yield no name.';
          data:
          [
            test::copperwillow6::store::StewardshipCoreDB:
              Relational
              #{
                directive.work_directive:
                  'directive_code,title_text,region_code,effort_hours,lead_volunteer_id,batch_out_id\n'+
                  'D-01,Clear fallen birch,northwood,6,V-1,999999999\n'+
                  'D-02,Rebuild stile,southridge,3,V-2,999999999\n'+
                  'D-03,Drain culvert,eastfell,,V-9,999999999\n';
                participant.volunteer:
                  'volunteer_id,batch_in_id,batch_out_id,full_name,club_code\n'+
                  'V-1,1,2,Ada Fenn,C-1\n'+
                  'V-1,2,999999999,Ada Fenn-Rowe,C-1\n'+
                  'V-2,1,4,Bram Hollis,C-2\n';
              }#
          ];
          asserts:
          [
            directiveRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"directiveCode":"D-01","stewardLabel":"NOR / Clear fallen birch","effortHours":6,"leadVolunteerName":"Ada Fenn-Rowe"},{"directiveCode":"D-02","stewardLabel":"SOU / Rebuild stile","effortHours":3,"leadVolunteerName":null},{"directiveCode":"D-03","stewardLabel":"EAS / Drain culvert","effortHours":null,"leadVolunteerName":null}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
