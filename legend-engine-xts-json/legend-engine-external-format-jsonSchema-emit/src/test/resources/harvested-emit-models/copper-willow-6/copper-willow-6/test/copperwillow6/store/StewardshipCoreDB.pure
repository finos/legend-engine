###Relational
Database test::copperwillow6::store::StewardshipCoreDB
(
  Schema directive
  (
    Table work_directive
    (
      directive_code VARCHAR(24) PRIMARY KEY,
      title_text VARCHAR(120),
      region_code VARCHAR(12),
      effort_hours INTEGER,
      lead_volunteer_id VARCHAR(24),
      batch_out_id INTEGER
    )
    Table directive_step
    (
      step_code VARCHAR(24) PRIMARY KEY,
      directive_code VARCHAR(24),
      step_order INTEGER,
      step_note VARCHAR(200)
    )
  )
  Schema participant
  (
    Table volunteer
    (
      volunteer_id VARCHAR(24) PRIMARY KEY,
      batch_in_id INTEGER PRIMARY KEY,
      batch_out_id INTEGER,
      full_name VARCHAR(120),
      club_code VARCHAR(12)
    )
    Table steward_club
    (
      club_code VARCHAR(12) PRIMARY KEY,
      club_name VARCHAR(120)
    )
  )

  Join DirectiveLeadVolunteer(directive.work_directive.lead_volunteer_id = participant.volunteer.volunteer_id and participant.volunteer.batch_out_id = 999999999)
  Join DirectiveStepOwner(directive.directive_step.directive_code = directive.work_directive.directive_code)
  Join ClubVolunteer(participant.steward_club.club_code = participant.volunteer.club_code)
)
