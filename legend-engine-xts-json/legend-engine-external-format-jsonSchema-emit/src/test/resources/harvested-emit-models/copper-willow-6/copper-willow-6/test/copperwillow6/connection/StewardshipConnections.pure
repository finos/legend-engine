###Connection
RelationalDatabaseConnection test::copperwillow6::connection::CoreSnowflakeProdConnection
{
  store: test::copperwillow6::store::StewardshipCoreDB;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'COPPER_WILLOW_CORE_PROD';
    account: 'example_copper_willow_account';
    warehouse: 'COPPER_WILLOW_PROD_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    role: 'COPPER_WILLOW_STEWARD_READER';
  };
  auth: OAuth
  {
    oauthKey: 'copper_willow_steward_oauth_key';
    scopeName: 'SESSION:ROLE:COPPER_WILLOW_STEWARD_READER';
  };
  postProcessors:
  [
    mapper
    {
      mappers:
      [
        schema {from: 'directive'; to: 'directive_prod';},
        schema {from: 'participant'; to: 'participant_prod';},
        table {from: 'work_directive'; to: 'work_directive_current'; schemaFrom: 'directive'; schemaTo: 'directive_prod';}
      ];
    }
  ];
}

