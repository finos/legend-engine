RelationalDatabaseConnection test::copperwillow6::connection::CoreMemSqlPrimaryConnection
{
  store: test::copperwillow6::store::StewardshipCoreDB;
  type: MemSQL;
  specification: Static
  {
    name: 'COPPER_WILLOW_DIRECTIVES';
    host: 'copper-willow-directive-primary-host';
    port: 3306;
  };
  auth: DelegatedKerberos;
}

