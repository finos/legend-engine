###Relational
Database test::umberthistle3::store::StudioDB
(
  Schema studio
  (
    Table kiln_booking
    (
      booking_ref VARCHAR(24) PRIMARY KEY,
      member_ref VARCHAR(24),
      kiln_ref VARCHAR(24),
      slot_ref VARCHAR(24),
      glaze_ref VARCHAR(24),
      booked_on DATE,
      firing_hours INTEGER,
      piece_count INTEGER,
      status_ref VARCHAR(16),
      note_text VARCHAR(200)
    )
    Table studio_member
    (
      member_ref VARCHAR(24) PRIMARY KEY,
      member_name VARCHAR(120),
      tier_ref VARCHAR(24),
      region_name VARCHAR(80)
    )
  )
)
