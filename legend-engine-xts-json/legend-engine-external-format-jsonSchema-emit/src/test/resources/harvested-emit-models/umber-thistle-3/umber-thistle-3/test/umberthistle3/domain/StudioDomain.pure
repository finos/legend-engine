###Pure
import meta::pure::profiles::*;

Profile test::umberthistle3::domain::StudioProfile
{
  stereotypes: [tracked, published];
  tags: [studioRole, reviewCycle];
}

Class <<test::umberthistle3::domain::StudioProfile.tracked>> {test::umberthistle3::domain::StudioProfile.studioRole = 'kiln-booking'} test::umberthistle3::domain::KilnBooking
{
  bookingRef: String[1];
  memberRef: String[1];
  kilnRef: String[1];
  slotRef: String[1];
  glazeRef: String[1];
  bookedOn: StrictDate[1];
  firingHours: Integer[1];
  pieceCount: Integer[1];
  statusRef: String[1];
  noteText: String[0..1];
}

Class test::umberthistle3::domain::StudioMember
{
  memberRef: String[1];
  memberName: String[1];
  tierRef: String[1];
  regionName: String[1];
}

Association test::umberthistle3::domain::BookingMember
{
  member: test::umberthistle3::domain::StudioMember[1];
  bookings: test::umberthistle3::domain::KilnBooking[*];
}
