###Mapping
Mapping test::maplecove::mapping::CoveMapping
(
  *test::maplecove::domain::TidePool[tidepool_feed]: Pure
  {
    ~src test::maplecove::domain::TidePoolFeed
    habitatId: $src.id,
    name: $src.nm,
    salinity: $src.sal,
    speciesCount: if($src.cnt < 0,
                     | 0,
                     | $src.cnt)
  }

  testSuites:
  [
    tidePoolTransformSuite:
    {
      function: |test::maplecove::domain::TidePool.all()->graphFetch(
        #{
          test::maplecove::domain::TidePool{
            habitatId,
            name,
            salinity,
            speciesCount
          }
        }#
      )->serialize(
        #{
          test::maplecove::domain::TidePool{
            habitatId,
            name,
            salinity,
            speciesCount
          }
        }#
      );
      tests:
      [
        populatedPool:
        {
          data:
          [
            ModelStore:
              ModelStore
              #{
                test::maplecove::domain::TidePoolFeed:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"id":3,"nm":"North Ledge","sal":33.5,"cnt":7}';
                  }#
              }#
          ];
          asserts:
          [
            transformed:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"habitatId":3,"name":"North Ledge","salinity":33.5,"speciesCount":7}';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
