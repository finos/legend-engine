Profile test::maplecove::domain::CoveProfile
{
  stereotypes: [surveyed];
  tags: [origin];
}

Class {meta::pure::profiles::doc.doc = 'Base identity for a coastal habitat within the cove.'} test::maplecove::domain::Habitat
{
  habitatId: Integer[1];
  name: String[1];
}

Class <<test::maplecove::domain::CoveProfile.surveyed>> {meta::pure::profiles::doc.doc = 'A tide pool habitat with salinity and an observed species count.', test::maplecove::domain::CoveProfile.origin = 'shoreline-survey'} test::maplecove::domain::TidePool extends test::maplecove::domain::Habitat
{
  salinity: Float[1];
  speciesCount: Integer[1];
}

Class {meta::pure::profiles::doc.doc = 'Inbound denormalised tide-pool feed record (flat-data source shape).'} test::maplecove::domain::TidePoolFeed
{
  id: Integer[1];
  nm: String[1];
  sal: Float[1];
  cnt: Integer[1];
}
