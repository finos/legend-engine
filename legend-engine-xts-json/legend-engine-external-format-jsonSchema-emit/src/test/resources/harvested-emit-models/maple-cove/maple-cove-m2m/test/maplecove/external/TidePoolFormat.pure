###ExternalFormat
Binding test::maplecove::external::TidePoolFeedBinding
{
  schemaSet: test::maplecove::external::TidePoolFeedSchemas;
  contentType: 'application/x.flatdata';
  modelIncludes: [
    test::maplecove::domain::TidePoolFeed
  ];
}

SchemaSet test::maplecove::external::TidePoolFeedSchemas
{
  format: FlatData;
  schemas: [
    {
      id: tidePoolFeedCsv;
      location: 'tide-pool-feed.csv';
      content: 'section feed: DelimitedWithHeadings\n{\n  scope.untilEof;\n  delimiter: \',\';\n  Record\n  {\n    id  : INTEGER;\n    nm  : STRING;\n    sal : DECIMAL;\n    cnt : INTEGER;\n  }\n}';
    }
  ];
}
