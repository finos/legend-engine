###Service
Service test::maplecove::service::TransformTidePool
{
  pattern: '/cove/v1/tidepool/transform';
  title: 'Cove - Transform Tide Pool (M2M)';
  owners:
  [
    'cove-survey-platform',
    'shoreline-eng'
  ];
  documentation: 'Single-execution model-to-model service that accepts an inbound tide-pool feed record as JSON and returns the graph-fetched tide-pool object tree.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |test::maplecove::domain::TidePool.all()->graphFetch(
      #{
        test::maplecove::domain::TidePool{
          habitatId,
          name,
          salinity,
          speciesCount
        }
      }#
    )->serialize(
      #{
        test::maplecove::domain::TidePool{
          habitatId,
          name,
          salinity,
          speciesCount
        }
      }#
    );
    mapping: test::maplecove::mapping::CoveMapping;
    runtime: test::maplecove::runtime::CoveRuntime;
  }
  testSuites:
  [
    transformTidePoolSuite:
    {
      data:
      [
        connections:
        [
          tidePoolFeedConnection:
            ExternalFormat
            #{
              contentType: 'application/json';
              data: '{"id":3,"nm":"North Ledge","sal":33.5,"cnt":7}';
            }#
        ]
      ]
      tests:
      [
        northLedge:
        {
          asserts:
          [
            transformed:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":{"habitatId":3,"name":"North Ledge","salinity":33.5,"speciesCount":7}}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
