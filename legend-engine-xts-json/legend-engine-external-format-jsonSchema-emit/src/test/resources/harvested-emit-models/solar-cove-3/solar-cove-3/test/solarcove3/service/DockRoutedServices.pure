###Service
Service test::solarcove3::service::DocksByTierService
{
  pattern: '/solarcove/v1/docks-by-tier';
  title: 'Docks By Deployment Tier';
  ownership: DID { identifier: 'bike-share-platform' };
  documentation: 'Multi-execution service keyed by deployment tier, returning the published bike-share dock roster over the model-to-model runtime. Retained for parse, compile and execution-plan coverage of the multi-execution service feature.';
  autoActivateUpdates: false;
  execution: Multi
  {
    query: |test::solarcove3::domain::Dock.all()->graphFetch(
  #{
    test::solarcove3::domain::Dock{
      dockId,
      stationCode,
      zone,
      statusCode,
      tier
    }
  }#
    )->serialize(
  #{
    test::solarcove3::domain::Dock{
      dockId,
      stationCode,
      zone,
      statusCode,
      tier
    }
  }#
    );
    key: 'tier';
    executions['dev']:
    {
      mapping: test::solarcove3::mapping::DockFromReading;
      runtime: test::solarcove3::runtime::DockRuntime;
    }
    executions['prod']:
    {
      mapping: test::solarcove3::mapping::DockFromReading;
      runtime: test::solarcove3::runtime::DockRuntime;
    }
  }
}


###Service
Service test::solarcove3::service::DocksByRegionService
{
  pattern: '/solarcove/v1/docks-by-region';
  title: 'Docks By Operator Region';
  ownership: DID { identifier: 'bike-share-platform' };
  documentation: 'Multi-execution service keyed by operator region, returning the published bike-share dock roster over the model-to-model runtime. Retained for parse, compile and execution-plan coverage of the multi-execution service feature.';
  autoActivateUpdates: false;
  execution: Multi
  {
    query: |test::solarcove3::domain::Dock.all()->graphFetch(
  #{
    test::solarcove3::domain::Dock{
      dockId,
      stationCode,
      zone,
      operatorName
    }
  }#
    )->serialize(
  #{
    test::solarcove3::domain::Dock{
      dockId,
      stationCode,
      zone,
      operatorName
    }
  }#
    );
    key: 'region';
    executions['east']:
    {
      mapping: test::solarcove3::mapping::DockFromReading;
      runtime: test::solarcove3::runtime::DockRuntime;
    }
    executions['west']:
    {
      mapping: test::solarcove3::mapping::DockFromReading;
      runtime: test::solarcove3::runtime::DockRuntime;
    }
  }
}
