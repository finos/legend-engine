function <<access.private>> meta::external::store::relational::sqlDialectTranslation::h2::tests::testDialect(): SqlDialect[1]
{
  h2SqlDialect()
}

function <<access.private>> meta::external::store::relational::sqlDialectTranslation::h2::tests::testSqlDialectTranslationState(): SqlDialectTranslationState[1]
{
  ^SqlDialectTranslationState
  (
    level = 0
  )
}

function <<access.private>> meta::external::store::relational::sqlDialectTranslation::h2::tests::testSqlDialectTranslationConfig(pretty: Boolean[1]): SqlDialectTranslationConfig[1]
{
  meta::external::store::relational::sqlDialectTranslation::h2::tests::testSqlDialectTranslationConfig($pretty, false)
}

function <<access.private>> meta::external::store::relational::sqlDialectTranslation::h2::tests::testSqlDialectTranslationConfig(pretty: Boolean[1], quoteIdentifiers: Boolean[1]): SqlDialectTranslationConfig[1]
{
  meta::external::store::relational::sqlDialectTranslation::h2::tests::testSqlDialectTranslationConfig($pretty, $quoteIdentifiers, []);
}

function <<access.private>> meta::external::store::relational::sqlDialectTranslation::h2::tests::testSqlDialectTranslationConfig(pretty: Boolean[1], quoteIdentifiers: Boolean[1], dbTimeZone:String[0..1]): SqlDialectTranslationConfig[1]
{
  ^SqlDialectTranslationConfig
  (
    dbConfig = ^DbConfig(dbType = 'H2', dbTimeZone = $dbTimeZone,      quoteIdentifiers = $quoteIdentifiers),
    formatConfig = ^FormatConfig(pretty = $pretty, upperCaseKeywords = true),
    functionRegistry = meta::external::store::relational::sqlDialectTranslation::functionRegistry::sqlFunctionRegistry()
  )
}

function <<test.Test>> meta::external::store::relational::sqlDialectTranslation::h2::tests::testQuerySpecificationProcessingForH2(): Boolean[1]
{
  let dialect = testDialect();
  let state = testSqlDialectTranslationState();
  let config = testSqlDialectTranslationConfig(false);

  let q1 = ^ExtendedQuerySpecification(
    select = ^Select(selectItems = [^SingleColumn(expression = ^ArithmeticExpression(left = literal(101), right = literal(102), type = ArithmeticType.ADD))])
  );
  assertEquals('SELECT 101 + 102', $dialect->executeNodeProcessor($q1, $state, $config));

  let tblA = ^AliasedRelation(relation = ^Table(name = ^QualifiedName(parts = ['db', 'schema', 'table_a'])), alias = '"root"');
  let tblB = ^AliasedRelation(relation = ^Table(name = ^QualifiedName(parts = ['db', 'schema', 'table_b'])), alias = '"t_b"');
  let rel = ^Join(left = $tblA, right = $tblB, type = JoinType.INNER, criteria = ^JoinOn(expression = ^ComparisonExpression(left = literal(101), right = literal(102), operator = ComparisonOperator.LESS_THAN)));

  let q2 = ^$q1(
    select = ^Select(selectItems = [^AllColumns(prefix = '"root"')]),
    from = $rel
  );
  assertEquals(
    'SELECT "root".* FROM db.schema.table_a AS "root" INNER JOIN db.schema.table_b AS "t_b" ON (101 < 102)',
    $dialect->executeNodeProcessor($q2, $state, $config)
  );

	let q3 = ^$q2(where = ^ComparisonExpression(left = literal(103), right = literal(104), operator = ComparisonOperator.LESS_THAN));
	assertEquals(
    'SELECT "root".* FROM db.schema.table_a AS "root" INNER JOIN db.schema.table_b AS "t_b" ON (101 < 102) WHERE 103 < 104',
    $dialect->executeNodeProcessor($q3, $state, $config)
  );	

	let q4 = ^$q3(
    groupBy = [
      ^QualifiedNameReference(name = ^QualifiedName(parts = ['"root"', 'c1'])),
      ^QualifiedNameReference(name = ^QualifiedName(parts = ['"root"', 'c2']))
    ]
  );
	assertEquals(
    'SELECT "root".* FROM db.schema.table_a AS "root" INNER JOIN db.schema.table_b AS "t_b" ON (101 < 102) WHERE 103 < 104 ' +
    'GROUP BY "root".c1, "root".c2',
    $dialect->executeNodeProcessor($q4, $state, $config)
  );	

	let q5 = ^$q4(having = ^IsNotNullPredicate(value = ^QualifiedNameReference(name = ^QualifiedName(parts = ['c1']))));
	assertEquals(
    'SELECT "root".* FROM db.schema.table_a AS "root" INNER JOIN db.schema.table_b AS "t_b" ON (101 < 102) WHERE 103 < 104 ' +
    'GROUP BY "root".c1, "root".c2 HAVING c1 IS NOT NULL',
    $dialect->executeNodeProcessor($q5, $state, $config)
  );	

	let q6 = ^$q5(
    orderBy = [
      ^SortItem(sortKey = ^QualifiedNameReference(name = ^QualifiedName(parts = ['c1'])), ordering = SortItemOrdering.DESCENDING, nullOrdering = SortItemNullOrdering.FIRST),
      ^SortItem(sortKey = ^QualifiedNameReference(name = ^QualifiedName(parts = ['c2'])), ordering = SortItemOrdering.ASCENDING, nullOrdering = SortItemNullOrdering.LAST)
    ]
  );
	assertEquals(
    'SELECT "root".* FROM db.schema.table_a AS "root" INNER JOIN db.schema.table_b AS "t_b" ON (101 < 102) WHERE 103 < 104 ' +
    'GROUP BY "root".c1, "root".c2 HAVING c1 IS NOT NULL ' +
    'ORDER BY c1 DESC NULLS FIRST, c2 ASC NULLS LAST',
    $dialect->executeNodeProcessor($q6, $state, $config)
  );	

	let q7 = ^$q6(limit = literal(10));
	assertEquals(
    'SELECT TOP 10 "root".* FROM db.schema.table_a AS "root" INNER JOIN db.schema.table_b AS "t_b" ON (101 < 102) WHERE 103 < 104 ' +
    'GROUP BY "root".c1, "root".c2 HAVING c1 IS NOT NULL ' +
    'ORDER BY c1 DESC NULLS FIRST, c2 ASC NULLS LAST',
    $dialect->executeNodeProcessor($q7, $state, $config)
  );	

	let q8 = ^$q7(offset = literal(5));
	assertEquals(
    'SELECT "root".* FROM db.schema.table_a AS "root" INNER JOIN db.schema.table_b AS "t_b" ON (101 < 102) WHERE 103 < 104 ' +
    'GROUP BY "root".c1, "root".c2 HAVING c1 IS NOT NULL ' +
    'ORDER BY c1 DESC NULLS FIRST, c2 ASC NULLS LAST OFFSET 5 ROWS FETCH NEXT 10 ROWS ONLY',
    $dialect->executeNodeProcessor($q8, $state, $config)
  );

  let q9 = ^$q6(offset = literal(5));
	assertEquals(
    'SELECT "root".* FROM db.schema.table_a AS "root" INNER JOIN db.schema.table_b AS "t_b" ON (101 < 102) WHERE 103 < 104 ' +
    'GROUP BY "root".c1, "root".c2 HAVING c1 IS NOT NULL ' +
    'ORDER BY c1 DESC NULLS FIRST, c2 ASC NULLS LAST OFFSET 5 ROWS',
    $dialect->executeNodeProcessor($q9, $state, $config)
  );
}

function <<test.Test>> meta::external::store::relational::sqlDialectTranslation::h2::tests::testLeftForH2(): Boolean[1]
{
  let dialect = testDialect();
  let state = testSqlDialectTranslationState();
  let config = testSqlDialectTranslationConfig(false);
  assertEquals('left(\'abcd\', char_length(\'xy\'))', $dialect->executeNodeProcessor(
    ^FunctionCall(
      name = ^QualifiedName(parts = 'left'),
      arguments = [
        literal('abcd'),
        ^FunctionCall(
          name = ^QualifiedName(parts = 'char_length'),
          arguments = [literal('xy')]
        )
      ]
    )->inferTypes($config.functionRegistry), $state, $config));
}

function <<test.Test>> meta::external::store::relational::sqlDialectTranslation::h2::tests::testRightForH2(): Boolean[1]
{
  let dialect = testDialect();
  let state = testSqlDialectTranslationState();
  let config = testSqlDialectTranslationConfig(false);
  assertEquals('right(\'defgh\', char_length(\'ghij\'))', $dialect->executeNodeProcessor(
    ^FunctionCall(
      name = ^QualifiedName(parts = 'right'),
      arguments = [
        literal('defgh'),
        ^FunctionCall(
          name = ^QualifiedName(parts = 'char_length'),
          arguments = [literal('ghij')]
        )
      ]
    )->inferTypes($config.functionRegistry), $state, $config));
}

function <<test.Test>> meta::external::store::relational::sqlDialectTranslation::h2::tests::testQualifyQueryProcessingForH2(): Boolean[1]
{
  let dialect = testDialect();
  let state = testSqlDialectTranslationState();
  let config = testSqlDialectTranslationConfig(false);

  assertEquals('SELECT dept, sum(id) OVER (PARTITION BY dept) AS sumCol FROM testTable QUALIFY sum(id) OVER (PARTITION BY dept) > 3', $dialect->executeNodeProcessor(
    ^Query(
      queryBody = ^ExtendedQuerySpecification(
        select = ^Select(
          distinct = false,
          selectItems = [
            ^SingleColumn(expression = ^QualifiedNameReference(name = ^QualifiedName(parts = 'dept'))),
            ^SingleColumn(
              expression = ^FunctionCall(
                arguments = ^QualifiedNameReference(name = ^QualifiedName(parts = 'id')),
                distinct = false,
                name = ^QualifiedName(parts = 'sum'),
                window = ^meta::external::query::sql::metamodel::Window(partitions = ^QualifiedNameReference(name = ^QualifiedName(parts = 'dept')))
              ),
              alias = 'sumCol'
            )
        ]),
        from = ^Table(name = ^QualifiedName(parts = 'testTable')),
        qualify = ^ComparisonExpression(
          left = ^FunctionCall(
            arguments = ^QualifiedNameReference(name = ^QualifiedName(parts = 'id')),
            distinct = false,
            name = ^QualifiedName(parts = 'sum'),
            window = ^meta::external::query::sql::metamodel::Window(partitions = ^QualifiedNameReference(name = ^QualifiedName(parts = 'dept')))
          ),
          operator = ComparisonOperator.GREATER_THAN,
          right = literal(3)
        )
      )
    )->inferTypes($config.functionRegistry), $state, $config)
  );
}

// ---------------------------------------------------------------------------
// useDbNativeImplicitNullOrdering
//
// SDT asserts result rows and so cannot tell "no clause because the dialect is already canonical"
// apart from "no clause because compensation was switched off". These assert the emitted SQL, which
// is where that difference shows up.
//
// The native ordering is supplied explicitly per version rather than via h2NativeNullOrdering(),
// which probes the running server -- pinning it keeps these deterministic whichever H2 is on the
// classpath, and lets both sides of the version split be asserted in one place.

function <<access.private>> meta::external::store::relational::sqlDialectTranslation::h2::tests::h2LatestNativeNullOrdering(): Map<SortItemOrdering, SortItemNullOrdering>[1]
{
  // 2.1.214 -- matches canonical
  [pair(SortItemOrdering.ASCENDING, SortItemNullOrdering.LAST), pair(SortItemOrdering.DESCENDING, SortItemNullOrdering.FIRST)]->newMap()
}

function <<access.private>> meta::external::store::relational::sqlDialectTranslation::h2::tests::h2LegacyNativeNullOrdering(): Map<SortItemOrdering, SortItemNullOrdering>[1]
{
  // 1.4.200 -- inverted from canonical
  [pair(SortItemOrdering.ASCENDING, SortItemNullOrdering.FIRST), pair(SortItemOrdering.DESCENDING, SortItemNullOrdering.LAST)]->newMap()
}

function <<access.private>> meta::external::store::relational::sqlDialectTranslation::h2::tests::testNullOrderingConfig(nativeNullOrdering: Map<SortItemOrdering, SortItemNullOrdering>[1], useDbNativeImplicitNullOrdering: Boolean[1]): SqlDialectTranslationConfig[1]
{
  testNullOrderingConfig($nativeNullOrdering, $useDbNativeImplicitNullOrdering, true);
}

function <<access.private>> meta::external::store::relational::sqlDialectTranslation::h2::tests::testNullOrderingConfig(nativeNullOrdering: Map<SortItemOrdering, SortItemNullOrdering>[1], useDbNativeImplicitNullOrdering: Boolean[1], supportsNullOrderingInOrderedAggregate: Boolean[1]): SqlDialectTranslationConfig[1]
{
  ^SqlDialectTranslationConfig
  (
    dbConfig = ^DbConfig(
      dbType = 'H2',
      quoteIdentifiers = false,
      useDbNativeImplicitNullOrdering = $useDbNativeImplicitNullOrdering,
      nullOrdering = ^DialectNullOrdering(
        nativeOrdering = $nativeNullOrdering,
        supportedInOrderedAggregate = $supportsNullOrderingInOrderedAggregate
      )
    ),
    formatConfig = ^FormatConfig(pretty = false, upperCaseKeywords = true),
    functionRegistry = meta::external::store::relational::sqlDialectTranslation::functionRegistry::sqlFunctionRegistry()
  )
}

function <<access.private>> meta::external::store::relational::sqlDialectTranslation::h2::tests::testSortItem(ordering: SortItemOrdering[1], nullOrdering: SortItemNullOrdering[1]): SortItem[1]
{
  ^SortItem(sortKey = ^QualifiedNameReference(name = ^QualifiedName(parts = 'c1')), ordering = $ordering, nullOrdering = $nullOrdering)
}

// 2.1.214 is already canonical, so nothing is emitted either way -- this is what keeps the existing
// mostly-unclaused platform fixtures byte-identical.
function <<test.Test>> meta::external::store::relational::sqlDialectTranslation::h2::tests::testImplicitNullOrderingForLatestVersion(): Boolean[1]
{
  let dialect = testDialect();
  let state = testSqlDialectTranslationState();

  let flagOff = testNullOrderingConfig(h2LatestNativeNullOrdering(), false);
  assertEquals('c1 ASC', $dialect->executeNodeProcessor(testSortItem(SortItemOrdering.ASCENDING, SortItemNullOrdering.UNDEFINED), $state, $flagOff));
  assertEquals('c1 DESC', $dialect->executeNodeProcessor(testSortItem(SortItemOrdering.DESCENDING, SortItemNullOrdering.UNDEFINED), $state, $flagOff));

  let flagOn = testNullOrderingConfig(h2LatestNativeNullOrdering(), true);
  assertEquals('c1 ASC', $dialect->executeNodeProcessor(testSortItem(SortItemOrdering.ASCENDING, SortItemNullOrdering.UNDEFINED), $state, $flagOn));
  assertEquals('c1 DESC', $dialect->executeNodeProcessor(testSortItem(SortItemOrdering.DESCENDING, SortItemNullOrdering.UNDEFINED), $state, $flagOn));
}

// 1.4.200 is inverted, so with the flag off both directions are compensated. This is the fix Alloy's
// mapped execution (EMIT tests) depends on.
function <<test.Test>> meta::external::store::relational::sqlDialectTranslation::h2::tests::testImplicitNullOrderingCompensatedForLegacyVersion(): Boolean[1]
{
  let dialect = testDialect();
  let state = testSqlDialectTranslationState();
  let config = testNullOrderingConfig(h2LegacyNativeNullOrdering(), false);

  assertEquals('c1 ASC NULLS LAST', $dialect->executeNodeProcessor(testSortItem(SortItemOrdering.ASCENDING, SortItemNullOrdering.UNDEFINED), $state, $config));
  assertEquals('c1 DESC NULLS FIRST', $dialect->executeNodeProcessor(testSortItem(SortItemOrdering.DESCENDING, SortItemNullOrdering.UNDEFINED), $state, $config));
}

// Flag on: even on the diverging version nothing is emitted, so 1.4.200's native (inverted) ordering
// is what takes effect.
function <<test.Test>> meta::external::store::relational::sqlDialectTranslation::h2::tests::testImplicitNullOrderingSuppressedForLegacyVersionWhenFlagOn(): Boolean[1]
{
  let dialect = testDialect();
  let state = testSqlDialectTranslationState();
  let config = testNullOrderingConfig(h2LegacyNativeNullOrdering(), true);

  assertEquals('c1 ASC', $dialect->executeNodeProcessor(testSortItem(SortItemOrdering.ASCENDING, SortItemNullOrdering.UNDEFINED), $state, $config));
  assertEquals('c1 DESC', $dialect->executeNodeProcessor(testSortItem(SortItemOrdering.DESCENDING, SortItemNullOrdering.UNDEFINED), $state, $config));
}

// The flag governs implicit ordering only -- explicit is always emitted verbatim, on either version.
function <<test.Test>> meta::external::store::relational::sqlDialectTranslation::h2::tests::testExplicitNullOrderingUnaffectedByFlag(): Boolean[1]
{
  let dialect = testDialect();
  let state = testSqlDialectTranslationState();
  let config = testNullOrderingConfig(h2LegacyNativeNullOrdering(), true);

  assertEquals('c1 ASC NULLS FIRST', $dialect->executeNodeProcessor(testSortItem(SortItemOrdering.ASCENDING, SortItemNullOrdering.FIRST), $state, $config));
  assertEquals('c1 DESC NULLS LAST', $dialect->executeNodeProcessor(testSortItem(SortItemOrdering.DESCENDING, SortItemNullOrdering.LAST), $state, $config));
}

// ---------------------------------------------------------------------------
// Null ordering inside an ordered-set aggregate
//
// H2 1.4.200's parser rejects NULLS FIRST/LAST inside WITHIN GROUP (ORDER BY ...) -- it fails with
// `expected ")"`. Emitting a compensating clause there therefore produces SQL the database cannot
// run at all, which is worse than ordering differently, so nothing is emitted in that position on
// that version. 2.1.214 parses it normally.
//
// This is the case the shared SDT suite structurally cannot cover: its H2 runner is 2.1.214, so the
// 1.4.200 side of the version split is only reachable here.

function <<access.private>> meta::external::store::relational::sqlDialectTranslation::h2::tests::orderedAggregateState(): SqlDialectTranslationState[1]
{
  testSqlDialectTranslationState()->inOrderedAggregate()
}

// 1.4.200: no clause in an ordered aggregate, even though a plain ORDER BY would be compensated,
// and even for an explicit null order -- the syntax simply is not available.
function <<test.Test>> meta::external::store::relational::sqlDialectTranslation::h2::tests::testNullOrderingOmittedInOrderedAggregateForLegacyVersion(): Boolean[1]
{
  let dialect = testDialect();
  let state = orderedAggregateState();
  let config = testNullOrderingConfig(h2LegacyNativeNullOrdering(), false, false);

  assertEquals('c1 ASC', $dialect->executeNodeProcessor(testSortItem(SortItemOrdering.ASCENDING, SortItemNullOrdering.UNDEFINED), $state, $config));
  assertEquals('c1 DESC', $dialect->executeNodeProcessor(testSortItem(SortItemOrdering.DESCENDING, SortItemNullOrdering.UNDEFINED), $state, $config));
  assertEquals('c1 ASC', $dialect->executeNodeProcessor(testSortItem(SortItemOrdering.ASCENDING, SortItemNullOrdering.FIRST), $state, $config));
  assertEquals('c1 DESC', $dialect->executeNodeProcessor(testSortItem(SortItemOrdering.DESCENDING, SortItemNullOrdering.LAST), $state, $config));
}

// The suppression is scoped to the ordered-aggregate position only: the same sort item in a plain
// ORDER BY on the same version is still compensated.
function <<test.Test>> meta::external::store::relational::sqlDialectTranslation::h2::tests::testNullOrderingStillAppliedOutsideOrderedAggregateForLegacyVersion(): Boolean[1]
{
  let dialect = testDialect();
  let config = testNullOrderingConfig(h2LegacyNativeNullOrdering(), false, false);

  assertEquals('c1 ASC NULLS LAST', $dialect->executeNodeProcessor(testSortItem(SortItemOrdering.ASCENDING, SortItemNullOrdering.UNDEFINED), testSqlDialectTranslationState(), $config));
}

// 2.1.214 supports it, so an explicit null order is honoured inside an ordered aggregate.
function <<test.Test>> meta::external::store::relational::sqlDialectTranslation::h2::tests::testNullOrderingKeptInOrderedAggregateForLatestVersion(): Boolean[1]
{
  let dialect = testDialect();
  let state = orderedAggregateState();
  let config = testNullOrderingConfig(h2LatestNativeNullOrdering(), false, true);

  assertEquals('c1 ASC NULLS FIRST', $dialect->executeNodeProcessor(testSortItem(SortItemOrdering.ASCENDING, SortItemNullOrdering.FIRST), $state, $config));
  // Implicit stays unclaused because 2.1.214 is already canonical, not because it is unsupported.
  assertEquals('c1 ASC', $dialect->executeNodeProcessor(testSortItem(SortItemOrdering.ASCENDING, SortItemNullOrdering.UNDEFINED), $state, $config));
}
