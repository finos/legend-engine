function <<test.Test>> meta::relational::tests::sqlQueryToString::duckDB::testCTESQLGeneration(): Boolean[1]
{
   let func = {|Trade.all()->project([x|$x.id, x|$x.quantity], ['TradeID', 'Quantity'])->limit(10)->filter(x | $x.getInteger('TradeID') == 100)};
   let pp = testRuntimeWithCTEPP().connectionStores->at(0).connection->cast(@meta::external::store::relational::runtime::DatabaseConnection).sqlQueryPostProcessors;
   let result = toSQLString($func, simpleRelationalMapping, DatabaseType.DuckDB, []->cast(@String), $pp, ^Format(newLine='', indent=''), duckDBExtensions(), noDebug());
   assertEquals(
      'WITH subquery_cte_1_1 AS (select "root".ID as "TradeID", "root".quantity as "Quantity" from tradeTable as "root" limit 10) \n' +
      'select "subselect"."TradeID" as "TradeID", "subselect"."Quantity" as "Quantity" from subquery_cte_1_1 as "subselect" where "subselect"."TradeID" = 100',
      $result
   );
}

function <<test.Test>> meta::relational::tests::sqlQueryToString::duckDB::testToSQLStringConvertVarchar128InDuckDB(): Boolean[1]
{
   let s = toSQLString(|SqlFunctionDemo.all()->project([s | $s.convertVarchar128], ['convertVarchar128']), testMapping, meta::relational::runtime::DatabaseType.DuckDB, meta::relational::extension::relationalExtensions());
   assertEquals('select CAST("root".int1 AS VARCHAR) as "convertVarchar128" from dataTable as "root"', $s);
}

function <<test.Test>> meta::relational::tests::sqlQueryToString::duckDB::testToSQLStringConvertDateNoFormatInDuckDB(): Boolean[1]
{
   let s = toSQLString(|SqlFunctionDemo.all()->project([s | $s.convertToDate1], ['convertToDate']), testMapping, meta::relational::runtime::DatabaseType.DuckDB, meta::relational::extension::relationalExtensions());
   assertEquals('select strptime("root".stringDateFormat, \'%Y-%m-%d\')::DATE as "convertToDate" from dataTable as "root"', $s);
}

function <<test.Test>> meta::relational::tests::sqlQueryToString::duckDB::testToSQLStringConvertDateISOFormatInDuckDB(): Boolean[1]
{
   let s = toSQLString(|SqlFunctionDemo.all()->project([s | $s.convertToDate], ['convertToDate']), testMapping, meta::relational::runtime::DatabaseType.DuckDB, meta::relational::extension::relationalExtensions());
   assertEquals('select strptime("root".stringDateFormat, \'%Y-%m-%d\')::DATE as "convertToDate" from dataTable as "root"', $s);
}

// substr is always correctly indexed, on every dialect, with no flag involved.
function <<test.Test>> meta::relational::tests::sqlQueryToString::duckDB::testSubstrOnDuckDB(): Boolean[1]
{
   let s = toSQLString(|Person.all()->project([p | $p.firstName->substr(4, 9)], ['slice']), simpleRelationalMapping, meta::relational::runtime::DatabaseType.DuckDB, meta::relational::extension::relationalExtensions());
   assertEquals('select substring("root".FIRSTNAME, 5, 5) as "slice" from personTable as "root"', $s);
}

function <<test.Test>> meta::relational::tests::sqlQueryToString::duckDB::testToSQLStringConvertDateMMMyyyyFormatInDuckDB(): Boolean[1]
{
   let s = toSQLString(|SqlFunctionDemo.all()->project([s | $s.convertToDateUserDefinedFormat], ['convertToDate']), testMapping, meta::relational::runtime::DatabaseType.DuckDB, meta::relational::extension::relationalExtensions());
   assertEquals('select strptime("root".stringUserDefinedDateFormat, \'%b%Y\')::DATE as "convertToDate" from dataTable as "root"', $s);
}

function <<test.Test>> meta::relational::tests::sqlQueryToString::duckDB::testToSQLStringConvertDateUppercaseFormatNormalizedInDuckDB(): Boolean[1]
{
   let s = toSQLString(|SqlFunctionDemo.all()->project([s | $s.convertToDateMemSQL], ['convertToDate']), testMapping, meta::relational::runtime::DatabaseType.DuckDB, meta::relational::extension::relationalExtensions());
   assertEquals('select strptime("root".stringDateFormat, \'%Y-%m-%d\')::DATE as "convertToDate" from dataTable as "root"', $s);
}

function <<test.Test>> meta::relational::tests::sqlQueryToString::duckDB::testToSQLStringConvertDateSlashedFormatInDuckDB(): Boolean[1]
{
   let s = toSQLString(|SqlFunctionDemo.all()->project([s | $s.convertToDateUserDefinedFormat2], ['convertToDate']), testMapping, meta::relational::runtime::DatabaseType.DuckDB, meta::relational::extension::relationalExtensions());
   assertEquals('select strptime("root".stringUserDefinedDateFormat, \'%Y/%m/%d\')::DATE as "convertToDate" from dataTable as "root"', $s);
}

function <<test.Test>> meta::relational::tests::sqlQueryToString::duckDB::testToSQLStringExtractFromSemiStructuredVarcharInDuckDB(): Boolean[1]
{
   let s = toSQLString(
      |meta::relational::tests::sqlQueryToString::duckDB::semiStructured::SemiStructuredFirm.all()
         ->project([f | $f.legalName], ['Legal Name']),
      meta::relational::tests::sqlQueryToString::duckDB::semiStructured::semiStructuredTestMapping,
      meta::relational::runtime::DatabaseType.DuckDB,
      meta::relational::extension::relationalExtensions()
   );
   assertEquals('select json_extract_string("root".FIRM_DETAILS, \'$.legalName\') as "Legal Name" from FIRM_TABLE as "root"', $s);
}


// A DuckDB table MACRO must be redeployable and must separate its parameters with commas. Both
// were wrong until this test existed: createFunction emitted a bare `CREATE MACRO`, so a second
// deploy failed with 'Table Macro Function with name ... already exists', and it joined parameter
// names with a space, so any macro with more than one parameter was unparseable ("Parser Error:
// syntax error at or near ..."). A single parameter happened to come out valid, which is why it
// went unnoticed.
function <<test.Test>> meta::relational::tests::sqlQueryToString::duckDB::testDuckDBCreateFunctionIsReplaceable(): Boolean[1]
{
   let sql = meta::relational::functions::sqlQueryToString::duckDB::createFunction(
      ^meta::relational::metamodel::CreateFunctionSQL(
         schemaName = 'MY_SCHEMA',
         name = 'MY_FN',
         typedParameters = ^meta::relational::metamodel::SQLParameter(
                              name = 'region',
                              type = ^meta::relational::metamodel::datatype::Varchar(size = 100)),
         generatedSQL = 'select 1'
      ),
      meta::relational::functions::sqlQueryToString::createDbConfig(meta::relational::runtime::DatabaseType.DuckDB),
      meta::relational::extension::relationalExtensions()
   );
   assertEquals('CREATE OR REPLACE MACRO MY_SCHEMA.MY_FN(region) AS TABLE\n   select 1', $sql);
}

function <<test.Test>> meta::relational::tests::sqlQueryToString::duckDB::testDuckDBCreateFunctionSeparatesParametersWithCommas(): Boolean[1]
{
   let sql = meta::relational::functions::sqlQueryToString::duckDB::createFunction(
      ^meta::relational::metamodel::CreateFunctionSQL(
         schemaName = 'MY_SCHEMA',
         name = 'MY_FN',
         typedParameters = [^meta::relational::metamodel::SQLParameter(
                               name = 'region',
                               type = ^meta::relational::metamodel::datatype::Varchar(size = 100)),
                            ^meta::relational::metamodel::SQLParameter(
                               name = 'legalName',
                               type = ^meta::relational::metamodel::datatype::Varchar(size = 100))],
         generatedSQL = 'select 1'
      ),
      meta::relational::functions::sqlQueryToString::createDbConfig(meta::relational::runtime::DatabaseType.DuckDB),
      meta::relational::extension::relationalExtensions()
   );
   assertEquals('CREATE OR REPLACE MACRO MY_SCHEMA.MY_FN(region, legalName) AS TABLE\n   select 1', $sql);
}

// Unsigned precise primitives map to DuckDB's native unsigned types. USmallInt widens to UINTEGER:
// the relational metamodel has no unsigned SMALLINT, and UINTEGER holds every USmallInt value.
function <<test.Test>> meta::relational::tests::sqlQueryToString::duckDB::testDuckDBUnsignedTypes(): Boolean[1]
{
   let sqlType = {t:String[1] | meta::relational::functions::typeConversion::duckDB::dataTypeToSqlTextDuckDB(meta::relational::functions::typeConversion::duckDB::convert(^GenericType(rawType = ('meta::pure::precisePrimitives::' + $t)->pathToElement()->cast(@Type))))};
   assertEquals('UTINYINT', $sqlType->eval('UTinyInt'));
   assertEquals('UINTEGER', $sqlType->eval('USmallInt'));
   assertEquals('UINTEGER', $sqlType->eval('UInt'));
   assertEquals('UBIGINT', $sqlType->eval('UBigInt'));
}

###Pure
Class meta::relational::tests::sqlQueryToString::duckDB::semiStructured::SemiStructuredFirm
{
   id: Integer[1];
   legalName: String[1];
}

###Relational
Database meta::relational::tests::sqlQueryToString::duckDB::semiStructured::semiStructuredTestDB
(
   Table FIRM_TABLE
   (
      ID INTEGER PRIMARY KEY,
      FIRM_DETAILS SEMISTRUCTURED
   )
)

###Mapping
Mapping meta::relational::tests::sqlQueryToString::duckDB::semiStructured::semiStructuredTestMapping
(
   meta::relational::tests::sqlQueryToString::duckDB::semiStructured::SemiStructuredFirm: Relational
   {
      ~primaryKey
      (
         [meta::relational::tests::sqlQueryToString::duckDB::semiStructured::semiStructuredTestDB]FIRM_TABLE.ID
      )
      ~mainTable [meta::relational::tests::sqlQueryToString::duckDB::semiStructured::semiStructuredTestDB]FIRM_TABLE
      id: [meta::relational::tests::sqlQueryToString::duckDB::semiStructured::semiStructuredTestDB]FIRM_TABLE.ID,
      legalName: extractFromSemiStructured([meta::relational::tests::sqlQueryToString::duckDB::semiStructured::semiStructuredTestDB]FIRM_TABLE.FIRM_DETAILS, 'legalName', 'VARCHAR')
   }
)
