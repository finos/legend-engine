    dynaFnToSql('extractFromSemiStructured', $allStates,         ^ToSql(format='%s', transform={p:String[3]|$p->processExtractFromSemiStructuredParamsFoDuckDb()})),
    dynaFnToSql('first',                  $allStates,            ^ToSql(format='first(%s)')),
