    dynaFnToSql('array_position',         $allStates,            ^ToSql(format='(ifnull(array_position(%s, %s), 0)-1)')),
    dynaFnToSql('array_slice',            $allStates,            ^ToSql(format='(%s[greatest(%s + 1, 1) : greatest(%s, 0)])')),
    dynaFnToSql('array_drop',             $allStates,            ^ToSql(format='(%s[greatest(%s + 1, 1) : ])')),
    dynaFnToSql('array_take',             $allStates,            ^ToSql(format='(%s[ : greatest(%s, 0)])')),
    dynaFnToSql('array_first',            $allStates,            ^ToSql(format='(%s[1])')),
    dynaFnToSql('array_last',             $allStates,            ^ToSql(format='(%s[-1])')),
    dynaFnToSql('array_init',             $allStates,            ^ToSql(format='array_pop_back(%s)')),
    dynaFnToSql('array_tail',             $allStates,            ^ToSql(format='array_pop_front(%s)')),    
    dynaFnToSql('array_concatenate',      $allStates,            ^ToSql(format='array_cat(%s, %s)')),
    dynaFnToSql('range',                  $allStates,            ^ToSql(format='range(%s, %s, %s)')),
    dynaFnToSql('array_contains',         $allStates,            ^ToSql(format='ifnull(array_contains(%s, %s), false)')),
    dynaFnToSql('array_distinct',         $allStates,            ^ToSql(format='array_distinct(%s)')),
    dynaFnToSql('array_to_string',        $allStates,           ^ToSql(format='array_to_string(%s, %s)')),
