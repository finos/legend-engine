function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::getLiteralProcessorsForPostgres():Map<Type,LiteralProcessor>[1]
{
   let literalReplacementPairForString = ^LiteralReplacement(old = '\'', new = '\'\'');

   newMap([
      pair(Enum,           ^LiteralProcessor(format = 'Text%s',          transform = toString_Any_1__String_1_->literalTransform())),
      pair(String,         ^LiteralProcessor(format = 'Text\'%s\'',      transform = convertStringToSQLString($literalReplacementPairForString)->literalTransform(), literalReplacements = $literalReplacementPairForString)),
      pair(Boolean,        ^LiteralProcessor(format = 'Boolean\'%s\'',   transform = toString_Any_1__String_1_->literalTransform())),
      pair(StrictDate,     ^LiteralProcessor(format = 'Date\'%s\'',      transform = {d:StrictDate[1], dbTimeZone:String[0..1] | $d->convertDateToSqlString($dbTimeZone)})),
      pair(DateTime,       ^LiteralProcessor(format = 'Timestamp\'%s\'', transform = {d:DateTime[1], dbTimeZone:String[0..1] | $d->convertDateToSqlString($dbTimeZone)})),
      pair(Date,           ^LiteralProcessor(format = 'Timestamp\'%s\'', transform = {d:Date[1], dbTimeZone:String[0..1] | $d->convertDateToSqlString($dbTimeZone)}))
   ]);
}

function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::getDynaFunctionToSqlForPostgres(): DynaFunctionToSql[*]
{
  let allStates = allGenerationStates();

  [
    // json_build_array(x) -> 0 rather than to_json(x): to_json takes anyelement, which Postgres
    // cannot resolve for an untyped null (an empty Pure collection), whereas json_build_array is
    // variadic "any" and accepts it.  The result is identical for every typed value.
    dynaFnToSql('toVariant',              $allStates,            ^ToSql(format='coalesce(json_build_array(%s) -> 0, \'null\'::json)')),
    dynaFnToSql('toVariantList',          $allStates,            ^ToSql(format='json_build_array(%s)', transform={p:String[*] | $p->joinStrings(',')})),
    dynaFnToSql('toVariantObject',        $allStates,            ^ToSql(format='json_build_object(%s)', transform={p:String[*] | $p->joinStrings(',')})),
    dynaFnToSql('array_sort',             $allStates,            ^ToSql(format='%s', transform={p:String[1] | reshapeJsonArrayForPostgres($p->at(0), '', jsonElementOrderingForPostgres())})),
    dynaFnToSql('array_distinct',         $allStates,            ^ToSql(format='%s', transform={p:String[1] | '(select case when %s is null then null else coalesce(json_agg(s.v order by s.o), \'[]\'::json) end from (select distinct on (t.v::jsonb) t.v as v, t.o as o from json_array_elements(%s) with ordinality t(v, o) order by t.v::jsonb, t.o) s)'->format([$p->at(0), $p->at(0)])})),
    dynaFnToSql('array_flatten',          $allStates,            ^ToSql(format='%s', transform={p:String[1] | '(select case when %s is null then null else coalesce(json_agg(b.e order by a.o, b.o), \'[]\'::json) end from json_array_elements(%s) with ordinality a(v, o), lateral json_array_elements(a.v) with ordinality b(e, o))'->format([$p->at(0), $p->at(0)])})),
    dynaFnToSql('array_to_string',        $allStates,            ^ToSql(format='(select coalesce(string_agg(t.v #>> \'{}\', %s order by t.o), \'\') from json_array_elements(%s) with ordinality t(v, o))', transform={p:String[2] | [$p->at(1), $p->at(0)]})),
    dynaFnToSql('array_position',         $allStates,            ^ToSql(format='(coalesce((select min(t.o) from json_array_elements(%s) with ordinality t(v, o) where t.v::jsonb = to_json(%s)::jsonb), 0) - 1)')),
    dynaFnToSql('array_contains',         $allStates,            ^ToSql(format='coalesce((%s)::jsonb @> to_json(%s)::jsonb, false)')),
    dynaFnToSql('array_concatenate',      $allStates,            ^ToSql(format='((%s)::jsonb || (%s)::jsonb)::json')),
    dynaFnToSql('array_append',           $allStates,            ^ToSql(format='((%s)::jsonb || to_json(%s)::jsonb)::json')),
    dynaFnToSql('array_max',              $allStates,            ^ToSql(format='(select max((t.v #>> \'{}\')::numeric) from json_array_elements(%s) t(v))')),
    dynaFnToSql('array_min',              $allStates,            ^ToSql(format='(select min((t.v #>> \'{}\')::numeric) from json_array_elements(%s) t(v))')),
    dynaFnToSql('keys',                   $allStates,            ^ToSql(format='%s', transform={p:String[1] | '(select case when %s is null then null else coalesce(json_agg(t.k order by t.o), \'[]\'::json) end from json_object_keys(%s) with ordinality t(k, o))'->format([$p->at(0), $p->at(0)])})),
    dynaFnToSql('values',                 $allStates,            ^ToSql(format='%s', transform={p:String[1] | '(select case when %s is null then null else coalesce(json_agg(t.v order by t.o), \'[]\'::json) end from json_each(%s) with ordinality t(k, v, o))'->format([$p->at(0), $p->at(0)])})),
    dynaFnToSql('mapConcatenate',         $allStates,            ^ToSql(format='((%s)::jsonb || (%s)::jsonb)::json')),
    dynaFnToSql('array_size',             $allStates,            ^ToSql(format='coalesce(json_array_length(%s), 0)')),
    dynaFnToSql('array_first',            $allStates,            ^ToSql(format='(%s ->> 0)')),
    dynaFnToSql('array_last',             $allStates,            ^ToSql(format='(%s ->> -1)')),
    dynaFnToSql('array_take',             $allStates,            ^ToSql(format='%s', transform={p:String[2] | reshapeJsonArrayForPostgres($p->at(0), 'o <= greatest(%s, 0)'->format($p->at(1)), 'o')})),
    dynaFnToSql('array_drop',             $allStates,            ^ToSql(format='%s', transform={p:String[2] | reshapeJsonArrayForPostgres($p->at(0), 'o > greatest(%s, 0)'->format($p->at(1)), 'o')})),
    dynaFnToSql('array_slice',            $allStates,            ^ToSql(format='%s', transform={p:String[3] | reshapeJsonArrayForPostgres($p->at(0), 'o > greatest(%s, 0) and o <= greatest(%s, 0)'->format([$p->at(1), $p->at(2)]), 'o')})),
    dynaFnToSql('array_tail',             $allStates,            ^ToSql(format='%s', transform={p:String[1] | reshapeJsonArrayForPostgres($p->at(0), 'o > 1', 'o')})),
    dynaFnToSql('array_init',             $allStates,            ^ToSql(format='%s', transform={p:String[1] | reshapeJsonArrayForPostgres($p->at(0), 'o < json_array_length(%s)'->format($p->at(0)), 'o')})),
    dynaFnToSql('array_reverse',          $allStates,            ^ToSql(format='%s', transform={p:String[1] | reshapeJsonArrayForPostgres($p->at(0), '', 'o desc')})),
    dynaFnToSql('variantTo',              $allStates,            ^ToSql(format='%s', transform={p:String[2] | castFromJsonForPostgres($p->at(0), $p->at(1))})),
    dynaFnToSql('parseJson',              $allStates,            ^ToSql(format='cast(%s as JSON)')),
    dynaFnToSql('toJson',                 $allStates,            ^ToSql(format='%s')),
    dynaFnToSql('adjust',                 $allStates,            ^ToSql(format='(%s + (INTERVAL \'1 %s\' * %s))', transform={p:String[3] | [$p->at(0), $p->at(2)->replace('Text', '')->removeQuotesIfExist(), $p->at(1)]})), //https://www.postgresql.org/message-id/2B704E31-B533-4159-B6F0-EC284CFE824C%40skype.net,
    dynaFnToSql('booland',                $allStates,            ^ToSql(format='bool_and(%s)', transform={p:String[*] | joinStrings($p, ', ')})),
    dynaFnToSql('boolor',                 $allStates,            ^ToSql(format='bool_or(%s)', transform={p:String[*] | joinStrings($p, ', ')})),
    dynaFnToSql('concat',                 $allStates,            ^ToSql(format='%s', transform={p:String[*]|$p->joinStrings(' || ')})),
    dynaFnToSql('nullSafeEqual',          $allStates,            ^ToSql(format='%s is not distinct from %s')),
    dynaFnToSql('nullSafeNotEqual',       $allStates,            ^ToSql(format='%s is distinct from %s')),
    dynaFnToSql('dateDiff',               $allStates,            ^ToSql(format='%s', transform={p:String[*]|generateDateDiffExpressionForPostgres($p)})),
    dynaFnToSql('datePart',               $allStates,            ^ToSql(format='Date(%s)')),
    dynaFnToSql('dayOfMonth',             $allStates,            ^ToSql(format='date_part(\'day\', %s)')),
    dynaFnToSql('dayOfWeek',              $allStates,            ^ToSql(format='to_char(%s, \'FMDay\')')),
    dynaFnToSql('dayOfWeekNumber',        $allStates,            ^ToSql(format='date_part(\'dow\', %s)')),
    dynaFnToSql('dayOfYear',              $allStates,            ^ToSql(format='date_part(\'doy\', %s)')),
    dynaFnToSql('decodeBase64',           $allStates,            ^ToSql(format='convert_from(decode(%s, \'base64\'), \'utf8\')')),
    dynaFnToSql('encodeBase64',           $allStates,            ^ToSql(format='encode(convert_to(%s, \'UTF8\'), \'base64\')')),
    dynaFnToSql('extractFromSemiStructured', $allStates,         ^ToSql(format='%s', transform={p:String[3]|$p->processExtractFromSemiStructuredParamsForPostgres()})),
    dynaFnToSql('firstDayOfMonth',        $allStates,            ^ToSql(format='date_trunc(\'month\', %s)')),
    dynaFnToSql('firstDayOfQuarter',      $allStates,            ^ToSql(format='date_trunc(\'quarter\', %s)')),
    dynaFnToSql('firstDayOfThisMonth',    $allStates,            ^ToSql(format='date_trunc(\'month\', CURRENT_DATE)%s', transform={p:String[*] | ''})),
    dynaFnToSql('firstDayOfThisQuarter',  $allStates,            ^ToSql(format='date_trunc(\'quarter\', CURRENT_DATE)%s', transform={p:String[*] | ''})),
    dynaFnToSql('firstDayOfThisYear',     $allStates,            ^ToSql(format='date_trunc(\'year\', CURRENT_DATE)%s', transform={p:String[*] | ''})),
    dynaFnToSql('firstDayOfWeek',         $allStates,            ^ToSql(format='date_trunc(\'week\', %s)')),
    dynaFnToSql('firstDayOfYear',         $allStates,            ^ToSql(format='date_trunc(\'year\', %s)')),
    dynaFnToSql('firstHourOfDay',         $allStates,            ^ToSql(format='date_trunc(\'day\', %s)')),
    dynaFnToSql('firstMillisecondOfSecond', $allStates,          ^ToSql(format='date_trunc(\'second\', %s)')),
    dynaFnToSql('firstMinuteOfHour',      $allStates,            ^ToSql(format='date_trunc(\'hour\', %s)')),
    dynaFnToSql('firstSecondOfMinute',    $allStates,            ^ToSql(format='date_trunc(\'minute\', %s)')),
    dynaFnToSql('generateGuid',           $allStates,            ^ToSql(format='cast(gen_random_uuid() as varchar)')),
    dynaFnToSql('hour',                   $allStates,            ^ToSql(format='date_part(\'hour\', %s)')),
    dynaFnToSql('indexOf',                $allStates,            ^ToSql(format='strpos(%s, %s)')),
    dynaFnToSql('joinStrings',            $allStates,            ^ToSql(format='string_agg(%s, %s)')),
    dynaFnToSql('length',                 $allStates,            ^ToSql(format='char_length(%s)')),
    dynaFnToSql('log10',                  $allStates,            ^ToSql(format='log(%s)')),
    dynaFnToSql('matches',                $allStates,            ^ToSql(format=regexpMatchPostgres('%s'), transform={p:String[2]|$p->transformRegexpParams()})),
    dynaFnToSql('regexpCount',            $allStates,            ^ToSql(format='%s', transform={p:String[3]|$p->transformRegexpCountPostgres()})),
    dynaFnToSql('regexpExtract',          $allStates,            ^ToSql(format='%s', transform={p:String[5]|$p->transformRegexpExtractPostgres()})),
    dynaFnToSql('regexpIndexOf',          $allStates,            ^ToSql(format='%s', transform={p:String[4]|$p->transformRegexpIndexOfPostgres()})),
    dynaFnToSql('regexpLike',             $allStates,            ^ToSql(format='%s', transform={p:String[3]|$p->transformRegexpLikePostgres()})),
    dynaFnToSql('regexpReplace',          $allStates,            ^ToSql(format='%s', transform={p:String[5]|$p->transformRegexpReplacePostgres()})),
    dynaFnToSql('minute',                 $allStates,            ^ToSql(format='date_part(\'minute\', %s)')),
    dynaFnToSql('month',                  $allStates,            ^ToSql(format='date_part(\'month\', %s)')),
    dynaFnToSql('monthName',              $allStates,            ^ToSql(format='to_char(%s, \'FMMonth\')')),
    dynaFnToSql('monthNumber',            $allStates,            ^ToSql(format='date_part(\'month\', %s)')),
    dynaFnToSql('mostRecentDayOfWeek',    $allStates,            ^ToSql(format='cast(%s as date) + cast(case when %s - date_part(\'dow\', %s) > 0 then %s - date_part(\'dow\', %s) - 7 else %s - date_part(\'dow\', %s) end as integer)', transform={p:String[1..2] | $p->formatMostRecentPostgres('current_date')}, parametersWithinWhenClause = [false, false])),
    dynaFnToSql('now',                    $allStates,            ^ToSql(format='now()')),
    dynaFnToSql('parseDecimal',           $allStates,            ^ToSql(format='%s', transform={p:String[*] |$p->transformParseDecimal()})),
    dynaFnToSql('parseFloat',             $allStates,            ^ToSql(format='cast(%s as float)')),
    dynaFnToSql('parseInteger',           $allStates,            ^ToSql(format='cast(%s as integer)')),
    dynaFnToSql('position',               $allStates,            ^ToSql(format='position(%s in %s)')),
    dynaFnToSql('previousDayOfWeek',      $allStates,            ^ToSql(format='cast(%s as date) + cast(case when %s - date_part(\'dow\', %s) >= 0 then %s - date_part(\'dow\', %s) - 7 else %s - date_part(\'dow\', %s) end as integer)', transform={p:String[1..2] | $p->formatMostRecentPostgres('current_date')}, parametersWithinWhenClause = [false, false])),
    dynaFnToSql('quarter',                $allStates,            ^ToSql(format='date_part(\'quarter\', %s)')),
    dynaFnToSql('quarterNumber',          $allStates,            ^ToSql(format='date_part(\'quarter\', %s)')),
    dynaFnToSql('round',                  $allStates,            ^ToSql(format='round((%s)::numeric, %s)', transform=transformRound_String_MANY__String_MANY_)),
    dynaFnToSql('second',                 $allStates,            ^ToSql(format='date_part(\'second\', %s)')),
    dynaFnToSql('sha1',                   $allStates,            ^ToSql(format='encode(digest(%s, \'sha1\'), \'hex\')')),
    dynaFnToSql('sha256',                 $allStates,            ^ToSql(format='encode(digest(%s, \'sha256\'), \'hex\')')),
    dynaFnToSql('split',                  $allStates,            ^ToSql(format='string_to_array(%s, %s)')),
    dynaFnToSql('substring',              $allStates,            ^ToSql(format='substring%s', transform={p:String[*]|$p->joinStrings('(', ', ', ')')})),
    dynaFnToSql('stdDevPopulation',       $allStates,            ^ToSql(format='stddev_pop(%s)')),
    dynaFnToSql('stdDevSample',           $allStates,            ^ToSql(format='stddev_samp(%s)')),
    dynaFnToSql('today',                  $allStates,            ^ToSql(format='current_date')),
    dynaFnToSql('toDecimal',              $allStates,            ^ToSql(format='cast(%s as decimal)')),
    dynaFnToSql('toFloat',                $allStates,            ^ToSql(format='cast(%s as double precision)')),
    dynaFnToSql('toString',               $allStates,            ^ToSql(format='cast(%s as varchar)')),
    dynaFnToSql('toTimestamp',            $allStates,            ^ToSql(format='to_timestamp(%s, %s)')),
    dynaFnToSql('weekOfYear',             $allStates,            ^ToSql(format='date_part(\'week\', %s)')),
    dynaFnToSql('year',                   $allStates,            ^ToSql(format='date_part(\'year\', %s)')),
    dynaFnToSql('formatDate',             $allStates,            ^ToSql(format='%s', transform={p:String[2] | $p->transformFormatDatePostgres()}))
  ];
}

function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::transformFormatDatePostgres(params:String[2]):String[1]
{
  let enumValue = $params->at(1)->replace('\'', '')->replace('Text', '');
  let formatPairs = [
    pair('ISO8601', '\'YYYY-MM-DD\''),
    pair('ISO8601_NanoSecondPrecision', '\'YYYY-MM-DD"T"HH24:MI:SS.US000\'')
  ];
  let sqlFmt = $formatPairs->filter(p | $p.first == $enumValue).second->toOne('Unsupported DateFormat: ' + $enumValue);
  format('TO_CHAR(%s,%s)', [$params->at(0), $sqlFmt]);
}

function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::jsonElementOrderingForPostgres():String[1]
{
  // json has no ordering operator, so sort numbers numerically and everything else as text.  The
  // numeric key is null for non-numbers, which falls through to the text key.
  '(case when json_typeof(t.v) = \'number\' then (t.v #>> \'{}\')::numeric end), (t.v #>> \'{}\')';
}

function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::reshapeJsonArrayForPostgres(array:String[1], where:String[1], order:String[1]):String[1]
{
  // Postgres has no list functions over json, so any reshaping of a json array is done by exploding
  // it and rebuilding it.  o is the 1-based element position; the order by inside json_agg is what
  // preserves (or reverses) element order, since scan order is not guaranteed.
  let filter = if($where == '', |'', |' where ' + $where);
  // The case guard keeps a null array null: json_agg over zero rows is null either way, so without
  // it a null input would come back as an empty array instead.
  '(select case when %s is null then null else coalesce(json_agg(t.v order by %s), \'[]\'::json) end from json_array_elements(%s) with ordinality t(v, o)%s)'
    ->format([$array, $order, $array, $filter]);
}

function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::castFromJsonForPostgres(expr:String[1], dbType:String[1]):String[1]
{
  // Postgres cannot cast a json value directly to a scalar type, and casting it to text keeps the
  // quotes around json strings -- cast('"1"'::json as TEXT) is "1", which is not a valid bigint.
  // #>> '{}' extracts the scalar as unquoted text.  https://www.postgresql.org/docs/current/functions-json.html
  // to_json normalises the operand first: #>> is only defined on json, but the expression reaching
  // here is sometimes already text (e.g. json_extract_path_text), and to_json is a no-op on json.
  let unquoted = 'to_json(%s) #>> \'{}\''->format($expr);
  if ($dbType->startsWith('JSON'),
    | $expr,
    | if ($dbType->startsWith('VARCHAR') || $dbType->startsWith('CHAR') || $dbType == 'TEXT',
        | '(%s)'->format($unquoted),
        | 'cast(%s as %s)'->format([$unquoted, $dbType])));
}

function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::processExtractFromSemiStructuredParamsForPostgres(params:String[3]):String[1]
{
  let baseRelationalOp = $params->at(0);
  let pathNavigation = $params->at(1)->split('.')->map(s|'\'' + $s + '\'')->joinStrings(', ');
  let returnType = $params->at(2);

  // https://www.postgresql.org/docs/current/functions-json.html
  // json_*, not jsonb_*: a Variant is json here, and the jsonb overloads do not accept it.  The
  // operand is cast because it is not always json already -- a flattened element arrives as text.
  let operand = format('cast(%s as json)', $baseRelationalOp);
  let elementAccess = if ($returnType == 'JSON',
    | format('json_extract_path(%s, %s)', [$operand, $pathNavigation]),
    | format('json_extract_path_text(%s, %s)', [$operand, $pathNavigation]));

  if ($returnType->in(['CHAR', 'VARCHAR', 'STRING']), | 'cast(' + $elementAccess + ' as VARCHAR)', |
  if ($returnType->in(['DATE','DATETIME', 'TIMESTAMP']), | 'cast(' + $elementAccess + ' as TIMESTAMP)', |
  if ($returnType == 'BOOLEAN', | 'cast(' + $elementAccess + ' as BOOLEAN)', |
  if ($returnType == 'FLOAT', | 'cast(' + $elementAccess + ' as DOUBLE PRECISION)', |
  if ($returnType == 'INTEGER', | 'cast(' + $elementAccess + ' as INTEGER)', |
  $elementAccess)))));
}

function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::generateDateDiffExpressionForPostgres(params:String[*]):String[1]
{
  let enumList = [DurationUnit.YEARS,DurationUnit.MONTHS,DurationUnit.WEEKS,DurationUnit.DAYS,DurationUnit.HOURS,DurationUnit.MINUTES,DurationUnit.SECONDS,DurationUnit.MILLISECONDS]->map(e|$e->toString());

  let indexOfDiff = $enumList->indexOf($params->at(2)->replace('\'', '')->replace('Text', ''));

  let dbSpecificUnits = [

     { | format('(%s)', [
        'DATE_PART(\'year\', %s) - DATE_PART(\'year\', %s)'
     ])},
     {| format('(%s * 12 + (%s))', [
        generateDateDiffExpressionForPostgres([$params->at(0), $params->at(1), DurationUnit.YEARS->toString()]),
        'DATE_PART(\'month\', %s) - DATE_PART(\'month\', %s)'
     ])},
     {| format('(%s)', [
        'TRUNC((%s - %s) / 7)'
     ])},
     {| format('(%s)', [
        '%s - %s'
     ])},
     {| format('(%s)', [
        '(trunc(DATE_PART(\'EPOCH\', (%s - %s)) / 3600))::bigint'
     ])},
     {| format('(%s)', [
        '(trunc(DATE_PART(\'EPOCH\', (%s - %s)) / 60))::bigint'
     ])},
     {| format('(%s)', [
        'trunc(DATE_PART(\'EPOCH\', (%s - %s)))::bigint'
     ])},
     {| format('(%s)', [
        '(trunc(DATE_PART(\'EPOCH\', (%s - %s)) * 1000))::bigint'
     ])}
  ];

  format($dbSpecificUnits->at($indexOfDiff)->eval(), [$params->at(1), $params->at(0)]);
}

function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::processJoinStringsOperationForPostgres(js:JoinStrings[1], sgc:SqlGenerationContext[1]): String[1]
{
   processJoinStringsOperation($js, $sgc, [], {strs, sep| $strs->joinStrings('concat(', if('Text\'\'' == $sep, |', ', |',' + $sep + ',') , ')')});
}

function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::processSelectSQLQueryForPostgres(s:SelectSQLQuery[1], sgc:SqlGenerationContext[1], isSubSelect:Boolean[1]):String[1]
{
   $s->processSelectSQLQueryForPostgres($sgc.dbConfig, $sgc.format, $sgc.config, $isSubSelect, $sgc.extensions);
}

function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::processSelectSQLQueryForPostgres(s:SelectSQLQuery[1], dbConfig : DbConfig[1], format:Format[1], config:Config[1], isSubSelect : Boolean[1], extensions:Extension[*]):String[1]
{
  assertEmpty($s.pivot, 'pivot is not supported');
  assertEmpty($s.qualifyOperation, 'QUALIFY grammar is not supported');
  let opStr = if($s.filteringOperation->isEmpty(), |'', |$s.filteringOperation->map(s|$s->processOperation($dbConfig, $format->indent(), ^$config(callingFromFilter = true), $extensions))->filter(s|$s != '')->joinStrings(' <||> '));
  let havingStr = if($s.havingOperation->isEmpty(), |'', |$s.havingOperation->map(s|$s->processOperation($dbConfig, $format->indent(), $config, $extensions))->filter(s|$s != '')->joinStrings(' <||> '));

  $format.separator + 'select ' + if($s.distinct == true,|'distinct ',|'') +
  processSelectColumns($s.columns, $dbConfig, $format->indent(), true, $extensions) +
  if($s.data == [],|'',| ' ' + $format.separator + 'from ' + $s.data->toOne()->processJoinTreeNode([], $dbConfig, $format->indent(), [], $extensions)) +
  if (eq($opStr, ''), |'', | ' ' + $format.separator + 'where ' + $opStr) +
  if ($s.groupBy->isEmpty(),|'',| ' ' + $format.separator + 'group by '+$s.groupBy->processGroupByColumnsForPostgres($s.columns, $dbConfig, $format->indent(), $extensions)->makeString(','))+
  if (eq($havingStr, ''), |'', | ' ' + $format.separator + 'having ' + $havingStr) +
  if ($s.orderBy->isEmpty(),|'',| ' ' + $format.separator + 'order by '+ $s.orderBy->processOrderBy($dbConfig, $format->indent(), $config, $extensions)->makeString(','))+
  + processLimit($s, $dbConfig, $format, $extensions, processTakeDefault_SelectSQLQuery_1__Format_1__DbConfig_1__Extension_MANY__String_1_, processSliceOrDropForPostgres_SelectSQLQuery_1__Format_1__DbConfig_1__Extension_MANY__Any_1__String_1_);
}

function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::processGroupByColumnsForPostgres(groupByColumns:RelationalOperationElement[*], selectColumns:RelationalOperationElement[*], dbConfig : DbConfig[1], format:Format[1], extensions:Extension[*]):String[*]
{ 
   let selectColNames = $selectColumns->map(c | $c->match([
                                                    a: Alias[1] | $a.name, 
                                                    any: Any[*] | $any
                                                  ])
                                           );
   $groupByColumns->map(c | $c->match([
                                a:Alias[1] | ($selectColNames->indexOf($a.name) + 1)->toString(),
                                c:TableAliasColumn[1] | $c->processOperation($dbConfig, $format, $extensions)
                               ])
                       );
}

function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::processSliceOrDropForPostgres(s:SelectSQLQuery[1], format:Format[1],dbConfig : DbConfig[1], extensions:Extension[*], size:Any[1]):String[1]
{
   '%s offset %s'->format([$format.separator, $s.fromRow->toOne()->getValueForTake($format, $dbConfig, $extensions)]) + if ($size == -1, | '', | ' limit %s'->format($size));
}

function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::getDDLCommandsTranslatorForPostgres(): RelationalDDLCommandsTranslator[1]
{
  ^RelationalDDLCommandsTranslator(
                createSchema = translateCreateSchemaStatementForPostgres_CreateSchemaSQL_1__DbConfig_1__String_$0_1$_,
                dropSchema =  translateDropSchemaStatementForPostgres_DropSchemaSQL_1__DbConfig_1__String_$0_1$_,
                createTable =  translateCreateTableStatementDefault_CreateTableSQL_1__DbConfig_1__String_1_,
                dropTable = translateDropTableStatementDefault_DropTableSQL_1__DbConfig_1__String_1_,
                loadTable =  loadValuesToDbTableDefault_LoadTableSQL_1__DbConfig_1__String_MANY_
              );
}

function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::translateCreateSchemaStatementForPostgres(createSchemaSQL:CreateSchemaSQL[1], dbConfig:DbConfig[1]) : String[0..1]
{
   if ($createSchemaSQL.schema.name == 'default', 
    | [], 
    | 'Create Schema if not exists ' + $createSchemaSQL.schema.name + ';';);
}

function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::translateDropSchemaStatementForPostgres(dropSchemaSQL:DropSchemaSQL[1], dbConfig:DbConfig[1]) : String[0..1]
{
  if ($dropSchemaSQL.schema.name == 'default', 
    |  [], 
    | 'Drop schema if exists ' + $dropSchemaSQL.schema.name + ' CASCADE;')
}

// See meta::relational::functions::sqlQueryToString::default::regexpPattern for why the group is required.
function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::regexpMatchPostgres(query: String[1]): String[1]
{
   '%s ~ \'^(?:' + $query + ')$\''
}

function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::formatMostRecentPostgres(p: String[1..2], defaultDay: String[1]): String[*]
{
   let day = $p->last()->toOne()->mapToDBDayOfWeekNumberPostgres()->toString();
   let current = if ($p->size() == 2, | $p->first()->toOne(), | $defaultDay);
   [$current, $day, $current, $day, $current, $day, $current];
}

function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::mapToDBDayOfWeekNumberPostgres(day: String[1]): Integer[1]
{
   let stringProc = getLiteralProcessorsForPostgres()->get(String)->toOne();
   let enumProc = getLiteralProcessorsForPostgres()->get(Enum)->toOne();

   [
      pair(list([$enumProc.formatValue(DayOfWeek.Monday, []), $stringProc.formatValue(DayOfWeek.Monday->toString(), [])]), 1),
      pair(list([$enumProc.formatValue(DayOfWeek.Tuesday, []), $stringProc.formatValue(DayOfWeek.Tuesday->toString(), [])]), 2),
      pair(list([$enumProc.formatValue(DayOfWeek.Wednesday, []), $stringProc.formatValue(DayOfWeek.Wednesday->toString(), [])]), 3),
      pair(list([$enumProc.formatValue(DayOfWeek.Thursday, []), $stringProc.formatValue(DayOfWeek.Thursday->toString(), [])]), 4),
      pair(list([$enumProc.formatValue(DayOfWeek.Friday, []), $stringProc.formatValue(DayOfWeek.Friday->toString(), [])]), 5),
      pair(list([$enumProc.formatValue(DayOfWeek.Saturday, []), $stringProc.formatValue(DayOfWeek.Saturday->toString(), [])]), 6),
      pair(list([$enumProc.formatValue(DayOfWeek.Sunday, []), $stringProc.formatValue(DayOfWeek.Sunday->toString(), [])]), 0)
   ]->filter(p | $p.first.values->contains($day)).second->toOne();
}

function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::processSemiStructuredElementForPostgres(s:RelationalOperationElement[1], sgc:SqlGenerationContext[1]): String[1]
{
   $s->match([
      o:SemiStructuredObjectNavigation[1]     | $o->processSemiStructuredObjectNavigationForPostgres($sgc),
      f:SemiStructuredArrayFlatten[1]         | $f->processSemiStructuredArrayFlattenForPostgres($sgc),
      f:SemiStructuredArrayFlattenOutput[1]   | $f->processSemiStructuredArrayFlattenOutputForPostgres($sgc),
      f:SemiStructuredArrayFlattenRelation[1] | ^SemiStructuredArrayFlatten(navigation = $f.navigation)->processSemiStructuredArrayFlattenForPostgres($sgc)
   ])
}

function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::processSemiStructuredObjectNavigationForPostgres(s:SemiStructuredObjectNavigation[1], sgc:SqlGenerationContext[1]): String[1]
{
   let processedOperand = $s.operand->processOperation($sgc);

   let elementAccess = $s->match([
      p: SemiStructuredPropertyAccess[1]     | 'json_extract_path(%s, %s)'->format([$processedOperand, $p.property->processOperation($sgc)]),
      a: SemiStructuredArrayElementAccess[1] | '(%s->%s)'->format([$processedOperand, $a.index->processOperation($sgc)])
   ]);

   if ($s.returnType->isNotEmpty(), 
    |
      let dbType = meta::relational::functions::pureToSqlQuery::genericTypeToDataType(^GenericType(rawType = $s.returnType), PureOne)->meta::relational::functions::sqlQueryToString::postgres::dataTypeToSqlTextPostgres();
      castFromJsonForPostgres($elementAccess, $dbType);,
    | 
      $elementAccess
  );
}

// Postgres takes an explicit flags argument on its regex functions, so RegexpParameter maps onto it
// directly rather than onto an inline prefix. 'n' is newline-sensitive matching, which is what
// MULTILINE asks for; 's' is non-newline-sensitive, which is DOTALL.
// Postgres renders literals with a type prefix - Text'abc', Boolean'false' - so a literal argument
// has to be unwrapped before it can be compared or split.
function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::unwrapLiteralPostgres(literal: String[1]):String[1]
{
   let withoutType = if ($literal->startsWith('Text'), | $literal->substring(4, $literal->length()),
                        | if ($literal->startsWith('Boolean'), | $literal->substring(7, $literal->length()), | $literal));
   $withoutType->removeQuotesIfExist();
}

// ARE expresses newline handling as a single mode letter rather than as independent flags, so
// MULTILINE and NON_NEWLINE_SENSITIVE cannot simply be concatenated - 'ns' is self-contradictory.
// The four combinations map to: p (neither - the Java default), n (^/$ per line), s (. matches
// newline), w (both).
function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::regexpFlagsForPostgres(regexpParametersAsString: String[1]):String[1]
{
   let regexpParameters = $regexpParametersAsString->unwrapLiteralPostgres()->split(',');
   let caseFlag = if ($regexpParameters->contains('CASE_INSENSITIVE'), | 'i', | '');
   let multiline = $regexpParameters->contains('MULTILINE');
   let dotAll = $regexpParameters->contains('NON_NEWLINE_SENSITIVE');
   let newlineFlag = if ($multiline && $dotAll, | 'w',
                        | if ($multiline, | 'n',
                             | if ($dotAll, | 's', | 'p')));
   $caseFlag + $newlineFlag;
}

function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::transformRegexpLikePostgres(params: String[3]):String[1]
{
   'regexp_like(' + $params->at(0) + ', ' + $params->at(1) + ', \'' + $params->at(2)->regexpFlagsForPostgres() + '\')';
}

function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::transformRegexpCountPostgres(params: String[3]):String[1]
{
   'regexp_count(' + $params->at(0) + ', ' + $params->at(1) + ', 1, \'' + $params->at(2)->regexpFlagsForPostgres() + '\')';
}

// regexp_instr is 1-based and returns 0 for no match; Pure is 0-based and returns -1, so one
// subtraction converts both. The seventh argument selects the capture group.
function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::transformRegexpIndexOfPostgres(params: String[4]):String[1]
{
   '(regexp_instr(' + $params->at(0) + ', ' + $params->at(1) + ', 1, 1, 0, \'' + $params->at(3)->regexpFlagsForPostgres() + '\', ' + $params->at(2) + ') - 1)';
}

// regexp_substr returns a single match; Postgres has no scalar function returning every match, so
// extractAll has no expressible form here.
function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::transformRegexpExtractPostgres(params: String[5]):String[1]
{
   assert($params->at(2)->unwrapLiteralPostgres() == 'false', | 'regexpExtract with extractAll=true is not supported on Postgres: regexp_substr returns a single match and there is no scalar all-matches function');
   'regexp_substr(' + $params->at(0) + ', ' + $params->at(1) + ', 1, 1, \'' + $params->at(4)->regexpFlagsForPostgres() + '\', ' + $params->at(3) + ')';
}

function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::transformRegexpReplacePostgres(params: String[5]):String[1]
{
   let flags = $params->at(4)->regexpFlagsForPostgres() + if ($params->at(3)->unwrapLiteralPostgres() == 'true', | 'g', | '');
   'regexp_replace(' + $params->at(0) + ', ' + $params->at(1) + ', ' + $params->at(2) + ', \'' + $flags + '\')';
}

function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::processSemiStructuredArrayFlattenForPostgres(s:SemiStructuredArrayFlatten[1], sgc:SqlGenerationContext[1]): String[1]
{
   // https://www.postgresql.org/docs/current/functions-json.html
   // VALUE is left unquoted to match how the reference to it is emitted: it is not a Postgres
   // reserved word, so identifierProcessor does not quote it and Postgres folds both to "value".
   //
   // The element is exposed as text, not json, because the caller wraps this column in a plain
   // cast(... as <type>) and Postgres has no cast from json to a scalar type.  #>> '{}' yields the
   // unquoted scalar, which casts to both the scalar types and (for objects/arrays) back to json.
   let processedNavigation = $s.navigation->processOperation($sgc);
   '(select "value" #>> \'{}\' as VALUE from json_array_elements(' + $processedNavigation + '))';
}

function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::processSemiStructuredArrayFlattenOutputForPostgres(s:SemiStructuredArrayFlattenOutput[1], sgc:SqlGenerationContext[1]): String[1]
{
   let doubleQuote = if($sgc.config.useQuotesForTableAliasColumn == false, |'', |'"');
   let processedIdentifier = $sgc.dbConfig.identifierProcessor($doubleQuote + $s.tableAliasColumn.alias.name->toOne() + $doubleQuote);
   let flattenedValue = $processedIdentifier + '.' + processColumnName('VALUE', $sgc.dbConfig);

   // A plain cast, not castFromJsonForPostgres: the flatten column is already unquoted text
   // (see processSemiStructuredArrayFlattenForPostgres), so scalars parse directly and a JSON
   // target re-parses the element's json text.
   if ($s.returnType->isNotEmpty(),
    |
      let dbType = meta::relational::functions::pureToSqlQuery::genericTypeToDataType(^GenericType(rawType = $s.returnType->toOne()), PureOne)->meta::relational::functions::sqlQueryToString::postgres::dataTypeToSqlTextPostgres();
      'cast(%s as %s)'->format([$flattenedValue, $dbType]);,
    |
      $flattenedValue
   );
}

function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::processJoinTreeNodeWithLateralJoinForPostgres(j:JoinTreeNode[1], dbConfig : DbConfig[1], format:Format[1], extensions:Extension[*]):String[1]
{
   // https://www.postgresql.org/docs/current/queries-table-expressions.html#QUERIES-LATERAL
   // The comma form is an inner join, matching the semantics the other dialects implement.
   ', lateral '
   + $j.alias
         ->map(a|^$a(name = '"' + $a.name + '"'))
         ->toOne()->processOperation($dbConfig, ^$format(newLine = '')->indent(), $extensions) + $format.separator();
}

function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::buildLambdaParameterForPostgres(param: RelationalLambdaParameter[1], sgc: SqlGenerationContext[1]): String[1]
{
  castFromJsonForPostgres('"' + $param.name + '"', $sgc.dbConfig.dataTypeToSqlText($param.type));
}

function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::buildLambdaForPostgres(lambda: RelationalLambda[1], sgc: SqlGenerationContext[1]): String[1]
{
  $lambda->match([
    map: MapRelationalLambda[1]       | buildMapLambdaForPostgres($map, $sgc),
    filter: FilterRelationalLambda[1] | buildFilterLambdaForPostgres($filter, $sgc),
    fold: FoldRelationalLambda[1]     | buildFoldLambdaForPostgres($fold, $sgc)
  ]);
}

function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::buildFoldLambdaForPostgres(lambda: FoldRelationalLambda[1], sgc: SqlGenerationContext[1]): String[1]
{
  // Postgres has no reduce over an array, so the fold is walked with a recursive CTE: one row per
  // step, joined to the element at that position.  Postgres allows this inside a scalar subquery
  // and lets it correlate to the outer row.
  //
  // The CTE column is named after the accumulator parameter and the set-returning function's column
  // after the element parameter, so the unqualified references the lambda parameter processor emits
  // resolve to them.  The seed is cast to the accumulator type because the recursive term's column
  // type is taken from the non-recursive term.
  let element = $lambda.parameters->at(0);
  let accumulator = $lambda.parameters->at(1);
  // A character accumulator is seeded as TEXT rather than VARCHAR(n): concatenation in the recursive
  // term yields unbounded text, and Postgres requires both terms to agree on the column type.
  let declaredType = $sgc.dbConfig.dataTypeToSqlText($accumulator.type);
  let accumulatorType = if($declaredType->startsWith('VARCHAR') || $declaredType->startsWith('CHAR'), |'TEXT', |$declaredType);

  '(with recursive legend_fold("legend_i", "%s") as (select 0, cast(%s as %s) union all select f."legend_i" + 1, %s from legend_fold f join json_array_elements(%s) with ordinality e("%s", "legend_o") on e."legend_o" = f."legend_i" + 1) select "%s" from legend_fold order by "legend_i" desc limit 1)'
    ->format([
        $accumulator.name,
        $accumulator.value->processOperation($sgc),
        $accumulatorType,
        $lambda.body->processOperation($sgc),
        $element.value->processOperation($sgc),
        $element.name,
        $accumulator.name
     ]);
}

function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::buildFilterLambdaForPostgres(lambda: FilterRelationalLambda[1], sgc: SqlGenerationContext[1]): String[1]
{
  '(select coalesce(json_agg("%s" order by legend_ord), \'[]\'::json) from %s where %s)'->format([
      $lambda.parameters->at(0).name,
      $lambda->flattenedSourceForPostgres($sgc),
      $lambda.body->processOperation($sgc)
   ]);
}

function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::buildMapLambdaForPostgres(lambda: MapRelationalLambda[1], sgc: SqlGenerationContext[1]): String[1]
{
  '(select coalesce(json_agg(%s order by legend_ord), \'[]\'::json) from %s)'->format([
      $lambda.body->processOperation($sgc),
      $lambda->flattenedSourceForPostgres($sgc)
   ]);
}

function <<access.private>> meta::relational::functions::sqlQueryToString::postgres::flattenedSourceForPostgres(lambda: RelationalLambda[1], sgc: SqlGenerationContext[1]): String[1]
{
  // WITH ORDINALITY + the order by in the aggregate is what preserves element order; scan order is not guaranteed.
  let name = $lambda.parameters->at(0).name;
  'json_array_elements(%s) with ordinality as "%s__src"("%s", legend_ord)'->format([
      $lambda.parameters->at(0).value->processOperation($sgc),
      $name,
      $name
   ]);
}
