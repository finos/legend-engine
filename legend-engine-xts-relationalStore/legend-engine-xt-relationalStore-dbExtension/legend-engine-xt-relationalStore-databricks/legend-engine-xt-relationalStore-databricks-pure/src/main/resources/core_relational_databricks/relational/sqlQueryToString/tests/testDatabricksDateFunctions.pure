import meta::relational::tests::functions::sqlstring::*;
import meta::pure::mapping::*;
import meta::relational::functions::asserts::*;
import meta::relational::mapping::*;
import meta::relational::tests::*;
import meta::external::store::relational::tests::*;
import meta::relational::tests::model::simple::*;
import meta::pure::profiles::*;
import meta::relational::functions::sqlstring::*;
import meta::relational::runtime::*;
import meta::external::store::relational::runtime::*;
import meta::relational::functions::sqlQueryToString::tests::*;
import meta::relational::tests::functions::sqlstring::databricks::*;

function <<test.Test>> meta::relational::tests::functions::sqlstring::databricks::testDateDiffMonthsCountsCalendarMonthBoundariesDatabricks():Boolean[1]
{
  let sql = toSQLString(|Trade.all()->project(t|dateDiff($t.settlementDateTime->toOne(), %2016-02-01T00:00:00+0000, DurationUnit.MONTHS), 'months'),
    simpleRelationalMapping, DatabaseType.Databricks, meta::relational::extension::relationalExtensions());
  assertEquals('select (year(to_timestamp(\'2016-02-01 00:00:00\')) * 12 + month(to_timestamp(\'2016-02-01 00:00:00\'))) - (year(`root`.settlementDateTime) * 12 + month(`root`.settlementDateTime)) as `months` from tradeTable as `root`', $sql);
}

function <<test.Test>> meta::relational::tests::functions::sqlstring::databricks::testDateDiffHoursTruncatesElapsedMicrosecondsDatabricks():Boolean[1]
{
  let sql = toSQLString(|Trade.all()->project(t|dateDiff($t.settlementDateTime->toOne(), %2016-02-01T00:00:00+0000, DurationUnit.HOURS), 'hours'),
    simpleRelationalMapping, DatabaseType.Databricks, meta::relational::extension::relationalExtensions());
  assertEquals('select cast((unix_micros(to_timestamp(\'2016-02-01 00:00:00\')) - unix_micros(`root`.settlementDateTime)) div 3600000000 AS INT) as `hours` from tradeTable as `root`', $sql);
}

function <<test.Test>> meta::relational::tests::functions::sqlstring::databricks::testDateDiffMillisecondsTruncatesElapsedMicrosecondsDatabricks():Boolean[1]
{
  let sql = toSQLString(|Trade.all()->project(t|dateDiff($t.settlementDateTime->toOne(), %2016-02-01T00:00:00+0000, DurationUnit.MILLISECONDS), 'milliseconds'),
    simpleRelationalMapping, DatabaseType.Databricks, meta::relational::extension::relationalExtensions());
  assertEquals('select (unix_micros(to_timestamp(\'2016-02-01 00:00:00\')) - unix_micros(`root`.settlementDateTime)) div 1000 as `milliseconds` from tradeTable as `root`', $sql);
}

function <<test.Test>> meta::relational::tests::functions::sqlstring::databricks::testFormatDateNanoSecondPrecisionEscapesQuotedTDatabricks():Boolean[1]
{
  let sql = toSQLString(|Trade.all()->project(t|$t.settlementDateTime->toOne()->formatDate(DateTimeFormat.ISO8601_NanoSecondPrecision), 'formatted'),
    simpleRelationalMapping, DatabaseType.Databricks, meta::relational::extension::relationalExtensions());
  assertEquals('select date_format(`root`.settlementDateTime,\'yyyy-MM-dd\\\'T\\\'HH:mm:ss.SSSSSSSSS\') as `formatted` from tradeTable as `root`', $sql);
}

function <<test.Test>> meta::relational::tests::functions::sqlstring::databricks::testDateDiffWeeksCountsSundayBoundariesDatabricks():Boolean[1]
{
  let sql = toSQLString(|Trade.all()->project(t|dateDiff($t.settlementDateTime->toOne(), %2016-02-01T00:00:00+0000, DurationUnit.WEEKS), 'weeks'),
    simpleRelationalMapping, DatabaseType.Databricks, meta::relational::extension::relationalExtensions());
  assertEquals('select case when to_timestamp(\'2016-02-01 00:00:00\') >= `root`.settlementDateTime then cast(floor((unix_timestamp(to_timestamp(\'2016-02-01 00:00:00\')) + 345600) / 604800) - floor((unix_timestamp(`root`.settlementDateTime) + 345600) / 604800) as INT) else cast(ceil((unix_timestamp(to_timestamp(\'2016-02-01 00:00:00\')) + 345600) / 604800) - ceil((unix_timestamp(`root`.settlementDateTime) + 345600) / 604800) as INT) end as `weeks` from tradeTable as `root`', $sql);
}

function <<test.Test>> meta::relational::tests::functions::sqlstring::databricks::testYearMonthDateLiteralRendersWithoutDayDatabricks():Boolean[1]
{
  let sql = toSQLString(|Trade.all()->project(t|%2015-04->monthNumber(), 'month'),
    simpleRelationalMapping, DatabaseType.Databricks, meta::relational::extension::relationalExtensions());
  assertEquals('select month(to_date(\'2015-04\')) as `month` from tradeTable as `root`', $sql);
}

function <<test.Test>> meta::relational::tests::functions::sqlstring::databricks::testMinuteDateLiteralRendersWithoutSecondsDatabricks():Boolean[1]
{
  let sql = toSQLString(|Trade.all()->project(t|%2015-04-15T17:09->minute(), 'minute'),
    simpleRelationalMapping, DatabaseType.Databricks, meta::relational::extension::relationalExtensions());
  assertEquals('select minute(to_timestamp(\'2015-04-15 17:09\')) as `minute` from tradeTable as `root`', $sql);
}

function <<test.Test>> meta::relational::tests::functions::sqlstring::databricks::testDateLiteralToStringIsRenderedInPureDatabricks():Boolean[1]
{
  let sql = toSQLString(|Trade.all()->project(t|%2014-01-02T01:54:27.352+0000->toString(), 'formatted'),
    simpleRelationalMapping, DatabaseType.Databricks, meta::relational::extension::relationalExtensions());
  assertEquals('select \'2014-01-02T01:54:27.352+0000\' as `formatted` from tradeTable as `root`', $sql);
}

function <<test.Test>> meta::relational::tests::functions::sqlstring::databricks::testHourOfYearOnlyDateLiteralFailsDatabricks():Boolean[1]
{
  assertError({|toSQLString(|Trade.all()->project(t|%2017->hour(), 'hour'),
    simpleRelationalMapping, DatabaseType.Databricks, meta::relational::extension::relationalExtensions())}, 'Cannot get hour for 2017');
}

function <<test.Test>> meta::relational::tests::functions::sqlstring::databricks::testDatePartOfYearMonthDateLiteralFailsDatabricks():Boolean[1]
{
  assertError({|toSQLString(|Trade.all()->project(t|%1973-11->datePart(), 'day'),
    simpleRelationalMapping, DatabaseType.Databricks, meta::relational::extension::relationalExtensions())}, 'Databricks cannot represent the Year or Year-Month precision of Date literal 1973-11 in a native DATE/TIMESTAMP column; datePart() would silently lose that precision.');
}
