import meta::pure::executionPlan::*;
import meta::pure::executionPlan::toString::*;
import meta::pure::metamodel::tds::*;
import meta::pure::profiles::*;
import meta::relational::extension::*;
import meta::relational::functions::sqlstring::*;
import meta::relational::runtime::*;
import meta::relational::tests::*;
import meta::relational::tests::functions::sqlstring::databricks::*;
import meta::relational::tests::model::simple::*;

function <<access.private>> meta::relational::tests::functions::sqlstring::databricks::databricksTestRuntime():meta::core::runtime::Runtime[1]
{
  ^meta::core::runtime::Runtime(connectionStores = ^meta::core::runtime::ConnectionStore(element = meta::relational::tests::db, connection = ^meta::external::store::relational::runtime::TestDatabaseConnection(type = DatabaseType.Databricks)))
}

function <<access.private>> meta::relational::tests::functions::sqlstring::databricks::inWithCollectionParameterQuery():FunctionDefinition<Any>[1]
{
  {ages:Integer[1..*]|Person.all()->filter(p|$p.age->toOne()->in($ages))->project([col(p:Person[1]|$p.firstName, 'firstName')])}
}

function <<access.private>> meta::relational::tests::functions::sqlstring::databricks::activationSql(f:FunctionDefinition<Any>[1]):String[1]
{
  let context = ^meta::relational::runtime::FunctionActivatorExecutionContext(postProcessor = meta::relational::postProcessor::ReplaceFreeMarkerWithTableFunctionParamHolder_SQLQuery_1__PostProcessorResult_1_);
  $f->generatedSql($context);
}

function <<access.private>> meta::relational::tests::functions::sqlstring::databricks::generatedSql(f:FunctionDefinition<Any>[1], context:meta::pure::runtime::ExecutionContext[1]):String[1]
{
  let plan = executionPlan($f, simpleRelationalMapping, databricksTestRuntime(), $context, relationalExtensions());
  $plan.rootExecutionNode->meta::pure::executionPlan::allNodes(relationalExtensions())
    ->filter(n | $n->instanceOf(meta::relational::mapping::SQLExecutionNode))->cast(@meta::relational::mapping::SQLExecutionNode)
    ->filter(n | $n.sqlQuery->toLower()->startsWith('select'))->last()->toOne('no select query generated').sqlQuery;
}

// Activation embeds the generated SQL directly in CREATE FUNCTION DDL, with no FreeMarker phase left
// to expand a renderCollection() macro. processInOperation replaces the collection parameter with an
// inFilterClause placeholder, which the activation post processor turns into a flatten over the
// parameter, read through the func_param_table CTE that createFunction emits.
function <<test.Test>> meta::relational::tests::functions::sqlstring::databricks::testActivationInWithCollectionParameterIsFlattened():Boolean[1]
{
  let sql = activationSql(inWithCollectionParameterQuery());
  assertEquals('select `root`.FIRSTNAME as `firstName` from personTable as `root` where `root`.AGE in (select `root`.value from (select `col` as `VALUE` from (select explode_outer(param_ages) from func_param_table)) as `root`)', $sql);
}

// A bounded to-many multiplicity is as much a collection as [*] and [1..*]; it must not be rendered
// as a scalar placeholder, which would leave a ${ages} macro in the activation DDL.
function <<test.Test>> meta::relational::tests::functions::sqlstring::databricks::testActivationInWithBoundedCollectionParameterIsFlattened():Boolean[1]
{
  let sql = activationSql({ages:Integer[1..3]|Person.all()->filter(p|$p.age->toOne()->in($ages))->project([col(p:Person[1]|$p.firstName, 'firstName')])});
  assertEquals(activationSql(inWithCollectionParameterQuery()), $sql);
}

function <<test.Test>> meta::relational::tests::functions::sqlstring::databricks::testActivationContainsWithCollectionParameterMatchesInForm():Boolean[1]
{
  let containsSql = activationSql({ages:Integer[1..*]|Person.all()->filter(p|$ages->contains($p.age->toOne()))->project([col(p:Person[1]|$p.firstName, 'firstName')])});
  assertEquals(activationSql(inWithCollectionParameterQuery()), $containsSql);
}

function <<test.Test>> meta::relational::tests::functions::sqlstring::databricks::testActivationScalarParameterUsesParameterTable():Boolean[1]
{
  let sql = activationSql({threshold:Integer[1]|Person.all()->filter(p|$p.age->toOne() > $threshold)->project([col(p:Person[1]|$p.firstName, 'firstName')])});
  assertEquals('select `root`.FIRSTNAME as `firstName` from personTable as `root` where `root`.AGE > (SELECT param_threshold FROM func_param_table)', $sql);
}

// On the plan path the same placeholder is supplied by the allocation node processInOperation adds, which
// renders the collection inline below the collection threshold and spills to a temp table above it.
function <<test.Test>> meta::relational::tests::functions::sqlstring::databricks::testInWithCollectionParameterUsesInFilterClauseOnThePlanPath():Boolean[1]
{
  let sql = generatedSql(inWithCollectionParameterQuery(), ^meta::pure::runtime::ExecutionContext());
  assertEquals('select `root`.FIRSTNAME as `firstName` from personTable as `root` where `root`.AGE in (${inFilterClause_ages})', $sql);
}
