      meta::relational::runtime::DatabaseType.Databricks,
      meta::relational::extension::relationalExtensions()
   );
   assertEquals('select `root`.FIRM_DETAILS:`legalName`::STRING as `Legal Name` from FIRM_TABLE as `root`', $result);
}

