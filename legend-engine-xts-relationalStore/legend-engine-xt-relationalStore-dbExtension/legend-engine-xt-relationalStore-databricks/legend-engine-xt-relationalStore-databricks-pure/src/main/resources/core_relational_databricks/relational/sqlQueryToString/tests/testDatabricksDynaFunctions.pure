function <<test.Test>> meta::relational::tests::functions::sqlstring::databricks::testToSQLStringNowDatabricks():Boolean[1]
{
   let result = toSQLString(|Trade.all()->filter(t | $t.date < now())->project([t | $t.id], ['id']),
                                                simpleRelationalMapping,
                                                meta::relational::runtime::DatabaseType.Databricks, meta::relational::extension::relationalExtensions());
   assertEquals('select `root`.ID as `id` from tradeTable as `root` where `root`.tradeDate < current_timestamp', $result);
}

