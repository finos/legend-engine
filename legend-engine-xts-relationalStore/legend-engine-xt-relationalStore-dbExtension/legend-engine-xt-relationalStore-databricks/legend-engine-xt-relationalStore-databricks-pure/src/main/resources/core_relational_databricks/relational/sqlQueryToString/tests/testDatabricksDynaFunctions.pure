function <<test.Test>> meta::relational::tests::functions::sqlstring::databricks::testToSQLStringFilterDatabricks():Boolean[1]
{
   let result = toSQLString(|Person.all()->filter(p | $p.firstName == 'John')->project([p | $p.firstName], ['name']),
                                                simpleRelationalMapping,
                                                meta::relational::runtime::DatabaseType.Databricks, meta::relational::extension::relationalExtensions());
   assertEquals('select `root`.FIRSTNAME as `name` from personTable as `root` where `root`.FIRSTNAME = \'John\'', $result);
}

