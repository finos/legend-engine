                                                simpleRelationalMapping,
                                                meta::relational::runtime::DatabaseType.Databricks, meta::relational::extension::relationalExtensions());
   assertEquals('select `root`.FIRSTNAME as `name` from personTable as `root` where `root`.FIRSTNAME like \'Jo%\'', $result);
}

