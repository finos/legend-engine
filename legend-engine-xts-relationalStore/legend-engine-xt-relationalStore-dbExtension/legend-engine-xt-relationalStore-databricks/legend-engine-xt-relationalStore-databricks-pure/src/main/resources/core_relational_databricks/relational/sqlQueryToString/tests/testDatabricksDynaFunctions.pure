function <<test.Test>> meta::relational::tests::functions::sqlstring::databricks::testToSQLStringParseDateDatabricks():Boolean[1]
{
   let result = toSQLString(|SqlFunctionDemo.all()->project([s | $s.string2DateUserDefinedFormatddMONyyyy], ['parseDate']),
                                                testMapping,
                                                meta::relational::runtime::DatabaseType.Databricks, meta::relational::extension::relationalExtensions());
   assertEquals('select to_date(`root`.string2date,\'ddMMMyyyy\') as `parseDate` from dataTable as `root`', $result);
}

