function <<db.ExtensionLoader>> meta::relational::functions::sqlQueryToString::databricks::dbExtensionLoaderForDatabricks():DbExtensionLoader[1]
{
  ^DbExtensionLoader(dbType = DatabaseType.Databricks, loader = createDbExtensionForDatabricks__DbExtension_1_);
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::databricksReservedWords():String[*]
{
    //https://docs.databricks.com/sql/language-manual/sql-ref-reserved-words.html
    [
       'anti', 'cross', 'catalog', 'except', 'full', 'inner', 'intersect', 'join', 'lateral',
       'left', 'minus', 'natural', 'on', 'right', 'semi', 'union', 'using', 'all', 'alter',
       'and', 'any', 'array', 'as', 'at', 'authorization', 'between', 'both', 'by', 'case',
       'cast', 'check', 'collate', 'column', 'commit', 'constraint', 'create', 'cross', 'cube',
       'current', 'current_date', 'current_time', 'current_timestamp', 'current_user', 'delete',
       'describe', 'distinct', 'drop', 'else', 'end', 'escape', 'except', 'exists', 'external',
       'extract', 'false', 'fetch', 'filter', 'for', 'foreign', 'from', 'full', 'function',
       'global', 'grant', 'group', 'grouping', 'having', 'in', 'inner', 'insert', 'intersect',
       'interval', 'into', 'is', 'join', 'leading', 'left', 'like', 'local', 'natural', 'no', 'not',
       'null', 'of', 'on', 'only', 'or', 'order', 'out', 'outer', 'overlaps', 'partition', 'position',
       'primary', 'range', 'references', 'revoke', 'right', 'rollback', 'rollup', 'row', 'rows', 'select',
       'session_user', 'set', 'some', 'start', 'table', 'tablesample', 'then', 'time', 'to', 'trailing',
       'true', 'truncate', 'union', 'unique', 'unknown', 'update', 'user', 'using', 'values', 'when',
       'where', 'window', 'with'
   ];
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::createDbExtensionForDatabricks():DbExtension[1]
{
   let reservedWords = databricksReservedWords();
   let literalProcessors = getDefaultLiteralProcessors()->putAll(getLiteralProcessorsForDatabricks());
   let literalProcessor = {type:Type[1]| $literalProcessors->get(if($type->instanceOf(Enumeration), | Enum, | $type))->toOne()};
   let baseDynaFuncDispatch = getDynaFunctionToSqlDefault($literalProcessor)->groupBy(d| $d.funcName)->putAll(
     getDynaFunctionToSqlForDatabricks()->groupBy(d| $d.funcName))->getDynaFunctionDispatcher();
   // VARIANT array operands need a `cast(... as array<variant>)`; typed arrays stay bare (Snowflake-matching).
   let dynaFuncDispatch = {func:DynaFunction[1], sgc:SqlGenerationContext[1] | $func->dynaFuncDispatchForDatabricks($sgc, $baseDynaFuncDispatch)};

   ^DbExtension(
      isBooleanLiteralSupported = true,
      collectionThresholdLimit = 10000,
      aliasLimit = 255,
      tableFunctionParamProcessor = processTableFunctionParamPlaceHolder_RelationalOperationElement_1__SqlGenerationContext_1__String_1_,
      isDbReservedIdentifier = {str:String[1]| $str->in($reservedWords)},
      literalProcessor = $literalProcessor,
      windowColumnProcessor = processWindowColumnForDatabricks_WindowColumn_1__SqlGenerationContext_1__String_1_,
      semiStructuredElementProcessor = processSemiStructuredElementForDatabricks_RelationalOperationElement_1__SqlGenerationContext_1__String_1_,
      tabularFunctionProcessor = meta::relational::functions::sqlQueryToString::databricks::tabularFunctionProcessorForDatabricks_String_1__String_1__FunctionParameter_MANY__String_1_,
      variableDeclarationProcessor = variableDeclarationProcessorForDatabricks_VariableDeclaration_1__SqlGenerationContext_1__String_1_,
      lateralJoinProcessor = processJoinTreeNodeWithLateralJoinForDatabricks_JoinTreeNode_1__DbConfig_1__Format_1__Extension_MANY__String_1_,
      joinStringsProcessor = processJoinStringsOperationWithConcatCall_JoinStrings_1__SqlGenerationContext_1__String_1_,
      selectSQLQueryProcessor = processSelectSQLQueryForDatabricks_SelectSQLQuery_1__SqlGenerationContext_1__Boolean_1__String_1_,
      schemaNameToIdentifier = schemaNameToIdentifierForDatabricks_String_1__DbConfig_1__String_1_,
      columnNameToIdentifier = columnNameToIdentifierDefault_String_1__DbConfig_1__String_1_,
      identifierProcessor = processIdentifierWithBackTicks_String_1__DbConfig_1__String_1_,
      dynaFuncDispatch = $dynaFuncDispatch,
      ddlCommandsTranslator = getDDLCommandsTranslatorForDatabricks(),
      dataTypeToSqlText = meta::relational::functions::typeConversion::databricks::dataTypeToSqlTextDatabricks_DataType_1__String_1_,
      pureTypeToDatabaseTypeConverter = meta::relational::functions::typeConversion::databricks::convert_GenericType_1__DataType_1_,
      buildDummyConnection = meta::relational::functions::sqlQueryToString::databricks::buildDummyConnection__RelationalDatabaseConnection_1_,
      lambdaParameterProcessor = buildLambdaParameterForDatabricks_RelationalLambdaParameter_1__SqlGenerationContext_1__String_1_,
      lambdaProcessor = buildLambdaForDatabricks_RelationalLambda_1__SqlGenerationContext_1__String_1_
   );
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::getLiteralProcessorsForDatabricks():Map<Type,LiteralProcessor>[1]
{
   newMap([
      // escape single quotes in string
      pair(String,         ^LiteralProcessor(format = '\'%s\'',               transform = {s:String[1], a:String[0..1] | $s->replace('\'','\\\'')})),
      // the default processor quotes these; Spark would coerce the string back to a boolean, but
      // emitting the keyword keeps the column a real BOOLEAN over JDBC instead of a VARCHAR
      pair(Boolean,        ^LiteralProcessor(format = '%s',                   transform = toString_Any_1__String_1_->literalTransform())),
      pair(StrictDate,     ^LiteralProcessor(format = 'to_date(\'%s\')',      transform = {d:StrictDate[1], dbTimeZone:String[0..1] | $d->convertDateToSqlString($dbTimeZone)})),
      pair(DateTime,       ^LiteralProcessor(format = 'to_timestamp(\'%s\')', transform = {d:DateTime[1], dbTimeZone:String[0..1] | $d->convertDateToSqlString($dbTimeZone)})),
      pair(Date,           ^LiteralProcessor(format = 'to_date(\'%s\')',      transform = {d:Date[1], dbTimeZone:String[0..1] | $d->convertDateToSqlString($dbTimeZone)}))
   ]);
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::getDynaFunctionToSqlForDatabricks(): DynaFunctionToSql[*]
{
  let allStates = allGenerationStates();

  [
    dynaFnToSql('adjust',                 $allStates,            ^ToSql(format='%s', transform={p:String[3] | $p->at(0) + ' + INTERVAL ' + $p->at(1) + ' ' + $p->at(2)->mapToDBUnitType()})),
    dynaFnToSql('booland',                $allStates,            ^ToSql(format='bool_and(%s)', transform={p:String[*] | joinStrings($p, ', ')})),
    dynaFnToSql('boolor',                 $allStates,            ^ToSql(format='bool_or(%s)', transform={p:String[*] | joinStrings($p, ', ')})),
    dynaFnToSql('concat',                 $allStates,            ^ToSql(format='concat%s', transform={p:String[*]|$p->joinStrings('(', ', ', ')')})),
    dynaFnToSql('nullSafeEqual',          $allStates,            ^ToSql(format='%s is not distinct from %s')),
    dynaFnToSql('nullSafeNotEqual',       $allStates,            ^ToSql(format='%s is distinct from %s')),
    dynaFnToSql('convertDate',            $allStates,            ^ToSql(format='%s', transform={p:String[*] | $p->convertToDateDatabricks()})),
    dynaFnToSql('convertDateTime',        $allStates,            ^ToSql(format='%s', transform={p:String[*] | $p->convertToDateTimeDatabricks()})),
    dynaFnToSql('convertVarchar128',      $allStates,            ^ToSql(format='cast(%s as STRING)')),
    dynaFnToSql('dateDiff',               $allStates,            ^ToSql(format='%s', transform={p:String[2..3] | $p->dateDiffDatabricks()})),
    dynaFnToSql('datePart',               $allStates,            ^ToSql(format='to_date(%s)')),
    dynaFnToSql('dayOfMonth',             $allStates,            ^ToSql(format='dayofmonth(%s)')),
    dynaFnToSql('dayOfWeekNumber',        $allStates,            ^ToSql(format='dayofweek(%s)')),
    dynaFnToSql('dayOfYear',              $allStates,            ^ToSql(format='dayofyear(%s)')),
    dynaFnToSql('dayOfWeek',              $allStates,            ^ToSql(format='DECODE(EXTRACT(dayofweek FROM %s), 2, \'Monday\', 3, \'Tuesday\', 4, \'Wednesday\', 5, \'Thursday\', 6, \'Friday\', 7, \'Saturday\', 1, \'Sunday\')')),
    dynaFnToSql('decodeBase64',           $allStates,            ^ToSql(format='cast(unbase64(%s) AS STRING)')),
    dynaFnToSql('encodeBase64',           $allStates,            ^ToSql(format='base64(%s)')),
    dynaFnToSql('firstDayOfMonth',        $allStates,            ^ToSql(format='trunc(%s, \'MONTH\')')),
    dynaFnToSql('firstDayOfQuarter',      $allStates,            ^ToSql(format='trunc(%s, \'QUARTER\')')),
    dynaFnToSql('firstDayOfThisMonth',    $allStates,            ^ToSql(format='trunc(current_date(), \'MONTH\')%s', transform={p:String[*] | ''})),
    dynaFnToSql('firstDayOfThisQuarter',  $allStates,            ^ToSql(format='trunc(CURRENT_DATE, \'QUARTER\')%s', transform={p:String[*] | ''})),
    dynaFnToSql('firstDayOfThisYear',     $allStates,            ^ToSql(format='trunc(CURRENT_DATE, \'YEAR\')%s', transform={p:String[*] | ''})),
    dynaFnToSql('firstDayOfWeek',         $allStates,            ^ToSql(format='trunc(%s, \'WEEK\')')),
    dynaFnToSql('firstDayOfYear',         $allStates,            ^ToSql(format='trunc(%s, \'YEAR\')')),
    dynaFnToSql('firstHourOfDay',         $allStates,            ^ToSql(format='date_trunc(\'DAY\', %s)')),
    dynaFnToSql('firstMillisecondOfSecond', $allStates,          ^ToSql(format='date_trunc(\'SECOND\', %s)')),
    dynaFnToSql('firstMinuteOfHour',      $allStates,            ^ToSql(format='date_trunc(\'HOUR\', %s)')),
    dynaFnToSql('firstSecondOfMinute',    $allStates,            ^ToSql(format='date_trunc(\'MINUTE\', %s)')),
    dynaFnToSql('hour',                   $allStates,            ^ToSql(format='hour(%s)')),
    dynaFnToSql('hashCode',               $allStates,            ^ToSql(format='hash(%s)', transform={p:String[*] | $p->joinStrings(', ')})),
    dynaFnToSql('indexOf',                $allStates,            ^ToSql(format='locate(%s)', transform={p:String[2] | $p->at(1) + ', ' + $p->at(0)})),
    dynaFnToSql('isNumeric',              $allStates,            ^ToSql(format='(lower(%s) = upper(%s))')),
    dynaFnToSql('isAlphaNumeric',         $allStates,            ^ToSql(format='%s', transform={p:String[1]|$p->transformAlphaNumericParamsDatabricks()})),
    dynaFnToSql('joinStrings',            $allStates,            ^ToSql(format='array_join(collect_list(%s), %s)')),
    dynaFnToSql('length',                 $allStates,            ^ToSql(format='length(%s)')),
    dynaFnToSql('matches',                $allStates,            ^ToSql(format='%s', transform={p:String[2]|$p->transformRegexpParamsDatabricks()})),
    dynaFnToSql('maxBy',                  $allStates,            ^ToSql(format='MAX_BY(%s)', transform={p:String[*] | $p->joinStrings(', ')})),
    dynaFnToSql('minBy',                  $allStates,            ^ToSql(format='MIN_BY(%s)', transform={p:String[*] | $p->joinStrings(', ')})),
    dynaFnToSql('minute',                 $allStates,            ^ToSql(format='minute(%s)')),
    dynaFnToSql('month',                  $allStates,            ^ToSql(format='month(%s)')),
    dynaFnToSql('monthNumber',            $allStates,            ^ToSql(format='month(%s)')),
    dynaFnToSql('monthName',              $allStates,            ^ToSql(format='to_char(%s, \'MMMM\')')),
    dynaFnToSql('mostRecentDayOfWeek',    $allStates,            ^ToSql(format='date_sub(%s, case when dayofweek(%s) = %s then 0 else dayofweek(%s) - %s end)', transform={p:String[1..2] | $p->formatMostRecentDatabricks('current_date()')}, parametersWithinWhenClause = [false, false])),
    dynaFnToSql('now',                    $allStates,            ^ToSql(format='current_timestamp')),
    dynaFnToSql('parseDate',              $allStates,            ^ToSql(format='%s', transform={p:String[*] | $p->transformParseDateDatabricks()})),
    dynaFnToSql('parseDecimal',           $allStates,            ^ToSql(format='%s', transform={p:String[*] |$p->transformParseDecimal()})),
    dynaFnToSql('parseFloat',             $allStates,            ^ToSql(format='cast(%s as double)')),
    dynaFnToSql('parseInteger',           $allStates,            ^ToSql(format='cast(%s as bigint)')),
    dynaFnToSql('parseJson',              $allStates,            ^ToSql(format='parse_json(%s)')),
    dynaFnToSql('position',               $allStates,            ^ToSql(format='position(%s, %s)')),
    dynaFnToSql('previousDayOfWeek',      $allStates,            ^ToSql(format='date_sub(%s, case when dayofweek(%s) = %s then 7 else dayofweek(%s) - %s end)', transform={p:String[1..2] | $p->formatMostRecentDatabricks('current_date()')}, parametersWithinWhenClause = [false, false])),
    dynaFnToSql('quarter',                $allStates,            ^ToSql(format='quarter(%s)')),
    dynaFnToSql('quarterNumber',          $allStates,            ^ToSql(format='quarter(%s)')),
    dynaFnToSql('round',                  $allStates,            ^ToSql(format='round(%s, %s)', transform=transformRound_String_MANY__String_MANY_)),
    dynaFnToSql('second',                 $allStates,            ^ToSql(format='second(%s)')),
    dynaFnToSql('sha256',                 $allStates,            ^ToSql(format='sha2(%s, 256)')),
    dynaFnToSql('split',                  $allStates,            ^ToSql(format='split(%s, %s)')),
    dynaFnToSql('sqlFalse',               $allStates,            ^ToSql(format='false')),
    dynaFnToSql('sqlTrue',                $allStates,            ^ToSql(format='true')),
    dynaFnToSql('substring',              $allStates,            ^ToSql(format='substring%s', transform={p:String[*]|$p->joinStrings('(', ', ', ')')})),
    dynaFnToSql('stdDevPopulation',       $allStates,            ^ToSql(format='stddev_pop(%s)')),
    dynaFnToSql('stdDevSample',           $allStates,            ^ToSql(format='stddev_samp(%s)')),
    dynaFnToSql('today',                  $allStates,            ^ToSql(format='current_date')),
    dynaFnToSql('toDecimal',              $allStates,            ^ToSql(format='cast(%s as decimal)')),
    dynaFnToSql('toFloat',                $allStates,            ^ToSql(format='cast(%s as double)')),
    dynaFnToSql('toJson',                 $allStates,            ^ToSql(format='to_json(%s)')),
    dynaFnToSql('toString',               $allStates,            ^ToSql(format='cast(%s as string)')),
    dynaFnToSql('weekOfYear',             $allStates,            ^ToSql(format='weekofyear(%s)')),
    dynaFnToSql('year',                   $allStates,            ^ToSql(format='year(%s)')),
    dynaFnToSql('formatDate',             $allStates,            ^ToSql(format='%s', transform={p:String[2] | $p->transformFormatDateDatabricks()})),
    dynaFnToSql('extractFromSemiStructured', $allStates, ^ToSql(format='%s', transform={p:String[3]|$p->processExtractFromSemiStructuredParamsForDatabricks()})),

    // Array functions: registered with bare typed-array codegen (mirrors Snowflake). When the operand
    // is relationally VARIANT, the dispatcher swaps in the array<variant> variant (see
    // arrayFunctionVariantOverrideForDatabricks / dynaFuncDispatchForDatabricks).
    dynaFnToSql('array_max',              $allStates,            ^ToSql(format='array_max(%s)')),
    dynaFnToSql('array_min',              $allStates,            ^ToSql(format='array_min(%s)')),
    dynaFnToSql('array_sum',              $allStates,            ^ToSql(format='aggregate(%s, cast(0 as DOUBLE), (acc, x) -> acc + x)')),
    dynaFnToSql('array_sort',             $allStates,            ^ToSql(format='array_sort(%s)')),
    dynaFnToSql('array_reverse',          $allStates,            ^ToSql(format='reverse(%s)')),
    dynaFnToSql('array_size',             $allStates,            ^ToSql(format='ifnull(size(%s), 0)')),
    dynaFnToSql('array_append',           $allStates,            ^ToSql(format='array_append(%s, %s)')),
    dynaFnToSql('array_position',         $allStates,            ^ToSql(format='ifnull(array_position(%s, %s) - 1, -1)')),
    dynaFnToSql('array_slice',            $allStates,            ^ToSql(format='slice(%s, greatest(%s, 0) + 1, greatest(%s - %s, 0))', transform={vals:String[*] | [$vals->at(0), $vals->at(1), $vals->at(2), $vals->at(1)]})),
    dynaFnToSql('array_drop',             $allStates,            ^ToSql(format='slice(%s, greatest(%s, 0) + 1, greatest(size(%s) - greatest(%s, 0), 0))', transform={vals:String[*] | [$vals->at(0), $vals->at(1), $vals->at(0), $vals->at(1)]})),
    dynaFnToSql('array_take',             $allStates,            ^ToSql(format='slice(%s, 1, greatest(%s, 0))')),
    dynaFnToSql('array_first',            $allStates,            ^ToSql(format='try_element_at(%s, 1)')),
    dynaFnToSql('array_last',             $allStates,            ^ToSql(format='try_element_at(%s, -1)')),
    dynaFnToSql('array_init',             $allStates,            ^ToSql(format='slice(%s, 1, greatest(size(%s) - 1, 0))', transform={vals:String[*] | $vals->concatenate($vals->at(0))})),
    dynaFnToSql('array_tail',             $allStates,            ^ToSql(format='slice(%s, 2, greatest(size(%s) - 1, 0))', transform={vals:String[*] | $vals->concatenate($vals->at(0))})),
    dynaFnToSql('array_concatenate',      $allStates,            ^ToSql(format='concat(%s, %s)')),
    dynaFnToSql('range',                  $allStates,            ^ToSql(format='%s', transform={p:String[3] | $p->transformRangeDatabricks()})),
    dynaFnToSql('array_contains',         $allStates,            ^ToSql(format='ifnull(array_contains(%s, %s), false)')),
    dynaFnToSql('array_distinct',         $allStates,            ^ToSql(format='array_distinct(%s)')),
    dynaFnToSql('array_to_string',        $allStates,            ^ToSql(format='array_join(cast(%s as ARRAY<STRING>), %s)')),
    dynaFnToSql('array_flatten',          $allStates,            ^ToSql(format='flatten(%s)')),

    // Bit functions
    dynaFnToSql('bitAnd',                 $allStates,            ^ToSql(format='(%s & %s)')),
    dynaFnToSql('bitNot',                 $allStates,            ^ToSql(format='(~ %s)')),
    dynaFnToSql('bitOr',                  $allStates,            ^ToSql(format='(%s | %s)')),
    dynaFnToSql('bitShiftLeft',           $allStates,            ^ToSql(format='shiftleft(%s, %s)')),
    dynaFnToSql('bitShiftRight',          $allStates,            ^ToSql(format='shiftright(%s, %s)')),
    dynaFnToSql('bitXor',                 $allStates,            ^ToSql(format='(%s ^ %s)')),

    // Variant/semi-structured functions
    dynaFnToSql('toVariant',              $allStates,            ^ToSql(format='%s', transform={p:String[*] | $p->toVariantForDatabricks()})),
    dynaFnToSql('toVariantList',          $allStates,            ^ToSql(format='array(%s)', transform={p:String[*] | $p->joinStrings(',')})),
    dynaFnToSql('toVariantObject',        $allStates,            ^ToSql(format='map(%s)', transform={p:String[*] | $p->transformToVariantObjectDatabricks()})),
    dynaFnToSql('keys',                   $allStates,            ^ToSql(format='map_keys(%s)')),
    dynaFnToSql('values',                 $allStates,            ^ToSql(format='map_values(%s)')),
    dynaFnToSql('mapConcatenate',         $allStates,            ^ToSql(format='map_concat(%s, %s)')),
    dynaFnToSql('parseBoolean',           $allStates,            ^ToSql(format='cast(%s as BOOLEAN)')),

    // Other functions
    dynaFnToSql('generateGuid',           $allStates,            ^ToSql(format='uuid()')),
    dynaFnToSql('levenshteinDistance',    $allStates,            ^ToSql(format='levenshtein(%s, %s)')),
    dynaFnToSql('date',                   $allStates,            ^ToSql(format='%s', transform={p:String[*] | $p->transformDateConstructionForDatabricks()}))
  ];
}

// Swaps in the array<variant> codegen when the array operand is relationally VARIANT. The decision
// needs the operand's relational type (only available on the DynaFunction node, not the rendered SQL),
// so it is made here rather than inside a `ToSql` transform.
function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::dynaFuncDispatchForDatabricks(func:DynaFunction[1], sgc:SqlGenerationContext[1], baseDispatch:meta::pure::metamodel::function::Function<{DynaFunction[1], SqlGenerationContext[1]->DynaFunctionToSql[1]}>[1]):DynaFunctionToSql[1]
{
   let variantOverride = arrayFunctionVariantOverrideForDatabricks()->get($func.name);
   if($variantOverride->isNotEmpty() && $func.parameters->isNotEmpty() && $func.parameters->at(0)->isSemiStructuredOperandForDatabricks(),
      | ^DynaFunctionToSql(funcName = $func.name, stateMatch = [], toSql = $variantOverride->toOne()),
      | $baseDispatch->eval($func, $sgc)
   );
}

// True when the operand renders to a Databricks VARIANT value: a semi-structured navigation, or any
// operation whose inferred relational type is SemiStructured (e.g. a Variant column).
function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::isSemiStructuredOperandForDatabricks(op:RelationalOperationElement[1]):Boolean[1]
{
   if($op->instanceOf(SemiStructuredObjectNavigation)
        || $op->instanceOf(SemiStructuredArrayFlatten)
        || $op->instanceOf(SemiStructuredArrayFlattenOutput)
        || $op->instanceOf(SemiStructuredArrayFlattenRelation),
      | true,
      | let inferred = meta::relational::functions::typeInference::inferRelationalType($op, false);
        $inferred->isNotEmpty() && $inferred->toOne()->instanceOf(meta::relational::metamodel::datatype::SemiStructured);
   );
}

// array<variant> codegen used when the operand is VARIANT. Element-comparison functions
// (append/position/contains) also cast the scalar element to variant to match the element type.
function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::arrayFunctionVariantOverrideForDatabricks():Map<String, ToSql>[1]
{
   newMap([
      pair('array_max',         ^ToSql(format='array_max(cast(%s as array<variant>))')),
      pair('array_min',         ^ToSql(format='array_min(cast(%s as array<variant>))')),
      pair('array_sum',         ^ToSql(format='aggregate(cast(%s as array<variant>), cast(0 as DOUBLE), (acc, x) -> acc + x)')),
      pair('array_sort',        ^ToSql(format='array_sort(cast(%s as array<variant>))')),
      pair('array_reverse',     ^ToSql(format='reverse(cast(%s as array<variant>))')),
      pair('array_size',        ^ToSql(format='ifnull(size(cast(%s as array<variant>)), 0)')),
      pair('array_append',      ^ToSql(format='array_append(cast(%s as array<variant>), cast(%s as variant))')),
      pair('array_position',    ^ToSql(format='ifnull(array_position(cast(%s as array<variant>), cast(%s as variant)) - 1, -1)')),
      pair('array_slice',       ^ToSql(format='slice(cast(%s as array<variant>), greatest(%s, 0) + 1, greatest(%s - %s, 0))', transform={vals:String[*] | [$vals->at(0), $vals->at(1), $vals->at(2), $vals->at(1)]})),
      pair('array_drop',        ^ToSql(format='slice(cast(%s as array<variant>), greatest(%s, 0) + 1, greatest(size(cast(%s as array<variant>)) - greatest(%s, 0), 0))', transform={vals:String[*] | [$vals->at(0), $vals->at(1), $vals->at(0), $vals->at(1)]})),
      pair('array_take',        ^ToSql(format='slice(cast(%s as array<variant>), 1, greatest(%s, 0))')),
      pair('array_first',       ^ToSql(format='try_element_at(cast(%s as array<variant>), 1)')),
      pair('array_last',        ^ToSql(format='try_element_at(cast(%s as array<variant>), -1)')),
      pair('array_init',        ^ToSql(format='slice(cast(%s as array<variant>), 1, greatest(size(cast(%s as array<variant>)) - 1, 0))', transform={vals:String[*] | $vals->concatenate($vals->at(0))})),
      pair('array_tail',        ^ToSql(format='slice(cast(%s as array<variant>), 2, greatest(size(cast(%s as array<variant>)) - 1, 0))', transform={vals:String[*] | $vals->concatenate($vals->at(0))})),
      pair('array_concatenate', ^ToSql(format='concat(cast(%s as array<variant>), cast(%s as array<variant>))')),
      pair('array_contains',    ^ToSql(format='ifnull(array_contains(cast(%s as array<variant>), cast(%s as variant)), false)')),
      pair('array_distinct',    ^ToSql(format='array_distinct(cast(%s as array<variant>))')),
      pair('array_flatten',     ^ToSql(format='flatten(cast(%s as array<variant>))'))
   ]);
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::transformParseDateDatabricks(params:String[*]):String[1]
{
  assert(2 - $params->size() >= 0, 'Incorrect number of parameters for parseDate: parseDate(column,[dateformat])');
  // Databricks/Spark datetime patterns use 'MMM' for the abbreviated month name (Snowflake uses 'MON').
  let dateFormat = if($params->size() == 1,
                      | '\'yyyy-MM-dd\'',
                      | $params->at(1)->replace('MON', 'MMM'));
  'to_date(' + $params->at(0) + ',' + $dateFormat + ')';
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::transformFormatDateDatabricks(params:String[2]):String[1]
{
  let enumValue = $params->at(1)->replace('\'', '')->replace('Text', '');
  let formatPairs = [
    pair('ISO8601', '\'yyyy-MM-dd\''),
    pair('ISO8601_NanoSecondPrecision', '\'yyyy-MM-dd\'\'T\'\'HH:mm:ss.SSSSSSSSS\'')
  ];
  let sqlFmt = $formatPairs->filter(p | $p.first == $enumValue).second->toOne('Unsupported DateFormat: ' + $enumValue);
  format('date_format(%s,%s)', [$params->at(0), $sqlFmt]);
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::transformRangeDatabricks(params:String[3]):String[1]
{
   // Pure/Snowflake `range` treats stop as EXCLUSIVE; Databricks `sequence` treats it as INCLUSIVE and
   // errors when the step sign disagrees with the start/stop direction. Adjust the inclusive end by one
   // per step sign, and emit an empty array when the range is empty.
   let start = $params->at(0);
   let stop = $params->at(1);
   let step = $params->at(2);
   'case ' +
   'when ' + $step + ' = 0 then sequence(' + $start + ', ' + $stop + ', ' + $step + ') ' +
   'when ' + $step + ' > 0 and ' + $start + ' < ' + $stop + ' then sequence(' + $start + ', ' + $stop + ' - 1, ' + $step + ') ' +
   'when ' + $step + ' < 0 and ' + $start + ' > ' + $stop + ' then sequence(' + $start + ', ' + $stop + ' + 1, ' + $step + ') ' +
   'else cast(array() as array<bigint>) end';
}

function meta::relational::functions::sqlQueryToString::databricks::loadValuesToDbTableForDatabricks(l:LoadTableSQL[1], dbConfig: DbConfig[1]): String[*]
{
  $l->insertValuesToDbTableForDatabricks($dbConfig);
}

function meta::relational::functions::sqlQueryToString::databricks::insertValuesToDbTableForDatabricks(loadTableSQL:LoadTableSQL[1] , dbConfig: DbConfig[1]) : String[*]
{
  if ($loadTableSQL.parsedData.values->isEmpty(),
    | [],
    |
      let sql = 'insert into ' + if($loadTableSQL.table.schema.name=='default', |'' ,|$loadTableSQL.table.schema.name + '.') + $loadTableSQL.table.name + ' ('
            + $loadTableSQL.columnsToLoad.name->map(colName | $colName->processColumnName($dbConfig))->joinStrings(',')
            +') '
            + 'values';

      $loadTableSQL.parsedData.values->map(row |  '(' + $row.values->convertValuesToCsvForDatabricks($loadTableSQL.columnsToLoad.type) + ')')
        ->joinStrings($sql, ', ', ';');
   );
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::convertValuesToCsvForDatabricks(strs : String[*], types : Any[*]): String[1]
{
  range($types->size())->map(x |
    let literalStr = $strs->at($x)->meta::relational::functions::database::testDataSQLgeneration::convertValuesToCsv($types->at($x));
    $types->at($x)->match([
      s:meta::relational::metamodel::datatype::SemiStructured[*] | 'PARSE_JSON(%s)'->format($literalStr),
      a:Any[1] | $literalStr
    ]);)->makeString(', ');
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::processWindowColumnForDatabricks(w:WindowColumn[1], sgc:SqlGenerationContext[1]):String[1]
{
   let partitionTranslation = if($w.window.partition->isNotEmpty(),
        |'Partition By ' + $w.window.partition->map(f|$f->processOperation($sgc))->joinStrings(','),
        |'');
   let orderByTranslation = if($w.window.sortBy->isNotEmpty(),
        |'Order By '+ $w.window.sortBy->map(s|$s.sortByElement->toOne()->processOperation($sgc) + if($s.sortDirection->isNotEmpty(), | ' ' +$s.sortDirection->toOne().name + if($s.sortDirection == meta::relational::metamodel::SortDirection.ASC, | ' NULLS LAST', | ' NULLS FIRST') , | ''))->joinStrings(', '),
        |'');
   let windowFrameTranslation = if($w.window.frame->isNotEmpty(),
        |$w.window.frame->toOne()->processWindowFrame($sgc),
        |'');
   $w.func->processOperation($sgc) +
   ' OVER (' +
   [$partitionTranslation, $orderByTranslation, $windowFrameTranslation]->filter(s | $s != '')->joinStrings(' ') +
   + ')';
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::processSelectSQLQueryForDatabricks(s:SelectSQLQuery[1], sgc:SqlGenerationContext[1], isSubSelect:Boolean[1]):String[1]
{
   $s->processSelectSQLQueryForDatabricks($sgc.dbConfig, $sgc.format, $sgc.config, $isSubSelect, $sgc.extensions);
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::processSelectSQLQueryForDatabricks(s:SelectSQLQuery[1], dbConfig : DbConfig[1], format:Format[1], config:Config[1], isSubSelect : Boolean[1], extensions:Extension[*]):String[1]
{
  assertEmpty($s.pivot, 'pivot is not supported');
  let opStr = if($s.filteringOperation->isEmpty(), |'', |$s.filteringOperation->map(s|$s->processOperation($dbConfig, $format->indent(), ^$config(callingFromFilter = true), $extensions))->filter(s|$s != '')->joinStrings(' <||> '));
  let havingStr = if($s.havingOperation->isEmpty(), |'', |$s.havingOperation->map(s|$s->processOperation($dbConfig, $format->indent(), $config, $extensions))->filter(s|$s != '')->joinStrings(' <||> '));
  let qualifyStr = if($s.qualifyOperation->isEmpty(), |'', |$s.qualifyOperation->map(s|$s->processOperation($dbConfig, $format->indent(), $config, $extensions))->filter(s|$s != '')->joinStrings(' <||> '));

  $format.separator + 'select ' + if($s.distinct == true,|'distinct ',|'') +
  processSelectColumns($s.columns, $dbConfig, $format->indent(), true, $extensions) +
  if($s.data == [],|'',| ' ' + $format.separator + 'from ' + $s.data->toOne()->processJoinTreeNode([], $dbConfig, $format->indent(), [], $extensions)) +
  if (eq($opStr, ''), |'', | ' ' + $format.separator + 'where ' + $opStr) +
  if ($s.groupBy->isEmpty(),|'',| ' ' + $format.separator + 'group by '+$s.groupBy->processGroupByColumns($dbConfig, $format->indent(), true, $extensions)->makeString(',')) +
  if (eq($havingStr, ''), |'', | ' ' + $format.separator + 'having ' + $havingStr) +
  if (eq($qualifyStr, ''), |'', | ' ' + $format.separator + 'qualify ' + $qualifyStr) +
  if ($s.orderBy->isEmpty(),|'',| ' ' + $format.separator + 'order by '+ $s.orderBy->processOrderBy($dbConfig, $format->indent(), $config, $extensions)->makeString(',')) +
  + processLimitDatabricks(
      $s,
      $dbConfig,
      $format,
      $extensions,
      processTakeDatabricks_SelectSQLQuery_1__Format_1__DbConfig_1__Extension_MANY__String_1_,
      processOffsetDatabricks_SelectSQLQuery_1__Format_1__DbConfig_1__Extension_MANY__String_1_,
      processSliceDatabricks_SelectSQLQuery_1__Format_1__DbConfig_1__Extension_MANY__Any_1__String_1_
  );
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::processTakeDatabricks(s:SelectSQLQuery[1], format:Format[1], dbConfig: DbConfig[1], extensions:Extension[*]):String[1]
{
   assert($s.toRow->isNotEmpty());
   '%s limit %s'->format([$format.separator, $s.toRow->toOne()->getValueForTake($format, $dbConfig, $extensions)]);
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::processOffsetDatabricks(s:SelectSQLQuery[1], format:Format[1], dbConfig: DbConfig[1], extensions:Extension[*]):String[1]
{
   assert($s.fromRow->isNotEmpty());
   '%s offset %s'->format([$format.separator, $s.fromRow->toOne()->getValueForTake($format, $dbConfig, $extensions)]);
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::processSliceDatabricks(s:SelectSQLQuery[1], format:Format[1], dbConfig: DbConfig[1], extensions:Extension[*], size:Any[1]):String[1]
{
   assert($s.toRow->isNotEmpty());
   assert($s.fromRow->isNotEmpty());
   '%s limit %s offset %s'->format([$format.separator, $size, $s.fromRow->toOne()->getValueForTake($format, $dbConfig, $extensions)]);
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::processLimitDatabricks(
   s:SelectSQLQuery[1],
   dbConfig: DbConfig[1],
   format:Format[1],
   extensions:Extension[*],
   takeProcessor:meta::pure::metamodel::function::Function<{SelectSQLQuery[1], Format[1], DbConfig[1], Extension[*] -> String[1]}>[1],
   offsetProcessor:meta::pure::metamodel::function::Function<{SelectSQLQuery[1], Format[1], DbConfig[1], Extension[*] -> String[1]}>[1],
   sliceProcessor:meta::pure::metamodel::function::Function<{SelectSQLQuery[1], Format[1], DbConfig[1], Extension[*], Any[1] -> String[1]}>[1]
   ):String[1]
{
   if ($s.fromRow == [] && $s.toRow == [],
      | // both fromRow and toRow are null, do mot limit results
        '';
     ,| if ($s.fromRow != [] && $s.toRow != [],
          | // both fromRow and toRow are not null, this is a slice (i.e. LIMIT + OFFSET)
            let size = $s.toRow.value->match([
              i:Integer[1]| $s.toRow->toOne().value->cast(@Integer) - $s.fromRow->toOne().value->cast(@Integer),
              v:VarPlaceHolder[1]| [$s.toRow->toOne().value->cast(@VarPlaceHolder).name, $s.fromRow->toOne().value->cast(@VarPlaceHolder).name]->joinStrings('${','?number - ', '?number}')
            ]);
            $sliceProcessor->eval($s, $format,$dbConfig, $extensions, $size);
         ,| if ($s.toRow == [],
              | // toRow is null, this is an offset
                $offsetProcessor->toOne()->eval($s, $format,$dbConfig, $extensions);
             ,| // fromRow is null, this is a take
                $takeProcessor->toOne()->eval($s, $format,$dbConfig, $extensions);
          );
      );
   );
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::convertToDateDatabricks(params:String[*]):String[1]
{
   assert( 2 - $params->size()  >= 0,'Incorrect number of parameters for convertDate: convertDate(column,[dateformat])');
   assert($params->size()==1 || dateFormatsDatabricks()->contains($params->at(1)->replace('\'', '')) , | $params->at(1) +' not supported ');
   let dateFormat = if( $params->size() == 1,|'\'yyyy-MM-dd\'' ,| $params->at(1););
   'to_date('+$params->at(0)+','+$dateFormat +')';
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::convertToDateTimeDatabricks(params:String[*]):String[1]
{
   assert( 2 - $params->size()  >= 0,'Incorrect number of parameters for convertDateTime: convertDateTime(column,[dateformat])');
   assert($params->size()==1 || dateTimeFormatsDatabricks()->contains($params->at(1)->replace('\'', '')) , | $params->at(1) +' not supported ');
   let dateTimeFormat = if( $params->size() == 1,|'\'yyyy-MM-dd HH:mm:ss\'',| $params->at(1));
   'to_timestamp('+$params->at(0)+','+$dateTimeFormat +')';
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::transformAlphaNumericParamsDatabricks(params: String[1]):String[1]
{
   let param = '\'[a-zA-Z0-9]*\'';
   let expression = $param->removeQuotes();
   'rlike(' + $params->at(0) + ',' + $expression + ')';
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::transformRegexpParamsDatabricks(params: String[2]):String[1]
{
   'rlike(' + $params->at(0) + ',' + $params->at(1) + ')';
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::schemaNameToIdentifierForDatabricks(schemaName: String[1], dbConfig: DbConfig[1]): String[1]
{
   $schemaName->replace('$', '.');
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::dateDiffDatabricks(p:String[2..3]):String[1]
{
    // dateDiff(d1: Date[1], d2: Date[1], du: DurationUnit[1]): Integer[1]
    // This returns an integer, hence a need to round results to int
    let interval = if($p->size() == 2, |'DAY', |$p->at(2)->replace('\'', '')->mapToDBUnitType());
    let cmd = if ($interval == 'YEAR',
        | 'year('+ $p->at(1) +') - year('+ $p->at(0) +')',
        | if ($interval == 'MONTH',
             | 'cast(round(months_between('+ $p->at(1) +', '+ $p->at(0) +')) AS INT)',
             | if ($interval == 'DAY',
                  | 'datediff('+ $p->at(1) +', '+ $p->at(0) +')',
                  | if ($interval == 'HOUR',
                       | 'cast(round((unix_timestamp('+ $p->at(1) +') - unix_timestamp('+ $p->at(0) +')) / 3600) AS INT)',
                       | if ($interval == 'MINUTE',
                            | 'cast(round((unix_timestamp('+ $p->at(1) +') - unix_timestamp('+ $p->at(0) +')) / 60) AS INT)',
                            | if ($interval == 'SECOND',
                                 | 'unix_timestamp('+ $p->at(1) +') - unix_timestamp('+ $p->at(0) +')',
                                 | if ($interval == 'MILLISECOND',
                                      | '(unix_timestamp('+ $p->at(1) +') - unix_timestamp('+ $p->at(0) +')) * 1000',
                                      | ''
                                 )
                            )
                       )
                  )
             )
        )
    );
    if ($cmd == '',|fail('The DurationUnit \''+$p->at(2)+'\' is not supported yet for date_diff'),|'');
    [$cmd];
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::formatMostRecentDatabricks(p:String[1..2], defaultDay:String[1]):String[*]
{
   let day = $p->last()->toOne()->mapToDBDayOfWeekNumber()->toString();
   let current = if ($p->size() == 2, | $p->first()->toOne(), | $defaultDay);
   [$current, $current, $day, $current, $day];
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::dateFormatsDatabricks():String[*]
{
   ['yyyy-MM-dd', 'MMMyyyy', 'yyyyMMdd'];
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::dateTimeFormatsDatabricks():String[*]
{
   ['yyyy-MM-dd HH:mm:ss', 'yyyy-MM-dd HH:mm:ss.SSS'];
}

function meta::relational::functions::sqlQueryToString::databricks::getDDLCommandsTranslatorForDatabricks(): RelationalDDLCommandsTranslator[1]
{
    ^RelationalDDLCommandsTranslator(
        createSchema = translateCreateSchemaStatementForDatabricks_CreateSchemaSQL_1__DbConfig_1__String_$0_1$_,
        dropSchema =  translateDropSchemaStatementDefault_DropSchemaSQL_1__DbConfig_1__String_1_,
        createTable = translateCreateTableStatementForDatabricks_CreateTableSQL_1__DbConfig_1__String_1_,
        createView = createView_CreateViewSQL_1__DbConfig_1__Extension_MANY__String_1_,
        createFunction = createFunction_CreateFunctionSQL_1__DbConfig_1__Extension_MANY__String_1_,
        dropTable = translateDropTableStatementDefault_DropTableSQL_1__DbConfig_1__String_1_,
        loadTable =  loadValuesToDbTableForDatabricks_LoadTableSQL_1__DbConfig_1__String_MANY_
    );
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::translateCreateSchemaStatementForDatabricks(createSchemaSQL:CreateSchemaSQL[1], dbConfig:DbConfig[1]) : String[0..1]
{
   if ($createSchemaSQL.schema.name == 'default',
       | [],
       | 'Create Schema if not exists ' + $createSchemaSQL.schema.name + ';';);
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::translateCreateTableStatementForDatabricks(createTableSQL:CreateTableSQL[1], dbConfig:DbConfig[1]) : String[1]
{
  // pct databricks does not support constraint on tables until we get unity catalog enabled...
  let createStatement = translateCreateTableStatementDefault(^$createTableSQL(applyConstraints = false), $dbConfig);
  let updatedCreateStatement = $createStatement->replace(';', '');

  // Enable column mapping on tables to allow whitespace characters in column names
  let tableProps = ' TBLPROPERTIES ( \'delta.minReaderVersion\' = \'2\', \'delta.minWriterVersion\' = \'5\', \'delta.columnMapping.mode\' = \'name\' );';

  // Concat the original create table statement with the column mapping table properties
  let combinedStatement = $updatedCreateStatement + $tableProps;
  [$combinedStatement];
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::processExtractFromSemiStructuredParamsForDatabricks(params:String[3]):String[1]
{
  // Databricks stores SEMISTRUCTURED as VARIANT. Use the colon operator with an explicit cast
  // rather than `get_json_object`, which only accepts STRING input.
  // Path is dot-separated (e.g. 'entity.entityType'); each segment is backticked so that names
  // containing special characters such as `@type` remain valid identifiers in the path expression.
  let baseRelationalOp = $params->at(0);
  let pathNavigation = $params->at(1);
  let returnType = $params->at(2);

  let pathSegments = $pathNavigation->split('.');
  let backTickedPath = $pathSegments->map(s | '`' + $s + '`')->joinStrings('.');
  let elementAccess = $baseRelationalOp + ':' + $backTickedPath;

  if ($returnType->in(['CHAR', 'VARCHAR', 'STRING']), | $elementAccess + '::STRING', |
  if ($returnType->in(['DATETIME', 'TIMESTAMP']), | $elementAccess + '::TIMESTAMP', |
  if ($returnType == 'DATE', | $elementAccess + '::DATE', |
  if ($returnType == 'BOOLEAN', | $elementAccess + '::BOOLEAN', |
  if ($returnType == 'FLOAT', | $elementAccess + '::DOUBLE', |
  if ($returnType == 'INTEGER', | $elementAccess + '::INT', |
  if ($returnType == 'DECIMAL', | $elementAccess + '::DECIMAL', |
  $elementAccess)))))));
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::processTableFunctionParamPlaceHolder(r:RelationalOperationElement[1], sgc: SqlGenerationContext[1]): String[1]
{
  $r->match([
    t: TableFunctionParamPlaceHolder[1] | $t.var->replaceVarPlaceHolderForAppGeneration($sgc),
    t: ProcedureVariablePlaceHolder[1] | $t.var->replaceProcedurevariable($sgc),
    r: RelationalOperationElement[1] | 'sqlQueryToString for relational element ' + $r->type().name->toOne() + ' has not been implemented yet for databricks'
   ]);
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::replaceProcedurevariable(v:VarPlaceHolder[1], sgc:SqlGenerationContext[1]): String[1]  
{  
  assertEmpty($v.propertyPath, 'processing for variable with propertyPath access is not implemented');  
  ':'+$v.name;  
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::replaceVarPlaceHolderForAppGeneration(v:VarPlaceHolder[1], sgc:SqlGenerationContext[1]): String[1]  
{  
  assertEmpty($v.propertyPath, 'processing for variable with propertyPath access is not implemented');  
  '(SELECT param_' + $v.name + ' FROM func_param_table)';  
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::processSemiStructuredElementForDatabricks(s:RelationalOperationElement[1], sgc:SqlGenerationContext[1]): String[1]
{
   $s->match([
      o:SemiStructuredObjectNavigation[1] | $o->processSemiStructuredObjectNavigationForDatabricks($sgc),
      a:SemiStructuredArrayFlatten[1] | $a->processSemiStructuredArrayFlattenForDatabricks($sgc),
      a:SemiStructuredArrayFlattenOutput[1] | $a->processSemiStructuredArrayFlattenOutputForDatabricks($sgc),
      a:SemiStructuredArrayFlattenRelation[1]| $a->processSemiStructuredArrayFlattenRelationForDatabricks($sgc)
   ])
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::processSemiStructuredObjectNavigationForDatabricks(s:SemiStructuredObjectNavigation[1], sgc:SqlGenerationContext[1]): String[1]
{
   // Databricks addresses semi-structured VARIANT data with the colon operator - `col:field.subField[index]`.
   // The first hop into the VARIANT value uses ':'; subsequent property hops use '.'.
   // Property names are always backticked so that names containing special characters
   // (e.g. `@type`) remain valid path identifiers.
   let processedOperand = $s.operand->processOperation($sgc);
   let isNestedNavigation = $s.operand->instanceOf(SemiStructuredObjectNavigation);

   let elementAccess = $processedOperand + $s->match([
      p: SemiStructuredPropertyAccess[1]     | if($isNestedNavigation, | '.', | ':') + '`' + $p.property->cast(@Literal).value->cast(@String) + '`' + if($p.index->isEmpty(),|'',|'['+ $p.index->toOne()->cast(@Literal).value->toString()+']'),
      a: SemiStructuredArrayElementAccess[1] | '[' + $a.index->cast(@Literal).value->toString() + ']'
   ]);

   if($s.avoidCastIfPrimitive == true, | $elementAccess, | $elementAccess + castSuffixForDatabricksSemiStructuredData($s.returnType));
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::processSemiStructuredArrayFlattenForDatabricks(s:SemiStructuredArrayFlatten[1], sgc:SqlGenerationContext[1]): String[1]
{
   // Used inside INNER JOIN LATERAL. Databricks needs an actual subquery expression, and
   // `explode_outer` emits a column named `col` (its `AS VALUE` alias is ignored at top-level).
   // Wrap in a subquery that renames `col` to `VALUE` so downstream references
   // (see processSemiStructuredArrayFlattenOutputForDatabricks) resolve as `alias.VALUE`.
   //
   // Use `try_cast` (not `cast`): a plain cast of a VARIANT that holds a JSON-string
   // representation of an array raises INVALID_VARIANT_CAST at runtime. `try_cast`
   // returns NULL on failure, and `explode_outer(NULL)` yields one NULL row per the
   // "outer" contract, matching the semi-structured null-safety semantics used elsewhere.
   let processedNavigation = $s.navigation->processOperation($sgc);
   '(select `col` as `VALUE` from (select explode_outer(try_cast(' + $processedNavigation + ' as array<variant>))))';
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::processSemiStructuredArrayFlattenRelationForDatabricks(s:SemiStructuredArrayFlattenRelation[1], sgc:SqlGenerationContext[1]): String[1]
{
   // `explode_outer` in a top-level SELECT emits a column called `col`; a trailing `AS VALUE` on
   // that SELECT is ignored by Databricks. Wrap the explode in an inner SELECT and alias `col`
   // to `VALUE` in the outer projection so that downstream references (see
   // processSemiStructuredArrayFlattenOutputForDatabricks) resolve.
   //
   // See processSemiStructuredArrayFlattenForDatabricks for the try_cast rationale.
   let processedNavigation = $s.navigation->processOperation($sgc);
   '(select `col` as `VALUE` from (select explode_outer(try_cast(' + $processedNavigation + ' as array<variant>))))';
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::processSemiStructuredArrayFlattenOutputForDatabricks(s:SemiStructuredArrayFlattenOutput[1], sgc:SqlGenerationContext[1]): String[1]
{
   let backTick = if($sgc.config.useQuotesForTableAliasColumn == false, |'', |'`');
   let processedIdentifier = $sgc.dbConfig.identifierProcessor($backTick + $s.tableAliasColumn.alias.name->toOne() + $backTick);
   $processedIdentifier + '.' + processColumnName('VALUE', $sgc.dbConfig) + castSuffixForDatabricksSemiStructuredData($s.returnType);
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::castSuffixForDatabricksSemiStructuredData(type:Type[0..1]): String[1]
{
   if($type == String, | '::STRING', |
   if($type == StrictDate, | '::DATE', |
   if($type == Integer, | '::INT', |
   if($type == Float, | '::DOUBLE', |
   if($type == Boolean, | '::BOOLEAN', |
   if($type->isNotEmpty() && $type->toOne()->_subTypeOf(Date), | '::TIMESTAMP', |
   if($type->isNotEmpty() && $type->toOne()->instanceOf(Enumeration), | '::STRING', |
   '')))))));
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::processJoinTreeNodeWithLateralJoinForDatabricks(j:JoinTreeNode[1], dbConfig:DbConfig[1], format:Format[1], extensions:Extension[*]):String[1]
{
   ' ' + $format.separator() + 'inner join lateral '
   + $j.alias
         ->map(a|^$a(name = '`' + $a.name + '`'))
         ->toOne()->processOperation($dbConfig, $format->indent(), $extensions) + $format.separator();
}

function meta::relational::functions::sqlQueryToString::databricks::tabularFunctionProcessorForDatabricks(schema:String[1], functionName:String[1], params:FunctionParameter[*]):String[1]
{
   if($schema == '', | $functionName, | $schema + '.' + $functionName) + '(' + $params->map(p|$p.name)->joinStrings(', ') + ')';
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::variableDeclarationProcessorForDatabricks(v:VariableDeclaration[1], sgc:SqlGenerationContext[1]): String[1]
{
   $v.name + ' := (' + $v.value->match([
                         l: Literal[1] | $l.value,
                         r: RelationalOperationElement[1]| $r->processOperation($sgc)
                       ])->cast(@String) + ')'
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::buildLambdaParameterForDatabricks(param:RelationalLambdaParameter[1], sgc:SqlGenerationContext[1]): String[1]
{
   '`%s`'->format($param.name);
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::buildLambdaForDatabricks(lambda:RelationalLambda[1], sgc:SqlGenerationContext[1]): String[1]
{
   $lambda->match([
      fold: FoldRelationalLambda[1] | buildFoldLambdaForDatabricks($fold, $sgc),
      map: MapRelationalLambda[1] | buildMapLambdaForDatabricks($map, $sgc),
      filter: FilterRelationalLambda[1] | buildFilterLambdaForDatabricks($filter, $sgc)
   ]);
}

// Renders the collection argument of a Databricks higher-order function (aggregate/transform/filter).
// A typed array is passed through bare (matching Snowflake, preserving element types). A
// VARIANT/semi-structured operand is coerced to ARRAY<VARIANT>: `try_cast` handles a VARIANT that
// holds an array, and the `array(cast(... as variant))` fallback wraps a scalar VARIANT into a
// 1-element ARRAY<VARIANT>. Both coalesce arms are ARRAY<VARIANT> so their types match (a bare
// `array(%s)` fallback over an already-ARRAY<VARIANT> value would yield ARRAY<ARRAY<VARIANT>> and
// trip DATATYPE_MISMATCH.DATA_DIFF_TYPES).
function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::lambdaCollectionExprForDatabricks(input:RelationalOperationElement[1], sgc:SqlGenerationContext[1]): String[1]
{
   let processed = $input->processOperation($sgc);
   if($input->isSemiStructuredOperandForDatabricks(),
      | 'coalesce(try_cast(' + $processed + ' as array<variant>), array(cast(' + $processed + ' as variant)))',
      | $processed
   );
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::buildFoldLambdaForDatabricks(lambda:FoldRelationalLambda[1], sgc:SqlGenerationContext[1]): String[1]
{
   // Databricks higher-order function lambdas do not accept parameter type annotations.
   // Syntax: `aggregate(array, zero, (acc, x) -> body)`
   'aggregate(%s, %s, (`%s`, `%s`) -> %s)'->format([
      lambdaCollectionExprForDatabricks($lambda.parameters->at(0).value, $sgc),
      $lambda.parameters->at(1).value->processOperation($sgc),
      $lambda.parameters->at(1).name,
      $lambda.parameters->at(0).name,
      $lambda.body->processOperation($sgc)
   ]);
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::buildMapLambdaForDatabricks(lambda:MapRelationalLambda[1], sgc:SqlGenerationContext[1]): String[1]
{
   // Databricks `transform(array, x -> body)` - lambda param has no type annotation.
   'transform(%s, `%s` -> %s)'->format([
      lambdaCollectionExprForDatabricks($lambda.parameters->at(0).value, $sgc),
      $lambda.parameters->at(0).name,
      $lambda.body->processOperation($sgc)
   ]);
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::buildFilterLambdaForDatabricks(lambda:FilterRelationalLambda[1], sgc:SqlGenerationContext[1]): String[1]
{
   // Databricks `filter(array, x -> body)` - lambda param has no type annotation.
   'filter(%s, `%s` -> %s)'->format([
      lambdaCollectionExprForDatabricks($lambda.parameters->at(0).value, $sgc),
      $lambda.parameters->at(0).name,
      $lambda.body->processOperation($sgc)
   ]);
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::toVariantForDatabricks(params:String[*]):String[1]
{
   if($params->size() == 1,
      | 'ifnull(cast(%s as VARIANT), parse_json(\'null\'))'->format($params->toOne()),
      | 'cast(array(%s) as VARIANT)'->format($params->joinStrings(','))
   );
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::transformToVariantObjectDatabricks(params:String[*]):String[1]
{
   // params are the flattened [k1, v1, k2, v2, ...] of the object. Snowflake's object-construct
   // `{k: v}` allows heterogeneous value types; Databricks `map(...)` requires a single value type,
   // so each value is cast to VARIANT, yielding MAP<STRING, VARIANT>. The surrounding cast (added by
   // processNewMap/processPut) then coerces to the declared MAP/VARIANT type, and keys/values/
   // mapConcatenate operate on the resulting map as in Snowflake.
   range(0, $params->size(), 2)->map(i | $params->at($i) + ', cast(' + $params->at($i + 1) + ' as variant)')->joinStrings(', ');
}

function <<access.private>> meta::relational::functions::sqlQueryToString::databricks::transformDateConstructionForDatabricks(params:String[*]):String[1]
{
   if($params->size() == 3,
      | 'make_date(' + $params->at(0) + ', ' + $params->at(1) + ', ' + $params->at(2) + ')',
      | if($params->size() >= 6,
           | 'make_timestamp(' + $params->at(0) + ', ' + $params->at(1) + ', ' + $params->at(2) + ', ' + $params->at(3) + ', ' + $params->at(4) + ', ' + $params->at(5) + ')',
           | fail('Date construction with ' + $params->size()->toString() + ' parameters not supported for Databricks'); '';
        )
   );
}