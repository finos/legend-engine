function <<test.Test>> meta::relational::tests::functions::sqlstring::databricks::testGreatestOfSingleOperandIsBareDatabricks():Boolean[1]
{
  assertEquals('quantity', ^meta::relational::metamodel::DynaFunction(name = 'greatest', parameters = ^meta::relational::metamodel::ColumnName(name = 'quantity'))->operationSqlDatabricks());
}

function <<test.Test>> meta::relational::tests::functions::sqlstring::databricks::testLiteralInMixedTypeListIsEvaluatedInPureDatabricks():Boolean[1]
{
  assertEquals('true', ^meta::relational::metamodel::DynaFunction(name = 'in', parameters = [
      ^meta::relational::metamodel::Literal(value = 1),
      ^meta::relational::metamodel::LiteralList(values = [^meta::relational::metamodel::Literal(value = 'a'), ^meta::relational::metamodel::Literal(value = 1), ^meta::relational::metamodel::Literal(value = true)])
    ])->operationSqlDatabricks());
}

function <<test.Test>> meta::relational::tests::functions::sqlstring::databricks::testNegatedIntegerLiteralInIsEvaluatedInPureDatabricks():Boolean[1]
{
  assertEquals('false', ^meta::relational::metamodel::DynaFunction(name = 'in', parameters = [
      ^meta::relational::metamodel::DynaFunction(name = 'minus', parameters = ^meta::relational::metamodel::Literal(value = 2)),
      ^meta::relational::metamodel::LiteralList(values = [^meta::relational::metamodel::Literal(value = 2), ^meta::relational::metamodel::Literal(value = 'a')])
    ])->operationSqlDatabricks());
}

function <<test.Test>> meta::relational::tests::functions::sqlstring::databricks::testNegatedFloatLiteralInIsLeftToSparkDatabricks():Boolean[1]
{
  assertEquals('-1.5 in (1.5, 2.5)', ^meta::relational::metamodel::DynaFunction(name = 'in', parameters = [
      ^meta::relational::metamodel::DynaFunction(name = 'minus', parameters = ^meta::relational::metamodel::Literal(value = 1.5)),
      ^meta::relational::metamodel::LiteralList(values = [^meta::relational::metamodel::Literal(value = 1.5), ^meta::relational::metamodel::Literal(value = 2.5)])
    ])->operationSqlDatabricks());
}

function <<test.Test>> meta::relational::tests::functions::sqlstring::databricks::testColumnInIsLeftToSparkDatabricks():Boolean[1]
{
  assertEquals('quantity in (1, 2)', ^meta::relational::metamodel::DynaFunction(name = 'in', parameters = [
      ^meta::relational::metamodel::ColumnName(name = 'quantity'),
      ^meta::relational::metamodel::LiteralList(values = [^meta::relational::metamodel::Literal(value = 1), ^meta::relational::metamodel::Literal(value = 2)])
    ])->operationSqlDatabricks());
}

function <<test.Test>> meta::relational::tests::functions::sqlstring::databricks::testToVariantObjectCastsScalarValuesDatabricks():Boolean[1]
{
  assertEquals('map(\'a\', cast(1 as variant))', ^meta::relational::metamodel::DynaFunction(name = 'toVariantObject', parameters = [
      ^meta::relational::metamodel::Literal(value = 'a'), ^meta::relational::metamodel::Literal(value = 1)
    ])->operationSqlDatabricks());
}

function <<test.Test>> meta::relational::tests::functions::sqlstring::databricks::testToVariantObjectConvertsMapValueToVariantObjectDatabricks():Boolean[1]
{
  let mapColumn = ^meta::relational::metamodel::TableAliasColumn(
    alias = ^meta::relational::metamodel::TableAlias(name = 'root', relationalElement = ^meta::relational::metamodel::Literal(value = 1)),
    column = ^meta::relational::metamodel::Column(name = 'inner', type = ^meta::relational::metamodel::datatype::Object(keyType = ^meta::relational::metamodel::datatype::Varchar(size = 200), valueType = ^meta::relational::metamodel::datatype::Integer())));
  assertEquals('map(\'outer\', to_variant_object(`root`.`inner`))', ^meta::relational::metamodel::DynaFunction(name = 'toVariantObject', parameters = [
      ^meta::relational::metamodel::Literal(value = 'outer'), $mapColumn
    ])->operationSqlDatabricks());
}

function <<access.private>> meta::relational::tests::functions::sqlstring::databricks::operationSqlDatabricks(func:meta::relational::metamodel::DynaFunction[1]):String[1]
{
  meta::relational::functions::sqlQueryToString::processOperation($func, DatabaseType.Databricks, meta::relational::extension::relationalExtensions());
}

function <<test.Test>> meta::relational::tests::functions::sqlstring::databricks::testRegexpReplaceFirstSplitsAtFirstMatchDatabricks():Boolean[1]
{
  let sql = toSQLString(|Person.all()->project(p|$p.firstName->regexpReplace('a+', 'b', false), 'name'),
    simpleRelationalMapping, DatabaseType.Databricks, meta::relational::extension::relationalExtensions());
  assertEquals('select case when size(split(`root`.FIRSTNAME, \'a+\', 2)) = 1 then `root`.FIRSTNAME else concat(element_at(split(`root`.FIRSTNAME, \'a+\', 2), 1), \'b\', element_at(split(`root`.FIRSTNAME, \'a+\', 2), 2)) end as `name` from personTable as `root`', $sql);
}

function <<test.Test>> meta::relational::tests::functions::sqlstring::databricks::testRegexpReplaceAllUsesRegexpReplaceDatabricks():Boolean[1]
{
  let sql = toSQLString(|Person.all()->project(p|$p.firstName->regexpReplace('a+', 'b', true), 'name'),
    simpleRelationalMapping, DatabaseType.Databricks, meta::relational::extension::relationalExtensions());
  assertEquals('select regexp_replace(`root`.FIRSTNAME, \'a+\', \'b\') as `name` from personTable as `root`', $sql);
}
