import meta::relational::extension::*;
import meta::pure::extension::*;
import meta::relational::tests::pct::*;
import meta::pure::test::pct::*;
import meta::relational::runtime::*;
import meta::relational::metamodel::*;
import meta::relational::functions::sqlQueryToString::*;
import meta::relational::functions::sqlQueryToString::databricks::*;

function <<PCT.adapter>> {PCT.adapterName='Databricks'} meta::relational::tests::pct::databricks::testAdapterForRelationalWithDatabricksExecution<X|o>(f:Function<{->X[o]}>[1]):X[o]
{
  meta::relational::tests::pct::testAdapterForRelationalExecution(
    $f,
    meta::pure::testConnection::getTestConnection(DatabaseType.Databricks),
    relationalExtensions(),
    meta::relational::tests::pct::databricks::fixtureDDLCommandsTranslator()
  )
}

function meta::relational::tests::pct::databricks::fixtureDDLCommandsTranslator():RelationalDDLCommandsTranslator[1]
{
  let databricks = getDDLCommandsTranslatorForDatabricks();
  ^$databricks(
    // DatabricksFixtureSchema creates the schema once per run
    createSchema = {sql: CreateSchemaSQL[1], c: DbConfig[1] | []->cast(@String)},
    // Every fixture table is loaded, so the table is created there, holding its rows in one statement
    createTable = {sql: CreateTableSQL[1], c: DbConfig[1] | []->cast(@String)},
    loadTable = {sql: LoadTableSQL[1], c: DbConfig[1] | if($sql.parsedData.values->isEmpty(),
                                                         | $databricks.createTable->toOne()->eval(^CreateTableSQL(table = $sql.table, applyConstraints = true), $c),
                                                         | createTableAsSelectForDatabricks($sql, $c))}
  );
}
