// The store has no type for a zoned timestamp, so it declares the column as a
// TIMESTAMP. The table the connections create holds it as a TIMESTAMP WITH TIME
// ZONE, and that is the type the database reports when the column is read.

###Pure
Class demo::Reading
{
  id: Integer[1];
  recordedAt: DateTime[0..1];
}

###Relational
Database demo::store::ReadingDB
(
  Table readingTable
  (
    id INTEGER PRIMARY KEY,
    recordedAt TIMESTAMP
  )
)

###Mapping
Mapping demo::ReadingMapping
(
  *demo::Reading: Relational
  {
    ~primaryKey
    (
      [demo::store::ReadingDB]readingTable.id
    )
    ~mainTable [demo::store::ReadingDB]readingTable
    id: [demo::store::ReadingDB]readingTable.id,
    recordedAt: [demo::store::ReadingDB]readingTable.recordedAt
  }
)
