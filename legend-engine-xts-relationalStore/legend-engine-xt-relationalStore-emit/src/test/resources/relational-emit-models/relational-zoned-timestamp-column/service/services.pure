// A graph fetch and a projection through each connection. Every test expects
// the same moments: a zoned timestamp holds a moment, so the zone a connection
// names, which says where the database keeps its wall clocks, cannot move it.

###Service
Service demo::service::ReadingFetchNoZoneService
{
  pattern: '/api/readings/fetch/no-zone';
  documentation: 'Readings fetched as a graph through a connection naming no time zone.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |demo::Reading.all()->graphFetch(#{demo::Reading{id, recordedAt}}#)->serialize(#{demo::Reading{id, recordedAt}}#);
    mapping: demo::ReadingMapping;
    runtime: demo::runtime::ReadingNoZoneRuntime;
  }
  testSuites:
  [
    readingSuite:
    {
      tests:
      [
        recordedAt:
        {
          serializationFormat: PURE;
          asserts:
          [
            shouldReadEachZonedTimestampAsTheMomentItHolds:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":1,"recordedAt":"2012-05-20T03:10:52.501000000"},{"id":2,"recordedAt":"2012-05-20T07:10:52.501000000"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service demo::service::ReadingProjectNoZoneService
{
  pattern: '/api/readings/project/no-zone';
  documentation: 'Readings projected to rows through a connection naming no time zone.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |demo::Reading.all()->project([x|$x.id, x|$x.recordedAt], ['Id', 'Recorded At'])->sort('Id');
    mapping: demo::ReadingMapping;
    runtime: demo::runtime::ReadingNoZoneRuntime;
  }
  testSuites:
  [
    readingSuite:
    {
      tests:
      [
        recordedAt:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            shouldReadEachZonedTimestampAsTheMomentItHolds:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Id":1,"Recorded At":"2012-05-20T03:10:52.501000000+0000"},{"Id":2,"Recorded At":"2012-05-20T07:10:52.501000000+0000"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

