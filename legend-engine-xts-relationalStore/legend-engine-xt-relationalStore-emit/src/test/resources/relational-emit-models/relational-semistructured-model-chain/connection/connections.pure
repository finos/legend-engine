###Connection
// Firm.all()->project(~[...]) returns a Relation, so RelationalConnectionFactory always rebuilds
// this connection as DuckDB for test execution, regardless of what's declared here -- declare
// DuckDB to match, rather than H2.
RelationalDatabaseConnection chain::connection::FirmDuckDBConnection
{
  store: chain::store::DB;
  type: DuckDB;
  specification: DuckDB
  {
    path: '';
  };
  auth: Test;
}

// What makes the mapping chain a chain: reads of the model-to-model mapping's source class are
// served by the relational mapping rather than by an external-format payload.
ModelChainConnection chain::connection::FirmModelChainConnection
{
  mappings: [ chain::mapping::Relational ];
}
