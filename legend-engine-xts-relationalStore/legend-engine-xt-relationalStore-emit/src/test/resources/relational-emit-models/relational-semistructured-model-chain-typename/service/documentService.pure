// The relation form, which is also the only form EMIT can run against a model chain (see
// relational-semistructured-model-chain for why). There is no sort(): the chain's reprocessing of a
// sort does not handle SortInfo, so rows come back in table order.
###Service
Service demo::mct::service::DocumentTermTypesService
{
  pattern: '/api/mct/documentTermTypes';
  documentation: 'The type of every term of the documents with two references, read through a model chain.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |demo::mct::model::Document.all()
              ->filter(x | $x.ref->in(['R1', 'R2']))
              ->project(~[id: x | $x.id, version: x | $x.version, termType: x | $x.termTypes]);
    mapping: demo::mct::mapping::M2MMapping;
    runtime: demo::mct::runtime::DocumentRuntime;
  }
  testSuites:
  [
    termTypesSuite:
    {
      data:
      [
        connections:
        [
          h2:
            Reference
            #{
              demo::mct::data::DocumentData
            }#
        ]
      ]
      tests:
      [
        typeNameInMapWithLambdaReusingQueryParameterName:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            shouldMatch:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":"E1","version":1,"termType":"CashTerms"},{"id":"E1","version":1,"termType":"SecurityTerms"},{"id":"E2","version":1,"termType":"SecurityTerms"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
