// RFC-4180: each JSON document is wrapped in " and every internal " is doubled.
//
// E1 has two terms of different subtypes, E2 has one, and E3 belongs to a reference the service filters
// out.
###Data
Data demo::mct::data::DocumentData
{
  Relation
  #{
    DOC.DOCUMENT:
      ID,VERSION,CONTENT
      E1,1,"{""ref"":""R1"",""terms"":[{""@type"":""CashTerms"",""termId"":""a""},{""@type"":""SecurityTerms"",""termId"":""b""}]}"
      E2,1,"{""ref"":""R2"",""terms"":[{""@type"":""SecurityTerms"",""termId"":""c""}]}"
      E3,1,"{""ref"":""R3"",""terms"":[{""@type"":""CashTerms"",""termId"":""d""}]}";
  }#
}
