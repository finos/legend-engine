###Pure
Class <<temporal.bitemporal>> demo::milestone::BiProduct
{
  name: String[1];
}

// PRODUCT is bitemporally milestoned: business validity via FROM_Z/THRU_Z and
// processing validity via IN_Z/OUT_Z. The four milestoning columns plus ID form a
// composite key so multiple versions of one logical product coexist.
###Relational
Database demo::store::BiTemporalDB
(
  Table PRODUCT
  (
    milestoning
    (
      business(BUS_FROM = FROM_Z, BUS_THRU = THRU_Z),
      processing(PROCESSING_IN = IN_Z, PROCESSING_OUT = OUT_Z)
    )
    ID INTEGER PRIMARY KEY,
    NAME VARCHAR(100) NOT NULL,
    FROM_Z DATE PRIMARY KEY,
    THRU_Z DATE NOT NULL,
    IN_Z DATE PRIMARY KEY,
    OUT_Z DATE NOT NULL
  )
)
