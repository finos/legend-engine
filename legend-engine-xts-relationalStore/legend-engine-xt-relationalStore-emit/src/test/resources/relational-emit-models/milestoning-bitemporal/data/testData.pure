// Two bitemporal versions of product ID 1. WidgetV1 is valid (business and
// processing) through 2021-01-01; WidgetV2 takes over afterwards.
###Data
Data demo::milestone::data::BiProductData
{
  Relational
  #{
    default.PRODUCT:
      'ID,NAME,FROM_Z,THRU_Z,IN_Z,OUT_Z\n' +
      '1,WidgetV1,2020-01-01,2021-01-01,2020-01-01,2021-01-01\n' +
      '1,WidgetV2,2021-01-01,9999-12-31,2021-01-01,9999-12-31\n';
  }#
}
