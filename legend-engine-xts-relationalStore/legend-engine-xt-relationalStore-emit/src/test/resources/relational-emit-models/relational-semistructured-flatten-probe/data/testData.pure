// a nests uniformly. e holds an empty inner array, n an explicit null, k omits the key, and z
// is empty throughout - the four ways a document says "nothing here".
###Data
Data probe::data::D
{
  Relation
  #{
    default.T:
      ID,DOC
      1,"{""a"":[{""b"":[1,2]},{""b"":[3]}],""e"":[{""b"":[1]},{""b"":[]}],""n"":[{""b"":[1]},{""b"":null}],""k"":[{""b"":[1]},{}],""z"":[{""b"":[]},{""b"":[]}]}";
  }#
}
