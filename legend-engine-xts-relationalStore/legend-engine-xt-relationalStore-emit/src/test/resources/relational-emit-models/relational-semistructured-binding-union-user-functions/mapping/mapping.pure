// Event is the union of the two feeds. Both sets carry the JSON document through the same binding.
//
// resolvedAmount() is the shape under test: a user function that branches on typeName(), narrows with
// subType() and indexes into an array, calls a second user function that matches on the subtypes, and
// is itself called on the result of an at(0) over a binding-mapped array. Each of these steps is routed
// by inlining the function body, so the arguments and the lambda parameters of the surrounding query
// have to stay in the right scope throughout.
###Pure
function demo::ssu::resolvedAmount(terms: demo::ssu::Terms[1]): Float[1]
{
  if($terms->typeName() == 'BasketTerms',
    |$terms->subType(@demo::ssu::BasketTerms).components->at(0)->demo::ssu::amountOf(),
    |$terms->demo::ssu::amountOf())
}

function demo::ssu::amountOf(terms: demo::ssu::Terms[1]): Float[1]
{
  $terms->match(
    [
      f: demo::ssu::FixedTerms[1] | $f.amount->toOne(),
      t: demo::ssu::Terms[1]      | 0.0
    ])
}


###Mapping
Mapping demo::ssu::mapping::EventMapping
(
  *demo::ssu::Event: Operation
  {
    meta::pure::router::operations::union_OperationSetImplementation_1__SetImplementation_MANY_(eventA, eventB)
  }

  demo::ssu::Event[eventA]: Relational
  {
    ~primaryKey
    (
      [demo::ssu::store::FeedDB]FEED_A.EVENT.EVENT_ID,
      [demo::ssu::store::FeedDB]FEED_A.EVENT.VERSION
    )
    ~mainTable [demo::ssu::store::FeedDB]FEED_A.EVENT
    eventId: [demo::ssu::store::FeedDB]FEED_A.EVENT.EVENT_ID,
    version: [demo::ssu::store::FeedDB]FEED_A.EVENT.VERSION,
    content: Binding demo::ssu::store::ContractBinding : [demo::ssu::store::FeedDB]FEED_A.EVENT.CONTENT
  }

  demo::ssu::Event[eventB]: Relational
  {
    ~primaryKey
    (
      [demo::ssu::store::FeedDB]FEED_B.EVENT.EVENT_ID,
      [demo::ssu::store::FeedDB]FEED_B.EVENT.VERSION
    )
    ~mainTable [demo::ssu::store::FeedDB]FEED_B.EVENT
    eventId: [demo::ssu::store::FeedDB]FEED_B.EVENT.EVENT_ID,
    version: [demo::ssu::store::FeedDB]FEED_B.EVENT.VERSION,
    content: Binding demo::ssu::store::ContractBinding : [demo::ssu::store::FeedDB]FEED_B.EVENT.CONTENT
  }

  testSuites:
  [
    resolvedSuite:
    {
      function: |demo::ssu::Event.all()
                  ->project(~[eventId: x | $x.eventId, resolved: x | $x.content.terms->at(0)->demo::ssu::resolvedAmount()])
                  ->sort([~eventId->ascending()]);
      tests:
      [
        resolvedForEachTermsKind:
        {
          data:
          [
            demo::ssu::store::FeedDB:
              Reference
              #{
                demo::ssu::data::FeedData
              }#
          ];
          asserts:
          [
            shouldComputeResolved:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"eventId":"A1","resolved":100.5},{"eventId":"A2","resolved":250.0},{"eventId":"B1","resolved":75.0},{"eventId":"B2","resolved":0.0}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
