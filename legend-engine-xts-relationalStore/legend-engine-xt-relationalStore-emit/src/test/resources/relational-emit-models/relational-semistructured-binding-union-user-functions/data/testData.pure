// RFC-4180: each JSON document is wrapped in " and every internal " is doubled.
//
// A1 and B1 carry a fixed amount directly, A2 a basket whose first component carries the amount, and
// B2 a bare Terms with no amount of its own.
###Data
Data demo::ssu::data::FeedData
{
  Relation
  #{
    FEED_A.EVENT:
      EVENT_ID,VERSION,CONTENT
      A1,1,"{""terms"":[{""@type"":""FixedTerms"",""termId"":""t1"",""amount"":100.5}]}"
      A2,1,"{""terms"":[{""@type"":""BasketTerms"",""termId"":""t2"",""components"":[{""@type"":""FixedTerms"",""termId"":""c1"",""amount"":250.0},{""@type"":""FixedTerms"",""termId"":""c2"",""amount"":50.0}]}]}";
    FEED_B.EVENT:
      EVENT_ID,VERSION,CONTENT
      B1,1,"{""terms"":[{""@type"":""FixedTerms"",""termId"":""t3"",""amount"":75.0}]}"
      B2,1,"{""terms"":[{""@type"":""Terms"",""termId"":""t4""}]}";
  }#
}
