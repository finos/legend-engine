// Departments: 10 (Engineering) is in NYC, 20 (Sales) is in LON. Alice and Carol
// are in dept 10 (NYC), Bob in dept 20 (LON) — so only Alice and Carol pass the
// cross-table filter.
###Data
Data demo::joins::data::CrossTableFilterData
{
  Relational
  #{
    HR.EMPLOYEE:
      'ID,NAME,DEPT_ID\n' +
      '1,Alice,10\n' +
      '2,Bob,20\n' +
      '3,Carol,10\n';
    HR.DEPARTMENT:
      'ID,NAME,LOCATION\n' +
      '10,Engineering,NYC\n' +
      '20,Sales,LON\n';
  }#
}
