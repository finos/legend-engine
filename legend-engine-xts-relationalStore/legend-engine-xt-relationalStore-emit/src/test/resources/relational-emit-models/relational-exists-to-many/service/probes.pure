###Service
Service demo::sqlshapes::service::TwoExistsOnSamePropertyAndProbe
{
  pattern: '/probe/twoExistsAnd';
  documentation: 'Plan-only probe: master keeps only the first of several exists() on the same to-many property (meta::relational::tests::query::filter::exists::testMultipleExistsOnSameProperty is ToFix), so the rows are wrong and the shape is planned, not asserted.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |demo::Firm.all()->filter(f|$f.employees->exists(e|$e.firstName == 'Peter') && $f.employees->exists(e|$e.lastName == 'Smith'))->project([f|$f.legalName], ['name']);
    mapping: demo::sqlshapes::ExistsMapping;
    runtime: demo::sqlshapes::runtime::FirmRuntime;
  }
}

Service demo::sqlshapes::service::TwoExistsOnSamePropertyOrProbe
{
  pattern: '/probe/twoExistsOr';
  documentation: 'Plan-only probe: master keeps only the first of several exists() on the same to-many property (meta::relational::tests::query::filter::exists::testMultipleExistsOnSameProperty is ToFix), so the rows are wrong and the shape is planned, not asserted.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |demo::Firm.all()->filter(f|$f.employees->exists(e|$e.firstName == 'Peter') || $f.employees->exists(e|$e.lastName == 'Brown'))->project([f|$f.legalName], ['name']);
    mapping: demo::sqlshapes::ExistsMapping;
    runtime: demo::sqlshapes::runtime::FirmRuntime;
  }
}

Service demo::sqlshapes::service::NegatedAndPositiveExistsOnSamePropertyProbe
{
  pattern: '/probe/negatedAndPositiveExists';
  documentation: 'Plan-only probe: master keeps only the first of several exists() on the same to-many property (meta::relational::tests::query::filter::exists::testMultipleExistsOnSameProperty is ToFix), so the rows are wrong and the shape is planned, not asserted.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |demo::Firm.all()->filter(f|!$f.employees->exists(e|$e.firstName == 'Peter') && $f.employees->exists(e|$e.lastName == 'Brown'))->project([f|$f.legalName], ['name']);
    mapping: demo::sqlshapes::ExistsMapping;
    runtime: demo::sqlshapes::runtime::FirmRuntime;
  }
}

Service demo::sqlshapes::service::ChainedExistsFiltersOnSamePropertyProbe
{
  pattern: '/probe/chainedExistsFilters';
  documentation: 'Plan-only probe: master keeps only the first of several exists() on the same to-many property (meta::relational::tests::query::filter::exists::testMultipleExistsOnSameProperty is ToFix), so the rows are wrong and the shape is planned, not asserted.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |demo::Firm.all()->filter(f|$f.employees->exists(e|$e.firstName == 'Peter'))->filter(f|$f.employees->exists(e|$e.lastName == 'Smith'))->project([f|$f.legalName], ['name']);
    mapping: demo::sqlshapes::ExistsMapping;
    runtime: demo::sqlshapes::runtime::FirmRuntime;
  }
}

Service demo::sqlshapes::service::SizeOfToManyInProjectionProbe
{
  pattern: '/probe/sizeOfToManyInProjection';
  documentation: 'Plan-only probe: on master, size() of a to-many property in a project emits count(*) over the outer join with no GROUP BY, which H2 rejects (column must be in the GROUP BY list), so the shape is planned, not asserted.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |demo::Firm.all()->project([f|$f.legalName, f|$f.employees->size()], ['name', 'employees']);
    mapping: demo::sqlshapes::ExistsMapping;
    runtime: demo::sqlshapes::runtime::FirmRuntime;
  }
}
