// The rows are those of relational-service-dates, carried on the connection
// rather than given to each test suite, because a test suite that brings its own
// connection data has the connection rebuilt without its time zone.

###Connection
RelationalDatabaseConnection demo::dates::zoned::connection::TradingConnection
{
  store: demo::dates::store::TradingDB;
  type: H2;
  timezone: 'America/New_York';
  specification: LocalH2
  {
    testDataSetupCSV: 'default\nPRODUCT\nID,NAME,FROM_Z,THRU_Z\n1,Widget,2025-01-01,2025-07-02\n1,Widget Mk2,2025-07-02,9999-12-31\n2,Gadget,2025-01-01,9999-12-31\n----\ndefault\nACCOUNT\nID,STATUS,IN_Z,OUT_Z\n1,OPEN,2025-01-01 00:00:00,2025-07-02 12:00:00\n1,FROZEN,2025-07-02 12:00:00,9999-12-31 23:59:59\n2,PENDING,2025-01-01 00:00:00,2025-07-02 10:30:00\n2,OPEN,2025-07-02 10:30:00,9999-12-31 23:59:59\n----\ndefault\nRATING\nISSUER,GRADE,IN_Z,OUT_Z,FROM_Z,THRU_Z\nAcme,A,2025-01-01 00:00:00,2025-07-02 12:00:00,2025-01-01 00:00:00,2025-07-01 12:00:00\nAcme,AA,2025-07-02 12:00:00,9999-12-31 23:59:59,2025-01-01 00:00:00,2025-07-01 12:00:00\nAcme,A-,2025-01-01 00:00:00,2025-07-02 12:00:00,2025-07-01 12:00:00,9999-12-31 23:59:59\nAcme,BBB,2025-07-02 12:00:00,9999-12-31 23:59:59,2025-07-01 12:00:00,9999-12-31 23:59:59\n----\ndefault\nTRADE\nID,PRODUCT_ID,ACCOUNT_ID,TRADE_DATE,EXECUTED_AT,QUANTITY\n1,1,1,2025-07-01,2025-07-01 16:00:00,100\n2,1,2,2025-07-02,2025-07-02 09:00:00,200\n3,2,1,2025-07-02,2025-07-02 10:45:00,300\n4,2,2,2025-07-02,2025-07-02 13:00:00,400\n5,1,1,2025-07-03,2025-07-03 09:30:00,500\n';
  };
  auth: DefaultH2;
}

###Runtime
Runtime demo::dates::zoned::runtime::TradingRuntime
{
  mappings:
  [
    demo::dates::TradingMapping
  ];
  connections:
  [
    demo::dates::store::TradingDB:
    [
      h2: demo::dates::zoned::connection::TradingConnection
    ]
  ];
}
