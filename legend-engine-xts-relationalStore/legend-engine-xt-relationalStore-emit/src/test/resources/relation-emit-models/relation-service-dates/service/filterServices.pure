// Dates compared with plain DATE and TIMESTAMP columns rather than used for
// milestoning.

###Service
// A calendar date compared with a DATE column.
Service demo::relation::dates::service::TradesOnDateLiteral
{
  pattern: '/api/relation/dates/trades/on';
  documentation: 'Trades made on a date, written into the query.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |demo::relation::dates::Trade.all()->filter(t|$t.tradeDate == %2025-07-02)->sortBy(t|$t.id)->project([t|$t.id, t|$t.tradeDate], ['Id', 'Trade Date']);
    mapping: demo::relation::dates::TradingMapping;
    runtime: demo::relation::dates::runtime::TradingRuntime;
  }
  testSuites:
  [
    tradeSuite:
    {
      data:
      [
        connections:
        [
          h2:
            Reference
            #{
              demo::relation::dates::data::TradingData
            }#
        ]
      ]
      tests:
      [
        secondOfJuly:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            shouldReturnThatDaysTrades:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Id":2,"Trade Date":"2025-07-02"},{"Id":3,"Trade Date":"2025-07-02"},{"Id":4,"Trade Date":"2025-07-02"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service demo::relation::dates::service::TradesOnDateParameter
{
  pattern: '/api/relation/dates/trades/on/{tradeDate}';
  documentation: 'Trades made on a date, given as a parameter.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {tradeDate: StrictDate[1]|demo::relation::dates::Trade.all()->filter(t|$t.tradeDate == $tradeDate)->sortBy(t|$t.id)->project([t|$t.id, t|$t.tradeDate], ['Id', 'Trade Date'])};
    mapping: demo::relation::dates::TradingMapping;
    runtime: demo::relation::dates::runtime::TradingRuntime;
  }
  testSuites:
  [
    tradeSuite:
    {
      data:
      [
        connections:
        [
          h2:
            Reference
            #{
              demo::relation::dates::data::TradingData
            }#
        ]
      ]
      tests:
      [
        secondOfJuly:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            tradeDate = %2025-07-02
          ]
          asserts:
          [
            shouldReturnThatDaysTrades:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Id":2,"Trade Date":"2025-07-02"},{"Id":3,"Trade Date":"2025-07-02"},{"Id":4,"Trade Date":"2025-07-02"}]';
                  }#;
              }#
          ]
        },
        thirdOfJuly:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            tradeDate = %2025-07-03
          ]
          asserts:
          [
            shouldReturnThatDaysTrades:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Id":5,"Trade Date":"2025-07-03"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

// A date-time compared with a TIMESTAMP column, and the matching
// timestamps read back. With no zone named, both are the wall clock.
Service demo::relation::dates::service::TradesExecutedBeforeLiteral
{
  pattern: '/api/relation/dates/trades/before';
  documentation: 'Trades executed before a moment, written into the query.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |demo::relation::dates::Trade.all()->filter(t|$t.executedAt < %2025-07-02T15:00:00+0000)->sortBy(t|$t.id)->project([t|$t.id, t|$t.executedAt], ['Id', 'Executed At']);
    mapping: demo::relation::dates::TradingMapping;
    runtime: demo::relation::dates::runtime::TradingRuntime;
  }
  testSuites:
  [
    tradeSuite:
    {
      data:
      [
        connections:
        [
          h2:
            Reference
            #{
              demo::relation::dates::data::TradingData
            }#
        ]
      ]
      tests:
      [
        afternoonUtc:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            shouldReturnTradesExecutedEarlier:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Id":1,"Executed At":"2025-07-01T16:00:00.000000000+0000"},{"Id":2,"Executed At":"2025-07-02T09:00:00.000000000+0000"},{"Id":3,"Executed At":"2025-07-02T10:45:00.000000000+0000"},{"Id":4,"Executed At":"2025-07-02T13:00:00.000000000+0000"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service demo::relation::dates::service::TradesExecutedBeforeParameter
{
  pattern: '/api/relation/dates/trades/before/{cutoff}';
  documentation: 'Trades executed before a moment, given as a parameter.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {cutoff: DateTime[1]|demo::relation::dates::Trade.all()->filter(t|$t.executedAt < $cutoff)->sortBy(t|$t.id)->project([t|$t.id, t|$t.executedAt], ['Id', 'Executed At'])};
    mapping: demo::relation::dates::TradingMapping;
    runtime: demo::relation::dates::runtime::TradingRuntime;
  }
  testSuites:
  [
    tradeSuite:
    {
      data:
      [
        connections:
        [
          h2:
            Reference
            #{
              demo::relation::dates::data::TradingData
            }#
        ]
      ]
      tests:
      [
        afternoonUtc:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            cutoff = %2025-07-02T15:00:00+0000
          ]
          asserts:
          [
            shouldReturnTradesExecutedEarlier:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Id":1,"Executed At":"2025-07-01T16:00:00.000000000+0000"},{"Id":2,"Executed At":"2025-07-02T09:00:00.000000000+0000"},{"Id":3,"Executed At":"2025-07-02T10:45:00.000000000+0000"},{"Id":4,"Executed At":"2025-07-02T13:00:00.000000000+0000"}]';
                  }#;
              }#
          ]
        },
        earlyMorningInNewYork:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            cutoff = %2025-07-02T06:00:00-0400
          ]
          asserts:
          [
            shouldReturnTradesExecutedEarlier:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Id":1,"Executed At":"2025-07-01T16:00:00.000000000+0000"},{"Id":2,"Executed At":"2025-07-02T09:00:00.000000000+0000"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
