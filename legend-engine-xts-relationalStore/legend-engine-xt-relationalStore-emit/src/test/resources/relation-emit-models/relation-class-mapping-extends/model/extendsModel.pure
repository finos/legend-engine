###Pure
Class demo::relation::classmappingextends::Product
{
  id: Integer[1];
  name: String[0..1];
  issuerName: String[0..1];
  knownIssuerId: Integer[0..1];
  listing: demo::relation::classmappingextends::Listing[0..1];
  classification: demo::relation::classmappingextends::Classification[0..1];
  sharesOutstanding: demo::relation::classmappingextends::Shares[*];
}

Class demo::relation::classmappingextends::Stock extends demo::relation::classmappingextends::Product
{
  stockClass: String[0..1];
}

Class demo::relation::classmappingextends::CommonStock extends demo::relation::classmappingextends::Stock
{
}

Class demo::relation::classmappingextends::PreferredStock extends demo::relation::classmappingextends::Stock
{
}

Class demo::relation::classmappingextends::Listing
{
  productType: String[0..1];
}

Class demo::relation::classmappingextends::Classification
{
  code: String[0..1];
  issuer: demo::relation::classmappingextends::Issuer[0..1];
}

Class demo::relation::classmappingextends::Issuer
{
  id: Integer[1];
  name: String[0..1];
}

Class demo::relation::classmappingextends::Shares
{
  amount: Integer[0..1];
}
