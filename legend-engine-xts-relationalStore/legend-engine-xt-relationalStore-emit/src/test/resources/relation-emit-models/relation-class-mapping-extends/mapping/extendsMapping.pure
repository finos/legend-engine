###Pure
function demo::relation::classmappingextends::func::productRel(): meta::pure::metamodel::relation::Relation<(ID:Integer[1], TYPE:String[0..1], NAME:String[0..1], STOCK_CLASS:String[0..1], ISSUER_ID:Integer[0..1])>[1]
{
  #>{demo::relation::classmappingextends::db::ExtendsDB.PRODUCT}#
}

function demo::relation::classmappingextends::func::stockRel(): meta::pure::metamodel::relation::Relation<(ID:Integer[1], TYPE:String[0..1], NAME:String[0..1], STOCK_CLASS:String[0..1], ISSUER_ID:Integer[0..1])>[1]
{
  #>{demo::relation::classmappingextends::db::ExtendsDB.PRODUCT}#->filter(p | ($p.TYPE == 'COMMON') || ($p.TYPE == 'PREFERRED'))
}

function demo::relation::classmappingextends::func::commonStockRel(): meta::pure::metamodel::relation::Relation<(ID:Integer[1], TYPE:String[0..1], NAME:String[0..1], STOCK_CLASS:String[0..1], ISSUER_ID:Integer[0..1])>[1]
{
  #>{demo::relation::classmappingextends::db::ExtendsDB.PRODUCT}#->filter(p | $p.TYPE == 'COMMON')
}

function demo::relation::classmappingextends::func::preferredStockRel(): meta::pure::metamodel::relation::Relation<(ID:Integer[1], TYPE:String[0..1], NAME:String[0..1], STOCK_CLASS:String[0..1], ISSUER_ID:Integer[0..1])>[1]
