###Relational
Database demo::relation::filteredtarget::db::FilteredTargetDB
(
  Table PERSON
  (
    ID INTEGER PRIMARY KEY,
    NAME VARCHAR(100) NOT NULL,
    FIRM_CODE VARCHAR(10),
    GROUP_CODE VARCHAR(10)
  )
  Table FIRM
  (
    ID INTEGER PRIMARY KEY,
    CODE VARCHAR(10) NOT NULL,
    NAME VARCHAR(100) NOT NULL,
    ACTIVE VARCHAR(1) NOT NULL,
    GROUP_CODE VARCHAR(10),
    HQ_ID INTEGER
  )
  Table HQ
  (
    ID INTEGER PRIMARY KEY,
    CITY VARCHAR(100) NOT NULL
  )
  Table PROCESSING_PERSON
  (
    milestoning
    (
      processing(PROCESSING_IN = IN_Z, PROCESSING_OUT = OUT_Z, INFINITY_DATE = %9999-12-31T00:00:00.0000)
    )
    ID INTEGER PRIMARY KEY,
    NAME VARCHAR(100) NOT NULL,
    FIRM_CODE VARCHAR(10),
    GROUP_CODE VARCHAR(10),
    IN_Z TIMESTAMP PRIMARY KEY,
    OUT_Z TIMESTAMP NOT NULL
  )
  Table PROCESSING_FIRM
  (
    milestoning
    (
      processing(PROCESSING_IN = IN_Z, PROCESSING_OUT = OUT_Z, INFINITY_DATE = %9999-12-31T00:00:00.0000)
    )
    ID INTEGER PRIMARY KEY,
    CODE VARCHAR(10) NOT NULL,
    NAME VARCHAR(100) NOT NULL,
    ACTIVE VARCHAR(1) NOT NULL,
    GROUP_CODE VARCHAR(10),
    IN_Z TIMESTAMP PRIMARY KEY,
    OUT_Z TIMESTAMP NOT NULL
  )

  Join Person_Firm(PERSON.FIRM_CODE = FIRM.CODE)
  Join Person_GroupFirms(PERSON.GROUP_CODE = FIRM.GROUP_CODE)
  Join Firm_Hq(FIRM.HQ_ID = HQ.ID)
  Join ProcessingPerson_Firm(PROCESSING_PERSON.FIRM_CODE = PROCESSING_FIRM.CODE)
  Join ProcessingPerson_GroupFirms(PROCESSING_PERSON.GROUP_CODE = PROCESSING_FIRM.GROUP_CODE)
  Filter ActiveFirm(FIRM.ACTIVE = 'Y')
  Filter ActiveProcessingFirm(PROCESSING_FIRM.ACTIVE = 'Y')
)
