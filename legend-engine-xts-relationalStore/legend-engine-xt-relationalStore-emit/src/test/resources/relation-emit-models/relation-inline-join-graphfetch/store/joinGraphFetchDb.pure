###Relational
Database demo::relation::joingraphfetch::db::JoinGraphFetchDB
(
  Table LISTING
  (
    ID        INTEGER PRIMARY KEY,
    NAME      VARCHAR(100) NOT NULL,
    LADDER_ID INTEGER
  )
  Table DIVISION
  (
    LISTING_ID INTEGER NOT NULL,
    LADDER_ID  INTEGER NOT NULL
  )
  Table LADDER
  (
    ID        INTEGER PRIMARY KEY,
    NAME      VARCHAR(100) NOT NULL,
    TICK_SIZE INTEGER NOT NULL
  )

  Join Listing_Ladder(LISTING.LADDER_ID = LADDER.ID)
  Join Listing_Division(LISTING.ID = DIVISION.LISTING_ID)
  Join Division_Ladder(DIVISION.LADDER_ID = LADDER.ID)
)
