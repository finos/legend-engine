###Relational
Database demo::relation::steppedjoin::db::SteppedJoinDB
(
  Table PERSON
  (
    ID          INTEGER PRIMARY KEY,
    NAME        VARCHAR(100) NOT NULL,
    FIRM_ID     INTEGER,
    OLD_FIRM_ID INTEGER,
    ACTIVE      VARCHAR(1) NOT NULL
  )
  Table FIRM
  (
    ID         INTEGER PRIMARY KEY,
    NAME       VARCHAR(100) NOT NULL,
    COUNTRY_ID INTEGER,
    LISTED     VARCHAR(1) NOT NULL
  )
  Table COUNTRY
  (
    ID   INTEGER PRIMARY KEY,
    NAME VARCHAR(100) NOT NULL
  )

  Join Person_Firm(case(isNull(PERSON.FIRM_ID), PERSON.OLD_FIRM_ID, PERSON.FIRM_ID) = FIRM.ID)
  Join Person_ActiveFirm(PERSON.ACTIVE = 'Y' and case(isNull(PERSON.FIRM_ID), PERSON.OLD_FIRM_ID, PERSON.FIRM_ID) = FIRM.ID)
  Join Firm_ListedMember(FIRM.LISTED = 'Y' and FIRM.ID = PERSON.FIRM_ID)
  Join Firm_Country(FIRM.COUNTRY_ID = COUNTRY.ID)
)
