          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":1,"firm":"Acme"},{"id":2,"firm":null},{"id":3,"firm":"Beta"},{"id":4,"firm":null},{"id":5,"firm":null},{"id":6,"firm":null},{"id":7,"firm":"Delta"}]';
                  }#;
              }#
          ];
        }
