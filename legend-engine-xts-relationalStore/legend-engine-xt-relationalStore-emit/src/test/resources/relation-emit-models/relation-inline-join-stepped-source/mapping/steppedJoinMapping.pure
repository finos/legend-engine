    firstPerFirmSuite:
    {
      function: |demo::relation::steppedjoin::Person.all()->project(~[id: x | $x.id, firm: x | $x.firstOfFirmFirm])->sort([~id->ascending()]);
      tests:
      [
        windowExtendRunsBeforeTheFilterThatGatesTheJoin:
        {
          data:
          [
            demo::relation::steppedjoin::db::SteppedJoinDB:
              Reference
              #{
                demo::relation::steppedjoin::data::SteppedJoinData
