###Pure
Class demo::relation::nestedinline::Trade
{
  id: Integer[1];
  details: demo::relation::nestedinline::TradeDetails[0..1];
}

Class demo::relation::nestedinline::TradeDetails
{
  desk: String[1];
  contact: demo::relation::nestedinline::Contact[0..1];
}

Class demo::relation::nestedinline::Contact
{
  counterpartyId: Integer[0..1];
  counterparty: demo::relation::nestedinline::Firm[0..1];
}

Class demo::relation::nestedinline::Firm
{
  id: Integer[1];
  name: String[1];
}

function demo::relation::nestedinline::func::tradeRel(): meta::pure::metamodel::relation::Relation<(ID:Integer[1], DESK:String[1], CPTY_ID:Integer[0..1])>[1]
{
  #>{demo::relation::nestedinline::db::NestedInlineDB.TRADE}#
}

function demo::relation::nestedinline::func::lowTradeRel(): meta::pure::metamodel::relation::Relation<(ID:Integer[1], DESK:String[1], CPTY_ID:Integer[0..1])>[1]
{
  #>{demo::relation::nestedinline::db::NestedInlineDB.TRADE}#->filter(r | $r.ID < 3)
}

function demo::relation::nestedinline::func::highTradeRel(): meta::pure::metamodel::relation::Relation<(ID:Integer[1], DESK:String[1], CPTY_ID:Integer[0..1])>[1]
{
  #>{demo::relation::nestedinline::db::NestedInlineDB.TRADE}#->filter(r | $r.ID >= 3)
}

