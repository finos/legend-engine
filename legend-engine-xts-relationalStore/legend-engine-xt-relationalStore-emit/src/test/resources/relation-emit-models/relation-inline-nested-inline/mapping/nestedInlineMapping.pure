###Mapping
Mapping demo::relation::nestedinline::mapping::NestedInlineMapping
(
  *demo::relation::nestedinline::Trade[trade]: Relation
  {
    ~src demo::relation::nestedinline::func::tradeRel()
    id: ID,
    details () Inline [details]
  }

  demo::relation::nestedinline::TradeDetails[details]: Relation
  {
    ~src demo::relation::nestedinline::func::tradeRel()
    desk: DESK,
    contact () Inline [contact]
  }

  demo::relation::nestedinline::Contact[contact]: Relation
  {
    ~src demo::relation::nestedinline::func::tradeRel()
    counterpartyId: CPTY_ID,
    counterparty: modelJoin({c, f | $c.counterpartyId == $f.id})
  }

  *demo::relation::nestedinline::Firm[firm]: Relation
  {
    ~src demo::relation::nestedinline::func::firmRel()
    id: ID,
    name: NAME
  }

  testSuites:
  [
    projectSuite:
    {
      function: |demo::relation::nestedinline::Trade.all()->project(~[id: t | $t.id, desk: t | $t.details.desk, counterparty: t | $t.details.contact.counterparty.name])->sort([~id->ascending()]);
      tests:
      [
        readsTheCounterpartyOfEachTrade:
        {
          data:
          [
            demo::relation::nestedinline::db::NestedInlineDB:
              Reference
              #{
                demo::relation::nestedinline::data::NestedInlineData
              }#
          ];
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":1,"desk":"Rates","counterparty":"Acme"},{"id":2,"desk":"Credit","counterparty":null},{"id":3,"desk":"Rates","counterparty":null},{"id":4,"desk":"FX","counterparty":"Globex"}]';
                  }#;
              }#
          ];
        }
      ];
    },
    filterSuite:
    {
      function: |demo::relation::nestedinline::Trade.all()->filter(t | $t.details.contact.counterparty.name->in(['Acme', 'Globex']))->project(~[id: t | $t.id])->sort([~id->ascending()]);
      tests:
      [
        keepsTradesWithAKnownCounterparty:
        {
          data:
          [
            demo::relation::nestedinline::db::NestedInlineDB:
              Reference
              #{
                demo::relation::nestedinline::data::NestedInlineData
              }#
          ];
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":1},{"id":4}]';
                  }#;
              }#
          ];
        }
      ];
    },
    graphFetchSuite:
    {
      function: |demo::relation::nestedinline::Trade.all()->graphFetch(#{demo::relation::nestedinline::Trade{id, details{desk, contact{counterparty{id, name}}}}}#)->serialize(#{demo::relation::nestedinline::Trade{id, details{desk, contact{counterparty{id, name}}}}}#);
      tests:
      [
        fetchesTheCounterpartyOfEachTrade:
        {
          data:
          [
            demo::relation::nestedinline::db::NestedInlineDB:
              Reference
              #{
                demo::relation::nestedinline::data::NestedInlineData
              }#
          ];
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":1,"details":{"desk":"Rates","contact":{"counterparty":{"id":10,"name":"Acme"}}}},{"id":2,"details":{"desk":"Credit","contact":{"counterparty":null}}},{"id":3,"details":{"desk":"Rates","contact":{"counterparty":null}}},{"id":4,"details":{"desk":"FX","contact":{"counterparty":{"id":11,"name":"Globex"}}}}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)

###Mapping
Mapping demo::relation::nestedinline::mapping::UnionNestedInlineMapping
(
  *demo::relation::nestedinline::Trade: Operation
  {
    meta::pure::router::operations::union_OperationSetImplementation_1__SetImplementation_MANY_(lowTrade, highTrade)
  }

  demo::relation::nestedinline::Trade[lowTrade]: Relation
  {
    ~src demo::relation::nestedinline::func::lowTradeRel()
    id: ID,
    details () Inline [details]
  }

  demo::relation::nestedinline::Trade[highTrade]: Relation
