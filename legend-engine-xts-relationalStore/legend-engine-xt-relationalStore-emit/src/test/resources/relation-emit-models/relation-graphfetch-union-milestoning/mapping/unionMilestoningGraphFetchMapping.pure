###Pure
Class demo::relation::domain::ContractEmployee extends demo::relation::domain::Employee
{
}

###Mapping
Mapping demo::relation::mapping::EmployeeGraphFetchUnionMapping
(
  *demo::relation::domain::Employee: Operation
  {
    meta::pure::router::operations::union_OperationSetImplementation_1__SetImplementation_MANY_(contractSet, fullTimeSet)
  }

  demo::relation::domain::Employee[contractSet]: Relation
  {
    ~func demo::relation::func::contractEmployees():Relation<Any>[1]
    id: ID,
    firstName: FIRST_NAME,
    lastName: LAST_NAME,
    employeeType: EnumerationMapping EmployeeTypeMapping: EMP_TYPE,
    active: $row.ACTIVE == 1,
    hireDate: HIRE_DATE,
    salary: SALARY
  }

  demo::relation::domain::Employee[fullTimeSet]: Relation
  {
    ~func demo::relation::func::fullTimeEmployees():Relation<Any>[1]
    id: ID,
    firstName: FIRST_NAME,
    lastName: LAST_NAME,
    employeeType: EnumerationMapping EmployeeTypeMapping: EMP_TYPE,
    active: $row.ACTIVE == 1,
    hireDate: HIRE_DATE,
    salary: SALARY
  }

  demo::relation::domain::EmployeeType: EnumerationMapping EmployeeTypeMapping
  {
    FULL_TIME: ['FULL_TIME'],
    CONTRACT: ['CONTRACT']
  }

  testSuites:
  [
    unionRootSuite:
    {
      function: |demo::relation::domain::Employee.all()
                  ->graphFetch(#{demo::relation::domain::Employee{firstName, employeeType}}#)
                  ->serialize(#{demo::relation::domain::Employee{firstName, employeeType}}#);
      tests:
      [
        bothSets:
        {
          data:
          [
            demo::relation::db::EmployeeDB:
              Reference
              #{
                demo::relation::data::EmployeeUnionGraphFetchData
              }#
          ];
          asserts:
          [
            shouldFetchRootsFromBothUnionedSets:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"firstName":"Alice","employeeType":"CONTRACT"},{"firstName":"Bob","employeeType":"CONTRACT"},{"firstName":"Carol","employeeType":"FULL_TIME"},{"firstName":"David","employeeType":"FULL_TIME"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)

Mapping demo::relation::mapping::EmployeeGraphFetchSubTypeMapping
(
  *demo::relation::domain::Employee: Operation
  {
    meta::pure::router::operations::inheritance_OperationSetImplementation_1__SetImplementation_MANY_()
  }

  *demo::relation::domain::ContractEmployee[contractSet]: Relation
  {
    ~func demo::relation::func::contractEmployees():Relation<Any>[1]
    id: ID,
    firstName: FIRST_NAME,
    lastName: LAST_NAME,
    employeeType: EnumerationMapping EmployeeTypeMapping: EMP_TYPE,
    active: $row.ACTIVE == 1,
    hireDate: HIRE_DATE,
    salary: SALARY
  }

  *demo::relation::domain::ExtendedEmployee[fullTimeSet]: Relation
  {
    ~func demo::relation::func::fullTimeEmployees():Relation<Any>[1]
    id: ID,
    firstName: FIRST_NAME,
    lastName: LAST_NAME,
    employeeType: EnumerationMapping EmployeeTypeMapping: EMP_TYPE,
    active: $row.ACTIVE == 1,
    hireDate: HIRE_DATE,
    salary: SALARY,
    fullGreeting: 'Hello, ' + $row.FIRST_NAME
  }

  demo::relation::domain::EmployeeType: EnumerationMapping EmployeeTypeMapping
  {
    FULL_TIME: ['FULL_TIME'],
    CONTRACT: ['CONTRACT']
  }

  testSuites:
  [
    subTypeRootSuite:
    {
      function: |demo::relation::domain::Employee.all()
                  ->graphFetch(#{demo::relation::domain::Employee{firstName, ->subType(@demo::relation::domain::ExtendedEmployee){fullGreeting}}}#)
                  ->serialize(#{demo::relation::domain::Employee{firstName, ->subType(@demo::relation::domain::ExtendedEmployee){fullGreeting}}}#);
      tests:
      [
        bothSubTypes:
        {
          data:
          [
            demo::relation::db::EmployeeDB:
              Reference
              #{
                demo::relation::data::EmployeeUnionGraphFetchData
              }#
          ];
          asserts:
          [
            shouldFetchSubTypePropertyOnlyForExtendedEmployees:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"firstName":"Alice"},{"firstName":"Bob"},{"firstName":"Carol","fullGreeting":"Hello, Carol"},{"firstName":"David","fullGreeting":"Hello, David"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)

Mapping demo::relation::mapping::TemporalEmployeeGraphFetchMapping
(
  *demo::relation::domain::TemporalEmployee: Relation
  {
    ~func demo::relation::func::temporalEmployees():Relation<Any>[1]
    id: ID,
    firstName: FIRST_NAME,
    salary: SALARY
  }

  *demo::relation::domain::BusinessTemporalEmployee: Relation
  {
    ~func demo::relation::func::businessTemporalEmployees():Relation<Any>[1]
    id: ID,
    firstName: FIRST_NAME,
    salary: SALARY
  }

  testSuites:
  [
    processingTemporalRootSuite:
    {
      function: |demo::relation::domain::TemporalEmployee.all(%2025-01-01)
                  ->graphFetch(#{demo::relation::domain::TemporalEmployee{id, firstName, salary}}#)
                  ->serialize(#{demo::relation::domain::TemporalEmployee{id, firstName, salary}}#);
      tests:
      [
        activeAtDate:
        {
          data:
          [
            demo::relation::db::EmployeeDB:
              Reference
              #{
                demo::relation::data::TemporalEmployeeGraphFetchData
              }#
          ];
          asserts:
          [
            shouldFetchRowsLiveAtProcessingDate:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":1,"firstName":"Alice","salary":90000.0},{"id":2,"firstName":"Bob","salary":75000.0}]';
                  }#;
              }#
          ];
        }
      ];
    },
    businessTemporalRootSuite:
    {
      function: |demo::relation::domain::BusinessTemporalEmployee.all(%2025-01-01)
                  ->graphFetch(#{demo::relation::domain::BusinessTemporalEmployee{id, firstName, salary}}#)
                  ->serialize(#{demo::relation::domain::BusinessTemporalEmployee{id, firstName, salary}}#);
      tests:
      [
        activeAtDate:
        {
          data:
          [
            demo::relation::db::EmployeeDB:
              Reference
              #{
                demo::relation::data::BusinessTemporalEmployeeGraphFetchData
              }#
          ];
          asserts:
          [
            shouldFetchRowsLiveAtBusinessDate:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":1,"firstName":"Dave","salary":95000.0},{"id":2,"firstName":"Eve","salary":80000.0}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
