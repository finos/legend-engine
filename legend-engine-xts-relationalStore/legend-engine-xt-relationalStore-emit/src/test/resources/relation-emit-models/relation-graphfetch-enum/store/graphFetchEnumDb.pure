###Relational
Database demo::relation::graphfetchenum::db::GraphFetchEnumDB
(
  Table PRODUCT
  (
    ID        INTEGER PRIMARY KEY,
    NAME      VARCHAR(100) NOT NULL,
    STATUS_CD VARCHAR(10)
  )
  Table DESIGNATION
  (
    PRODUCT_ID     INTEGER NOT NULL,
    ENTITY_ID      INTEGER NOT NULL,
    DESIGNATION_CD VARCHAR(10) NOT NULL
  )

  Join Product_Designation(PRODUCT.ID = DESIGNATION.PRODUCT_ID)
  Join Product_EuDesignation(PRODUCT.ID = DESIGNATION.PRODUCT_ID and DESIGNATION.ENTITY_ID = 10)
)
