###Mapping
Mapping demo::relation::mapping::EmployeeGraphFetchBasicMapping
(
  *demo::relation::domain::Employee: Relation
  {
    ~func demo::relation::func::employeesWithAddress():Relation<Any>[1]
    id: ID,
    firstName: FIRST_NAME,
    lastName: LAST_NAME,
    employeeType: EnumerationMapping EmployeeTypeMapping: EMP_TYPE,
    active: $row.ACTIVE == 1,
    hireDate: HIRE_DATE,
    salary: SALARY
  }

  demo::relation::domain::EmployeeType: EnumerationMapping EmployeeTypeMapping
  {
    FULL_TIME: ['FULL_TIME'],
    CONTRACT: ['CONTRACT']
  }

  testSuites:
  [
    rootFilterWithQualifierSuite:
    {
      function: |demo::relation::domain::Employee.all()
                  ->filter(e | $e.id > 1)
                  ->graphFetch(#{demo::relation::domain::Employee{id, firstName, lastName, salary, fullName}}#)
                  ->serialize(#{demo::relation::domain::Employee{id, firstName, lastName, salary, fullName}}#);
      tests:
      [
        idAboveOne:
        {
          data:
          [
            demo::relation::db::EmployeeDB:
              Reference
              #{
                demo::relation::data::EmployeeData
              }#
          ];
          asserts:
          [
            shouldFetchFilteredRootsWithDerivedFullName:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":2,"firstName":"Bob","lastName":"Smith","salary":75000.0,"fullName()":"Bob Smith"},{"id":3,"firstName":"Carol","lastName":"White","salary":null,"fullName()":"Carol White"}]';
                  }#;
              }#
          ];
        }
      ];
    },
    enumPropertySuite:
    {
      function: |demo::relation::domain::Employee.all()
                  ->graphFetch(#{demo::relation::domain::Employee{firstName, employeeType}}#)
                  ->serialize(#{demo::relation::domain::Employee{firstName, employeeType}}#);
      tests:
      [
        allEmployees:
        {
          data:
          [
            demo::relation::db::EmployeeDB:
              Reference
              #{
                demo::relation::data::EmployeeData
              }#
          ];
          asserts:
          [
            shouldFetchMappedEnumValues:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"firstName":"Alice","employeeType":"FULL_TIME"},{"firstName":"Bob","employeeType":"CONTRACT"},{"firstName":"Carol","employeeType":"FULL_TIME"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)

Mapping demo::relation::mapping::EmployeeGraphFetchEmbeddedMapping
(
  *demo::relation::domain::ExtendedEmployee: Relation
  {
    ~func demo::relation::func::employeesWithAddress():Relation<Any>[1]
    id: ID,
    firstName: FIRST_NAME,
    lastName: LAST_NAME,
    employeeType: EnumerationMapping EmployeeTypeMapping: EMP_TYPE,
    active: $row.ACTIVE == 1,
    hireDate: HIRE_DATE,
    salary: SALARY,
    address
    (
      street: STREET,
      city: CITY
    )
  }

  demo::relation::domain::EmployeeType: EnumerationMapping EmployeeTypeMapping
  {
    FULL_TIME: ['FULL_TIME'],
    CONTRACT: ['CONTRACT']
  }

  testSuites:
  [
    embeddedPropertySuite:
    {
      function: |demo::relation::domain::ExtendedEmployee.all()
                  ->graphFetch(#{demo::relation::domain::ExtendedEmployee{firstName, address{street, city}}}#)
                  ->serialize(#{demo::relation::domain::ExtendedEmployee{firstName, address{street, city}}}#);
      tests:
      [
        allEmployees:
        {
          data:
          [
            demo::relation::db::EmployeeDB:
              Reference
              #{
                demo::relation::data::EmployeeData
              }#
          ];
          asserts:
          [
            shouldFetchEmbeddedAddress:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"firstName":"Alice","address":{"street":"Main St","city":"London"}},{"firstName":"Bob","address":{"street":"Oak Ave","city":"Paris"}},{"firstName":"Carol","address":{"street":"Pine Rd","city":"Berlin"}}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)

Mapping demo::relation::mapping::EmployeeGraphFetchInlineEmbeddedMapping
(
  *demo::relation::domain::ExtendedEmployee[empAddr]: Relation
  {
    ~func demo::relation::func::employeesWithAddress():Relation<Any>[1]
    id: ID,
    firstName: FIRST_NAME,
    lastName: LAST_NAME,
    employeeType: EnumerationMapping EmployeeTypeMapping: EMP_TYPE,
    active: $row.ACTIVE == 1,
    hireDate: HIRE_DATE,
    salary: SALARY,
    address () Inline [addressSet]
  }

  *demo::relation::domain::Address[addressSet]: Relation
  {
    ~func demo::relation::func::employeesWithAddress():Relation<Any>[1]
    street: STREET,
    city: CITY
  }

  demo::relation::domain::EmployeeType: EnumerationMapping EmployeeTypeMapping
  {
    FULL_TIME: ['FULL_TIME'],
    CONTRACT: ['CONTRACT']
  }

  testSuites:
  [
    inlineEmbeddedPropertySuite:
    {
      function: |demo::relation::domain::ExtendedEmployee.all()
                  ->graphFetch(#{demo::relation::domain::ExtendedEmployee{firstName, address{city}}}#)
                  ->serialize(#{demo::relation::domain::ExtendedEmployee{firstName, address{city}}}#);
      tests:
      [
        allEmployees:
        {
          data:
          [
            demo::relation::db::EmployeeDB:
              Reference
              #{
                demo::relation::data::EmployeeData
              }#
          ];
          asserts:
          [
            shouldFetchInlineEmbeddedAddress:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"firstName":"Alice","address":{"city":"London"}},{"firstName":"Bob","address":{"city":"Paris"}},{"firstName":"Carol","address":{"city":"Berlin"}}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
