###Mapping
Mapping demo::relation::inlineembeddedjoin::mapping::UnionInlineEmbeddedMilestonedJoinMapping
(
  *demo::relation::inlineembeddedjoin::Position: Operation
  {
    meta::pure::router::operations::union_OperationSetImplementation_1__SetImplementation_MANY_(lowPosition, highPosition)
  }

  demo::relation::inlineembeddedjoin::Position[lowPosition]: Relation
  {
    ~src demo::relation::inlineembeddedjoin::func::lowPositionRel()
    id: ID,
    holding () Inline [holding]
  }

  demo::relation::inlineembeddedjoin::Position[highPosition]: Relation
  {
    ~src demo::relation::inlineembeddedjoin::func::highPositionRel()
    id: ID,
    holding () Inline [holding]
  }

  demo::relation::inlineembeddedjoin::Holding[holding]: Relation
  {
    ~src demo::relation::inlineembeddedjoin::func::positionRel()
    quantity: QUANTITY,
    issuerId: ISSUER_ID,
    issuer: modelJoin({h, i | $h.issuerId == $i.id})
  }

  *demo::relation::inlineembeddedjoin::Issuer[issuer]: Relation
  {
    ~src demo::relation::inlineembeddedjoin::func::issuerRel()
    id: ID,
    name: NAME
  }

  testSuites:
  [
    projectSuite:
    {
      function: |demo::relation::inlineembeddedjoin::Position.all(%2023-01-01T00:00:00)->project(~[id: p | $p.id, quantity: p | $p.holding.quantity, issuer: p | $p.holding.issuer.name])->sort([~id->ascending()]);
      tests:
      [
        readsTheIssuerCurrentAtTheQueryDate:
        {
          data:
          [
            demo::relation::inlineembeddedjoin::db::InlineEmbeddedJoinDB:
              Reference
              #{
                demo::relation::inlineembeddedjoin::data::InlineEmbeddedJoinData
              }#
          ];
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":1,"quantity":100,"issuer":"Acme"},{"id":2,"quantity":200,"issuer":null},{"id":3,"quantity":350,"issuer":"Globex"},{"id":4,"quantity":400,"issuer":null}]';
                  }#;
              }#
          ];
        }
      ];
    },
    filterSuite:
    {
      function: |demo::relation::inlineembeddedjoin::Position.all(%2023-01-01T00:00:00)->filter(p | $p.holding.issuer.name == 'Acme')->project(~[id: p | $p.id])->sort([~id->ascending()]);
      tests:
      [
        matchesTheIssuerNameCurrentAtTheQueryDate:
        {
          data:
          [
            demo::relation::inlineembeddedjoin::db::InlineEmbeddedJoinDB:
              Reference
              #{
                demo::relation::inlineembeddedjoin::data::InlineEmbeddedJoinData
              }#
          ];
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":1}]';
                  }#;
              }#
          ];
        }
      ];
    },
    graphFetchSuite:
    {
      function: |demo::relation::inlineembeddedjoin::Position.all(%2023-01-01T00:00:00)->graphFetch(#{demo::relation::inlineembeddedjoin::Position{id, holding{quantity, issuer{id, name}}}}#)->serialize(#{demo::relation::inlineembeddedjoin::Position{id, holding{quantity, issuer{id, name}}}}#);
      tests:
      [
        fetchesTheIssuerCurrentAtTheQueryDate:
        {
          data:
          [
            demo::relation::inlineembeddedjoin::db::InlineEmbeddedJoinDB:
              Reference
              #{
                demo::relation::inlineembeddedjoin::data::InlineEmbeddedJoinData
              }#
          ];
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":1,"holding(2023-01-01T00:00:00+0000)":{"quantity":100,"issuer(2023-01-01T00:00:00+0000)":{"id":10,"name":"Acme"}}},{"id":2,"holding(2023-01-01T00:00:00+0000)":{"quantity":200,"issuer(2023-01-01T00:00:00+0000)":null}},{"id":3,"holding(2023-01-01T00:00:00+0000)":{"quantity":350,"issuer(2023-01-01T00:00:00+0000)":{"id":11,"name":"Globex"}}},{"id":4,"holding(2023-01-01T00:00:00+0000)":{"quantity":400,"issuer(2023-01-01T00:00:00+0000)":null}}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
