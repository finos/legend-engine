###Mapping
Mapping demo::relation::inlineembeddedjoin::mapping::InlineEmbeddedJoinMapping
(
  *demo::relation::inlineembeddedjoin::Trade[trade]: Relation
  {
    ~src demo::relation::inlineembeddedjoin::func::tradeRel()
    id: ID,
    details () Inline [details]
  }

  demo::relation::inlineembeddedjoin::TradeDetails[details]: Relation
  {
    ~src demo::relation::inlineembeddedjoin::func::tradeRel()
    desk: DESK,
    counterpartyId: CPTY_ID,
    counterparty: modelJoin({d, f | $d.counterpartyId == $f.id})
  }

  *demo::relation::inlineembeddedjoin::Firm[firm]: Relation
  {
    ~src demo::relation::inlineembeddedjoin::func::firmRel()
    id: ID,
    name: NAME
  }

  testSuites:
  [
    projectSuite:
    {
      function: |demo::relation::inlineembeddedjoin::Trade.all()->project(~[id: t | $t.id, desk: t | $t.details.desk, counterparty: t | $t.details.counterparty.name])->sort([~id->ascending()]);
      tests:
      [
        readsTheCounterpartyOfEachTrade:
        {
          data:
          [
            demo::relation::inlineembeddedjoin::db::InlineEmbeddedJoinDB:
              Reference
              #{
                demo::relation::inlineembeddedjoin::data::InlineEmbeddedJoinData
              }#
          ];
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":1,"desk":"Rates","counterparty":"Acme"},{"id":2,"desk":"Credit","counterparty":null},{"id":3,"desk":"Rates","counterparty":null},{"id":4,"desk":"FX","counterparty":"Globex"}]';
                  }#;
              }#
          ];
        }
      ];
    },
    filterSuite:
    {
      function: |demo::relation::inlineembeddedjoin::Trade.all()->filter(t | $t.details.counterparty.name->in(['Acme', 'Globex']))->project(~[id: t | $t.id])->sort([~id->ascending()]);
      tests:
      [
        keepsTradesWithAKnownCounterparty:
        {
          data:
          [
            demo::relation::inlineembeddedjoin::db::InlineEmbeddedJoinDB:
              Reference
              #{
                demo::relation::inlineembeddedjoin::data::InlineEmbeddedJoinData
              }#
          ];
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":1},{"id":4}]';
                  }#;
              }#
          ];
        }
      ];
    },
    graphFetchSuite:
    {
      function: |demo::relation::inlineembeddedjoin::Trade.all()->graphFetch(#{demo::relation::inlineembeddedjoin::Trade{id, details{desk, counterparty{id, name}}}}#)->serialize(#{demo::relation::inlineembeddedjoin::Trade{id, details{desk, counterparty{id, name}}}}#);
      tests:
      [
        fetchesTheCounterpartyOfEachTrade:
        {
          data:
          [
            demo::relation::inlineembeddedjoin::db::InlineEmbeddedJoinDB:
              Reference
              #{
                demo::relation::inlineembeddedjoin::data::InlineEmbeddedJoinData
              }#
          ];
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":1,"details":{"desk":"Rates","counterparty":{"id":10,"name":"Acme"}}},{"id":2,"details":{"desk":"Credit","counterparty":null}},{"id":3,"details":{"desk":"Rates","counterparty":null}},{"id":4,"details":{"desk":"FX","counterparty":{"id":11,"name":"Globex"}}}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)


###Mapping
Mapping demo::relation::inlineembeddedjoin::mapping::UnionInlineEmbeddedJoinMapping
(
  *demo::relation::inlineembeddedjoin::Trade: Operation
  {
    meta::pure::router::operations::union_OperationSetImplementation_1__SetImplementation_MANY_(lowTrade, highTrade)
  }

  demo::relation::inlineembeddedjoin::Trade[lowTrade]: Relation
  {
    ~src demo::relation::inlineembeddedjoin::func::lowTradeRel()
    id: ID,
    details () Inline [details]
  }

  demo::relation::inlineembeddedjoin::Trade[highTrade]: Relation
  {
    ~src demo::relation::inlineembeddedjoin::func::highTradeRel()
    id: ID,
    details () Inline [details]
  }

  demo::relation::inlineembeddedjoin::TradeDetails[details]: Relation
  {
    ~src demo::relation::inlineembeddedjoin::func::tradeRel()
    desk: DESK,
    counterpartyId: CPTY_ID,
    counterparty: modelJoin({d, f | $d.counterpartyId == $f.id})
  }

  *demo::relation::inlineembeddedjoin::Firm[firm]: Relation
  {
    ~src demo::relation::inlineembeddedjoin::func::firmRel()
    id: ID,
    name: NAME
  }

  testSuites:
  [
    projectWithoutJoinSuite:
    {
      function: |demo::relation::inlineembeddedjoin::Trade.all()->project(~[id: t | $t.id, desk: t | $t.details.desk, counterpartyId: t | $t.details.counterpartyId])->sort([~id->ascending()]);
      tests:
      [
        readsTheDetailsOfBothBranches:
        {
          data:
          [
            demo::relation::inlineembeddedjoin::db::InlineEmbeddedJoinDB:
              Reference
              #{
                demo::relation::inlineembeddedjoin::data::InlineEmbeddedJoinData
              }#
          ];
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":1,"desk":"Rates","counterpartyId":10},{"id":2,"desk":"Credit","counterpartyId":null},{"id":3,"desk":"Rates","counterpartyId":99},{"id":4,"desk":"FX","counterpartyId":11}]';
                  }#;
              }#
          ];
        }
      ];
    },
    filterWithoutJoinSuite:
    {
      function: |demo::relation::inlineembeddedjoin::Trade.all()->filter(t | $t.details.desk == 'Rates')->project(~[id: t | $t.id])->sort([~id->ascending()]);
      tests:
      [
        keepsTheRatesTradesOfBothBranches:
        {
          data:
          [
            demo::relation::inlineembeddedjoin::db::InlineEmbeddedJoinDB:
              Reference
              #{
                demo::relation::inlineembeddedjoin::data::InlineEmbeddedJoinData
              }#
          ];
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":1},{"id":3}]';
                  }#;
              }#
          ];
        }
      ];
    },
    projectSuite:
    {
      function: |demo::relation::inlineembeddedjoin::Trade.all()->project(~[id: t | $t.id, desk: t | $t.details.desk, counterparty: t | $t.details.counterparty.name])->sort([~id->ascending()]);
      tests:
      [
        readsTheCounterpartyOfEachTrade:
        {
          data:
          [
            demo::relation::inlineembeddedjoin::db::InlineEmbeddedJoinDB:
              Reference
              #{
                demo::relation::inlineembeddedjoin::data::InlineEmbeddedJoinData
              }#
          ];
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":1,"desk":"Rates","counterparty":"Acme"},{"id":2,"desk":"Credit","counterparty":null},{"id":3,"desk":"Rates","counterparty":null},{"id":4,"desk":"FX","counterparty":"Globex"}]';
                  }#;
              }#
          ];
        }
      ];
    },
    filterSuite:
    {
      function: |demo::relation::inlineembeddedjoin::Trade.all()->filter(t | $t.details.counterparty.name->in(['Acme', 'Globex']))->project(~[id: t | $t.id])->sort([~id->ascending()]);
      tests:
      [
        keepsTradesWithAKnownCounterparty:
        {
          data:
          [
            demo::relation::inlineembeddedjoin::db::InlineEmbeddedJoinDB:
              Reference
              #{
                demo::relation::inlineembeddedjoin::data::InlineEmbeddedJoinData
              }#
          ];
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":1},{"id":4}]';
                  }#;
              }#
          ];
        }
      ];
    },
    graphFetchSuite:
    {
      function: |demo::relation::inlineembeddedjoin::Trade.all()->graphFetch(#{demo::relation::inlineembeddedjoin::Trade{id, details{desk, counterparty{id, name}}}}#)->serialize(#{demo::relation::inlineembeddedjoin::Trade{id, details{desk, counterparty{id, name}}}}#);
      tests:
      [
        fetchesTheCounterpartyOfEachTrade:
        {
          data:
          [
            demo::relation::inlineembeddedjoin::db::InlineEmbeddedJoinDB:
              Reference
              #{
                demo::relation::inlineembeddedjoin::data::InlineEmbeddedJoinData
              }#
          ];
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":1,"details":{"desk":"Rates","counterparty":{"id":10,"name":"Acme"}}},{"id":2,"details":{"desk":"Credit","counterparty":null}},{"id":3,"details":{"desk":"Rates","counterparty":null}},{"id":4,"details":{"desk":"FX","counterparty":{"id":11,"name":"Globex"}}}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)


###Mapping
Mapping demo::relation::inlineembeddedjoin::mapping::UnionEmbeddedJoinMapping
(
  *demo::relation::inlineembeddedjoin::Trade: Operation
