// Each union branch (ID < 3, ID >= 3) holds a trade whose counterparty exists and one whose counterparty
// is null or unknown. Acme was renamed on 2022-01-01 and position 3 changed issuer on 2021-01-01, so a
// milestoned read at 2023-01-01 that ignored the query date would see superseded rows.

###Data
Data demo::relation::inlineembeddedjoin::data::InlineEmbeddedJoinData
{
  Relation
  #{
    default.TRADE:
      ID,DESK,CPTY_ID
      1,Rates,10
      2,Credit,
      3,Rates,99
      4,FX,11;
    default.FIRM:
      ID,NAME
      10,Acme
      11,Globex;
    default.POSITION:
      ID,QUANTITY,ISSUER_ID,IN_Z,OUT_Z
      1,100,10,2020-01-01 00:00:00,9999-12-31 00:00:00
      2,200,,2020-01-01 00:00:00,9999-12-31 00:00:00
      3,300,10,2020-01-01 00:00:00,2021-01-01 00:00:00
      3,350,11,2021-01-01 00:00:00,9999-12-31 00:00:00
      4,400,99,2020-01-01 00:00:00,9999-12-31 00:00:00;
    default.ISSUER:
      ID,NAME,IN_Z,OUT_Z
      10,Acme Old,2020-01-01 00:00:00,2022-01-01 00:00:00
      10,Acme,2022-01-01 00:00:00,9999-12-31 00:00:00
      11,Globex,2020-01-01 00:00:00,9999-12-31 00:00:00;
  }#
}
