###Relational
Database demo::relation::inlineembeddedjoin::db::InlineEmbeddedJoinDB
(
  Table TRADE
  (
    ID      INTEGER PRIMARY KEY,
    DESK    VARCHAR(100) NOT NULL,
    CPTY_ID INTEGER
  )
  Table FIRM
  (
    ID   INTEGER PRIMARY KEY,
    NAME VARCHAR(100) NOT NULL
  )
  Table POSITION
  (
    milestoning
    (
      processing(PROCESSING_IN = IN_Z, PROCESSING_OUT = OUT_Z, INFINITY_DATE = %9999-12-31T00:00:00.0000)
    )
    ID        INTEGER PRIMARY KEY,
    QUANTITY  INTEGER NOT NULL,
    ISSUER_ID INTEGER,
    IN_Z      TIMESTAMP PRIMARY KEY,
    OUT_Z     TIMESTAMP NOT NULL
  )
  Table ISSUER
  (
    milestoning
    (
      processing(PROCESSING_IN = IN_Z, PROCESSING_OUT = OUT_Z, INFINITY_DATE = %9999-12-31T00:00:00.0000)
    )
    ID    INTEGER PRIMARY KEY,
    NAME  VARCHAR(100) NOT NULL,
    IN_Z  TIMESTAMP PRIMARY KEY,
    OUT_Z TIMESTAMP NOT NULL
  )

  Join Trade_Firm(TRADE.CPTY_ID = FIRM.ID)
  Join Position_Issuer(POSITION.ISSUER_ID = ISSUER.ID)

  Filter LowTradeFilter(TRADE.ID < 3)
  Filter HighTradeFilter(TRADE.ID >= 3)
  Filter LowPositionFilter(POSITION.ID < 3)
  Filter HighPositionFilter(POSITION.ID >= 3)
)
