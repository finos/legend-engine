###Relational
Database demo::relation::joinvariant::db::JoinVariantDB
(
  Table OWNER
  (
    ID   INTEGER PRIMARY KEY,
    NAME VARCHAR(100) NOT NULL
  )
  Table DOC
  (
    ID      INTEGER PRIMARY KEY,
    OWNERID INTEGER,
    PAYLOAD SEMISTRUCTURED
  )
  Table LIMITS
  (
    ID     INTEGER PRIMARY KEY,
    MAXLEN INTEGER NOT NULL
  )
)
