###Mapping
import demo::relation::joinmilestoning::func::*;

Mapping demo::relation::joinmilestoning::mapping::JoinMilestoningMapping
(
  *demo::relation::joinmilestoning::ProcessingProduct: Relation
  {
    ~src demo::relation::joinmilestoning::func::processingProductRel()
    name: NAME,
    market: $src->navigationJoin(processingListingRel(), {p, l | $p.ID == $l.PRODUCT_ID}).MARKET,
    exchangeName: $src->navigationJoin(processingListingRel(), {p, l | $p.ID == $l.PRODUCT_ID})->navigationJoin(exchangeRel(), {l, e | $l.EXCHANGE_ID == $e.ID}).EXCHANGE_NAME,
    listedName: $src->filterJoin(processingListingRel(), {p, l | $p.ID == $l.PRODUCT_ID}).NAME,
    exchangeNameViaJoinedTarget: $src->navigationJoin(#>{demo::relation::joinmilestoning::db::JoinMilestoningDB.EXCHANGE}#->join(#>{demo::relation::joinmilestoning::db::JoinMilestoningDB.PROCESSING_LISTING}#, meta::pure::functions::relation::JoinKind.INNER, {e, l | $e.ID == $l.EXCHANGE_ID}), {p, t | $p.ID == $t.PRODUCT_ID}).EXCHANGE_NAME,
    lseMarketViaFilteredTarget: $src->navigationJoin(processingListingRel()->filter(l | $l.EXCHANGE_ID == 1), {p, l | $p.ID == $l.PRODUCT_ID}).MARKET
  }

  *demo::relation::joinmilestoning::BusinessProduct: Relation
  {
    ~src demo::relation::joinmilestoning::func::businessProductRel()
    name: NAME,
    market: $src->navigationJoin(businessListingRel(), {p, l | $p.ID == $l.PRODUCT_ID}).MARKET,
    exchangeName: $src->navigationJoin(businessListingRel(), {p, l | $p.ID == $l.PRODUCT_ID})->navigationJoin(exchangeRel(), {l, e | $l.EXCHANGE_ID == $e.ID}).EXCHANGE_NAME
  }

  *demo::relation::joinmilestoning::BiTemporalProduct: Relation
  {
    ~src demo::relation::joinmilestoning::func::biTemporalProductRel()
    name: NAME,
    market: $src->navigationJoin(biTemporalListingRel(), {p, l | $p.ID == $l.PRODUCT_ID}).MARKET
  }

  testSuites:
  [
    processingLatestSuite:
    {
      function: |demo::relation::joinmilestoning::ProcessingProduct.all(%latest)->project(~[name: x | $x.name, market: x | $x.market, exchange: x | $x.exchangeName])->sort([~name->ascending()]);
      tests:
      [
        readsTheCurrentListing:
        {
          data:
          [
            demo::relation::joinmilestoning::db::JoinMilestoningDB:
              Reference
              #{
                demo::relation::joinmilestoning::data::JoinMilestoningData
              }#
          ];
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"name":"Gadget","market":null,"exchange":null},{"name":"Widget","market":"New Market","exchange":"NYSE"}]';
                  }#;
              }#
          ];
        }
      ];
    },
    processingPointInTimeSuite:
    {
      function: |demo::relation::joinmilestoning::ProcessingProduct.all(%2022-06-01)->project(~[name: x | $x.name, market: x | $x.market, exchange: x | $x.exchangeName])->sort([~name->ascending()]);
      tests:
      [
        readsTheListingCurrentAtTheDate:
        {
          data:
          [
            demo::relation::joinmilestoning::db::JoinMilestoningDB:
              Reference
              #{
                demo::relation::joinmilestoning::data::JoinMilestoningData
              }#
          ];
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"name":"Gadget","market":"Gadget Market","exchange":"LSE"},{"name":"Widget","market":"Old Market","exchange":"LSE"}]';
                  }#;
              }#
          ];
        }
      ];
    },
    processingFilterOnJoinPropertySuite:
    {
      function: |demo::relation::joinmilestoning::ProcessingProduct.all(%latest)->filter(x | $x.market == 'Old Market')->project(~[name: x | $x.name]);
      tests:
      [
        ignoresListingsThatAreNoLongerCurrent:
        {
          data:
