###Pure
Class demo::relation::domain::EmployeeLabels
{
  id: Integer[1];
  surnames: String[1..*];
  initials: String[1..*];
  statuses: String[1..*];
  hireDays: StrictDate[1..*];
}

function demo::relation::func::employees(): meta::pure::metamodel::relation::Relation<Any>[1]
{
  #>{demo::relation::db::EmployeeDB.EmployeeTable}#
}

###Mapping
Mapping demo::relation::mapping::EmployeeToManyExpressionMapping
(
  *demo::relation::domain::EmployeeLabels: Relation
  {
    ~func demo::relation::func::employees():Relation<Any>[1]
    id: ID,
    surnames: $row.LAST_NAME->cast(@String),
    initials: $row.FIRST_NAME->substring(0, 1),
    statuses: if($row.ACTIVE == 1, |'active', |'inactive'),
    hireDays: $row.HIRE_DATE->datePart()->cast(@StrictDate)
  }

  testSuites:
  [
    toManyGraphFetchSuite:
    {
      function: |demo::relation::domain::EmployeeLabels.all()
                  ->graphFetch(#{demo::relation::domain::EmployeeLabels{id, surnames, initials, statuses, hireDays}}#)
                  ->serialize(#{demo::relation::domain::EmployeeLabels{id, surnames, initials, statuses, hireDays}}#);
      tests:
      [
        allEmployees:
        {
          data:
          [
            demo::relation::db::EmployeeDB:
              Reference
              #{
                demo::relation::data::EmployeeData
              }#
          ];
          asserts:
          [
            shouldFetchOneElementPerExpression:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":1,"surnames":["Green"],"initials":["A"],"statuses":["active"],"hireDays":["2020-01-15"]},{"id":2,"surnames":["Smith"],"initials":["B"],"statuses":["active"],"hireDays":["2021-06-01"]},{"id":3,"surnames":["White"],"initials":["C"],"statuses":["inactive"],"hireDays":["2019-03-10"]}]';
                  }#;
              }#
          ];
        }
      ];
    },
    toManyProjectSuite:
    {
      function: |demo::relation::domain::EmployeeLabels.all()
                  ->sortBy(x | $x.id)
                  ->project(
                    [x | $x.id, x | $x.surnames, x | $x.initials, x | $x.statuses, x | $x.hireDays],
                    ['Id', 'Surname', 'Initial', 'Status', 'Hire Day']
                  );
      tests:
      [
        allEmployees:
        {
          data:
          [
            demo::relation::db::EmployeeDB:
              Reference
              #{
                demo::relation::data::EmployeeData
              }#
          ];
          asserts:
          [
            shouldProjectOneRowPerEmployee:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Id":1,"Surname":"Green","Initial":"A","Status":"active","Hire Day":"2020-01-15"},{"Id":2,"Surname":"Smith","Initial":"B","Status":"active","Hire Day":"2021-06-01"},{"Id":3,"Surname":"White","Initial":"C","Status":"inactive","Hire Day":"2019-03-10"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
