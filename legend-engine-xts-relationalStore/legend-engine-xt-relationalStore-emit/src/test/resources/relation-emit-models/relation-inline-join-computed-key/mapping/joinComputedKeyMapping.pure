function demo::relation::joincomputedkey::func::ordinalFirmRel(): meta::pure::metamodel::relation::Relation<(ID:Integer[1], NAME:String[1], COUNTRY_ORDINAL:Integer[0..1])>[1]
{
  #>{demo::relation::joincomputedkey::db::JoinComputedKeyDB.ORD_FIRM}#
