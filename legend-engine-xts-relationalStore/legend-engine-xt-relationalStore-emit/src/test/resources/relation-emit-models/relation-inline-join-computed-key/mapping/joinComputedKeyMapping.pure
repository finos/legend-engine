###Pure
Class demo::relation::joincomputedkey::Person
{
  id: Integer[1];
  firmName: String[0..1];
  firmCountryName: String[0..1];
  knownFirmId: Integer[0..1];
  firmHomeCountryName: String[0..1];
}

function demo::relation::joincomputedkey::func::personRel(): meta::pure::metamodel::relation::Relation<Any>[1]
{
  #>{demo::relation::joincomputedkey::db::JoinComputedKeyDB.PERSON}#
    ->extend(~FIRM_KEY: p | if($p.FIRM_ID->isEmpty(), | $p.OLD_FIRM_ID, | $p.FIRM_ID))
    ->select(~[ID, FIRM_KEY])
    ->distinct()
}

Class demo::relation::joincomputedkey::Employee
{
  id: Integer[1];
  firmKey: Integer[0..1];
  firmName: String[0..1];
  firmCountryName: String[0..1];
  knownFirmId: Integer[0..1];
  firm: demo::relation::joincomputedkey::Firm[0..1];
}

Class demo::relation::joincomputedkey::Firm
{
  id: Integer[1];
  name: String[1];
}

function demo::relation::joincomputedkey::func::employeeRel(): meta::pure::metamodel::relation::Relation<Any>[1]
{
  #>{demo::relation::joincomputedkey::db::JoinComputedKeyDB.PERSON}#
    ->extend(~firmKey: p | if($p.FIRM_ID->isEmpty(), | $p.OLD_FIRM_ID, | $p.FIRM_ID))
    ->select(~[ID, firmKey])
    ->distinct()
}

function demo::relation::joincomputedkey::func::firmRel(): meta::pure::metamodel::relation::Relation<(ID:Integer[1], NAME:String[1], COUNTRY_ID:Integer[0..1], HQ_COUNTRY_ID:Integer[0..1])>[1]
{
  #>{demo::relation::joincomputedkey::db::JoinComputedKeyDB.FIRM}#
}

function demo::relation::joincomputedkey::func::countryRel(): meta::pure::metamodel::relation::Relation<(ID:Integer[1], NAME:String[1])>[1]
{
  #>{demo::relation::joincomputedkey::db::JoinComputedKeyDB.COUNTRY}#
}

