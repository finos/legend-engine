###Service
// The binary columns read from the table itself. The query returns a Relation,
// but unlike a query that reaches a Relation through a mapping with
// project(~[...]), reading the table directly and naming the runtime with
// from() here does not get routed to DuckDB; its test suite runs on H2.
Service demo::relation::binary::service::BinaryRowsDirect
{
  pattern: '/api/relation/binary/direct';
  documentation: 'Binary columns read from the table directly through a relation accessor.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |#>{demo::relation::binary::store::BinaryDB.T}#->select(~[ID, PAYLOAD, VPAYLOAD])->sort(ascending(~ID))->from(demo::relation::binary::runtime::BinaryRuntime);
  }
  testSuites:
  [
    binarySuite:
    {
      data:
      [
        connections:
        [
          h2:
            Reference
            #{
              demo::relation::binary::data::BinaryData
            }#
        ]
      ]
      tests:
      [
        readsHex:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            shouldReturnBinaryAsHex:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"ID":1,"PAYLOAD":"0a0b0000000000000000000000000000","VPAYLOAD":"deadbeef"},{"ID":2,"PAYLOAD":"cafebabe000000000000000000000000","VPAYLOAD":"0102030405"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
