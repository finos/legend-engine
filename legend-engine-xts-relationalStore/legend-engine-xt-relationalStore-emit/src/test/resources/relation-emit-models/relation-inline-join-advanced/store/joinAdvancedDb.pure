###Relational
Database demo::relation::joinadvanced::db::JoinAdvancedDB
(
  Table PersonTable
  (
    ID         INTEGER PRIMARY KEY,
    NAME       VARCHAR(100) NOT NULL,
    FIRM_ID    INTEGER,
    MANAGER_ID INTEGER
  )
  Table FirmTable
  (
    ID         INTEGER PRIMARY KEY,
    LEGAL_NAME VARCHAR(100) NOT NULL,
    ADDRESS_ID INTEGER
  )
  Table AddressTable
  (
    ID   INTEGER PRIMARY KEY,
    CITY VARCHAR(100) NOT NULL
  )
  Table TemporalPersonTable
  (
    milestoning
    (
      business(BUS_FROM = FROM_Z, BUS_THRU = THRU_Z)
    )
    ID      INTEGER PRIMARY KEY,
    NAME    VARCHAR(100) NOT NULL,
    FIRM_ID INTEGER,
    FROM_Z  DATE NOT NULL,
    THRU_Z  DATE NOT NULL
  )
  Table AccountTable
  (
    ID           INTEGER PRIMARY KEY,
    PERSON_ID    INTEGER NOT NULL,
    ACCOUNT_NAME VARCHAR(100) NOT NULL
  )
)
