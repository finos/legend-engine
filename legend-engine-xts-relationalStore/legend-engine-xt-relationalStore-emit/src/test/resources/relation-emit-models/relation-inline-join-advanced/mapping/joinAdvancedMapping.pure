###Pure
Class demo::relation::joinadvanced::Firm
{
  legalName: String[1];
  employees: demo::relation::joinadvanced::Person[*];
}

Class demo::relation::joinadvanced::Employment
{
  firmId: Integer[0..1];
  firmName: String[0..1];
  firm: demo::relation::joinadvanced::Firm[0..1];
}

Class demo::relation::joinadvanced::Person
{
  name: String[1];
  firm: demo::relation::joinadvanced::Firm[1];
  manager: demo::relation::joinadvanced::Person[0..1];
  temporalRecord: demo::relation::joinadvanced::TemporalPerson[0..1];
  employment: demo::relation::joinadvanced::Employment[1];
  firmName: String[1];
  firmCity: String[1];
  managerName: String[1];
  managerNameIfFirmExists: String[1];
  accountNames: String[*];
  firmNamesViaHelper: String[*];
  firmsViaHelper: demo::relation::joinadvanced::Firm[*];
  firmNameViaThis: String[1];
  firmNameUpper() {$this.firmName->toUpper()}: String[1];
  firmNameViaThisUpper() {$this.firmNameViaThis->toUpper()}: String[1];
}

Class <<temporal.businesstemporal>> demo::relation::joinadvanced::TemporalPerson
{
  name: String[1];
  firm: demo::relation::joinadvanced::Firm[0..1];
  firmName: String[0..1];
}

function demo::relation::joinadvanced::func::personRel(): meta::pure::metamodel::relation::Relation<(ID:Integer[1], NAME:String[1], FIRM_ID:Integer[0..1], MANAGER_ID:Integer[0..1])>[1]
{
  #>{demo::relation::joinadvanced::db::JoinAdvancedDB.PersonTable}#
}

function demo::relation::joinadvanced::func::firmRel(): meta::pure::metamodel::relation::Relation<(ID:Integer[1], LEGAL_NAME:String[1], ADDRESS_ID:Integer[0..1])>[1]
{
  #>{demo::relation::joinadvanced::db::JoinAdvancedDB.FirmTable}#
}

function demo::relation::joinadvanced::func::addressRel(): meta::pure::metamodel::relation::Relation<(ID:Integer[1], CITY:String[1])>[1]
{
  #>{demo::relation::joinadvanced::db::JoinAdvancedDB.AddressTable}#
}

function demo::relation::joinadvanced::func::accountRel(): meta::pure::metamodel::relation::Relation<(ID:Integer[1], PERSON_ID:Integer[1], ACCOUNT_NAME:String[1])>[1]
{
  #>{demo::relation::joinadvanced::db::JoinAdvancedDB.AccountTable}#
}

function demo::relation::joinadvanced::func::sameFirm(p: Integer[1], f: Integer[0..1]): Boolean[1]
{
  $p == $f
}

function demo::relation::joinadvanced::func::temporalPersonRel(): meta::pure::metamodel::relation::Relation<(ID:Integer[1], NAME:String[1], FIRM_ID:Integer[0..1], FROM_Z:StrictDate[1], THRU_Z:StrictDate[1])>[1]
{
  #>{demo::relation::joinadvanced::db::JoinAdvancedDB.TemporalPersonTable}#
}

###Mapping
import demo::relation::joinadvanced::func::*;

Mapping demo::relation::joinadvanced::mapping::JoinAdvancedMapping
(
  *demo::relation::joinadvanced::Person[person]: Relation
  {
    ~src demo::relation::joinadvanced::func::personRel()
    name: NAME,
    +personId: Integer[1]: ID,
    +firmId: Integer[0..1]: FIRM_ID,
    +managerId: Integer[0..1]: MANAGER_ID,
    firm: modelJoin({p, f | $p.firmId == $f.id}),
    firmName: $src->navigationJoin(firmRel(), {p, f | $p.FIRM_ID == $f.ID}).LEGAL_NAME,
    firmCity: $src->navigationJoin(firmRel(), {p, f | $p.FIRM_ID == $f.ID})->navigationJoin(addressRel(), {f, a | $f.ADDRESS_ID == $a.ID}).CITY,
    managerName: $src->navigationJoin(personRel(), {p, m | $p.MANAGER_ID == $m.ID}).NAME,
    managerNameIfFirmExists: $src->filterJoin(firmRel(), {p, f | $p.FIRM_ID == $f.ID})->navigationJoin(personRel(), {p, m | $p.MANAGER_ID == $m.ID}).NAME,
    manager: modelJoin({p, m | $p.managerId == $m.personId}),
    temporalRecord: modelJoin({p, t | $p.personId == $t.id}),
    accountNames: $src->navigationJoin(accountRel(), {p, a | $p.ID == $a.PERSON_ID}).ACCOUNT_NAME,
    firmNamesViaHelper: $src->navigationJoin(firmRel(), {p, f | sameFirm($f.ID, $p.FIRM_ID)}).LEGAL_NAME,
    firmsViaHelper: modelJoin({p, f | sameFirm($f.id, $p.firmId)}),
    firmNameViaThis: $src->navigationJoin(firmRel(), {this, that | $this.FIRM_ID == $that.ID}).LEGAL_NAME,
    employment
    (
      firmId: FIRM_ID,
      firmName: $src->navigationJoin(firmRel(), {p, f | $p.FIRM_ID == $f.ID}).LEGAL_NAME,
      firm: modelJoin({e, f | $e.firmId == $f.id})
    )
  }

  *demo::relation::joinadvanced::Firm[firm]: Relation
  {
    ~src demo::relation::joinadvanced::func::firmRel()
    legalName: LEGAL_NAME,
    +id: Integer[1]: ID,
    // Deliberately a second, independent inline modelJoin (not a shared declaration with
    // Person.firm above) to exercise the per-property construct in both directions; a real
    // bidirectional association would more naturally use the classic Association-level ModelJoin.
    employees: modelJoin({f, p | $f.id == $p.firmId})
  }

  *demo::relation::joinadvanced::TemporalPerson[temporalPerson]: Relation
  {
    ~src demo::relation::joinadvanced::func::temporalPersonRel()
    name: NAME,
    +id: Integer[1]: ID,
    +firmId: Integer[0..1]: FIRM_ID,
    firmName: $src->navigationJoin(firmRel(), {p, f | $p.FIRM_ID == $f.ID}).LEGAL_NAME,
    firm: modelJoin({p, f | $p.firmId == $f.id})
  }

  testSuites:
  [
    navigationJoinSuite:
    {
      function: |demo::relation::joinadvanced::Person.all()->project(~[name: x | $x.name, firm: x | $x.firmName])->sort([~name->ascending()]);
      tests:
      [
        pullsFirmName:
        {
          data:
          [
            demo::relation::joinadvanced::db::JoinAdvancedDB:
              Reference
              #{
                demo::relation::joinadvanced::data::JoinAdvancedData
              }#
          ];
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"name":"Alice","firm":"Acme"},{"name":"Bob","firm":"Beta"},{"name":"Carol","firm":"Acme"},{"name":"Dave","firm":null}]';
                  }#;
              }#
          ];
        }
      ];
    },
    chainedNavigationJoinSuite:
    {
      function: |demo::relation::joinadvanced::Person.all()->project(~[name: x | $x.name, city: x | $x.firmCity])->sort([~name->ascending()]);
      tests:
      [
        pullsFirmCityThroughTwoHops:
        {
          data:
          [
            demo::relation::joinadvanced::db::JoinAdvancedDB:
              Reference
              #{
                demo::relation::joinadvanced::data::JoinAdvancedData
              }#
          ];
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"name":"Alice","city":"London"},{"name":"Bob","city":null},{"name":"Carol","city":"London"},{"name":"Dave","city":null}]';
                  }#;
              }#
          ];
        }
      ];
    },
    filterThenNavigationJoinSuite:
    {
      function: |demo::relation::joinadvanced::Person.all()->project(~[name: x | $x.name, manager: x | $x.managerNameIfFirmExists])->sort([~name->ascending()]);
      tests:
      [
        pullsManagerOfPeopleWithAFirm:
        {
          data:
          [
            demo::relation::joinadvanced::db::JoinAdvancedDB:
              Reference
              #{
