###Pure
function demo::relation::joinadvanced::func::lowIdPersonRel(): meta::pure::metamodel::relation::Relation<(ID:Integer[1], NAME:String[1], FIRM_ID:Integer[0..1], MANAGER_ID:Integer[0..1])>[1]
{
  #>{demo::relation::joinadvanced::db::JoinAdvancedDB.PersonTable}#->filter(r | $r.ID <= 2)
}

function demo::relation::joinadvanced::func::highIdPersonRel(): meta::pure::metamodel::relation::Relation<(ID:Integer[1], NAME:String[1], FIRM_ID:Integer[0..1], MANAGER_ID:Integer[0..1])>[1]
{
  #>{demo::relation::joinadvanced::db::JoinAdvancedDB.PersonTable}#->filter(r | $r.ID > 2)
}

###Mapping
import demo::relation::joinadvanced::func::*;

Mapping demo::relation::joinadvanced::mapping::JoinAdvancedUnionMapping
(
  *demo::relation::joinadvanced::Person: Operation
  {
    meta::pure::router::operations::union_OperationSetImplementation_1__SetImplementation_MANY_(lowId, highId)
  }

  demo::relation::joinadvanced::Person[lowId]: Relation
  {
    ~src demo::relation::joinadvanced::func::lowIdPersonRel()
    name: NAME,
    firmName: $src->navigationJoin(firmRel(), {p, f | $p.FIRM_ID == $f.ID}).LEGAL_NAME,
    managerNameIfFirmExists: $src->filterJoin(firmRel(), {p, f | $p.FIRM_ID == $f.ID})->navigationJoin(personRel(), {p, m | $p.MANAGER_ID == $m.ID}).NAME
  }

  demo::relation::joinadvanced::Person[highId]: Relation
  {
    ~src demo::relation::joinadvanced::func::highIdPersonRel()
    name: NAME,
    firmName: $src->navigationJoin(firmRel(), {p, f | $p.FIRM_ID == $f.ID}).LEGAL_NAME,
    managerNameIfFirmExists: $src->filterJoin(firmRel(), {p, f | $p.FIRM_ID == $f.ID})->navigationJoin(personRel(), {p, m | $p.MANAGER_ID == $m.ID}).NAME
  }

  testSuites:
  [
    unionNavigationJoinSuite:
    {
      function: |demo::relation::joinadvanced::Person.all()->project(~[name: x | $x.name, firm: x | $x.firmName])->sort([~name->ascending()]);
      tests:
      [
        pullsFirmNameAcrossUnionBranches:
        {
          data:
          [
            demo::relation::joinadvanced::db::JoinAdvancedDB:
              Reference
              #{
                demo::relation::joinadvanced::data::JoinAdvancedData
              }#
          ];
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"name":"Alice","firm":"Acme"},{"name":"Bob","firm":"Beta"},{"name":"Carol","firm":"Acme"},{"name":"Dave","firm":null}]';
                  }#;
              }#
          ];
        }
      ];
    },
    unionKeyedJoinSuite:
    {
      function: |demo::relation::joinadvanced::Person.all()->project(~[name: x | $x.name, manager: x | $x.managerNameIfFirmExists])->sort([~name->ascending()]);
      tests:
      [
        pullsManagerOfPeopleWithAFirmAcrossUnionBranches:
        {
          data:
          [
            demo::relation::joinadvanced::db::JoinAdvancedDB:
              Reference
              #{
                demo::relation::joinadvanced::data::JoinAdvancedData
              }#
          ];
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"name":"Alice","manager":null},{"name":"Bob","manager":"Alice"},{"name":"Carol","manager":"Bob"},{"name":"Dave","manager":null}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
