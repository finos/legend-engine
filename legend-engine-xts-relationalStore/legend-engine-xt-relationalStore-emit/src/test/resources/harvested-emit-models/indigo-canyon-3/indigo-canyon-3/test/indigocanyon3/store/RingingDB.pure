###Relational
Database test::indigocanyon3::store::RingingDB
(
  Schema wetland
  (
    Table ringing_record
    (
      record_code VARCHAR(24) PRIMARY KEY,
      station_name VARCHAR(48) NOT NULL,
      scheme_code VARCHAR(24) NOT NULL,
      species_group VARCHAR(48) NOT NULL,
      ringed_on DATE NOT NULL,
      brood_size INTEGER NOT NULL,
      condition_note VARCHAR(48) NOT NULL
    )
  )
)
