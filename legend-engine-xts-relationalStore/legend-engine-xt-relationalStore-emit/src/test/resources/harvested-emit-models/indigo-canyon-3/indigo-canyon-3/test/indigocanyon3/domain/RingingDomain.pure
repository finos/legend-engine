###Pure
import test::indigocanyon3::domain::*;

Class {meta::pure::profiles::doc.doc = 'One wetland bird-ringing record captured by a ringing station on a single visit.'} test::indigocanyon3::domain::RingingRecord
{
  recordCode: String[1];
  stationName: String[1];
  schemeCode: String[1];
  speciesGroup: String[1];
  ringedOn: StrictDate[1];
  broodSize: Integer[1];
  registerLabel: String[1];
  conditionNote: String[1];
  rosterLabel() {$this.stationName + '/' + $this.schemeCode}: String[1];
  largeBrood() {$this.broodSize >= 4}: Boolean[1];
}
