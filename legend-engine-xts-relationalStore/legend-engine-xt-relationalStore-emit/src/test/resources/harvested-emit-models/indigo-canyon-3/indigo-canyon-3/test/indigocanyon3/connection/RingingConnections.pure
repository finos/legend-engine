###Connection
RelationalDatabaseConnection test::indigocanyon3::connection::RingingH2Connection
{
  store: test::indigocanyon3::store::RingingDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists wetland;',
      'create schema wetland;',
      'create table wetland.ringing_record (record_code varchar(24) primary key, station_name varchar(48) not null, scheme_code varchar(24) not null, species_group varchar(48) not null, ringed_on date not null, brood_size integer not null, condition_note varchar(48) not null);'
      ];
  };
  auth: DefaultH2;
}
