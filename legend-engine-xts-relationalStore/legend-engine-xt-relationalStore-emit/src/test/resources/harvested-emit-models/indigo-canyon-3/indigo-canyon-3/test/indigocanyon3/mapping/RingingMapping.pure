    stationName: toUpper([test::indigocanyon3::store::RingingDB]wetland.ringing_record.station_name),
    schemeCode: toUpper([test::indigocanyon3::store::RingingDB]wetland.ringing_record.scheme_code),
    speciesGroup: toUpper([test::indigocanyon3::store::RingingDB]wetland.ringing_record.species_group),
    ringedOn: [test::indigocanyon3::store::RingingDB]wetland.ringing_record.ringed_on,
    broodSize: [test::indigocanyon3::store::RingingDB]wetland.ringing_record.brood_size,
    registerLabel: 'WETLAND-RINGING-V1',
    conditionNote: toUpper([test::indigocanyon3::store::RingingDB]wetland.ringing_record.condition_note)
  }
)
