###Pure
import test::russetarboretum::domain::*;

Enum {meta::pure::profiles::doc.doc = 'Lifecycle stage of a living collection specimen.'} test::russetarboretum::domain::LifecycleStage
{
  Planted,
  Established,
  Retired
}

Enum {meta::pure::profiles::doc.doc = 'Habitat class assigned to a planting bed.'} test::russetarboretum::domain::HabitatClass
{
  Woodland,
  Meadow,
  Wetland
}

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'A collection site whose naming and region assignment are tracked on a business timeline.'} test::russetarboretum::domain::CollectionSite
{
  siteName: String[1];
  regionCode: String[1];
}

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'A planting bed on a collection site, valid over a business interval.'} test::russetarboretum::domain::PlantingBed
{
  bedCode: String[1];
  habitat: HabitatClass[1];
  site: CollectionSite[1];
}

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'An accessioned specimen, its bed placement and the specimen it was propagated from.'} test::russetarboretum::domain::Specimen
{
  accessionCode: String[1];
  speciesName: String[1];
  stage: LifecycleStage[1];
  plantingYear: Integer[1];
  bed: PlantingBed[0..1];
  propagatedFrom: Specimen[0..1];
}

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'A care operation recorded against a specimen.'} test::russetarboretum::domain::CareEvent
{
  eventCode: String[1];
  performedOn: StrictDate[1];
  specimen: Specimen[1];
}

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'A pruning care operation carrying the crown reduction it applied.'} test::russetarboretum::domain::PruningEvent extends CareEvent
{
  crownReductionPct: Integer[1];
}

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'A survey care operation carrying the measured specimen height.'} test::russetarboretum::domain::SurveyEvent extends CareEvent
{
  heightCm: Integer[1];
}
