###Mapping
Mapping test::gildedbeacon7::mapping::BeaconMapping
(
  *test::gildedbeacon7::domain::BeaconStation: Relational
  {
    ~primaryKey
    (
      [test::gildedbeacon7::store::BeaconDatabase]beacon_watch.beacon_station.station_id
    )
    ~mainTable [test::gildedbeacon7::store::BeaconDatabase]beacon_watch.beacon_station
    stationCode: [test::gildedbeacon7::store::BeaconDatabase]beacon_watch.beacon_station.station_code,
    keeperName: [test::gildedbeacon7::store::BeaconDatabase]beacon_watch.beacon_station.keeper_name,
    lampTier: EnumerationMapping LampTierMapping: [test::gildedbeacon7::store::BeaconDatabase]beacon_watch.beacon_station.lamp_tier,
    lensGrade: [test::gildedbeacon7::store::BeaconDatabase]beacon_watch.beacon_station.lens_grade,
    watchHours: [test::gildedbeacon7::store::BeaconDatabase]beacon_watch.beacon_station.watch_hours,
    luxReading: [test::gildedbeacon7::store::BeaconDatabase]beacon_watch.beacon_station.lux_reading,
    inspectedOn: [test::gildedbeacon7::store::BeaconDatabase]beacon_watch.beacon_station.inspected_on,
    district: [test::gildedbeacon7::store::BeaconDatabase]@Station_District
  }

  *test::gildedbeacon7::domain::BeaconDistrict: Relational
  {
    ~primaryKey
    (
      [test::gildedbeacon7::store::BeaconDatabase]beacon_watch.beacon_district.district_id
    )
    ~mainTable [test::gildedbeacon7::store::BeaconDatabase]beacon_watch.beacon_district
    districtCode: [test::gildedbeacon7::store::BeaconDatabase]beacon_watch.beacon_district.district_code,
    districtName: [test::gildedbeacon7::store::BeaconDatabase]beacon_watch.beacon_district.district_name,
    shoreLine: [test::gildedbeacon7::store::BeaconDatabase]beacon_watch.beacon_district.shore_line
  }

  test::gildedbeacon7::domain::LampTier: EnumerationMapping LampTierMapping
  {
    HALOGEN: ['HAL'],
    LED: ['LED'],
    VAPOUR: ['VAP']
  }
)
