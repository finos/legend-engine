###Connection
RelationalDatabaseConnection test::gildedbeacon7::connection::BeaconH2Connection
{
  store: test::gildedbeacon7::store::BeaconDatabase;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists beacon_watch;',
      'create schema beacon_watch;',
      'create table beacon_watch.beacon_station (station_id integer not null, station_code varchar(24) not null, keeper_name varchar(80) not null, lamp_tier varchar(16) not null, lens_grade varchar(24), watch_hours integer not null, lux_reading double not null, inspected_on date not null, district_id integer, from_z date, thru_z date);',
      'create table beacon_watch.beacon_district (district_id integer primary key, district_code varchar(16) not null, district_name varchar(80) not null, shore_line varchar(48));'
      ];
  };
  auth: DefaultH2;
}
