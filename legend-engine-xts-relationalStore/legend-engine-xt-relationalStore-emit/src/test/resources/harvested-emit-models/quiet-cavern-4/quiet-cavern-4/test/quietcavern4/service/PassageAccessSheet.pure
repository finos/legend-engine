###Service
Service test::quietcavern4::service::PassageAccessSheet
{
  pattern: '/quietcavern4/passage-access/{processingDate}';
  title: 'Cave Passage Access Sheet';
  ownership: DID { identifier: '000000' };
  documentation: 'Lists the requested passages as recorded at a processing date, with their chamber, bolt markers, whether a seasonal or crawl rule seals them, whether they are flagged or gated, and the approach trail or chamber used to reach them.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: {processingDate: StrictDate[1], passageCodes: String[*]|test::quietcavern4::domain::Passage.all($processingDate)->filter(p|$p.passageCode->in($passageCodes))->project(
      [
        p|$p.passageCode,
        p|$p.lengthMetres,
        p|$p.chamber.chamberLabel,
        p|$p.markers->filter(m|$m.markerKind == 'BOLT').markerCode,
        p|($p->subType(@test::quietcavern4::domain::FloodedPassage).floodRule.level == test::quietcavern4::domain::AccessLevel.SEALED) || ($p->subType(@test::quietcavern4::domain::CrawlPassage).crawlRule.level == test::quietcavern4::domain::AccessLevel.SEALED),
        p|if($p.markers->filter(m|$m.markerKind == 'FLAG')->isEmpty(), |false, |true),
        p|if($p->subType(@test::quietcavern4::domain::FloodedPassage).floodRule.gate->isEmpty() && $p->subType(@test::quietcavern4::domain::CrawlPassage).crawlRule.gate->isEmpty(), |false, |true),
        p|if($p.entrance.approach->isEmpty(), |$p.chamber.chamberLabel, |$p.entrance.approach.trailLabel->toOne())
      ],
      [
        'Passage',
        'LengthMetres',
        'Chamber',
        'BoltMarker',
        'Sealed',
        'Flagged',
        'Gated',
        'ReachedVia'
      ]
    )->distinct()};
    mapping: test::quietcavern4::mapping::CavernSurveyMapping;
    runtime: test::quietcavern4::runtime::CavernSurveyRuntime;
  }
  testSuites:
  [
    passageAccessSuite:
    {
      data:
      [
        connections:
        [
          cavernSurveyConnection:
            Relational
            #{
              survey.passage:
                'passage_code,kind_code,length_m,chamber_code,entrance_code,rule_code,in_z,out_z\n'+
                'PS-01,FLOODED,140,CH-1,EN-1,RL-1,2026-01-01,9999-12-31\n'+
                'PS-02,CRAWL,35,CH-1,EN-2,RL-2,2026-01-01,9999-12-31\n'+
                'PS-03,DRY,220,CH-2,,,2026-01-01,9999-12-31\n'+
                'PS-04,FLOODED,90,CH-2,EN-1,RL-1,2025-01-01,2026-02-01\n'+
                'PS-04,FLOODED,95,CH-2,EN-1,RL-3,2026-02-01,9999-12-31\n'+
                'PS-05,CRAWL,20,CH-1,EN-1,RL-4,2026-01-01,9999-12-31\n';

              survey.marker:
                'marker_code,passage_code,marker_kind\n'+
                'MK-1,PS-01,BOLT\n'+
                'MK-2,PS-01,FLAG\n'+
                'MK-3,PS-02,BOLT\n'+
                'MK-4,PS-04,BOLT\n'+
                'MK-5,PS-05,FLAG\n';

              survey.chamber:
                'chamber_code,chamber_label\n'+
                'CH-1,Upper Gallery\n'+
                'CH-2,Lower Gallery\n';

              survey.entrance:
                'entrance_code,entrance_label,trail_code\n'+
                'EN-1,Fern Shaft,TR-1\n'+
                'EN-2,Moss Slot,\n';

              survey.approach_trail:
                'trail_code,trail_label\n'+
                'TR-1,Fern Path\n';

              survey.access_rule:
                'rule_code,access_level,gate_code\n'+
                'RL-1,SEALED,GT-1\n'+
                'RL-2,GUIDED,\n'+
                'RL-3,OPEN,\n'+
                'RL-4,SEALED,GT-2\n';

              survey.gate:
                'gate_code,key_holder\n'+
                'GT-1,Caving Club Warden\n'+
                'GT-2,Rescue Team Store\n';

              survey.survey_visit:
                'visit_code,passage_code,team_code,in_z,out_z,from_z,thru_z\n'+
                'VS-1,PS-01,TM-A,2026-01-01,9999-12-31,2026-05-01,2026-06-01\n'+
                'VS-2,PS-01,TM-A,2026-01-01,9999-12-31,2026-05-10,2026-05-20\n'+
                'VS-3,PS-02,TM-B,2026-01-01,2026-03-01,2026-05-01,9999-12-31\n'+
                'VS-3,PS-02,TM-C,2026-03-01,9999-12-31,2026-05-01,9999-12-31\n'+
                'VS-4,PS-04,TM-A,2026-01-01,9999-12-31,2026-06-01,9999-12-31\n';

              survey.survey_team:
                'team_code,team_label\n'+
                'TM-A,Lamp Crew\n'+
                'TM-B,Rope Crew\n'+
                'TM-C,Sump Crew\n';

              survey.team_member:
                'member_code,team_code\n'+
                'MB-1,TM-A\n'+
                'MB-2,TM-A\n'+
                'MB-3,TM-B\n'+
                'MB-4,TM-C\n';
            }#
        ]
      ]
      tests:
      [
        supersededPassageVersionIsOutOfRange:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            processingDate = %2026-06-01,
            passageCodes = ['PS-01', 'PS-02', 'PS-03', 'PS-04']
          ]
          asserts:
          [
            currentVersionsOnly:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Passage":"PS-01","LengthMetres":140,"Chamber":"Upper Gallery","BoltMarker":"MK-1","Sealed":true,"Flagged":true,"Gated":true,"ReachedVia":"Fern Path"},{"Passage":"PS-02","LengthMetres":35,"Chamber":"Upper Gallery","BoltMarker":"MK-3","Sealed":false,"Flagged":false,"Gated":false,"ReachedVia":"Upper Gallery"},{"Passage":"PS-03","LengthMetres":220,"Chamber":"Lower Gallery","BoltMarker":null,"Sealed":null,"Flagged":false,"Gated":false,"ReachedVia":"Lower Gallery"},{"Passage":"PS-04","LengthMetres":95,"Chamber":"Lower Gallery","BoltMarker":"MK-4","Sealed":false,"Flagged":false,"Gated":false,"ReachedVia":"Fern Path"}]';
                  }#;
              }#
          ]
        },
        unrequestedPassageIsDropped:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            processingDate = %2026-06-01,
            passageCodes = ['PS-09']
          ]
          asserts:
          [
            noRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
