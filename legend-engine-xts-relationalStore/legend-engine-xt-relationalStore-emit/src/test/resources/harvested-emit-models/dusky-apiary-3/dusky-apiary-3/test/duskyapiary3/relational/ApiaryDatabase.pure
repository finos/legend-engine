###Relational
Database test::duskyapiary3::relational::ApiaryDB
(
  Schema apiary
  (
    Table hive
    (
      hive_id INTEGER PRIMARY KEY,
      hive_code VARCHAR(24) NOT NULL,
      hive_name VARCHAR(80),
      yard_id INTEGER NOT NULL,
      yard_code VARCHAR(24) NOT NULL,
      population INTEGER NOT NULL,
      status_code VARCHAR(16) NOT NULL
    )

    Table yard
    (
      yard_id INTEGER PRIMARY KEY,
      yard_code VARCHAR(24) NOT NULL,
      yard_name VARCHAR(80) NOT NULL,
      plot_id INTEGER NOT NULL
    )

    Table forage_plot
    (
      plot_id INTEGER PRIMARY KEY,
      plot_code VARCHAR(24) NOT NULL,
      plot_name VARCHAR(80) NOT NULL,
      bloom_note VARCHAR(120) NOT NULL
    )

    Table inspection
    (
      inspection_id INTEGER PRIMARY KEY,
      hive_id INTEGER NOT NULL,
      inspector_name VARCHAR(80) NOT NULL,
      inspection_note VARCHAR(160) NOT NULL
    )
  )

  Join Hive_Yard(apiary.hive.yard_id = apiary.yard.yard_id)
  Join Yard_Forage(apiary.yard.plot_id = apiary.forage_plot.plot_id)
  Join Hive_Inspection(apiary.hive.hive_id = apiary.inspection.hive_id)
)
