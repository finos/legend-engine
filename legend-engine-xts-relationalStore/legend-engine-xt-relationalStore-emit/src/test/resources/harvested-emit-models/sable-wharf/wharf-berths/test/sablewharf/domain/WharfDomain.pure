import demo::sablewharf::domain::*;

Enum demo::sablewharf::domain::HandlingClass
{
  CHILLED,
  AMBIENT,
  HAZARDOUS
}

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'A vessel allocated to a wharf berth over a business-effective window.'} demo::sablewharf::domain::BerthAssignment
{
  assignmentRef: String[1];
  berthCode: String[1];
  plan: StowagePlan[0..1];
}

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'The stowage plan in force for a berth assignment on a given business date.'} demo::sablewharf::domain::StowagePlan
{
  planRef: String[1];
  specification: LotSpecification[0..1];
  stowageLines: StowageLine[*];
}

Class demo::sablewharf::domain::LotSpecification
{
  specRef: String[1];
}

Class demo::sablewharf::domain::ChilledLotSpecification extends LotSpecification
{
  setPointCelsius: Float[1];
}

Class demo::sablewharf::domain::StowageLine
{
  lineRef: String[1];
  handlingClass: HandlingClass[1];
  grossKilos: Float[1];
  unit: CargoUnit[0..1];
  spareUnit: CargoUnit[0..1];
}

Class demo::sablewharf::domain::CargoUnit
{
  unitRef: String[1];
}

Class demo::sablewharf::domain::ReeferCargoUnit extends CargoUnit
{
  plugSlots: Integer[1];
}

Class demo::sablewharf::domain::FlatRackCargoUnit extends CargoUnit
{
  deckLength: Float[1];
}
