###Relational
Database demo::sablewharf::store::WharfDatabase
(
  Schema HARBOUR
  (
    Table BERTH_ASSIGNMENT
    (
      milestoning
      (
        business(BUS_FROM = FROM_Z, BUS_THRU = THRU_Z)
      )
      ASSIGNMENT_REF VARCHAR(24) PRIMARY KEY,
      BERTH_CODE VARCHAR(24) NOT NULL,
      PLAN_REF VARCHAR(24),
      FROM_Z DATE PRIMARY KEY,
      THRU_Z DATE
    )
    Table STOWAGE_PLAN
    (
      milestoning
      (
        business(BUS_FROM = FROM_Z, BUS_THRU = THRU_Z)
      )
      PLAN_REF VARCHAR(24) PRIMARY KEY,
      SPEC_REF VARCHAR(24),
      FROM_Z DATE PRIMARY KEY,
      THRU_Z DATE
    )
    Table LOT_SPEC
    (
      SPEC_REF VARCHAR(24) PRIMARY KEY,
      SPEC_KIND VARCHAR(16) NOT NULL,
      SET_POINT_CELSIUS DOUBLE
    )
    Table STOWAGE_LINE
    (
      LINE_REF VARCHAR(24) PRIMARY KEY,
      PLAN_REF VARCHAR(24) NOT NULL,
      HANDLING_CLASS VARCHAR(16) NOT NULL,
      GROSS_KILOS DOUBLE NOT NULL,
      UNIT_REF VARCHAR(24),
      SPARE_UNIT_REF VARCHAR(24)
    )
    Table CARGO_UNIT
    (
      UNIT_REF VARCHAR(24) PRIMARY KEY,
      UNIT_KIND VARCHAR(16) NOT NULL,
      PLUG_SLOTS INTEGER,
      DECK_LENGTH DOUBLE
    )
  )

  Join BerthAssignment_StowagePlan(HARBOUR.BERTH_ASSIGNMENT.PLAN_REF = HARBOUR.STOWAGE_PLAN.PLAN_REF)
  Join StowagePlan_LotSpec(HARBOUR.STOWAGE_PLAN.SPEC_REF = HARBOUR.LOT_SPEC.SPEC_REF)
  Join StowagePlan_StowageLine(HARBOUR.STOWAGE_PLAN.PLAN_REF = HARBOUR.STOWAGE_LINE.PLAN_REF)
  Join StowageLine_CargoUnit(HARBOUR.STOWAGE_LINE.UNIT_REF = HARBOUR.CARGO_UNIT.UNIT_REF)
  Join StowageLine_SpareCargoUnit(HARBOUR.STOWAGE_LINE.SPARE_UNIT_REF = HARBOUR.CARGO_UNIT.UNIT_REF)
)
