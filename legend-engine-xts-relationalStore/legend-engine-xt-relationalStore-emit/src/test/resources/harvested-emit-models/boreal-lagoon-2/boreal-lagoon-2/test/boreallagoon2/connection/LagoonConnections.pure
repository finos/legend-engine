###Connection
RelationalDatabaseConnection test::boreallagoon2::connection::LagoonHireH2Connection
{
  store: test::boreallagoon2::store::LagoonHireDb;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists hire;',
      'create schema hire;',
      'create table hire.trip_log (trip_ref varchar(24) primary key, hire_code varchar(12) not null, craft_kind varchar(24) not null, launch_zone varchar(24) not null, guide_code varchar(24) not null, paddler_count integer not null, trip_minutes integer not null, safety_state varchar(24) not null);',
      'create table hire.trip_tag (tag_ref varchar(24) primary key, trip_ref varchar(24) not null, hazard_tag varchar(24) not null);'
      ];
  };
  auth: DefaultH2;
}
