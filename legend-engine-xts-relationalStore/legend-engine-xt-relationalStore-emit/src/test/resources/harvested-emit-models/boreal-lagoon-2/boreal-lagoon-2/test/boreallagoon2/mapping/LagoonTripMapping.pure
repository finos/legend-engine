###Mapping
Mapping test::boreallagoon2::mapping::LagoonTripMapping
(
  *test::boreallagoon2::domain::LagoonTrip[lagoonTrip]: Relational
  {
    ~primaryKey
    (
      [test::boreallagoon2::store::LagoonHireDb]hire.trip_log.trip_ref
    )
    ~mainTable [test::boreallagoon2::store::LagoonHireDb]hire.trip_log
    tripRef: [test::boreallagoon2::store::LagoonHireDb]hire.trip_log.trip_ref,
    hireCode: [test::boreallagoon2::store::LagoonHireDb]hire.trip_log.hire_code,
    craftKind: [test::boreallagoon2::store::LagoonHireDb]hire.trip_log.craft_kind,
    launchZone: [test::boreallagoon2::store::LagoonHireDb]hire.trip_log.launch_zone,
    guideCode: [test::boreallagoon2::store::LagoonHireDb]hire.trip_log.guide_code,
    paddlerCount: [test::boreallagoon2::store::LagoonHireDb]hire.trip_log.paddler_count,
    tripMinutes: [test::boreallagoon2::store::LagoonHireDb]hire.trip_log.trip_minutes,
    safetyState: [test::boreallagoon2::store::LagoonHireDb]hire.trip_log.safety_state,
    hazardTags[lagoonHazardTag]: [test::boreallagoon2::store::LagoonHireDb]@TripHazardTags
  }

  *test::boreallagoon2::domain::LagoonHazardTag[lagoonHazardTag]: Relational
  {
    ~primaryKey
    (
      [test::boreallagoon2::store::LagoonHireDb]hire.trip_tag.tag_ref
    )
    ~mainTable [test::boreallagoon2::store::LagoonHireDb]hire.trip_tag
    tagRef: [test::boreallagoon2::store::LagoonHireDb]hire.trip_tag.tag_ref,
    hazardTag: [test::boreallagoon2::store::LagoonHireDb]hire.trip_tag.hazard_tag
  }
)
