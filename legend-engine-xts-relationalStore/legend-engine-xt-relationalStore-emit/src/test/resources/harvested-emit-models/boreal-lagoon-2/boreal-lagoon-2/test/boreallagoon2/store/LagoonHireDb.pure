###Relational
Database test::boreallagoon2::store::LagoonHireDb
(
  Schema hire
  (
    Table trip_log
    (
      trip_ref VARCHAR(24) PRIMARY KEY,
      hire_code VARCHAR(12),
      craft_kind VARCHAR(24),
      launch_zone VARCHAR(24),
      guide_code VARCHAR(24),
      paddler_count INTEGER,
      trip_minutes INTEGER,
      safety_state VARCHAR(24)
    )

    Table trip_tag
    (
      tag_ref VARCHAR(24) PRIMARY KEY,
      trip_ref VARCHAR(24),
      hazard_tag VARCHAR(24)
    )
  )

  Join TripHazardTags(hire.trip_log.trip_ref = hire.trip_tag.trip_ref)
)
