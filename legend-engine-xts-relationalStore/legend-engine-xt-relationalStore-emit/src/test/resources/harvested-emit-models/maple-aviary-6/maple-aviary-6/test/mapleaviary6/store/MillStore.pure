###Relational
Database test::mapleaviary6::store::MillDb
(
  Schema mill
  (
    Table milling_run
    (
      run_code VARCHAR(24) PRIMARY KEY,
      mill_code VARCHAR(24) NOT NULL,
      estate_name VARCHAR(40) NOT NULL,
      sail_set VARCHAR(24) NOT NULL,
      grain_kind VARCHAR(24) NOT NULL,
      run_grade VARCHAR(16) NOT NULL,
      sack_count INTEGER NOT NULL,
      stone_hours DOUBLE NOT NULL,
      milled_on DATE NOT NULL
    )
    Table sail_check
    (
      check_code VARCHAR(24) PRIMARY KEY,
      run_code VARCHAR(24) NOT NULL,
      check_grade VARCHAR(16) NOT NULL,
      canvas_metres DOUBLE NOT NULL
    )
  )
  Join Run_Check(mill.milling_run.run_code = mill.sail_check.run_code)
)
