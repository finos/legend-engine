###Pure
import test::mapleaviary6::domain::*;

Class test::mapleaviary6::domain::MillEvent
{
  eventCode: String[1];
  millCode: String[1];
  estateName: String[1];
  recordedOn: StrictDate[1];
}

Class test::mapleaviary6::domain::MillingRun extends MillEvent
{
  sailSet: String[1];
  grainKind: String[1];
  runGrade: String[1];
  sackCount: Integer[1];
  stoneHours: Float[1];
}

Class test::mapleaviary6::domain::SailCheck
{
  checkCode: String[1];
  runCode: String[1];
  checkGrade: String[1];
  canvasMetres: Float[1];
}

Association test::mapleaviary6::domain::Run_Check
{
  checks: SailCheck[*];
  checkedRun: MillingRun[1];
}
