###Relational
Database test::jadelighthouse2::store::HarbourReferenceStore
(
  Schema reference
  (
    Table optic_grade
    (
      grade_code VARCHAR(16) PRIMARY KEY,
      grade_label VARCHAR(64) NOT NULL,
      sector_code VARCHAR(16) NOT NULL
    )

    Table coast_sector
    (
      sector_code VARCHAR(16) PRIMARY KEY,
      sector_name VARCHAR(64) NOT NULL,
      district_code VARCHAR(16) NOT NULL,
      exposure_flag VARCHAR(16) NOT NULL
    )

    Table coast_district
    (
      district_code VARCHAR(16) PRIMARY KEY,
      district_name VARCHAR(64) NOT NULL
    )

    Table district_keeper
    (
      district_code VARCHAR(16) PRIMARY KEY,
      keeper_name VARCHAR(64) NOT NULL
    )

    Table keeper_post
    (
      keeper_name VARCHAR(64) PRIMARY KEY,
      post_name VARCHAR(64) NOT NULL
    )
  )

  Join Grade_Sector(reference.optic_grade.sector_code = reference.coast_sector.sector_code)
  Join Sector_District(reference.coast_sector.district_code = reference.coast_district.district_code)
  Join District_Keeper(reference.coast_district.district_code = reference.district_keeper.district_code)
  Join Keeper_Post(reference.district_keeper.keeper_name = reference.keeper_post.keeper_name)

  Filter NamedSectorFilter(reference.coast_sector.sector_name != 'UNKNOWN')
)
