###Relational
Database test::jadelighthouse2::store::StationSurveyStore
(
  include test::jadelighthouse2::store::HarbourReferenceStore

  Schema survey
  (
    Table light_station
    (
      station_id INTEGER PRIMARY KEY,
      station_name VARCHAR(64) NOT NULL,
      lamp_count INTEGER NOT NULL,
      focal_height_m FLOAT NOT NULL,
      band_code VARCHAR(8),
      state_code VARCHAR(24),
      glazing_code VARCHAR(24),
      grade_code VARCHAR(16) NOT NULL,
      watch_id INTEGER NOT NULL,
      note_text VARCHAR(128)
    )
  )

  Schema watch
  (
    Table watch_log
    (
      watch_id INTEGER PRIMARY KEY,
      watch_code VARCHAR(32) NOT NULL,
      watch_hours FLOAT NOT NULL,
      watch_kind VARCHAR(16) NOT NULL,
      watch_date DATE NOT NULL
    )
  )

  Join Station_Watch(survey.light_station.watch_id = watch.watch_log.watch_id)
  Join Station_Grade(survey.light_station.grade_code = reference.optic_grade.grade_code)

  Filter LitStationFilter(survey.light_station.focal_height_m > 0.0)
  Filter PositiveHoursFilter(watch.watch_log.watch_hours > 0.0)
  Filter DuskWatchFilter(watch.watch_log.watch_kind = 'DUSK')
  Filter ReliefWatchFilter(watch.watch_log.watch_kind = 'RELIEF')

  View watch_hours_vw
  (
    ~filter PositiveHoursFilter
    ~groupBy
    (
      watch.watch_log.watch_code
    )
    watchCode: watch.watch_log.watch_code PRIMARY KEY,
    hoursTotal: sum(watch.watch_log.watch_hours)
  )
)
