###Relational
Database demo::meadowwarren4::store::WardenDb
(
  Schema staff
  (
    Table warden_person
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z, INFINITY_DATE = %9999-12-31)
      )
      warden_code VARCHAR(20) PRIMARY KEY,
      warden_name VARCHAR(80) NOT NULL,
      depot_name VARCHAR(80),
      contact_note VARCHAR(200),
      from_z DATE,
      thru_z DATE
    )

    Table hierarchy_flat
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z, INFINITY_DATE = %9999-12-31)
      )
      flat_ref VARCHAR(20) PRIMARY KEY,
      plot_ref VARCHAR(20),
      path_note VARCHAR(200),
      depth_level INTEGER,
      from_z DATE,
      thru_z DATE
    )
  )
)
