###Relational
Database test::mapleprairie3::store::TrailDb
(
  Schema highland
  (
    Table mountain_hut
    (
      hut_code VARCHAR(32) PRIMARY KEY,
      hut_name VARCHAR(120) NOT NULL,
      trail_code VARCHAR(32) NOT NULL,
      station_code VARCHAR(32) NOT NULL,
      opened_on DATE NOT NULL
    )
    Table trail_segment
    (
      segment_code VARCHAR(32) PRIMARY KEY,
      segment_name VARCHAR(120) NOT NULL,
      grade_code VARCHAR(32) NOT NULL,
      distance_km INTEGER NOT NULL,
      opened_on DATE NOT NULL
    )
    View hut_year_vw
    (
      hut_code: highland.mountain_hut.hut_code PRIMARY KEY,
      patrol_year_label: concat('OPEN-', toString(year(highland.mountain_hut.opened_on)))
    )
  )

  Schema watch
  (
    Table ranger_station
    (
      station_code VARCHAR(32) PRIMARY KEY,
      station_name VARCHAR(120) NOT NULL,
      sector_code VARCHAR(32) NOT NULL
    )
    Table patrol_visit
    (
      visit_code VARCHAR(32) PRIMARY KEY,
      station_code VARCHAR(32) NOT NULL,
      hut_code VARCHAR(32) NOT NULL,
      patrol_kind VARCHAR(32) NOT NULL,
      visit_sequence INTEGER NOT NULL,
      visited_on DATE NOT NULL
    )
  )

  Join Hut_Trail(highland.mountain_hut.trail_code = highland.trail_segment.segment_code)
  Join Hut_Station(highland.mountain_hut.station_code = watch.ranger_station.station_code)
  Join Station_Patrol(watch.ranger_station.station_code = watch.patrol_visit.station_code)
  Join Hut_YearView(highland.mountain_hut.hut_code = highland.hut_year_vw.hut_code)
)
