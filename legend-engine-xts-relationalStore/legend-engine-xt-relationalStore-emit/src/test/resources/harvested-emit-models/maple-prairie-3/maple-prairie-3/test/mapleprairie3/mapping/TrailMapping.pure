###Mapping
Mapping test::mapleprairie3::mapping::TrailMapping
(
  *test::mapleprairie3::domain::MountainHut[hut]: Relational
  {
    ~primaryKey
    (
      [test::mapleprairie3::store::TrailDb]highland.mountain_hut.hut_code
    )
    ~mainTable [test::mapleprairie3::store::TrailDb]highland.mountain_hut
    hutCode: [test::mapleprairie3::store::TrailDb]highland.mountain_hut.hut_code,
    hutName: toUpper(trim([test::mapleprairie3::store::TrailDb]highland.mountain_hut.hut_name)),
    trailName: concat('TRAIL-', toUpper(replace(trim([test::mapleprairie3::store::TrailDb]@Hut_Trail | [test::mapleprairie3::store::TrailDb]highland.trail_segment.segment_name), ' ', '-'))),
    stationName: toUpper(trim([test::mapleprairie3::store::TrailDb]@Hut_Station | [test::mapleprairie3::store::TrailDb]watch.ranger_station.station_name)),
    patrolCode: [test::mapleprairie3::store::TrailDb]@Hut_Station > (INNER) @Station_Patrol | [test::mapleprairie3::store::TrailDb]watch.patrol_visit.visit_code,
    hutLabel: concat('HUT-', [test::mapleprairie3::store::TrailDb]highland.mountain_hut.hut_code),
    patrolYearLabel: [test::mapleprairie3::store::TrailDb]@Hut_YearView | [test::mapleprairie3::store::TrailDb]highland.hut_year_vw.patrol_year_label,
    openedOn: [test::mapleprairie3::store::TrailDb]highland.mountain_hut.opened_on
  }

  *test::mapleprairie3::domain::TrailSegment[segment]: Relational
  {
    ~primaryKey
    (
      [test::mapleprairie3::store::TrailDb]highland.trail_segment.segment_code
    )
    ~mainTable [test::mapleprairie3::store::TrailDb]highland.trail_segment
    segmentCode: [test::mapleprairie3::store::TrailDb]highland.trail_segment.segment_code,
    segmentName: toUpper(trim([test::mapleprairie3::store::TrailDb]highland.trail_segment.segment_name)),
    gradeCode: [test::mapleprairie3::store::TrailDb]highland.trail_segment.grade_code,
    distanceKm: [test::mapleprairie3::store::TrailDb]highland.trail_segment.distance_km,
    openedOn: [test::mapleprairie3::store::TrailDb]highland.trail_segment.opened_on
  }

  *test::mapleprairie3::domain::RangerStation[station]: Relational
  {
    ~primaryKey
    (
      [test::mapleprairie3::store::TrailDb]watch.ranger_station.station_code
    )
    ~mainTable [test::mapleprairie3::store::TrailDb]watch.ranger_station
    stationCode: [test::mapleprairie3::store::TrailDb]watch.ranger_station.station_code,
    stationName: toUpper(trim([test::mapleprairie3::store::TrailDb]watch.ranger_station.station_name)),
    sectorCode: [test::mapleprairie3::store::TrailDb]watch.ranger_station.sector_code
  }

  *test::mapleprairie3::domain::PatrolVisit[visit]: Relational
  {
    ~primaryKey
    (
      [test::mapleprairie3::store::TrailDb]watch.patrol_visit.visit_code
    )
    ~mainTable [test::mapleprairie3::store::TrailDb]watch.patrol_visit
    visitCode: [test::mapleprairie3::store::TrailDb]watch.patrol_visit.visit_code,
    stationCode: [test::mapleprairie3::store::TrailDb]watch.patrol_visit.station_code,
    hutCode: [test::mapleprairie3::store::TrailDb]watch.patrol_visit.hut_code,
    patrolKind: [test::mapleprairie3::store::TrailDb]watch.patrol_visit.patrol_kind,
    visitSequence: [test::mapleprairie3::store::TrailDb]watch.patrol_visit.visit_sequence,
    visitedOn: [test::mapleprairie3::store::TrailDb]watch.patrol_visit.visited_on
  }

  testSuites:
  [
    hutDerivationSuite:
    {
      function: |test::mapleprairie3::domain::MountainHut.all()->project(
  [
    h|$h.hutCode,
    h|$h.hutName,
    h|$h.trailName,
    h|$h.stationName,
    h|$h.patrolCode,
    h|$h.hutLabel,
    h|$h.patrolYearLabel
  ],
  [
    'HutCode',
    'HutName',
    'TrailName',
    'StationName',
    'PatrolCode',
    'HutLabel',
    'PatrolYear'
  ]
)->sort([asc('HutCode')]);
      tests:
      [
        oneMappedHut:
        {
          doc: 'Covers the main-table aliases, primary key, string transforms, table-alias columns, cross-schema station join, two-hop patrol join, and the derived year view.';
          data:
          [
            test::mapleprairie3::store::TrailDb:
              Relational
              #{
                highland.mountain_hut:
                  'hut_code,hut_name,trail_code,station_code,opened_on\n'+
                  'H-7,  summit shelter  ,T-7,RS-3,2024-06-10\n';
                highland.trail_segment:
                  'segment_code,segment_name,grade_code,distance_km,opened_on\n'+
                  'T-7,granite approach,BLUE,8,2024-05-01\n';
                watch.ranger_station:
                  'station_code,station_name,sector_code\n'+
                  'RS-3, north watch ,NORTH\n';
                watch.patrol_visit:
                  'visit_code,station_code,hut_code,patrol_kind,visit_sequence,visited_on\n'+
                  'PV-7,RS-3,H-7,ROUTINE,1,2024-06-12\n';
              }#
          ];
          asserts:
          [
            mappedHut:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"HutCode":"H-7","HutName":"SUMMIT SHELTER","TrailName":"TRAIL-GRANITE-APPROACH","StationName":"NORTH WATCH","PatrolCode":"PV-7","HutLabel":"HUT-H-7","PatrolYear":"OPEN-2024"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
