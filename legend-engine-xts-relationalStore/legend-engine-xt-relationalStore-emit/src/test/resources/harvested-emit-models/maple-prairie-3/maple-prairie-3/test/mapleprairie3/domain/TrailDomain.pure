import test::mapleprairie3::domain::*;

Class test::mapleprairie3::domain::MountainHut
{
  hutCode: String[1];
  hutName: String[1];
  trailName: String[0..1];
  stationName: String[0..1];
  patrolCode: String[0..1];
  hutLabel: String[0..1];
  patrolYearLabel: String[0..1];
  openedOn: StrictDate[1];
}

Class test::mapleprairie3::domain::TrailSegment
{
  segmentCode: String[1];
  segmentName: String[1];
  gradeCode: String[1];
  distanceKm: Integer[1];
  openedOn: StrictDate[1];
}

Class test::mapleprairie3::domain::RangerStation
{
  stationCode: String[1];
  stationName: String[1];
  sectorCode: String[1];
}

Class test::mapleprairie3::domain::PatrolVisit
{
  visitCode: String[1];
  stationCode: String[1];
  hutCode: String[1];
  patrolKind: String[1];
  visitSequence: Integer[1];
  visitedOn: StrictDate[1];
}
