###Pure
import test::goldenthicket5::domain::*;

Class test::goldenthicket5::domain::Wagon
{
  wagonCode: String[1];
  wagonType: String[1];
  tareTonnes: Float[1];
  lastOverhaulOn: StrictDate[0..1];
}

Class test::goldenthicket5::domain::Consist
{
  consistCode: String[1];
  formedOn: StrictDate[1];
  wagonCount: Integer[1];
  destinationYard: String[0..1];
}

Class test::goldenthicket5::domain::Siding
{
  sidingCode: String[1];
  sidingName: String[1];
  lengthMetres: Float[1];
  electrified: Boolean[1];
}

Class test::goldenthicket5::domain::WagonInspection
{
  inspectionCode: String[1];
  inspectedOn: StrictDate[1];
  brakeTestPassed: Boolean[1];
  defectNote: String[0..1];
}

Class test::goldenthicket5::domain::ShiftCrew
{
  crewCode: String[1];
  shiftLabel: String[1];
  headcount: Integer[1];
}

Class test::goldenthicket5::domain::Depot
{
  depotCode: String[1];
  depotName: String[1];
  regionName: String[1];
}
