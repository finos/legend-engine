###Pure
import test::kindlygecko::domain::*;

Enum test::kindlygecko::domain::VigourLevel
{
  ACTIVE,
  TORPID,
  BASKING
}

Class test::kindlygecko::domain::BodyReading
{
  lengthMm: Integer[0..1];
  massG: Float[0..1];
  logSource: String[1];
  recordedBy: String[0..1];
}

Class <<temporal.businesstemporal>> test::kindlygecko::domain::GeckoSighting
{
  sightingId: String[1];
  geckoTag: String[1];
  clutchCount: Integer[1];
  vigour: VigourLevel[0..1];
  reading: BodyReading[1];
  enclosureName: String[0..1];
  zoneName: String[0..1];
  enclosure: Enclosure[0..1];
}

Class test::kindlygecko::domain::Enclosure
{
  enclosureCode: String[1];
  enclosureName: String[1];
  zoneName: String[0..1];
  registerLabel: String[1];
}
