###Relational
Database test::kindlygecko::store::BurrowDatabase
(
  Schema survey
  (
    Table gecko_sighting
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      sighting_id VARCHAR(16) PRIMARY KEY,
      enclosure_code VARCHAR(16) NOT NULL,
      gecko_tag VARCHAR(16) NOT NULL,
      clutch_count INTEGER NOT NULL,
      vigour_code VARCHAR(8),
      length_mm INTEGER,
      mass_g DOUBLE,
      from_z DATE PRIMARY KEY,
      thru_z DATE
    )

    Table field_log
    (
      sighting_id VARCHAR(16) PRIMARY KEY,
      recorded_by VARCHAR(64) NOT NULL
    )
  )

  Schema reference
  (
    Table enclosure
    (
      enclosure_code VARCHAR(16) PRIMARY KEY,
      enclosure_name VARCHAR(64) NOT NULL,
      zone_code VARCHAR(16) NOT NULL
    )

    Table habitat_zone
    (
      zone_code VARCHAR(16) PRIMARY KEY,
      zone_name VARCHAR(64) NOT NULL
    )
  )

  Join SightingEnclosure(survey.gecko_sighting.enclosure_code = reference.enclosure.enclosure_code)
  Join EnclosureZone(reference.enclosure.zone_code = reference.habitat_zone.zone_code)
  Join SightingLog(survey.gecko_sighting.sighting_id = survey.field_log.sighting_id)
)
