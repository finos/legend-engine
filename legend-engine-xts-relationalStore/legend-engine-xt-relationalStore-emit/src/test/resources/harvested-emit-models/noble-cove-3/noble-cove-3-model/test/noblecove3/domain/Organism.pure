import test::noblecove3::domain::*;

Class <<IntertidalProfile.rootTaxon>> {IntertidalProfile.monitoringNotes = 'Root of the intertidal taxon lattice; subtypes add their own survey detail.'} test::noblecove3::domain::Organism
{
  organismCode: String[1];
  scientificName: String[1];
  commonName: String[0..1];
  firstRecordedOn: StrictDate[1];
  observations: Observation[*];
}

Class <<IntertidalProfile.tidalIndicator>> {IntertidalProfile.habitatBand = 'mid-shore'} test::noblecove3::domain::Invertebrate extends Organism
{
  shellPresent: Boolean[1];
  mobilityClass: String[1];
  preferredSubstrates: Substrate[*];
}

Class <<IntertidalProfile.protectedSpecies>> {IntertidalProfile.surveyCadence = 'quarterly'} test::noblecove3::domain::Mollusc extends Invertebrate
{
  shellWhorls: Integer[1];
  maxLengthMillimetres: Float[1];
  grazingDepthCentimetres: Float[0..1];
}

Class <<IntertidalProfile.tidalIndicator>> {IntertidalProfile.habitatBand = 'low-shore'} test::noblecove3::domain::Alga extends Organism
{
  holdfastType: String[1];
  frondLengthCentimetres: Float[1];
  tidalWindows: TidalWindow[*];
}
