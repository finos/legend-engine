###Service
Service test::cobaltcove2::service::StationBatteryRankService
{
  pattern: '/cobaltcove/v1/stations/{processingDate}';
  title: 'Camera Station Battery Rank';
  owners:
  [
    'cove-monitoring',
    'camera-maintenance'
  ];
  documentation: 'Ranks trail cameras by remaining battery within each trail segment as of the requested processing date, so a window function is computed over the processing-temporal slice.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {processingDate: StrictDate[1]|test::cobaltcove2::domain::CameraStation.all($processingDate)->project(
      [
        col(
          c|$c.segmentCode,
          'SegmentCode'
        ),
        col(
          c|$c.stationCode,
          'StationCode'
        ),
        col(
          c|$c.batteryPercent,
          'BatteryPercent'
        )
      ]
    )->olapGroupBy(
      ['SegmentCode'],
      desc('BatteryPercent'),
      y|$y->rank(),
      'BatteryRank'
    )->sort(
      [
        asc('SegmentCode'),
        asc('BatteryRank')
      ]
    )};
    mapping: test::cobaltcove2::mapping::CoveMapping;
    runtime: test::cobaltcove2::runtime::CoveRuntime;
  }
  testSuites:
  [
    stationBatteryRankSuite:
    {
      data:
      [
        connections:
        [
          coveConnection:
            Relational
            #{
              cove.camera_station:
                'station_code,segment_code,battery_percent,in_z,out_z\n'+
                'CM-01,TS-01,88,2024-01-01,9999-12-31\n'+
                'CM-02,TS-01,42,2024-01-01,9999-12-31\n'+
                'CM-03,TS-02,67,2024-01-01,9999-12-31\n'+
                'CM-04,TS-01,95,2023-01-01,2023-12-31\n';
            }#
        ]
      ]
      tests:
      [
        midYearRanks:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            processingDate = %2024-06-01
          ]
          asserts:
          [
            rankedWithinSegment:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"SegmentCode":"TS-01","StationCode":"CM-01","BatteryPercent":88,"BatteryRank":1},{"SegmentCode":"TS-01","StationCode":"CM-02","BatteryPercent":42,"BatteryRank":2},{"SegmentCode":"TS-02","StationCode":"CM-03","BatteryPercent":67,"BatteryRank":1}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
