###Relational
Database test::cobaltcove2::store::CoveDB
(
  Schema cove
  (
    Table trail_segment
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      segment_code VARCHAR(24) PRIMARY KEY,
      reserve_name VARCHAR(96) NOT NULL,
      surface_grade INTEGER NOT NULL,
      from_z DATE PRIMARY KEY,
      thru_z DATE
    )
    Table camera_station
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )
      station_code VARCHAR(24) PRIMARY KEY,
      segment_code VARCHAR(24) NOT NULL,
      battery_percent INTEGER NOT NULL,
      in_z DATE PRIMARY KEY,
      out_z DATE
    )
    Table sighting
    (
      sighting_code VARCHAR(24) PRIMARY KEY,
      segment_code VARCHAR(24) NOT NULL,
      species_name VARCHAR(96) NOT NULL,
      count_seen INTEGER NOT NULL
    )
  )

  Join Segment_Sighting(cove.trail_segment.segment_code = cove.sighting.segment_code)
)
