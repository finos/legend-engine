###Pure
import test::cobaltcove2::domain::*;

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'A monitored stretch of coastal trail, versioned on a business timeline.'} test::cobaltcove2::domain::TrailSegment
{
  segmentCode: String[1];
  reserveName: String[1];
  surfaceGrade: Integer[1];
  sightings: test::cobaltcove2::domain::Sighting[*];
}

Class <<temporal.processingtemporal>> {meta::pure::profiles::doc.doc = 'A trail camera whose recorded state is versioned on a processing timeline.'} test::cobaltcove2::domain::CameraStation
{
  stationCode: String[1];
  segmentCode: String[1];
  batteryPercent: Integer[1];
}

Class {meta::pure::profiles::doc.doc = 'A wildlife sighting logged against a trail segment.'} test::cobaltcove2::domain::Sighting
{
  sightingCode: String[1];
  speciesName: String[1];
  countSeen: Integer[1];
}
