###Service
Service test::cobaltcove2::service::ReserveRosterService
{
  pattern: '/cobaltcove/v1/reserves/{businessDate}';
  title: 'Monitored Reserve Roster';
  owners:
  [
    'cove-monitoring',
    'reserve-wardens'
  ];
  documentation: 'Lists the distinct reserves that still have a monitored trail segment as of the requested business date, so duplicate projected rows collapse after the temporal rewrite.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {businessDate: StrictDate[1]|test::cobaltcove2::domain::TrailSegment.all($businessDate)->project(
      [
        s|$s.reserveName
      ],
      [
        'ReserveName'
      ]
    )->distinct()->sort(
      [
        asc('ReserveName')
      ]
    )};
    mapping: test::cobaltcove2::mapping::CoveMapping;
    runtime: test::cobaltcove2::runtime::CoveRuntime;
  }
  testSuites:
  [
    reserveRosterSuite:
    {
      data:
      [
        connections:
        [
          coveConnection:
            Relational
            #{
              cove.trail_segment:
                'segment_code,reserve_name,surface_grade,from_z,thru_z\n'+
                'TS-01,Kelp Cove Reserve,3,2024-01-01,9999-12-31\n'+
                'TS-02,Kelp Cove Reserve,5,2024-01-01,9999-12-31\n'+
                'TS-03,Otter Point Reserve,2,2024-01-01,9999-12-31\n'+
                'TS-05,Gannet Ledge Reserve,1,2022-01-01,2023-06-30\n';
            }#
        ]
      ]
      tests:
      [
        currentReserves:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            businessDate = %2024-06-01
          ]
          asserts:
          [
            twoDistinctReserves:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"ReserveName":"Kelp Cove Reserve"},{"ReserveName":"Otter Point Reserve"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
