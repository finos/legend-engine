###Connection
RelationalDatabaseConnection test::cobaltcove2::connection::CoveConnection
{
  store: test::cobaltcove2::store::CoveDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists cove;',
      'create schema cove;',
      'create table cove.trail_segment (segment_code varchar(24), reserve_name varchar(96) not null, surface_grade integer not null, from_z date, thru_z date);',
      'create table cove.camera_station (station_code varchar(24), segment_code varchar(24) not null, battery_percent integer not null, in_z date, out_z date);',
      'create table cove.sighting (sighting_code varchar(24) primary key, segment_code varchar(24) not null, species_name varchar(96) not null, count_seen integer not null);'
      ];
  };
  auth: DefaultH2;
}
