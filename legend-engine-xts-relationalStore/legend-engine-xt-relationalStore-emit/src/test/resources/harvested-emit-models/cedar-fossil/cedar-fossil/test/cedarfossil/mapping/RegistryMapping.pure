###Mapping
Mapping demo::cedarfossil::mapping::RegistryMapping
(
  *demo::cedarfossil::domain::Stratum[stratum]: Relational
  {
    ~primaryKey
    (
      [demo::cedarfossil::store::FossilRegistryDB]registry.stratum.stratum_code
    )
    ~mainTable [demo::cedarfossil::store::FossilRegistryDB]registry.stratum
    stratumCode: [demo::cedarfossil::store::FossilRegistryDB]registry.stratum.stratum_code,
    stratumName: [demo::cedarfossil::store::FossilRegistryDB]registry.stratum.stratum_name,
    periodName: [demo::cedarfossil::store::FossilRegistryDB]registry.stratum.period_name
  }

  *demo::cedarfossil::domain::DigSite[digSite]: Relational
  {
    ~primaryKey
    (
      [demo::cedarfossil::store::FossilRegistryDB]registry.dig_site.site_code
    )
    ~mainTable [demo::cedarfossil::store::FossilRegistryDB]registry.dig_site
    siteCode: [demo::cedarfossil::store::FossilRegistryDB]registry.dig_site.site_code,
    siteName: [demo::cedarfossil::store::FossilRegistryDB]registry.dig_site.site_name
  }
)
