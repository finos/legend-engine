###Pure
import demo::cedarfossil::domain::*;

Enum demo::cedarfossil::domain::TaxonGroup
{
  INVERTEBRATE,
  VERTEBRATE,
  FLORA,
  UNDETERMINED
}

Enum demo::cedarfossil::domain::ConditionGrade
{
  PRISTINE,
  FRAGMENTED,
  UNGRADED
}

Class demo::cedarfossil::domain::Stratum
{
  stratumCode: String[1];
  stratumName: String[1];
  periodName: String[1];
}

Class demo::cedarfossil::domain::DigSite
{
  siteCode: String[1];
  siteName: String[1];
}

Association demo::cedarfossil::domain::Site_Bed
{
  bed: Stratum[1];
  sites: DigSite[*];
}

Class <<meta::pure::profiles::temporal.processingtemporal>> demo::cedarfossil::domain::Specimen
{
  specimenCode: String[1];
  taxon: TaxonGroup[1];
  condition: ConditionGrade[1];
  massG: Float[1];
  siteName: String[1];
  periodName: String[1];
  preparedHours: Float[1];
}

Class demo::cedarfossil::domain::PreparationEntry
{
  prepCode: String[1];
  specimenCode: String[1];
  prepStage: String[1];
  prepHours: Float[1];
}
