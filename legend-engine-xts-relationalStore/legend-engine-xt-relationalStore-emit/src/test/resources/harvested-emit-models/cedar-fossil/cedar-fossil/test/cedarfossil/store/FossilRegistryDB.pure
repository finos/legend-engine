###Relational
Database demo::cedarfossil::store::FossilRegistryDB
(
  Schema registry
  (
    Table stratum
    (
      stratum_code VARCHAR(24) PRIMARY KEY,
      stratum_name VARCHAR(120) NOT NULL,
      period_name VARCHAR(120) NOT NULL
    )
    Table dig_site
    (
      site_code VARCHAR(24) PRIMARY KEY,
      site_name VARCHAR(120) NOT NULL,
      stratum_code VARCHAR(24) NOT NULL
    )
  )

  Join Site_Stratum(registry.dig_site.stratum_code = registry.stratum.stratum_code)
)
