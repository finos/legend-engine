###Pure
function test::indigoaviary::function::readingAge(asOf: StrictDate[1], capturedOn: StrictDate[1]): Integer[1]
{
  ($capturedOn->dateDiff($asOf, meta::pure::functions::date::DurationUnit.DAYS) +
    year($asOf) -
    year($capturedOn))
}

function test::indigoaviary::function::windowFloor(asOf: StrictDate[1], daysBack: Integer[1]): Date[1]
{
  $asOf->adjust(
    0 - $daysBack,
    meta::pure::functions::date::DurationUnit.DAYS
  )
}
