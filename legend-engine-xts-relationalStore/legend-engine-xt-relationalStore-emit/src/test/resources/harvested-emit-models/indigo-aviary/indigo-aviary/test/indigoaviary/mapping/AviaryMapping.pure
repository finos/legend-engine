  testSuites:
  [
    readingMilestoneSuite:
    {
      function: |test::indigoaviary::domain::SensorReading.all(%2026-06-30)->project(
  [
    r|$r.readingCode,
    r|$r.unitCode,
    r|$r.sensorKind,
    r|$r.conditionBand
  ],
  [
    'Reading',
    'Unit',
    'Sensor',
    'Condition'
  ]
)->sort(
  [
    asc('Reading')
  ]
);
      tests:
      [
        currentWindowExcludesClosedReading:
        {
          data:
          [
            test::indigoaviary::store::WindFarmDatabase:
              Relational
              #{
                telemetry.sensor_reading:
                  'reading_code,unit_code,sensor_code,reading_value,captured_on,condition_code,in_date,out_date\n'+
                  'RD-01,WT-01,VIB,12.0,2026-06-10,CLEAR,2026-01-01,9999-12-31\n'+
                  'RD-02,WT-01,TMP,78.0,2026-06-11,WATCH,2026-01-01,9999-12-31\n'+
                  'RD-03,WT-02,VIB,34.0,2026-06-12,ALERT,2026-01-01,9999-12-31\n'+
                  'RD-04,WT-02,PRS,4.0,2026-06-13,CRITICAL,2026-01-01,9999-12-31\n'+
                  'RD-05,WT-03,VIB,18.0,2026-05-01,CLEAR,2026-01-01,2026-05-31\n';
              }#
          ];
          asserts:
          [
            fourCurrentReadings:
              Relation
              #{
                Reading,Unit,Sensor,Condition
                RD-01,WT-01,VIBRATION,CLEAR
                RD-02,WT-01,TEMPERATURE,CRITICAL
                RD-03,WT-02,VIBRATION,ALERT
                RD-04,WT-02,OIL_PRESSURE,CLEAR;
              }#
          ];
        }
      ];
    }
  ]
)
