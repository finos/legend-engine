###Mapping
Mapping test::indigoaviary::mapping::AviaryMapping
(
  include mapping test::indigoaviary::mapping::AviaryBaseMapping

  test::indigoaviary::domain::SensorReading[archiveReading]: Relational
  {
    ~primaryKey
    (
      [test::indigoaviary::store::WindFarmDatabase]telemetry.sensor_reading_archive.reading_code
    )
    ~mainTable [test::indigoaviary::store::WindFarmDatabase]telemetry.sensor_reading_archive
    readingCode: [test::indigoaviary::store::WindFarmDatabase]telemetry.sensor_reading_archive.reading_code,
    unitCode: [test::indigoaviary::store::WindFarmDatabase]telemetry.sensor_reading_archive.unit_code,
    sensorKind: EnumerationMapping SensorKindMapping: toUpper(trim([test::indigoaviary::store::WindFarmDatabase]telemetry.sensor_reading_archive.sensor_code)),
    readingValue: [test::indigoaviary::store::WindFarmDatabase]telemetry.sensor_reading_archive.reading_value,
    capturedOn: [test::indigoaviary::store::WindFarmDatabase]telemetry.sensor_reading_archive.captured_on,
    conditionBand: EnumerationMapping ConditionBandMapping: toUpper(trim([test::indigoaviary::store::WindFarmDatabase]telemetry.sensor_reading_archive.condition_code))
  }

  *test::indigoaviary::domain::SensorReading[allReadings]: Operation
  {
    meta::pure::router::operations::union_OperationSetImplementation_1__SetImplementation_MANY_(currentReading, archiveReading)
  }

