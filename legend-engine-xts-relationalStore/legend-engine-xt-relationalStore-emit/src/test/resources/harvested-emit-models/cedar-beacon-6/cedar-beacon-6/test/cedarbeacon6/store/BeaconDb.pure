###Relational
Database test::cedarbeacon6::store::BeaconDb
(
  Schema network
  (
    Table beacon_station
    (
      station_id INTEGER PRIMARY KEY,
      station_code VARCHAR(20) NOT NULL,
      station_name VARCHAR(120) NOT NULL,
      massif_code VARCHAR(12) NOT NULL,
      altitude_m INTEGER NOT NULL,
      commissioned_on DATE NOT NULL
    )
  )

  Schema power
  (
    Table battery_check
    (
      check_id INTEGER PRIMARY KEY,
      check_code VARCHAR(20) NOT NULL,
      station_code VARCHAR(20) NOT NULL,
      checked_on DATE NOT NULL,
      charge_percent DOUBLE NOT NULL,
      cell_kind VARCHAR(16) NOT NULL
    )
  )
)

Database test::cedarbeacon6::store::SignalDb
(
  Schema telemetry
  (
    Table signal_reading
    (
      reading_id INTEGER PRIMARY KEY,
      reading_code VARCHAR(20) NOT NULL,
      station_code VARCHAR(20) NOT NULL,
      recorded_on DATE NOT NULL,
      signal_strength_db DOUBLE NOT NULL,
      receiver_code VARCHAR(20) NOT NULL
    )
  )

  Schema terrain
  (
    Table patrol_route
    (
      route_id INTEGER PRIMARY KEY,
      route_code VARCHAR(20) NOT NULL,
      route_name VARCHAR(120) NOT NULL,
      massif_code VARCHAR(12) NOT NULL,
      distance_km DOUBLE NOT NULL,
      waypoint_count INTEGER NOT NULL
    )
  )
)
