###Pure
import test::cedarbeacon6::domain::*;

Class {meta::pure::profiles::doc.doc = 'A fixed radio beacon standing on a mountain massif, the subject every power and telemetry reading is booked against.'} test::cedarbeacon6::domain::BeaconStation
{
  stationCode: String[1];
  stationName: String[1];
  massifCode: String[1];
  altitudeM: Integer[1];
  commissionedOn: StrictDate[1];
}

Class {meta::pure::profiles::doc.doc = 'One inspection of the battery pack of a beacon, recording the charge left in the pack on the day it was opened.'} test::cedarbeacon6::domain::BatteryCheck
{
  checkCode: String[1];
  stationCode: String[1];
  checkedOn: StrictDate[1];
  chargePercent: Float[1];
  cellKind: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A walked patrol route across one massif, described by the ground it covers and the waypoints it passes.'} test::cedarbeacon6::domain::PatrolRoute
{
  routeCode: String[1];
  routeName: String[1];
  massifCode: String[1];
  distanceKm: Float[1];
  waypointCount: Integer[1];
}

Class {meta::pure::profiles::doc.doc = 'One telemetry sample taken from a beacon, carrying the strength the receiving station heard it at.'} test::cedarbeacon6::domain::SignalReading
{
  readingCode: String[1];
  stationCode: String[1];
  recordedOn: StrictDate[1];
  signalStrengthDb: Float[1];
  receiverCode: String[1];
}
