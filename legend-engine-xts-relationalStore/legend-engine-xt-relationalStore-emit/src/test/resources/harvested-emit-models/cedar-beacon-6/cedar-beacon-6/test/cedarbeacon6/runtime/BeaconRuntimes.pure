###Runtime
Runtime test::cedarbeacon6::runtime::StationRuntime
{
  mappings:
  [
    test::cedarbeacon6::mapping::StationMapping
  ];
  connections:
  [
    test::cedarbeacon6::store::BeaconDb:
    [
      beaconConnection: test::cedarbeacon6::connection::BeaconNetworkConnection
    ]
  ];
}

