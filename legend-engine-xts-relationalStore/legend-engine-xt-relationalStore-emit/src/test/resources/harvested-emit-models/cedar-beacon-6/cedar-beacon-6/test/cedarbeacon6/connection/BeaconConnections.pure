###Connection
RelationalDatabaseConnection test::cedarbeacon6::connection::BeaconNetworkConnection
{
  store: test::cedarbeacon6::store::BeaconDb;
  type: DB2;
  specification: Static
  {
    name: 'EXAMPLE_BEACON_NETWORK_DB';
    host: 'example-beacon-network-host';
    port: 50000;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'beaconnetworkserviceprincipal';
  };
}

RelationalDatabaseConnection test::cedarbeacon6::connection::BeaconTelemetryConnection
{
  store: test::cedarbeacon6::store::SignalDb;
  type: DB2;
  specification: Static
  {
    name: 'EXAMPLE_BEACON_TELEMETRY_DB';
    host: 'example-beacon-telemetry-host';
    port: 50001;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'beacontelemetryserviceprincipal';
  };
}
