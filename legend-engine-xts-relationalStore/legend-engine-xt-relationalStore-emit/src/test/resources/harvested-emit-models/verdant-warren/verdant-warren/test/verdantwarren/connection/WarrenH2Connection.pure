###Connection
RelationalDatabaseConnection test::verdantwarren::connection::WarrenH2Connection
{
  store: test::verdantwarren::store::WarrenDb;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists warren;',
      'create schema warren;',
      'create table warren.burrow_survey (survey_key integer primary key, survey_code varchar(20) not null, hedgerow_name varchar(60) not null, meadow_band varchar(40) not null, surveyor_name varchar(60) not null, entrance_count integer not null, kits_counted integer not null, soil_note varchar(120), in_z date not null, out_z date not null);'
      ];
  };
  auth: DefaultH2;
}
