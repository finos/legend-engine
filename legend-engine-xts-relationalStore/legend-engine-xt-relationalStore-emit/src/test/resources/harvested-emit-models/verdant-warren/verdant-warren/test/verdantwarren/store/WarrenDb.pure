###Relational
Database test::verdantwarren::store::WarrenDb
(
  Schema warren
  (
    Table burrow_survey
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )
      survey_key INTEGER PRIMARY KEY,
      survey_code VARCHAR(20) NOT NULL,
      hedgerow_name VARCHAR(60) NOT NULL,
      meadow_band VARCHAR(40) NOT NULL,
      surveyor_name VARCHAR(60) NOT NULL,
      entrance_count INTEGER NOT NULL,
      kits_counted INTEGER NOT NULL,
      soil_note VARCHAR(120),
      in_z DATE NOT NULL,
      out_z DATE NOT NULL
    )
  )
)
