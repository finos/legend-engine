###Pure
Class <<temporal.processingtemporal>> {meta::pure::profiles::doc.doc = 'A burrow survey walked along one hedgerow of a verdant warren, milestoned on the processing window so the register can be resolved at an arbitrary past instant.'} test::verdantwarren::domain::BurrowSurvey
{
  surveyCode: String[1];
  hedgerowName: String[1];
  meadowBand: String[1];
  surveyorName: String[1];
  entranceCount: Integer[1];
  kitsCounted: Integer[1];
  soilNote: String[0..1];

  crowdingIndex()
  {
    if($this.entranceCount == 0,
       | 0.0,
       | $this.kitsCounted / $this.entranceCount)
  }: Float[1];

  soilLabel()
  {
    if($this.soilNote->isEmpty(),
       | 'UNRECORDED',
       | $this.soilNote->toOne()->trim()->toUpper())
  }: String[1];
}
