###Relational
Database test::zephyrlighthouse5::store::KeeperRegisterDB
(
  Schema keepers
  (
    Table coast_district
    (
      district_code VARCHAR(32) PRIMARY KEY,
      district_name VARCHAR(120) NOT NULL,
      coast_name VARCHAR(120) NOT NULL
    )
    Table station_grade
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z),
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      grade_code VARCHAR(32) PRIMARY KEY,
      grade_description VARCHAR(120) NOT NULL,
      grade_band_label VARCHAR(60) NOT NULL,
      in_z DATE NOT NULL,
      out_z DATE NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
    Table light_station
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z),
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      station_code VARCHAR(32) PRIMARY KEY,
      station_label VARCHAR(120) NOT NULL,
      watch_window VARCHAR(60) NOT NULL,
      lamp_type VARCHAR(60) NOT NULL,
      grade_code VARCHAR(32),
      district_code VARCHAR(32),
      in_z DATE NOT NULL,
      out_z DATE NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
    Table keeper_name
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z),
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      name_code VARCHAR(32) PRIMARY KEY,
      salutation_part VARCHAR(20),
      given_part VARCHAR(60) NOT NULL,
      middle_part VARCHAR(60),
      family_part VARCHAR(60) NOT NULL,
      in_z DATE NOT NULL,
      out_z DATE NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
    Table tenure_entry
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z),
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      tenure_code VARCHAR(32) PRIMARY KEY,
      keeper_code VARCHAR(32) NOT NULL,
      tenure_years INTEGER NOT NULL,
      duty_code VARCHAR(40),
      rotation_code VARCHAR(40) NOT NULL,
      post_label VARCHAR(120) NOT NULL,
      in_z DATE NOT NULL,
      out_z DATE NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
    Table keeper
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z),
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      keeper_code VARCHAR(32) PRIMARY KEY,
      contact_code VARCHAR(60),
      roster_code VARCHAR(40) NOT NULL,
      cert_code VARCHAR(40) NOT NULL,
      name_code VARCHAR(32),
      station_code VARCHAR(32),
      in_z DATE NOT NULL,
      out_z DATE NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
  )

  Join Keeper_Name(keepers.keeper.name_code = keepers.keeper_name.name_code)
  Join Keeper_Station(keepers.keeper.station_code = keepers.light_station.station_code)
  Join Keeper_Tenure(keepers.keeper.keeper_code = keepers.tenure_entry.keeper_code)
  Join Station_District(keepers.light_station.district_code = keepers.coast_district.district_code)
  Join Station_Grade(keepers.light_station.grade_code = keepers.station_grade.grade_code)
)
