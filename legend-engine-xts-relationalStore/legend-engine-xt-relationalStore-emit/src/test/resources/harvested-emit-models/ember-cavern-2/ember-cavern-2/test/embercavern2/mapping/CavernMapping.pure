    massifCode: [test::embercavern2::store::CavernDb]registry.massif.massif_code,
    massifName: [test::embercavern2::store::CavernDb]registry.massif.massif_name
  }

  *test::embercavern2::domain::District[district]: Relational
  {
    ~primaryKey
    (
      [test::embercavern2::store::CavernDb]registry.district.district_code
