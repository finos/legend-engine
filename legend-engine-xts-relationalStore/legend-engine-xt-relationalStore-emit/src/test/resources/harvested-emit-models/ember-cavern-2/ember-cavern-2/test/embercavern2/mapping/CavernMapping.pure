###Mapping
Mapping test::embercavern2::mapping::CavernMapping
(
  test::embercavern2::domain::ExpeditionStatus: EnumerationMapping StatusCodes
  {
    PLANNED: ['PLN'],
    UNDERGROUND: ['UND'],
    SURFACED: ['SRF'],
    ABANDONED: ['ABN']
  }

  test::embercavern2::domain::SurveyGrade: EnumerationMapping GradeCodes
  {
    G1: ['1'],
    G2: ['2'],
    G3: ['3'],
    G4: ['4']
  }

  *test::embercavern2::domain::Expedition[expedition]: Relational
  {
    ~primaryKey
    (
      [test::embercavern2::store::CavernDb]survey.expedition.expedition_id
    )
    ~mainTable [test::embercavern2::store::CavernDb]survey.expedition
    expeditionCode: [test::embercavern2::store::CavernDb]survey.expedition.expedition_code,
    regionCode: [test::embercavern2::store::CavernDb]survey.expedition.region_code,
    status: EnumerationMapping StatusCodes: [test::embercavern2::store::CavernDb]survey.expedition.status_code,
    grade: EnumerationMapping GradeCodes: [test::embercavern2::store::CavernDb]survey.expedition.grade_code,
    isRescueCleared: [test::embercavern2::store::CavernDb]survey.expedition.rescue_cleared,
    leaderNote: [test::embercavern2::store::CavernDb]survey.expedition.leader_note,
    departedAt: [test::embercavern2::store::CavernDb]survey.expedition.departed_at,
    dueBackAt: [test::embercavern2::store::CavernDb]survey.expedition.due_back_at,
    depthM: [test::embercavern2::store::CavernDb]survey.expedition.depth_m
  }

  *test::embercavern2::domain::Cave[cave]: Relational
  {
    ~primaryKey
    (
      [test::embercavern2::store::CavernDb]survey.cave.cave_id
    )
    ~mainTable [test::embercavern2::store::CavernDb]survey.cave
    caveCode: [test::embercavern2::store::CavernDb]survey.cave.cave_code,
    caveName: [test::embercavern2::store::CavernDb]survey.cave.cave_name,
    entranceKind: [test::embercavern2::store::CavernDb]survey.cave.entrance_kind
  }

  *test::embercavern2::domain::Massif[massif]: Relational
  {
    ~primaryKey
    (
