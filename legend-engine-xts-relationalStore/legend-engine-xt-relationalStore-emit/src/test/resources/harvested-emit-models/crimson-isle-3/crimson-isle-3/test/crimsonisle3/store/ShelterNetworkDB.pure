###Relational
Database test::crimsonisle3::store::ShelterNetworkDB
(
  Schema alpine
  (
    Table shelter
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      shelter_id INTEGER PRIMARY KEY,
      shelter_code VARCHAR(20) NOT NULL,
      shelter_name VARCHAR(60) NOT NULL,
      tier_code VARCHAR(4) NOT NULL,
      roof_code VARCHAR(4) NOT NULL,
      route_code VARCHAR(4) NOT NULL,
      bunk_count INTEGER NOT NULL,
      altitude_m INTEGER NOT NULL,
      water_source VARCHAR(20) NOT NULL,
      sweep_note VARCHAR(60),
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
    Table inspection
    (
      inspection_id INTEGER PRIMARY KEY,
      shelter_code VARCHAR(20) NOT NULL,
      inspection_ref VARCHAR(20) NOT NULL,
      checklist_tag VARCHAR(20) NOT NULL,
      outcome_code VARCHAR(4) NOT NULL,
      inspected_on DATE NOT NULL
    )
    Table routine_inspection
    (
      routine_id INTEGER PRIMARY KEY,
      inspection_ref VARCHAR(20) NOT NULL,
      checklist_tag VARCHAR(20) NOT NULL,
      outcome_code VARCHAR(4) NOT NULL,
      inspected_on DATE NOT NULL,
      checklist_version VARCHAR(12) NOT NULL
    )
    Table storm_inspection
    (
      storm_id INTEGER PRIMARY KEY,
      inspection_ref VARCHAR(20) NOT NULL,
      checklist_tag VARCHAR(20) NOT NULL,
      outcome_code VARCHAR(4) NOT NULL,
      inspected_on DATE NOT NULL,
      wind_speed_kph INTEGER NOT NULL
    )
    Table permit
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z),
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      permit_id INTEGER PRIMARY KEY,
      shelter_code VARCHAR(20) NOT NULL,
      permit_ref VARCHAR(20) NOT NULL,
      bunk_allowance INTEGER NOT NULL,
      in_z DATE NOT NULL,
      out_z DATE NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
    Table warden_assignment
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )
      warden_id INTEGER PRIMARY KEY,
      shelter_code VARCHAR(20) NOT NULL,
      warden_name VARCHAR(60) NOT NULL,
      contact_radio VARCHAR(20) NOT NULL,
      in_z DATE NOT NULL,
      out_z DATE NOT NULL
    )
  )

  Join Shelter_Inspection(alpine.shelter.shelter_code = alpine.inspection.shelter_code)

  Join Shelter_Permit(alpine.shelter.shelter_code = alpine.permit.shelter_code)

  Join Shelter_Warden(alpine.shelter.shelter_code = alpine.warden_assignment.shelter_code)
)
