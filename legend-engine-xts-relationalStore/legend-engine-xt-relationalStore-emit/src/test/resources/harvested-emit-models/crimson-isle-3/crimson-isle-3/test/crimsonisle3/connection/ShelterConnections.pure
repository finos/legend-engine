###Connection
RelationalDatabaseConnection test::crimsonisle3::connection::ShelterH2Connection
{
  store: test::crimsonisle3::store::ShelterNetworkDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists alpine;',
      'create schema alpine;',
      'create table alpine.shelter (shelter_id integer primary key, shelter_code varchar(20) not null, shelter_name varchar(60) not null, tier_code varchar(4) not null, roof_code varchar(4) not null, route_code varchar(4) not null, bunk_count integer not null, altitude_m integer not null, water_source varchar(20) not null, sweep_note varchar(60), from_z date not null, thru_z date not null);',
      'create table alpine.inspection (inspection_id integer primary key, shelter_code varchar(20) not null, inspection_ref varchar(20) not null, checklist_tag varchar(20) not null, outcome_code varchar(4) not null, inspected_on date not null);',
      'create table alpine.routine_inspection (routine_id integer primary key, inspection_ref varchar(20) not null, checklist_tag varchar(20) not null, outcome_code varchar(4) not null, inspected_on date not null, checklist_version varchar(12) not null);',
      'create table alpine.storm_inspection (storm_id integer primary key, inspection_ref varchar(20) not null, checklist_tag varchar(20) not null, outcome_code varchar(4) not null, inspected_on date not null, wind_speed_kph integer not null);',
      'create table alpine.permit (permit_id integer primary key, shelter_code varchar(20) not null, permit_ref varchar(20) not null, bunk_allowance integer not null, in_z date not null, out_z date not null, from_z date not null, thru_z date not null);',
      'create table alpine.warden_assignment (warden_id integer primary key, shelter_code varchar(20) not null, warden_name varchar(60) not null, contact_radio varchar(20) not null, in_z date not null, out_z date not null);'
      ];
  };
  auth: DefaultH2;
}
