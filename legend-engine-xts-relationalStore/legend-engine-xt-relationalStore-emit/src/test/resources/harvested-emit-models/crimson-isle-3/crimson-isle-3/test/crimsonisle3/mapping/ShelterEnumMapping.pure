###Mapping
Mapping test::crimsonisle3::mapping::ShelterEnumMapping
(
  test::crimsonisle3::domain::ShelterTier: EnumerationMapping ShelterTierMapping
  {
    BASIC: ['B'],
    SERVICED: ['S'],
    STAFFED: ['T']
  }

  test::crimsonisle3::domain::RoofMaterial: EnumerationMapping RoofMaterialMapping
  {
    SHINGLE: ['SH'],
    SHEET_METAL: ['SM'],
    TURF: ['TU'],
    CANVAS: ['CA']
  }

  test::crimsonisle3::domain::AccessRoute: EnumerationMapping AccessRouteMapping
  {
    FOOT_PATH: ['FP'],
    MULE_TRACK: ['MT'],
    CABLE_HOIST: ['CH']
  }

  test::crimsonisle3::domain::InspectionOutcome: EnumerationMapping InspectionOutcomeMapping
  {
    PASS: ['P'],
    ADVISORY: ['A'],
    DEFECT: ['D'],
    CLOSURE: ['C']
  }
)
