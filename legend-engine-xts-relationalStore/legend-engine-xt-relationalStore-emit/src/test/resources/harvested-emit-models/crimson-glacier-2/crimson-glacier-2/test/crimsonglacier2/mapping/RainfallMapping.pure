###Mapping
Mapping test::crimsonglacier2::mapping::RainfallMapping
(
  test::crimsonglacier2::domain::GaugeStation[station]: Relational
  {
    ~primaryKey
    (
      [test::crimsonglacier2::store::RainfallDb]rainfall.gauge_station.station_code
    )
    ~mainTable [test::crimsonglacier2::store::RainfallDb]rainfall.gauge_station
    stationCode: [test::crimsonglacier2::store::RainfallDb]rainfall.gauge_station.station_code,
    stationName: [test::crimsonglacier2::store::RainfallDb]rainfall.gauge_station.station_name,
    regionCode: [test::crimsonglacier2::store::RainfallDb]rainfall.gauge_station.region_code,
    altitudeMetres: [test::crimsonglacier2::store::RainfallDb]rainfall.gauge_station.altitude_metres
  }

  test::crimsonglacier2::domain::RainfallReading[reading]: Relational
  {
    ~primaryKey
    (
      [test::crimsonglacier2::store::RainfallDb]rainfall.rain_reading.reading_id
    )
    ~mainTable [test::crimsonglacier2::store::RainfallDb]rainfall.rain_reading
    readingId: [test::crimsonglacier2::store::RainfallDb]rainfall.rain_reading.reading_id,
    readingDate: [test::crimsonglacier2::store::RainfallDb]rainfall.rain_reading.reading_date,
    millimetres: [test::crimsonglacier2::store::RainfallDb]rainfall.rain_reading.millimetres,
    qualityFlag: [test::crimsonglacier2::store::RainfallDb]rainfall.rain_reading.quality_flag
  }

  test::crimsonglacier2::domain::Station_Reading: Relational
  {
    AssociationMapping
    (
      gaugeStation[reading, station]: [test::crimsonglacier2::store::RainfallDb]@Reading_Station,
      readings[station, reading]: [test::crimsonglacier2::store::RainfallDb]@Reading_Station
    )
  }
)
