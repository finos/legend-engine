###Relational
Database test::crimsonglacier2::store::RainfallDb
(
  Schema rainfall
  (
    Table gauge_station
    (
      station_code VARCHAR(20) PRIMARY KEY,
      station_name VARCHAR(200) NOT NULL,
      region_code VARCHAR(20) NOT NULL,
      altitude_metres INTEGER NOT NULL
    )

    Table rain_reading
    (
      reading_id INTEGER PRIMARY KEY,
      station_code VARCHAR(20) NOT NULL,
      reading_date DATE NOT NULL,
      millimetres FLOAT NOT NULL,
      quality_flag VARCHAR(20)
    )
  )

  Join Reading_Station(rainfall.rain_reading.station_code = rainfall.gauge_station.station_code)
)
