###Mapping
Mapping test::hazelestuary::mapping::EstuaryMapping
(
  *test::hazelestuary::domain::GaugeReading[reading]: Relational
  {
    ~primaryKey
    (
      [test::hazelestuary::store::EstuaryDB]tideflat.gauge_reading.reading_id
    )
    ~mainTable [test::hazelestuary::store::EstuaryDB]tideflat.gauge_reading
    stationCode: [test::hazelestuary::store::EstuaryDB]tideflat.gauge_reading.station_code,
    zoneName: toUpper([test::hazelestuary::store::EstuaryDB]tideflat.gauge_reading.zone_code),
    gaugeLabel: substring(toUpper([test::hazelestuary::store::EstuaryDB]tideflat.gauge_reading.station_code), 0, 3),
    turbidityIndex: [test::hazelestuary::store::EstuaryDB]tideflat.gauge_reading.turbidity_index
  }
)
