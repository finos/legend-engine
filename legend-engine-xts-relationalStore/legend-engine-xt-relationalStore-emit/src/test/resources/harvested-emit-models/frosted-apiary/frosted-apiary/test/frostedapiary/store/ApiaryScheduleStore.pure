###Relational
Database test::frostedapiary::store::ApiaryScheduleStore
(
  include test::frostedapiary::store::ApiaryDirectoryStore
  include test::frostedapiary::store::ApiarySiteStore

  Schema schedule
  (
    Table inspection_visit
    (
      visit_id INTEGER PRIMARY KEY,
      visit_reference VARCHAR(32) NOT NULL,
      visit_title VARCHAR(120) NOT NULL,
      visit_kind VARCHAR(24) NOT NULL,
      calendar_name VARCHAR(80) NOT NULL,
      organiser_name VARCHAR(80) NOT NULL,
      inspector_contact VARCHAR(120) NOT NULL,
      site_code VARCHAR(20) NOT NULL,
      apiary_zone VARCHAR(40) NOT NULL,
      hive_count INTEGER NOT NULL,
      location_note VARCHAR(160),
      agenda_note VARCHAR(240),
      weather_note VARCHAR(120),
      starts_at TIMESTAMP NOT NULL,
      ends_at TIMESTAMP NOT NULL,
      all_day_flag BIT NOT NULL,
      recurring_flag BIT NOT NULL,
      cancelled_flag BIT NOT NULL,
      confirmed_flag BIT NOT NULL,
      protective_gear_flag BIT NOT NULL,
      smoker_required_flag BIT NOT NULL,
      queen_check_flag BIT NOT NULL,
      brood_check_flag BIT NOT NULL,
      varroa_check_flag BIT NOT NULL,
      harvest_planned_flag BIT NOT NULL,
      feeding_planned_flag BIT NOT NULL,
      travel_required_flag BIT NOT NULL,
      reminder_sent_flag BIT NOT NULL
    )
  )

  Join Visit_Inspector(schedule.inspection_visit.inspector_contact = directory.inspector_directory.contact_address)

  Join Visit_Site(schedule.inspection_visit.site_code = site.hive_site.site_code)
)
