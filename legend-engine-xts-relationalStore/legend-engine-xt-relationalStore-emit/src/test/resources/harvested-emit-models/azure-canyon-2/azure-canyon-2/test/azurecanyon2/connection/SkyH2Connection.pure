###Connection
RelationalDatabaseConnection test::azurecanyon2::connection::SkyH2Connection
{
  store: test::azurecanyon2::store::SkyDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists sky;',
      'create schema sky;',
      'create table sky.survey (survey_id integer primary key, survey_name varchar(200) not null, target_band varchar(20) not null, plate_count integer not null, in_z date not null, out_z date not null, from_z date not null, thru_z date not null);',
      'create table sky.reading (reading_id integer primary key, station_id integer not null, band varchar(20) not null, magnitude double not null, captured_on date not null, in_z date not null, out_z date not null);',
      'create table sky.station (station_id integer primary key, station_name varchar(200) not null, station_kind varchar(20) not null, elevation_m double not null, ridge_name varchar(200));'
      ];
  };
  auth: DefaultH2;
}
