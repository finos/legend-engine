###Service
Service test::azurecanyon2::service::RidgeStationsAbove
{
  pattern: '/sky/v1/ridge-stations/{minElevationM}';
  title: 'Sky - Ridge Stations Above Elevation';
  owners:
  [
    'sky-survey-ops',
    'site-planning'
  ];
  documentation: 'Narrows observing sites to the ridge-sited subtype and returns those above an elevation threshold with a derived ridge label.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {minElevationM: Float[1]|test::azurecanyon2::domain::Station.all()->cast(
      @test::azurecanyon2::domain::RidgeStation
    )->filter(
      r|$r.elevationM >= $minElevationM
    )->project(
      [
        x|$x.stationName,
        x|$x.ridgeLabel()
      ],
      [
        'Station',
        'Ridge'
      ]
    )->sort(
      [
        asc('Station')
      ]
    )};
    mapping: test::azurecanyon2::mapping::SkyMapping;
    runtime: test::azurecanyon2::runtime::SkyRuntime;
  }
  testSuites:
  [
    ridgeStationsSuite:
    {
      data:
      [
        connections:
        [
          skyConnection:
            Relational
            #{
              sky.station:
                'station_id,station_name,station_kind,elevation_m,ridge_name\n'+
                '1,Crest Watch,RIDGE,2450.0,North Crest\n'+
                '2,Basin Watch,BASIN,910.0,\n'+
                '3,Saddle Watch,RIDGE,1180.0,South Saddle\n';
            }#
        ]
      ]
      tests:
      [
        highRidgeStations:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            minElevationM = 1000.0
          ]
          asserts:
          [
            twoRidgeStations:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Station":"Crest Watch","Ridge":"NORTH CREST @ 2450"},{"Station":"Saddle Watch","Ridge":"SOUTH SADDLE @ 1180"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
