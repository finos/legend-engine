import test::azurecanyon2::domain::*;

Class <<temporal.bitemporal>> {meta::pure::profiles::doc.doc = 'An observing campaign whose plate coverage is tracked on both the processing and the business timeline.'} test::azurecanyon2::domain::SkySurvey
{
  name: String[1];
  targetBand: String[1];
  plateCount: Integer[1];
  coverageTier() {if($this.plateCount > 400, | 'DEEP-' + $this.targetBand->toUpper(), | if($this.plateCount > 120, | 'MID-' + $this.targetBand->toUpper(), | 'SHALLOW-' + $this.targetBand->toUpper()))}: String[1];
}

Class <<temporal.processingtemporal>> {meta::pure::profiles::doc.doc = 'A single instrument capture whose corrected magnitude is tracked on the processing timeline.'} test::azurecanyon2::domain::InstrumentReading
{
  band: String[1];
  magnitude: Float[1];
  capturedOn: StrictDate[1];
  qualityLabel() {if($this.magnitude < 6.0, | 'BRIGHT (' + $this.band->toUpper()->substring(0, 2) + ')', | if($this.magnitude < 12.0, | 'FAINT (' + $this.band->toUpper()->substring(0, 2) + ')', | 'MARGINAL (' + $this.band->toUpper()->substring(0, 2) + ')'))}: String[1];
}

Class {meta::pure::profiles::doc.doc = 'An observing site that hosts instruments.'} test::azurecanyon2::domain::Station
{
  stationId: Integer[1];
  stationName: String[1];
  elevationM: Float[1];
}

Class {meta::pure::profiles::doc.doc = 'An observing site sited on an exposed ridge, carrying the ridge it occupies.'} test::azurecanyon2::domain::RidgeStation extends test::azurecanyon2::domain::Station
{
  ridgeName: String[1];
  ridgeLabel() {$this.ridgeName->toUpper() + ' @ ' + $this.elevationM->round()->toString()}: String[1];
}
