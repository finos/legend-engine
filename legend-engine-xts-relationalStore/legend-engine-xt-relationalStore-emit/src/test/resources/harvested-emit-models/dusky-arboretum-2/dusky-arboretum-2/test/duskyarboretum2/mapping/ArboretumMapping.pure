###Mapping
Mapping test::duskyarboretum2::mapping::ArboretumMapping
(
  include test::duskyarboretum2::mapping::GroveMapping

  *test::duskyarboretum2::domain::TreeSpecimen[specimen]: Relational
  {
    ~primaryKey
    (
      [test::duskyarboretum2::store::ArboretumDB]arboretum.specimen.specimen_id
    )
    ~mainTable [test::duskyarboretum2::store::ArboretumDB]arboretum.specimen
    label: [test::duskyarboretum2::store::ArboretumDB]arboretum.specimen.label,
    healthRating: [test::duskyarboretum2::store::ArboretumDB]arboretum.specimen.health_rating,
    grove[grove]: [test::duskyarboretum2::store::ArboretumDB]@Specimen_Grove
  }

  testSuites:
  [
    specimenAsOfSuite:
    {
      function: |test::duskyarboretum2::domain::TreeSpecimen.all(%2023-06-01)->project(
  [
    x|$x.label,
    x|$x.healthRating,
    x|$x.grove.name
  ],
  [
    'Label',
    'HealthRating',
    'Grove'
  ]
);
      tests:
      [
        healthAsOfMidYear:
        {
          doc: 'Point-in-time projection of a business-temporal specimen as of 2023-06-01, exercising milestoning and the Specimen_Grove join across an included mapping.';
          data:
          [
            test::duskyarboretum2::store::ArboretumDB:
              Relational
              #{
                arboretum.grove:
                  'grove_id,grove_name\n'+
                  '1,North Grove\n';
                arboretum.specimen:
                  'specimen_id,label,health_rating,grove_id,from_z,thru_z\n'+
                  '1,Copper Beech,7,1,2023-01-01,2023-06-01\n'+
                  '1,Copper Beech,9,1,2023-06-01,9999-12-31\n';
              }#
          ];
          asserts:
          [
            oneRow:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Label":"Copper Beech","HealthRating":9,"Grove":"North Grove"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
