###Pure
import test::crimsonwharf4::domain::*;

Profile test::crimsonwharf4::domain::KilnMeta
{
  stereotypes: [curated, reference];
  tags: [steward, tier];
}

Class <<KilnMeta.curated>> {KilnMeta.steward = 'Kiln Rota Desk'} test::crimsonwharf4::domain::KilnFiring
{
  firingCode: String[1];
  kilnCode: String[1];
  studioCode: String[1];
  firingDate: StrictDate[1];
  startedAt: DateTime[1];
  peakCelsius: Integer[1];
  holdMinutes: Integer[1];
  leadPotter: String[1];
  firingNote: String[0..1];
  firingLabel: String[1];
  firingBand: String[0..1];
  holdFraction: Float[1];
  rosterLine() {$this.firingCode + ' <- ' + $this.leadPotter}: String[1];
  bandedLabel() {$this.firingLabel + ' / ' + if($this.firingBand->isEmpty(), |'UNBANDED', |$this.firingBand->toOne())}: String[1];
}

Class <<KilnMeta.curated>> test::crimsonwharf4::domain::PotteryPiece
{
  pieceCode: String[1];
  pieceName: String[1];
  clayBody: String[1];
  wallMm: Float[1];
  massGrams: Integer[1];
  massKilograms: Float[1];
  glazeMode: String[1];
  firingLeadPotter: String[0..1];
  reviewFlag: String[0..1];
  sizeLine() {$this.pieceCode + ' ' + $this.clayBody}: String[1];
}

Class test::crimsonwharf4::domain::GlazeBatch
{
  glazeCode: String[1];
  glazeName: String[1];
  coneNumber: Integer[1];
  matteFlag: String[1];
  glazeLabel: String[1];
}

Class test::crimsonwharf4::domain::FiringReview
{
  reviewCode: String[1];
  passedFlag: String[1];
  reviewedAt: DateTime[1];
  reviewerName: String[1];
}

Class <<KilnMeta.reference>> {KilnMeta.tier = 'reference'} test::crimsonwharf4::domain::Studio
{
  studioCode: String[1];
  studioName: String[1];
  wheelCount: Integer[1];
  kilnCount: Integer[1];
  studioLabel: String[1];
  stationRatio: Float[1];
}

Association test::crimsonwharf4::domain::Firing_Pieces
{
  firing: test::crimsonwharf4::domain::KilnFiring[1];
  pieces: test::crimsonwharf4::domain::PotteryPiece[*];
}

Association test::crimsonwharf4::domain::Piece_Glaze
{
  glaze: test::crimsonwharf4::domain::GlazeBatch[0..1];
  glazedPieces: test::crimsonwharf4::domain::PotteryPiece[*];
}

Association test::crimsonwharf4::domain::Firing_Reviews
{
  reviewedFiring: test::crimsonwharf4::domain::KilnFiring[1];
  reviews: test::crimsonwharf4::domain::FiringReview[*];
}
