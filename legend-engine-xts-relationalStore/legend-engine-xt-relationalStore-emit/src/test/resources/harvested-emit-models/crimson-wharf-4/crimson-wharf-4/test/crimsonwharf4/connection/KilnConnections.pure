###Connection
RelationalDatabaseConnection test::crimsonwharf4::connection::KilnClusterConnection
{
  store: test::crimsonwharf4::store::KilnDB;
  type: MemSQL;
  specification: Static
  {
    name: 'EXAMPLE_KILN_DB';
    host: 'example-kiln-host';
    port: 3306;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'kilnserviceprincipal';
  };
}

###Connection
RelationalDatabaseConnection test::crimsonwharf4::connection::StudioRefClusterConnection
{
  store: test::crimsonwharf4::store::StudioRefDB;
  type: MemSQL;
  specification: Static
  {
    name: 'EXAMPLE_STUDIO_REF_DB';
    host: 'example-studio-ref-host';
    port: 3306;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'studiorefserviceprincipal';
  };
}

###Connection
RelationalDatabaseConnection test::crimsonwharf4::connection::KilnH2Connection
{
  store: test::crimsonwharf4::store::KilnDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [];
  };
  auth: DefaultH2;
}

