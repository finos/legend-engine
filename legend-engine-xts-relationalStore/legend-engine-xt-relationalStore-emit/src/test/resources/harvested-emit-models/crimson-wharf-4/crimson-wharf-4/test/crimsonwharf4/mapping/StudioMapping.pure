###Mapping
Mapping test::crimsonwharf4::mapping::StudioMapping
(
  *test::crimsonwharf4::domain::Studio[studio]: Relational
  {
    ~filter [test::crimsonwharf4::store::StudioRefDB]LiveStudio
    ~primaryKey
    (
      [test::crimsonwharf4::store::StudioRefDB]studioref.studio.studio_code
    )
    ~mainTable [test::crimsonwharf4::store::StudioRefDB]studioref.studio
    studioCode: [test::crimsonwharf4::store::StudioRefDB]studioref.studio.studio_code,
    studioName: trim([test::crimsonwharf4::store::StudioRefDB]studioref.studio.studio_name),
    wheelCount: [test::crimsonwharf4::store::StudioRefDB]studioref.studio.wheel_count,
    kilnCount: [test::crimsonwharf4::store::StudioRefDB]studioref.studio.kiln_count,
    studioLabel: case(
                   greaterThan([test::crimsonwharf4::store::StudioRefDB]studioref.studio.wheel_count, 8),
                   toUpper(
                     trim(
                       concat(
                         [test::crimsonwharf4::store::StudioRefDB]studioref.studio.studio_code,
                         concat(' - ', [test::crimsonwharf4::store::StudioRefDB]studioref.studio.studio_name)
                       )
                     )
                   ),
                   trim([test::crimsonwharf4::store::StudioRefDB]studioref.studio.studio_name)
                 ),
    stationRatio: divide([test::crimsonwharf4::store::StudioRefDB]studioref.studio.wheel_count, [test::crimsonwharf4::store::StudioRefDB]studioref.studio.kiln_count)
  }

  testSuites:
  [
    studioRosterSuite:
    {
      function: |test::crimsonwharf4::domain::Studio.all()->project(
        [
          s|$s.studioCode,
          s|$s.studioLabel,
          s|$s.stationRatio
        ],
        [
          'Studio',
          'Label',
          'Ratio'
        ]
      )->sort([asc('Studio')]);
      tests:
      [
        labelArmsAndRetiredStudio:
        {
          doc: 'Keeps the live studios only, sends the busy studio down the composed-label arm and the quiet one down the trimmed-name arm, and derives the wheels-per-kiln ratio arithmetically.';
          data:
          [
            test::crimsonwharf4::store::StudioRefDB:
              Relational
              #{
                studioref.studio:
                  'studio_code,studio_name,wheel_count,kiln_count,studio_state\n'+
                  'S-1,ridge pottery,12,3,1\n'+
                  'S-2, vale pottery ,6,2,1\n'+
                  'S-3,closed pottery,4,1,0\n';
              }#
          ];
          asserts:
          [
            rows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Studio":"S-1","Label":"S-1 - RIDGE POTTERY","Ratio":4.0},{"Studio":"S-2","Label":"vale pottery","Ratio":3.0}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
