###Pure
import test::solarcove2::domain::*;
import test::solarcove2::domain::common::*;
import test::solarcove2::profile::*;

Enum {meta::pure::profiles::doc.doc = 'Second-generation review cycle vocabulary. Overlaps the shared stage vocabulary but adds a withdrawal outcome, so the two versions are not interchangeable.'} test::solarcove2::domain::v2::SurveyStage
{
  PLANNED,
  FIELDWORK,
  REVIEW,
  PUBLISHED,
  {meta::pure::profiles::doc.doc = 'Return withdrawn before publication; has no first-generation equivalent.'} WITHDRAWN
}

Class <<CivicMeta.versioned>> {meta::pure::profiles::doc.doc = 'Second-generation signal timing observation. The relationship to its flag bundle is expressed as a plain property here rather than through the shared association.', CivicMeta.schemaVersion = 'v2'} test::solarcove2::domain::v2::SignalPhaseReport extends CrossingReportEvent
{
  {meta::pure::profiles::doc.doc = 'Measured length of the pedestrian phase.'} phaseSeconds: Integer[0..1];
  {meta::pure::profiles::doc.doc = 'Measured length of the all-red clearance interval, new in the second generation.'} clearanceSeconds: Integer[0..1];
  {meta::pure::profiles::doc.doc = 'Flag bundle carried as a plain property instead of an association end.'} flags: ObservationFlags[0..1];
}

Class <<CivicMeta.versioned>> {meta::pure::profiles::doc.doc = 'Second-generation kerb ramp observation carrying the measured approach width.', CivicMeta.schemaVersion = 'v2'} test::solarcove2::domain::v2::KerbRampReport extends CrossingReportEvent
{
  {meta::pure::profiles::doc.doc = 'Measured ramp gradient as a whole percentage.'} rampGradientPct: Integer[0..1];
  {meta::pure::profiles::doc.doc = 'Clear approach width in centimetres.'} approachWidthCm: Integer[0..1];
}

Class {meta::pure::profiles::doc.doc = 'One access audit on the second-generation schema, keyed by auditor, review stage and audit date.'} test::solarcove2::domain::v2::AccessAudit
{
  <<CivicMeta.identityKey>> {meta::pure::profiles::doc.doc = 'Code of the auditor.'} auditorCode: String[1];
  <<CivicMeta.identityKey>> {meta::pure::profiles::doc.doc = 'Review stage the audit was taken at, on the second-generation vocabulary.'} stage: test::solarcove2::domain::v2::SurveyStage[1];
  <<CivicMeta.identityKey>> {meta::pure::profiles::doc.doc = 'Date the audit was taken.'} auditedOn: StrictDate[1];
  {meta::pure::profiles::doc.doc = 'Mobility aid declared by the resident who walked the crossing.'} aidRequired: MobilityAid[0..1];
}

Class <<CivicMeta.governed>> {meta::pure::profiles::doc.doc = 'Second-generation aggregate root of a crossing survey return, applying the same composite-key uniqueness rule over the second-generation children.', CivicMeta.retention = 'ten-years'} test::solarcove2::domain::v2::CrossingSurveyReturn
[
  childCompositeKeysUnique: ($this.audits->map(a | $a.auditorCode + '~' + $a.stage->toString() + '~' + $a.auditedOn->toString())->removeDuplicates()->size() == $this.audits->size()) && ($this.phaseReports->map(r | $r.reportCode + '~' + $r.recordedOn->toString() + '~' + $r.crossingKind->toString())->removeDuplicates()->size() == $this.phaseReports->size()) && ($this.rampReports->map(r | $r.reportCode + '~' + $r.recordedOn->toString())->removeDuplicates()->size() == $this.rampReports->size()),
  withdrawnReturnsCarryNote: if($this.stage == test::solarcove2::domain::v2::SurveyStage.WITHDRAWN, | $this.withdrawalNote->isNotEmpty(), | true)
]
{
  <<CivicMeta.identityKey>> {meta::pure::profiles::doc.doc = 'Code of the survey return.'} returnCode: String[1];
  {meta::pure::profiles::doc.doc = 'Stage the return has reached on the second-generation vocabulary.'} stage: test::solarcove2::domain::v2::SurveyStage[1];
  {meta::pure::profiles::doc.doc = 'Reason the return was withdrawn; required once the stage is a withdrawal.'} withdrawalNote: String[0..1];
  {meta::pure::profiles::doc.doc = 'Access audits collected under the return.'} audits: test::solarcove2::domain::v2::AccessAudit[*];
  {meta::pure::profiles::doc.doc = 'Signal timing observations collected under the return.'} phaseReports: test::solarcove2::domain::v2::SignalPhaseReport[*];
  {meta::pure::profiles::doc.doc = 'Kerb ramp observations collected under the return.'} rampReports: test::solarcove2::domain::v2::KerbRampReport[*];
}
