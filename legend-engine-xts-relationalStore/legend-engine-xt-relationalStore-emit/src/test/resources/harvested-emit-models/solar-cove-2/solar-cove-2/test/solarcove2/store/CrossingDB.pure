###Relational
Database test::solarcove2::store::CrossingDB
(
  Schema civic
  (
    Table crossing_eligibility_outcome
    (
      decision_code VARCHAR(32) PRIMARY KEY,
      period_code INTEGER PRIMARY KEY,
      ward_code VARCHAR(24),
      street_name VARCHAR(200),
      crossing_form VARCHAR(24),
      programme_code VARCHAR(24),
      scheme_stage VARCHAR(24),
      eligible_flag VARCHAR(1),
      eligibility_reason VARCHAR(400),
      footfall_band VARCHAR(16),
      daily_footfall BIGINT,
      school_route_flag VARCHAR(1),
      bus_stop_count INTEGER,
      dropped_kerb_count INTEGER,
      tactile_stud_count INTEGER,
      signal_head_count INTEGER,
      audible_aid_count INTEGER,
      approach_width_cm INTEGER,
      ramp_gradient_pct INTEGER,
      last_resurfaced_on TIMESTAMP,
      last_inspected_on TIMESTAMP,
      decision_taken_at TIMESTAMP,
      decision_officer_code VARCHAR(24),
      review_note VARCHAR(400)
    )
    Table crossing_report
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )

      report_id INTEGER PRIMARY KEY,
      report_code VARCHAR(32) NOT NULL,
      crossing_form VARCHAR(24) NOT NULL,
      recorded_on DATE NOT NULL,
      surveyor_code VARCHAR(24),
      review_note VARCHAR(400),
      in_z DATE PRIMARY KEY,
      out_z DATE
    )
  )
)
