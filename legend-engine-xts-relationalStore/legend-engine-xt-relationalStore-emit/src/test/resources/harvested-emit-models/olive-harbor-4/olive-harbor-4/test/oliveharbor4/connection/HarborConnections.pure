###Connection
RelationalDatabaseConnection test::oliveharbor4::connection::HarborYardConnection
{
  store: test::oliveharbor4::store::HarborYardDb;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists yard;',
      'create schema yard;',
      'create table yard.haul_out (haul_ref varchar(24) primary key, cradle_code varchar(24) not null, craft_name varchar(80) not null, craft_kind varchar(24) not null, haul_state varchar(16) not null, keel_metres double not null, tonnage double, dock_days integer not null);',
      'create table yard.lift_cradle (cradle_code varchar(24) primary key, cradle_name varchar(80) not null, slip_code varchar(24) not null, cradle_tonnes_t double not null);',
      'create table yard.slipway (slip_code varchar(24) primary key, slip_name varchar(80) not null, winch_rating_t double not null);'
      ];
  };
  auth: DefaultH2;
}
