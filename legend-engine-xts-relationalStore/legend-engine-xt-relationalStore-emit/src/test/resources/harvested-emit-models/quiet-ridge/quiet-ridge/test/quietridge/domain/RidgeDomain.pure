import meta::pure::profiles::*;
import test::quietridge::domain::*;

Class <<temporal.processingtemporal>> {doc.doc = 'A surveyed trail segment as the registry knew it at a processing instant.'} test::quietridge::domain::TrailSegment
{
  segmentCode: String[1];
  trailName: String[1];
  patrolZone: Integer[1];
  elevationGainM: Integer[1];
  surfaceKind: String[1];
  hazards: HazardNote[*];
}

Class {doc.doc = 'An exposed ridge-line segment carrying an exposure rating.'} test::quietridge::domain::RidgeSegment extends TrailSegment
{
  exposureRating: Integer[1];
}

Class {doc.doc = 'A sheltered forest segment carrying a canopy cover percentage.'} test::quietridge::domain::ForestSegment extends TrailSegment
{
  canopyCoverPct: Integer[1];
}

Class {doc.doc = 'A hazard observation recorded against a trail segment.'} test::quietridge::domain::HazardNote
{
  hazardKind: String[1];
  severityLevel: Integer[1];
}
