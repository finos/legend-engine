###Mapping
Mapping test::quietridge::mapping::RidgeMapping
(
  *test::quietridge::domain::TrailSegment: Operation
  {
    meta::pure::router::operations::inheritance_OperationSetImplementation_1__SetImplementation_MANY_(ridge_segment, forest_segment)
  }

  test::quietridge::domain::RidgeSegment[ridge_segment]: Relational
  {
    ~filter [test::quietridge::store::RidgeDb]RidgeClassFilter
    ~primaryKey
    (
      [test::quietridge::store::RidgeDb]ridge.trail_segment.segment_id
    )
    ~mainTable [test::quietridge::store::RidgeDb]ridge.trail_segment
    segmentCode: [test::quietridge::store::RidgeDb]ridge.trail_segment.segment_code,
    trailName: [test::quietridge::store::RidgeDb]ridge.trail_segment.trail_name,
    patrolZone: [test::quietridge::store::RidgeDb]ridge.trail_segment.patrol_zone,
    elevationGainM: [test::quietridge::store::RidgeDb]ridge.trail_segment.gain_metres,
    surfaceKind: [test::quietridge::store::RidgeDb]ridge.trail_segment.surface_kind,
    exposureRating: [test::quietridge::store::RidgeDb]ridge.trail_segment.exposure_rating,
    hazards[hazard_note]: [test::quietridge::store::RidgeDb]@Segment_Hazard
  }

  test::quietridge::domain::ForestSegment[forest_segment]: Relational
  {
    ~filter [test::quietridge::store::RidgeDb]ForestClassFilter
    ~primaryKey
    (
      [test::quietridge::store::RidgeDb]ridge.trail_segment.segment_id
    )
    ~mainTable [test::quietridge::store::RidgeDb]ridge.trail_segment
    segmentCode: [test::quietridge::store::RidgeDb]ridge.trail_segment.segment_code,
    trailName: [test::quietridge::store::RidgeDb]ridge.trail_segment.trail_name,
    patrolZone: [test::quietridge::store::RidgeDb]ridge.trail_segment.patrol_zone,
    elevationGainM: [test::quietridge::store::RidgeDb]ridge.trail_segment.gain_metres,
    surfaceKind: [test::quietridge::store::RidgeDb]ridge.trail_segment.surface_kind,
    canopyCoverPct: [test::quietridge::store::RidgeDb]ridge.trail_segment.canopy_cover_pct,
    hazards[hazard_note]: [test::quietridge::store::RidgeDb]@Segment_Hazard
  }

  *test::quietridge::domain::HazardNote[hazard_note]: Relational
  {
    ~primaryKey
    (
      [test::quietridge::store::RidgeDb]ridge.hazard_note.hazard_id
    )
    ~mainTable [test::quietridge::store::RidgeDb]ridge.hazard_note
    hazardKind: [test::quietridge::store::RidgeDb]ridge.hazard_note.hazard_kind,
    severityLevel: [test::quietridge::store::RidgeDb]ridge.hazard_note.severity_level
  }
)
