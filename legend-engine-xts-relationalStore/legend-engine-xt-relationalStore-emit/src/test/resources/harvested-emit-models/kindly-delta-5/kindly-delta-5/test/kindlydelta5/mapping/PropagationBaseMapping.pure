###Mapping
Mapping test::kindlydelta5::mapping::PropagationBaseMapping
(
  test::kindlydelta5::domain::VigourBand: EnumerationMapping VigourBandMapping
  {
    SPROUT: ['SPROUT'],
    READY: ['READY'],
    LUSH: ['LUSH']
  }

  test::kindlydelta5::domain::TrayFormat: EnumerationMapping TrayFormatMapping
  {
    CELL: ['CELL'],
    FLAT: ['FLAT'],
    OPEN: ['OPEN']
  }

  test::kindlydelta5::domain::StorageZone: EnumerationMapping StorageZoneMapping
  {
    COOL: ['COOL'],
    MILD: ['MILD'],
    WARM: ['WARM']
  }

  *test::kindlydelta5::domain::SpeciesRef[species]: Relational
  {
    ~primaryKey
    (
      [test::kindlydelta5::store::PropagationDB]catalog.species_ref.species_code
    )
    ~mainTable [test::kindlydelta5::store::PropagationDB]catalog.species_ref
    speciesCode: [test::kindlydelta5::store::PropagationDB]catalog.species_ref.species_code,
    speciesLabel: [test::kindlydelta5::store::PropagationDB]catalog.species_ref.species_label,
    familyCode: [test::kindlydelta5::store::PropagationDB]catalog.species_ref.family_code
  }

  *test::kindlydelta5::domain::RegionRef[region]: Relational
  {
    ~primaryKey
    (
      [test::kindlydelta5::store::PropagationDB]catalog.region_ref.region_code
    )
    ~mainTable [test::kindlydelta5::store::PropagationDB]catalog.region_ref
    regionCode: [test::kindlydelta5::store::PropagationDB]catalog.region_ref.region_code,
    regionLabel: [test::kindlydelta5::store::PropagationDB]catalog.region_ref.region_label
  }
)
