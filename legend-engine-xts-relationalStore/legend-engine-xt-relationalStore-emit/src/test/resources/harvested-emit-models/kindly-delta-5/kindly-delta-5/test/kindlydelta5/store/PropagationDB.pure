###Relational
Database test::kindlydelta5::store::PropagationDB
(
  Schema nursery
  (
    Table propagation_batch
    (
      batch_code VARCHAR(24) PRIMARY KEY,
      stage_no INTEGER NOT NULL,
      batch_label VARCHAR(120) NOT NULL,
      zone_code VARCHAR(24) NOT NULL,
      planned_date DATE NOT NULL,
      recorded_at TIMESTAMP NOT NULL,
      active_flag CHAR(1) NOT NULL
    )
    Table bench_tray
    (
      tray_code VARCHAR(24) PRIMARY KEY,
      batch_code VARCHAR(24) NOT NULL,
      tray_label VARCHAR(120) NOT NULL,
      tray_format VARCHAR(24),
      species_code VARCHAR(24) NOT NULL,
      sown_count INTEGER NOT NULL
    )

    View batch_yield_view
    (
      ~groupBy
      (
        nursery.bench_tray.batch_code
      )
      batch_code: nursery.bench_tray.batch_code PRIMARY KEY,
      tray_count: count(nursery.bench_tray.tray_code),
      total_sown: sum(nursery.bench_tray.sown_count)
    )
  )

  Schema catalog
  (
    Table species_ref
    (
      species_code VARCHAR(24) PRIMARY KEY,
      species_label VARCHAR(120),
      family_code VARCHAR(24) NOT NULL
    )
    Table region_ref
    (
      region_code VARCHAR(24) PRIMARY KEY,
      region_label VARCHAR(120) NOT NULL
    )
  )

  Filter ActivePropagationFilter(
    and(
      equal(nursery.propagation_batch.active_flag, 'Y'),
      greaterThanEqual(nursery.propagation_batch.stage_no, 1)
    )
  )

  Join BatchToTray(nursery.propagation_batch.batch_code = nursery.bench_tray.batch_code)
  Join BatchToYield(nursery.propagation_batch.batch_code = nursery.batch_yield_view.batch_code)
  Join TrayToSpecies(nursery.bench_tray.species_code = catalog.species_ref.species_code)
  Join SpeciesToRegion(catalog.species_ref.family_code = catalog.region_ref.region_code)
)
