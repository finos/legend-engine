###Connection
RelationalDatabaseConnection test::kindlydelta5::connection::PropagationH2Connection
{
  store: test::kindlydelta5::store::PropagationDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists nursery;',
      'create schema nursery;',
      'drop schema if exists catalog;',
      'create schema catalog;',
      'create table nursery.propagation_batch (batch_code varchar(24) primary key, stage_no integer not null, batch_label varchar(120) not null, zone_code varchar(24) not null, planned_date date not null, recorded_at timestamp not null, active_flag char(1) not null);',
      'create table nursery.bench_tray (tray_code varchar(24) primary key, batch_code varchar(24) not null, tray_label varchar(120) not null, tray_format varchar(24), species_code varchar(24) not null, sown_count integer not null);',
      'create table catalog.species_ref (species_code varchar(24) primary key, species_label varchar(120), family_code varchar(24) not null);',
      'create table catalog.region_ref (region_code varchar(24) primary key, region_label varchar(120) not null);'
      ];
  };
  auth: DefaultH2;
}
