###Mapping
Mapping test::kindlydelta5::mapping::PropagationM2MMapping
(
  test::kindlydelta5::domain::VigourBand: EnumerationMapping VigourBandMapping
  {
    SPROUT: ['SPROUT'],
    READY: ['READY'],
    LUSH: ['LUSH']
  }

  test::kindlydelta5::domain::TrayFormat: EnumerationMapping TrayFormatMapping
  {
    CELL: ['CELL'],
    FLAT: ['FLAT'],
    OPEN: ['OPEN']
  }

  test::kindlydelta5::domain::StorageZone: EnumerationMapping StorageZoneMapping
  {
    COOL: ['COOL'],
    MILD: ['MILD'],
    WARM: ['WARM']
  }

  *test::kindlydelta5::domain::PropagationDigest[digest]: Pure
  {
    ~src test::kindlydelta5::domain::PropagationBatchRecord
    batchCode: $src.batchCode,
    digestLabel: if(
      $src.labelText->isEmpty(),
      | 'UNNAMED',
      | $src.labelText->toOne()->toUpper()->trim()
    ),
    labelLength: if(
      $src.labelText->isEmpty(),
      | 0,
      | $src.labelText->toOne()->length()
    ),
    vigour: EnumerationMapping VigourBandMapping: [if(
      $src.stageText->isEmpty(),
      | 'SPROUT',
      | if(
        $src.stageText->toOne()->toUpper()->trim() == 'MATURE',
        | 'LUSH',
        | 'READY'
      )
    )]->toOne(),
    trayFormat: EnumerationMapping TrayFormatMapping: [if(
      $src.trayFormatText->isEmpty(),
      | 'OPEN',
      | $src.trayFormatText->toOne()->toUpper()->trim()
    )]->toOne(),
    storageZone: EnumerationMapping StorageZoneMapping: [if(
      $src.zoneText->isEmpty(),
      | 'WARM',
      | $src.zoneText->toOne()->toUpper()->trim()
    )]->toOne()
  }
)
