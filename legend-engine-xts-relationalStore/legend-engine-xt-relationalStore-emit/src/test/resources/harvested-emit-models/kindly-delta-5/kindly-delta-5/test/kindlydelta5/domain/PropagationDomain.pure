###Pure
import test::kindlydelta5::domain::*;

Enum test::kindlydelta5::domain::VigourBand
{
  SPROUT,
  READY,
  LUSH
}

Enum test::kindlydelta5::domain::TrayFormat
{
  CELL,
  FLAT,
  OPEN
}

Enum test::kindlydelta5::domain::StorageZone
{
  COOL,
  MILD,
  WARM
}

Class test::kindlydelta5::domain::PropagationBatchRecord
{
  batchCode: String[1];
  stageText: String[0..1];
  trayFormatText: String[0..1];
  zoneText: String[0..1];
  labelText: String[0..1];
}

Class test::kindlydelta5::domain::PropagationDigest
{
  batchCode: String[1];
  digestLabel: String[1];
  labelLength: Integer[1];
  vigour: test::kindlydelta5::domain::VigourBand[1];
  trayFormat: test::kindlydelta5::domain::TrayFormat[1];
  storageZone: test::kindlydelta5::domain::StorageZone[1];
}

Class test::kindlydelta5::domain::PropagationBatch
{
  batchCode: String[1];
  stageNo: Integer[1];
  batchLabel: String[1];
  zoneCode: String[1];
  plannedDate: StrictDate[1];
  recordedAt: DateTime[1];
  stagedLabel: String[1];
  speciesSummary: String[0..1];
  trayFormatLabel: String[0..1];
  shortCode: String[1];
  labelLength: Integer[1];
  regionLabel: String[0..1];
  trayCount: Integer[0..1];
  vigour: test::kindlydelta5::domain::VigourBand[0..1];
  trayFormat: test::kindlydelta5::domain::TrayFormat[0..1];
  storageZone: test::kindlydelta5::domain::StorageZone[0..1];
}

Class test::kindlydelta5::domain::BenchTray
{
  trayCode: String[1];
  batchCode: String[1];
  trayLabel: String[1];
  trayFormatCode: String[0..1];
  speciesCode: String[1];
  sownCount: Integer[1];
}

Class test::kindlydelta5::domain::SpeciesRef
{
  speciesCode: String[1];
  speciesLabel: String[0..1];
  familyCode: String[1];
}

Class test::kindlydelta5::domain::RegionRef
{
  regionCode: String[1];
  regionLabel: String[1];
}

Class test::kindlydelta5::domain::BatchYield
{
  batchCode: String[1];
  trayCount: Integer[1];
  totalSown: Integer[1];
}

Association test::kindlydelta5::domain::Propagation_BenchTrays
{
  batch: PropagationBatch[1];
  trays: BenchTray[*];
}
