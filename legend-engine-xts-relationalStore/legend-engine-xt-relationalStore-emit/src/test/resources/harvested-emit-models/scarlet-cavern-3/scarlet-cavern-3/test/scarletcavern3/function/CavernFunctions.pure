###Pure
function test::scarletcavern3::function::lanternLabel(reference: String[1], revision: Integer[1]): String[1]
{
  'LT' + $revision->toString() + '-' + $reference->toUpper()->trim()
}

function test::scarletcavern3::function::gradeSentinel(code: String[0..1]): String[1]
{
  if($code->isEmpty(), | 'MOD', | $code->toOne()->toUpper()->trim())
}

function test::scarletcavern3::function::partySizeBand(size: Integer[0..1]): String[1]
{
  if($size->isEmpty(),
     | 'PARTY-NONE',
     | if($size->toOne() >= 40,
          | 'PARTY-6',
          | if($size->toOne() >= 30,
               | 'PARTY-5',
               | if($size->toOne() >= 20,
                    | 'PARTY-4',
                    | if($size->toOne() >= 12,
                         | 'PARTY-3',
                         | if($size->toOne() >= 6,
                              | 'PARTY-2',
                              | 'PARTY-1'))))))
}
