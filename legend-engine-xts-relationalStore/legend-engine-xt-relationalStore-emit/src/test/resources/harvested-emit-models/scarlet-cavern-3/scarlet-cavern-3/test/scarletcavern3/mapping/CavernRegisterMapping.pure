###Mapping
Mapping test::scarletcavern3::mapping::CavernRegisterMapping
(
  *test::scarletcavern3::domain::CaveChamber[chamber]: Relational
  {
    ~primaryKey
    (
      [test::scarletcavern3::store::CavernDb]cavern.cave_chamber.chamber_id
    )
    ~mainTable [test::scarletcavern3::store::CavernDb]cavern.cave_chamber
    chamberCode: [test::scarletcavern3::store::CavernDb]cavern.cave_chamber.chamber_code,
    chamberName: [test::scarletcavern3::store::CavernDb]cavern.cave_chamber.chamber_name,
    formationNote: [test::scarletcavern3::store::CavernDb]cavern.cave_chamber.formation_note
  }

  *test::scarletcavern3::domain::LanternWalk[walk]: Relational
  {
    ~primaryKey
    (
      [test::scarletcavern3::store::CavernDb]cavern.lantern_walk.walk_id
    )
    ~mainTable [test::scarletcavern3::store::CavernDb]cavern.lantern_walk
    walkCode: [test::scarletcavern3::store::CavernDb]cavern.lantern_walk.walk_code,
    guideName: [test::scarletcavern3::store::CavernDb]cavern.lantern_walk.guide_name,
    partySize: [test::scarletcavern3::store::CavernDb]cavern.lantern_walk.party_size,
    metresWalked: [test::scarletcavern3::store::CavernDb]cavern.lantern_walk.metres_walked
  }

  test::scarletcavern3::domain::Walk_Chamber: Relational
  {
    AssociationMapping
    (
      routedChamber[walk, chamber]: [test::scarletcavern3::store::CavernDb]@Walk_Chamber,
      walks[chamber, walk]: [test::scarletcavern3::store::CavernDb]@Walk_Chamber
    )
  }

  testSuites:
  [
    walkRegisterSuite:
    {
      function: |test::scarletcavern3::domain::LanternWalk.all()->project(
        [
          w|$w.walkCode,
          w|$w.guideName,
          w|$w.partySize,
          w|$w.metresWalked,
          w|$w.routedChamber.chamberCode,
          w|$w.routedChamber.chamberName,
          w|$w.routedChamber.formationNote,
          w|test::scarletcavern3::function::partySizeBand($w.partySize),
          w|test::scarletcavern3::function::lanternLabel($w.walkCode, 3)
        ],
        [
          'WalkCode',
          'GuideName',
          'PartySize',
          'MetresWalked',
          'ChamberCode',
          'ChamberName',
          'FormationNote',
          'PartyBand',
          'LanternLabel'
        ]
      )->sort(
        [
          asc('WalkCode')
        ]
      );
      tests:
      [
        walksAcrossTheChamberAssociation:
        {
          doc: 'The association resolves each booked walk to the chamber it is routed through, leaves the unrouted walk without one, and the party band and lantern label are computed by the shared functions over the resolved rows.';
          data:
          [
            test::scarletcavern3::store::CavernDb:
              Relational
              #{
                cavern.cave_chamber:
                  'chamber_id,chamber_code,chamber_name,formation_note\n'+
                  '1,CH-01,Lantern Hall,flowstone curtain on the east wall\n'+
                  '2,CH-02,Straw Gallery,soda straws above the walkway\n';

                cavern.lantern_walk:
                  'walk_id,walk_code,guide_name,party_size,metres_walked,chamber_id\n'+
                  '1,LW-01,Nella Thrift,34,420.5,1\n'+
                  '2,LW-02,Bram Ashby,8,180.0,2\n'+
                  '3,LW-03,Ivo Marram,14,260.25,\n';
              }#
          ];
          asserts:
          [
            threeWalksTwoRouted:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"WalkCode":"LW-01","GuideName":"Nella Thrift","PartySize":34,"MetresWalked":420.5,"ChamberCode":"CH-01","ChamberName":"Lantern Hall","FormationNote":"flowstone curtain on the east wall","PartyBand":"PARTY-5","LanternLabel":"LT3-LW-01"},{"WalkCode":"LW-02","GuideName":"Bram Ashby","PartySize":8,"MetresWalked":180.0,"ChamberCode":"CH-02","ChamberName":"Straw Gallery","FormationNote":"soda straws above the walkway","PartyBand":"PARTY-2","LanternLabel":"LT3-LW-02"},{"WalkCode":"LW-03","GuideName":"Ivo Marram","PartySize":14,"MetresWalked":260.25,"PartyBand":"PARTY-3","LanternLabel":"LT3-LW-03"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
