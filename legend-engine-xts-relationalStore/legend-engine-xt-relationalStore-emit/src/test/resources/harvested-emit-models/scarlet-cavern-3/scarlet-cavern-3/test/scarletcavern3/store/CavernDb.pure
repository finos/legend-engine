###Relational
Database test::scarletcavern3::store::CavernDb
(
  Schema cavern
  (
    Table cave_chamber
    (
      chamber_id INTEGER PRIMARY KEY,
      chamber_code VARCHAR(24) NOT NULL,
      chamber_name VARCHAR(120) NOT NULL,
      formation_note VARCHAR(240)
    )

    Table lantern_walk
    (
      walk_id INTEGER PRIMARY KEY,
      walk_code VARCHAR(24) NOT NULL,
      guide_name VARCHAR(120) NOT NULL,
      party_size INTEGER NOT NULL,
      metres_walked FLOAT NOT NULL,
      chamber_id INTEGER
    )
  )

  Join Walk_Chamber(cavern.lantern_walk.chamber_id = cavern.cave_chamber.chamber_id)
)
