###Relational
Database test::zephyrmeadow::store::MeadowArchiveStore
(
  Schema archive
  (
    Table restoration_site
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )

      site_code VARCHAR(20) PRIMARY KEY,
      site_name VARCHAR(120),
      region_code VARCHAR(20),
      regime_code VARCHAR(20),
      in_z DATE,
      out_z DATE
    )
    Table survey_visit
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )

      visit_code VARCHAR(20) PRIMARY KEY,
      site_code VARCHAR(20),
      stage_code VARCHAR(20),
      visited_on DATE,
      in_z DATE,
      out_z DATE
    )
    Table habitat_finding
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )

      finding_code VARCHAR(20) PRIMARY KEY,
      visit_code VARCHAR(20),
      review_visit_code VARCHAR(20),
      severity_code VARCHAR(20),
      status_code VARCHAR(20),
      appetite_code VARCHAR(20),
      finding_summary VARCHAR(200),
      escalation_note VARCHAR(200),
      in_z DATE,
      out_z DATE
    )
    Table meadow_region
    (
      region_code VARCHAR(20) PRIMARY KEY,
      region_name VARCHAR(120),
      steward_code VARCHAR(20)
    )
    Table steward_team
    (
      steward_code VARCHAR(20) PRIMARY KEY,
      team_name VARCHAR(120)
    )
    Table retirement_note
    (
      note_code VARCHAR(20) PRIMARY KEY,
      finding_code VARCHAR(20),
      note_text VARCHAR(200)
    )
  )

  Filter LiveFinding(archive.habitat_finding.status_code != 'CLOSED OUT')
  Filter EscalatedLiveFinding((trim(archive.habitat_finding.severity_code) = 'SEV' or trim(archive.habitat_finding.severity_code) = 'VSV') and archive.habitat_finding.status_code != 'CLOSED OUT')
  Filter ManagedSite(archive.restoration_site.regime_code != 'UNMANAGED')

  Join SiteToVisit(archive.restoration_site.site_code = archive.survey_visit.site_code)
  Join VisitToSite(archive.survey_visit.site_code = archive.restoration_site.site_code)
  Join VisitToFinding(archive.survey_visit.visit_code = archive.habitat_finding.visit_code)
  Join FindingToVisit(archive.habitat_finding.visit_code = archive.survey_visit.visit_code)
  Join VisitToReviewFinding(archive.survey_visit.visit_code = archive.habitat_finding.review_visit_code)
  Join FindingToReviewVisit(archive.habitat_finding.review_visit_code = archive.survey_visit.visit_code)
  Join SiteToRegion(archive.restoration_site.region_code = archive.meadow_region.region_code)
  Join RegionToSite(archive.meadow_region.region_code = archive.restoration_site.region_code)
  Join RegionToSteward(archive.meadow_region.steward_code = archive.steward_team.steward_code)
  Join StewardToRegion(archive.steward_team.steward_code = archive.meadow_region.steward_code)
  Join FindingToRetirementNote(archive.habitat_finding.finding_code = archive.retirement_note.finding_code)
)
