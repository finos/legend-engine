###Pure
import test::ivorythistle2::domain::*;

Class test::ivorythistle2::domain::NurseryRecord
{
  recordCode: String[1];
}

Class test::ivorythistle2::domain::Bench
{
  benchId: Integer[1];
  benchName: String[1];
  glasshouse: String[1];
}

Class test::ivorythistle2::domain::PropagationTray extends NurseryRecord
{
  trayLabel: String[1];
  cuttingCount: Integer[1];
  pottedAt: DateTime[1];
  hardenedOff: Boolean[1];
  bench: Bench[1];
}
