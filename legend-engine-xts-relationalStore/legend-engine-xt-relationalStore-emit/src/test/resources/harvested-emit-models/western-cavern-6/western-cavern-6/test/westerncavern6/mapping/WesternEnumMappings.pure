###Mapping
Mapping test::westerncavern6::mapping::WesternEnumMappings
(
  test::westerncavern6::domain::CavernStatus: EnumerationMapping StatusMapping
  {
    OPEN: ['OPEN'],
    GATED: ['GATE', 'GATED'],
    FLOODED: ['FLOOD']
  }

  test::westerncavern6::domain::PassageFlow: EnumerationMapping FlowMapping
  {
    DRY: ['D'],
    DAMP: ['M'],
    STREAM: ['S'],
    SUMP: ['P']
  }

  test::westerncavern6::domain::ChamberKind: EnumerationMapping KindMapping
  {
    HALL: [1],
    GROTTO: [2],
    SHAFT: [3, 4]
  }

  test::westerncavern6::domain::FloorType: EnumerationMapping FloorMapping
  {
    MUD: ['MU'],
    ROCK: ['RO'],
    SAND: ['SA']
  }
)
