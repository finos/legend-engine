###Service
Service test::silverdelta::service::StationEffortSummary
{
  pattern: '/delta/v1/stations/mass-summary/{observationDate}';
  title: 'Delta - Station Mass Summary As Of';
  owners:
  [
    'delta-ringing-scheme',
    'wetland-monitoring'
  ];
  documentation: 'Aggregating shape over the same point-in-time read: birds in force at the observation instant are projected with their station, grouped by station and delta arm, summed on recorded mass and ordered so the heaviest cohort leads.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: {observationDate: StrictDate[1]|test::silverdelta::domain::RingedBird.all($observationDate)->project(
      [
        b|$b.station.stationName,
        b|$b.station.deltaArm,
        b|$b.massGrams
      ],
      [
        'Station/Name',
        'Station/Arm',
        'Bird/MassGrams'
      ]
    )->groupBy(
      [
        'Station/Name',
        'Station/Arm'
      ],
      [
        agg('Station/MassGramsTotal', x|$x.getFloat('Bird/MassGrams'), y|$y->sum())
      ]
    )->sort(
      [
        desc('Station/MassGramsTotal')
      ]
    )->take(5);};
    mapping: test::silverdelta::mapping::DeltaMapping;
    runtime: test::silverdelta::runtime::DeltaRuntime;
  }
}
