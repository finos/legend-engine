###Mapping
Mapping test::silverdelta::mapping::DeltaMapping
(
  *test::silverdelta::domain::RingedBird[bird]: Relational
  {
    ~primaryKey
    (
      [test::silverdelta::store::DeltaDB]ringing.ringed_bird.bird_id
    )
    ~mainTable [test::silverdelta::store::DeltaDB]ringing.ringed_bird
    ringCode: [test::silverdelta::store::DeltaDB]ringing.ringed_bird.ring_code,
    ageClass: [test::silverdelta::store::DeltaDB]ringing.ringed_bird.age_class,
    wingLengthMm: [test::silverdelta::store::DeltaDB]ringing.ringed_bird.wing_length_mm,
    massGrams: [test::silverdelta::store::DeltaDB]ringing.ringed_bird.mass_grams
  }

  *test::silverdelta::domain::RingingStation[station]: Relational
  {
    ~primaryKey
    (
      [test::silverdelta::store::DeltaDB]ringing.ringing_station.station_id
    )
    ~mainTable [test::silverdelta::store::DeltaDB]ringing.ringing_station
    stationCode: [test::silverdelta::store::DeltaDB]ringing.ringing_station.station_code,
    stationName: [test::silverdelta::store::DeltaDB]ringing.ringing_station.station_name,
    deltaArm: [test::silverdelta::store::DeltaDB]ringing.ringing_station.delta_arm,
    staffedAllSeason: [test::silverdelta::store::DeltaDB]ringing.ringing_station.staffed_all_season
  }

  *test::silverdelta::domain::SpeciesTaxon[species]: Relational
  {
    ~primaryKey
    (
      [test::silverdelta::store::DeltaDB]ringing.species_taxon.species_id
    )
    ~mainTable [test::silverdelta::store::DeltaDB]ringing.species_taxon
    speciesCode: [test::silverdelta::store::DeltaDB]ringing.species_taxon.species_code,
    commonName: [test::silverdelta::store::DeltaDB]ringing.species_taxon.common_name,
    migrationStrategy: [test::silverdelta::store::DeltaDB]ringing.species_taxon.migration_strategy
  }

  *test::silverdelta::domain::CaptureEvent[capture]: Relational
  {
    ~primaryKey
    (
      [test::silverdelta::store::DeltaDB]ringing.capture_event.event_id
    )
    ~mainTable [test::silverdelta::store::DeltaDB]ringing.capture_event
    eventCode: [test::silverdelta::store::DeltaDB]ringing.capture_event.event_code,
    capturedOn: [test::silverdelta::store::DeltaDB]ringing.capture_event.captured_on,
