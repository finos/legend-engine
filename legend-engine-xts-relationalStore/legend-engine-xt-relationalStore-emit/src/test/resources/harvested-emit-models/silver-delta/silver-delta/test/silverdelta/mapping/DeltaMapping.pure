  test::silverdelta::domain::Bird_Station: Relational
  {
    AssociationMapping
    (
      station[bird, station]: [test::silverdelta::store::DeltaDB]@Bird_Station,
      bird[station, bird]: [test::silverdelta::store::DeltaDB]@Bird_Station
    )
  }

  test::silverdelta::domain::Bird_Species: Relational
  {
    AssociationMapping
    (
      species[bird, species]: [test::silverdelta::store::DeltaDB]@Bird_Species,
      birdOfSpecies[species, bird]: [test::silverdelta::store::DeltaDB]@Bird_Species
    )
  }

  test::silverdelta::domain::Bird_Capture: Relational
  {
    AssociationMapping
    (
      captures[bird, capture]: [test::silverdelta::store::DeltaDB]@Bird_Capture,
      capturedBird[capture, bird]: [test::silverdelta::store::DeltaDB]@Bird_Capture
    )
  }
)
