###Relational
Database test::silverdelta::store::DeltaDB
(
  Schema ringing
  (
    Table ringed_bird
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      bird_id INTEGER PRIMARY KEY,
      ring_code VARCHAR(20) NOT NULL,
      age_class VARCHAR(10) NOT NULL,
      wing_length_mm DOUBLE NOT NULL,
      mass_grams DOUBLE NOT NULL,
      station_id INTEGER NOT NULL,
      species_id INTEGER NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
    Table ringing_station
    (
      station_id INTEGER PRIMARY KEY,
      station_code VARCHAR(20) NOT NULL,
      station_name VARCHAR(120) NOT NULL,
      delta_arm VARCHAR(60) NOT NULL,
      staffed_all_season BIT NOT NULL
    )
    Table species_taxon
    (
      species_id INTEGER PRIMARY KEY,
      species_code VARCHAR(20) NOT NULL,
      common_name VARCHAR(120) NOT NULL,
      migration_strategy VARCHAR(40) NOT NULL
    )
    Table capture_event
    (
      event_id INTEGER PRIMARY KEY,
      event_code VARCHAR(20) NOT NULL,
      captured_on DATE NOT NULL,
      net_hours DOUBLE NOT NULL,
      observer_name VARCHAR(120) NOT NULL,
      condition_code VARCHAR(20) NOT NULL,
      bird_id INTEGER NOT NULL
    )
  )

  Join Bird_Station(ringing.ringed_bird.station_id = ringing.ringing_station.station_id)

  Join Bird_Species(ringing.ringed_bird.species_id = ringing.species_taxon.species_id)

  Join Bird_Capture(ringing.ringed_bird.bird_id = ringing.capture_event.bird_id)
)
