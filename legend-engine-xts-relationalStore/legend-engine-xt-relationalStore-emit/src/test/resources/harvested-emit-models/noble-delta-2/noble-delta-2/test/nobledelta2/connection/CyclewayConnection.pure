###Connection
RelationalDatabaseConnection demo::nobledelta2::connection::CyclewayH2Connection
{
  store: demo::nobledelta2::store::CyclewayDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists network;',
      'create schema network;',
      'create table network.planning_district (district_ref varchar(20) primary key, district_label varchar(120) not null);',
      'create table network.path_segment (segment_ref varchar(20) primary key, segment_label varchar(120) not null, district_ref varchar(20) not null);',
      'create table network.counter_unit (counter_ref varchar(20) primary key, segment_ref varchar(20) not null, unit_label varchar(120) not null, mount_code varchar(8) not null, active_flag char(1) not null);',
      'create table network.count_session (session_ref varchar(20) primary key, counter_ref varchar(20) not null, weather_code varchar(8), surface_code varchar(8), rider_total integer, note_text varchar(240), retired_flag char(1) not null);'
      ];
  };
  auth: DefaultH2;
}
