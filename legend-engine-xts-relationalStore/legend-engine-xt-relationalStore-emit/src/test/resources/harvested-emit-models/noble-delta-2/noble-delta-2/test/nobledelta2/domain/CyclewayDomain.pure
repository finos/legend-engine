import demo::nobledelta2::domain::*;

Class {meta::pure::profiles::doc.doc = 'One counting window recorded on a cycleway, carrying the classified weather and surface bands derived from the raw survey codes.'} demo::nobledelta2::domain::CountSession
{
  sessionRef: String[1];
  riderTotal: Integer[0..1];
  weatherBand: String[0..1];
  crowdTier: String[1];
  surfaceState: String[1];
  noteLabel: String[0..1];
  codeLength: Integer[1];
  codePrefix: String[0..1];
  programme: String[1];
  surfaceSetTier: String[1];
  unitLabel: String[0..1];
  segmentLabel: String[0..1];
  districtLabel: String[0..1];

  busyWindow()
  {
    if($this.riderTotal->isNotEmpty() && ($this.riderTotal->toOne() > 100), |'busy-window', |'quiet-window')
  }: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A counting unit mounted on a cycleway segment.'} demo::nobledelta2::domain::CounterUnit
{
  counterRef: String[1];
  unitLabel: String[1];
  mountCode: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A stretch of cycleway that belongs to a planning district.'} demo::nobledelta2::domain::PathSegment
{
  segmentRef: String[1];
  segmentLabel: String[1];
}

Association {meta::pure::profiles::doc.doc = 'Relates each counting window to the unit that recorded it.'} demo::nobledelta2::domain::Session_Unit
{
  countedBy: CounterUnit[0..1];
  sessions: CountSession[*];
}
