###Mapping
Mapping test::crimsonprairie3::mapping::PrairieMapping
(
  *test::crimsonprairie3::domain::PlotReading[plotReadingSet]: Relational
  {
    ~primaryKey
    (
      [test::crimsonprairie3::store::PrairieDB]grassland.plot_reading.reading_digest
    )
    ~mainTable [test::crimsonprairie3::store::PrairieDB]grassland.plot_reading
    readingDigest: [test::crimsonprairie3::store::PrairieDB]grassland.plot_reading.reading_digest,
    readingRef: [test::crimsonprairie3::store::PrairieDB]grassland.plot_reading.reading_ref,
    plotName: [test::crimsonprairie3::store::PrairieDB]grassland.plot_reading.plot_name,
    grassCoverPct: [test::crimsonprairie3::store::PrairieDB]grassland.plot_reading.grass_cover_pct,
    observedOn: [test::crimsonprairie3::store::PrairieDB]grassland.plot_reading.observed_on,
    lakeBatchIn: [test::crimsonprairie3::store::PrairieDB]grassland.plot_reading.lake_batch_in,
    lakeBatchOut: [test::crimsonprairie3::store::PrairieDB]grassland.plot_reading.lake_batch_out
  }

  testSuites:
  [
    plotReadingSuite:
    {
      function: test::crimsonprairie3::domain::PlotReading.all()->filter(r|$r.grassCoverPct->toOne() >= 25.0)->project(~[readingRef: r|$r.readingRef, plotTag: r|$r.plotName->toUpper(), coverStep: r|$r.grassCoverPct->toOne()->round()->toString(), digestTag: r|$r.readingDigest->substr(0, 5)->toUpper(), batchIn: r|$r.lakeBatchIn, batchOut: r|$r.lakeBatchOut]);
      tests:
      [
        coveredReadingsCarryBatchWindow:
        {
          doc: 'Reads the reading extent whose identity is the digest bookkeeping column rather than a payload column, and projects the payload alongside both batch boundary markers so the lake columns travel with every row the class yields.';
          data:
          [
            test::crimsonprairie3::store::PrairieDB:
              Relational
              #{
                grassland.plot_reading:
                  'reading_digest,reading_ref,plot_name,grass_cover_pct,observed_on,lake_batch_in,lake_batch_out\n'+
                  'D-AAA1,RD-01,north swale,42.400,2025-04-02,1001,999999999\n'+
                  'D-BBB2,RD-02,mid ridge,27.200,2025-04-09,1002,999999999\n'+
                  'D-CCC3,RD-03,south hollow,11.750,2025-04-16,1003,1004\n';
              }#
          ];
          asserts:
          [
            twoCoveredReadings:
              Relation
              #{
                readingRef,plotTag,coverStep,digestTag,batchIn,batchOut
                RD-01,NORTH SWALE,42,D-AAA,1001,999999999
                RD-02,MID RIDGE,27,D-BBB,1002,999999999;
              }#
          ];
        }
      ];
    }
  ]
)
