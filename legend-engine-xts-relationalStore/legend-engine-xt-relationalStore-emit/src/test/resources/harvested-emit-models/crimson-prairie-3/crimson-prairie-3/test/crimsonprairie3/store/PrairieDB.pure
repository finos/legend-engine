###Relational
Database test::crimsonprairie3::store::PrairieDB
(
  Schema grassland
  (
    Table plot_reading
    (
      reading_digest VARCHAR(64) PRIMARY KEY,
      reading_ref VARCHAR(32),
      plot_name VARCHAR(64),
      grass_cover_pct DECIMAL(9,3),
      observed_on DATE,
      lake_batch_in DECIMAL(38,0),
      lake_batch_out DECIMAL(38,0)
    )
  )
)
