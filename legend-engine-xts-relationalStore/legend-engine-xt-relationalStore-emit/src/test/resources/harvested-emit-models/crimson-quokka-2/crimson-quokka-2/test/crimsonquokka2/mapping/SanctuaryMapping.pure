###Mapping
Mapping test::crimsonquokka2::mapping::SanctuaryMapping
(
  *test::crimsonquokka2::domain::BurrowColony: Relational
  {
    ~primaryKey
    (
      [test::crimsonquokka2::store::SanctuaryDatabase]sanctuary.burrow_colony.colony_id
    )
    ~mainTable [test::crimsonquokka2::store::SanctuaryDatabase]sanctuary.burrow_colony
    colonyCode: [test::crimsonquokka2::store::SanctuaryDatabase]sanctuary.burrow_colony.colony_code,
    zone: EnumerationMapping HabitatZoneMapping: [test::crimsonquokka2::store::SanctuaryDatabase]sanctuary.burrow_colony.habitat_zone,
    steward: [test::crimsonquokka2::store::SanctuaryDatabase]@Colony_Steward
  }

  *test::crimsonquokka2::domain::FieldSteward: Relational
  {
    ~primaryKey
    (
      [test::crimsonquokka2::store::SanctuaryDatabase]sanctuary.field_steward.steward_id
    )
    ~mainTable [test::crimsonquokka2::store::SanctuaryDatabase]sanctuary.field_steward
    stewardCode: [test::crimsonquokka2::store::SanctuaryDatabase]sanctuary.field_steward.steward_code,
    radioTag: [test::crimsonquokka2::store::SanctuaryDatabase]sanctuary.field_steward.radio_tag
  }

  test::crimsonquokka2::domain::HabitatZone: EnumerationMapping HabitatZoneMapping
  {
    RIVERINE: ['RIV'],
    HEATHLAND: ['HEA'],
    DUNE: ['DUN']
  }

  testSuites:
  [
    taggedColonySuite:
    {
      function: |test::crimsonquokka2::domain::BurrowColony.all(%2026-06-01)->filter(
  c|(($c.colonyCode->startsWith('COL')) && ($c.steward.radioTag->isEmpty()->not()))
)->project(
  [
    c|$c.colonyCode,
    c|$c.steward.radioTag->toOne()->toUpper()
  ],
  [
    'Colony',
    'Steward Tag'
  ]
)->distinct()->sort(
  [
    asc('Colony')
  ]
);
      tests:
      [
        coloniesWithARadioTag:
        {
          doc: 'Opens the colony extent at a literal date and keeps the colonies whose steward carries a radio tag, so the absent-tag row, the absent-steward row and the version whose window closed before the date are all excluded while the tag is upper-cased on the way out.';
          data:
          [
            test::crimsonquokka2::store::SanctuaryDatabase:
              Relational
              #{
                sanctuary.burrow_colony:
                  'colony_id,colony_code,habitat_zone,steward_id,from_z,thru_z\n'+
                  '1,COL-A,RIV,100,2026-01-01,9999-12-31\n'+
                  '2,COL-B,RIV,200,2026-01-01,9999-12-31\n'+
                  '3,COL-C,HEA,100,2026-01-01,9999-12-31\n'+
                  '4,COL-D,RIV,100,2024-01-01,2026-01-01\n'+
                  '5,COL-E,RIV,,2026-01-01,9999-12-31\n';

                sanctuary.field_steward:
                  'steward_id,steward_code,radio_tag\n'+
                  '100,STW-A,tag-alpha\n'+
                  '200,STW-B,\n';
              }#
          ];
          asserts:
          [
            onlyTheTaggedColonies:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Colony":"COL-A","Steward Tag":"TAG-ALPHA"},{"Colony":"COL-C","Steward Tag":"TAG-ALPHA"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
