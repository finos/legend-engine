###Connection
RelationalDatabaseConnection test::crimsonquokka2::connection::SanctuaryH2Connection
{
  store: test::crimsonquokka2::store::SanctuaryDatabase;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists sanctuary;',
      'create schema sanctuary;',
      'create table sanctuary.burrow_colony (colony_id integer not null, colony_code varchar(20) not null, habitat_zone varchar(20) not null, steward_id integer, from_z date, thru_z date);',
      'create table sanctuary.field_steward (steward_id integer primary key, steward_code varchar(20) not null, radio_tag varchar(20));'
      ];
  };
  auth: DefaultH2;
}
