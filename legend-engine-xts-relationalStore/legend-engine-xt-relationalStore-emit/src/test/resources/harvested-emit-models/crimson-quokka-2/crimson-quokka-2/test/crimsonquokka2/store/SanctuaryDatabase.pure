###Relational
Database test::crimsonquokka2::store::SanctuaryDatabase
(
  Schema sanctuary
  (
    Table burrow_colony
    (
      milestoning
      (
        business(BUS_FROM=from_z, BUS_THRU=thru_z)
      )
      colony_id INTEGER PRIMARY KEY,
      colony_code VARCHAR(20) NOT NULL,
      habitat_zone VARCHAR(20) NOT NULL,
      steward_id INTEGER,
      from_z DATE PRIMARY KEY,
      thru_z DATE
    )
    Table field_steward
    (
      steward_id INTEGER PRIMARY KEY,
      steward_code VARCHAR(20) NOT NULL,
      radio_tag VARCHAR(20)
    )
  )

  Join Colony_Steward(sanctuary.burrow_colony.steward_id = sanctuary.field_steward.steward_id)
)
