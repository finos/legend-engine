###Connection
RelationalDatabaseConnection test::ivoryprairie::connection::PrairieH2Connection
{
  store: test::ivoryprairie::store::PrairieDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists prairie;',
      'create schema prairie;',
      'create table prairie.meadow (meadow_id integer, meadow_name varchar(200) not null, wildflower_count integer not null, from_z date not null, thru_z date);',
      'insert into prairie.meadow values (1, \'North Meadow\', 40, DATE \'2023-01-01\', DATE \'9999-12-31\');'
      ];
  };
  auth: DefaultH2;
}
