###Service
Service test::ivoryprairie::service::MeadowsAsOf
{
  pattern: '/prairie/v1/meadows/{businessDate}';
  title: 'Meadow Wildflower Census As Of';
  owners:
  [
    'prairie-survey',
    'meadow-ops'
  ];
  documentation: 'Returns the wildflower census of prairie meadows as of the requested business date, exercising business-temporal milestoning and a point-in-time query over the in-process H2 PrairieRuntime.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {businessDate: StrictDate[1]|test::ivoryprairie::domain::Meadow.all($businessDate)->project(
      [
        x|$x.name,
        x|$x.wildflowerCount
      ],
      [
        'Meadow',
        'WildflowerCount'
      ]
    )->sort(
      [
        asc('Meadow')
      ]
    )};
    mapping: test::ivoryprairie::mapping::PrairieMapping;
    runtime: test::ivoryprairie::runtime::PrairieRuntime;
  }
  testSuites:
  [
    meadowsAsOfSuite:
    {
      data:
      [
        connections:
        [
          h2Connection:
            Relational
            #{
              prairie.meadow:
                'meadow_id,meadow_name,wildflower_count,from_z,thru_z\n'+
                '1,North Meadow,40,2023-01-01,9999-12-31\n';
            }#
        ]
      ]
      tests:
      [
        midYear:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            businessDate = %2023-06-01
          ]
          asserts:
          [
            oneMeadow:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Meadow":"North Meadow","WildflowerCount":40}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
