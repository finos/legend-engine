###Connection
RelationalDatabaseConnection test::lunarotter::connection::WildlifeH2Connection
{
  store: test::lunarotter::store::WildlifeDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists wildlife;',
      'create schema wildlife;',
      'create table wildlife.region (region_id integer primary key, region_name varchar(200) not null);',
      'create table wildlife.habitat (habitat_id integer primary key, habitat_name varchar(200) not null, region_id integer not null);',
      'create table wildlife.otter (otter_id integer primary key, otter_name varchar(200) not null, weight_kg double not null, habitat_id integer not null);',
      'insert into wildlife.region values (1, \'Northern Fenland\');',
      'insert into wildlife.region values (2, \'Coastal Estuary\');',
      'insert into wildlife.habitat values (1, \'Willow Bend\', 1);',
      'insert into wildlife.habitat values (2, \'Tidal Creek\', 2);',
      'insert into wildlife.otter values (1, \'Pebble\', 8.4, 1);',
      'insert into wildlife.otter values (2, \'Ripple\', 6.1, 1);',
      'insert into wildlife.otter values (3, \'Marsh\', 9.2, 2);'
      ];
  };
  auth: DefaultH2;
}
