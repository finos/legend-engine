###Service
Service test::lunarotter::service::OttersByRegion
{
  pattern: '/wildlife/v1/otters/{regionName}';
  title: 'River Otters by Region';
  owners:
  [
    'wildlife-survey',
    'river-ecology'
  ];
  documentation: 'Returns tagged river otters whose habitat lies in the given region and whose weight is at least minWeight. Walks the Otter_Habitat and Habitat_Region joins over the in-process H2 WildlifeRuntime.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {regionName: String[1], minWeight: Float[1]|test::lunarotter::domain::Otter.all()->filter(
      o|($o.habitat.region.name == $regionName) && ($o.weightKg >= $minWeight)
    )->project(
      [
        o|$o.name,
        o|$o.weightKg
      ],
      [
        'Otter',
        'WeightKg'
      ]
    )};
    mapping: test::lunarotter::mapping::WildlifeMapping;
    runtime: test::lunarotter::runtime::WildlifeRuntime;
  }
  testSuites:
  [
    ottersByRegionSuite:
    {
      data:
      [
        connections:
        [
          h2Connection:
            Relational
            #{
              wildlife.region:
                'region_id,region_name\n'+
                '1,Northern Fenland\n'+
                '2,Coastal Estuary\n';
              wildlife.habitat:
                'habitat_id,habitat_name,region_id\n'+
                '1,Willow Bend,1\n'+
                '2,Tidal Creek,2\n';
              wildlife.otter:
                'otter_id,otter_name,weight_kg,habitat_id\n'+
                '1,Pebble,8.4,1\n'+
                '2,Ripple,6.1,1\n'+
                '3,Marsh,9.2,2\n';
            }#
        ]
      ]
      tests:
      [
        fenlandHeavyOtters:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            regionName = 'Northern Fenland',
            minWeight = 7.0
          ]
          asserts:
          [
            onlyPebble:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Otter":"Pebble","WeightKg":8.4}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
