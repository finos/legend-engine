###Relational
Database test::lunarotter::store::WildlifeDB
(
  Schema wildlife
  (
    Table region
    (
      region_id INTEGER PRIMARY KEY,
      region_name VARCHAR(200) NOT NULL
    )
    Table habitat
    (
      habitat_id INTEGER PRIMARY KEY,
      habitat_name VARCHAR(200) NOT NULL,
      region_id INTEGER NOT NULL
    )
    Table otter
    (
      otter_id INTEGER PRIMARY KEY,
      otter_name VARCHAR(200) NOT NULL,
      weight_kg DOUBLE NOT NULL,
      habitat_id INTEGER NOT NULL
    )
  )

  Join Otter_Habitat(wildlife.otter.habitat_id = wildlife.habitat.habitat_id)
  Join Habitat_Region(wildlife.habitat.region_id = wildlife.region.region_id)
)
