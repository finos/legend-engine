Class {meta::pure::profiles::doc.doc = 'A protected drainage region monitored by the river-otter survey programme.'} test::lunarotter::domain::Region
{
  name: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A riverbank habitat patch that belongs to a monitored region.'} test::lunarotter::domain::Habitat
{
  name: String[1];
  region: test::lunarotter::domain::Region[1];
}

Class {meta::pure::profiles::doc.doc = 'An individually tagged river otter observed within a habitat patch.'} test::lunarotter::domain::Otter
{
  name: String[1];
  weightKg: Float[1];
  habitat: test::lunarotter::domain::Habitat[1];
}
