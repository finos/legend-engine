###Pure
import meta::pure::profiles::*;

Class {doc.doc = 'One section of raised boardwalk carried across a marsh reserve.'} test::embermarsh3::domain::BoardwalkSection
{
  sectionCode: String[1];
  reserveName: String[1];
  plankCount: Integer[1];
  lengthM: Float[1];
  surveyedOn: StrictDate[1];
}

Class {doc.doc = 'One patrol walked over a boardwalk section by a reserve warden.'} test::embermarsh3::domain::WardenPatrol
{
  patrolCode: String[1];
  sectionCode: String[1];
  wardenCode: String[1];
  patrolledOn: StrictDate[1];
  hazardCount: Integer[1];
  patrolNote: String[1];
  section: test::embermarsh3::domain::BoardwalkSection[1];
}
