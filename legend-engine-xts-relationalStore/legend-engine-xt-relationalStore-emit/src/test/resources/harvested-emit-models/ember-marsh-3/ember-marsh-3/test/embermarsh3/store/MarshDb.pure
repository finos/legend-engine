###Relational
Database test::embermarsh3::store::MarshDb
(
  Schema marsh
  (
    Table boardwalk_section
    (
      section_code VARCHAR(24) PRIMARY KEY,
      reserve_name VARCHAR(60),
      plank_count INTEGER,
      length_m DOUBLE,
      surveyed_on DATE
    )

    Table warden_patrol
    (
      patrol_code VARCHAR(24) PRIMARY KEY,
      section_code VARCHAR(24),
      warden_code VARCHAR(12),
      patrolled_on DATE,
      hazard_count INTEGER,
      patrol_note VARCHAR(240)
    )
  )

  Join SectionPatrol
  (
    marsh.warden_patrol.section_code = marsh.boardwalk_section.section_code
  )
)
