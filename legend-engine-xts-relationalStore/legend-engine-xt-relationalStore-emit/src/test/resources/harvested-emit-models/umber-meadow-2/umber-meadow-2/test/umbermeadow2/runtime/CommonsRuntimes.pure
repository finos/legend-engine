###Runtime
Runtime test::umbermeadow2::runtime::CommonsRegisterRuntime
{
  mappings:
  [
    test::umbermeadow2::mapping::GrazingMapping
  ];
  connections:
  [
    test::umbermeadow2::store::CommonsDb:
    [
      commonsRegisterConnection: test::umbermeadow2::connection::CommonsRegisterConnection
    ]
  ];
}

Runtime test::umbermeadow2::runtime::CommonsMirrorRuntime
{
  mappings:
  [
    test::umbermeadow2::mapping::GrazingMirrorMapping
  ];
  connections:
  [
    test::umbermeadow2::store::CommonsDb:
    [
      commonsMirrorConnection: test::umbermeadow2::connection::CommonsMirrorConnection
    ]
  ];
}
