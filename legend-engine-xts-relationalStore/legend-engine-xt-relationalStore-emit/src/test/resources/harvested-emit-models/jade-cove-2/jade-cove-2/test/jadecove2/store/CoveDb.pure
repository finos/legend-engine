###Relational
Database test::jadecove2::store::CoveDb
(
  Schema shore
  (
    Table tide_pool
    (
      pool_id INTEGER PRIMARY KEY,
      pool_code VARCHAR(24) NOT NULL,
      shore_code VARCHAR(16) NOT NULL,
      salinity_ppt DECIMAL(5, 2) NOT NULL,
      water_depth_cm INTEGER NOT NULL,
      substrate_code VARCHAR(16) NOT NULL,
      surveyor_code VARCHAR(16) NOT NULL
    )
    Table shore_reach
    (
      reach_id INTEGER PRIMARY KEY,
      shore_code VARCHAR(16) NOT NULL,
      reach_name VARCHAR(120) NOT NULL,
      warden_name VARCHAR(120) NOT NULL
    )
  )

  Join Pool_Reach(shore.tide_pool.shore_code = shore.shore_reach.shore_code)
)
