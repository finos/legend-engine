###Pure
import test::jadecove2::function::*;

function {meta::pure::profiles::doc.doc = 'Bands a handed-in sample grade, folding anything unrecognised onto a review band.'} test::jadecove2::function::gradeBand(sampleGrade: String[1]): String[1]
{
  if($sampleGrade->trim()->toUpper() == 'CLEAN',
    |'CLEAN-SAMPLE',
    |if($sampleGrade->trim()->toUpper() == 'SILTED', |'SILTED-SAMPLE', |'REVIEW-SAMPLE'))
}

function {meta::pure::profiles::doc.doc = 'Summarises a shore walker note, falling back when nothing was written down.'} test::jadecove2::function::noteSummary(sampleNote: String[1]): String[1]
{
  if($sampleNote->trim() == '', |'NO-NOTE', |'NOTE:' + $sampleNote->trim()->toUpper())
}

function {meta::pure::profiles::doc.doc = 'Folds a technician code to a single spelling for the digest.'} test::jadecove2::function::technicianLabel(technicianCode: String[1]): String[1]
{
  'TECH/' + $technicianCode->trim()->toUpper()
}
