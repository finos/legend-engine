###Mapping
Mapping test::borealcove::mapping::SurveyMapping
(
  *test::borealcove::domain::TaggedAnimal[taggedAnimal]: Relational
  {
    ~primaryKey
    (
      [test::borealcove::store::SurveyDB]fieldsurvey.tagged_animal.tag_id
    )
    ~mainTable [test::borealcove::store::SurveyDB]fieldsurvey.tagged_animal
    tagCode: [test::borealcove::store::SurveyDB]fieldsurvey.tagged_animal.tag_code,
    speciesCode: [test::borealcove::store::SurveyDB]fieldsurvey.tagged_animal.species_code,
    regionCode: [test::borealcove::store::SurveyDB]fieldsurvey.tagged_animal.region_code,
    habitatCode: [test::borealcove::store::SurveyDB]fieldsurvey.tagged_animal.habitat_code,
    massGrams: [test::borealcove::store::SurveyDB]fieldsurvey.tagged_animal.mass_grams,
    wingSpanMm: [test::borealcove::store::SurveyDB]fieldsurvey.tagged_animal.wing_span_mm,
    releasedAlive: [test::borealcove::store::SurveyDB]fieldsurvey.tagged_animal.released_alive,
    surveyorName: [test::borealcove::store::SurveyDB]fieldsurvey.tagged_animal.surveyor_name,
    sightingCount: [test::borealcove::store::SurveyDB]fieldsurvey.tagged_animal.sighting_count
  }

  testSuites:
  [
    resightingFloorSuite:
    {
      function: |test::borealcove::domain::TaggedAnimal.all()->filter(
  a|$a.sightingCount > test::borealcove::domain::resightingFloor($a.regionCode)
)->project(
  [
    a|$a.tagCode,
    a|$a.regionCode,
    a|$a.sightingCount
  ],
  [
    'TagCode',
    'RegionCode',
    'SightingCount'
  ]
)->sort(
  [
    asc('TagCode')
  ]
);
      tests:
      [
        everyRegionFloorArm:
        {
          doc: 'One region per arm of the re-sighting floor helper, each with a row above and a row at or below its floor, so the northern arm, the fen arm and the fallback arm are all distinguished.';
          data:
          [
            test::borealcove::store::SurveyDB:
              Relational
              #{
                fieldsurvey.tagged_animal:
                  'tag_id,tag_code,species_code,region_code,habitat_code,mass_grams,wing_span_mm,released_alive,surveyor_name,sighting_count\n'+
                  '1,TG-1001,SNOWFINCH,NORTHSHORE,TUNDRA,120,410,true,Wren Halloway,6\n'+
                  '2,TG-1002,SNOWFINCH,EASTRIDGE,SCRUB,95,360,true,Wren Halloway,3\n'+
                  '3,TG-1003,SNOWFINCH,WESTFLATS,MARSH,140,455,false,Iver Solheim,9\n'+
                  '4,TG-1004,PLOVER,SOUTHFEN,MARSH,210,520,true,Iver Solheim,2\n'+
                  '5,TG-1005,SNOWFINCH,NORTHSHORE,TUNDRA,88,300,true,Iver Solheim,1\n'+
                  '6,TG-1006,PLOVER,UPLANDS,SCRUB,260,610,false,Wren Halloway,7\n'+
                  '7,TG-1007,SNOWFINCH,EASTRIDGE,TUNDRA,150,470,true,Wren Halloway,5\n'+
                  '8,TG-1008,PLOVER,ISLETS,DUNE,180,505,true,Iver Solheim,4\n'+
                  '9,TG-1009,PLOVER,SOUTHFEN,MARSH,200,500,true,Wren Halloway,3\n';
              }#
          ];
          asserts:
          [
            onlyTagsAboveTheirRegionFloor:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"TagCode":"TG-1001","RegionCode":"NORTHSHORE","SightingCount":6},{"TagCode":"TG-1002","RegionCode":"EASTRIDGE","SightingCount":3},{"TagCode":"TG-1003","RegionCode":"WESTFLATS","SightingCount":9},{"TagCode":"TG-1006","RegionCode":"UPLANDS","SightingCount":7},{"TagCode":"TG-1007","RegionCode":"EASTRIDGE","SightingCount":5},{"TagCode":"TG-1008","RegionCode":"ISLETS","SightingCount":4},{"TagCode":"TG-1009","RegionCode":"SOUTHFEN","SightingCount":3}]';
                  }#;
              }#
          ];
        }
      ];
    },
    recoveredHabitatSuite:
    {
      function: |test::borealcove::domain::TaggedAnimal.all()->filter(
  a|$a.habitatCode->in(['MARSH', 'DUNE']) && ($a.releasedAlive == false)
)->project(
  [
    a|$a.tagCode,
    a|$a.habitatCode,
    a|$a.releasedAlive
  ],
  [
    'TagCode',
    'HabitatCode',
    'ReleasedAlive'
  ]
)->sort(
  [
    asc('TagCode')
  ]
);
      tests:
      [
        membershipAndReleaseState:
        {
          doc: 'Three rows inside the habitat set and one outside it, with only one of the members not released alive, so the membership test and the boolean conjunct are each shown to remove rows on their own.';
          data:
          [
            test::borealcove::store::SurveyDB:
              Relational
              #{
                fieldsurvey.tagged_animal:
                  'tag_id,tag_code,species_code,region_code,habitat_code,mass_grams,wing_span_mm,released_alive,surveyor_name,sighting_count\n'+
                  '1,TG-1001,SNOWFINCH,NORTHSHORE,TUNDRA,120,410,true,Wren Halloway,6\n'+
                  '2,TG-1002,SNOWFINCH,EASTRIDGE,SCRUB,95,360,true,Wren Halloway,3\n'+
                  '3,TG-1003,SNOWFINCH,WESTFLATS,MARSH,140,455,false,Iver Solheim,9\n'+
                  '4,TG-1004,PLOVER,SOUTHFEN,MARSH,210,520,true,Iver Solheim,2\n'+
                  '5,TG-1005,SNOWFINCH,NORTHSHORE,TUNDRA,88,300,true,Iver Solheim,1\n'+
                  '6,TG-1006,PLOVER,UPLANDS,SCRUB,260,610,false,Wren Halloway,7\n'+
                  '7,TG-1007,SNOWFINCH,EASTRIDGE,TUNDRA,150,470,true,Wren Halloway,5\n'+
                  '8,TG-1008,PLOVER,ISLETS,DUNE,180,505,true,Iver Solheim,4\n'+
                  '9,TG-1009,PLOVER,SOUTHFEN,MARSH,200,500,true,Wren Halloway,3\n';
              }#
          ];
          asserts:
          [
            onlyTheUnreleasedMarshTag:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"TagCode":"TG-1003","HabitatCode":"MARSH","ReleasedAlive":false}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
