import test::borealcove::domain::*;

Class {meta::pure::profiles::doc.doc = 'An individual animal fitted with a tracking tag during a field survey.'} test::borealcove::domain::TaggedAnimal
{
  {meta::pure::profiles::doc.doc = 'Code stamped on the tracking tag.'} tagCode: String[1];
  {meta::pure::profiles::doc.doc = 'Short code of the species the animal belongs to.'} speciesCode: String[1];
  {meta::pure::profiles::doc.doc = 'Survey region the animal was tagged in.'} regionCode: String[1];
  {meta::pure::profiles::doc.doc = 'Habitat class recorded at the tagging site.'} habitatCode: String[1];
  {meta::pure::profiles::doc.doc = 'Recorded mass of the animal in grams.'} massGrams: Integer[1];
  {meta::pure::profiles::doc.doc = 'Recorded wing span of the animal in millimetres.'} wingSpanMm: Integer[1];
  {meta::pure::profiles::doc.doc = 'Whether the animal was released alive after tagging.'} releasedAlive: Boolean[1];
  {meta::pure::profiles::doc.doc = 'Field name of the surveyor who fitted the tag.'} surveyorName: String[1];
  {meta::pure::profiles::doc.doc = 'Number of times the tag has been re-sighted since release.'} sightingCount: Integer[1];
}

function {meta::pure::profiles::doc.doc = 'Minimum re-sighting count a survey region has to clear before its animals count as well observed. An absent region falls back to the loosest floor.'} test::borealcove::domain::resightingFloor(regionCode: String[0..1]): Integer[1]
{
  if($regionCode->isEmpty(),
    | 1,
    | if($regionCode->toOne()->toUpper()->startsWith('NORTH'),
        | 4,
        | if($regionCode->toOne()->toUpper()->contains('FEN'), | 2, | 1)))
}
