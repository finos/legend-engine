###Relational
Database test::borealcove::store::SurveyDB
(
  Schema fieldsurvey
  (
    Table tagged_animal
    (
      tag_id INTEGER PRIMARY KEY,
      tag_code VARCHAR(20) NOT NULL,
      species_code VARCHAR(20) NOT NULL,
      region_code VARCHAR(20) NOT NULL,
      habitat_code VARCHAR(20) NOT NULL,
      mass_grams INTEGER NOT NULL,
      wing_span_mm INTEGER NOT NULL,
      released_alive BIT NOT NULL,
      surveyor_name VARCHAR(120) NOT NULL,
      sighting_count INTEGER NOT NULL
    )
  )
)
