###Connection
RelationalDatabaseConnection test::borealcove::connection::NorthshoreConnection
{
  store: test::borealcove::store::SurveyDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists fieldsurvey;',
      'create schema fieldsurvey;',
      'create table fieldsurvey.tagged_animal (tag_id integer primary key, tag_code varchar(20) not null, species_code varchar(20) not null, region_code varchar(20) not null, habitat_code varchar(20) not null, mass_grams integer not null, wing_span_mm integer not null, released_alive boolean not null, surveyor_name varchar(120) not null, sighting_count integer not null);'
      ];
  };
  auth: DefaultH2;
}

