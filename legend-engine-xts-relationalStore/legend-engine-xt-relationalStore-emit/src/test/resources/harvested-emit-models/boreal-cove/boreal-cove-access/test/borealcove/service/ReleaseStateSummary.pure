###Service
Service test::borealcove::service::ReleaseStateSummary
{
  pattern: '/borealcove/v1/release-state-summary';
  title: 'Boreal Cove - Deduplicated Release State Summary';
  owners:
  [
    'field-survey-platform',
    'wildlife-tracking-ops'
  ];
  documentation: 'Reduces a literal region set to the distinct species and release-state pairs observed in it, keeping the shared optional-region floor conjunct in front of the de-duplication.';
  autoActivateUpdates: false;
  execution: Multi
  {
    query: {speciesCode: String[1], minMass: Integer[1], maxWingSpan: Integer[1], regionFilter: String[0..1], habitatCodes: String[*]|test::borealcove::domain::TaggedAnimal.all()->filter(
      a|$a.speciesCode == $speciesCode
    )->filter(
      a|$a.massGrams > $minMass
    )->filter(
      a|$a.wingSpanMm <= $maxWingSpan
    )->filter(
      a|$regionFilter->isEmpty() || ($a.sightingCount > test::borealcove::domain::resightingFloor($regionFilter))
    )->filter(
      a|$a.regionCode->in(['NORTHSHORE', 'EASTRIDGE'])
    )->project(
      [
        a|$a.speciesCode,
        a|$a.releasedAlive
      ],
      [
        'SpeciesCode',
        'ReleasedAlive'
      ]
    )->distinct()->sort(
      [
        asc('SpeciesCode')
      ]
    )};
    key: 'range';
    executions['northshore']:
    {
      mapping: test::borealcove::mapping::SurveyMapping;
      runtime: test::borealcove::runtime::NorthshoreRuntime;
    }
    executions['eastridge']:
    {
      mapping: test::borealcove::mapping::SurveyMapping;
      runtime: test::borealcove::runtime::EastridgeRuntime;
    }
    executions['westflats']:
    {
      mapping: test::borealcove::mapping::SurveyMapping;
      runtime: test::borealcove::runtime::WestflatsRuntime;
    }
    executions['southfen']:
    {
      mapping: test::borealcove::mapping::SurveyMapping;
      runtime: test::borealcove::runtime::SouthfenRuntime;
    }
    executions['uplands']:
    {
      mapping: test::borealcove::mapping::SurveyMapping;
      runtime: test::borealcove::runtime::UplandsRuntime;
    }
    executions['islets']:
    {
      mapping: test::borealcove::mapping::SurveyMapping;
      runtime: test::borealcove::runtime::IsletsRuntime;
    }
  }
}
