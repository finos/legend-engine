import test::emeraldcove::domain::*;

Class {meta::pure::profiles::doc.doc = 'Waymarker plate fixed at the entrance of a rockpool walk, carried inline with the walk it belongs to.'} test::emeraldcove::domain::WalkMarker
{
  markerCode: String[0..1];
  markerLabel: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'Volunteer guide who leads rockpool walks.'} test::emeraldcove::domain::WalkGuide
{
  guideId: String[1];
  guideName: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'Tidal pool that rockpool walks are routed through.'} test::emeraldcove::domain::TidePool
{
  poolId: String[1];
  poolName: String[0..1];
  shoreLabel: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'Guided rockpool walk, reaching its shore section through the pool it visits.'} test::emeraldcove::domain::RockpoolWalk
{
  walkId: String[1];
  walkName: String[1];
  poolName: String[0..1];
  shoreLabel: String[0..1];
  marker: WalkMarker[0..1];
  guide: WalkGuide[0..1];
}
