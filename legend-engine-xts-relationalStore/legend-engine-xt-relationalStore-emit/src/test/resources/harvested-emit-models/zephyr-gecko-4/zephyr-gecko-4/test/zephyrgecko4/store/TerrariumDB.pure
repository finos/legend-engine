###Relational
Database test::zephyrgecko4::store::TerrariumDB
(
  Schema terrarium
  (
    Table room
    (
      room_code VARCHAR(16) PRIMARY KEY,
      room_name VARCHAR(64) NOT NULL,
      building_wing VARCHAR(32) NOT NULL
    )

    Table enclosure
    (
      enclosure_code VARCHAR(16) PRIMARY KEY,
      enclosure_name VARCHAR(64) NOT NULL,
      habitat_type VARCHAR(32) NOT NULL,
      humidity_band VARCHAR(24) NOT NULL,
      room_code VARCHAR(16) NOT NULL
    )

    Table species
    (
      species_code VARCHAR(16) PRIMARY KEY,
      common_name VARCHAR(64) NOT NULL,
      care_level VARCHAR(24) NOT NULL
    )

    Table keeper
    (
      keeper_code VARCHAR(16) PRIMARY KEY,
      keeper_name VARCHAR(64) NOT NULL,
      shift_block VARCHAR(24) NOT NULL
    )

    Table diet_item
    (
      diet_code VARCHAR(16) PRIMARY KEY,
      diet_name VARCHAR(64) NOT NULL,
      feed_form VARCHAR(24) NOT NULL
    )

    Table feeding_event
    (
      event_id VARCHAR(16) PRIMARY KEY,
      fed_on DATE NOT NULL,
      event_kind VARCHAR(16) NOT NULL,
      portion_count INTEGER NOT NULL,
      live_prey_count INTEGER NOT NULL,
      dusted_prey_count INTEGER NOT NULL,
      refused_count INTEGER NOT NULL,
      water_ml INTEGER NOT NULL,
      supplement_mg INTEGER NOT NULL,
      enclosure_code VARCHAR(16) NOT NULL,
      species_code VARCHAR(16) NOT NULL,
      keeper_code VARCHAR(16) NOT NULL,
      diet_code VARCHAR(16)
    )
  )

  Join Event_Enclosure(terrarium.feeding_event.enclosure_code = terrarium.enclosure.enclosure_code)
  Join Enclosure_Room(terrarium.enclosure.room_code = terrarium.room.room_code)
  Join Event_Species(terrarium.feeding_event.species_code = terrarium.species.species_code)
  Join Event_Keeper(terrarium.feeding_event.keeper_code = terrarium.keeper.keeper_code)
  Join Event_Diet(terrarium.feeding_event.diet_code = terrarium.diet_item.diet_code)
)
