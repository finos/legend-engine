###Pure
import test::zephyrgecko4::domain::*;

Enum test::zephyrgecko4::domain::FeedingMode
{
  SCATTER,
  TONGS,
  DISH,
  MISTING,
  GAVAGE
}

Class test::zephyrgecko4::domain::Room
{
  roomCode: String[1];
  roomName: String[1];
  buildingWing: String[1];
}

Class test::zephyrgecko4::domain::Enclosure
{
  enclosureCode: String[1];
  enclosureName: String[1];
  habitatType: String[1];
  humidityBand: String[1];
  room: Room[1];
}

Class test::zephyrgecko4::domain::Species
{
  speciesCode: String[1];
  commonName: String[1];
  careLevel: String[1];
}

Class test::zephyrgecko4::domain::Keeper
{
  keeperCode: String[1];
  keeperName: String[1];
  shiftBlock: String[1];
}

Class test::zephyrgecko4::domain::DietItem
{
  dietCode: String[1];
  dietName: String[1];
  feedForm: String[1];
}

Class test::zephyrgecko4::domain::FeedingEvent
{
  eventId: String[1];
  fedOn: StrictDate[1];
  mode: FeedingMode[1];
  portionCount: Integer[1];
  livePreyCount: Integer[1];
  dustedPreyCount: Integer[1];
  refusedCount: Integer[1];
  waterMl: Integer[1];
  supplementMg: Integer[1];
  enclosure: Enclosure[1];
  species: Species[1];
  keeper: Keeper[1];
  dietItem: DietItem[0..1];
}
