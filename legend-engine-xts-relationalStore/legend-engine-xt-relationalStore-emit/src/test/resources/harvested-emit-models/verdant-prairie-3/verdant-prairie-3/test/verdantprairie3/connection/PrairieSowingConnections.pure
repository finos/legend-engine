###Connection
RelationalDatabaseConnection test::verdantprairie3::connection::PrairieSowingH2Connection
{
  store: test::verdantprairie3::store::PrairieSowingDb;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists prairie cascade;',
      'create schema prairie;',
      'create table prairie.sowing_plot(plot_id integer primary key, plot_code varchar(24) not null, grid_code varchar(24) not null, seed_mix varchar(48) not null, steward_name varchar(80) not null, soil_class varchar(24) not null, drill_kind varchar(24) not null, note_text varchar(120) not null, sown_at timestamp not null, checked_at timestamp not null);'
      ];
  };
  auth: DefaultH2;
}
