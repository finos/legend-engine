###Service
Service test::goldenwillow::service::ActivePlantingsAsOf
{
  pattern: '/goldenwillow/v1/active-plantings-as-of/{zoneCode}';
  title: 'Golden Willow - Active Plantings By Zone As Of';
  owners:
  [
    'garden-registry',
    'grounds-eng'
  ];
  documentation: 'Single-execution counterpart of the keyed active-plantings service, pinned to the primary environment and carrying the tested suite for the standing-plant predicate, the cross-schema zone join and the aperture-free projection.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {zoneCode: String[1], currentDate: StrictDate[1]|test::goldenwillow::domain::Plant.all()->filter(
      p|((($p.plantedOn->dateDiff($currentDate, meta::pure::functions::date::DurationUnit.DAYS) >= 0) && ($p.statusCode->in(['ACTIVE', 'MATURE']))) && ((($p.retiredOn->isEmpty()) || ($p.retiredOn->toOne() > %9999-12-01)) && ($p.bed.gardenZone->in([$zoneCode, 'NORTH', 'SOUTH']))))
    )->project(
      [
        p|$p.commonName,
        p|$p.speciesCode->toUpper(),
        p|$p.bed.gardenZone,
        p|$p.commonName->length()
      ],
      [
        'CommonName',
        'Species',
        'Zone',
        'NameLen'
      ]
    )->distinct()->sort([asc('CommonName')])->take(100)};
    mapping: test::goldenwillow::mapping::GardenMapping;
    runtime: test::goldenwillow::runtime::GardenPrimaryRuntime;
  }
  testSuites:
  [
    standingPlantingsSuite:
    {
      data:
      [
        connections:
        [
          gardenConnection:
            Relational
            #{
              catalogue.plant:
                'plant_id,common_name,species_code,status_code,bed_code,planted_on,retired_on\n'+
                '1,Fern,FER,ACTIVE,B1,2020-03-15,\n'+
                '2,Ivy,IVY,MATURE,B2,2019-06-01,9999-12-31\n'+
                '3,Moss,MOS,RETIRED,B1,2018-01-01,2021-05-05\n'+
                '4,Reed,REE,ACTIVE,B3,2021-07-07,\n'+
                '5,Sage,SAG,ACTIVE,B4,2099-01-01,\n';

              layout.bed:
                'bed_code,garden_zone,surface_code\n'+
                'B1,EAST,LOAM\n'+
                'B2,NORTH,CLAY\n'+
                'B3,WEST,SAND\n'+
                'B4,EAST,PEAT\n';
            }#
        ]
      ]
      tests:
      [
        eastZoneStanding:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            zoneCode = 'EAST',
            currentDate = %2026-08-01
          ]
          asserts:
          [
            keepsEastAndAdjacent:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"CommonName":"Fern","Species":"FER","Zone":"EAST","NameLen":4},{"CommonName":"Ivy","Species":"IVY","Zone":"NORTH","NameLen":3}]';
                  }#;
              }#
          ]
        },
        westZoneStanding:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            zoneCode = 'WEST',
            currentDate = %2026-08-01
          ]
          asserts:
          [
            keepsWestAndAdjacent:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"CommonName":"Ivy","Species":"IVY","Zone":"NORTH","NameLen":3},{"CommonName":"Reed","Species":"REE","Zone":"WEST","NameLen":4}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
