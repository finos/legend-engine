###Service
Service test::goldenwillow::service::ActivePlantings
{
  pattern: '/goldenwillow/v1/active-plantings/{env}/{zoneCode}';
  title: 'Golden Willow - Active Plantings By Zone (keyed environments)';
  owners:
  [
    'garden-registry',
    'grounds-eng'
  ];
  documentation: 'Keyed execution returning currently-standing plantings for a requested zone: the query keeps plants planted on or before today, in an active or mature status, not yet retired or retired only at a far-future sentinel, and sited in the requested or an adjacent zone, then projects the plant, species, zone and name length. It is bound to a primary and a standby environment by an execution key, each pairing the shared mapping with its own runtime.';
  autoActivateUpdates: true;
  execution: Multi
  {
    query: {zoneCode: String[1], currentDate: StrictDate[1]|test::goldenwillow::domain::Plant.all()->filter(
      p|((($p.plantedOn->dateDiff($currentDate, meta::pure::functions::date::DurationUnit.DAYS) >= 0) && ($p.statusCode->in(['ACTIVE', 'MATURE']))) && ((($p.retiredOn->isEmpty()) || ($p.retiredOn->toOne() > %9999-12-01)) && ($p.bed.gardenZone->in([$zoneCode, 'NORTH', 'SOUTH']))))
    )->project(
      [
        p|$p.commonName,
        p|$p.speciesCode->toUpper(),
        p|$p.bed.gardenZone,
        p|$p.commonName->length()
      ],
      [
        'CommonName',
        'Species',
        'Zone',
        'NameLen'
      ]
    )->distinct()->sort([asc('CommonName')])->take(100)};
    key: 'env';
    executions['primary']:
    {
      mapping: test::goldenwillow::mapping::GardenMapping;
      runtime: test::goldenwillow::runtime::GardenPrimaryRuntime;
    }
    executions['standby']:
    {
      mapping: test::goldenwillow::mapping::GardenMapping;
      runtime: test::goldenwillow::runtime::GardenStandbyRuntime;
    }
  }
}
