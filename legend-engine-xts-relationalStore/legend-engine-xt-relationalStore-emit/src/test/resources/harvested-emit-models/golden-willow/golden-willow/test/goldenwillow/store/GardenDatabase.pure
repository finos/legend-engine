###Relational
Database test::goldenwillow::store::GardenDatabase
(
  Schema catalogue
  (
    Table plant
    (
      plant_id INTEGER PRIMARY KEY,
      common_name VARCHAR(120) NOT NULL,
      species_code VARCHAR(16) NOT NULL,
      status_code VARCHAR(16) NOT NULL,
      bed_code VARCHAR(16) NOT NULL,
      planted_on DATE NOT NULL,
      retired_on DATE
    )
  )

  Schema layout
  (
    Table bed
    (
      bed_code VARCHAR(16) PRIMARY KEY,
      garden_zone VARCHAR(32) NOT NULL,
      surface_code VARCHAR(16) NOT NULL
    )
  )

  Join Plant_Bed(catalogue.plant.bed_code = layout.bed.bed_code)
)
