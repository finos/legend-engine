###Relational
Database test::emeraldmarsh2::store::MarshMonitorDB
(
  Schema marshmonitor
  (
    Table reed_stand
    (
      milestoning
      (
        business(BUS_FROM = valid_from_z, BUS_THRU = valid_thru_z)
      )

      stand_id INTEGER PRIMARY KEY,
      stand_code VARCHAR(40) NOT NULL,
      sector_code VARCHAR(20) NOT NULL,
      reed_height_cm INTEGER NOT NULL,
      cover_pct INTEGER NOT NULL,
      recorded_on DATE NOT NULL,
      valid_from_z TIMESTAMP NOT NULL,
      valid_thru_z TIMESTAMP NOT NULL
    )
  )
)
