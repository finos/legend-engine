###Pure
import test::emeraldmarsh2::domain::*;

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'A monitored reed stand in a wetland sector, versioned along a business validity window.'} test::emeraldmarsh2::domain::ReedStand
{
  standId: Integer[1];
  standCode: String[1];
  sectorCode: String[1];
  reedHeightCm: Integer[1];
  coverPct: Integer[1];
  recordedOn: StrictDate[1];
  densityBand() {if($this.coverPct >= 70, | 'CLOSED', | if($this.coverPct >= 40, | 'PATCHY', | 'OPEN'))}: String[1];
  standLabel() {$this.standCode->toUpper() + ' / ' + $this.sectorCode->toUpper()}: String[1];
}
