###Mapping
Mapping demo::duskyorchard3::mapping::OrchardMapping
(
  *demo::duskyorchard3::domain::Orchard[orchard]: Relational
  {
    ~primaryKey
    (
      [demo::duskyorchard3::store::OrchardYardDB]orchardyard.orchard.orchard_code
    )
    ~mainTable [demo::duskyorchard3::store::OrchardYardDB]orchardyard.orchard
    orchardCode: [demo::duskyorchard3::store::OrchardYardDB]orchardyard.orchard.orchard_code,
    orchardName: [demo::duskyorchard3::store::OrchardYardDB]orchardyard.orchard.orchard_name,
    regionName: [demo::duskyorchard3::store::OrchardYardDB]orchardyard.orchard.region_name
  }

  *demo::duskyorchard3::domain::PickCrew[pickCrew]: Relational
  {
    ~primaryKey
    (
      [demo::duskyorchard3::store::OrchardYardDB]orchardyard.pick_crew.crew_code
    )
    ~mainTable [demo::duskyorchard3::store::OrchardYardDB]orchardyard.pick_crew
    crewCode: [demo::duskyorchard3::store::OrchardYardDB]orchardyard.pick_crew.crew_code,
    crewName: [demo::duskyorchard3::store::OrchardYardDB]orchardyard.pick_crew.crew_name,
    shiftCode: toUpper([demo::duskyorchard3::store::OrchardYardDB]orchardyard.pick_crew.shift_code)
  }

  *demo::duskyorchard3::domain::PickingRound[pickingRound]: Relational
  {
    ~primaryKey
    (
      [demo::duskyorchard3::store::OrchardYardDB]orchardyard.picking_round.round_code
    )
    ~mainTable [demo::duskyorchard3::store::OrchardYardDB]orchardyard.picking_round
    roundCode: [demo::duskyorchard3::store::OrchardYardDB]orchardyard.picking_round.round_code,
    pickedOn: [demo::duskyorchard3::store::OrchardYardDB]orchardyard.picking_round.picked_on,
    varietyLabel: toUpper([demo::duskyorchard3::store::OrchardYardDB]orchardyard.picking_round.variety_code),
    gradeLabel: toUpper([demo::duskyorchard3::store::OrchardYardDB]orchardyard.picking_round.grade_code),
    crateCount: [demo::duskyorchard3::store::OrchardYardDB]orchardyard.picking_round.crate_count,
    grossMassKg: [demo::duskyorchard3::store::OrchardYardDB]orchardyard.picking_round.gross_mass_kg,
    avgCrateMassKg: divide([demo::duskyorchard3::store::OrchardYardDB]orchardyard.picking_round.gross_mass_kg,
                           [demo::duskyorchard3::store::OrchardYardDB]orchardyard.picking_round.crate_count),
    orchard[orchard]: [demo::duskyorchard3::store::OrchardYardDB]@Round_Orchard,
    crew[pickCrew]: [demo::duskyorchard3::store::OrchardYardDB]@Round_Crew
  }
)
