###Pure
import demo::duskyorchard3::domain::*;

Class demo::duskyorchard3::domain::Orchard
{
  orchardCode: String[1];
  orchardName: String[1];
  regionName: String[1];
}

Class demo::duskyorchard3::domain::PickCrew
{
  crewCode: String[1];
  crewName: String[1];
  shiftCode: String[1];
}

Class demo::duskyorchard3::domain::PickingRound
{
  roundCode: String[1];
  pickedOn: StrictDate[1];
  varietyLabel: String[1];
  gradeLabel: String[1];
  crateCount: Integer[1];
  grossMassKg: Float[1];
  avgCrateMassKg: Float[1];
  orchard: Orchard[1];
  crew: PickCrew[1];
}
