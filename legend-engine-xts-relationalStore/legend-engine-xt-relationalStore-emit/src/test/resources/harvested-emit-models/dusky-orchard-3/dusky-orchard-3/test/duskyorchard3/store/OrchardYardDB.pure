###Relational
Database demo::duskyorchard3::store::OrchardYardDB
(
  Schema orchardyard
  (
    Table orchard
    (
      orchard_code VARCHAR(16) PRIMARY KEY,
      orchard_name VARCHAR(96),
      region_name VARCHAR(96)
    )

    Table pick_crew
    (
      crew_code VARCHAR(16) PRIMARY KEY,
      crew_name VARCHAR(96),
      shift_code VARCHAR(16)
    )

    Table picking_round
    (
      round_code VARCHAR(16) PRIMARY KEY,
      picked_on DATE,
      variety_code VARCHAR(32),
      grade_code VARCHAR(8),
      crate_count INTEGER,
      gross_mass_kg FLOAT,
      orchard_code VARCHAR(16),
      crew_code VARCHAR(16)
    )
  )

  Join Round_Orchard(orchardyard.picking_round.orchard_code = orchardyard.orchard.orchard_code)
  Join Round_Crew(orchardyard.picking_round.crew_code = orchardyard.pick_crew.crew_code)
)
