###Relational
Database test::lunararboretum::store::NurseryDB
(
  Table conservatory
  (
    conservatory_id INTEGER PRIMARY KEY,
    conservatory_name VARCHAR(200) NOT NULL
  )
  Table tree_north
  (
    tree_id INTEGER PRIMARY KEY,
    label VARCHAR(200) NOT NULL,
    height_m DOUBLE NOT NULL,
    conservatory_id INTEGER NOT NULL
  )
  Table tree_south
  (
    tree_id INTEGER PRIMARY KEY,
    label VARCHAR(200) NOT NULL,
    height_m DOUBLE NOT NULL,
    conservatory_id INTEGER NOT NULL
  )

  Filter TallFilter(tree_north.height_m > 10.0)

  View tall_north_view
  (
    ~filter TallFilter
    tree_id: tree_north.tree_id,
    label: tree_north.label,
    height_m: tree_north.height_m,
    conservatory_id: tree_north.conservatory_id
  )

  Join TallNorth_Conservatory(tall_north_view.conservatory_id = conservatory.conservatory_id)
  Join South_Conservatory(tree_south.conservatory_id = conservatory.conservatory_id)
)
