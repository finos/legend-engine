###Connection
RelationalDatabaseConnection test::lunararboretum::connection::NurseryH2Connection
{
  store: test::lunararboretum::store::NurseryDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop all objects;',
      'create table conservatory (conservatory_id integer primary key, conservatory_name varchar(200) not null);',
      'create table tree_north (tree_id integer primary key, label varchar(200) not null, height_m double not null, conservatory_id integer not null);',
      'create table tree_south (tree_id integer primary key, label varchar(200) not null, height_m double not null, conservatory_id integer not null);',
      'insert into conservatory values (1, \'Glass House\');',
      'insert into tree_north values (1, \'Northern Oak\', 15.0, 1);',
      'insert into tree_north values (2, \'Northern Fern\', 3.0, 1);',
      'insert into tree_south values (1, \'Southern Pine\', 8.0, 1);'
      ];
  };
  auth: DefaultH2;
}
