###Service
Service test::lunararboretum::service::TreesByConservatory
{
  pattern: '/nursery/v1/trees/{conservatoryName}';
  title: 'Trees by Conservatory';
  owners:
  [
    'nursery-survey',
    'conservatory-ops'
  ];
  documentation: 'Returns tree specimens in the given conservatory, unioning tall northern trees (via a filtered inline view) with southern trees over the in-process H2 NurseryRuntime.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {conservatoryName: String[1]|test::lunararboretum::domain::TreeSpecimen.all()->filter(
      t|$t.conservatory.name == $conservatoryName
    )->project(
      [
        t|$t.label,
        t|$t.heightM
      ],
      [
        'Label',
        'HeightM'
      ]
    )->sort(
      [
        asc('Label')
      ]
    )};
    mapping: test::lunararboretum::mapping::NurseryMapping;
    runtime: test::lunararboretum::runtime::NurseryRuntime;
  }
  testSuites:
  [
    treesByConservatorySuite:
    {
      data:
      [
        connections:
        [
          h2Connection:
            Relational
            #{
              default.conservatory:
                'conservatory_id,conservatory_name\n'+
                '1,Glass House\n';
              default.tree_north:
                'tree_id,label,height_m,conservatory_id\n'+
                '1,Northern Oak,15.0,1\n'+
                '2,Northern Fern,3.0,1\n';
              default.tree_south:
                'tree_id,label,height_m,conservatory_id\n'+
                '1,Southern Pine,8.0,1\n';
            }#
        ]
      ]
      tests:
      [
        glassHouse:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            conservatoryName = 'Glass House'
          ]
          asserts:
          [
            twoTrees:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Label":"Northern Oak","HeightM":15.0},{"Label":"Southern Pine","HeightM":8.0}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
