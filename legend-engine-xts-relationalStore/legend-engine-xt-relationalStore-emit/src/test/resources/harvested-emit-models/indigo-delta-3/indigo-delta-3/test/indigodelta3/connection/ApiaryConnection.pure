###Connection
RelationalDatabaseConnection test::indigodelta3::connection::ApiaryConnection
{
  store: test::indigodelta3::store::ApiaryDb;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists apiary;',
      'create schema apiary;',
      'create table apiary.hive_inspection (inspection_id integer primary key, hive_tag varchar(24) not null, yard_code varchar(24) not null, brood_pattern varchar(32) not null, mite_wash_count integer not null, super_count integer not null, log_state varchar(16) not null);',
      'create table apiary.hive_yard (yard_id integer primary key, yard_code varchar(24) not null, yard_name varchar(120), forage_zone varchar(60), steward_name varchar(120), shelter_note varchar(120));',
      'create table apiary.forage_sample (sample_id integer primary key, yard_code varchar(24) not null, nectar_source varchar(60) not null, gram_yield integer not null);'
      ];
  };
  auth: DefaultH2;
}
