###Connection
RelationalDatabaseConnection demo::wistfulaviary::connection::AviaryH2Connection
{
  store: demo::wistfulaviary::store::AviaryStore;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists aviary;',
      'create schema aviary;',
      'create table aviary.aviary_site (site_id integer primary key, site_name varchar(200) not null, region_code varchar(20) not null, habitat_code varchar(20));',
      'create table aviary.ringed_bird (bird_id integer, ring_code varchar(40) not null, species_code varchar(20) not null, site_id integer not null, wing_mm integer, from_z date, thru_z date);',
      'create table aviary.observation (obs_id integer, bird_id integer not null, observer varchar(120) not null, count_seen integer not null, condition_code varchar(20), observed_on date not null, from_z date, thru_z date);'
      ];
  };
  auth: DefaultH2;
}
