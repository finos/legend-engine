###Pure
import demo::wistfulaviary::domain::*;

Class {meta::pure::profiles::doc.doc = 'A ringing station within the aviary observation network.'} demo::wistfulaviary::domain::Site
{
  name: String[1];
  regionCode: String[1];
  habitat: String[1];
  regionTier()
  {
    if($this.regionCode == 'NORTH',
       | 'PRIORITY',
       | if($this.regionCode == 'COAST',
            | 'SEASONAL',
            | 'STANDARD'))
  }: String[1];
}

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'A ringed bird whose recorded species and biometrics are tracked on a business timeline.'} demo::wistfulaviary::domain::RingedBird
{
  ringCode: String[1];
  speciesCode: String[1];
  wingMillimetres: Integer[0..1];
  speciesLabel()
  {
    if($this.speciesCode == 'WREN',
       | 'Eurasian Wren',
       | if($this.speciesCode == 'FINCH',
            | 'Common Chaffinch',
            | if($this.speciesCode == 'PIPIT',
                 | 'Meadow Pipit',
                 | if($this.speciesCode == 'THRUSH',
                      | 'Song Thrush',
                      | if($this.speciesCode == 'SISKIN',
                           | 'Eurasian Siskin',
                           | 'Unidentified Passerine')))))
  }: String[1];
  sizeClass()
  {
    if($this.wingMillimetres->isEmpty(),
       | 'UNMEASURED',
       | if($this.wingMillimetres->toOne() > 95,
            | 'LARGE',
            | if($this.wingMillimetres->toOne() > 70,
                 | 'MEDIUM',
                 | 'SMALL')))
  }: String[1];
}

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'A field observation of a ringed bird, tracked on a business timeline so corrections supersede earlier readings.'} demo::wistfulaviary::domain::Observation
{
  observer: String[1];
  countSeen: Integer[1];
  conditionCode: String[0..1];
  observedOn: StrictDate[1];
  conditionLabel()
  {
    if($this.conditionCode->isEmpty(),
       | 'UNASSESSED',
       | if($this.conditionCode->toOne() == 'H',
            | 'HEALTHY',
            | if($this.conditionCode->toOne() == 'I',
                 | 'INJURED',
                 | if($this.conditionCode->toOne() == 'M',
                      | 'MOULTING',
                      | 'UNASSESSED'))))
  }: String[1];
  effortBand()
  {
    if($this.countSeen > 20,
       | 'FLOCK',
       | if($this.countSeen > 5,
            | 'PARTY',
            | if($this.countSeen > 1,
                 | 'PAIR',
                 | 'SINGLETON')))
  }: String[1];
}

Association demo::wistfulaviary::domain::Bird_Site
{
  site: Site[1];
  birds: RingedBird[*];
}

Association demo::wistfulaviary::domain::Observation_Bird
{
  bird: RingedBird[1];
  observations: Observation[*];
}
