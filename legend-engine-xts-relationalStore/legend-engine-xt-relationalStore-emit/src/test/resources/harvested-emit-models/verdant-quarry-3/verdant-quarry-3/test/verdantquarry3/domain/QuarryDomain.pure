###Pure
import test::verdantquarry3::domain::*;

Class {meta::pure::profiles::doc.doc = 'A working stone quarry that faces and samples are recorded against.'} test::verdantquarry3::domain::QuarrySite
{
  quarryCode: String[1];
  quarryName: String[1];
  regionCode: String[1];
}

Class {meta::pure::profiles::doc.doc = 'One excavated face of a quarry, surveyed on a given date.'} test::verdantquarry3::domain::QuarryFace
{
  faceCode: String[1];
  faceName: String[1];
  benchHeight: Integer[1];
  surveyedOn: StrictDate[1];
}

Class {meta::pure::profiles::doc.doc = 'A drilled core sample taken from a quarry face and graded for mineral purity.'} test::verdantquarry3::domain::CoreSample
{
  sampleCode: String[1];
  mineralCode: String[1];
  purityPercent: Integer[1];
  depthMetres: Integer[1];
  collectedOn: StrictDate[1];
}

Association test::verdantquarry3::domain::SiteFaces
{
  site: QuarrySite[1];
  faces: QuarryFace[*];
}

Association test::verdantquarry3::domain::FaceSamples
{
  face: QuarryFace[1];
  samples: CoreSample[*];
}
