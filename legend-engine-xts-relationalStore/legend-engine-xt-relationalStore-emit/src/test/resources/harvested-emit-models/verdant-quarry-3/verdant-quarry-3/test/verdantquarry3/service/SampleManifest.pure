###Service
Service test::verdantquarry3::service::SampleManifest
{
  pattern: '/quarry/v1/sample-manifest';
  title: 'Verdant Quarry - Sample Manifest';
  owners:
  [
    'quarry-survey-desk',
    'quarry-geology'
  ];
  documentation: 'Widest projection in the group: seven columns over the whole core-sample extent, two of them resolved two hops away through face and site, with the collection date reduced to its calendar year so the projected column is derived rather than a raw column read.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: {|test::verdantquarry3::domain::CoreSample.all()->project(
      [
        s|$s.sampleCode,
        s|$s.mineralCode,
        s|$s.purityPercent,
        s|$s.depthMetres,
        s|$s.collectedOn->year(),
        s|$s.face.faceName,
        s|$s.face.site.quarryName
      ],
      [
        'Sample Code',
        'Mineral Code',
        'Purity Percent',
        'Depth Metres',
        'Collected Year',
        'Face Name',
        'Quarry Name'
      ]
    )->distinct()->sort([asc('Sample Code')])};
    mapping: test::verdantquarry3::mapping::QuarryMapping;
    runtime: test::verdantquarry3::runtime::QuarryH2Runtime;
  }
  testSuites:
  [
    sampleManifestSuite:
    {
      data:
      [
        connections:
        [
          quarryConnection:
            Relational
            #{
              geology.quarry_site:
                'quarry_code,quarry_name,region_code\n'+
                'QS-01,Verdant Ridge Quarry,RG-NORTH\n'+
                'QS-02,Slate Hollow Quarry,RG-SOUTH\n';

              geology.quarry_face:
                'face_code,face_name,quarry_code,bench_height,surveyed_on\n'+
                'QF-01,North Bench,QS-01,14,2026-03-04\n'+
                'QF-02,East Bench,QS-01,9,2026-05-20\n'+
                'QF-03,South Bench,QS-02,6,2026-03-11\n';

              geology.core_sample:
                'sample_code,face_code,mineral_code,purity_percent,depth_metres,collected_on\n'+
                'CS-01,QF-01,QTZ,94,12,2026-03-06\n'+
                'CS-02,QF-01,QTZ,71,18,2026-03-07\n'+
                'CS-03,QF-02,FSP,63,9,2026-05-22\n'+
                'CS-04,QF-03,QTZ,88,25,2026-03-12\n';
            }#
        ]
      ]
      tests:
      [
        everySampleWithTwoHopContext:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
          ]
          asserts:
          [
            faceAndQuarryResolvedForEverySample:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Sample Code":"CS-01","Mineral Code":"QTZ","Purity Percent":94,"Depth Metres":12,"Collected Year":2026,"Face Name":"North Bench","Quarry Name":"Verdant Ridge Quarry"},{"Sample Code":"CS-02","Mineral Code":"QTZ","Purity Percent":71,"Depth Metres":18,"Collected Year":2026,"Face Name":"North Bench","Quarry Name":"Verdant Ridge Quarry"},{"Sample Code":"CS-03","Mineral Code":"FSP","Purity Percent":63,"Depth Metres":9,"Collected Year":2026,"Face Name":"East Bench","Quarry Name":"Verdant Ridge Quarry"},{"Sample Code":"CS-04","Mineral Code":"QTZ","Purity Percent":88,"Depth Metres":25,"Collected Year":2026,"Face Name":"South Bench","Quarry Name":"Slate Hollow Quarry"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
