###Relational
Database test::verdantquarry3::store::QuarryDB
(
  Schema geology
  (
    Table quarry_site
    (
      quarry_code VARCHAR(24) PRIMARY KEY,
      quarry_name VARCHAR(120) NOT NULL,
      region_code VARCHAR(24) NOT NULL
    )
    Table quarry_face
    (
      face_code VARCHAR(24) PRIMARY KEY,
      face_name VARCHAR(120) NOT NULL,
      quarry_code VARCHAR(24) NOT NULL,
      bench_height INTEGER NOT NULL,
      surveyed_on DATE NOT NULL
    )
    Table core_sample
    (
      sample_code VARCHAR(24) PRIMARY KEY,
      face_code VARCHAR(24) NOT NULL,
      mineral_code VARCHAR(24) NOT NULL,
      purity_percent INTEGER NOT NULL,
      depth_metres INTEGER NOT NULL,
      collected_on DATE NOT NULL
    )
  )

  Join Face_Site(geology.quarry_face.quarry_code = geology.quarry_site.quarry_code)
  Join Sample_Face(geology.core_sample.face_code = geology.quarry_face.face_code)
)
