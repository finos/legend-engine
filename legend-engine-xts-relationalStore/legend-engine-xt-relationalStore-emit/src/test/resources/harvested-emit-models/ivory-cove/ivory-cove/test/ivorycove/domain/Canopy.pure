###Pure
import test::ivorycove::domain::*;

Enum test::ivorycove::domain::CanopyGrade
{
  BROAD, NARROW, MIXED
}

Class test::ivorycove::domain::TreePlot
{
  plotCode: String[1];
  plotName: String[1];
  plantedOn: StrictDate[0..1];
  trunkCount: Integer[1];
  sheltered: Boolean[1];
  grade: CanopyGrade[1];
  catalogTag: String[1];
  sourceLabel: String[1];
  heightCm: Integer[0..1];
  districtName: String[0..1];
  boroughName: String[0..1];
  district: District[0..1];
}

Class test::ivorycove::domain::District
{
  districtCode: String[1];
  districtName: String[1];
  boroughName: String[0..1];
  plots: TreePlot[*];
}
