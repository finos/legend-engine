###Relational
Database test::ivorycove::store::CanopyDatabase
(
  Schema inventory
  (
    Table tree_plot
    (
      plot_code VARCHAR(16) PRIMARY KEY,
      plot_name VARCHAR(64),
      planted_on DATE,
      trunk_count INTEGER,
      sheltered BIT,
      grade_code VARCHAR(16),
      status_code VARCHAR(16),
      district_code VARCHAR(16)
    )

    Table plot_measure
    (
      plot_code VARCHAR(16) PRIMARY KEY,
      height_cm INTEGER
    )
  )

  Schema reference
  (
    Table district
    (
      district_code VARCHAR(16) PRIMARY KEY,
      district_name VARCHAR(64),
      borough_code VARCHAR(16)
    )

    Table borough
    (
      borough_code VARCHAR(16) PRIMARY KEY,
      borough_name VARCHAR(64)
    )
  )

  Filter LivePlots(toUpper(inventory.tree_plot.status_code) = 'LIVE')

  Join PlotMeasureJoin(inventory.tree_plot.plot_code = inventory.plot_measure.plot_code)
  Join PlotDistrictJoin(inventory.tree_plot.district_code = reference.district.district_code)
  Join DistrictBoroughJoin(reference.district.borough_code = reference.borough.borough_code)
)
