###Relational
Database test::kindlygecko4::store::HerpetariumDb
(
  Schema herpetarium
  (
    Table occupant_record
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )

      occupant_code VARCHAR(24) PRIMARY KEY,
      terrarium_code VARCHAR(24) NOT NULL,
      species_name VARCHAR(80) NOT NULL,
      record_kind VARCHAR(8) NOT NULL,
      snout_vent_mm INTEGER NOT NULL,
      mass_grams INTEGER,
      shed_cycle_days INTEGER,
      basking_lamp_code VARCHAR(24),
      burrow_substrate VARCHAR(24),
      care_note VARCHAR(120),
      hatched_on DATE,
      in_z DATE PRIMARY KEY,
      out_z DATE
    )
  )

  Filter GeckoRows(herpetarium.occupant_record.record_kind = 'GECKO')

  Filter SkinkRows(herpetarium.occupant_record.record_kind = 'SKINK')
)
