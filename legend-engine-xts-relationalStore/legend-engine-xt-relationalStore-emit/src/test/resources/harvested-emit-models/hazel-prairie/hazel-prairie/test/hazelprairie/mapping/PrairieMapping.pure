###Mapping
Mapping test::hazelprairie::mapping::PrairieMapping
(
  *test::hazelprairie::domain::Meadow[meadow]: Relational
  {
    ~primaryKey
    (
      [test::hazelprairie::store::PrairieDatabase]prairie.meadow.meadow_id
    )
    ~mainTable [test::hazelprairie::store::PrairieDatabase]prairie.meadow
    meadowCode: [test::hazelprairie::store::PrairieDatabase]prairie.meadow.meadow_code,
    name: [test::hazelprairie::store::PrairieDatabase]prairie.meadow.meadow_name,
    region: [test::hazelprairie::store::PrairieDatabase]prairie.meadow.region_code
  }

  *test::hazelprairie::domain::SurveyPlot[plot]: Relational
  {
    ~primaryKey
    (
      [test::hazelprairie::store::PrairieDatabase]prairie.survey_plot.plot_id
    )
    ~mainTable [test::hazelprairie::store::PrairieDatabase]prairie.survey_plot
    plotRef: [test::hazelprairie::store::PrairieDatabase]prairie.survey_plot.plot_ref,
    aspect: [test::hazelprairie::store::PrairieDatabase]prairie.survey_plot.aspect_code,
    meadow[meadow]: [test::hazelprairie::store::PrairieDatabase]@SurveyPlot_Meadow
  }

  *test::hazelprairie::domain::BloomCount[bloom]: Relational
  {
    ~primaryKey
    (
      [test::hazelprairie::store::PrairieDatabase]prairie.bloom_count.count_id
    )
    ~mainTable [test::hazelprairie::store::PrairieDatabase]prairie.bloom_count
    recordRef: [test::hazelprairie::store::PrairieDatabase]prairie.bloom_count.record_ref,
    species: [test::hazelprairie::store::PrairieDatabase]prairie.bloom_count.species_label,
    colour: [test::hazelprairie::store::PrairieDatabase]prairie.bloom_count.colour_code,
    observer: [test::hazelprairie::store::PrairieDatabase]prairie.bloom_count.observer_code,
    surveyDay: [test::hazelprairie::store::PrairieDatabase]prairie.bloom_count.survey_day,
    stems: [test::hazelprairie::store::PrairieDatabase]prairie.bloom_count.stem_total,
    plot[plot]: [test::hazelprairie::store::PrairieDatabase]@BloomCount_SurveyPlot
  }
)
