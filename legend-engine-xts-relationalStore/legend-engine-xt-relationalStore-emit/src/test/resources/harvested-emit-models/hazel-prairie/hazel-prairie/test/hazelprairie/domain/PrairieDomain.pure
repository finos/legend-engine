Class {meta::pure::profiles::doc.doc = 'A named wildflower meadow surveyed within one region.'} test::hazelprairie::domain::Meadow
{
  meadowCode: String[1];
  name: String[1];
  region: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A fixed quadrat laid out inside a meadow, facing one aspect.'} test::hazelprairie::domain::SurveyPlot
{
  plotRef: String[1];
  aspect: String[1];
  meadow: test::hazelprairie::domain::Meadow[1];
}

Class {meta::pure::profiles::doc.doc = 'A stem count of one flowering species recorded on a plot by one observer on one day.'} test::hazelprairie::domain::BloomCount
{
  recordRef: String[1];
  species: String[1];
  colour: String[1];
  observer: String[1];
  surveyDay: StrictDate[1];
  stems: Integer[1];
  plot: test::hazelprairie::domain::SurveyPlot[1];
}
