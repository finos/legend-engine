###Relational
Database test::hazelprairie::store::PrairieDatabase
(
  Schema prairie
  (
    Table meadow
    (
      meadow_id INTEGER PRIMARY KEY,
      meadow_code VARCHAR(16) NOT NULL,
      meadow_name VARCHAR(120) NOT NULL,
      region_code VARCHAR(32) NOT NULL
    )
    Table survey_plot
    (
      plot_id INTEGER PRIMARY KEY,
      plot_ref VARCHAR(16) NOT NULL,
      meadow_id INTEGER NOT NULL,
      aspect_code VARCHAR(16) NOT NULL
    )
    Table bloom_count
    (
      count_id INTEGER PRIMARY KEY,
      record_ref VARCHAR(16) NOT NULL,
      plot_id INTEGER NOT NULL,
      species_label VARCHAR(120) NOT NULL,
      colour_code VARCHAR(32) NOT NULL,
      observer_code VARCHAR(32) NOT NULL,
      survey_day DATE NOT NULL,
      stem_total INTEGER NOT NULL
    )
  )

  Join BloomCount_SurveyPlot(prairie.bloom_count.plot_id = prairie.survey_plot.plot_id)
  Join SurveyPlot_Meadow(prairie.survey_plot.meadow_id = prairie.meadow.meadow_id)
)
