###Relational
Database test::goldenotter2::store::VolunteerDb
(
  Schema people
  (
    Table volunteer
    (
      volunteer_code VARCHAR(32) PRIMARY KEY,
      volunteer_name VARCHAR(120) NOT NULL,
      badge_code VARCHAR(32),
      rota_code VARCHAR(32) NOT NULL
    )
    Table badge
    (
      badge_code VARCHAR(32) PRIMARY KEY,
      badge_label VARCHAR(120) NOT NULL,
      badge_grade VARCHAR(32) NOT NULL
    )
  )

  Join Volunteer_Badge(people.volunteer.badge_code = people.badge.badge_code)
)
