###Service
Service test::goldenotter2::service::GlasshouseRotaList
{
  pattern: '/garden/v1/rotas';
  title: 'Golden Otter - Glasshouse rota list';
  owners:
  [
    'glasshouse-register-desk',
    'botanic-collections-office'
  ];
  documentation: 'Rota-level projection reaching the glasshouse it is run for across the schema boundary, with no further reduction so the plan is a single projected relational read.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {|test::goldenotter2::domain::WateringRota.all()->project(
      [
        r|$r.rotaCode,
        r|$r.rotaLabel,
        r|$r.weekNumber,
        r|$r.glasshouse.glasshouseName,
        r|$r.glasshouse.zoneCode
      ],
      [
        'Rota/Code',
        'Rota/Label',
        'Rota/Week',
        'Glasshouse/Name',
        'Glasshouse/Zone'
      ]
    );};
    mapping: test::goldenotter2::mapping::GardenMapping;
    runtime: test::goldenotter2::runtime::GardenRuntime;
  }
  testSuites:
  [
    rotaListSuite:
    {
      data:
      [
        connections:
        [
          gardenConnection:
            Relational
            #{
              glass.glasshouse:
                'glasshouse_code,glasshouse_name,zone_code\n'+
                'GH-1,Palm House,ZONE-A\n';
              glass.watering_rota:
                'rota_code,glasshouse_code,rota_label,week_number\n'+
                'WR-1,GH-1,morning-rota,1\n';
            }#
        ]
      ]
      tests:
      [
        singleRotaRow:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            oneRow:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Rota/Code":"WR-1","Rota/Label":"morning-rota","Rota/Week":1,"Glasshouse/Name":"Palm House","Glasshouse/Zone":"ZONE-A"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
