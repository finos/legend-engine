###Pure
import test::sabledelta2::domain::*;

Class {meta::pure::profiles::doc.doc = 'Root of the remote bookmobile stop-feed document.'} test::sabledelta2::domain::StopPayload
{
  stopRef: String[0..1];
  revision: Integer[0..1];
  visit: VisitNode[0..1];
}

Class {meta::pure::profiles::doc.doc = 'The visit recorded against one bookmobile stop.'} test::sabledelta2::domain::VisitNode
{
  driverCode: String[0..1];
  holdingCount: Integer[0..1];
  dwellMinutes: Integer[0..1];
  patron: PatronNode[0..1];
  route: RouteNode[0..1];
}

Class {meta::pure::profiles::doc.doc = 'The route a visit was walked on.'} test::sabledelta2::domain::RouteNode
{
  routeName: String[0..1];
  vehicle: VehicleNode[0..1];
  depot: DepotNode[0..1];
}

Class {meta::pure::profiles::doc.doc = 'The depot a route is dispatched from.'} test::sabledelta2::domain::DepotNode
{
  depotCode: String[0..1];
  depotName: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'The vehicle assigned to a route.'} test::sabledelta2::domain::VehicleNode
{
  plateCode: String[0..1];
  seatCount: Integer[0..1];
}

Class {meta::pure::profiles::doc.doc = 'The patron who requested the visit.'} test::sabledelta2::domain::PatronNode
{
  patronCode: String[0..1];
  patronName: String[0..1];
}
