###Connection
RelationalDatabaseConnection test::sabledelta2::connection::StopLogbookConnection
{
  store: test::sabledelta2::store::StopLogbookDb;
  type: H2;
  specification: Static
  {
    name: 'STOP_LOGBOOK';
    host: 'stop-logbook.example.internal';
    port: 5100;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'stoplogbookprincipal';
  };
}

###Connection
ModelChainConnection test::sabledelta2::connection::StopChainConnection
{
  mappings:
  [
    test::sabledelta2::mapping::StopDigestMapping
  ];
}
