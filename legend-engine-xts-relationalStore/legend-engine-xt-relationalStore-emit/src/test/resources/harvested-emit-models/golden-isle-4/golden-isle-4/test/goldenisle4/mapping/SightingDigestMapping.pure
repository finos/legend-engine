###Mapping
Mapping test::goldenisle4::mapping::SightingDigestMapping
(
  include mapping test::goldenisle4::mapping::IsleEnumMappings

  *test::goldenisle4::domain::NestDigest: Pure
  {
    ~src test::goldenisle4::domain::NestSighting
    digestKey: $src.sightingRef + '/' + $src.speciesText->toUpper(),
    broodLabel: if($src.chickCount >= 5,
                   | 'LARGE-' + $src.chickCount->toString(),
                   | if($src.chickCount >= 1,
                        | 'SMALL-' + $src.chickCount->toString(),
                        | 'EGGS-' + $src.eggCount->toString())),
    speciesGroup: EnumerationMapping SpeciesMapping: [if($src.speciesText->toUpper()->startsWith('AUK'), |'AK', |if($src.speciesText->toUpper()->startsWith('GULL'), |'GU', |if($src.speciesText->toUpper()->startsWith('PETREL'), |'PE', |'ZZ')))],
    broodClass: EnumerationMapping BroodMapping: [if($src.chickCount >= 3, |'F', |if($src.chickCount > 0, |'B', |if($src.eggCount > 0, |'B', |'E')))],
    ringScheme: EnumerationMapping RingMapping: [if($src.ringText->toUpper()->startsWith('METAL'), |'M', |if($src.ringText->toUpper()->startsWith('COLOUR'), |'C', |'N'))]
  }
)
