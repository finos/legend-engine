###Pure
Enum test::goldenisle4::domain::SpeciesGroup
{
  AUK,
  GULL,
  PETREL
}

Enum test::goldenisle4::domain::BroodClass
{
  FLEDGED,
  BROODING,
  EMPTY
}

Enum test::goldenisle4::domain::RingScheme
{
  METAL,
  COLOUR,
  NONE
}

Class {meta::pure::profiles::doc.doc = 'One monitored seabird nest on a surveyed cliff plot.'} test::goldenisle4::domain::NestRecord
{
  nestRef: String[1];
  plotRef: String[1];
  speciesGroup: test::goldenisle4::domain::SpeciesGroup[0..1];
  broodClass: test::goldenisle4::domain::BroodClass[0..1];
  ringScheme: test::goldenisle4::domain::RingScheme[0..1];
  broodBand: String[1];
  handlingNote: String[0..1];
  plotName: String[0..1];
  colonyName: String[0..1];
  isleName: String[0..1];
  isleColonyCount: Integer[0..1];
  plotNestCount: Integer[0..1];
  plotChickTotal: Integer[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A raw field sighting slip typed up by a ringer before it is folded into the nest register.'} test::goldenisle4::domain::NestSighting
{
  sightingRef: String[1];
  speciesText: String[1];
  chickCount: Integer[1];
  eggCount: Integer[1];
  ringText: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A normalised digest of a field sighting slip.'} test::goldenisle4::domain::NestDigest
{
  digestKey: String[1];
  broodLabel: String[1];
  speciesGroup: test::goldenisle4::domain::SpeciesGroup[0..1];
  broodClass: test::goldenisle4::domain::BroodClass[0..1];
  ringScheme: test::goldenisle4::domain::RingScheme[0..1];
}
