###Connection
RelationalDatabaseConnection test::borealwillow2::connection::WillowSeasonConnection
{
  store: test::borealwillow2::store::WillowCoppiceDb;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists coppice;',
      'create schema coppice;',
      'create table coppice.cut_log (cut_ref varchar(24) primary key, bed_code varchar(24) not null, cut_round integer not null, rod_bundles integer not null, rod_length_cm integer not null, cut_grade varchar(16) not null, cut_state varchar(16) not null);',
      'create table coppice.willow_bed (bed_code varchar(24) primary key, bed_name varchar(80) not null, soil_code varchar(16) not null, crew_code varchar(24) not null);',
      'create table coppice.cutter_crew (crew_code varchar(24) primary key, crew_name varchar(80) not null, depot_name varchar(80) not null);'
      ];
  };
  auth: DefaultH2;
}

RelationalDatabaseConnection test::borealwillow2::connection::WillowArchiveConnection
{
  store: test::borealwillow2::store::WillowCoppiceDb;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists coppice;',
      'create schema coppice;',
      'create table coppice.cut_log (cut_ref varchar(24) primary key, bed_code varchar(24) not null, cut_round integer not null, rod_bundles integer not null, rod_length_cm integer not null, cut_grade varchar(16) not null, cut_state varchar(16) not null);',
      'create table coppice.willow_bed (bed_code varchar(24) primary key, bed_name varchar(80) not null, soil_code varchar(16) not null, crew_code varchar(24) not null);',
      'create table coppice.cutter_crew (crew_code varchar(24) primary key, crew_name varchar(80) not null, depot_name varchar(80) not null);'
      ];
  };
  auth: DefaultH2;
}
