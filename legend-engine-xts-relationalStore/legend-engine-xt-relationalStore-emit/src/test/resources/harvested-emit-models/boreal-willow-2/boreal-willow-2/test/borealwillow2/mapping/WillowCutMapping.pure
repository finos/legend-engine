###Mapping
Mapping test::borealwillow2::mapping::WillowCutMapping
(
  *test::borealwillow2::domain::WillowCut[willowCut]: Relational
  {
    ~primaryKey
    (
      [test::borealwillow2::store::WillowCoppiceDb]coppice.cut_log.cut_ref
    )
    ~mainTable [test::borealwillow2::store::WillowCoppiceDb]coppice.cut_log
    cutRef: [test::borealwillow2::store::WillowCoppiceDb]coppice.cut_log.cut_ref,
    cutRound: [test::borealwillow2::store::WillowCoppiceDb]coppice.cut_log.cut_round,
    rodBundles: [test::borealwillow2::store::WillowCoppiceDb]coppice.cut_log.rod_bundles,
    rodLengthCm: [test::borealwillow2::store::WillowCoppiceDb]coppice.cut_log.rod_length_cm,
    cutGrade: [test::borealwillow2::store::WillowCoppiceDb]coppice.cut_log.cut_grade,
    cutState: [test::borealwillow2::store::WillowCoppiceDb]coppice.cut_log.cut_state
  }

  *test::borealwillow2::domain::WillowBed[willowBed]: Relational
  {
    ~primaryKey
    (
      [test::borealwillow2::store::WillowCoppiceDb]coppice.willow_bed.bed_code
    )
    ~mainTable [test::borealwillow2::store::WillowCoppiceDb]coppice.willow_bed
    bedCode: [test::borealwillow2::store::WillowCoppiceDb]coppice.willow_bed.bed_code,
    bedName: [test::borealwillow2::store::WillowCoppiceDb]coppice.willow_bed.bed_name,
    soilCode: [test::borealwillow2::store::WillowCoppiceDb]coppice.willow_bed.soil_code
  }

  *test::borealwillow2::domain::CutterCrew[cutterCrew]: Relational
  {
    ~primaryKey
    (
      [test::borealwillow2::store::WillowCoppiceDb]coppice.cutter_crew.crew_code
    )
    ~mainTable [test::borealwillow2::store::WillowCoppiceDb]coppice.cutter_crew
    crewCode: [test::borealwillow2::store::WillowCoppiceDb]coppice.cutter_crew.crew_code,
    crewName: [test::borealwillow2::store::WillowCoppiceDb]coppice.cutter_crew.crew_name,
    depotName: [test::borealwillow2::store::WillowCoppiceDb]coppice.cutter_crew.depot_name
  }

  test::borealwillow2::domain::CutBed: Relational
  {
    AssociationMapping
    (
      bed[willowCut, willowBed]: [test::borealwillow2::store::WillowCoppiceDb]@cutToBed,
      cuts[willowBed, willowCut]: [test::borealwillow2::store::WillowCoppiceDb]@cutToBed
    )
  }

  test::borealwillow2::domain::BedCrew: Relational
  {
    AssociationMapping
    (
      crew[willowBed, cutterCrew]: [test::borealwillow2::store::WillowCoppiceDb]@bedToCrew,
      beds[cutterCrew, willowBed]: [test::borealwillow2::store::WillowCoppiceDb]@bedToCrew
    )
  }
)
