###Runtime
Runtime test::borealwillow2::runtime::WillowSeasonRuntime
{
  mappings:
  [
    test::borealwillow2::mapping::WillowCutMapping
  ];
  connections:
  [
    test::borealwillow2::store::WillowCoppiceDb:
    [
      willowSeason: test::borealwillow2::connection::WillowSeasonConnection
    ]
  ];
}

Runtime test::borealwillow2::runtime::WillowArchiveRuntime
{
  mappings:
  [
    test::borealwillow2::mapping::WillowCutMapping
  ];
  connections:
  [
    test::borealwillow2::store::WillowCoppiceDb:
    [
      willowArchive: test::borealwillow2::connection::WillowArchiveConnection
    ]
  ];
}
