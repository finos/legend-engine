###Mapping
Mapping test::scarletwillow2::mapping::ItemRefMapping
(
  test::scarletwillow2::domain::ShelvableKind: EnumerationMapping ItemShelvableMapping
  {
    OPEN_SHELF: ['OPEN'],
    CLOSED_SHELF: ['CLOSED']
  }

  test::scarletwillow2::domain::AssessBasis: EnumerationMapping UnitBasisMapping
  {
    PER_SHEET: ['SHEET'],
    PER_FOLIO: ['FOLIO'],
    PER_HOUR: ['HOUR']
  }

  *test::scarletwillow2::domain::ItemRef[itemRef]: Relational
  {
    ~primaryKey
    (
      [test::scarletwillow2::store::ItemRefDB]reference.item_ref.item_code,
      [test::scarletwillow2::store::ItemRefDB]reference.item_ref.bus_from
    )
    ~mainTable [test::scarletwillow2::store::ItemRefDB]reference.item_ref
    itemCode: [test::scarletwillow2::store::ItemRefDB]reference.item_ref.item_code,
    itemName: [test::scarletwillow2::store::ItemRefDB]reference.item_ref.item_name,
    shelvable: EnumerationMapping ItemShelvableMapping: rtrim([test::scarletwillow2::store::ItemRefDB]reference.item_ref.shelvable_code)
  }

  *test::scarletwillow2::domain::UnitRateRef[unitRateRef]: Relational
  {
    ~primaryKey
    (
      [test::scarletwillow2::store::ItemRefDB]reference.unit_rate_ref.unit_code,
      [test::scarletwillow2::store::ItemRefDB]reference.unit_rate_ref.bus_from
    )
    ~mainTable [test::scarletwillow2::store::ItemRefDB]reference.unit_rate_ref
    unitCode: [test::scarletwillow2::store::ItemRefDB]reference.unit_rate_ref.unit_code,
    unitName: [test::scarletwillow2::store::ItemRefDB]reference.unit_rate_ref.unit_name,
    basis: EnumerationMapping UnitBasisMapping: rtrim([test::scarletwillow2::store::ItemRefDB]reference.unit_rate_ref.basis_code)
  }
)
