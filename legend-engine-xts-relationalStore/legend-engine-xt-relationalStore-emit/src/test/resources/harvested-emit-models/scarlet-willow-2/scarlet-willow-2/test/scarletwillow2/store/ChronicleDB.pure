###Relational
Database test::scarletwillow2::store::ChronicleDB
(
  include test::scarletwillow2::store::ItemRefDB
  include test::scarletwillow2::store::RecordRefDB

  Schema chronicle
  (
    Table holding_quantity
    (
      milestoning
      (
        business(BUS_FROM = bus_from, BUS_THRU = bus_thru)
      )

      line_code VARCHAR(24) PRIMARY KEY,
      record_no_text VARCHAR(16) NOT NULL,
      unit_code VARCHAR(16) NOT NULL,
      entity_code VARCHAR(16) NOT NULL,
      treatment_code VARCHAR(16),
      status_code CHAR(12),
      counted_sheets INTEGER,
      bath_minutes INTEGER,
      auditor_label VARCHAR(96),
      recorded_on DATE NOT NULL,
      bus_from DATE PRIMARY KEY,
      bus_thru DATE
    )

    Table holding_extent
    (
      milestoning
      (
        business(BUS_FROM = bus_from, BUS_THRU = bus_thru)
      )

      line_code VARCHAR(24) PRIMARY KEY,
      record_no_text VARCHAR(16) NOT NULL,
      unit_code VARCHAR(16) NOT NULL,
      entity_code VARCHAR(16) NOT NULL,
      treatment_code VARCHAR(16),
      status_code CHAR(12),
      measured_extent INTEGER,
      press_grams INTEGER,
      recorded_on DATE NOT NULL,
      bus_from DATE PRIMARY KEY,
      bus_thru DATE
    )
  )

  Filter FinalLines(chronicle.holding_quantity.status_code = 'FINAL')

  Join Quantity_Record(parseInteger(chronicle.holding_quantity.record_no_text) = registry.record_ref.record_no)
  Join Extent_Record(parseInteger(chronicle.holding_extent.record_no_text) = registry.record_ref.record_no)
  Join Quantity_Unit(chronicle.holding_quantity.unit_code = reference.unit_rate_ref.unit_code)
  Join Extent_Unit(chronicle.holding_extent.unit_code = reference.unit_rate_ref.unit_code)
)
