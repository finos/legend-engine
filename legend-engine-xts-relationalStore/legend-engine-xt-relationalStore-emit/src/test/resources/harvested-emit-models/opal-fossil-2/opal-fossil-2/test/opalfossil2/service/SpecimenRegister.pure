###Service
Service test::opalfossil2::service::SpecimenRegister
{
  pattern: '/opalfossil2/v1/specimen-register/{businessDate}';
  title: 'Opal Fossil 2 - Specimen Register As Of';
  ownership: UserList { users: ['fossil-catalogue-desk'] };
  documentation: 'Single-execution counterpart of the determination register: resolves the specimens effective on the requested business date and reports their matrix and mass, executed against the in-process runtime so the business-temporal cut is asserted end to end.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: {businessDate: StrictDate[1]|test::opalfossil2::domain::FossilSpecimen.all($businessDate)->project(
      [
        s|test::opalfossil2::function::processingAsOf($businessDate),
        s|$s.specimenCode,
        s|$s.matrixType,
        s|$s.massG
      ],
      [
        'Specimen/AsOf',
        'Specimen/Code',
        'Specimen/Matrix',
        'Specimen/MassG'
      ]
    )};
    mapping: test::opalfossil2::mapping::FossilCatalogMapping;
    runtime: test::opalfossil2::runtime::FossilLiveRuntime;
  }
  testSuites:
  [
    specimenRegisterSuite:
    {
      data:
      [
        connections:
        [
          fossilLive:
            Relational
            #{
              fossil.specimen:
                'specimen_id,specimen_code,matrix_type,mass_g,determination_id,from_z,thru_z\n'+
                '1,SPC-001,SHALE,120.5,10,2026-01-01,9999-12-31\n'+
                '2,SPC-002,LIMESTONE,88.25,11,2024-01-01,2024-06-30\n';
            }#
        ]
      ]
      tests:
      [
        specimensEffectiveInMarch:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            businessDate = %2026-03-01
          ]
          asserts:
          [
            theRetiredSpecimenIsOutOfRange:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Specimen/AsOf":"2026-03-01","Specimen/Code":"SPC-001","Specimen/Matrix":"SHALE","Specimen/MassG":120.5}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
