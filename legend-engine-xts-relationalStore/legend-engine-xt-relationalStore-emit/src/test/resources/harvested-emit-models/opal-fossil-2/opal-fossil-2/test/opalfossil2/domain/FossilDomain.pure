import test::opalfossil2::domain::*;

Class {meta::pure::profiles::doc.doc = 'A palaeontological taxon that a specimen can be determined to.'} test::opalfossil2::domain::FossilTaxon
{
  taxonName: String[1];
  familyName: String[1];
}

Class <<temporal.bitemporal>> {meta::pure::profiles::doc.doc = 'A determination assigning a specimen to a taxon: corrected over processing time as the catalogue is revised, and effective over business time for the interval the determination applies to.'} test::opalfossil2::domain::SpecimenDetermination
{
  determinationCode: String[1];
  confidenceScore: Integer[1];
  reviewed: Boolean[1];
}

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'A catalogued fossil specimen, whose recorded matrix and mass are effective over business time.'} test::opalfossil2::domain::FossilSpecimen
{
  specimenCode: String[1];
  matrixType: String[1];
  massG: Float[1];
}

Association test::opalfossil2::domain::Specimen_Determination
{
  specimen: FossilSpecimen[*];
  determination: SpecimenDetermination[0..1];
}

Association test::opalfossil2::domain::Determination_Taxon
{
  determination: SpecimenDetermination[*];
  taxon: FossilTaxon[1];
}

function test::opalfossil2::function::processingAsOf(requested: StrictDate[1]): StrictDate[1]
{
  $requested
}

function test::opalfossil2::function::catalogLabel(code: String[1]): String[1]
{
  'CAT-' + $code
}
