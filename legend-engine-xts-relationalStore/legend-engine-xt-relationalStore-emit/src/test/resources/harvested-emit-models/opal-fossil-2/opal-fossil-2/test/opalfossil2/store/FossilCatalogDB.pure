###Relational
Database test::opalfossil2::store::FossilCatalogDB
(
  Schema fossil
  (
    Table taxon
    (
      taxon_id INTEGER PRIMARY KEY,
      taxon_name VARCHAR(120) NOT NULL,
      family_name VARCHAR(120) NOT NULL
    )
    Table determination
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z),
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      determination_id INTEGER PRIMARY KEY,
      determination_code VARCHAR(24) NOT NULL,
      confidence_score INTEGER NOT NULL,
      reviewed BIT NOT NULL,
      taxon_id INTEGER NOT NULL,
      in_z DATE NOT NULL,
      out_z DATE NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
    Table specimen
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      specimen_id INTEGER PRIMARY KEY,
      specimen_code VARCHAR(24) NOT NULL,
      matrix_type VARCHAR(24) NOT NULL,
      mass_g DOUBLE NOT NULL,
      determination_id INTEGER NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
  )

  Join Specimen_Determination(fossil.specimen.determination_id = fossil.determination.determination_id)

  Join Determination_Taxon(fossil.determination.taxon_id = fossil.taxon.taxon_id)
)
