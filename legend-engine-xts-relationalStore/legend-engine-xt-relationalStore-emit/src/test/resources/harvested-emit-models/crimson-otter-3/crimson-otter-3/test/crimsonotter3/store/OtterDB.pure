###Relational
Database demo::crimsonotter3::store::OtterDB
(
  Schema survey
  (
    Table river_reach
    (
      reach_code VARCHAR(24) PRIMARY KEY,
      reach_name VARCHAR(120) NOT NULL,
      catchment_code VARCHAR(24) NOT NULL
    )
    Table otter_holt
    (
      holt_code VARCHAR(24) PRIMARY KEY,
      holt_name VARCHAR(120) NOT NULL,
      reach_code VARCHAR(24) NOT NULL,
      grade_code VARCHAR(8) NOT NULL,
      bank_side VARCHAR(8) NOT NULL,
      last_visited_on DATE NOT NULL,
      spraint_count INTEGER NOT NULL
    )
    Table holt_visit
    (
      visit_code VARCHAR(24) PRIMARY KEY,
      holt_code VARCHAR(24) NOT NULL,
      visited_on DATE NOT NULL,
      outcome_code VARCHAR(16) NOT NULL,
      observer_name VARCHAR(120) NOT NULL,
      minutes_spent INTEGER NOT NULL
    )
  )

  Join Holt_Reach(survey.otter_holt.reach_code = survey.river_reach.reach_code)
  Join Holt_Visits(survey.otter_holt.holt_code = survey.holt_visit.holt_code)
)
