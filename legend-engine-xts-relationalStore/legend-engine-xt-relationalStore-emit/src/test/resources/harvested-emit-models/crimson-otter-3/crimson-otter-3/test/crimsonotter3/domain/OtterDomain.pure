###Pure
import demo::crimsonotter3::domain::*;

Class {meta::pure::profiles::doc.doc = 'A monitored river reach gathering the bankside holts of one catchment.'} demo::crimsonotter3::domain::RiverReach
{
  reachCode: String[1];
  reachName: String[1];
  catchmentCode: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A bankside otter holt whose catchment is reached through the river reach it sits on.'} demo::crimsonotter3::domain::OtterHolt
{
  holtCode: String[1];
  holtName: String[1];
  gradeCode: String[1];
  bankSide: String[1];
  lastVisitedOn: StrictDate[1];
  spraintCount: Integer[1];
  catchmentCode: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'One recorded field visit to a holt, carrying the outcome the surveyor logged.'} demo::crimsonotter3::domain::HoltVisit
{
  visitCode: String[1];
  visitedOn: StrictDate[1];
  outcomeCode: String[1];
  observerName: String[1];
  minutesSpent: Integer[1];
}

Association {meta::pure::profiles::doc.doc = 'Links a holt to the field visits recorded on it, supplying the collection a survey predicate folds over.'} demo::crimsonotter3::domain::Holt_Visits
{
  holt: OtterHolt[0..1];
  visits: HoltVisit[*];
}
