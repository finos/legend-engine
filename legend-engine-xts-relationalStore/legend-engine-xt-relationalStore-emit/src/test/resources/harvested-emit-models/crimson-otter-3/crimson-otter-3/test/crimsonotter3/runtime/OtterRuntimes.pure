###Runtime
Runtime demo::crimsonotter3::runtime::OtterFieldRuntime
{
  mappings:
  [
    demo::crimsonotter3::mapping::OtterMapping
  ];
  connections:
  [
    demo::crimsonotter3::store::OtterDB:
    [
      fieldConnection: demo::crimsonotter3::connection::OtterFieldConnection
    ]
  ];
}

Runtime demo::crimsonotter3::runtime::OtterMirrorRuntime
{
  mappings:
  [
    demo::crimsonotter3::mapping::OtterMapping
  ];
  connections:
  [
    demo::crimsonotter3::store::OtterDB:
    [
      mirrorConnection: demo::crimsonotter3::connection::OtterMirrorConnection
    ]
  ];
}
