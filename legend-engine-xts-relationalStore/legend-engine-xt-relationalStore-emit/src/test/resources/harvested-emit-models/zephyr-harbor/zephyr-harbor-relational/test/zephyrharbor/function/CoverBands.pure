function {meta::pure::profiles::doc.doc = 'Accepts only the kelp cover bands the survey programme publishes, so the station constraint can delegate its check.'} test::zephyrharbor::function::isKnownBand(band: String[0..1]): Boolean[1]
{
  if($band->isEmpty(),
    | true,
    | ['CANOPY_CLOSED', 'CANOPY_DENSE', 'CANOPY_BROKEN', 'BED_PATCHY', 'BED_SPARSE', 'BED_THIN', 'BED_TRACE', 'BED_BARE', 'UNSURVEYED']->contains($band->toOne())
  )
}

function {meta::pure::profiles::doc.doc = 'Collapses an optional inbound note collection to a single line, distinguishing empty, single and multi-line notes.'} test::zephyrharbor::function::noteLine(notes: String[*]): String[0..1]
{
  if($notes->size() == 0,
    | []->cast(@String),
    | if($notes->size() == 1,
      | $notes->toOne(),
      | $notes->at(0) + ' (+more)'
    )
  )
}
