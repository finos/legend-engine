###Mapping
Mapping test::zephyrharbor::mapping::HarbourReliefMapping
(
  test::zephyrharbor::domain::DiveSurvey[tideSurveys]: Relational
  {
    ~primaryKey
    (
      [test::zephyrharbor::store::HarbourDB]tide.dive_survey.survey_id
    )
    ~mainTable [test::zephyrharbor::store::HarbourDB]tide.dive_survey
    surveyId: concat([test::zephyrharbor::store::HarbourDB]tide.dive_survey.survey_id, '-T'),
    kelpCoverPct: [test::zephyrharbor::store::HarbourDB]tide.dive_survey.kelp_cover_pct,
    visibilityMetres: [test::zephyrharbor::store::HarbourDB]tide.dive_survey.visibility_metres,
    grade: EnumerationMapping ReliefGradeMap: toUpper([test::zephyrharbor::store::HarbourDB]tide.dive_survey.survey_grade)
  }

  test::zephyrharbor::domain::DiveSurvey[reliefSurveys]: Relational
  {
    ~filter [test::zephyrharbor::store::HarbourDB]StaffedReliefSurveys
    ~primaryKey
    (
      [test::zephyrharbor::store::HarbourDB]shoreline.relief_survey.survey_id
    )
    ~mainTable [test::zephyrharbor::store::HarbourDB]shoreline.relief_survey
    surveyId: concat([test::zephyrharbor::store::HarbourDB]shoreline.relief_survey.survey_id, '-R'),
    kelpCoverPct: [test::zephyrharbor::store::HarbourDB]shoreline.relief_survey.kelp_cover_pct,
    visibilityMetres: [test::zephyrharbor::store::HarbourDB]shoreline.relief_survey.visibility_metres,
    grade: EnumerationMapping ReliefGradeMap: toUpper([test::zephyrharbor::store::HarbourDB]shoreline.relief_survey.survey_grade)
  }

  *test::zephyrharbor::domain::DiveSurvey: Operation
  {
    meta::pure::router::operations::union_OperationSetImplementation_1__SetImplementation_MANY_(tideSurveys, reliefSurveys)
  }

  test::zephyrharbor::domain::SurveyGrade: EnumerationMapping ReliefGradeMap
  {
    ACCEPTED: ['ACCEPTED'],
    REPEAT: ['REPEAT']
  }

  testSuites:
  [
    reliefUnionSuite:
    {
      function: |test::zephyrharbor::domain::DiveSurvey.all()->project(
        [
          d|$d.surveyId,
          d|$d.kelpCoverPct
        ],
        [
          'SurveyId',
          'KelpCoverPct'
        ]
      )->sort([asc('SurveyId')]);
      tests:
      [
        unionAcrossSchemas:
        {
          doc: 'Reads the same class from two tables in different schemas through the union operation, with one relief row dropped by the set filter because it carries no diver.';
          data:
          [
            test::zephyrharbor::store::HarbourDB:
              Relational
              #{
                tide.dive_survey:
                  'survey_id,station_id,kelp_cover_pct,visibility_metres,diver_id,survey_grade\n'+
                  'SV-01,ST-01,95,7.5,DV-01,ACCEPTED\n';

                shoreline.relief_survey:
                  'survey_id,station_id,kelp_cover_pct,visibility_metres,diver_id,survey_grade\n'+
                  'RS-01,ST-01,44,3.5,DV-02,REPEAT\n'+
                  'RS-02,ST-03,21,2,,ACCEPTED\n';
              }#
          ];
          asserts:
          [
            unionRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"SurveyId":"RS-01-R","KelpCoverPct":44.0},{"SurveyId":"SV-01-T","KelpCoverPct":95.0}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
