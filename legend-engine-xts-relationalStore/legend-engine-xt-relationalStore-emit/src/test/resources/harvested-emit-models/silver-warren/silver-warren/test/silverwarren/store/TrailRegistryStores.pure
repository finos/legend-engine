###Relational
Database test::silverwarren::store::TrailRegistryFieldDB
(
  Schema FIELDREF
  (
    Table TRAIL_SEGMENT
    (
      segment_code VARCHAR(24) PRIMARY KEY,
      expiry_key BIGINT PRIMARY KEY,
      segment_name VARCHAR(120),
      corridor_code VARCHAR(24),
      corridor_name VARCHAR(120),
      surface_kind VARCHAR(24),
      surface_grade VARCHAR(24),
      district_code VARCHAR(24),
      district_name VARCHAR(120),
      length_metres BIGINT,
      ascent_metres BIGINT,
      width_centimetres BIGINT,
      access_note VARCHAR(240),
      steward_team VARCHAR(120),
      inspection_cycle VARCHAR(24),
      created_on TIMESTAMP NOT NULL,
      updated_on TIMESTAMP
    )

    Table TRAILHEAD
    (
      trailhead_code VARCHAR(24) PRIMARY KEY,
      expiry_key BIGINT PRIMARY KEY,
      trailhead_name VARCHAR(120),
      corridor_code VARCHAR(24),
      parking_kind VARCHAR(24),
      bay_count BIGINT,
      opened_on TIMESTAMP NOT NULL,
      created_on TIMESTAMP NOT NULL,
      updated_on TIMESTAMP
    )
  )
)


