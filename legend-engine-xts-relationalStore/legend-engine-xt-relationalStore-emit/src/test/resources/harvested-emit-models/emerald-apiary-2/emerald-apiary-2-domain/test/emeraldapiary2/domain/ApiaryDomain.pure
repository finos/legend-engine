###Pure
import test::emeraldapiary2::domain::*;

Class test::emeraldapiary2::domain::InspectionAddress
{
  street: String[1];
  district: String[1];
}

Class test::emeraldapiary2::domain::Apiary
{
  apiaryCode: String[1];
  apiaryName: String[1];
  colonies: Colony[*];
}

Class test::emeraldapiary2::domain::Colony
{
  colonyCode: String[1];
  colonyName: String[1];
  apiary: Apiary[1];
  inspectionAddress: InspectionAddress[1];
}

Class test::emeraldapiary2::domain::HiveInspection
{
  inspectionCode: String[1];
  colonyCode: String[1];
  inspectedOn: StrictDate[1];
  inspectorName: String[1];
  apiaryName: String[1];
  inspectionStamp: InspectionStamp[1];
}

Class test::emeraldapiary2::domain::InspectionStamp
{
  inspectorAlias: String[1];
  apiaryLabel: String[1];
}

Class test::emeraldapiary2::domain::TreatmentInspection extends HiveInspection
{
  treatmentCode: String[1];
  treatmentNotes: String[0..1];
}

Class test::emeraldapiary2::domain::RoutineInspection extends HiveInspection
{
  observationNote: String[0..1];
}

Association test::emeraldapiary2::domain::Apiary_Colony
{
  apiary: Apiary[1];
  colonies: Colony[*];
}
