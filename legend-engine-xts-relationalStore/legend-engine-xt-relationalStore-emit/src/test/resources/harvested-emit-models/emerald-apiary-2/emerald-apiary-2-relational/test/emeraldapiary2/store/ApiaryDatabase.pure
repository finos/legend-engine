###Relational
Database test::emeraldapiary2::store::ApiaryDatabase
(
  Schema apiary
  (
    Table apiary_site
    (
      apiary_code VARCHAR(24) PRIMARY KEY,
      apiary_name VARCHAR(100) NOT NULL
    )
    Table apiary_archive
    (
      apiary_code VARCHAR(24) PRIMARY KEY,
      apiary_name VARCHAR(100) NOT NULL
    )
    Table colony
    (
      colony_code VARCHAR(24) PRIMARY KEY,
      colony_name VARCHAR(100) NOT NULL,
      apiary_code VARCHAR(24) NOT NULL,
      street VARCHAR(120) NOT NULL,
      district VARCHAR(80) NOT NULL
    )
  )
  Schema inspection
  (
    Table hive_inspection
    (
      inspection_code VARCHAR(24) PRIMARY KEY,
      colony_code VARCHAR(24) NOT NULL,
      inspected_on DATE NOT NULL,
      inspector_name VARCHAR(100) NOT NULL
    )
    Table treatment_inspection
    (
      inspection_code VARCHAR(24) PRIMARY KEY,
      treatment_code VARCHAR(24) NOT NULL,
      treatment_notes VARCHAR(200)
    )
    Table routine_inspection
    (
      inspection_code VARCHAR(24) PRIMARY KEY,
      observation_note VARCHAR(200)
    )
  )

  Join Colony_Apiary(apiary.colony.apiary_code = apiary.apiary_site.apiary_code)
  Join Inspection_Colony(inspection.hive_inspection.colony_code = apiary.colony.colony_code)
  Join Treatment_Inspection(inspection.treatment_inspection.inspection_code = inspection.hive_inspection.inspection_code)
  Join Routine_Inspection(inspection.routine_inspection.inspection_code = inspection.hive_inspection.inspection_code)
)
