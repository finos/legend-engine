###Relational
Database demo::coppercanyon::store::ObservatoryDB
(
  Schema sky
  (
    Table field_plate
    (
      plate_id INTEGER PRIMARY KEY,
      plate_code VARCHAR(32) NOT NULL,
      field_name VARCHAR(120) NOT NULL,
      declination_deg DOUBLE NOT NULL
    )
    Table exposure
    (
      exposure_id INTEGER PRIMARY KEY,
      exposure_ref VARCHAR(32) NOT NULL,
      plate_id INTEGER NOT NULL,
      instrument_id INTEGER NOT NULL,
      exposure_seconds INTEGER NOT NULL,
      filter_code VARCHAR(12),
      seeing_arcsec DOUBLE
    )
  )

  Schema registry
  (
    Table instrument
    (
      instrument_id INTEGER PRIMARY KEY,
      instrument_name VARCHAR(120) NOT NULL,
      mount_kind VARCHAR(40) NOT NULL
    )
  )

  Join Exposure_Plate(sky.exposure.plate_id = sky.field_plate.plate_id)
  Join Exposure_Instrument(sky.exposure.instrument_id = registry.instrument.instrument_id)
)
