import demo::coppercanyon::domain::*;
import meta::pure::profiles::*;

Class {doc.doc = 'A raw plate-exposure record as the survey telescope logs it, before any observing-night grading is applied.'} demo::coppercanyon::domain::ExposureFeed
{
  plateCode: String[1];
  exposureRef: String[1];
  fieldName: String[1];
  instrumentName: String[1];
  exposureSeconds: Integer[1];
  filterCode: String[0..1];
  seeingArcsec: Float[0..1];
}

Class {doc.doc = 'A graded plate-exposure digest: a composed survey key, a resolved filter band, a duration band and a seeing note derived from the raw exposure record.'} demo::coppercanyon::domain::ExposureDigest
{
  digestKey: String[1];
  fieldName: String[1];
  instrumentName: String[1];
  filterBand: String[1];
  durationBand: String[1];
  seeingNote: String[1];
}
