###Relational
Database test::lunarwillow5::store::LibraryDatabase
(
  Schema library
  (
    Table catalogue_record
    (
      catalogue_code VARCHAR(32) PRIMARY KEY,
      title VARCHAR(256) NOT NULL,
      subtitle VARCHAR(256) NOT NULL,
      author_name VARCHAR(160) NOT NULL,
      imprint_name VARCHAR(160) NOT NULL,
      edition_label VARCHAR(96) NOT NULL,
      language_code VARCHAR(16) NOT NULL,
      shelf_mark VARCHAR(48) NOT NULL,
      collection_name VARCHAR(128) NOT NULL,
      branch_name VARCHAR(128) NOT NULL,
      section_name VARCHAR(128) NOT NULL,
      genre_label VARCHAR(96) NOT NULL,
      format_label VARCHAR(64) NOT NULL,
      binding_label VARCHAR(64) NOT NULL,
      summary_text VARCHAR(256) NOT NULL,
      subject_heading VARCHAR(128) NOT NULL,
      series_label VARCHAR(128) NOT NULL,
      contributor_name VARCHAR(160) NOT NULL,
      illustrator_name VARCHAR(160) NOT NULL,
      translator_name VARCHAR(160) NOT NULL,
      publication_place VARCHAR(128) NOT NULL,
      publisher_code VARCHAR(64) NOT NULL,
      circulation_status VARCHAR(32) NOT NULL,
      availability_label VARCHAR(64) NOT NULL,
      audience_label VARCHAR(64) NOT NULL,
      reading_level VARCHAR(64) NOT NULL,
      condition_label VARCHAR(64) NOT NULL,
      acquisition_source VARCHAR(128) NOT NULL,
      call_number VARCHAR(64) NOT NULL,
      barcode_value VARCHAR(64) NOT NULL,
      record_status VARCHAR(32) NOT NULL,
      cover_color VARCHAR(64) NOT NULL,
      spine_color VARCHAR(64) NOT NULL,
      cataloguer_note VARCHAR(256) NOT NULL,
      display_note VARCHAR(256) NOT NULL,
      search_keywords VARCHAR(256) NOT NULL,
      alternate_title VARCHAR(256) NOT NULL,
      original_language VARCHAR(64) NOT NULL,
      country_of_origin VARCHAR(96) NOT NULL,
      donor_name VARCHAR(160) NOT NULL,
      accession_note VARCHAR(256) NOT NULL,
      review_label VARCHAR(64) NOT NULL,
      route_label VARCHAR(64) NOT NULL,
      storage_zone VARCHAR(64) NOT NULL,
      handling_note VARCHAR(256) NOT NULL,
      replacement_code VARCHAR(64) NOT NULL,
      record_group VARCHAR(64) NOT NULL,
      classification_note VARCHAR(256) NOT NULL,
      page_count INTEGER NOT NULL,
      copy_count INTEGER NOT NULL,
      borrowing_period_days INTEGER NOT NULL,
      branch_number INTEGER NOT NULL,
      shelf_level INTEGER NOT NULL,
      volume_number INTEGER NOT NULL,
      print_run INTEGER NOT NULL,
      height_cm FLOAT NOT NULL,
      width_cm FLOAT NOT NULL,
      weight_kg FLOAT NOT NULL,
      reading_score FLOAT NOT NULL,
      condition_score FLOAT NOT NULL,
      published_at TIMESTAMP NOT NULL,
      acquired_at TIMESTAMP NOT NULL,
      last_reviewed_at TIMESTAMP NOT NULL,
      withdrawn_at TIMESTAMP NOT NULL
    )

    Table catalogue_note
    (
      note_code VARCHAR(32) PRIMARY KEY,
      catalogue_code VARCHAR(32) NOT NULL,
      note_text VARCHAR(256) NOT NULL
    )

    Table circulation_event
    (
      event_code VARCHAR(32) PRIMARY KEY,
      catalogue_code VARCHAR(32) NOT NULL,
      event_type VARCHAR(64) NOT NULL,
      event_at TIMESTAMP NOT NULL
    )
  )
)
