  branchName: String[1];
  sectionName: String[1];
  genreLabel: String[1];
  formatLabel: String[1];
  bindingLabel: String[1];
  summaryText: String[1];
  subjectHeading: String[1];
  seriesLabel: String[1];
  contributorName: String[1];
  illustratorName: String[1];
  translatorName: String[1];
  publicationPlace: String[1];
  publisherCode: String[1];
  circulationStatus: String[1];
  availabilityLabel: String[1];
  audienceLabel: String[1];
  readingLevel: String[1];
  conditionLabel: String[1];
  acquisitionSource: String[1];
  callNumber: String[1];
  barcodeValue: String[1];
  recordStatus: String[1];
  coverColor: String[1];
  spineColor: String[1];
  cataloguerNote: String[1];
  displayNote: String[1];
  searchKeywords: String[1];
  alternateTitle: String[1];
  originalLanguage: String[1];
  countryOfOrigin: String[1];
  donorName: String[1];
  accessionNote: String[1];
  reviewLabel: String[1];
  routeLabel: String[1];
  storageZone: String[1];
  handlingNote: String[1];
  replacementCode: String[1];
  recordGroup: String[1];
  classificationNote: String[1];
  pageCount: Integer[1];
  copyCount: Integer[1];
  borrowingPeriodDays: Integer[1];
  branchNumber: Integer[1];
  shelfLevel: Integer[1];
  volumeNumber: Integer[1];
  printRun: Integer[1];
  heightCm: Float[1];
  widthCm: Float[1];
  weightKg: Float[1];
  readingScore: Float[1];
  conditionScore: Float[1];
  publishedAt: DateTime[1];
  acquiredAt: DateTime[1];
  lastReviewedAt: DateTime[1];
  withdrawnAt: DateTime[1];
}

Class {meta::pure::profiles::doc.doc = 'A short curator note attached to a catalogue record, stored in a secondary relation to exercise the multi-table store shape.'} test::lunarwillow5::domain::CatalogueNote
{
  noteCode: String[1];
  catalogueCode: String[1];
  noteText: String[1];
}

Class {meta::pure::profiles::doc.doc = 'One circulation event associated with a catalogue record, stored in the second supporting relation.'} test::lunarwillow5::domain::CirculationEvent
{
  eventCode: String[1];
  catalogueCode: String[1];
  eventType: String[1];
  eventAt: DateTime[1];
}
