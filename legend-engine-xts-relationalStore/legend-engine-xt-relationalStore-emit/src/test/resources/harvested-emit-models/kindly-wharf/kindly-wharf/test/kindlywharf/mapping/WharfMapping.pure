    departAt: [test::kindlywharf::store::WharfDB]wharf.gate_move.depart_at,
    moveLabel: concat(concat(toUpper(trim([test::kindlywharf::store::WharfDB]wharf.gate_move.gate_code)), '-'), [test::kindlywharf::store::WharfDB]wharf.gate_move.move_ref)
