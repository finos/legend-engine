      [test::kindlywharf::store::WharfDB]wharf.crane_shift.shift_ref,
      [test::kindlywharf::store::WharfDB]wharf.crane_shift.crane_code,
      [test::kindlywharf::store::WharfDB]wharf.crane_shift.shift_date,
      [test::kindlywharf::store::WharfDB]wharf.crane_shift.cut_code,
      [test::kindlywharf::store::WharfDB]wharf.crane_shift.valid_from
    )
    ~mainTable [test::kindlywharf::store::WharfDB]wharf.crane_shift
    shiftRef: [test::kindlywharf::store::WharfDB]wharf.crane_shift.shift_ref,
    craneCode: [test::kindlywharf::store::WharfDB]wharf.crane_shift.crane_code,
    shiftDate: [test::kindlywharf::store::WharfDB]wharf.crane_shift.shift_date,
    cutCode: [test::kindlywharf::store::WharfDB]wharf.crane_shift.cut_code,
    validFrom: [test::kindlywharf::store::WharfDB]wharf.crane_shift.valid_from,
    validThru: [test::kindlywharf::store::WharfDB]wharf.crane_shift.valid_thru,
    operatorName: [test::kindlywharf::store::WharfDB]wharf.crane_shift.operator_name,
    liftCount: [test::kindlywharf::store::WharfDB]wharf.crane_shift.lift_count,
    movedT: [test::kindlywharf::store::WharfDB]wharf.crane_shift.moved_t,
    idleMin: [test::kindlywharf::store::WharfDB]wharf.crane_shift.idle_min,
    activeMin: minus(480, [test::kindlywharf::store::WharfDB]wharf.crane_shift.idle_min),
    groupCode: [test::kindlywharf::store::WharfDB]wharf.crane_shift.group_code,
    shiftLabel: concat(concat(toUpper(trim([test::kindlywharf::store::WharfDB]wharf.crane_shift.crane_code)), '#'), [test::kindlywharf::store::WharfDB]wharf.crane_shift.shift_ref)
  }

