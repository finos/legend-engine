###Mapping
Mapping test::kindlywharf::mapping::WharfMapping
(
  *test::kindlywharf::domain::BerthCall[call]: Relational
  {
    ~primaryKey
    (
      [test::kindlywharf::store::WharfDB]wharf.berth_call.call_ref,
      [test::kindlywharf::store::WharfDB]wharf.berth_call.berth_code,
      [test::kindlywharf::store::WharfDB]wharf.berth_call.call_date,
      [test::kindlywharf::store::WharfDB]wharf.berth_call.cut_code,
      [test::kindlywharf::store::WharfDB]wharf.berth_call.lane_code,
      [test::kindlywharf::store::WharfDB]wharf.berth_call.valid_from
    )
    ~mainTable [test::kindlywharf::store::WharfDB]wharf.berth_call
    callRef: [test::kindlywharf::store::WharfDB]wharf.berth_call.call_ref,
    berthCode: [test::kindlywharf::store::WharfDB]wharf.berth_call.berth_code,
    callDate: [test::kindlywharf::store::WharfDB]wharf.berth_call.call_date,
    cutCode: [test::kindlywharf::store::WharfDB]wharf.berth_call.cut_code,
    laneCode: [test::kindlywharf::store::WharfDB]wharf.berth_call.lane_code,
    validFrom: [test::kindlywharf::store::WharfDB]wharf.berth_call.valid_from,
    validThru: [test::kindlywharf::store::WharfDB]wharf.berth_call.valid_thru,
    vesselName: [test::kindlywharf::store::WharfDB]wharf.berth_call.vessel_name,
    moorKind: [test::kindlywharf::store::WharfDB]wharf.berth_call.moor_kind,
    tonnageT: [test::kindlywharf::store::WharfDB]wharf.berth_call.tonnage_t,
    teuCount: [test::kindlywharf::store::WharfDB]wharf.berth_call.teu_count,
    pilotName: [test::kindlywharf::store::WharfDB]wharf.berth_call.pilot_name,
    groupCode: [test::kindlywharf::store::WharfDB]wharf.berth_call.group_code,
    callLabel: concat(concat(toUpper(trim([test::kindlywharf::store::WharfDB]wharf.berth_call.berth_code)), '/'), [test::kindlywharf::store::WharfDB]wharf.berth_call.call_ref)
  }

  *test::kindlywharf::domain::CraneShift[shift]: Relational
