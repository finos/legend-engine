###Mapping
Mapping test::coppertundra::mapping::TundraMapping
(
  *test::coppertundra::domain::CollaredAnimal[collared]: Relational
  {
    ~filter [test::coppertundra::store::TundraDb]ActiveCollar
    ~primaryKey
    (
      [test::coppertundra::store::TundraDb]registry.animal.animal_tag
    )
    ~mainTable [test::coppertundra::store::TundraDb]registry.animal
    animalTag: [test::coppertundra::store::TundraDb]registry.animal.animal_tag,
    species: [test::coppertundra::store::TundraDb]registry.animal.species,
    tagCode: [test::coppertundra::store::TundraDb]registry.animal.tag_code,
    batteryPct: [test::coppertundra::store::TundraDb]registry.animal.battery_pct,
    collarActive: [test::coppertundra::store::TundraDb]registry.animal.collar_active
  }

  *test::coppertundra::domain::HerdSighting[sighting]: Relational
  {
    ~primaryKey
    (
      [test::coppertundra::store::TundraDb]field.sighting.sighting_id
    )
    ~mainTable [test::coppertundra::store::TundraDb]field.sighting
    sightingId: [test::coppertundra::store::TundraDb]field.sighting.sighting_id,
    animalTag: [test::coppertundra::store::TundraDb]field.sighting.animal_tag,
    herdCode: [test::coppertundra::store::TundraDb]field.sighting.herd_code,
    terrainCode: [test::coppertundra::store::TundraDb]field.sighting.terrain_code,
    countSeen: [test::coppertundra::store::TundraDb]field.sighting.count_seen,
    sightedSpecies: [test::coppertundra::store::TundraDb]@Sighting_Animal | registry.animal.species
  }
)
