###Relational
Database test::coppertundra::store::TundraDb
(
  Schema field
  (
    Table sighting
    (
      sighting_id INTEGER PRIMARY KEY,
      animal_tag VARCHAR(40) NOT NULL,
      herd_code VARCHAR(20) NOT NULL,
      terrain_code VARCHAR(20) NOT NULL,
      count_seen INTEGER NOT NULL
    )

    View herd_terrain_totals
    (
      ~groupBy
      (
        field.sighting.herd_code,
        field.sighting.terrain_code
      )
      herd_code: field.sighting.herd_code PRIMARY KEY,
      terrain_code: field.sighting.terrain_code PRIMARY KEY,
      total_seen: sum(field.sighting.count_seen),
      sighting_count: count(field.sighting.sighting_id)
    )
  )

  Schema registry
  (
    Table animal
    (
      animal_tag VARCHAR(40) PRIMARY KEY,
      species VARCHAR(80) NOT NULL,
      tag_code VARCHAR(40) NOT NULL,
      battery_pct INTEGER,
      collar_active BIT NOT NULL
    )
  )

  Join Sighting_Animal(field.sighting.animal_tag = registry.animal.animal_tag)

  Filter ActiveCollar(registry.animal.collar_active = 1)
)
