###Relational
Database test::goldenmeadow::store::MeadowSurveyDb
(
  Schema meadow
  (
    Table pollinator_patch
    (
      milestoning
      (
        business(BUS_FROM = bus_from_z, BUS_THRU = bus_thru_z)
      )

      patch_code VARCHAR(16) PRIMARY KEY,
      patch_name VARCHAR(120) NOT NULL,
      flora_code VARCHAR(24) NOT NULL,
      bloom_index INTEGER NOT NULL,
      steward_code VARCHAR(16),
      bus_from_z TIMESTAMP NOT NULL,
      bus_thru_z TIMESTAMP NOT NULL
    )

    Table steward_crew
    (
      milestoning
      (
        business(BUS_FROM = bus_from_z, BUS_THRU = bus_thru_z)
      )

      steward_code VARCHAR(16) PRIMARY KEY,
      crew_name VARCHAR(120) NOT NULL,
      depot_code VARCHAR(64) NOT NULL,
      bus_from_z TIMESTAMP NOT NULL,
      bus_thru_z TIMESTAMP NOT NULL
    )
  )

  Join Patch_Crew_J(meadow.pollinator_patch.steward_code = meadow.steward_crew.steward_code)
)
