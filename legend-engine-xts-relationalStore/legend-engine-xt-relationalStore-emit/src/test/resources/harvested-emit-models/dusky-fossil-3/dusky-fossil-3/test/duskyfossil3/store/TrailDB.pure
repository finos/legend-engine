###Relational
Database test::duskyfossil3::store::TrailDB
(
  Schema trail
  (
    Table condition_report
    (
      report_id VARCHAR(24) PRIMARY KEY,
      site_code VARCHAR(24) NOT NULL,
      segment_code VARCHAR(24) NOT NULL,
      region_code VARCHAR(16) NOT NULL,
      stratum_code VARCHAR(16) NOT NULL,
      survey_kind VARCHAR(16) NOT NULL,
      condition_grade VARCHAR(16) NOT NULL,
      recorded_on DATE NOT NULL,
      erosion_index INTEGER NOT NULL,
      fragment_count INTEGER NOT NULL,
      recorder_code VARCHAR(16),
      note_text VARCHAR(240)
    )
  )
)
