###Relational
Database test::emeralddelta5::store::HerbariumDb
(
  Schema herbarium
  (
    Table specimen_sheet
    (
      milestoning
      (
        business(BUS_FROM = valid_from, BUS_THRU = valid_thru, INFINITY_DATE = %9999-12-31T00:00:00.0000)
      )

      sheet_code VARCHAR(24) PRIMARY KEY,
      cabinet_code VARCHAR(20) NOT NULL,
      family_name VARCHAR(48) NOT NULL,
      genus_name VARCHAR(48) NOT NULL,
      species_epithet VARCHAR(48) NOT NULL,
      collector_code VARCHAR(24) NOT NULL,
      locality_code VARCHAR(24) NOT NULL,
      condition_grade VARCHAR(8) NOT NULL,
      mounted_height_cm FLOAT NOT NULL,
      valid_from DATE NOT NULL,
      valid_thru DATE NOT NULL
    )
  )
)
