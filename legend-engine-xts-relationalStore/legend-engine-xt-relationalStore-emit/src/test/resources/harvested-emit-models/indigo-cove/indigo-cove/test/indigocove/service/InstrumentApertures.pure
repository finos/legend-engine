###Service
Service test::indigocove::service::InstrumentApertures
{
  pattern: '/indigocove/v1/apertures/{env}/{observatoryCode}';
  title: 'Indigo Cove - Optical Instrument Apertures (keyed environments)';
  owners:
  [
    'observatory-registry',
    'skywatch-eng'
  ];
  documentation: 'Keyed execution over the observatory instrument register: one shared projection narrows the register to its optical subtype and reports aperture readings for a given observatory, bound to a primary and a standby environment each supplying its own runtime over the shared instrument database.';
  autoActivateUpdates: true;
  execution: Multi
  {
    query: {observatoryCode: String[1]|test::indigocove::domain::Instrument.all()->filter(
      x|((($x.siteCode == $observatoryCode) && ($x.statusCode == 'ACTIVE')) || (($x.siteCode == $observatoryCode) && ($x.statusCode == 'STANDBY'))) || (($x.statusCode == 'ACTIVE') && $x.siteCode->in(['ZENITH', 'MERIDIAN', 'APEX']))
    )->project(
      [
        x|$x.instrumentId,
        x|$x.siteCode->toUpper(),
        x|$x->subType(@test::indigocove::domain::OpticalInstrument).apertureMm,
        x|$x.instrumentId->length()
      ],
      [
        'Instrument',
        'Site',
        'ApertureMm',
        'TagLength'
      ]
    )->distinct()->sort([asc('Instrument')])->take(50)};
    key: 'env';
    executions['primary']:
    {
      mapping: test::indigocove::mapping::InstrumentMapping;
      runtime: test::indigocove::runtime::InstrumentPrimaryRuntime;
    }
    executions['standby']:
    {
      mapping: test::indigocove::mapping::InstrumentMapping;
      runtime: test::indigocove::runtime::InstrumentStandbyRuntime;
    }
  }
}
