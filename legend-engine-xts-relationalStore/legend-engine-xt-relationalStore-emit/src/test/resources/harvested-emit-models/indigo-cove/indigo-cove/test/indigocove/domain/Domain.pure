Class {meta::pure::profiles::doc.doc = 'An observatory instrument tracked in the site register.'} test::indigocove::domain::Instrument
{
  instrumentId: String[1];
  siteCode: String[1];
  statusCode: String[1];
}

Class {meta::pure::profiles::doc.doc = 'An optical instrument carrying an aperture measurement.'} test::indigocove::domain::OpticalInstrument extends test::indigocove::domain::Instrument
{
  apertureMm: Integer[1];
}

Class {meta::pure::profiles::doc.doc = 'A radio instrument carrying a dish diameter.'} test::indigocove::domain::RadioInstrument extends test::indigocove::domain::Instrument
{
  dishMetres: Integer[1];
}
