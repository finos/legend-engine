###Relational
Database test::indigocove::store::InstrumentDatabase
(
  Schema registry
  (
    Table instrument
    (
      instrument_id VARCHAR(32) PRIMARY KEY,
      site_code VARCHAR(32) NOT NULL,
      status_code VARCHAR(16) NOT NULL,
      kind_code VARCHAR(16) NOT NULL,
      aperture_mm INTEGER,
      dish_metres INTEGER
    )
  )

  Filter OpticalFilter(registry.instrument.kind_code = 'OPTICAL')
  Filter RadioFilter(registry.instrument.kind_code = 'RADIO')
)
