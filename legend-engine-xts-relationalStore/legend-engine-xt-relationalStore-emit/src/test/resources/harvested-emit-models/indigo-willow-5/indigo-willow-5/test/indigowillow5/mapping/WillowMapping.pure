###Mapping
Mapping test::indigowillow5::mapping::WillowMapping
(
  *test::indigowillow5::domain::WillowHabitat: Relational
  {
    ~primaryKey
    (
      [test::indigowillow5::store::WillowDatabase]willow.willow_habitat.habitat_id
    )
    ~mainTable [test::indigowillow5::store::WillowDatabase]willow.willow_habitat
    habitatCode: [test::indigowillow5::store::WillowDatabase]willow.willow_habitat.habitat_code,
    reedArea: [test::indigowillow5::store::WillowDatabase]willow.willow_habitat.reed_area,
    lastCheckOn: [test::indigowillow5::store::WillowDatabase]willow.willow_habitat.last_check_on,
    programCode: concat('WILLOW-GROVE-', [test::indigowillow5::store::WillowDatabase]willow.willow_habitat.habitat_code),
    observer: [test::indigowillow5::store::WillowDatabase]@Habitat_Observer
  }

  *test::indigowillow5::domain::TrailObserver: Relational
  {
    ~primaryKey
    (
      [test::indigowillow5::store::WillowDatabase]willow.trail_observer.observer_id
    )
    ~mainTable [test::indigowillow5::store::WillowDatabase]willow.trail_observer
    observerCode: [test::indigowillow5::store::WillowDatabase]willow.trail_observer.observer_code,
    permitTag: [test::indigowillow5::store::WillowDatabase]willow.trail_observer.permit_tag
  }
)
