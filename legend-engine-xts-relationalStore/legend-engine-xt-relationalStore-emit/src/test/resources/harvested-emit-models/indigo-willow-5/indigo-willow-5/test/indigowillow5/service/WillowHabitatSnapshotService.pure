###Service
Service test::indigowillow5::service::WillowHabitatSnapshotService
{
  pattern: '/indigowillow5/willowHabitatSnapshot/{observedOn}';
  title: 'Willow Grove Habitat Snapshot As Of A Date';
  owners:
  [
    'willow-grove-inspection-desk',
    'willow-watch-eng'
  ];
  documentation: 'Opens the willow habitat extent as of the requested date, keeps the habitats walked since the rolling inspection horizon, and projects the habitat code beside a derived programme label and the observer who last walked it.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {observedOn: StrictDate[1]|test::indigowillow5::domain::WillowHabitat.all($observedOn)->project(
      [
        b|$b.habitatCode,
        b|$b.programCode,
        b|$b.observer.observerCode,
        b|$b.habitatCode->toUpper(),
        b|$b.reedArea
      ],
      [
        'Habitat',
        'Programme',
        'Observer',
        'Habitat Label',
        'Reed Area'
      ]
    )->distinct()->sort([asc('Habitat')])};
    mapping: test::indigowillow5::mapping::WillowMapping;
    runtime: test::indigowillow5::runtime::WillowArchiveRuntime;
  }
  testSuites:
  [
    willowHabitatSnapshotSuite:
    {
      data:
      [
        connections:
        [
          willowH2Connection:
            Relational
            #{
              willow.willow_habitat:
                'habitat_id,habitat_code,reed_area,last_check_on,observer_id,from_z,thru_z\n'+
                '1,WIL-A,42,2026-03-02,100,2026-01-01,9999-12-31\n'+
                '2,WIL-B,17,2005-04-19,200,2026-01-01,9999-12-31\n'+
                '3,WIL-C,23,2026-05-11,,2026-01-01,9999-12-31\n'+
                '4,WIL-D,31,2026-02-08,100,2015-01-01,2026-01-01\n';

              willow.trail_observer:
                'observer_id,observer_code,permit_tag\n'+
                '100,REC-A,permit-north\n'+
                '200,REC-B,\n';
            }#
        ]
      ]
      tests:
      [
        habitatsProjectedAsOfDate:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            observedOn = %2026-06-01
          ]
          asserts:
          [
            habitatsAreProjected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Habitat":"WIL-A","Programme":"WILLOW-GROVE-WIL-A","Observer":"REC-A","Habitat Label":"WIL-A","Reed Area":42}, {"Habitat":"WIL-B","Programme":"WILLOW-GROVE-WIL-B","Observer":"REC-B","Habitat Label":"WIL-B","Reed Area":17}, {"Habitat":"WIL-C","Programme":"WILLOW-GROVE-WIL-C","Observer":null,"Habitat Label":"WIL-C","Reed Area":23}]';
                  }#;
              }#
          ]
        },
        snapshotAtEarlierDate:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            observedOn = %2011-06-01
          ]
          asserts:
          [
            noHabitatStandsAtEarlierDate:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
