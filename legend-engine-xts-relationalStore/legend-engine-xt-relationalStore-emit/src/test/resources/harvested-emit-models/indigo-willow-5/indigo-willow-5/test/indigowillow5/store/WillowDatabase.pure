###Relational
Database test::indigowillow5::store::WillowDatabase
(
  Schema willow
  (
    Table willow_habitat
    (
      milestoning
      (
        business(BUS_FROM=from_z, BUS_THRU=thru_z)
      )
      habitat_id INTEGER PRIMARY KEY,
      habitat_code VARCHAR(20) NOT NULL,
      reed_area INTEGER NOT NULL,
      last_check_on DATE NOT NULL,
      observer_id INTEGER,
      from_z DATE PRIMARY KEY,
      thru_z DATE
    )
    Table trail_observer
    (
      observer_id INTEGER PRIMARY KEY,
      observer_code VARCHAR(20) NOT NULL,
      permit_tag VARCHAR(20)
    )
  )

  Join Habitat_Observer(willow.willow_habitat.observer_id = willow.trail_observer.observer_id)
)
