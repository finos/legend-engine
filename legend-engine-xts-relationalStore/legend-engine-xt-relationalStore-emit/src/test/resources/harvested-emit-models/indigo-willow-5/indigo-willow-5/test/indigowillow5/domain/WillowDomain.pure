import test::indigowillow5::domain::*;

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'A willow habitat tracked along a willow willow-grove; its canopy extent, inspection date and the observer who walks it are restated over time.'} test::indigowillow5::domain::WillowHabitat
{
  habitatCode: String[1];
  reedArea: Integer[1];
  lastCheckOn: StrictDate[1];
  programCode: String[1];
  observer: TrailObserver[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A field observer who walks a set of willow habitats and may hold a diving permit tag.'} test::indigowillow5::domain::TrailObserver
{
  observerCode: String[1];
  permitTag: String[0..1];
}
