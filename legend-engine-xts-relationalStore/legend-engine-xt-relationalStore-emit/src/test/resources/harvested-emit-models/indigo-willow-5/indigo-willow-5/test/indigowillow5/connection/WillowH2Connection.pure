###Connection
RelationalDatabaseConnection test::indigowillow5::connection::WillowH2Connection
{
  store: test::indigowillow5::store::WillowDatabase;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists willow;',
      'create schema willow;',
      'create table willow.willow_habitat (habitat_id integer not null, habitat_code varchar(20) not null, reed_area integer not null, last_check_on date not null, observer_id integer, from_z date, thru_z date);',
      'create table willow.trail_observer (observer_id integer primary key, observer_code varchar(20) not null, permit_tag varchar(20));'
      ];
  };
  auth: DefaultH2;
}
