###Service
Service test::copperquokka3::service::HiveInspectionWindow
{
  pattern: '/copperquokka3/{season}/hives/{hiveId}/inspections';
  title: 'Copper Quokka 3 - HiveInspectionWindow';
  documentation: 'Inspections of one hive on or between the window dates, halving the honey weight when one was recorded and showing the unsigned mite change.';
  autoActivateUpdates: false;
  ownership: UserList { users: ['apiary-yard-desk', 'hive-health-leads'] };
  execution: Multi
  {
    query: {start: StrictDate[1], end: StrictDate[1], hiveId: Integer[1]|test::copperquokka3::domain::Inspection.all()->filter(
      i|(($i.hiveId == $hiveId) && ($i.inspectedOn >= $start)) && ($i.inspectedOn <= $end)
    )->project(
      [
        i|$i.inspectionId,
        i|$i.inspectedOn,
        i|$i.hive.hiveName,
        i|$i.hive.yard.yardName,
        i| if($i.honeyKg->isNotEmpty(), |$i.honeyKg->toOne() / 2.0, |[]),
        i|$i.miteDelta->abs()->toString()
      ],
      ['Inspection', 'InspectedOn', 'Hive', 'Yard', 'HalfHoneyKg', 'MiteChange']
    )->sort([asc('Inspection')])};
    key: 'season';
    executions['spring']:
    {
      mapping: test::copperquokka3::mapping::ApiaryMapping;
      runtime: test::copperquokka3::runtime::SpringApiaryRuntime;
    }
    executions['autumn']:
    {
      mapping: test::copperquokka3::mapping::ApiaryMapping;
      runtime: test::copperquokka3::runtime::AutumnApiaryRuntime;
    }
  }
  testSuites:
  [
    hiveInspectionWindowSuite:
    {
      data:
      [
        connections:
        [
          springConn: Reference #{test::copperquokka3::data::ApiaryRows}#,
          autumnConn: Reference #{test::copperquokka3::data::ApiaryRows}#
        ]
      ]
      tests:
      [
        inclusiveBoundsKeepFirstAndLastDay:
        {
          keys: ['spring', 'autumn'];
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            start = %2026-04-01,
            end = %2026-05-01,
            hiveId = 10
          ]
          asserts:
          [
            expectedRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Inspection":100,"InspectedOn":"2026-04-01","Hive":"Amber Box","Yard":"Clover Yard","HalfHoneyKg":6.25,"MiteChange":"3"},{"Inspection":101,"InspectedOn":"2026-04-15","Hive":"Amber Box","Yard":"Clover Yard","HalfHoneyKg":null,"MiteChange":"4"},{"Inspection":102,"InspectedOn":"2026-05-01","Hive":"Amber Box","Yard":"Clover Yard","HalfHoneyKg":10.25,"MiteChange":"2"}]';
                  }#;
              }#
          ]
        },
        hiveWithoutRegisteredYard:
        {
          keys: ['spring', 'autumn'];
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            start = %2026-04-01,
            end = %2026-04-30,
            hiveId = 14
          ]
          asserts:
          [
            expectedRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Inspection":108,"InspectedOn":"2026-04-10","Hive":"Ash Box","Yard":null,"HalfHoneyKg":3.5,"MiteChange":"0"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service test::copperquokka3::service::YardHoneyTotals
{
  pattern: '/copperquokka3/yards/honey';
  title: 'Copper Quokka 3 - YardHoneyTotals';
  documentation: 'Honey, peak brood and distinct hive counts per yard for inspections in the requested regions by inspectors whose name starts with A or contains Lee.';
  autoActivateUpdates: false;
  ownership: DID { identifier: '000000' };
  execution: Single
  {
    query: {regions: String[*]|test::copperquokka3::domain::Inspection.all()->filter(
      i|$i.hive.yard.regionCode->in($regions) && ($i.inspectorName->startsWith('A') || $i.inspectorName->contains('Lee'))
    )->groupBy(
      [
        i|$i.hive.yard.yardName
      ],
      [
        agg(i|$i.honeyKg, y|$y->sum()),
        agg(i|$i.framesBrood, y|$y->max()),
        agg(i|$i.hiveId, y|$y->distinct()->count())
      ],
      ['Yard', 'HoneyKg', 'PeakBrood', 'Hives']
    )->sort([asc('Yard')])};
    mapping: test::copperquokka3::mapping::ApiaryMapping;
    runtime: test::copperquokka3::runtime::SpringApiaryRuntime;
  }
  testSuites:
  [
    yardHoneyTotalsSuite:
    {
      data:
      [
        connections:
        [
          springConn: Reference #{test::copperquokka3::data::ApiaryRows}#
        ]
      ]
      tests:
      [
        northAndWestYards:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            regions = ['NORTH', 'WEST']
          ]
          asserts:
          [
            expectedRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Yard":"Clover Yard","HoneyKg":48.5,"PeakBrood":8,"Hives":2},{"Yard":"Heath Yard","HoneyKg":19.0,"PeakBrood":9,"Hives":1}]';
                  }#;
              }#
          ]
        },
        southYardOnly:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            regions = ['SOUTH']
          ]
          asserts:
          [
            expectedRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Yard":"Lime Yard","HoneyKg":2.5,"PeakBrood":3,"Hives":1}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service test::copperquokka3::service::LineageRegionRoster
{
  pattern: '/copperquokka3/{season}/lineages';
  title: 'Copper Quokka 3 - LineageRegionRoster';
  documentation: 'Distinct queen lineage and yard region pairs seen in inspections since a date.';
  autoActivateUpdates: false;
  ownership: UserList { users: ['apiary-yard-desk', 'hive-health-leads'] };
  execution: Multi
  {
    query: {since: StrictDate[1]|test::copperquokka3::domain::Inspection.all()->filter(
      i|($i.inspectedOn >= $since) && $i.hive.queen.lineage->isNotEmpty()
    )->project(
      [
        i|$i.hive.queen.lineage,
        i|$i.hive.yard.regionCode
      ],
      ['Lineage', 'Region']
    )->distinct()->sort([asc('Lineage'), asc('Region')])};
    key: 'season';
    executions['spring']:
    {
      mapping: test::copperquokka3::mapping::ApiaryMapping;
      runtime: test::copperquokka3::runtime::SpringApiaryRuntime;
    }
    executions['autumn']:
    {
      mapping: test::copperquokka3::mapping::ApiaryMapping;
      runtime: test::copperquokka3::runtime::AutumnApiaryRuntime;
    }
  }
  testSuites:
  [
    lineageRegionRosterSuite:
    {
      data:
      [
        connections:
        [
          springConn: Reference #{test::copperquokka3::data::ApiaryRows}#,
          autumnConn: Reference #{test::copperquokka3::data::ApiaryRows}#
        ]
      ]
      tests:
      [
        duplicatePairsCollapse:
        {
          keys: ['spring', 'autumn'];
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            since = %2026-04-12
          ]
          asserts:
          [
            expectedRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Lineage":"Buckfast","Region":"NORTH"},{"Lineage":"Carniolan","Region":"NORTH"},{"Lineage":"Carniolan","Region":"WEST"}]';
                  }#;
              }#
          ]
        },
        lateWindowLeavesOnePair:
        {
          keys: ['spring', 'autumn'];
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            since = %2026-05-02
          ]
          asserts:
          [
            expectedRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Lineage":"Carniolan","Region":"NORTH"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service test::copperquokka3::service::BusiestRecentYard
{
  pattern: '/copperquokka3/yards/busiest';
  title: 'Copper Quokka 3 - BusiestRecentYard';
  documentation: 'Ranks inspection dates per yard with a dense rank, keeps the two latest dates, keeps inspectors whose name contains e, counts them per yard and returns the busiest yard.';
  autoActivateUpdates: false;
  ownership: UserList { users: ['apiary-yard-desk', 'hive-health-leads'] };
  execution: Single
  {
    query: {minFrames: Integer[1]|test::copperquokka3::domain::Inspection.all()->filter(
      i|$i.framesBrood >= $minFrames
    )->project(
      [
        i|$i.hive.yard.yardName,
        i|$i.inspectedOn,
        i|$i.inspectorName
      ],
      ['Yard', 'InspectedOn', 'Inspector']
    )->olapGroupBy(
      ['Yard'],
      desc('InspectedOn'),
      w|$w->denseRank(),
      'DateRank'
    )->filter(
      r|$r.getInteger('DateRank') <= 2
    )->filter(
      r|$r.getString('Inspector')->contains('e')
    )->groupBy(
      ['Yard'],
      [agg('Inspectors', r|$r.getString('Inspector'), y|$y->distinct()->count())]
    )->sort([desc('Inspectors'), asc('Yard')])->take(1)};
    mapping: test::copperquokka3::mapping::ApiaryMapping;
    runtime: test::copperquokka3::runtime::SpringApiaryRuntime;
  }
  testSuites:
  [
    busiestRecentYardSuite:
    {
      data:
      [
        connections:
        [
          springConn: Reference #{test::copperquokka3::data::ApiaryRows}#
        ]
      ]
      tests:
      [
        tiedCountsResolveByYardName:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            minFrames = 4
          ]
          asserts:
          [
            expectedRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Yard":"Clover Yard","Inspectors":2}]';
                  }#;
              }#
          ]
        },
        heavyBroodOnly:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            minFrames = 8
          ]
          asserts:
          [
            expectedRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Yard":"Heath Yard","Inspectors":2}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service test::copperquokka3::service::HiveLookup
{
  pattern: '/copperquokka3/hives/lookup';
  title: 'Copper Quokka 3 - HiveLookup';
  documentation: 'Hives whose id is in the requested list, excluding cedar boxes, with their yard and queen lineage.';
  autoActivateUpdates: false;
  ownership: DID { identifier: '000000' };
  execution: Single
  {
    query: {hiveIds: Integer[*]|test::copperquokka3::domain::Hive.all()->filter(
      h|$hiveIds->contains($h.hiveId) && !$h.hiveName->contains('Cedar')
    )->project(
      [
        h|$h.hiveName,
        h|$h.yard.yardName,
        h|$h.queen.lineage
      ],
      ['Hive', 'Yard', 'Lineage']
    )->sort([asc('Hive')])};
    mapping: test::copperquokka3::mapping::ApiaryMapping;
    runtime: test::copperquokka3::runtime::SpringApiaryRuntime;
  }
  testSuites:
  [
    hiveLookupSuite:
    {
      data:
      [
        connections:
        [
          springConn: Reference #{test::copperquokka3::data::ApiaryRows}#
        ]
      ]
      tests:
      [
        requestedHivesWithMissingYard:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            hiveIds = [10, 12, 14]
          ]
          asserts:
          [
            expectedRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Hive":"Amber Box","Yard":"Clover Yard","Lineage":"Carniolan"},{"Hive":"Ash Box","Yard":null,"Lineage":"Buckfast"},{"Hive":"Birch Box","Yard":"Heath Yard","Lineage":"Carniolan"}]';
                  }#;
              }#
          ]
        },
        cedarBoxExcluded:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            hiveIds = [13]
          ]
          asserts:
          [
            expectedRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
