###Relational
Database test::copperquokka3::store::ApiaryDb
(
  Schema apiary
  (
    Table yard
    (
      yard_code VARCHAR(8) PRIMARY KEY,
      yard_name VARCHAR(40) NOT NULL,
      region_code VARCHAR(8) NOT NULL
    )
    Table queen
    (
      queen_id INTEGER PRIMARY KEY,
      lineage VARCHAR(20) NOT NULL,
      marked_on DATE NOT NULL
    )
    Table hive
    (
      hive_id INTEGER PRIMARY KEY,
      hive_name VARCHAR(40) NOT NULL,
      yard_code VARCHAR(8) NOT NULL,
      queen_id INTEGER
    )
    Table inspection
    (
      inspection_id INTEGER PRIMARY KEY,
      hive_id INTEGER NOT NULL,
      inspected_on DATE NOT NULL,
      frames_brood INTEGER NOT NULL,
      honey_kg DOUBLE,
      mite_delta INTEGER NOT NULL,
      inspector_name VARCHAR(40) NOT NULL
    )
  )

  Join Inspection_Hive(apiary.inspection.hive_id = apiary.hive.hive_id)
  Join Hive_Yard(apiary.hive.yard_code = apiary.yard.yard_code)
  Join Hive_Queen(apiary.hive.queen_id = apiary.queen.queen_id)
)
