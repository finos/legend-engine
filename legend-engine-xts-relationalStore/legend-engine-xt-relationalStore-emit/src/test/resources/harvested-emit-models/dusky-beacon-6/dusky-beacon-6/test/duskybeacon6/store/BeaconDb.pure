###Relational
Database test::duskybeacon6::store::BeaconDb
(
  Schema beacon
  (
    Table lamp_watch
    (
      watch_id INTEGER PRIMARY KEY,
      watch_code VARCHAR(24) NOT NULL,
      lamp_code VARCHAR(24) NOT NULL,
      keeper_name VARCHAR(80) NOT NULL,
      watch_state VARCHAR(24) NOT NULL,
      burn_hours INTEGER,
      sighted_km DOUBLE,
      logged_on DATE NOT NULL
    )
  )
)
