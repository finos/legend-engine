###Connection
RelationalDatabaseConnection test::duskybeacon6::connection::BeaconCoastConnection
{
  store: test::duskybeacon6::store::BeaconDb;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists beacon cascade;',
      'create schema beacon;',
      'create table beacon.lamp_watch(watch_id integer primary key, watch_code varchar(24) not null, lamp_code varchar(24) not null, keeper_name varchar(80) not null, watch_state varchar(24) not null, burn_hours integer, sighted_km double, logged_on date not null);'
      ];
  };
  auth: DefaultH2;
}

