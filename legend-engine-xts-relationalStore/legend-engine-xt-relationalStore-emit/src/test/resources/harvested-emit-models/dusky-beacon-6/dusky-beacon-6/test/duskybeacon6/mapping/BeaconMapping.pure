###Mapping
Mapping test::duskybeacon6::mapping::BeaconMapping
(
  *test::duskybeacon6::domain::LampWatch[lampWatch]: Relational
  {
    ~primaryKey
    (
      [test::duskybeacon6::store::BeaconDb]beacon.lamp_watch.watch_id
    )
    ~mainTable [test::duskybeacon6::store::BeaconDb]beacon.lamp_watch
    watchCode: [test::duskybeacon6::store::BeaconDb]beacon.lamp_watch.watch_code,
    lampCode: [test::duskybeacon6::store::BeaconDb]beacon.lamp_watch.lamp_code,
    keeperName: [test::duskybeacon6::store::BeaconDb]beacon.lamp_watch.keeper_name,
    watchState: [test::duskybeacon6::store::BeaconDb]beacon.lamp_watch.watch_state,
    burnHours: coalesce([test::duskybeacon6::store::BeaconDb]beacon.lamp_watch.burn_hours, 0),
    sightedKm: coalesce([test::duskybeacon6::store::BeaconDb]beacon.lamp_watch.sighted_km, 0),
    loggedOn: [test::duskybeacon6::store::BeaconDb]beacon.lamp_watch.logged_on
  }
)
