###Connection
RelationalDatabaseConnection test::fabledcavern3::connection::CavernGuidingConnection
{
  store: test::fabledcavern3::store::CavernDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists karst;',
      'create schema karst;',
      'create table karst.passage (passage_id integer primary key, passage_code varchar(16) not null, passage_name varchar(64) not null, surveyed_length_m double not null, walking_grade varchar(16) not null);'
      ];
  };
  auth: DefaultH2;
}

