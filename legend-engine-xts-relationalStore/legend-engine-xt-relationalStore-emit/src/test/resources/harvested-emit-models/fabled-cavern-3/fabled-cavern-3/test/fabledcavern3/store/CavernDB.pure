###Relational
Database test::fabledcavern3::store::CavernDB
(
  Schema karst
  (
    Table passage
    (
      passage_id INTEGER PRIMARY KEY,
      passage_code VARCHAR(16) NOT NULL,
      passage_name VARCHAR(64) NOT NULL,
      surveyed_length_m DOUBLE NOT NULL,
      walking_grade VARCHAR(16) NOT NULL
    )
  )
)
