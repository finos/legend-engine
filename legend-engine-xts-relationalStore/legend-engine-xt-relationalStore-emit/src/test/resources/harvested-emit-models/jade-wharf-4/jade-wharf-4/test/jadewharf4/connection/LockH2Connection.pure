###Connection
RelationalDatabaseConnection test::jadewharf4::connection::LockRegisterConnection
{
  store: test::jadewharf4::store::CanalLockDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists waterway;',
      'create schema waterway;',
      'create table waterway.canal_lock (lock_code varchar(16) primary key, canal_code varchar(16) not null, lock_name varchar(80) not null, rise_cm integer not null, chamber_count integer not null, gate_kind varchar(24) not null, keeper_name varchar(80));'
      ];
  };
  auth: DefaultH2;
}
