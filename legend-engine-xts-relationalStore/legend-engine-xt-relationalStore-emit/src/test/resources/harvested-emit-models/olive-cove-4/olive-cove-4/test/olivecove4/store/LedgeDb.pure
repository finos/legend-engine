###Relational
Database test::olivecove4::store::LedgeDb
(
  Schema census
  (
    Table ledge_count
    (
      count_code VARCHAR(24) PRIMARY KEY,
      ledge_code VARCHAR(24) NOT NULL,
      species_code VARCHAR(16) NOT NULL,
      adult_count INTEGER NOT NULL,
      chick_count INTEGER,
      season_key VARCHAR(4) NOT NULL,
      counted_on DATE NOT NULL,
      observer_ref VARCHAR(24) NOT NULL
    )

    Table cliff_ledge
    (
      ledge_code VARCHAR(24) PRIMARY KEY,
      ledge_name VARCHAR(120) NOT NULL,
      cove_name VARCHAR(120) NOT NULL,
      aspect VARCHAR(16)
    )

    Table observer_team
    (
      observer_ref VARCHAR(24) PRIMARY KEY,
      team_name VARCHAR(120) NOT NULL
    )

    View ledge_tally_view
    (
      ~groupBy
      (
        census.ledge_count.ledge_code
      )
      ledge_code: census.ledge_count.ledge_code PRIMARY KEY,
      visit_count: count(census.ledge_count.count_code),
      total_adults: sum(census.ledge_count.adult_count)
    )
  )

  Filter RecentSeasonFilter(census.ledge_count.season_key > '2023')

  Join Count_Ledge(census.ledge_count.ledge_code = census.cliff_ledge.ledge_code)
  Join Count_Team(census.ledge_count.observer_ref = census.observer_team.observer_ref)
  Join Ledge_Tally(census.cliff_ledge.ledge_code = census.ledge_tally_view.ledge_code)
)
