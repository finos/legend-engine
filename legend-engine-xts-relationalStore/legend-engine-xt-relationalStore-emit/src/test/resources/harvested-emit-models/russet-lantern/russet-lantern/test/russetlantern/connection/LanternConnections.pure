###Connection
RelationalDatabaseConnection test::russetlantern::connection::InnerWardConnection
{
  store: test::russetlantern::store::LanternDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists lighting;',
      'create schema lighting;',
      'create table lighting.lantern_state (lantern_id integer primary key, lantern_code varchar(20) not null, ward_code varchar(20) not null, lamp_type varchar(20) not null, mantle_height_cm integer not null, from_z date not null, thru_z date not null);'
      ];
  };
  auth: DefaultH2;
}

RelationalDatabaseConnection test::russetlantern::connection::OuterWardConnection
{
  store: test::russetlantern::store::LanternDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists lighting;',
      'create schema lighting;',
      'create table lighting.lantern_state (lantern_id integer primary key, lantern_code varchar(20) not null, ward_code varchar(20) not null, lamp_type varchar(20) not null, mantle_height_cm integer not null, from_z date not null, thru_z date not null);'
      ];
  };
  auth: DefaultH2;
}
