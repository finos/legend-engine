###Mapping
Mapping test::russetlantern::mapping::LanternMapping
(
  *test::russetlantern::domain::LanternState[lanternState]: Relational
  {
    ~primaryKey
    (
      [test::russetlantern::store::LanternDB]lighting.lantern_state.lantern_id
    )
    ~mainTable [test::russetlantern::store::LanternDB]lighting.lantern_state
    lanternCode: [test::russetlantern::store::LanternDB]lighting.lantern_state.lantern_code,
    wardCode: [test::russetlantern::store::LanternDB]lighting.lantern_state.ward_code,
    lampType: [test::russetlantern::store::LanternDB]lighting.lantern_state.lamp_type,
    mantleHeightCm: [test::russetlantern::store::LanternDB]lighting.lantern_state.mantle_height_cm
  }
)
