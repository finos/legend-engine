###Pure
import test::duskylighthouse2::domain::*;

Profile test::duskylighthouse2::domain::WatchProfile
{
  stereotypes: [published, rostered];
  tags: [watchDesk, cadence];
}

Enum test::duskylighthouse2::domain::SeeingGrade
{
  STEADY,
  SHIMMERING,
  TURBULENT
}

Class <<temporal.businesstemporal, WatchProfile.published>> {WatchProfile.watchDesk = 'night-watch-desk'} test::duskylighthouse2::domain::ObservingRegion
{
  regionCode: String[1];
  regionName: String[1];
}

Class <<temporal.businesstemporal, WatchProfile.rostered>> {WatchProfile.cadence = 'seasonal'} test::duskylighthouse2::domain::ObservingSite
{
  siteCode: String[1];
  siteName: String[1];
  sectorName: String[1];
  region: ObservingRegion[1];
}

Class <<temporal.businesstemporal, WatchProfile.published>> {WatchProfile.cadence = 'nightly'} test::duskylighthouse2::domain::NightWatchLog
{
  logCode: String[1];
  loggedOn: StrictDate[1];
  patrolLevel: Integer[1];
  seeingGrade: SeeingGrade[1];
  catalogVersion: String[1];
  seasonYear: String[1];
  exposureMinutes: Integer[1];
  lampTag: String[1];
  lampTagWidth: Integer[1];
  site: ObservingSite[1];
}
