###Relational
Database test::duskylighthouse2::store::SkyWatchDB
(
  Schema skywatch
  (
    Table observing_region
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      region_code VARCHAR(20) PRIMARY KEY,
      region_name VARCHAR(80) NOT NULL,
      from_z DATE PRIMARY KEY,
      thru_z DATE
    )
    Table observing_site
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      site_code VARCHAR(20) PRIMARY KEY,
      site_name VARCHAR(80) NOT NULL,
      sector_name VARCHAR(40) NOT NULL,
      region_code VARCHAR(20) NOT NULL,
      from_z DATE PRIMARY KEY,
      thru_z DATE
    )
    Table night_watch_log
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      log_code VARCHAR(20) PRIMARY KEY,
      logged_on DATE NOT NULL,
      patrol_level INTEGER NOT NULL,
      seeing_code VARCHAR(4) NOT NULL,
      catalog_version VARCHAR(20) NOT NULL,
      season_year VARCHAR(4) NOT NULL,
      exposure_minutes INTEGER NOT NULL,
      lamp_note VARCHAR(40),
      site_code VARCHAR(20) NOT NULL,
      from_z DATE PRIMARY KEY,
      thru_z DATE
    )
  )

  Join Log_Site(skywatch.night_watch_log.site_code = skywatch.observing_site.site_code)
  Join Site_Region(skywatch.observing_site.region_code = skywatch.observing_region.region_code)
)
