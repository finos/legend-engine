###Relational
Database test::jadecavern3::store::CavernDatabase
(
  Schema KARST
  (
    Table SURVEY_LEG
    (
      milestoning
      (
        business(BUS_FROM = FROM_Z, BUS_THRU = THRU_Z)
      )
      LEG_REF VARCHAR(24) PRIMARY KEY,
      CAVE_CODE VARCHAR(24) NOT NULL,
      GRADE_CODE VARCHAR(8) NOT NULL,
      CREW_CODE VARCHAR(24) NOT NULL,
      LOGGED_METRES DOUBLE NOT NULL,
      SPOIL_METRES DOUBLE NOT NULL,
      PERIOD_START DATE NOT NULL,
      PERIOD_END DATE NOT NULL,
      LOGGED_ON DATE NOT NULL,
      PASSAGE_REF VARCHAR(24),
      FROM_Z DATE PRIMARY KEY,
      THRU_Z DATE
    )
    Table PASSAGE_RECORD
    (
      milestoning
      (
        business(BUS_FROM = FROM_Z, BUS_THRU = THRU_Z)
      )
      PASSAGE_REF VARCHAR(24) PRIMARY KEY,
      CAVE_CODE VARCHAR(24) NOT NULL,
      ROOF_HEIGHT_METRES DOUBLE NOT NULL,
      WIDTH_METRES DOUBLE NOT NULL,
      SPEC_REF VARCHAR(24),
      FROM_Z DATE PRIMARY KEY,
      THRU_Z DATE
    )
    Table PASSAGE_SPEC
    (
      SPEC_REF VARCHAR(24) PRIMARY KEY,
      SPEC_KIND VARCHAR(16) NOT NULL,
      WATER_DEPTH_METRES DOUBLE,
      FLOOR_AREA_SQM DOUBLE
    )
  )

  Join SurveyLeg_PassageRecord(KARST.SURVEY_LEG.PASSAGE_REF = KARST.PASSAGE_RECORD.PASSAGE_REF)
  Join PassageRecord_PassageSpec(KARST.PASSAGE_RECORD.SPEC_REF = KARST.PASSAGE_SPEC.SPEC_REF)
)
