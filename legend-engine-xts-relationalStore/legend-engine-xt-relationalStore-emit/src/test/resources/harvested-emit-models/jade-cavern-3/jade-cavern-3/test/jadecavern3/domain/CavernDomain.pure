###Pure
import test::jadecavern3::domain::*;

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'A surveyed leg of a karst cave system, valid over a business-effective window.'} test::jadecavern3::domain::SurveyLeg
{
  legRef: String[1];
  caveCode: String[1];
  gradeCode: String[1];
  crewCode: String[1];
  loggedMetres: Float[1];
  spoilMetres: Float[1];
  periodStart: StrictDate[1];
  periodEnd: StrictDate[1];
  loggedOn: StrictDate[1];
  passage: PassageRecord[0..1];
  netSpanOn(surveyDate: StrictDate[1])
  {
    $this.passage($surveyDate)->toOne().roofHeightMetres - $this.spoilMetres
  }: Float[1];
}

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'The passage record standing for a survey leg on a given business date.'} test::jadecavern3::domain::PassageRecord
{
  passageRef: String[1];
  caveCode: String[1];
  roofHeightMetres: Float[1];
  widthMetres: Float[1];
  spec: PassageSpec[0..1];
  altSpec: PassageSpec[0..1];
}

Class test::jadecavern3::domain::PassageSpec
{
  specRef: String[1];
}

Class test::jadecavern3::domain::SumpSpec extends PassageSpec
{
  waterDepthMetres: Float[1];
}

Class test::jadecavern3::domain::ChamberSpec extends PassageSpec
{
  floorAreaSquareMetres: Float[1];
}
