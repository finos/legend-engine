###Runtime
Runtime test::westerntundra::runtime::TundraSurveyRuntime
{
  mappings:
  [
    test::westerntundra::mapping::TundraSurveyMapping
  ];
  connections:
  [
    test::westerntundra::store::TundraSurveyDB:
    [
      surveyConnection: test::westerntundra::connection::TundraSurveyConnection
    ]
  ];
}

Runtime test::westerntundra::runtime::TundraArchiveRuntime
{
  mappings:
  [
    test::westerntundra::mapping::TundraArchiveMapping
  ];
  connections:
  [
    test::westerntundra::store::TundraArchiveDB:
    [
      archiveConnection: test::westerntundra::connection::TundraArchiveConnection
    ]
  ];
}
