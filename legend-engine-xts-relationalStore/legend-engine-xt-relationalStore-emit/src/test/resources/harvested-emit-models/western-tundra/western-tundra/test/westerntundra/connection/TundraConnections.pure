###Connection
RelationalDatabaseConnection test::westerntundra::connection::TundraSurveyConnection
{
  store: test::westerntundra::store::TundraSurveyDB;
  type: MemSQL;
  quoteIdentifiers: false;
  specification: Static
  {
    name: 'tundra_survey_current';
    host: 'example-tundra-survey-host';
    port: 3306;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'tundrasurveyprincipal';
  };
}

RelationalDatabaseConnection test::westerntundra::connection::TundraArchiveConnection
{
  store: test::westerntundra::store::TundraArchiveDB;
  type: MemSQL;
  quoteIdentifiers: false;
  specification: Static
  {
    name: 'tundra_survey_archive';
    host: 'example-tundra-archive-host';
    port: 3306;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'tundraarchiveprincipal';
  };
}
