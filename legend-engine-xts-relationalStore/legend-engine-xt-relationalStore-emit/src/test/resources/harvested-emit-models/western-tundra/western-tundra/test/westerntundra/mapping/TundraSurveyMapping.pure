###Mapping
Mapping test::westerntundra::mapping::TundraSurveyMapping
(
  *test::westerntundra::domain::Reserve[reserve]: Relational
  {
    ~primaryKey
    (
      [test::westerntundra::store::TundraSurveyDB]tundra.reserve.reserve_id
    )
    ~mainTable [test::westerntundra::store::TundraSurveyDB]tundra.reserve
    reserveCode: [test::westerntundra::store::TundraSurveyDB]tundra.reserve.reserve_code,
    reserveName: [test::westerntundra::store::TundraSurveyDB]tundra.reserve.reserve_name,
    regionCode: [test::westerntundra::store::TundraSurveyDB]tundra.reserve.region_code,
    rosterRegionCode: [test::westerntundra::store::TundraSurveyDB]@Reserve_ReserveRoster | [test::westerntundra::store::TundraSurveyDB]tundra.reserve_roster_vw.region_code
  }

  *test::westerntundra::domain::Plot[plot]: Relational
  {
    ~primaryKey
    (
      [test::westerntundra::store::TundraSurveyDB]tundra.plot.plot_id
    )
    ~mainTable [test::westerntundra::store::TundraSurveyDB]tundra.plot
    plotCode: [test::westerntundra::store::TundraSurveyDB]tundra.plot.plot_code,
    elevationM: [test::westerntundra::store::TundraSurveyDB]tundra.plot.elevation_m,
    reserveCode: [test::westerntundra::store::TundraSurveyDB]@Plot_Reserve | [test::westerntundra::store::TundraSurveyDB]tundra.reserve.reserve_code
  }

  *test::westerntundra::domain::Quadrat[quadrat]: Relational
  {
    ~primaryKey
    (
      [test::westerntundra::store::TundraSurveyDB]tundra.quadrat.quadrat_id
    )
    ~mainTable [test::westerntundra::store::TundraSurveyDB]tundra.quadrat
    quadratCode: [test::westerntundra::store::TundraSurveyDB]tundra.quadrat.quadrat_code,
    areaM2: [test::westerntundra::store::TundraSurveyDB]tundra.quadrat.area_m2,
    plotCode: [test::westerntundra::store::TundraSurveyDB]@Quadrat_PlotProfile | [test::westerntundra::store::TundraSurveyDB]tundra.plot_profile_vw.plot_code
  }

  *test::westerntundra::domain::Taxon[taxon]: Relational
  {
    ~primaryKey
    (
      [test::westerntundra::store::TundraSurveyDB]tundra.taxon.taxon_id
    )
    ~mainTable [test::westerntundra::store::TundraSurveyDB]tundra.taxon
    taxonCode: [test::westerntundra::store::TundraSurveyDB]tundra.taxon.taxon_code,
    taxonName: [test::westerntundra::store::TundraSurveyDB]tundra.taxon.taxon_name,
    growthForm: [test::westerntundra::store::TundraSurveyDB]tundra.taxon.growth_form,
    profileGrowthForm: [test::westerntundra::store::TundraSurveyDB]@Taxon_TaxonProfile | [test::westerntundra::store::TundraSurveyDB]tundra.taxon_profile_vw.growth_form
  }

  *test::westerntundra::domain::CoverRecord[coverRecord]: Relational
  {
    ~primaryKey
    (
      [test::westerntundra::store::TundraSurveyDB]tundra.cover_record.cover_record_id
    )
    ~mainTable [test::westerntundra::store::TundraSurveyDB]tundra.cover_record
    coverPct: [test::westerntundra::store::TundraSurveyDB]tundra.cover_record.cover_pct,
    recordedOn: [test::westerntundra::store::TundraSurveyDB]tundra.cover_record.recorded_on,
    quadratCode: [test::westerntundra::store::TundraSurveyDB]@CoverRecord_Quadrat | [test::westerntundra::store::TundraSurveyDB]tundra.quadrat.quadrat_code,
    taxonName: [test::westerntundra::store::TundraSurveyDB]@CoverRecord_Taxon | [test::westerntundra::store::TundraSurveyDB]tundra.taxon.taxon_name,
    plotCode: [test::westerntundra::store::TundraSurveyDB]@CoverRecord_Quadrat > @Quadrat_PlotProfile | [test::westerntundra::store::TundraSurveyDB]tundra.plot_profile_vw.plot_code,
    reserveName: [test::westerntundra::store::TundraSurveyDB]@CoverRecord_Quadrat > @Quadrat_Plot > @Plot_Reserve | [test::westerntundra::store::TundraSurveyDB]tundra.reserve.reserve_name
  }

  testSuites:
  [
    coverRecordSuite:
    {
      function: |test::westerntundra::domain::CoverRecord.all()->project([c|$c.quadratCode, c|$c.taxonName, c|$c.plotCode, c|$c.reserveName, c|$c.coverPct], ['Quadrat', 'Taxon', 'Plot', 'Reserve', 'CoverPct']);
      tests:
      [
        multiHopJoinHit:
        {
          doc: 'The reading resolves its plot code through two hops that land on a store view and its reserve name through three chained hops, so a single row materialises the whole quadrat-plot-reserve chain.';
          data:
          [
            test::westerntundra::store::TundraSurveyDB:
              Relational
              #{
                tundra.reserve:
                  'reserve_id,reserve_code,reserve_name,region_code\n'+
                  '1,RSV-ALDER,Alder Fell Reserve,REG-NORTH\n';
                tundra.plot:
                  'plot_id,reserve_id,plot_code,elevation_m\n'+
                  '1,1,PLT-CAIRN,1840\n';
                tundra.quadrat:
                  'quadrat_id,plot_id,quadrat_code,area_m2\n'+
                  '1,1,QDT-CAIRN-A,1\n';
                tundra.taxon:
                  'taxon_id,taxon_code,taxon_name,growth_form\n'+
                  '1,TAX-MOSS,Woolly Fringe Moss,CUSHION\n';
                tundra.cover_record:
                  'cover_record_id,quadrat_id,taxon_id,cover_pct,recorded_on\n'+
                  '1,1,1,42,2026-07-14\n';
              }#
          ];
          asserts:
          [
            chainedHierarchyResolves:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Quadrat":"QDT-CAIRN-A","Taxon":"Woolly Fringe Moss","Plot":"PLT-CAIRN","Reserve":"Alder Fell Reserve","CoverPct":42}]';
                  }#;
              }#
          ];
        }
      ];
    },
    reserveSuite:
    {
      function: |test::westerntundra::domain::Reserve.all()->project([r|$r.reserveCode, r|$r.reserveName, r|$r.regionCode, r|$r.rosterRegionCode], ['ReserveCode', 'ReserveName', 'RegionCode', 'RosterRegionCode']);
      tests:
      [
        rosterViewHit:
        {
          doc: 'The roster region code is read through a join onto the reserve roster view, so it agrees with the region code held on the base table.';
          data:
          [
            test::westerntundra::store::TundraSurveyDB:
              Relational
              #{
                tundra.reserve:
                  'reserve_id,reserve_code,reserve_name,region_code\n'+
                  '1,RSV-BIRCH,Birch Saddle Reserve,REG-SOUTH\n';
              }#
          ];
          asserts:
          [
            viewAgreesWithBaseTable:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"ReserveCode":"RSV-BIRCH","ReserveName":"Birch Saddle Reserve","RegionCode":"REG-SOUTH","RosterRegionCode":"REG-SOUTH"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
