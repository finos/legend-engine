###Relational
Database test::westerntundra::store::TundraArchiveDB
(
  Schema archive
  (
    Table archived_plot
    (
      plot_id INTEGER PRIMARY KEY,
      plot_code VARCHAR(24) NOT NULL,
      reserve_code VARCHAR(24) NOT NULL
    )
    Table archived_cover_record
    (
      cover_record_id INTEGER PRIMARY KEY,
      plot_id INTEGER NOT NULL,
      cover_pct INTEGER NOT NULL,
      season_code VARCHAR(24) NOT NULL
    )

    View plot_digest_vw
    (
      plot_id: archive.archived_plot.plot_id PRIMARY KEY,
      plot_code: archive.archived_plot.plot_code,
      reserve_code: archive.archived_plot.reserve_code
    )
  )

  Join ArchivedCoverRecord_ArchivedPlot(archive.archived_cover_record.plot_id = archive.archived_plot.plot_id)
  Join ArchivedPlot_PlotDigest(archive.archived_plot.plot_id = archive.plot_digest_vw.plot_id)
)
