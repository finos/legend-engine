{
  tankCode: String[1];
  hallCode: String[1];
  hallName: String[1];
  waterLitres: Integer[1];
  tankGrade: String[1];
  inspectedOn: StrictDate[1];
}

Class {meta::pure::profiles::doc.doc = 'One lantern fitting installed above an aquarium hall, held without milestoning because the lighting inventory is restated in place rather than versioned.'} test::corallantern3::domain::LanternFitting
{
  fittingCode: String[1];
  hallCode: String[1];
  lumens: Integer[1];
  fittingType: String[1];
  installedOn: StrictDate[1];
}
