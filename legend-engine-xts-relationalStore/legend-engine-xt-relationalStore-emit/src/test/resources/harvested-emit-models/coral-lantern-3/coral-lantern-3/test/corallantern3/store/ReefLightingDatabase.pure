###Relational
Database test::corallantern3::store::ReefLightingDatabase
(
  Schema reefhall
  (
    Table reef_tank
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )

      tank_id INTEGER PRIMARY KEY,
      tank_code VARCHAR(16),
      hall_code VARCHAR(16),
      hall_name VARCHAR(96),
      water_litres INTEGER,
      tank_grade VARCHAR(16),
      inspected_on DATE,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
    Table lantern_fitting
    (
      fitting_id INTEGER PRIMARY KEY,
      fitting_code VARCHAR(16),
      hall_code VARCHAR(16),
      lumens INTEGER,
      fitting_type VARCHAR(16),
      installed_on DATE
    )
  )
)
