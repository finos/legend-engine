###Pure
import test::solarridge::domain::*;

Class {meta::pure::profiles::doc.doc = 'A cultivation zone of a community allotment site, optionally nested inside a wider zone.'} test::solarridge::domain::GardenZone
{
  zoneCode: String[1];
  zoneName: String[1];
  parentZone: GardenZone[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A single rented growing plot, always sited within one cultivation zone.'} test::solarridge::domain::AllotmentPlot
{
  plotCode: String[1];
  plotName: String[1];
  zone: GardenZone[1];
}

Class {meta::pure::profiles::doc.doc = 'A plot-warden visit recorded against one harvest entry.'} test::solarridge::domain::PlotInspection
{
  inspectionCode: String[1];
  inspectedOn: StrictDate[1];
}

Class {meta::pure::profiles::doc.doc = 'A weighed crop lift taken from a plot on a given day, with the warden visits that checked it.'} test::solarridge::domain::HarvestEntry
{
  entryCode: String[1];
  cropName: String[1];
  harvestedOn: StrictDate[1];
  weightKg: Integer[1];
  plot: AllotmentPlot[1];
  inspections: PlotInspection[*];
}
