import test::emeraldthistle3::domain::*;

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'A volunteer who looks after a nature reserve; held as a to-many ancestor collection at the far end of the grouping hierarchy.'} test::emeraldthistle3::domain::ReserveSteward
{
  stewardCode: String[1];
  stewardName: String[1];
  rotaLabel: String[1];
}

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'The reserve a garden section draws its plantings from; its steward collection is the to-many end of the five-hop traversal.'} test::emeraldthistle3::domain::NatureReserve
{
  reserveCode: String[1];
  reserveLabel: String[1];
  stewards: ReserveSteward[*];
}

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'A named section of the garden that groups plots and points at the reserve it was seeded from.'} test::emeraldthistle3::domain::GardenSection
{
  sectionCode: String[1];
  sectionLabel: String[1];
  reserve: NatureReserve[0..1];
}

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'A plot inside a garden section; the intermediate hop that is deliberately absent for one bed so a traversal miss can be observed.'} test::emeraldthistle3::domain::GardenPlot
{
  plotCode: String[1];
  plotLabel: String[1];
  section: GardenSection[0..1];
}

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'The growing bed a specimen sits in; the first hop of the grouping hierarchy the wide projection descends.'} test::emeraldthistle3::domain::GrowingBed
{
  bedCode: String[1];
  bedLabel: String[1];
  plot: GardenPlot[0..1];
}

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'The gathering record a specimen was accessioned under, reached as a one-hop traversal at the requested instant.'} test::emeraldthistle3::domain::AccessionRecord
{
  accessionCode: String[1];
  sourceLabel: String[1];
  gatherRegion: String[1];
}

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'A herbarium specimen read at one business instant; the driving extent of a wide fixed-arity projection that descends a five-level grouping hierarchy and derives a tag prefix by conditional string manipulation.'} test::emeraldthistle3::domain::Specimen
{
  specimenCode: String[1];
  tagCode: String[0..1];
  speciesLabel: String[1];
  habitLabel: String[1];
  collectCode: String[1];
  formLabel: String[1];
  statusLabel: String[1];
  noteLabel: String[1];
  accession: AccessionRecord[0..1];
  bed: GrowingBed[0..1];
}
