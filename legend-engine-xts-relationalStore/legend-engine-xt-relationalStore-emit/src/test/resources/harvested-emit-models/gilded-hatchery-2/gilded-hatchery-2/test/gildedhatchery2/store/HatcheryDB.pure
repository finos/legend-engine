###Relational
Database test::gildedhatchery2::store::HatcheryDB
(
  Schema rearing
  (
    Table spawn_lot
    (
      lot_id INTEGER PRIMARY KEY,
      lot_code VARCHAR(20) NOT NULL,
      lot_name VARCHAR(120) NOT NULL,
      tank_code VARCHAR(20) NOT NULL,
      keeper_code VARCHAR(20) NOT NULL,
      fry_count INTEGER NOT NULL,
      mean_weight_grams DOUBLE NOT NULL,
      logged_at TIMESTAMP NOT NULL
    )
    Table rearing_tank
    (
      tank_id INTEGER PRIMARY KEY,
      tank_code VARCHAR(20) NOT NULL,
      tank_label VARCHAR(120) NOT NULL,
      bay_code VARCHAR(20) NOT NULL
    )
    Table hatch_bay
    (
      bay_id INTEGER PRIMARY KEY,
      bay_code VARCHAR(20) NOT NULL,
      bay_name VARCHAR(120) NOT NULL
    )
  )

  Schema facility
  (
    Table tank_keeper
    (
      keeper_id INTEGER PRIMARY KEY,
      keeper_code VARCHAR(20) NOT NULL,
      keeper_name VARCHAR(120) NOT NULL,
      station_code VARCHAR(20) NOT NULL
    )
    Table keeper_station
    (
      station_id INTEGER PRIMARY KEY,
      station_code VARCHAR(20) NOT NULL,
      station_name VARCHAR(120) NOT NULL,
      zone_code VARCHAR(20) NOT NULL
    )
    Table station_zone
    (
      zone_id INTEGER PRIMARY KEY,
      zone_code VARCHAR(20) NOT NULL,
      zone_name VARCHAR(120) NOT NULL
    )
  )

  Join Lot_Tank(rearing.spawn_lot.tank_code = rearing.rearing_tank.tank_code)
  Join Tank_Bay(rearing.rearing_tank.bay_code = rearing.hatch_bay.bay_code)
  Join Lot_Keeper(toUpper(trim(rearing.spawn_lot.keeper_code)) = facility.tank_keeper.keeper_code)
  Join Keeper_Station(facility.tank_keeper.station_code = facility.keeper_station.station_code)
  Join Station_Zone(facility.keeper_station.zone_code = facility.station_zone.zone_code)
)
