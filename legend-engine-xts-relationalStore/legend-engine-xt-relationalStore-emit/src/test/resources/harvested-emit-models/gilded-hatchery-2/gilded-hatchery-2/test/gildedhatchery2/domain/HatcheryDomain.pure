###Pure
import test::gildedhatchery2::domain::*;

Class {meta::pure::profiles::doc.doc = 'A batch of fry reared in one hatchery tank over a single rearing window.'} test::gildedhatchery2::domain::SpawnLot
{
  lotCode: String[1];
  lotName: String[1];
  fryCount: Integer[1];
  meanWeightGrams: Float[1];
  loggedAt: DateTime[1];
  registerLabel: String[1];
  tankLabel: String[1];
  bayName: String[1];
  zoneName: String[1];
  postedKeeper: TankKeeper[0..1];
}

Class {meta::pure::profiles::doc.doc = 'The keeper who signs off a rearing tank, held in the facility roster.'} test::gildedhatchery2::domain::TankKeeper
{
  keeperCode: String[1];
  keeperName: String[1];
}
