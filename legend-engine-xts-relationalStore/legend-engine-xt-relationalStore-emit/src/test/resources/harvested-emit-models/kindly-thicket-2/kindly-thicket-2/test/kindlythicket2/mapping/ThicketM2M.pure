###Mapping
Mapping test::kindlythicket2::mapping::ThicketM2M
(
  *test::kindlythicket2::domain::TrailNode[trailNode]: Pure
  {
    ~src test::kindlythicket2::domain::TrailNode
    nodeCode: $src.nodeCode,
    nodeLabel: $src.nodeLabel,
    reserveName: $src.reserveName,
    reserveCode: $src.reserveCode,
    districtName: $src.districtName,
    districtCode: $src.districtCode,
    corridorName: $src.corridorName,
    corridorCode: $src.corridorCode,
    sectorName: $src.sectorName,
    sectorCode: $src.sectorCode,
    segmentName: $src.segmentName,
    segmentCode: $src.segmentCode,
    spurName: $src.spurName,
    spurCode: $src.spurCode,
    stationName: $src.stationName,
    stationCode: $src.stationCode,
    waypointName: $src.waypointName,
    waypointCode: $src.waypointCode
  }

  *test::kindlythicket2::domain::StewardRecord[stewardRecord]: Pure
  {
    ~src test::kindlythicket2::domain::StewardRecord
  }
)
