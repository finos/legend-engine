###Relational
Database test::kindlythicket2::store::ThicketDB
(
  Schema reserve
  (
    Table trail_node
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z, INFINITY_DATE = %9999-12-31)
      )
      node_code VARCHAR(20) PRIMARY KEY,
      node_label VARCHAR(200) NOT NULL,
      reserve_name VARCHAR(200) NOT NULL,
      reserve_code VARCHAR(20) NOT NULL,
      district_name VARCHAR(200) NOT NULL,
      district_code VARCHAR(20) NOT NULL,
      corridor_name VARCHAR(200) NOT NULL,
      corridor_code VARCHAR(20) NOT NULL,
      sector_name VARCHAR(200) NOT NULL,
      sector_code VARCHAR(20) NOT NULL,
      segment_name VARCHAR(200) NOT NULL,
      segment_code VARCHAR(20) NOT NULL,
      spur_name VARCHAR(200),
      spur_code VARCHAR(20),
      station_name VARCHAR(200),
      station_code VARCHAR(20),
      waypoint_name VARCHAR(200),
      waypoint_code VARCHAR(20),
      from_z DATE PRIMARY KEY,
      thru_z DATE
    )
    Table steward_record
    (
      record_code VARCHAR(20) PRIMARY KEY,
      steward_name VARCHAR(200) NOT NULL,
      node_code VARCHAR(20) NOT NULL
    )
  )
)
