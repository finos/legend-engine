###Connection
RelationalDatabaseConnection test::kindlythicket2::connection::ThicketH2Connection
{
  store: test::kindlythicket2::store::ThicketDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists reserve;',
      'create schema reserve;',
      'create table reserve.trail_node (node_code varchar(20) not null, node_label varchar(200) not null, reserve_name varchar(200) not null, reserve_code varchar(20) not null, district_name varchar(200) not null, district_code varchar(20) not null, corridor_name varchar(200) not null, corridor_code varchar(20) not null, sector_name varchar(200) not null, sector_code varchar(20) not null, segment_name varchar(200) not null, segment_code varchar(20) not null, spur_name varchar(200), spur_code varchar(20), station_name varchar(200), station_code varchar(20), waypoint_name varchar(200), waypoint_code varchar(20), from_z date, thru_z date);',
      'create table reserve.steward_record (record_code varchar(20) not null, steward_name varchar(200) not null, node_code varchar(20) not null);'
      ];
  };
  auth: DefaultH2;
}

###Connection
ModelChainConnection test::kindlythicket2::connection::ThicketNodeChainConnection
{
  mappings:
  [
    test::kindlythicket2::mapping::ThicketNodeMapping
  ];
}
