import test::tealfjord3::domain::*;

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'A kelp bed tracked along a fjord shoreline; its canopy extent, survey date and the recorder who walks it are restated over time.'} test::tealfjord3::domain::KelpBed
{
  bedCode: String[1];
  canopyArea: Integer[1];
  lastSurveyOn: StrictDate[1];
  programCode: String[1];
  recorder: SurveyRecorder[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A field recorder who walks a set of kelp beds and may hold a diving permit tag.'} test::tealfjord3::domain::SurveyRecorder
{
  recorderCode: String[1];
  permitTag: String[0..1];
}
