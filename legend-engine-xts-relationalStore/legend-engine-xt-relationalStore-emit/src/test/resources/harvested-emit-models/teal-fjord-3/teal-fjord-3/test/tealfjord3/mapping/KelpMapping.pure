###Mapping
Mapping test::tealfjord3::mapping::KelpMapping
(
  *test::tealfjord3::domain::KelpBed: Relational
  {
    ~primaryKey
    (
      [test::tealfjord3::store::KelpDatabase]kelp.kelp_bed.bed_id
    )
    ~mainTable [test::tealfjord3::store::KelpDatabase]kelp.kelp_bed
    bedCode: [test::tealfjord3::store::KelpDatabase]kelp.kelp_bed.bed_code,
    canopyArea: [test::tealfjord3::store::KelpDatabase]kelp.kelp_bed.canopy_area,
    lastSurveyOn: [test::tealfjord3::store::KelpDatabase]kelp.kelp_bed.last_survey_on,
    programCode: concat('FJORD-KELP-', [test::tealfjord3::store::KelpDatabase]kelp.kelp_bed.bed_code),
    recorder: [test::tealfjord3::store::KelpDatabase]@Bed_Recorder
  }

  *test::tealfjord3::domain::SurveyRecorder: Relational
  {
    ~primaryKey
    (
      [test::tealfjord3::store::KelpDatabase]kelp.survey_recorder.recorder_id
    )
    ~mainTable [test::tealfjord3::store::KelpDatabase]kelp.survey_recorder
    recorderCode: [test::tealfjord3::store::KelpDatabase]kelp.survey_recorder.recorder_code,
    permitTag: [test::tealfjord3::store::KelpDatabase]kelp.survey_recorder.permit_tag
  }
)
