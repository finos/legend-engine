###Relational
Database test::tealfjord3::store::KelpDatabase
(
  Schema kelp
  (
    Table kelp_bed
    (
      milestoning
      (
        business(BUS_FROM=from_z, BUS_THRU=thru_z)
      )
      bed_id INTEGER PRIMARY KEY,
      bed_code VARCHAR(20) NOT NULL,
      canopy_area INTEGER NOT NULL,
      last_survey_on DATE NOT NULL,
      recorder_id INTEGER,
      from_z DATE PRIMARY KEY,
      thru_z DATE
    )
    Table survey_recorder
    (
      recorder_id INTEGER PRIMARY KEY,
      recorder_code VARCHAR(20) NOT NULL,
      permit_tag VARCHAR(20)
    )
  )

  Join Bed_Recorder(kelp.kelp_bed.recorder_id = kelp.survey_recorder.recorder_id)
)
