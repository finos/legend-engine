###Connection
RelationalDatabaseConnection test::tealfjord3::connection::KelpH2Connection
{
  store: test::tealfjord3::store::KelpDatabase;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists kelp;',
      'create schema kelp;',
      'create table kelp.kelp_bed (bed_id integer not null, bed_code varchar(20) not null, canopy_area integer not null, last_survey_on date not null, recorder_id integer, from_z date, thru_z date);',
      'create table kelp.survey_recorder (recorder_id integer primary key, recorder_code varchar(20) not null, permit_tag varchar(20));'
      ];
  };
  auth: DefaultH2;
}
