###Connection
RelationalDatabaseConnection test::indigocanyon::connection::SkyWatchH2Connection
{
  store: test::indigocanyon::store::SkyWatchDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists skywatch;',
      'create schema skywatch;',
      'create table skywatch.sighting_log (record_code varchar(24) primary key, observatory_code varchar(24) not null, constellation varchar(48) not null, logged_at timestamp not null, meteor_count integer not null, sky_quality varchar(24));'
      ];
  };
  auth: DefaultH2;
}
