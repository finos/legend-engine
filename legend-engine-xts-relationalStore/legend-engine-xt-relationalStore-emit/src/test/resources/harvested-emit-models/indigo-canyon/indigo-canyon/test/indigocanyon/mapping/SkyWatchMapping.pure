###Mapping
Mapping test::indigocanyon::mapping::SkyWatchMapping
(
  *test::indigocanyon::domain::SkyWatchEntry[entry]: Relational
  {
    ~primaryKey
    (
      [test::indigocanyon::store::SkyWatchDB]skywatch.sighting_log.record_code
    )
    ~mainTable [test::indigocanyon::store::SkyWatchDB]skywatch.sighting_log
    entryCode: toUpper([test::indigocanyon::store::SkyWatchDB]skywatch.sighting_log.record_code),
    observatoryCode: [test::indigocanyon::store::SkyWatchDB]skywatch.sighting_log.observatory_code,
    constellation: toUpper([test::indigocanyon::store::SkyWatchDB]skywatch.sighting_log.constellation),
    loggedAt: [test::indigocanyon::store::SkyWatchDB]skywatch.sighting_log.logged_at,
    meteorCount: [test::indigocanyon::store::SkyWatchDB]skywatch.sighting_log.meteor_count,
    programmeCode: 'CANYON-METEOR-WATCH',
    qualityNote: case(
                   isNull([test::indigocanyon::store::SkyWatchDB]skywatch.sighting_log.sky_quality),
                   'UNRATED',
                   toUpper([test::indigocanyon::store::SkyWatchDB]skywatch.sighting_log.sky_quality)
                 )
  }
)
