###Relational
Database test::indigocanyon::store::SkyWatchDB
(
  Schema skywatch
  (
    Table sighting_log
    (
      record_code VARCHAR(24) PRIMARY KEY,
      observatory_code VARCHAR(24) NOT NULL,
      constellation VARCHAR(48) NOT NULL,
      logged_at TIMESTAMP NOT NULL,
      meteor_count INTEGER NOT NULL,
      sky_quality VARCHAR(24)
    )
  )
)
