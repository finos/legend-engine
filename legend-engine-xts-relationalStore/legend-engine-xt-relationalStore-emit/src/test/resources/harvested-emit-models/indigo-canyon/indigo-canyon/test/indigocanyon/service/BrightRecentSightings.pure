###Service
Service test::indigocanyon::service::BrightRecentSightings
{
  pattern: '/indigocanyon/skywatch/recent-bright';
  title: 'Recent Bright Sky-Watch Sightings';
  owners:
  [
    'canyon-observatory'
  ];
  documentation: 'Publishes the same sliding recent-activity window of curated sky-watch entries, keeping the projected rows that either belong to the featured constellation or reported a high meteor count.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {currentDateTime: DateTime[1]|test::indigocanyon::domain::SkyWatchEntry.all()->filter(
      e|($e.loggedAt >= $currentDateTime->adjust(-50, DurationUnit.YEARS)) && ($e.loggedAt < $currentDateTime->adjust(50, DurationUnit.YEARS))
    )->project(
      [
        e|$e.entryCode,
        e|$e.observatoryCode,
        e|$e.constellation,
        e|$e.meteorCount,
        e|$e.programmeCode,
        e|$e.qualityNote
      ],
      [
        'EntryCode',
        'Observatory',
        'Constellation',
        'MeteorCount',
        'Programme',
        'QualityNote'
      ]
    )->filter(
      r|($r.getString('Constellation') == 'PERSEUS') || ($r.getInteger('MeteorCount') >= 40)
    )->sort([asc('EntryCode')])};
    mapping: test::indigocanyon::mapping::SkyWatchMapping;
    runtime: test::indigocanyon::runtime::SkyWatchRuntime;
  }
  testSuites:
  [
    brightRecentSightingsSuite:
    {
      data:
      [
        connections:
        [
          skyWatchH2Connection:
            Relational
            #{
              skywatch.sighting_log:
                'record_code,observatory_code,constellation,logged_at,meteor_count,sky_quality\n'+
                'sw-01,OBS-RIM,perseus,2024-08-12 22:40:00,12,clear\n'+
                'sw-02,OBS-RIM,lyra,2024-08-13 01:05:00,55,\n'+
                'sw-05,OBS-RIM,cygnus,2024-08-13 02:20:00,8,misty\n'+
                'sw-03,OBS-FLOOR,perseus,1900-01-04 23:10:00,31,hazy\n';
            }#
        ]
      ]
      tests:
      [
        eitherArmOfDisjunction:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            currentDateTime = %2026-08-01T00:00:00
          ]
          asserts:
          [
            featuredOrBright:
              EqualToJson
              #{
                expected: ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"EntryCode":"SW-01","Observatory":"OBS-RIM","Constellation":"PERSEUS","MeteorCount":12,"Programme":"CANYON-METEOR-WATCH","QualityNote":"CLEAR"},{"EntryCode":"SW-02","Observatory":"OBS-RIM","Constellation":"LYRA","MeteorCount":55,"Programme":"CANYON-METEOR-WATCH","QualityNote":"UNRATED"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
