###Relational
Database test::gildedarboretum::store::NurseryDatabase
(
  Schema nursery
  (
    Table propagation_batch
    (
      batch_id INTEGER PRIMARY KEY,
      batch_code VARCHAR(24) NOT NULL,
      cultivar_code VARCHAR(24) NOT NULL,
      medium_code VARCHAR(16) NOT NULL,
      viability_pct FLOAT,
      sown_count INTEGER
    )

    Table nursery_bed
    (
      bed_code VARCHAR(16) PRIMARY KEY,
      bed_name VARCHAR(96) NOT NULL,
      shade_fraction FLOAT
    )
  )
)
