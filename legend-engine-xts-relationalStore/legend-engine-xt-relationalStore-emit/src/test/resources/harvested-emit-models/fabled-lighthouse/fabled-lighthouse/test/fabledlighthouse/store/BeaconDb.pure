###Relational
Database demo::fabledlighthouse::store::BeaconDb
(
  Schema signal
  (
    Table station
    (
      code VARCHAR(20) PRIMARY KEY,
      name VARCHAR(200) NOT NULL,
      region VARCHAR(80) NOT NULL,
      commissioned_date DATE NOT NULL,
      focal_height_m INTEGER NOT NULL
    )
    Table beam_log
    (
      log_id VARCHAR(20) PRIMARY KEY,
      station_code VARCHAR(20) NOT NULL,
      region VARCHAR(80) NOT NULL,
      log_date DATE NOT NULL,
      visibility_dm INTEGER NOT NULL,
      active_hours INTEGER NOT NULL,
      rotations INTEGER NOT NULL
    )
  )

  Join Station_BeamLog(signal.beam_log.station_code = signal.station.code)
)
