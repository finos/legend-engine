###Mapping
Mapping demo::fabledlighthouse::mapping::BeaconMapping
(
  *demo::fabledlighthouse::domain::Station[station]: Relational
  {
    ~primaryKey
    (
      [demo::fabledlighthouse::store::BeaconDb]signal.station.code
    )
    ~mainTable [demo::fabledlighthouse::store::BeaconDb]signal.station
    code: [demo::fabledlighthouse::store::BeaconDb]signal.station.code,
    name: [demo::fabledlighthouse::store::BeaconDb]signal.station.name,
    region: [demo::fabledlighthouse::store::BeaconDb]signal.station.region,
    commissionedDate: [demo::fabledlighthouse::store::BeaconDb]signal.station.commissioned_date,
    focalHeightM: [demo::fabledlighthouse::store::BeaconDb]signal.station.focal_height_m
  }
  *demo::fabledlighthouse::domain::BeamLog[beamLog]: Relational
  {
    ~primaryKey
    (
      [demo::fabledlighthouse::store::BeaconDb]signal.beam_log.log_id
    )
    ~mainTable [demo::fabledlighthouse::store::BeaconDb]signal.beam_log
    logId: [demo::fabledlighthouse::store::BeaconDb]signal.beam_log.log_id,
    stationCode: [demo::fabledlighthouse::store::BeaconDb]signal.beam_log.station_code,
    region: [demo::fabledlighthouse::store::BeaconDb]signal.beam_log.region,
    logDate: [demo::fabledlighthouse::store::BeaconDb]signal.beam_log.log_date,
    visibilityDm: [demo::fabledlighthouse::store::BeaconDb]signal.beam_log.visibility_dm,
    activeHours: [demo::fabledlighthouse::store::BeaconDb]signal.beam_log.active_hours,
    rotations: [demo::fabledlighthouse::store::BeaconDb]signal.beam_log.rotations
  }

  demo::fabledlighthouse::domain::Station_BeamLog: Relational
  {
    AssociationMapping
    (
      station[beamLog,station]: [demo::fabledlighthouse::store::BeaconDb]@Station_BeamLog,
      logs[station,beamLog]: [demo::fabledlighthouse::store::BeaconDb]@Station_BeamLog
    )
  }
)
