###Connection
RelationalDatabaseConnection demo::fabledlighthouse::connection::BeaconH2Connection
{
  store: demo::fabledlighthouse::store::BeaconDb;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists signal;',
      'create schema signal;',
      'create table signal.station (code varchar(20) primary key, name varchar(200) not null, region varchar(80) not null, commissioned_date date not null, focal_height_m integer not null);',
      'create table signal.beam_log (log_id varchar(20) primary key, station_code varchar(20) not null, region varchar(80) not null, log_date date not null, visibility_dm integer not null, active_hours integer not null, rotations integer not null);'
      ];
  };
  auth: DefaultH2;
}
