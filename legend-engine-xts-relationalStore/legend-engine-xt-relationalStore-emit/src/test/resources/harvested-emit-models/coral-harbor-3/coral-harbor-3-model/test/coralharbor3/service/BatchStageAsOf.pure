###Service
Service test::coralharbor3::service::BatchStageAsOf
{
  pattern: '/coralharbor3/v1/batch-stage/{asOf}/{sownOn}';
  title: 'Coral Harbor - Batch Stage At A Point In Time';
  documentation: 'Resolves the propagation batches at the requested date through the milestoned accessor and reuses that same date as an ordinary potting-date equality alongside a sowing-date equality, projects the survivors into the six-column core row shape and then narrows that tabular result by reading its stage and watering columns as enumerated values.';
  ownership: UserList { users: ['nursery-propagation', 'bench-scheduling'] };
  autoActivateUpdates: true;
  execution: Single
  {
    query: {asOf: StrictDate[1], sownOn: StrictDate[1], stage: test::coralharbor3::domain::GrowthStage[1], watering: test::coralharbor3::domain::IrrigationMode[1]|test::coralharbor3::domain::PlantBatch.all($asOf)->filter(
      b|($b.sownOn == $sownOn) && ($b.pottedOn == $asOf)
    )->project(
      [
        b|$b.batchCode,
        b|$b.cultivar,
        b|$b.sownOn,
        b|$b.stage,
        b|$b.irrigation,
        b|$b.benchCode
      ],
      [
        'Batch',
        'Cultivar',
        'Sown',
        'Stage',
        'Watering',
        'Bench'
      ]
    )->filter(
      r|($r.getEnum('Stage') == $stage) && ($r.getEnum('Watering') == $watering)
    )};
    mapping: test::coralharbor3::mapping::NurseryMapping;
    runtime: test::coralharbor3::runtime::NurseryRuntime;
  }
  testSuites:
  [
    stageSuite:
    {
      data:
      [
        connections:
        [
          nurseryConnection:
            Relational
            #{
              nursery.plant_batch:
                'batch_id,batch_code,cultivar,sown_on,stage_code,irrigation_code,bench_code,propagator,potted_on,tray_count,height_cm,medium_code,house_code,seed_lot,germination_rate,hardened_on,label_note,bus_from_z,bus_thru_z\n'+
                '1,PB-0001,Alba Fern,2026-02-01,SDL,DRP,B-1,Iris Calder,2026-03-01,12,8.5,PEAT,GH-1,LOT-1,0.82,2026-04-01,spring sowing,2026-01-01,2026-05-01\n'+
                '1,PB-0001,Alba Fern,2026-02-01,VEG,DRP,B-1,Iris Calder,2026-06-01,12,9.5,PEAT,GH-1,LOT-1,0.82,2026-04-01,spring sowing,2026-05-01,9999-12-31\n'+
                '2,PB-0002,Coral Sedge,2026-02-15,VEG,MST,B-2,Nadia Ferrow,2026-03-10,8,14.25,COIR,GH-1,LOT-2,0.74,2026-04-15,bench two,2026-01-01,9999-12-31\n'+
                '3,PB-0003,Dune Aster,2026-03-05,FLW,FLD,B-3,Oren Vale,2026-03-20,20,22.5,BARK,GH-2,LOT-3,0.66,2026-05-01,late batch,2026-01-01,9999-12-31\n'+
                '4,PB-0004,Ember Moss,2026-01-10,DRM,MAN,B-1,Iris Calder,2026-02-01,4,3.75,PEAT,GH-2,LOT-4,0.51,2026-03-01,overwintered,2027-01-01,9999-12-31\n';
            }#
        ]
      ]
      tests:
      [
        juneStageForFebruarySowing:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            asOf = %2026-06-01,
            sownOn = %2026-02-01,
            stage = test::coralharbor3::domain::GrowthStage.VEGETATIVE,
            watering = test::coralharbor3::domain::IrrigationMode.DRIP
          ]
          asserts:
          [
            theCurrentVersionMatchesBothDatesAndBothEnums:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Batch":"PB-0001","Cultivar":"Alba Fern","Sown":"2026-02-01","Stage":"VEGETATIVE","Watering":"DRIP","Bench":"B-1"}]';
                  }#;
              }#
          ]
        },
        januarySownBatchIsOutOfRange:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            asOf = %2026-06-01,
            sownOn = %2026-01-10,
            stage = test::coralharbor3::domain::GrowthStage.DORMANT,
            watering = test::coralharbor3::domain::IrrigationMode.MANUAL
          ]
          asserts:
          [
            theOnlyMatchingVersionStartsAfterTheAsOfDate:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
