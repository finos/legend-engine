###Connection
RelationalDatabaseConnection test::coralharbor3::connection::NurseryH2Connection
{
  store: test::coralharbor3::store::NurseryDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists nursery;',
      'create schema nursery;',
      'create table nursery.plant_batch (batch_id integer not null, batch_code varchar(20) not null, cultivar varchar(80) not null, sown_on date not null, stage_code varchar(8) not null, irrigation_code varchar(8) not null, bench_code varchar(20) not null, propagator varchar(80) not null, potted_on date not null, tray_count integer not null, height_cm double not null, medium_code varchar(20) not null, house_code varchar(20) not null, seed_lot varchar(20) not null, germination_rate double not null, hardened_on date not null, label_note varchar(120) not null, bus_from_z date, bus_thru_z date);'
      ];
  };
  auth: DefaultH2;
}
