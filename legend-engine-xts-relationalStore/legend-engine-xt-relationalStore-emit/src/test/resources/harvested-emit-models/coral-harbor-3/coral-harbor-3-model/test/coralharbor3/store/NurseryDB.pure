###Relational
Database test::coralharbor3::store::NurseryDB
(
  Schema nursery
  (
    Table plant_batch
    (
      milestoning
      (
        business(BUS_FROM=bus_from_z, BUS_THRU=bus_thru_z)
      )
      batch_id INTEGER PRIMARY KEY,
      batch_code VARCHAR(20) NOT NULL,
      cultivar VARCHAR(80) NOT NULL,
      sown_on DATE NOT NULL,
      stage_code VARCHAR(8) NOT NULL,
      irrigation_code VARCHAR(8) NOT NULL,
      bench_code VARCHAR(20) NOT NULL,
      propagator VARCHAR(80) NOT NULL,
      potted_on DATE NOT NULL,
      tray_count INTEGER NOT NULL,
      height_cm FLOAT NOT NULL,
      medium_code VARCHAR(20) NOT NULL,
      house_code VARCHAR(20) NOT NULL,
      seed_lot VARCHAR(20) NOT NULL,
      germination_rate FLOAT NOT NULL,
      hardened_on DATE NOT NULL,
      label_note VARCHAR(120) NOT NULL,
      bus_from_z DATE PRIMARY KEY,
      bus_thru_z DATE
    )
  )
)
