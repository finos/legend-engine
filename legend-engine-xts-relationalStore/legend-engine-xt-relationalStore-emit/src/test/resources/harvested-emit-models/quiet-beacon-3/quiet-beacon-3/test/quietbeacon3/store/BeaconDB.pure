###Relational
Database test::quietbeacon3::store::BeaconDB
(
  Schema beacon
  (
    Table bell_station
    (
      milestoning
      (
        processing(PROCESSING_IN = processing_in, PROCESSING_OUT = processing_out)
      )
      station_id INTEGER PRIMARY KEY,
      station_code VARCHAR(40) NOT NULL,
      profile_path VARCHAR(200) NOT NULL,
      keeper_code VARCHAR(40) NOT NULL,
      nominal_hz DOUBLE NOT NULL,
      crown_mass_kg DOUBLE NOT NULL,
      rim_diameter_cm DOUBLE NOT NULL,
      strike_count INTEGER NOT NULL,
      temper_code VARCHAR(20) NOT NULL,
      crown_state_code VARCHAR(20) NOT NULL,
      storage_code VARCHAR(20) NOT NULL,
      script_code VARCHAR(20) NOT NULL,
      poured_on TIMESTAMP,
      is_listed BIT
      ,processing_in DATE NOT NULL
      ,processing_out DATE NOT NULL
    )
    Table keeper
    (
      keeper_id INTEGER PRIMARY KEY,
      keeper_code VARCHAR(40) NOT NULL,
      keeper_name VARCHAR(160) NOT NULL,
      founder_name VARCHAR(160) NOT NULL,
      coast_code VARCHAR(40) NOT NULL
    )
    Table founder_coast
    (
      coast_id INTEGER PRIMARY KEY,
      coast_code VARCHAR(40) NOT NULL,
      coast_name VARCHAR(160) NOT NULL,
      coast_climate VARCHAR(80) NOT NULL
    )
    Table tuning_pass
    (
      pass_id INTEGER PRIMARY KEY,
      station_code VARCHAR(40) NOT NULL,
      tuner_name VARCHAR(160) NOT NULL,
      pass_label VARCHAR(80) NOT NULL
    )
  )

  Join Station_Keeper(trim(beacon.bell_station.keeper_code) = trim(beacon.keeper.keeper_code))
  Join Keeper_Coast(toUpper(trim(beacon.keeper.coast_code)) = toUpper(beacon.founder_coast.coast_code))
  Join Station_Pass(beacon.bell_station.station_code = trim(beacon.tuning_pass.station_code))
)
