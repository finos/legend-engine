###Mapping
Mapping test::quietbeacon3::mapping::BeaconMapping
(
  include mapping test::quietbeacon3::mapping::BeaconClassificationMapping
  include mapping test::quietbeacon3::mapping::BeaconScriptMapping

  *test::quietbeacon3::domain::BellStation[station]: Relational
  {
    ~primaryKey
    (
      [test::quietbeacon3::store::BeaconDB]beacon.bell_station.station_id,
      [test::quietbeacon3::store::BeaconDB]beacon.bell_station.station_code
    )
    ~mainTable [test::quietbeacon3::store::BeaconDB]beacon.bell_station
    stationCode: [test::quietbeacon3::store::BeaconDB]beacon.bell_station.station_code,
    profileFamily: toUpper(trim([test::quietbeacon3::store::BeaconDB]beacon.bell_station.profile_path)),
    profileWeightBand: concat(
                         toUpper(trim([test::quietbeacon3::store::BeaconDB]beacon.bell_station.profile_path)),
                         concat('~', toUpper(trim([test::quietbeacon3::store::BeaconDB]beacon.bell_station.keeper_code)))
                       ),
    toneLabel: concat(
                 toUpper(trim([test::quietbeacon3::store::BeaconDB]beacon.bell_station.profile_path)),
                 concat(
                   '/',
                   concat(
                     toUpper(trim([test::quietbeacon3::store::BeaconDB]@Station_Keeper | beacon.keeper.keeper_name)),
                     '/CARILLON'
                   )
                 )
               ),
    keeperName: [test::quietbeacon3::store::BeaconDB]@Station_Keeper | beacon.keeper.keeper_name,
    founderName: [test::quietbeacon3::store::BeaconDB]@Station_Keeper | beacon.keeper.founder_name,
    coastName: [test::quietbeacon3::store::BeaconDB]@Station_Keeper > @Keeper_Coast | beacon.founder_coast.coast_name,
    coastClimate: coalesce(
                       [test::quietbeacon3::store::BeaconDB]@Station_Keeper > @Keeper_Coast | beacon.founder_coast.coast_climate,
                       'UNRECORDED'
                     ),
    tunerName: [test::quietbeacon3::store::BeaconDB]@Station_Pass | beacon.tuning_pass.tuner_name,
    registerSource: 'CARILLON REGISTER',
    archiveShelf: 'SHELF-B',
    nominalHz: [test::quietbeacon3::store::BeaconDB]beacon.bell_station.nominal_hz,
    crownMassKg: [test::quietbeacon3::store::BeaconDB]beacon.bell_station.crown_mass_kg,
    rimDiameterCm: [test::quietbeacon3::store::BeaconDB]beacon.bell_station.rim_diameter_cm,
    strikeCount: [test::quietbeacon3::store::BeaconDB]beacon.bell_station.strike_count,
    temper: EnumerationMapping TemperMapping: [test::quietbeacon3::store::BeaconDB]beacon.bell_station.temper_code,
    crownState: EnumerationMapping CrownStateMapping: [test::quietbeacon3::store::BeaconDB]beacon.bell_station.crown_state_code,
    storageTier: EnumerationMapping StorageTierMapping: [test::quietbeacon3::store::BeaconDB]beacon.bell_station.storage_code,
    inscriptionScript: EnumerationMapping InscriptionScriptMapping: [test::quietbeacon3::store::BeaconDB]beacon.bell_station.script_code
  }

  test::quietbeacon3::domain::ToneTemper: EnumerationMapping TemperMapping
  {
    MAJOR_THIRD: ['MJ', 'M3', 'MAJOR'],
    MINOR_THIRD: ['MN', 'M2'],
    UNTEMPERED: ['UT']
  }

  test::quietbeacon3::domain::CrownState: EnumerationMapping CrownStateMapping
  {
    SOUND: ['SD'],
    HAIRLINE: ['HL', 'HAIR'],
    RECAST_PENDING: ['RP']
  }

  test::quietbeacon3::reference::StorageTier: EnumerationMapping StorageTierMapping
  {
    AMBIENT_LOFT: ['AL', 'LOFT'],
    CHILLED_VAULT: ['CV'],
    OPEN_YARD: ['OY']
  }

  test::quietbeacon3::reference::InscriptionScript: EnumerationMapping InscriptionScriptMapping
  {
    ROMAN_CAPITALS: ['RC', 'ROMAN'],
    UNCIAL: ['UN'],
    BLACKLETTER: ['BL']
  }

  testSuites:
  [
    beaconRegisterSuite:
    {
      function: test::quietbeacon3::domain::BellStation.all()->project(~[stationCode: c|$c.stationCode, profileFamily: c|$c.profileFamily, profileWeightBand: c|$c.profileWeightBand, toneLabel: c|$c.toneLabel, keeperName: c|$c.keeperName, coastName: c|$c.coastName, coastClimate: c|$c.coastClimate, tunerName: c|$c.tunerName, registerSource: c|$c.registerSource, archiveShelf: c|$c.archiveShelf, strikeCount: c|$c.strikeCount, temper: c|$c.temper, crownState: c|$c.crownState, storageTier: c|$c.storageTier, inscriptionScript: c|$c.inscriptionScript]);
      tests:
      [
        registerRowsResolveEveryHop:
        {
          doc: 'Drives the aliased station table and reaches the keeper over a trimming join and the coast over a second upper-casing hop, so the two-hop labels, the nested string composition, the two constants and all four enumeration lookups are proven together; the station whose keeper code has no counterpart and the station with no tuning pass keep their driver columns and report the unmatched hops as nulls, and the nested composition collapses to an empty segment for the broken path.';
          data:
          [
            test::quietbeacon3::store::BeaconDB:
              Relational
              #{
                beacon.bell_station:
                  'station_id,station_code,profile_path,keeper_code,nominal_hz,crown_mass_kg,rim_diameter_cm,strike_count,temper_code,crown_state_code,storage_code,script_code,poured_on,is_listed,processing_in,processing_out\n'+
                  '1,BC-1,bourdon/heavy,WS-1 ,110.5,1840.25,168.40,12,MJ,SD,LOFT,ROMAN,2026-01-14 09:00:00,true,2026-01-01,2027-01-01\n'+
                  '2,BC-2, tenor/medium ,ws-2,220.0,940.75,121.60,7,M2,HAIR,CV,UN,2026-02-03 09:00:00,true,2026-01-01,2027-01-01\n'+
                  '3,BC-3,treble/light,WS-9,440.0,310.50,84.20,3,UT,RP,OY,BL,2026-02-11 09:00:00,false,2027-01-01,2028-01-01\n'+
                  '4,BC-4,quint/light,WS-1,330.0,505.00,96.80,5,MAJOR,SD,AL,RC,2026-03-02 09:00:00,true,2026-01-01,2027-01-01\n';

                beacon.keeper:
                  'keeper_id,keeper_code,keeper_name,founder_name,coast_code\n'+
                  '1,WS-1,Old Belfry Works,Ilse Vandermeer,DS-1\n'+
                  '2,ws-2,Riverside Bell House,Tomas Brekke,ds-2\n';

                beacon.founder_coast:
                  'coast_id,coast_code,coast_name,coast_climate\n'+
                  '1,DS-1,Upper Weaving Quarter,Temperate Inland\n'+
                  '2,DS-2,Lower Wharf Quarter,Maritime Mild\n';

                beacon.tuning_pass:
                  'pass_id,station_code,tuner_name,pass_label\n'+
                  '1,BC-1,Marta Lindqvist,first pass\n'+
                  '2, BC-2,Ewan Rhodes,second pass\n'+
                  '3,BC-3,Nils Aakre,first pass\n';
              }#
          ];
          asserts:
          [
            resolvedAndBrokenPaths:
              Relation
              #{
                stationCode,profileFamily,profileWeightBand,toneLabel,keeperName,coastName,coastClimate,tunerName,registerSource,archiveShelf,strikeCount,temper,crownState,storageTier,inscriptionScript
                BC-1,BOURDON/HEAVY,BOURDON/HEAVY~WS-1,BOURDON/HEAVY/OLD BELFRY WORKS/CARILLON,Old Belfry Works,Upper Weaving Quarter,Temperate Inland,Marta Lindqvist,CARILLON REGISTER,SHELF-B,12,MAJOR_THIRD,SOUND,AMBIENT_LOFT,ROMAN_CAPITALS
                BC-2,TENOR/MEDIUM,TENOR/MEDIUM~WS-2,TENOR/MEDIUM/RIVERSIDE BELL HOUSE/CARILLON,Riverside Bell House,Lower Wharf Quarter,Maritime Mild,Ewan Rhodes,CARILLON REGISTER,SHELF-B,7,MINOR_THIRD,HAIRLINE,CHILLED_VAULT,UNCIAL
                BC-3,TREBLE/LIGHT,TREBLE/LIGHT~WS-9,TREBLE/LIGHT//CARILLON,null,null,UNRECORDED,Nils Aakre,CARILLON REGISTER,SHELF-B,3,UNTEMPERED,RECAST_PENDING,OPEN_YARD,BLACKLETTER
                BC-4,QUINT/LIGHT,QUINT/LIGHT~WS-1,QUINT/LIGHT/OLD BELFRY WORKS/CARILLON,Old Belfry Works,Upper Weaving Quarter,Temperate Inland,null,CARILLON REGISTER,SHELF-B,5,MAJOR_THIRD,SOUND,AMBIENT_LOFT,ROMAN_CAPITALS;
              }#
          ];
        }
      ];
    },
    processingWindowSuite:
    {
      function: |test::quietbeacon3::domain::BellStation.all(%2026-06-01)->project(
        [
          c|$c.stationCode
        ],
        [
          'stationCode'
        ]
      );
      tests:
      [
        milestoningOutOfRangeRow:
        {
          doc: 'A station whose processing window starts after the requested instant is excluded from the point-in-time station register.';
          data:
          [
            test::quietbeacon3::store::BeaconDB:
              Relational
              #{
                beacon.bell_station:
                  'station_id,station_code,profile_path,keeper_code,nominal_hz,crown_mass_kg,rim_diameter_cm,strike_count,temper_code,crown_state_code,storage_code,script_code,poured_on,is_listed,processing_in,processing_out\n'+
                  '1,BC-1,bourdon/heavy,WS-1,110.5,1840.25,168.40,12,MJ,SD,LOFT,ROMAN,2026-01-14 09:00:00,true,2026-01-01,2027-01-01\n'+
                  '3,BC-3,treble/light,WS-9,440.0,310.50,84.20,3,UT,RP,OY,BL,2026-02-11 09:00:00,false,2027-01-01,2028-01-01\n';
              }#
          ];
          asserts:
          [
            currentStation:
              Relation
              #{
                stationCode
                BC-1;
              }#
          ];
        }
      ];
    }
  ]
)
