###Pure
import test::quietbeacon3::domain::*;
import test::quietbeacon3::reference::*;

Enum {meta::pure::profiles::doc.doc = 'Tuning temper a station was finished to.'} test::quietbeacon3::domain::ToneTemper
{
  MAJOR_THIRD,
  MINOR_THIRD,
  UNTEMPERED
}

Enum {meta::pure::profiles::doc.doc = 'Condition recorded for the crown of a station.'} test::quietbeacon3::domain::CrownState
{
  SOUND,
  HAIRLINE,
  RECAST_PENDING
}

Class <<temporal.processingtemporal>> {meta::pure::profiles::doc.doc = 'One coastal beacon station in a maintenance register, with its keeper assignment, inspection verdicts and closed operational classifications.'} test::quietbeacon3::domain::BellStation
{
  stationCode: String[1];
  profileFamily: String[1];
  profileWeightBand: String[1];
  toneLabel: String[1];
  keeperName: String[1];
  founderName: String[1];
  coastName: String[1];
  coastClimate: String[1];
  tunerName: String[1];
  registerSource: String[1];
  archiveShelf: String[1];
  nominalHz: Float[1];
  crownMassKg: Float[1];
  rimDiameterCm: Float[1];
  strikeCount: Integer[1];
  temper: ToneTemper[1];
  crownState: CrownState[1];
  storageTier: StorageTier[1];
  inscriptionScript: InscriptionScript[1];
}
