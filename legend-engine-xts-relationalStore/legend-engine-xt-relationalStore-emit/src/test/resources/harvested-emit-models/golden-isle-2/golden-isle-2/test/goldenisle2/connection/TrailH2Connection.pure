###Connection
RelationalDatabaseConnection test::goldenisle2::connection::TrailH2Connection
{
  store: test::goldenisle2::store::TrailDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists trail;',
      'drop schema if exists isleref;',
      'create schema trail;',
      'create schema isleref;',
      'create table trail.path_segment (segment_code varchar(24) not null, route_code varchar(24) not null, surface_code varchar(40) not null, gradient_pct integer not null, width_cm integer not null, drainage_code varchar(24) not null);',
      'create table trail.path_route (route_code varchar(24) not null, route_name varchar(120) not null, district_code varchar(24) not null);',
      'create table trail.segment_inspection (inspection_code varchar(24) not null, segment_code varchar(24) not null, inspected_on date not null, erosion_score integer not null, surface_code varchar(40) not null, gradient_pct integer not null, width_cm integer not null, note varchar(200) not null);',
      'create table isleref.district (district_code varchar(24) not null, district_name varchar(120) not null, isle_code varchar(24) not null);',
      'create table isleref.isle (isle_code varchar(24) not null, isle_name varchar(120) not null, landing_code varchar(24) not null);',
      'create table isleref.landing (landing_code varchar(24) not null, landing_name varchar(120) not null, crossing_minutes integer not null);'
      ];
  };
  auth: DefaultH2;
}
