###Relational
Database test::silverfjord2::store::FjordDb
(
  Schema fjord
  (
    Table tide_gauge
    (
      reading_id INTEGER PRIMARY KEY,
      gauge_name VARCHAR(200) NOT NULL,
      station_code VARCHAR(50) NOT NULL,
      gauge_status VARCHAR(20) NOT NULL,
      tide_height INTEGER NOT NULL,
      wave_count INTEGER NOT NULL
    )
  )
)
