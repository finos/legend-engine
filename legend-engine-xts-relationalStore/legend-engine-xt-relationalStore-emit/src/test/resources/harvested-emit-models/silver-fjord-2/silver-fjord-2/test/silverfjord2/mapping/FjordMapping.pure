###Mapping
Mapping test::silverfjord2::mapping::FjordMapping
(
  *test::silverfjord2::domain::GaugeReading[gaugeReading]: Relational
  {
    ~primaryKey
    (
      [test::silverfjord2::store::FjordDb]fjord.tide_gauge.reading_id
    )
    ~mainTable [test::silverfjord2::store::FjordDb]fjord.tide_gauge
    readingId: [test::silverfjord2::store::FjordDb]fjord.tide_gauge.reading_id,
    gaugeName: [test::silverfjord2::store::FjordDb]fjord.tide_gauge.gauge_name,
    stationCode: [test::silverfjord2::store::FjordDb]fjord.tide_gauge.station_code,
    gaugeStatus: [test::silverfjord2::store::FjordDb]fjord.tide_gauge.gauge_status,
    tideHeight: [test::silverfjord2::store::FjordDb]fjord.tide_gauge.tide_height,
    waveCount: [test::silverfjord2::store::FjordDb]fjord.tide_gauge.wave_count
  }
)
