###Connection
RelationalDatabaseConnection test::silverfjord2::connection::FjordGaugeConnection
{
  store: test::silverfjord2::store::FjordDb;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists fjord;',
      'create schema fjord;',
      'create table fjord.tide_gauge (reading_id integer primary key, gauge_name varchar(200) not null, station_code varchar(50) not null, gauge_status varchar(20) not null, tide_height integer not null, wave_count integer not null);',
      'insert into fjord.tide_gauge values (1, \'Outer Sill\', \'NorthArm\', \'OPEN\', 120, 40);',
      'insert into fjord.tide_gauge values (2, \'Inner Sill\', \'NorthArm\', \'ACTIVE\', 80, 60);',
      'insert into fjord.tide_gauge values (3, \'Dry Shelf\', \'NorthArm\', \'SEALED\', 0, 10);',
      'insert into fjord.tide_gauge values (4, \'Far Head\', \'SouthArm\', \'OPEN\', 200, 90);',
      'insert into fjord.tide_gauge values (5, \'Mid Reach\', \'NorthArm\', \'OPEN\', 140, 20);'
      ];
  };
  auth: DefaultH2;
}
