###Pure
import test::ivorythicket::domain::*;

Class test::ivorythicket::domain::Inspection
{
  inspectionRef: String[1];
  inspectedOn: StrictDate[1];
  faultsFound: Integer[1];
  severity: FaultSeverity[0..1];
  frameKind: FrameKind[1];
}

Class test::ivorythicket::domain::DockingStation
{
  stationRef: String[1];
  stationName: String[1];
  standCount: Integer[1];
}

Class test::ivorythicket::domain::Mechanic
{
  mechanicRef: String[1];
  fullName: String[1];
}

Association test::ivorythicket::domain::CycleRecord_Inspection
{
  cycle: CycleRecord[1];
  inspections: Inspection[*];
}

Association test::ivorythicket::domain::DockingStation_CycleRecord
{
  station: DockingStation[1];
  dockedCycles: CycleRecord[*];
}

Association test::ivorythicket::domain::CargoCycle_Mechanic
{
  cargoCycle: CargoCycle[0..1];
  mechanics: Mechanic[*];
}
