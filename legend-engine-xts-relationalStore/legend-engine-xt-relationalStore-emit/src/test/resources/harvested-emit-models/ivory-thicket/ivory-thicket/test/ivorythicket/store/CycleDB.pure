###Relational
Database test::ivorythicket::store::CycleDB
(
  Schema fleet
  (
    Table cycle_record
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )

      cycle_ref VARCHAR(24) PRIMARY KEY,
      station_ref VARCHAR(24) NOT NULL,
      service_state VARCHAR(16) NOT NULL,
      gear_count INTEGER,
      wear_index INTEGER,
      last_seen_on DATE NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
  )
)
