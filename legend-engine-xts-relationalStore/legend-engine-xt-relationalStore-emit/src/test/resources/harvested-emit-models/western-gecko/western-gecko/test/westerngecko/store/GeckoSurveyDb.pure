###Relational
Database test::westerngecko::store::GeckoSurveyDb
(
  Schema field
  (
    Table survey_site
    (
      site_id INTEGER PRIMARY KEY,
      site_name VARCHAR(120) NOT NULL,
      habitat_kind VARCHAR(20) NOT NULL,
      protection_flag CHAR(1) NOT NULL
    )
    Table gecko_record
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )

      record_id INTEGER PRIMARY KEY,
      record_code VARCHAR(20) NOT NULL,
      site_id INTEGER NOT NULL,
      species_group VARCHAR(8) NOT NULL,
      tail_flag CHAR(1) NOT NULL,
      observer_name VARCHAR(120) NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
    Table observation_tag
    (
      tag_id INTEGER PRIMARY KEY,
      record_id INTEGER NOT NULL,
      tag_label VARCHAR(60) NOT NULL
    )
  )

  Join Record_Site
  (
    [test::westerngecko::store::GeckoSurveyDb]field.gecko_record.site_id = [test::westerngecko::store::GeckoSurveyDb]field.survey_site.site_id
  )

  Join Record_Tag
  (
    [test::westerngecko::store::GeckoSurveyDb]field.gecko_record.record_id = [test::westerngecko::store::GeckoSurveyDb]field.observation_tag.record_id
  )
)
