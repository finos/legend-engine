###Relational
Database test::fabledarboretum6::store::ScopeDb
(
  Schema hirepool
  (
    Table sky_region
    (
      region_code VARCHAR(16) PRIMARY KEY,
      region_name VARCHAR(64) NOT NULL,
      light_code VARCHAR(8) NOT NULL
    )

    Table mount_site
    (
      site_code VARCHAR(16) PRIMARY KEY,
      site_name VARCHAR(64) NOT NULL,
      region_code VARCHAR(16) NOT NULL,
      altitude_m INTEGER NOT NULL
    )

    Table telescope
    (
      scope_id INTEGER PRIMARY KEY,
      scope_code VARCHAR(16) NOT NULL,
      scope_name VARCHAR(64) NOT NULL,
      aperture_mm INTEGER NOT NULL,
      mount_code VARCHAR(8) NOT NULL,
      optic_code VARCHAR(8) NOT NULL,
      tube_state VARCHAR(16) NOT NULL,
      site_code VARCHAR(16) NOT NULL,
      logged_hours INTEGER NOT NULL,
      service_note VARCHAR(48)
    )
  )

  Join Scope_Site(hirepool.telescope.site_code = hirepool.mount_site.site_code)
  Join Site_Region(hirepool.mount_site.region_code = hirepool.sky_region.region_code)
)
