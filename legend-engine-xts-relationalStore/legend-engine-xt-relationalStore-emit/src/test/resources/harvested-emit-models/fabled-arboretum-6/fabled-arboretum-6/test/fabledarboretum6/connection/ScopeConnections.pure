###Connection
RelationalDatabaseConnection test::fabledarboretum6::connection::ScopePoolConnection
{
  store: test::fabledarboretum6::store::ScopeDb;
  type: MemSQL;
  timezone: +0000;
  quoteIdentifiers: false;
  specification: Static
  {
    name: 'EXAMPLE_SCOPE_POOL_DB';
    host: 'example-scope-pool-host';
    port: 3306;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'scopepoolserviceprincipal';
  };
  postProcessors:
  [
    mapper
    {
      mappers:
      [
        schema {from: 'hirepool'; to: 'hirepool_current';}
      ];
    }
  ];
}

###Connection
RelationalDatabaseConnection test::fabledarboretum6::connection::CoatingBenchConnection
{
  store: test::fabledarboretum6::store::CoatingDb;
  type: MemSQL;
  timezone: +0000;
  quoteIdentifiers: false;
  specification: Static
  {
    name: 'EXAMPLE_COATING_BENCH_DB';
    host: 'example-coating-bench-host';
    port: 3306;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'coatingbenchserviceprincipal';
  };
  postProcessors:
  [
    mapper
    {
      mappers:
      [
        table {from: 'optic_grade'; to: 'optic_grade_current'; schemaFrom: 'optics'; schemaTo: 'optics';}
      ];
    }
  ];
}
