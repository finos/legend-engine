###Relational
Database test::wistfulwharf5::store::WharfDb
(
  Schema harbour
  (
    Table mooring_berth
    (
      berth_id INTEGER PRIMARY KEY,
      berth_code VARCHAR(24) NOT NULL,
      berth_name VARCHAR(120) NOT NULL,
      pontoon_name VARCHAR(60) NOT NULL,
      berth_length_m DOUBLE NOT NULL
    )

    Table harbour_watch
    (
      watch_id INTEGER PRIMARY KEY,
      watch_code VARCHAR(24) NOT NULL,
      watch_lead_name VARCHAR(120) NOT NULL,
      watch_name VARCHAR(60) NOT NULL
    )

    Table vessel_visit
    (
      visit_id INTEGER PRIMARY KEY,
      visit_code VARCHAR(24) NOT NULL,
      vessel_name VARCHAR(120) NOT NULL,
      state_code VARCHAR(4),
      nights_alongside INTEGER NOT NULL,
      berth_id INTEGER,
      watch_id INTEGER
    )
  )

  Join Visit_Berth(harbour.vessel_visit.berth_id = harbour.mooring_berth.berth_id)
  Join Visit_Watch(harbour.vessel_visit.watch_id = harbour.harbour_watch.watch_id)
)
