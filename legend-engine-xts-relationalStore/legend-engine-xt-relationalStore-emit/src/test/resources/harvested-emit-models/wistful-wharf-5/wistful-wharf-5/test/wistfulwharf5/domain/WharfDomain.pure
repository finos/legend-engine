###Pure
import test::wistfulwharf5::domain::*;

Enum {meta::pure::profiles::doc.doc = 'The state a vessel visit is in when the harbour master closes the daily register.'} test::wistfulwharf5::domain::VisitState
{
  ALONGSIDE,
  DEPARTED,
  EXPECTED
}

Class {meta::pure::profiles::doc.doc = 'A mooring berth on one of the wharf pontoons, mapped by the included base mapping and reached from a visit across the berth join.'} test::wistfulwharf5::domain::MooringBerth
{
  berthCode: String[1];
  berthName: String[1];
  pontoonName: String[1];
  berthLengthM: Float[1];
}

Class {meta::pure::profiles::doc.doc = 'A watch of harbour crew answerable for a visit, reached from a visit across the crew join.'} test::wistfulwharf5::domain::HarbourWatch
{
  watchCode: String[1];
  watchLeadName: String[1];
  watchName: String[1];
}

Class {meta::pure::profiles::doc.doc = 'One vessel visit to the wharf, carrying the register state decoded from a stored code and the berth and watch context reached across the two joins.'} test::wistfulwharf5::domain::VesselVisit
{
  visitCode: String[1];
  vesselName: String[1];
  visitState: VisitState[1];
  nightsAlongside: Integer[1];
  berthName: String[0..1];
  pontoonName: String[0..1];
  watchLeadName: String[0..1];
  watchName: String[0..1];
}
