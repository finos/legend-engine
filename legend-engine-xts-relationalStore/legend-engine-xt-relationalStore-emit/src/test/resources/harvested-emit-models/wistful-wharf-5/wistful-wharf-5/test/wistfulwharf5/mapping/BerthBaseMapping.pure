###Mapping
Mapping test::wistfulwharf5::mapping::BerthBaseMapping
(
  *test::wistfulwharf5::domain::MooringBerth[berth]: Relational
  {
    ~primaryKey
    (
      [test::wistfulwharf5::store::WharfDb]harbour.mooring_berth.berth_id
    )
    ~mainTable [test::wistfulwharf5::store::WharfDb]harbour.mooring_berth
    berthCode: [test::wistfulwharf5::store::WharfDb]harbour.mooring_berth.berth_code,
    berthName: [test::wistfulwharf5::store::WharfDb]harbour.mooring_berth.berth_name,
    pontoonName: toUpper([test::wistfulwharf5::store::WharfDb]harbour.mooring_berth.pontoon_name),
    berthLengthM: [test::wistfulwharf5::store::WharfDb]harbour.mooring_berth.berth_length_m
  }

  *test::wistfulwharf5::domain::HarbourWatch[watch]: Relational
  {
    ~primaryKey
    (
      [test::wistfulwharf5::store::WharfDb]harbour.harbour_watch.watch_id
    )
    ~mainTable [test::wistfulwharf5::store::WharfDb]harbour.harbour_watch
    watchCode: [test::wistfulwharf5::store::WharfDb]harbour.harbour_watch.watch_code,
    watchLeadName: [test::wistfulwharf5::store::WharfDb]harbour.harbour_watch.watch_lead_name,
    watchName: [test::wistfulwharf5::store::WharfDb]harbour.harbour_watch.watch_name
  }
)
