###Connection
RelationalDatabaseConnection demo::borealwillow::connection::WillowFieldConnection
{
  store: demo::borealwillow::store::WillowNurseryDatabase;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists nursery;',
      'create schema nursery;',
      'create table nursery.cutting_batch (batch_ref varchar(24) primary key, stand_code varchar(24), stand_name varchar(80), clone_code varchar(24), stem_count integer, grade_code varchar(4), rooted varchar(5));'
      ];
  };
  auth: DefaultH2;
}

###Connection
RelationalDatabaseConnection demo::borealwillow::connection::WillowArchiveConnection
