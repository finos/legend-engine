###Relational
Database demo::borealwillow::store::WillowNurseryDatabase
(
  Schema nursery
  (
    Table cutting_batch
    (
      batch_ref VARCHAR(24) PRIMARY KEY,
      stand_code VARCHAR(24),
      stand_name VARCHAR(80),
      clone_code VARCHAR(24),
      stem_count INTEGER,
      grade_code VARCHAR(4),
      rooted VARCHAR(5)
    )
  )
)
