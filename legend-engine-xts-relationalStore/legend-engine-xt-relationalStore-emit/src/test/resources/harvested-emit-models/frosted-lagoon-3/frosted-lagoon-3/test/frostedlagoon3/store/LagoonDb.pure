###Relational
Database test::frostedlagoon3::store::LagoonDb
(
  Schema lagoon
  (
    Table oyster_tray
    (
      tray_id INTEGER PRIMARY KEY,
      tray_code VARCHAR(16) NOT NULL,
      tray_name VARCHAR(64) NOT NULL,
      trestle_code VARCHAR(16),
      grade_code VARCHAR(8),
      shell_length_mm INTEGER,
      notes_text VARCHAR(128)
    )
    Table trestle
    (
      trestle_code VARCHAR(16) PRIMARY KEY,
      trestle_name VARCHAR(64) NOT NULL,
      bed_code VARCHAR(16)
    )
    Table oyster_bed
    (
      bed_code VARCHAR(16) PRIMARY KEY,
      bed_name VARCHAR(64) NOT NULL,
      zone_code VARCHAR(16)
    )
    Table lagoon_zone
    (
      zone_code VARCHAR(16) PRIMARY KEY,
      zone_name VARCHAR(64) NOT NULL
    )
    Table basket_entry
    (
      entry_id INTEGER PRIMARY KEY,
      tray_code VARCHAR(16) NOT NULL,
      basket_kg DOUBLE NOT NULL,
      gathered_on DATE
    )
  )

  Join Tray_Trestle(lagoon.oyster_tray.trestle_code = lagoon.trestle.trestle_code)

  Join Trestle_Bed(lagoon.trestle.bed_code = lagoon.oyster_bed.bed_code)

  Join Bed_Zone(lagoon.oyster_bed.zone_code = lagoon.lagoon_zone.zone_code)
)
