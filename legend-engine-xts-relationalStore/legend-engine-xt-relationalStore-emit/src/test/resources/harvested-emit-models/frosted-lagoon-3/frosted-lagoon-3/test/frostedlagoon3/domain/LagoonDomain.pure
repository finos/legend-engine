###Pure
import test::frostedlagoon3::domain::*;

Enum {meta::pure::profiles::doc.doc = 'The cultivation grade an oyster tray is sorted into at the lagoon grading shed.'} test::frostedlagoon3::domain::GradeClass
{
  PRIME,
  ROCKPOOL,
  CULL,
  SPAT
}

Class {meta::pure::profiles::doc.doc = 'A tray of cultivated oysters standing on a lagoon trestle, described together with everything reached from it through the store joins.'} test::frostedlagoon3::domain::OysterTray
{
  trayCode: String[1];
  trayName: String[1];
  shellLengthMm: Integer[0..1];
  shellBand: String[0..1];
  grade: GradeClass[0..1];
  trestleName: String[0..1];
  bedName: String[0..1];
  zoneName: String[0..1];
  notesLine: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'Basket entries gathered from one tray, reduced to a tally, the heaviest basket and the summed weight.'} test::frostedlagoon3::domain::TrayBasketTally
{
  trayCode: String[1];
  basketTally: Integer[0..1];
  heaviestBasketKg: Float[0..1];
  totalBasketKg: Float[0..1];
}

Class {meta::pure::profiles::doc.doc = 'Trays standing on one trestle, reduced to a tally and the longest shell measured on that trestle.'} test::frostedlagoon3::domain::TrestleTrayTally
{
  trestleCode: String[1];
  trayTally: Integer[0..1];
  longestShellMm: Integer[0..1];
}
