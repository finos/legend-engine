###Mapping
Mapping test::quiethatchery2::mapping::HatcheryBaseMapping
(
  *test::quiethatchery2::domain::HatchPond: Relational
  {
    ~primaryKey
    (
      [test::quiethatchery2::store::HatcheryDatabase]hatchery.hatch_pond.pond_code
    )
    ~mainTable [test::quiethatchery2::store::HatcheryDatabase]hatchery.hatch_pond
    pondCode: [test::quiethatchery2::store::HatcheryDatabase]hatchery.hatch_pond.pond_code,
    pondName: [test::quiethatchery2::store::HatcheryDatabase]hatchery.hatch_pond.pond_name,
    district: [test::quiethatchery2::store::HatcheryDatabase]@Pond_District
  }

  *test::quiethatchery2::domain::HatchDistrict: Relational
  {
    ~primaryKey
    (
      [test::quiethatchery2::store::HatcheryDatabase]hatchery.hatch_district.district_code
    )
    ~mainTable [test::quiethatchery2::store::HatcheryDatabase]hatchery.hatch_district
    districtCode: [test::quiethatchery2::store::HatcheryDatabase]hatchery.hatch_district.district_code,
    districtName: [test::quiethatchery2::store::HatcheryDatabase]hatchery.hatch_district.district_name
  }
)
