###Connection
RelationalDatabaseConnection test::quiethatchery2::connection::HatcheryH2Connection
{
  store: test::quiethatchery2::store::HatcheryDatabase;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists hatchery;',
      'create schema hatchery;',
      'create table hatchery.tray_revision (basis_code varchar(20) not null, tray_code varchar(20) not null, batch_code varchar(20) not null, record_date date not null, tally_method varchar(20), early_band varchar(20), late_band varchar(20), observation_kind varchar(20), egg_count integer, fry_count integer, tray_note varchar(200), in_z date not null, out_z date not null, from_z date not null, thru_z date not null);',
      'create table hatchery.hatch_pond (pond_code varchar(20) not null, pond_name varchar(120), district_code varchar(20), from_z date not null, thru_z date not null);',
      'create table hatchery.hatch_district (district_code varchar(20) not null, district_name varchar(120) not null, from_z date not null, thru_z date not null);'
      ];
  };
  auth: DefaultH2;
}
