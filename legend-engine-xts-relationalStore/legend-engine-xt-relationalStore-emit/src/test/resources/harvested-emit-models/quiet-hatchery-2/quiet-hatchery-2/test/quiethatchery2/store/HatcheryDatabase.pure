###Relational
Database test::quiethatchery2::store::HatcheryDatabase
(
  Schema hatchery
  (
    Table tray_revision
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z),
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      basis_code VARCHAR(20) PRIMARY KEY,
      tray_code VARCHAR(20) PRIMARY KEY,
      batch_code VARCHAR(20) PRIMARY KEY,
      record_date DATE PRIMARY KEY,
      tally_method VARCHAR(20),
      early_band VARCHAR(20),
      late_band VARCHAR(20),
      observation_kind VARCHAR(20),
      egg_count INTEGER,
      fry_count INTEGER,
      tray_note VARCHAR(200),
      in_z DATE PRIMARY KEY,
      out_z DATE NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
    Table hatch_pond
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      pond_code VARCHAR(20) PRIMARY KEY,
      pond_name VARCHAR(120),
      district_code VARCHAR(20),
      from_z DATE PRIMARY KEY,
      thru_z DATE NOT NULL
    )
    Table hatch_district
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      district_code VARCHAR(20) PRIMARY KEY,
      district_name VARCHAR(120) NOT NULL,
      from_z DATE PRIMARY KEY,
      thru_z DATE NOT NULL
    )
  )

  Join Pond_District(hatchery.hatch_pond.district_code = hatchery.hatch_district.district_code)
)
