###Connection
RelationalDatabaseConnection test::fabledbeacon4::connection::BeaconH2Connection
{
  store: test::fabledbeacon4::store::BeaconDB;
  type: H2;
  specification: LocalH2 { testDataSetupSqls: []; };
  auth: DefaultH2;
}

RelationalDatabaseConnection test::fabledbeacon4::connection::BeaconDB2Connection
{
  store: test::fabledbeacon4::store::BeaconDB;
  type: DB2;
  specification: Static
  {
    name: 'CANOPY_STEWARDSHIP_DB';
    host: 'canopy-stewardship.example';
    port: 50000;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'canopystewardshipserviceprincipal';
  };
}
