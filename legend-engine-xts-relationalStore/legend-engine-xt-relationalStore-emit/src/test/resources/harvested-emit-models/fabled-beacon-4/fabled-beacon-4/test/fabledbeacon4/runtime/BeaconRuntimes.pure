###Runtime
Runtime test::fabledbeacon4::runtime::BeaconRuntime
{
  mappings:
  [
    test::fabledbeacon4::mapping::BeaconMapping
  ];
  connections:
  [
    test::fabledbeacon4::store::BeaconDB:
    [
      h2Connection: test::fabledbeacon4::connection::BeaconH2Connection
    ]
  ];
}

Runtime test::fabledbeacon4::runtime::BeaconDB2Runtime
{
  mappings:
  [
    test::fabledbeacon4::mapping::BeaconMapping
  ];
  connections:
  [
    test::fabledbeacon4::store::BeaconDB:
    [
      db2Connection: test::fabledbeacon4::connection::BeaconDB2Connection
    ]
  ];
}
