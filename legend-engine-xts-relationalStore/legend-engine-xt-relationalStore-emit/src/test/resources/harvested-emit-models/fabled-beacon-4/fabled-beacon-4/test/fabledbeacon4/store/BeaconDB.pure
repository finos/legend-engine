###Relational
Database test::fabledbeacon4::store::BeaconDB
(
  Schema grove
  (
    Table tree_record
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      tree_code VARCHAR(20) PRIMARY KEY,
      zone_code VARCHAR(20) NOT NULL,
      tree_name VARCHAR(80) NOT NULL,
      measured_at TIMESTAMP NOT NULL,
      healthy_flag BIT NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
  )
  Schema habitat
  (
    Table zone
    (
      zone_code VARCHAR(20) PRIMARY KEY,
      zone_name VARCHAR(80) NOT NULL,
      zone_tier INTEGER NOT NULL
    )
    Table zone_note
    (
      note_code VARCHAR(20) PRIMARY KEY,
      zone_code VARCHAR(20) NOT NULL,
      note_text VARCHAR(120) NOT NULL
    )
  )
  Join Tree_Zone(grove.tree_record.zone_code = habitat.zone.zone_code)
  Join Zone_Note(habitat.zone.zone_code = habitat.zone_note.zone_code)
)
