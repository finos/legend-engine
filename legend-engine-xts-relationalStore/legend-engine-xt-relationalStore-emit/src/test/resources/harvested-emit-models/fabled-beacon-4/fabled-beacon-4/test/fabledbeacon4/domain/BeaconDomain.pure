###Pure
import test::fabledbeacon4::domain::*;

Class test::fabledbeacon4::domain::HabitatZone
{
  zoneCode: String[1];
  zoneName: String[1];
  zoneTier: Integer[1];
  note: ZoneNote[0..1];
}

Class <<temporal.businesstemporal>> test::fabledbeacon4::domain::TreeRecord
{
  treeCode: String[1];
  treeName: String[1];
  measuredAt: DateTime[1];
  healthyFlag: Boolean[1];
}

Class test::fabledbeacon4::domain::ZoneNote
{
  noteCode: String[1];
  noteText: String[1];
}

Association test::fabledbeacon4::domain::Tree_Zone
{
  trees: TreeRecord[*];
  zone: HabitatZone[1];
}
