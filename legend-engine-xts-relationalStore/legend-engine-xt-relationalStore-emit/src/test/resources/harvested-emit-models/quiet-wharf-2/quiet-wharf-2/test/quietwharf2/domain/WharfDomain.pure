###Pure
import test::quietwharf2::domain::*;

Class {meta::pure::profiles::doc.doc = 'A quay of the harbour a vessel can be allocated a berth against, held by the warden who keeps its berth register.'} test::quietwharf2::domain::Wharf
{
  wharfCode: String[1];
  wharfName: String[1];
  wardenName: String[1];
  harbourCode: String[1];
}

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'The berth a vessel holds on a wharf, effective over business time so a re-berthing closes the previous allocation rather than overwriting it.'} test::quietwharf2::domain::BerthAllocation
{
  allocationCode: String[1];
  vesselName: String[1];
  berthNumber: Integer[1];
  lengthMetres: Float[1];
}

Association test::quietwharf2::domain::AllocationWharf
{
  wharf: Wharf[1];
  berthAllocations: BerthAllocation[*];
}
