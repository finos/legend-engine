###Relational
Database test::quietwharf2::store::WharfReferenceStore
(
  Schema reference
  (
    Table wharf
    (
      wharf_code VARCHAR(20) PRIMARY KEY,
      wharf_name VARCHAR(60) NOT NULL,
      warden_name VARCHAR(60) NOT NULL,
      harbour_code VARCHAR(20) NOT NULL
    )
  )
)

Database test::quietwharf2::store::MooringStore
(
  include test::quietwharf2::store::WharfReferenceStore

  Schema mooring
  (
    Table berth_allocation
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )

      allocation_key VARCHAR(24) PRIMARY KEY,
      allocation_code VARCHAR(20) NOT NULL,
      vessel_name VARCHAR(60) NOT NULL,
      berth_number INTEGER NOT NULL,
      length_metres DOUBLE NOT NULL,
      wharf_code VARCHAR(20) NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
  )

  Join Allocation_Wharf(mooring.berth_allocation.wharf_code = reference.wharf.wharf_code)
)
