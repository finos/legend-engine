###Mapping
Mapping test::quietwharf2::mapping::WharfReferenceMapping
(
  *test::quietwharf2::domain::Wharf[wharf]: Relational
  {
    ~primaryKey
    (
      [test::quietwharf2::store::MooringStore]reference.wharf.wharf_code
    )
    ~mainTable [test::quietwharf2::store::MooringStore]reference.wharf
    wharfCode: [test::quietwharf2::store::MooringStore]reference.wharf.wharf_code,
    wharfName: [test::quietwharf2::store::MooringStore]reference.wharf.wharf_name,
    wardenName: [test::quietwharf2::store::MooringStore]reference.wharf.warden_name,
    harbourCode: [test::quietwharf2::store::MooringStore]reference.wharf.harbour_code
  }

  testSuites:
  [
    wharfRegisterSuite:
    {
      function: |test::quietwharf2::domain::Wharf.all()->project(
  [
    w|$w.wharfCode,
    w|$w.wharfName,
    w|$w.wardenName,
    w|$w.harbourCode
  ],
  [
    'WharfCode',
    'WharfName',
    'WardenName',
    'HarbourCode'
  ]
)->sort(
  [
    asc('WharfCode')
  ]
);
      tests:
      [
        bothQuaysOfTheHarbour:
        {
          doc: 'Both quays surface with the warden who keeps their berth register, so the reference table reached through the including database is shown to bind one row per wharf code with no milestoning of its own.';
          data:
          [
            test::quietwharf2::store::MooringStore: Reference
              #{
                test::quietwharf2::data::WharfTestData
              }#
          ];
          asserts:
          [
            wharfRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"WharfCode":"WH-1","WharfName":"Quiet Wharf North","WardenName":"Iris Calder","HarbourCode":"HB-1"},{"WharfCode":"WH-2","WharfName":"Slipway Basin","WardenName":"Owen Tarrant","HarbourCode":"HB-2"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
