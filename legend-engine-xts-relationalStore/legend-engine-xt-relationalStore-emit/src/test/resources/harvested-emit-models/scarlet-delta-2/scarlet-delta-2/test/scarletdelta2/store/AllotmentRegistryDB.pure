###Relational
Database test::scarletdelta2::store::AllotmentRegistryDB
(
  Schema allotments
  (
    Table plot_holding
    (
      milestoning
      (
        business(BUS_FROM = tenancy_from, BUS_THRU = tenancy_thru, INFINITY_DATE = %9999-12-31T00:00:00.000000+0000)
      )

      plot_code VARCHAR(20) PRIMARY KEY,
      season_year INTEGER PRIMARY KEY,
      plot_size_sqm DOUBLE,
      surveyed_at TIMESTAMP,
      warden_code VARCHAR(12),
      tenancy_from TIMESTAMP NOT NULL,
      tenancy_thru TIMESTAMP NOT NULL
    )

    Table warden_roster
    (
      warden_code VARCHAR(12) PRIMARY KEY,
      warden_name VARCHAR(120) NOT NULL,
      district_name VARCHAR(80) NOT NULL
    )
  )

  Join PlotHolding_WardenRoster
  (
    allotments.plot_holding.warden_code = allotments.warden_roster.warden_code
  )
)
