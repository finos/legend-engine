###Pure
Class {meta::pure::profiles::doc.doc = 'One walk of a butterfly transect, recorded either at dawn or at dusk; the two recording slots are held in separate relations and unioned by the mapping.'} test::tealmeadow3::domain::ButterflyWalk
{
  walkCode: String[1];
  transectName: String[1];
  speciesName: String[0..1];
  countedTotal: Integer[1];
  walkedOn: StrictDate[1];
}

Class {meta::pure::profiles::doc.doc = 'A butterfly species the transect walks record; mapped by the included base mapping rather than by the walk mapping.'} test::tealmeadow3::domain::MeadowSpecies
{
  speciesCode: String[1];
  speciesName: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A dawn walk read with its sky band and the butterfly family reached through the species and genus; its class mapping extends the dawn walk set.'} test::tealmeadow3::domain::DawnSurveyWalk extends test::tealmeadow3::domain::ButterflyWalk
{
  skyBand: String[0..1];
  familyName: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A dusk walk read with a recorded-sky flag and the butterfly family reached through the species and genus; its class mapping extends the dusk walk set.'} test::tealmeadow3::domain::DuskSurveyWalk extends test::tealmeadow3::domain::ButterflyWalk
{
  skyBand: String[0..1];
  familyName: String[0..1];
}
