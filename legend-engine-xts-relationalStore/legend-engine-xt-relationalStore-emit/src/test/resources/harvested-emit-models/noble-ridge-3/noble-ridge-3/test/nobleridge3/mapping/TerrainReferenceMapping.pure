###Mapping
Mapping test::nobleridge3::mapping::TerrainReferenceMapping
(
  *test::nobleridge3::domain::Region[region]: Relational
  {
    ~primaryKey
    (
      [test::nobleridge3::store::TrailNetworkDB]terrain.region.region_code
    )
    ~mainTable [test::nobleridge3::store::TrailNetworkDB]terrain.region
    regionCode: [test::nobleridge3::store::TrailNetworkDB]terrain.region.region_code,
    regionName: [test::nobleridge3::store::TrailNetworkDB]terrain.region.region_name,
    regionState: [test::nobleridge3::store::TrailNetworkDB]terrain.region.region_state
  }

  *test::nobleridge3::domain::StewardCrew[stewardCrew]: Relational
  {
    ~primaryKey
    (
      [test::nobleridge3::store::TrailNetworkDB]terrain.steward_crew.steward_code
    )
    ~mainTable [test::nobleridge3::store::TrailNetworkDB]terrain.steward_crew
    stewardCode: [test::nobleridge3::store::TrailNetworkDB]terrain.steward_crew.steward_code,
    crewName: [test::nobleridge3::store::TrailNetworkDB]terrain.steward_crew.crew_name,
    crewState: [test::nobleridge3::store::TrailNetworkDB]terrain.steward_crew.crew_state
  }
)
