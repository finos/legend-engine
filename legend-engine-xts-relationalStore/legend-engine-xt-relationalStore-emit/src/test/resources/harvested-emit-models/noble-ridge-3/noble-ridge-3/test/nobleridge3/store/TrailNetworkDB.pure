###Relational
Database test::nobleridge3::store::TrailNetworkDB
(
  Schema terrain
  (
    Table trail_segment
    (
      segment_code VARCHAR(24) PRIMARY KEY,
      head_code VARCHAR(24) NOT NULL,
      surface_code VARCHAR(24) NOT NULL,
      difficulty_code VARCHAR(16) NOT NULL,
      length_metres INTEGER NOT NULL
    )
    Table trail_head
    (
      head_code VARCHAR(24) PRIMARY KEY,
      head_name VARCHAR(60) NOT NULL,
      region_code VARCHAR(24) NOT NULL,
      access_state VARCHAR(16) NOT NULL
    )
    Table region
    (
      region_code VARCHAR(24) PRIMARY KEY,
      region_name VARCHAR(60) NOT NULL,
      region_state VARCHAR(16) NOT NULL
    )
    Table steward_crew
    (
      steward_code VARCHAR(24) PRIMARY KEY,
      crew_name VARCHAR(60) NOT NULL,
      region_code VARCHAR(24) NOT NULL,
      crew_state VARCHAR(16) NOT NULL
    )
  )

  Join Segment_Head
  (
    terrain.trail_segment.head_code = terrain.trail_head.head_code
      and terrain.trail_head.access_state = 'ACCESS-OPEN'
  )

  Join Head_Region
  (
    terrain.trail_head.region_code = terrain.region.region_code
      and terrain.region.region_state = 'REGION-ACTIVE'
  )

  Join Region_Steward
  (
    terrain.region.region_code = terrain.steward_crew.region_code
      and terrain.steward_crew.crew_state = 'CREW-ON-ROSTER'
  )
)
