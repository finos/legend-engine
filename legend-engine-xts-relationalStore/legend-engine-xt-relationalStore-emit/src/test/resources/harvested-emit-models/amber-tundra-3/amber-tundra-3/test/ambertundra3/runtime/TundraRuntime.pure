###Runtime
Runtime test::ambertundra3::runtime::TundraRuntime
{
  mappings:
  [
    test::ambertundra3::mapping::HerdMapping
  ];
  connections:
  [
    test::ambertundra3::store::TundraDB:
    [
      tundraField: test::ambertundra3::connection::TundraConnection
    ]
  ];
}

Runtime test::ambertundra3::runtime::TundraSurveyRuntime
{
  mappings:
  [
    test::ambertundra3::mapping::HerdMapping
  ];
  connections:
  [
    test::ambertundra3::store::TundraDB:
    [
      tundraSurvey: test::ambertundra3::connection::TundraSurveyConnection
    ]
  ];
}
