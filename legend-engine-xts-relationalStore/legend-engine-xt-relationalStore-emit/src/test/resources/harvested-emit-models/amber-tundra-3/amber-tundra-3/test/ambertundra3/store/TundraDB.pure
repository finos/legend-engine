###Relational
Database test::ambertundra3::store::TundraDB
(
  Schema tundra
  (
    Table caribou
    (
      animal_code VARCHAR(20) PRIMARY KEY,
      herd_name VARCHAR(50) NOT NULL,
      collar_status VARCHAR(10),
      first_seen DATE NOT NULL,
      last_seen DATE NOT NULL,
      collar_age_months INTEGER NOT NULL,
      range_code VARCHAR(20) NOT NULL
    )
    Table herd_range
    (
      range_code VARCHAR(20) PRIMARY KEY,
      range_name VARCHAR(80) NOT NULL,
      season_name VARCHAR(30) NOT NULL,
      latitude_band INTEGER NOT NULL
    )
  )

  Join Caribou_Range(tundra.caribou.range_code = tundra.herd_range.range_code)
)
