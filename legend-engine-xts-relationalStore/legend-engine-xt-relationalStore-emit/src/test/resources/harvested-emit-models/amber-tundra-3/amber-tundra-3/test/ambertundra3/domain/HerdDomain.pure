###Pure
Class test::ambertundra3::domain::Caribou
{
  animalCode: String[1];
  herdName: String[1];
  collarStatus: String[0..1];
  firstSeen: StrictDate[1];
  lastSeen: StrictDate[1];
  collarAgeMonths: Integer[1];
  statusLabel: String[0..1];
  travelLabel: String[0..1];
}

Class test::ambertundra3::domain::HerdRange
{
  rangeCode: String[1];
  rangeName: String[1];
  seasonName: String[1];
  latitudeBand: Integer[1];
}

Association test::ambertundra3::domain::CaribouRange
{
  ranges: test::ambertundra3::domain::HerdRange[*];
  caribou: test::ambertundra3::domain::Caribou[1];
}
