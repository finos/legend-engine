###Connection
RelationalDatabaseConnection test::ambertundra3::connection::TundraConnection
{
  store: test::ambertundra3::store::TundraDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists tundra;',
      'create schema tundra;',
      'create table tundra.caribou (animal_code varchar(20) primary key, herd_name varchar(50) not null, collar_status varchar(10), first_seen date not null, last_seen date not null, collar_age_months integer not null, range_code varchar(20) not null);',
      'create table tundra.herd_range (range_code varchar(20) primary key, range_name varchar(80) not null, season_name varchar(30) not null, latitude_band integer not null);'
      ];
  };
  auth: DefaultH2;
}

RelationalDatabaseConnection test::ambertundra3::connection::TundraSurveyConnection
{
  store: test::ambertundra3::store::TundraDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists tundra;',
      'create schema tundra;',
      'create table tundra.caribou (animal_code varchar(20) primary key, herd_name varchar(50) not null, collar_status varchar(10), first_seen date not null, last_seen date not null, collar_age_months integer not null, range_code varchar(20) not null);',
      'create table tundra.herd_range (range_code varchar(20) primary key, range_name varchar(80) not null, season_name varchar(30) not null, latitude_band integer not null);'
      ];
  };
  auth: DefaultH2;
}
