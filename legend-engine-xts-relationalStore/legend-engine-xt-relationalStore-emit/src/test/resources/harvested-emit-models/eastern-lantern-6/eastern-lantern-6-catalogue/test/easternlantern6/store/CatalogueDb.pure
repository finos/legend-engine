###Relational
Database test::easternlantern6::store::CatalogueDb
(
  Schema library
  (
    Table shelf_copy
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )

      copy_code VARCHAR(24) PRIMARY KEY,
      title_code VARCHAR(16) NOT NULL,
      branch_code VARCHAR(16) NOT NULL,
      format_code VARCHAR(16) NOT NULL,
      condition_code VARCHAR(16) NOT NULL,
      acquired_on DATE NOT NULL,
      replacement_cost DOUBLE NOT NULL,
      copy_units INTEGER NOT NULL,
      in_z DATE NOT NULL,
      out_z DATE NOT NULL
    )

    Table title_record
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )

      title_code VARCHAR(16) PRIMARY KEY,
      title_name VARCHAR(96) NOT NULL,
      subject_code VARCHAR(16) NOT NULL,
      language_code VARCHAR(16) NOT NULL,
      in_z DATE NOT NULL,
      out_z DATE NOT NULL
    )

    Table branch
    (
      branch_code VARCHAR(16) PRIMARY KEY,
      branch_name VARCHAR(96) NOT NULL,
      region_code VARCHAR(16) NOT NULL
    )
  )
)
