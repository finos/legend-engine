###Connection
RelationalDatabaseConnection test::russetquokka::connection::ReserveH2Connection
{
  store: test::russetquokka::store::ReserveDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists reserve cascade;',
      'create schema reserve;',
      'create table reserve.steward_zone (zone_id integer primary key, zone_name varchar(200) not null, steward_team varchar(120) not null);',
      'create table reserve.transect (transect_id integer primary key, transect_code varchar(60) not null, zone_id integer not null);',
      'create table reserve.burrow (burrow_id integer primary key, burrow_code varchar(60) not null, substrate varchar(60) not null, transect_id integer);',
      'create table reserve.colony_count (count_id integer, tag_code varchar(60) not null, individuals_counted integer not null, burrow_id integer not null, in_z date not null, out_z date not null, from_z date not null, thru_z date not null);'
      ];
  };
  auth: DefaultH2;
}
