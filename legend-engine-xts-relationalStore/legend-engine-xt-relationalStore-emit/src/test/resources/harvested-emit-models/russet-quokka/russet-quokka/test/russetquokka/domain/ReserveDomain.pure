###Pure
import test::russetquokka::domain::*;

Class {meta::pure::profiles::doc.doc = 'A stewardship zone of a coastal nature reserve.'} test::russetquokka::domain::StewardZone
{
  zoneName: String[1];
  stewardTeam: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A walked survey line laid out inside a stewardship zone.'} test::russetquokka::domain::Transect
{
  transectCode: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A single animal burrow entrance recorded along a survey line.'} test::russetquokka::domain::Burrow
{
  burrowCode: String[1];
  substrate: String[1];
  habitatLabel() {$this.burrowCode->toUpper() + ' / ' + $this.substrate}: String[1];
}

Class <<temporal.bitemporal>> {meta::pure::profiles::doc.doc = 'A headcount taken at a burrow, versioned on both the recording and the observation timeline.'} test::russetquokka::domain::ColonyCount
{
  tagCode: String[1];
  individualsCounted: Integer[1];
}

Association {meta::pure::profiles::doc.doc = 'Relates a headcount to the burrow it was taken at.'} test::russetquokka::domain::Burrow_ColonyCount
{
  burrow: Burrow[1];
  counts: ColonyCount[*];
}

Association {meta::pure::profiles::doc.doc = 'Relates a burrow to the survey line it sits on, which may not yet be assigned.'} test::russetquokka::domain::Transect_Burrow
{
  transect: Transect[0..1];
  burrows: Burrow[*];
}

Association {meta::pure::profiles::doc.doc = 'Relates a survey line to the stewardship zone that owns it.'} test::russetquokka::domain::StewardZone_Transect
{
  zone: StewardZone[1];
  transects: Transect[*];
}
