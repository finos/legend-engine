###Relational
Database test::russetquokka::store::ReserveDB
(
  Schema reserve
  (
    Table steward_zone
    (
      zone_id INTEGER PRIMARY KEY,
      zone_name VARCHAR(200) NOT NULL,
      steward_team VARCHAR(120) NOT NULL
    )
    Table transect
    (
      transect_id INTEGER PRIMARY KEY,
      transect_code VARCHAR(60) NOT NULL,
      zone_id INTEGER NOT NULL
    )
    Table burrow
    (
      burrow_id INTEGER PRIMARY KEY,
      burrow_code VARCHAR(60) NOT NULL,
      substrate VARCHAR(60) NOT NULL,
      transect_id INTEGER
    )
    Table colony_count
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z),
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      count_id INTEGER PRIMARY KEY,
      tag_code VARCHAR(60) NOT NULL,
      individuals_counted INTEGER NOT NULL,
      burrow_id INTEGER NOT NULL,
      in_z DATE NOT NULL,
      out_z DATE NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
  )

  Join Count_Burrow(reserve.colony_count.burrow_id = reserve.burrow.burrow_id)
  Join Burrow_Transect(reserve.burrow.transect_id = reserve.transect.transect_id)
  Join Transect_Zone(reserve.transect.zone_id = reserve.steward_zone.zone_id)
)
