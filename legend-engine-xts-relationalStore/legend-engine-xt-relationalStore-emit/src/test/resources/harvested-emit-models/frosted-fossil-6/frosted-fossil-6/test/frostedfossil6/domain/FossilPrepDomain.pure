###Pure
import test::frostedfossil6::domain::*;
import meta::pure::profiles::*;

Enum {doc.doc = 'Where a preparation ticket stands, resolved from the short stage code the bench log keeps.'} test::frostedfossil6::domain::PrepStage
{
  Intake,
  Active,
  Held,
  Closed
}

Enum {doc.doc = 'How hard the matrix around a specimen is, resolved from the short matrix code.'} test::frostedfossil6::domain::MatrixGrade
{
  Soft,
  Firm,
  Hard
}

Enum {doc.doc = 'How urgently a ticket is queued, computed rather than stored.'} test::frostedfossil6::domain::QueueBand
{
  Low,
  Medium,
  High
}

Class {doc.doc = 'A bench a preparation ticket is worked at.'} test::frostedfossil6::domain::PrepBench
{
  {doc.doc = 'Bench identifier.'} benchId: Integer[1];
  {doc.doc = 'Name of the bench.'} benchLabel: String[1];
}

Class {doc.doc = 'A region the quarries of the register sit in.'} test::frostedfossil6::domain::FieldRegion
{
  {doc.doc = 'Region identifier.'} regionId: Integer[1];
  {doc.doc = 'Name of the region.'} regionLabel: String[1];
}

Class {doc.doc = 'A quarry a formation was cut from.'} test::frostedfossil6::domain::QuarrySite
{
  {doc.doc = 'Quarry identifier.'} quarryId: Integer[1];
  {doc.doc = 'Name of the quarry.'} quarryLabel: String[1];
}

Class {doc.doc = 'A rock formation a specimen block belongs to.'} test::frostedfossil6::domain::RockFormation
{
  {doc.doc = 'Formation identifier.'} formationId: Integer[1];
  {doc.doc = 'Name of the formation.'} formationLabel: String[1];
}

Class {doc.doc = 'A catalogued block of matrix a specimen is embedded in.'} test::frostedfossil6::domain::SpecimenBlock
{
  {doc.doc = 'Block identifier.'} specimenId: Integer[1];
  {doc.doc = 'Code the catalogue holds the block under.'} blockCode: String[1];
  {doc.doc = 'Name of the block.'} blockLabel: String[1];
}

Class <<temporal.businesstemporal>> {doc.doc = 'One preparation ticket for a fossil block, versioned on the business timeline so a restated ticket closes its window rather than overwriting the earlier state, and reaching catalogue detail up to a four-hop path away.'} test::frostedfossil6::domain::PrepTicket
{
  {doc.doc = 'Code the bench log holds the ticket under.'} ticketCode: String[1];
  {doc.doc = 'Register the ticket belongs to, defaulted by the mapping.'} registerName: String[1];
  {doc.doc = 'Stage the ticket stands at, absent when the bench log carries a code the register does not know.'} prepStage: test::frostedfossil6::domain::PrepStage[0..1];
  {doc.doc = 'Hardness of the matrix around the specimen.'} matrixGrade: test::frostedfossil6::domain::MatrixGrade[0..1];
  {doc.doc = 'Grit step the preparator recorded.'} gritLevel: Integer[0..1];
  {doc.doc = 'Hours booked against the ticket.'} prepHours: Float[0..1];
  {doc.doc = 'Day the ticket was opened.'} openedOn: StrictDate[0..1];
  {doc.doc = 'Free note the preparator wrote onto the ticket.'} noteText: String[0..1];
  {doc.doc = 'Band the recorded grit step falls in, publishing no value once the step leaves the banded range.'} gritBand: String[0..1];
  {doc.doc = 'Label folded from the free note, published only for a note the register recognises.'} noteLabel: String[0..1];
  {doc.doc = 'Band the booked hours fall in.'} hoursBand: String[0..1];
  {doc.doc = 'Leading part of the trimmed note.'} noteStem: String[0..1];
  {doc.doc = 'Length of the trimmed note.'} noteSize: Integer[0..1];
  {doc.doc = 'Effort score fitted from the booked hours.'} effortScore: Float[0..1];
  {doc.doc = 'Name of the bench the ticket is worked at, reached over its own one-hop path.'} benchLabel: String[0..1];
  {doc.doc = 'Name of the specimen block, reached over one hop into the catalogue schema.'} blockLabel: String[0..1];
  {doc.doc = 'Name of the formation the block belongs to, reached over two hops.'} formationLabel: String[0..1];
  {doc.doc = 'Name of the quarry the formation was cut from, reached over three hops.'} quarryLabel: String[0..1];
  {doc.doc = 'Name of the region the quarry sits in, reached over the full four-hop path.'} regionLabel: String[0..1];
}

Class {doc.doc = 'A compact bench scan handed to the digest mapping, carrying only the raw values the digest computes its enumerations from.'} test::frostedfossil6::domain::PrepScan
{
  {doc.doc = 'Code of the scanned ticket.'} scanCode: String[1];
  {doc.doc = 'Stage text the scan carries.'} stageText: String[1];
  {doc.doc = 'Matrix reading the scan carries.'} matrixValue: Float[1];
  {doc.doc = 'Queue depth the scan carries.'} queueDepth: Integer[1];
}

Class {doc.doc = 'The digest of one bench scan, whose three enumerated properties are each resolved from a computed expression rather than a stored code.'} test::frostedfossil6::domain::PrepDigest
{
  {doc.doc = 'Code of the digested scan.'} digestCode: String[1];
  {doc.doc = 'Stage the digest computes.'} digestStage: test::frostedfossil6::domain::PrepStage[0..1];
  {doc.doc = 'Matrix grade the digest computes.'} digestGrade: test::frostedfossil6::domain::MatrixGrade[0..1];
  {doc.doc = 'Queue band the digest computes.'} digestBand: test::frostedfossil6::domain::QueueBand[0..1];
}
