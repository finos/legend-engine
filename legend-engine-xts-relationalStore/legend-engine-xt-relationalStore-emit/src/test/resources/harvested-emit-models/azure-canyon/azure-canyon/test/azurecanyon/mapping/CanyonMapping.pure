###Mapping
Mapping test::azurecanyon::mapping::CanyonMapping
(
  include test::azurecanyon::mapping::FormationMapping

  *test::azurecanyon::domain::RockLayer[layer]: Relational
  {
    ~primaryKey
    (
      [test::azurecanyon::store::CanyonDB]canyon.rock_layer.layer_id
    )
    ~mainTable [test::azurecanyon::store::CanyonDB]canyon.rock_layer
    name: [test::azurecanyon::store::CanyonDB]canyon.rock_layer.layer_name,
    thicknessM: [test::azurecanyon::store::CanyonDB]canyon.rock_layer.thickness_m
  }

  test::azurecanyon::domain::Formation_Layer: Relational
  {
    AssociationMapping
    (
      formation[layer, formation]: [test::azurecanyon::store::CanyonDB]@Layer_Formation,
      layers[formation, layer]: [test::azurecanyon::store::CanyonDB]@Layer_Formation
    )
  }

  testSuites:
  [
    layerAsOfSuite:
    {
      function: |test::azurecanyon::domain::RockLayer.all(%2023-06-01, %2023-06-01)->project(
  [
    x|$x.name,
    x|$x.thicknessM,
    x|$x.formation.name
  ],
  [
    'Layer',
    'ThicknessM',
    'Formation'
  ]
);
      tests:
      [
        layersAsOfMidYear:
        {
          doc: 'Bitemporal point-in-time projection of a rock layer with its formation, exercising the relational association mapping across the Layer_Formation join.';
          data:
          [
            test::azurecanyon::store::CanyonDB:
              Relational
              #{
                canyon.formation:
                  'formation_id,formation_name\n'+
                  '1,Sunset Sandstone\n';
                canyon.rock_layer:
                  'layer_id,layer_name,thickness_m,formation_id,in_z,out_z,from_z,thru_z\n'+
                  '1,Ochre Band,12.5,1,2023-01-01,9999-12-31,2023-01-01,9999-12-31\n';
              }#
          ];
          asserts:
          [
            oneRow:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Layer":"Ochre Band","ThicknessM":12.5,"Formation":"Sunset Sandstone"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
