Class {meta::pure::profiles::doc.doc = 'A named geological formation exposed in a canyon wall.'} test::azurecanyon::domain::Formation
{
  name: String[1];
}

Class <<temporal.bitemporal>> {meta::pure::profiles::doc.doc = 'A rock layer whose measured thickness is tracked bitemporally.'} test::azurecanyon::domain::RockLayer
{
  name: String[1];
  thicknessM: Float[1];
}

Association {meta::pure::profiles::doc.doc = 'Associates a formation with the rock layers it contains.'} test::azurecanyon::domain::Formation_Layer
{
  formation: test::azurecanyon::domain::Formation[1];
  layers: test::azurecanyon::domain::RockLayer[*];
}
