###Relational
Database test::azurecanyon::store::CanyonDB
(
  Schema canyon
  (
    Table formation
    (
      formation_id INTEGER PRIMARY KEY,
      formation_name VARCHAR(200) NOT NULL
    )
    Table rock_layer
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z),
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      layer_id INTEGER PRIMARY KEY,
      layer_name VARCHAR(200) NOT NULL,
      thickness_m DOUBLE NOT NULL,
      formation_id INTEGER NOT NULL,
      in_z DATE NOT NULL,
      out_z DATE NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
  )

  Join Layer_Formation(canyon.rock_layer.formation_id = canyon.formation.formation_id)
)
