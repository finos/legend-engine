###Connection
RelationalDatabaseConnection test::azurecanyon::connection::CanyonH2Connection
{
  store: test::azurecanyon::store::CanyonDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists canyon;',
      'create schema canyon;',
      'create table canyon.formation (formation_id integer primary key, formation_name varchar(200) not null);',
      'create table canyon.rock_layer (layer_id integer, layer_name varchar(200) not null, thickness_m double not null, formation_id integer not null, in_z date not null, out_z date not null, from_z date not null, thru_z date not null);',
      'insert into canyon.formation values (1, \'Sunset Sandstone\');',
      'insert into canyon.rock_layer values (1, \'Ochre Band\', 12.5, 1, DATE \'2023-01-01\', DATE \'9999-12-31\', DATE \'2023-01-01\', DATE \'9999-12-31\');'
      ];
  };
  auth: DefaultH2;
}
