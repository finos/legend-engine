###Service
Service test::frostedlighthouse4::service::LotHouseRankFeed
{
  pattern: '/frostedlighthouse/v1/lotHouseRank/{stage}';
  title: 'Frosted Lighthouse - Lot House Rank';
  owners:
  [
    'nursery-propagation-desk',
    'nursery-quality-review'
  ];
  documentation: 'Ranks the graded lots of each glasshouse by germination rate with a window function computed over the projected rows, partitioned by glasshouse so the numbering restarts per partition.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {stage: String[1]|test::frostedlighthouse4::domain::SeedLot.all()->filter(x|($x.statusCode == $stage) && ($x.germinationPct->isNotEmpty()))->project([x|$x.houseCode, x|$x.lotCode, x|$x.germinationPct->toOne()], ['HouseCode', 'LotCode', 'GerminationPct'])->olapGroupBy(['HouseCode'], desc('GerminationPct'), w|$w->rowNumber(), 'HouseRank')->sort([asc('HouseCode'), asc('HouseRank')])};
    mapping: test::frostedlighthouse4::mapping::NurseryLotMapping;
    runtime: test::frostedlighthouse4::runtime::NurseryLotRuntime;
  }
  testSuites:
  [
    lotHouseRankSuite:
    {
      data:
      [
        connections:
        [
          nurseryLotConnection:
            Relational
            #{
              nursery.seed_lot:
                'lot_id,lot_code,species_code,house_code,status_code,tray_count,germination_pct,sown_on,graded_at,batch_note\n'+
                '1,LT-0001,SP-ACER,GH-01,GRADED,48,92.5,2026-01-05,2026-02-01 09:15:00,first flush strong\n'+
                '2,LT-0002,SP-BETU,GH-01,GRADED,36,78.25,2026-01-12,2026-02-02 09:30:00,\n'+
                '3,LT-0003,SP-CORY,GH-02,SOWN,24,,2026-01-19,,awaiting first count\n'+
                '4,LT-0004,SP-ACER,GH-02,GRADED,60,64.0,2026-01-26,2026-02-05 10:00:00,thinned tray\n'+
                '5,LT-0005,SP-QUER,GH-03,DISCARDED,12,4.5,2026-02-02,2026-02-09 11:45:00,damping off\n'+
                '6,LT-0006,SP-TILI,GH-03,GRADED,30,88.75,2026-02-09,2026-02-16 08:20:00,\n';
            }#
        ]
      ]
      tests:
      [
        plannedAndExecuted:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            stage = 'GRADED'
          ]
          asserts:
          [
            projectedRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"HouseCode":"GH-01","LotCode":"LT-0001","GerminationPct":92.5,"HouseRank":1},{"HouseCode":"GH-01","LotCode":"LT-0002","GerminationPct":78.25,"HouseRank":2},{"HouseCode":"GH-02","LotCode":"LT-0004","GerminationPct":64.0,"HouseRank":1},{"HouseCode":"GH-03","LotCode":"LT-0006","GerminationPct":88.75,"HouseRank":1}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
