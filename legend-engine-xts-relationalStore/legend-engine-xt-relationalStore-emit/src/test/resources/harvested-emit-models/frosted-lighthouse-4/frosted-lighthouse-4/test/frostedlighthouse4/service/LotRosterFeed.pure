###Service
Service test::frostedlighthouse4::service::LotRosterFeed
{
  pattern: '/frostedlighthouse/v1/lotRoster/{house}/{stage}';
  title: 'Frosted Lighthouse - Seed Lot Roster';
  owners:
  [
    'nursery-propagation-desk'
  ];
  documentation: 'Filters the propagation lots of one glasshouse at one grading stage through a deeply nested boolean predicate that composes equality, set membership, a null-tolerant germination test and a code-prefix fallback, then projects the surviving lots as a tabular data set.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {house: String[1], stage: String[1]|test::frostedlighthouse4::domain::SeedLot.all()->filter(x|($x.houseCode == $house) && (($x.statusCode == $stage) && (($x.speciesCode->in(['SP-ACER', 'SP-BETU', 'SP-CORY', 'SP-QUER', 'SP-TILI', 'SP-FAGU'])) && ((($x.trayCount >= 12) && ($x.germinationPct->isEmpty() || ($x.germinationPct->toOne() >= 50.0))) || ($x.lotCode->toUpper()->startsWith('LT-'))))))->project([x|$x.lotId, x|$x.lotCode, x|$x.speciesCode, x|$x.statusCode, x|$x.trayCount, x|$x.germinationPct], ['LotId', 'LotCode', 'SpeciesCode', 'StatusCode', 'TrayCount', 'GerminationPct'])->sort([asc('LotId')])};
    mapping: test::frostedlighthouse4::mapping::NurseryLotMapping;
    runtime: test::frostedlighthouse4::runtime::NurseryLotRuntime;
  }
  testSuites:
  [
    lotRosterSuite:
    {
      data:
      [
        connections:
        [
          nurseryLotConnection:
            Relational
            #{
              nursery.seed_lot:
                'lot_id,lot_code,species_code,house_code,status_code,tray_count,germination_pct,sown_on,graded_at,batch_note\n'+
                '1,LT-0001,SP-ACER,GH-01,GRADED,48,92.5,2026-01-05,2026-02-01 09:15:00,first flush strong\n'+
                '2,LT-0002,SP-BETU,GH-01,GRADED,36,78.25,2026-01-12,2026-02-02 09:30:00,\n'+
                '3,LT-0003,SP-CORY,GH-02,SOWN,24,,2026-01-19,,awaiting first count\n'+
                '4,LT-0004,SP-ACER,GH-02,GRADED,60,64.0,2026-01-26,2026-02-05 10:00:00,thinned tray\n'+
                '5,LT-0005,SP-QUER,GH-03,DISCARDED,12,4.5,2026-02-02,2026-02-09 11:45:00,damping off\n'+
                '6,LT-0006,SP-TILI,GH-03,GRADED,30,88.75,2026-02-09,2026-02-16 08:20:00,\n';
            }#
        ]
      ]
      tests:
      [
        plannedAndExecuted:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            house = 'GH-01',
            stage = 'GRADED'
          ]
          asserts:
          [
            projectedRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"LotId":1,"LotCode":"LT-0001","SpeciesCode":"SP-ACER","StatusCode":"GRADED","TrayCount":48,"GerminationPct":92.5},{"LotId":2,"LotCode":"LT-0002","SpeciesCode":"SP-BETU","StatusCode":"GRADED","TrayCount":36,"GerminationPct":78.25}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
