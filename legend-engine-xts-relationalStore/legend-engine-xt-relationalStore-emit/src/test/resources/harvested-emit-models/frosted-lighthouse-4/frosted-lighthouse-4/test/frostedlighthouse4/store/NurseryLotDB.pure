###Relational
Database test::frostedlighthouse4::store::NurseryLotDB
(
  Schema nursery
  (
    Table seed_lot
    (
      lot_id BIGINT PRIMARY KEY,
      lot_code VARCHAR(24),
      species_code VARCHAR(12),
      house_code VARCHAR(12),
      status_code VARCHAR(16),
      tray_count INTEGER,
      germination_pct DOUBLE,
      sown_on DATE,
      graded_at TIMESTAMP,
      batch_note VARCHAR(240)
    )
  )
)
