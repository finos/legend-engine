import demo::crimsonaviary::domain::*;

Enum demo::crimsonaviary::domain::PlumageStage
{
  HATCHLING,
  FLEDGLING,
  JUVENILE,
  ADULT
}

Class <<meta::pure::profiles::temporal.businesstemporal>> demo::crimsonaviary::domain::FlightEnclosure
{
  enclosureCode: String[1];
  enclosureName: String[1];
  canopyHeightMetres: Float[1];
  canopyBand()
  {
    if($this.canopyHeightMetres >= 11.0,
       | 'tall-canopy',
       | 'low-canopy')
  }: String[1];
}

Class <<meta::pure::profiles::temporal.businesstemporal>> demo::crimsonaviary::domain::BirdCohort
{
  cohortCode: String[1];
  speciesName: String[1];
  ringSeries: Float[1];
  fledglingCount: Integer[1];
  broodSize: Integer[0..1];
  stage: PlumageStage[1];
  cohortLabel()
  {
    $this.cohortCode->toUpper() + '/' + $this.speciesName->trim()->toLower() + '/' + $this.fledglingCount->toString()
  }: String[1];
  broodBand()
  {
    if($this.broodSize->isEmpty(),
       | 'unrecorded',
       | if($this.broodSize->toOne() >= 6,
            | 'large-brood',
            | 'small-brood'))
  }: String[1];
}

Association demo::crimsonaviary::domain::Enclosure_Cohorts
{
  enclosure: FlightEnclosure[1];
  cohorts: BirdCohort[*];
}
