###Relational
Database demo::crimsonaviary::store::AviaryDb
(
  Schema aviary
  (
    Table flight_enclosure
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z, INFINITY_DATE = %9999-12-31T00:00:00.000000+0000)
      )

      enclosure_code VARCHAR(20) PRIMARY KEY,
      enclosure_name VARCHAR(120) NOT NULL,
      canopy_height_m DOUBLE NOT NULL,
      from_z TIMESTAMP NOT NULL,
      thru_z TIMESTAMP NOT NULL
    )

    Table bird_cohort
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z, INFINITY_DATE = %9999-12-31T00:00:00.000000+0000)
      )

      cohort_code VARCHAR(20) PRIMARY KEY,
      species_name VARCHAR(120) NOT NULL,
      ring_series DOUBLE NOT NULL,
      fledgling_count INTEGER NOT NULL,
      brood_size INTEGER,
      stage_code VARCHAR(10) NOT NULL,
      enclosure_code VARCHAR(20) NOT NULL,
      from_z TIMESTAMP NOT NULL,
      thru_z TIMESTAMP NOT NULL
    )
  )

  Join Cohort_Enclosure(aviary.bird_cohort.enclosure_code = aviary.flight_enclosure.enclosure_code)
)
