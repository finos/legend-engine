###Mapping
Mapping test::noblefossil::mapping::SeedVaultMapping
(
  *test::noblefossil::domain::SeedLot[seedLot]: Relational
  {
    ~primaryKey
    (
      [test::noblefossil::store::SeedVaultDB]vault.seed_lot.lot_code
    )
    ~mainTable [test::noblefossil::store::SeedVaultDB]vault.seed_lot
    lotCode: [test::noblefossil::store::SeedVaultDB]vault.seed_lot.lot_code,
    speciesName: [test::noblefossil::store::SeedVaultDB]vault.seed_lot.species_name,
    viabilityPct: [test::noblefossil::store::SeedVaultDB]vault.seed_lot.viability_pct
  }

  testSuites:
  [
    seedLotSuite:
    {
      function: |test::noblefossil::domain::SeedLot.all(%2026-06-01)->project(
        [
          l|$l.lotCode,
          l|$l.speciesName,
          l|$l.viabilityPct
        ],
        [
          'Lot',
          'Species',
          'Viability'
        ]
      )->sort([asc('Lot')]);
      tests:
      [
        activeAsOfBusinessDate:
        {
          doc: 'Projects the seed lots whose business validity window contains the requested business date; the retired lot whose window closed before that date is the milestoning out-of-range row and is excluded.';
          data:
          [
            test::noblefossil::store::SeedVaultDB:
              Relational
              #{
                vault.seed_lot:
                  'lot_code,species_name,viability_pct,valid_from,valid_thru\n'+
                  'SL-100,Silphium laciniatum,88,2026-01-01 00:00:00.000,9999-12-31 00:00:00.000\n'+
                  'SL-200,Asclepias tuberosa,54,2024-01-01 00:00:00.000,2025-01-01 00:00:00.000\n';
              }#
          ];
          asserts:
          [
            rows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Lot":"SL-100","Species":"Silphium laciniatum","Viability":88}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
