###Relational
Database test::noblefossil::store::SeedVaultDB
(
  Schema vault
  (
    Table seed_lot
    (
      milestoning
      (
        business(BUS_FROM = valid_from, BUS_THRU = valid_thru, INFINITY_DATE = %9999-12-31T00:00:00.000000+0000)
      )

      lot_code VARCHAR(24) PRIMARY KEY,
      species_name VARCHAR(128),
      viability_pct INTEGER,
      valid_from TIMESTAMP NOT NULL,
      valid_thru TIMESTAMP NOT NULL
    )
  )
)
