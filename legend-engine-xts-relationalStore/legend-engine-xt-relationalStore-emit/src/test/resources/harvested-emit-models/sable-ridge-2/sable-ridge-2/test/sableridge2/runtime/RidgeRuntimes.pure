###Runtime
Runtime test::sableridge2::runtime::RidgeSummitRuntime
{
  mappings:
  [
    test::sableridge2::mapping::RidgeMapping
  ];
  connections:
  [
    test::sableridge2::store::RidgeDB:
    [
      summitConnection: test::sableridge2::connection::RidgeSummitConnection
    ]
  ];
}

Runtime test::sableridge2::runtime::RidgeValleyRuntime
{
  mappings:
  [
    test::sableridge2::mapping::RidgeMapping
  ];
  connections:
  [
    test::sableridge2::store::RidgeDB:
    [
      valleyConnection: test::sableridge2::connection::RidgeValleyConnection
    ]
  ];
}
