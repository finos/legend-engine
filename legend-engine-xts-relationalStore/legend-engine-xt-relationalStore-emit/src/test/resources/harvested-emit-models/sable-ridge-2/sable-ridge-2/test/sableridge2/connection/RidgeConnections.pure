###Connection
RelationalDatabaseConnection test::sableridge2::connection::RidgeSummitConnection
{
  store: test::sableridge2::store::RidgeDB;
  type: DB2;
  specification: Static
  {
    name: 'EXAMPLE_RIDGE_SUMMIT_DB';
    host: 'example-ridge-summit-host';
    port: 50000;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'ridgesummitprincipal';
  };
}

RelationalDatabaseConnection test::sableridge2::connection::RidgeValleyConnection
{
  store: test::sableridge2::store::RidgeDB;
  type: DB2;
  quoteIdentifiers: false;
  specification: Static
  {
    name: 'EXAMPLE_RIDGE_VALLEY_DB';
    host: 'example-ridge-valley-host';
    port: 50001;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'ridgevalleyprincipal';
  };
}
