###Service
Service test::sableridge2::service::HutClassBoard
{
  pattern: '/sableridge/v1/hut-class-board/{environment}/{segmentCode}';
  title: 'Sable Ridge - Hut Class Board';
  documentation: 'Graph-fetches the huts on the requested trail segment, keyed so the summit and valley stores answer the same shape.';
  autoActivateUpdates: false;
  execution: Multi
  {
    query: segmentCode: String[1]|test::sableridge2::domain::MountainHut.all()->filter(h|$h.segment.segmentCode == $segmentCode->toUpper())->graphFetch(
      #{
        test::sableridge2::domain::MountainHut
        {
          hutCode,
          hutName,
          hutClass,
          elevationM,
          segment
          {
            segmentCode,
            segmentName,
            grade
          }
        }
      }#
    )->serialize(
      #{
        test::sableridge2::domain::MountainHut
        {
          hutCode,
          hutName,
          hutClass,
          elevationM,
          segment
          {
            segmentCode,
            segmentName,
            grade
          }
        }
      }#
    );
    key: 'environment';
    executions['summit']:
    {
      mapping: test::sableridge2::mapping::RidgeMapping;
      runtime: test::sableridge2::runtime::RidgeSummitRuntime;
    }
    executions['valley']:
    {
      mapping: test::sableridge2::mapping::RidgeMapping;
      runtime: test::sableridge2::runtime::RidgeValleyRuntime;
    }
  }
}
