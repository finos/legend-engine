Class {meta::pure::profiles::doc.doc = 'A swimming area of a public pool, carrying the lanes it can offer and the label the timetable prints for it.'} test::tealprairie4::domain::PoolArea
{
  areaCode: String[1];
  areaLabel: String[1];
  laneCount: Integer[1];
  areaTag: String[1];
  siteLabel: String[1];
  openedOn: StrictDate[1];
}

Class {meta::pure::profiles::doc.doc = 'One bookable lane slot of a swimming area on one day.'} test::tealprairie4::domain::LaneSlot
{
  slotCode: String[1];
  areaCode: String[1];
  laneNumber: Integer[1];
  slotState: String[1];
  venueKind: String[1];
  startsOn: StrictDate[1];
}

Class {meta::pure::profiles::doc.doc = 'One swimmer holding one lane slot.'} test::tealprairie4::domain::LaneBooking
{
  bookingCode: String[1];
  slotCode: String[1];
  swimmerLabel: String[1];
  bookingTag: String[1];
  bookedOn: StrictDate[1];
}
