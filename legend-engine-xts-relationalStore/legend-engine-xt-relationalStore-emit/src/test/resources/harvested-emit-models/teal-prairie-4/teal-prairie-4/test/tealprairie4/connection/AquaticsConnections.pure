###Connection
RelationalDatabaseConnection test::tealprairie4::connection::AquaticsPrimaryConnection
{
  store: test::tealprairie4::store::AquaticsDb;
  type: DB2;
  specification: Static
  {
    name: 'EXAMPLE_AQUATICS_TIMETABLE_DB';
    host: 'example-aquatics-primary-host';
    port: 50000;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'aquaticstimetableprimaryprincipal';
  };
}

RelationalDatabaseConnection test::tealprairie4::connection::AquaticsArchiveConnection
{
  store: test::tealprairie4::store::AquaticsDb;
  type: DB2;
  specification: Static
  {
    name: 'EXAMPLE_AQUATICS_TIMETABLE_ARCHIVE_DB';
    host: 'example-aquatics-archive-host';
    port: 50000;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'aquaticstimetablearchiveprincipal';
  };
}
