###Service
Service test::gildedvineyard7::service::PruningPassRegisterMulti
{
  pattern: '/vineyard/v1/pruning-multi';
  title: 'Gilded Vineyard - Open pruning register (multi-environment)';
  owners:
  [
    'vineyard-operations-platform',
    'pruning-crew-eng'
  ];
  documentation: 'Multi-execution register of the pruning passes still in play, resolving an environment-keyed mapping and runtime binding at execution time. It projects the parcel and state of each such pass, de-duplicates the pairs and caps the extract.';
  autoActivateUpdates: true;
  execution: Multi
  {
    query: {|test::gildedvineyard7::domain::PruningPass.all()->filter(
      p|$p.passStatus->in(['OPEN', 'ACTIVE'])
    )->project(
      [
        p|$p.parcelCode,
        p|$p.passStatus
      ],
      [
        'Parcel',
        'Status'
      ]
    )->distinct()->sort(
      [
        asc('Parcel'),
        asc('Status')
      ]
    )->limit(50)};
    key: 'env';
    executions['primary']:
    {
      mapping: test::gildedvineyard7::mapping::VineyardMapping;
      runtime: test::gildedvineyard7::runtime::VineyardRuntime;
    }
    executions['standby']:
    {
      mapping: test::gildedvineyard7::mapping::VineyardMapping;
      runtime: test::gildedvineyard7::runtime::VineyardRuntime;
    }
  }
}

Service test::gildedvineyard7::service::PruningPassRegister
{
  pattern: '/vineyard/v1/pruning';
  title: 'Gilded Vineyard - Open pruning register';
  owners:
  [
    'vineyard-operations-platform',
    'pruning-crew-eng'
  ];
  documentation: 'Single-execution counterpart carrying the tested suite. It keeps the passes whose state is in the working set, projects the parcel and state pairs and orders the de-duplicated result.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {|test::gildedvineyard7::domain::PruningPass.all()->filter(
      p|$p.passStatus->in(['OPEN', 'ACTIVE'])
    )->project(
      [
        p|$p.parcelCode,
        p|$p.passStatus
      ],
      [
        'Parcel',
        'Status'
      ]
    )->distinct()->sort(
      [
        asc('Parcel'),
        asc('Status')
      ]
    )->limit(50)};
    mapping: test::gildedvineyard7::mapping::VineyardMapping;
    runtime: test::gildedvineyard7::runtime::VineyardRuntime;
  }
  testSuites:
  [
    pruningPassRegisterSuite:
    {
      data:
      [
        connections:
        [
          vineyardConnection:
            Relational
            #{
              vineyard.pruning_pass:
                'pass_id,block_code,parcel_code,pass_status,cane_count,hours_logged,crew_lead\n'+
                '1,BLK-01,PAR-NORTH,OPEN,120,6,LEAD-ASH\n'+
                '2,BLK-02,PAR-NORTH,ACTIVE,90,4,LEAD-ASH\n'+
                '3,BLK-03,PAR-NORTH,CLOSED,0,0,LEAD-ASH\n'+
                '4,BLK-04,PAR-SOUTH,OPEN,140,8,LEAD-BIRCH\n'+
                '5,BLK-05,PAR-NORTH,OPEN,110,5,LEAD-BIRCH\n';
            }#
        ]
      ]
      tests:
      [
        repeatedParcelStatePairsCollapse:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            threeDistinctPairs:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Parcel":"PAR-NORTH","Status":"ACTIVE"},{"Parcel":"PAR-NORTH","Status":"OPEN"},{"Parcel":"PAR-SOUTH","Status":"OPEN"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
