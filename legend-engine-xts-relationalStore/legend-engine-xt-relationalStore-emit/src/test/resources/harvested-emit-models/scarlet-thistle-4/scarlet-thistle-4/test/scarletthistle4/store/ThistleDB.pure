###Relational
Database test::scarletthistle4::store::ThistleDB
(
  Schema trail
  (
    Table contact
    (
      contact_code VARCHAR(24) PRIMARY KEY,
      contact_name VARCHAR(120) NOT NULL,
      subscription_code VARCHAR(24)
    )
    Table subscription
    (
      subscription_code VARCHAR(24) PRIMARY KEY,
      program_name VARCHAR(120) NOT NULL,
      region_code VARCHAR(16) NOT NULL,
      cadence_code VARCHAR(16) NOT NULL,
      tier_code VARCHAR(16) NOT NULL,
      channel_code VARCHAR(16) NOT NULL
    )
    Table offering
    (
      offering_code VARCHAR(24) PRIMARY KEY,
      subscription_code VARCHAR(24) NOT NULL,
      offering_name VARCHAR(120) NOT NULL
    )
  )

  Join Contact_Subscription(trail.contact.subscription_code = trail.subscription.subscription_code)
  Join Subscription_Offering(trail.subscription.subscription_code = trail.offering.subscription_code)
)
