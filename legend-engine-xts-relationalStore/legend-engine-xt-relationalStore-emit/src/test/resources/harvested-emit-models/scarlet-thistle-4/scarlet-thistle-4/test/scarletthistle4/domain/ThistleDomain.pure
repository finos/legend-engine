import test::scarletthistle4::domain::*;

Class {meta::pure::profiles::doc.doc = 'One volunteer contact on the trail register. Only the code and the display name are held here; every other published attribute of a contact is reached through the subscription association.'} test::scarletthistle4::domain::TrailContact
{
  contactCode: String[1];
  contactName: String[1];
}

Class {meta::pure::profiles::doc.doc = 'The programme subscription a contact holds. It supplies five of the seven published grouping keys, and is optional because a contact may be registered before a programme has been allocated to it.'} test::scarletthistle4::domain::TrailSubscription
{
  subscriptionCode: String[1];
  programName: String[1];
  regionCode: String[1];
  cadenceCode: String[1];
  tierCode: String[1];
  channelCode: String[1];
}

Class {meta::pure::profiles::doc.doc = 'One offering published under a subscription. A subscription may carry several offerings or none at all, so the folded digest of offering names collapses a collection whose size is not fixed.'} test::scarletthistle4::domain::TrailOffering
{
  offeringCode: String[1];
  offeringName: String[1];
}

Association test::scarletthistle4::domain::ContactSubscription
{
  subscription: TrailSubscription[0..1];
  subscribedContacts: TrailContact[*];
}

Association test::scarletthistle4::domain::SubscriptionOffering
{
  offerings: TrailOffering[*];
  offeredSubscriptions: TrailSubscription[*];
}
