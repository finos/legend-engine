###Relational
Database test::gildedthicket::store::CanopyStore
(
  include test::gildedthicket::store::GreenwayStore

  Schema survey
  (
    Table street_block
    (
      block_id INTEGER PRIMARY KEY,
      block_code VARCHAR(24) NOT NULL,
      ward_id INTEGER NOT NULL,
      surface_code VARCHAR(8) NOT NULL,
      street_label VARCHAR(120) NOT NULL
    )
    Table street_tree
    (
      tree_id INTEGER PRIMARY KEY,
      tree_code VARCHAR(24) NOT NULL,
      species_code VARCHAR(24) NOT NULL,
      block_id INTEGER NOT NULL
    )
    Table canopy_survey
    (
      survey_id INTEGER PRIMARY KEY,
      survey_code VARCHAR(24),
      tree_id INTEGER NOT NULL,
      condition_code VARCHAR(8),
      crown_code VARCHAR(8) NOT NULL,
      care_code VARCHAR(8) NOT NULL,
      spread_m DOUBLE NOT NULL,
      note_text VARCHAR(240)
    )
    Table canopy_survey_archive
    (
      survey_id INTEGER PRIMARY KEY,
      survey_code VARCHAR(24) NOT NULL,
      tree_id INTEGER NOT NULL,
      spread_m DOUBLE NOT NULL
    )

    View block_canopy_vw
    (
      block_id: survey.street_block.block_id PRIMARY KEY,
      block_code: survey.street_block.block_code,
      surface_code: survey.street_block.surface_code,
      ward_name: [test::gildedthicket::store::CanopyStore]@Block_Ward | [test::gildedthicket::store::GreenwayStore]arbor.ward.ward_name
    )
  )

  Join Survey_Tree(survey.canopy_survey.tree_id = survey.street_tree.tree_id)

  Join Tree_Block(survey.street_tree.block_id = survey.street_block.block_id)

  Join Block_Ward(survey.street_block.ward_id = [test::gildedthicket::store::GreenwayStore]arbor.ward.ward_id)

  Join Ward_District([test::gildedthicket::store::GreenwayStore]arbor.ward.district_id = [test::gildedthicket::store::GreenwayStore]arbor.district.district_id)

  Join District_Borough([test::gildedthicket::store::GreenwayStore]arbor.district.borough_id = [test::gildedthicket::store::GreenwayStore]arbor.borough.borough_id)

  Join Tree_BlockView(survey.street_tree.block_id = survey.block_canopy_vw.block_id)

  Filter SurveyCoded(survey.canopy_survey.survey_code != '')
)
