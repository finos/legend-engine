###Pure
import test::gildedthicket::domain::*;

Enum test::gildedthicket::domain::ConditionGrade
{
  THRIVING,
  STABLE,
  STRESSED,
  DECLINING
}

Enum test::gildedthicket::domain::CrownForm
{
  BROAD,
  COLUMNAR,
  WEEPING
}

Enum test::gildedthicket::domain::SurfaceType
{
  PAVED,
  GRASS,
  MULCH
}

Enum test::gildedthicket::domain::CareTier
{
  PRIORITY,
  ROUTINE,
  WATCH
}

Class {meta::pure::profiles::doc.doc = 'Where a surveyed street tree stands, folded into the survey record itself.'} test::gildedthicket::domain::SurveyLocation
{
  blockCode: String[1];
  streetLabel: String[1];
}

Class {meta::pure::profiles::doc.doc = 'One canopy inspection of a street tree on a municipal greenway.'} test::gildedthicket::domain::CanopySurvey
{
  surveyCode: String[1];
  spreadMetres: Float[1];
  conditionBand: String[0..1];
  noteLabel: String[0..1];
  conditionGrade: ConditionGrade[0..1];
  crownForm: CrownForm[0..1];
  surfaceType: SurfaceType[0..1];
  careTier: CareTier[0..1];
  boroughName: String[0..1];
  blockWardName: String[0..1];
  location: SurveyLocation[1];
}

Class {meta::pure::profiles::doc.doc = 'A survey entry surfaced from either the live register or the retired archive.'} test::gildedthicket::domain::SurveyEntry
{
  entryCode: String[1];
  sourceTag: String[1];
  spreadMetres: Float[1];
}

Class {meta::pure::profiles::doc.doc = 'An administrative ward of the greenway network.'} test::gildedthicket::domain::Ward
{
  wardCode: String[1];
  wardName: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A planning district grouping greenway wards.'} test::gildedthicket::domain::District
{
  districtCode: String[1];
  districtName: String[1];
}
