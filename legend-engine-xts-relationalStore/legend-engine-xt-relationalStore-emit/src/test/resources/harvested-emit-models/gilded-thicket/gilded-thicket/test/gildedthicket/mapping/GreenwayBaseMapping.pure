###Mapping
Mapping test::gildedthicket::mapping::GreenwayBaseMapping
(
  *test::gildedthicket::domain::Ward[ward]: Relational
  {
    ~primaryKey
    (
      [test::gildedthicket::store::GreenwayStore]arbor.ward.ward_id
    )
    ~mainTable [test::gildedthicket::store::GreenwayStore]arbor.ward
    wardCode: [test::gildedthicket::store::GreenwayStore]arbor.ward.ward_code,
    wardName: [test::gildedthicket::store::GreenwayStore]arbor.ward.ward_name
  }

  *test::gildedthicket::domain::District[district]: Relational
  {
    ~primaryKey
    (
      [test::gildedthicket::store::GreenwayStore]arbor.district.district_id
    )
    ~mainTable [test::gildedthicket::store::GreenwayStore]arbor.district
    districtCode: [test::gildedthicket::store::GreenwayStore]arbor.district.district_code,
    districtName: [test::gildedthicket::store::GreenwayStore]arbor.district.district_name
  }
)
