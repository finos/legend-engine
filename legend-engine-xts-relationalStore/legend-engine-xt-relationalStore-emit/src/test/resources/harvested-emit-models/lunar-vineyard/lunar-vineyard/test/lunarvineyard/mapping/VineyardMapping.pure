###Mapping
Mapping demo::lunarvineyard::mapping::VineyardMapping
(
  *demo::lunarvineyard::domain::VineBlock[vineBlock]: Relational
  {
    ~primaryKey
    (
      [demo::lunarvineyard::store::VineyardDB]vineyard.vine_block.block_code
    )
    ~mainTable [demo::lunarvineyard::store::VineyardDB]vineyard.vine_block
    blockCode: [demo::lunarvineyard::store::VineyardDB]vineyard.vine_block.block_code,
    sectorCode: [demo::lunarvineyard::store::VineyardDB]vineyard.vine_block.sector_code
  }

  *demo::lunarvineyard::domain::IrrigationCycle[irrigationCycle]: Relational
  {
    ~primaryKey
    (
      [demo::lunarvineyard::store::VineyardDB]vineyard.irrigation_cycle.cycle_id
    )
    ~mainTable [demo::lunarvineyard::store::VineyardDB]vineyard.irrigation_cycle
    cycleId: [demo::lunarvineyard::store::VineyardDB]vineyard.irrigation_cycle.cycle_id,
    appliedOn: [demo::lunarvineyard::store::VineyardDB]vineyard.irrigation_cycle.applied_on,
    valveCode: [demo::lunarvineyard::store::VineyardDB]vineyard.irrigation_cycle.valve_code,
    scheduleCode: [demo::lunarvineyard::store::VineyardDB]vineyard.irrigation_cycle.schedule_code,
    litresApplied: [demo::lunarvineyard::store::VineyardDB]vineyard.irrigation_cycle.litres_applied,
    soilMoisturePct: [demo::lunarvineyard::store::VineyardDB]vineyard.irrigation_cycle.soil_moisture_pct,
    block[vineBlock]: [demo::lunarvineyard::store::VineyardDB]@Cycle_Block
  }

  testSuites:
  [
    blockProjectionSuite:
    {
      function: |demo::lunarvineyard::domain::VineBlock.all()->project(
  [
    b|$b.blockCode,
    b|$b.sectorCode
  ],
  [
    'Block',
    'Sector'
  ]
);
      tests:
      [
        blockProjection:
        {
          doc: 'Projects the block register that the milestoned cycle rows reach through the block join.';
          data:
          [
            demo::lunarvineyard::store::VineyardDB:
              Relational
              #{
                vineyard.vine_block:
                  'block_code,sector_code\n'+
                  'BLK-1,NORTH-SLOPE\n'+
                  'BLK-3,RIVER-TERRACE\n';
              }#
          ];
          asserts:
          [
            twoBlocks:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Block":"BLK-1","Sector":"NORTH-SLOPE"},{"Block":"BLK-3","Sector":"RIVER-TERRACE"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
