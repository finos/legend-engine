###Service
Service test::mapledelta3::service::StandYieldRollupService
{
  pattern: '/maple-delta-3/v1/stand-yield-rollup/{environment}/{fromDate}/{minLitres}';
  title: 'Maple Delta 3 - Stand Yield Rollup';
  ownership: UserList { users: ['sugarbush-tap-desk'] };
  documentation: 'Rolls the sugarbush collection runs up to one row per maple stand once a run has cleared the grade, the stainless-spile test on its own spiles, the season code, the litre floor, the collection window and the crew prefix, and serves the same rollup from a primary and an archive extent.';
  autoActivateUpdates: false;
  execution: Multi
  {
    query: {fromDate: StrictDate[1], minLitres: Integer[1]|test::mapledelta3::domain::TapRun.all()->filter(
      r|(($r.sapGrade == 'GRADE-A') && (($r.spiles->exists(s|$s.spileKind == 'STAINLESS')) && (($r.seasonCode == 'SEASON-2026') && (($r.litres > $minLitres) && (($r.collectedOn > $fromDate) && ($r.crewLabel->toUpper()->startsWith('NORTH')))))))
    )->project(
      [
        r|$r.standCode,
        r|$r.runCode,
        r|$r.litres,
        r|$r.crewLabel->toUpper()
      ],
      [
        'Stand',
        'Run',
        'Litres',
        'Crew'
      ]
    )->distinct()->groupBy(
      ['Stand'],
      [
        agg('Runs', x|$x.getString('Run'), y|$y->count()),
        agg('TotalLitres', x|$x.getInteger('Litres'), y|$y->sum())
      ]
    )->sort(
      [
        asc('Stand')
      ]
    )};
    key: 'environment';
    executions['primary']:
    {
      mapping: test::mapledelta3::mapping::SugarbushMapping;
      runtime: test::mapledelta3::runtime::SugarbushPrimaryRuntime;
    }
    executions['archive']:
    {
      mapping: test::mapledelta3::mapping::SugarbushMapping;
      runtime: test::mapledelta3::runtime::SugarbushArchiveRuntime;
    }
  }
  testSuites:
  [
    standYieldRollupSuite:
    {
      data:
      [
        connections:
        [
          sugarbush:
            Relational
            #{
              sugarbush.tap_run:
                'run_code,stand_code,sap_grade,litres,collected_on,crew_label,season_code\n'+
                'TR-01,ST-01,GRADE-A,120,2026-03-05,north ridge crew,SEASON-2026\n'+
                'TR-02,ST-01,GRADE-A,140,2026-03-06,north ridge crew,SEASON-2026\n'+
                'TR-03,ST-02,GRADE-B,200,2026-03-07,north ridge crew,SEASON-2026\n'+
                'TR-04,ST-02,GRADE-A,210,2026-03-08,south hollow crew,SEASON-2026\n'+
                'TR-05,ST-03,GRADE-A,40,2026-03-09,north ridge crew,SEASON-2026\n'+
                'TR-06,ST-03,GRADE-A,160,2026-02-01,north ridge crew,SEASON-2026\n'+
                'TR-07,ST-03,GRADE-A,180,2026-03-10,north ridge crew,SEASON-2025\n'+
                'TR-08,ST-04,GRADE-A,150,2026-03-11,north ridge crew,SEASON-2026\n'+
                'TR-09,ST-04,GRADE-A,130,2026-03-12,north ridge crew,SEASON-2026\n';

              sugarbush.run_spile:
                'spile_code,run_code,spile_kind,bore_mm\n'+
                'SP-01,TR-01,STAINLESS,8\n'+
                'SP-02,TR-01,PLASTIC,8\n'+
                'SP-03,TR-02,STAINLESS,9\n'+
                'SP-04,TR-03,STAINLESS,8\n'+
                'SP-05,TR-04,STAINLESS,8\n'+
                'SP-06,TR-05,STAINLESS,8\n'+
                'SP-07,TR-06,STAINLESS,8\n'+
                'SP-08,TR-07,STAINLESS,8\n'+
                'SP-09,TR-08,PLASTIC,7\n'+
                'SP-10,TR-09,STAINLESS,9\n';
            }#
        ]
      ]
      tests:
      [
        primaryStandRollupAboveTheLitreFloor:
        {
          serializationFormat: PURE_TDSOBJECT;
          keys: ['primary'];
          parameters:
          [
            fromDate = %2026-03-01,
            minLitres = 100
          ]
          asserts:
          [
            twoStandsSurviveEveryArmOfThePredicate:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Stand":"ST-01","Runs":2,"TotalLitres":260},{"Stand":"ST-04","Runs":1,"TotalLitres":130}]';
                  }#;
              }#
          ]
        },
        archiveStandRollupWithATighterLitreFloor:
        {
          serializationFormat: PURE_TDSOBJECT;
          keys: ['archive'];
          parameters:
          [
            fromDate = %2026-03-01,
            minLitres = 125
          ]
          asserts:
          [
            theTighterFloorDropsTheSmallerRunOfTheFirstStand:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Stand":"ST-01","Runs":1,"TotalLitres":140},{"Stand":"ST-04","Runs":1,"TotalLitres":130}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
