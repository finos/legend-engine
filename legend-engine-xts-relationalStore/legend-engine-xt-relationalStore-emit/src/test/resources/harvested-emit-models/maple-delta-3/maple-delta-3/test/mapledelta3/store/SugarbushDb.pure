###Relational
Database test::mapledelta3::store::SugarbushDb
(
  Schema sugarbush
  (
    Table tap_run
    (
      run_code VARCHAR(16) PRIMARY KEY,
      stand_code VARCHAR(16) NOT NULL,
      sap_grade VARCHAR(16) NOT NULL,
      litres INTEGER NOT NULL,
      collected_on DATE NOT NULL,
      crew_label VARCHAR(64) NOT NULL,
      season_code VARCHAR(16) NOT NULL
    )

    Table run_spile
    (
      spile_code VARCHAR(16) PRIMARY KEY,
      run_code VARCHAR(16) NOT NULL,
      spile_kind VARCHAR(16) NOT NULL,
      bore_mm INTEGER NOT NULL
    )
  )

  Join Run_Spile(sugarbush.tap_run.run_code = sugarbush.run_spile.run_code)
)
