###Pure
import test::mapledelta3::domain::*;

Class {meta::pure::profiles::doc.doc = 'One collection run off a stand of sugar maples, tallied per stand once the run has cleared the season and crew rules.'} test::mapledelta3::domain::TapRun
{
  runCode: String[1];
  standCode: String[1];
  sapGrade: String[1];
  litres: Integer[1];
  collectedOn: StrictDate[1];
  crewLabel: String[1];
  seasonCode: String[1];
  spiles: RunSpile[*];
}

Class {meta::pure::profiles::doc.doc = 'A spile driven for one collection run; a run counts only when at least one of its spiles is a stainless spile.'} test::mapledelta3::domain::RunSpile
{
  spileCode: String[1];
  spileKind: String[1];
  boreMm: Integer[1];
}
