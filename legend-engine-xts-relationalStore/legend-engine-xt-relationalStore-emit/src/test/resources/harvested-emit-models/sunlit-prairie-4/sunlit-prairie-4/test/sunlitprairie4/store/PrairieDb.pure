###Relational
Database test::sunlitprairie4::store::PrairieDb
(
  Schema prairie
  (
    Table burn_patch
    (
      survey_code VARCHAR(24) PRIMARY KEY,
      patch_code VARCHAR(20) NOT NULL,
      surveyed_on DATE NOT NULL,
      stem_tally INTEGER NOT NULL,
      grass_name VARCHAR(48) NOT NULL,
      seed_code VARCHAR(20) NOT NULL,
      patch_area_sqm FLOAT NOT NULL,
      tract_code VARCHAR(20) NOT NULL
    )

    Table prairie_tract
    (
      tract_code VARCHAR(20) PRIMARY KEY,
      tract_name VARCHAR(48) NOT NULL,
      warden_code VARCHAR(20) NOT NULL
    )

    Table warden_desk
    (
      warden_code VARCHAR(20) PRIMARY KEY,
      warden_name VARCHAR(48) NOT NULL,
      district_code VARCHAR(20) NOT NULL
    )

    Table sighting_log
    (
      tract_code VARCHAR(20) NOT NULL,
      grass_name VARCHAR(48) NOT NULL,
      logged_on DATE NOT NULL
    )
  )

  Join PatchToTract(prairie.burn_patch.tract_code = prairie.prairie_tract.tract_code)
  Join TractToWarden(prairie.prairie_tract.warden_code = prairie.warden_desk.warden_code)
)
