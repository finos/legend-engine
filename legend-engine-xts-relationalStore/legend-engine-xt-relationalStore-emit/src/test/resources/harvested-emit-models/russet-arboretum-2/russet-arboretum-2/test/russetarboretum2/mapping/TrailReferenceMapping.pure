###Mapping
Mapping test::russetarboretum2::mapping::TrailReferenceMapping
(
  test::russetarboretum2::domain::TerrainClass: EnumerationMapping TerrainMapping
  {
    SCREE: ['SC'],
    LOAM: ['LO'],
    BOARDWALK: ['BW']
  }

  *test::russetarboretum2::domain::Steward[steward]: Relational
  {
    ~primaryKey
    (
      [test::russetarboretum2::store::TrailDatabase]roster.steward.steward_code
    )
    ~mainTable [test::russetarboretum2::store::TrailDatabase]roster.steward
    partyCode: [test::russetarboretum2::store::TrailDatabase]roster.steward.steward_code,
    partyName: [test::russetarboretum2::store::TrailDatabase]roster.steward.steward_name,
    radioCall: [test::russetarboretum2::store::TrailDatabase]roster.steward.radio_call
  }

  *test::russetarboretum2::domain::TrailSegment[trailSegment]: Relational
  {
    ~primaryKey
    (
      [test::russetarboretum2::store::TrailDatabase]field.trail_segment.segment_code
    )
    ~mainTable [test::russetarboretum2::store::TrailDatabase]field.trail_segment
    featureLabel: 'TRAIL SEGMENT',
    segmentCode: [test::russetarboretum2::store::TrailDatabase]field.trail_segment.segment_code,
    segmentName: [test::russetarboretum2::store::TrailDatabase]field.trail_segment.segment_name,
    steward[steward]: [test::russetarboretum2::store::TrailDatabase]@Segment_Steward
  }
)
