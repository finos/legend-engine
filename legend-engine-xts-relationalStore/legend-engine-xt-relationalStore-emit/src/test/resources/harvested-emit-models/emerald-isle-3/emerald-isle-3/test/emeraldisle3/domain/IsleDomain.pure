import test::emeraldisle3::domain::*;

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'A seabird colony census plot on an offshore isle, versioned along a business validity window.'} test::emeraldisle3::domain::ColonyPlot
{
  plotId: Integer[1];
  plotCode: String[1];
  habitatCode: String[1];
  wardenNote: String[1];
  nestCount: Integer[1];
  surveyStatus: String[1];
  nestBand() {if($this.nestCount >= 100, | 'LARGE', | if($this.nestCount >= 20, | 'MEDIUM', | 'SMALL'))}: String[1];
  displayLabel() {$this.plotCode + ' [' + $this.habitatCode + ']'}: String[1];
  burrowNesting() {$this.habitatCode->startsWith('B') && !$this.wardenNote->isEmpty()}: Boolean[1];
}
