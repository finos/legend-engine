###Pure
import test::nobleorchard7::domain::*;

Class test::nobleorchard7::domain::Tree
{
  treeCode: String[1];
  cultivar: String[1];
}

Class test::nobleorchard7::domain::Graft
{
  graftCode: String[1];
  scionLabel: String[1];
  tree: Tree[1];
}

Association test::nobleorchard7::domain::Tree_Graft
{
  tree: Tree[0..1];
  grafts: Graft[*];
}
