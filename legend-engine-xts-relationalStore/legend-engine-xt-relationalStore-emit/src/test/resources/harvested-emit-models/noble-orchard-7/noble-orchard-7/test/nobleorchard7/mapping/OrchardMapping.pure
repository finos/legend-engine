###Mapping
Mapping test::nobleorchard7::mapping::OrchardMapping
(
  include mapping test::nobleorchard7::mapping::TreeMapping

  *test::nobleorchard7::domain::Graft[graft]: Relational
  {
    ~primaryKey
    (
      [test::nobleorchard7::store::OrchardDb]ORCHARD.GRAFT.GRAFT_ID
    )
    ~mainTable [test::nobleorchard7::store::OrchardDb]ORCHARD.GRAFT
    graftCode: [test::nobleorchard7::store::OrchardDb]ORCHARD.GRAFT.GRAFT_CODE,
    scionLabel: [test::nobleorchard7::store::OrchardDb]ORCHARD.GRAFT.SCION_LABEL
  }

  test::nobleorchard7::domain::Tree_Graft: Relational
  {
    AssociationMapping
    (
      tree[graft, tree]: [test::nobleorchard7::store::OrchardDb]@Tree_Graft,
      grafts[tree, graft]: [test::nobleorchard7::store::OrchardDb]@Tree_Graft
    )
  }

  testSuites:
  [
    graftTreeSuite:
    {
      function: |test::nobleorchard7::domain::Graft.all()->project(~[Graft: g|$g.graftCode, Scion: g|$g.scionLabel, Tree: g|$g.tree.treeCode]);
      tests:
      [
        graftRowsWalkBackToTree:
        {
          data:
          [
            test::nobleorchard7::store::OrchardDb: Reference
              #{
                test::nobleorchard7::data::OrchardData
              }#
          ];
          asserts:
          [
            joinedGraftRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Graft":"GR-501","Scion":"Early Gold","Tree":"TR-101"},{"Graft":"GR-502","Scion":"Red Crest","Tree":"TR-101"},{"Graft":"GR-503","Scion":"Winter Green","Tree":"TR-102"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
