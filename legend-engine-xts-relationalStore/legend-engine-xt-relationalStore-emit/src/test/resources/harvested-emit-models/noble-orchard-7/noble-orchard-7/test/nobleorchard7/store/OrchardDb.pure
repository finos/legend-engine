###Relational
Database test::nobleorchard7::store::OrchardDb
(
  Schema ORCHARD
  (
    Table TREE
    (
      TREE_ID INTEGER PRIMARY KEY,
      TREE_CODE VARCHAR(24) NOT NULL,
      CULTIVAR VARCHAR(64) NOT NULL
    )
    Table GRAFT
    (
      GRAFT_ID INTEGER PRIMARY KEY,
      TREE_ID INTEGER NOT NULL,
      GRAFT_CODE VARCHAR(24) NOT NULL,
      SCION_LABEL VARCHAR(64) NOT NULL
    )
  )
  Join Tree_Graft(ORCHARD.GRAFT.TREE_ID = ORCHARD.TREE.TREE_ID)
)
