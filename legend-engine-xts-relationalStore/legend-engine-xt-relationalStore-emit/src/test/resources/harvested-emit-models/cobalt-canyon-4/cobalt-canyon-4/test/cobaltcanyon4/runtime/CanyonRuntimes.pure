###Runtime
Runtime test::cobaltcanyon4::runtime::CanyonLiveRuntime
{
  mappings:
  [
    test::cobaltcanyon4::mapping::CanyonLiveMapping
  ];
  connections:
  [
    test::cobaltcanyon4::store::CanyonDb:
    [
      liveConnection: test::cobaltcanyon4::connection::CanyonLiveConnection
    ]
  ];
}

Runtime test::cobaltcanyon4::runtime::CanyonArchiveRuntime
{
  mappings:
  [
    test::cobaltcanyon4::mapping::CanyonArchiveMapping
  ];
  connections:
  [
    test::cobaltcanyon4::store::CanyonDb:
    [
      archiveConnection: test::cobaltcanyon4::connection::CanyonArchiveConnection
    ]
  ];
}
