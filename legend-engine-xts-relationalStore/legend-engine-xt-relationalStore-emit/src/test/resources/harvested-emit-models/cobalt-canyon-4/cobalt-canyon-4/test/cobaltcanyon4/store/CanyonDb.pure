###Relational
Database test::cobaltcanyon4::store::CanyonDb
(
  Schema canyon
  (
    Table sector
    (
      sector_id INTEGER PRIMARY KEY,
      sector_number INTEGER NOT NULL,
      sector_name VARCHAR(60) NOT NULL
    )
    Table trail_segment
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      segment_row INTEGER PRIMARY KEY,
      segment_id INTEGER NOT NULL,
      segment_name VARCHAR(60) NOT NULL,
      closed_flag BIT NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
    Table hazard_note
    (
      hazard_id INTEGER PRIMARY KEY,
      report_id INTEGER NOT NULL,
      hazard_label VARCHAR(60) NOT NULL
    )
  )

  Schema patrol
  (
    Table patrol_report
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )
      report_row INTEGER PRIMARY KEY,
      report_id INTEGER NOT NULL,
      report_code VARCHAR(16) NOT NULL,
      sector_id INTEGER NOT NULL,
      segment_id INTEGER NOT NULL,
      created_at TIMESTAMP NOT NULL,
      updated_at TIMESTAMP NOT NULL,
      archived_flag BIT,
      ranger_tag VARCHAR(16),
      in_z DATE NOT NULL,
      out_z DATE NOT NULL
    )
  )

  Schema archive
  (
    Table patrol_report
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )
      report_row INTEGER PRIMARY KEY,
      report_id INTEGER NOT NULL,
      report_code VARCHAR(16) NOT NULL,
      sector_id INTEGER NOT NULL,
      segment_id INTEGER NOT NULL,
      created_at TIMESTAMP NOT NULL,
      updated_at TIMESTAMP NOT NULL,
      archived_flag BIT,
      ranger_tag VARCHAR(16),
      in_z DATE NOT NULL,
      out_z DATE NOT NULL
    )
  )

  Join LiveReport_Sector(patrol.patrol_report.sector_id = canyon.sector.sector_id)
  Join LiveReport_Segment(patrol.patrol_report.segment_id = canyon.trail_segment.segment_id)
  Join LiveReport_Hazard(patrol.patrol_report.report_id = canyon.hazard_note.report_id)
  Join ArchiveReport_Sector(archive.patrol_report.sector_id = canyon.sector.sector_id)
  Join ArchiveReport_Segment(archive.patrol_report.segment_id = canyon.trail_segment.segment_id)
  Join ArchiveReport_Hazard(archive.patrol_report.report_id = canyon.hazard_note.report_id)
)
