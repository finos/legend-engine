###Service
Service test::cobaltcanyon4::service::ArchiveHazardWeek
{
  pattern: '/cobalt-canyon/v1/archive-hazard-week';
  title: 'Cobalt Canyon - Archive hazard week';
  ownership: UserList { users: ['canyon-patrol-desk', 'canyon-ranger-lead'] };
  documentation: 'Lists archived patrol reports carrying a hazard that were revised within the past week, with the as-of closure of their trail segment.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {|let processingDate = now();
    let businessDate = now();
    test::cobaltcanyon4::domain::PatrolReport.all($processingDate)->filter(
      r|$r.createdAt->isOnOrAfterDay(%2024-01-01) && (!$r.hazards->isEmpty() && $r.updatedAt->isOnOrAfterDay(today()->adjust(-7, DurationUnit.DAYS)))
    )->project(
      [
        r|$r.reportCode,
        r|$r.segment($businessDate).closed,
        r|$r.archived,
        r|'ARCHIVE-WEEK'
      ],
      [
        'Report',
        'SegmentClosed',
        'Archived',
        'Source'
      ]
    )->filter(
      row|!($row.getBoolean('Archived') == true)
    )->distinct()->sort(
      [
        asc('Report')
      ]
    );};
    mapping: test::cobaltcanyon4::mapping::CanyonArchiveMapping;
    runtime: test::cobaltcanyon4::runtime::CanyonArchiveRuntime;
  }
  testSuites:
  [
    hazardWeekSuite:
    {
      data:
      [
        connections:
        [
          archiveConnection:
            Reference
            #{
              test::cobaltcanyon4::data::CanyonPatrolData
            }#
        ]
      ]
      tests:
      [
        recentHazardReportsOnly:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            recentHazardReportsOnlyResult:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Report":"AR-001","SegmentClosed":false,"Archived":false,"Source":"ARCHIVE-WEEK"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
