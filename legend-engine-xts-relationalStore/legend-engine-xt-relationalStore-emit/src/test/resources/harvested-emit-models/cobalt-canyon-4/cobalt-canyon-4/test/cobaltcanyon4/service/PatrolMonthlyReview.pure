###Service
Service test::cobaltcanyon4::service::PatrolMonthlyReview
{
  pattern: '/cobalt-canyon/v1/patrol-monthly-review';
  title: 'Cobalt Canyon - Patrol monthly review';
  ownership: UserList { users: ['canyon-patrol-desk', 'canyon-ranger-lead'] };
  documentation: 'Lists the latest version of live patrol reports opened within the past month outside the excluded sectors, keeping only tagged reports whose trail segment is open at the far end of business time.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {|let processingDate = now();
    let businessDate = now();
    test::cobaltcanyon4::domain::PatrolReport.all(%9999-12-30)->filter(
      r|$r.createdAt->isOnOrAfterDay(%2024-01-01) && ($r.createdAt->isOnOrAfterDay(today()->adjust(-1, DurationUnit.MONTHS)) && !$r.sector.sectorNumber->in([3, 7, 11]))
    )->project(
      [
        r|$r.reportCode,
        r|$r.sector.sectorName,
        r|$r.segment(%9999-12-30).closed,
        r|$r.rangerTag,
        r|'LIVE-LATEST'
      ],
      [
        'Report',
        'Sector',
        'SegmentClosed',
        'RangerTag',
        'Source'
      ]
    )->filter(
      row|!($row.getBoolean('SegmentClosed') == true) && $row.getString('RangerTag')->isNotEmpty()
    )->distinct()->sort(
      [
        asc('Report')
      ]
    );};
    mapping: test::cobaltcanyon4::mapping::CanyonLiveMapping;
    runtime: test::cobaltcanyon4::runtime::CanyonLiveRuntime;
  }
  testSuites:
  [
    monthlyReviewSuite:
    {
      data:
      [
        connections:
        [
          liveConnection:
            Reference
            #{
              test::cobaltcanyon4::data::CanyonPatrolData
            }#
        ]
      ]
      tests:
      [
        openTaggedSegmentsOnly:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            openTaggedSegmentsOnlyResult:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Report":"PR-001","Sector":"Rim Sector","SegmentClosed":false,"RangerTag":"RG-12","Source":"LIVE-LATEST"},{"Report":"PR-007","Sector":"Slot Sector","SegmentClosed":null,"RangerTag":"ZZ-1","Source":"LIVE-LATEST"},{"Report":"PR-008","Sector":"Rim Sector","SegmentClosed":false,"RangerTag":"QX-7","Source":"LIVE-LATEST"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
