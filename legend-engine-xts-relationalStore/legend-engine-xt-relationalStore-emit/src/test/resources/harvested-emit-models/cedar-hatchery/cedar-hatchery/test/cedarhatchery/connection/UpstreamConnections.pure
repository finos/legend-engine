###Connection
RelationalDatabaseConnection test::cedarhatchery::connection::RegisterH2Connection
{
  store: test::cedarhatchery::store::HatcheryRegisterDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists register;',
      'create schema register;',
      'create table register.register_row (register_code varchar(24) primary key, period_month varchar(12) not null, unit_code varchar(24) not null, keeper_name varchar(120), stock_count integer not null, release_count integer not null, loss_count integer);'
      ];
  };
  auth: DefaultH2;
}
