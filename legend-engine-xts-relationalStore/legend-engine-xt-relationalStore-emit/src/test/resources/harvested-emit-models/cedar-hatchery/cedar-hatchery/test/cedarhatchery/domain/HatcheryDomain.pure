###Pure
Class {meta::pure::profiles::doc.doc = 'A monthly operational measure grain for one rearing unit of the hatchery, populated entirely by transforms so every required property always carries a value.'} test::cedarhatchery::domain::HatcheryMeasure
{
  measureCode: String[1];
  periodMonth: String[1];
  unitCode: String[1];
  speciesLabel: String[1];
  keeperName: String[1];
  stockCount: Integer[1];
  releaseCount: Integer[1];
  lossBand: String[1];
  gradeLabel: String[1];
  recordedOn: StrictDate[0..1];
}

Class {meta::pure::profiles::doc.doc = 'Specialises the measure grain for the river rearing unit without adding properties.'} test::cedarhatchery::domain::RiverUnitMeasure extends test::cedarhatchery::domain::HatcheryMeasure
{
}

