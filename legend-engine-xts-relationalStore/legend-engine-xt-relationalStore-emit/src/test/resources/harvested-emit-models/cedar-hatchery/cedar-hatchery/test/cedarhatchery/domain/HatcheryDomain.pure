Class {meta::pure::profiles::doc.doc = 'A row of the legacy rearing register, kept relationally so the raw counts behind the mapped grain can be aggregated directly.'} test::cedarhatchery::domain::RegisterRow
{
  registerCode: String[1];
  periodMonth: String[1];
  unitCode: String[1];
  keeperName: String[0..1];
  stockCount: Integer[1];
  releaseCount: Integer[1];
  lossCount: Integer[0..1];
}
