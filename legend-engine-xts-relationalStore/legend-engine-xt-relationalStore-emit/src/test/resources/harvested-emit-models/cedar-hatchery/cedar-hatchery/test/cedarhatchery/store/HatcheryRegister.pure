###Relational
Database test::cedarhatchery::store::HatcheryRegisterDB
(
  Schema register
  (
    Table register_row
    (
      register_code VARCHAR(24) PRIMARY KEY,
      period_month VARCHAR(12) NOT NULL,
      unit_code VARCHAR(24) NOT NULL,
      keeper_name VARCHAR(120),
      stock_count INTEGER NOT NULL,
      release_count INTEGER NOT NULL,
      loss_count INTEGER
    )
  )
)
