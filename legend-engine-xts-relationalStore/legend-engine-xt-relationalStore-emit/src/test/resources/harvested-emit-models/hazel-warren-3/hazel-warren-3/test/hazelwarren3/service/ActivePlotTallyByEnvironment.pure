###Service
Service test::hazelwarren3::service::ActivePlotTallyByEnvironment
{
  pattern: '/allotment/v1/active-plot-tally/{districtName}';
  title: 'Allotment Warren - Active Plot Tally By Environment';
  owners:
  [
    'allotment-warren-office',
    'allotment-tending-rota'
  ];
  documentation: 'Counts the plots of one district, dropping the retired plots before the projection and then keeping the rows whose home field is one of the eight recognised fields and whose sowing date is still ahead of the current date unless the field itself admits them. The projected rows are grouped per district, de-duplicated and returned per environment key, so the same body plans against the primary and the standby runtime.';
  autoActivateUpdates: false;
  execution: Multi
  {
    query: {districtName: String[1], currentDate: StrictDate[1]|test::hazelwarren3::domain::AllotmentPlot.all()->filter(
      p|$p.active->toOne() == true
    )->project(
      [
        col(p|$p.site.districtName, 'District'),
        col(p|$p.site.siteName, 'Site'),
        col(p|$p.plotCode, 'Plot'),
        col(p|$p.sownOn, 'Sown On')
      ]
    )->filter(
      r|($r.getString('District') == $districtName) && (((((((($r.getString('Site') == 'North Field') || ($r.getString('Site') == 'South Field')) || ($r.getString('Site') == 'East Field')) || ($r.getString('Site') == 'West Field')) || ($r.getString('Site') == 'Upper Field')) || ($r.getString('Site') == 'Lower Field')) || ($r.getString('Site') == 'Mill Field')) && ((($r.getString('Site') == 'North Field') || ($r.getStrictDate('Sown On') > $currentDate)) && (($r.getString('Site') == 'South Field') || ($r.getStrictDate('Sown On') > $currentDate))))
    )->groupBy(['District'], [agg('Plots', x|$x.getString('Plot'), y|$y->count())])->distinct()->sort([asc('District')])};
    key: 'environment';
    executions['primary']:
    {
      mapping: test::hazelwarren3::mapping::PlotLinkMapping;
      runtime: test::hazelwarren3::runtime::PlotPrimaryRuntime;
    }
    executions['standby']:
    {
      mapping: test::hazelwarren3::mapping::PlotLinkMapping;
      runtime: test::hazelwarren3::runtime::PlotStandbyRuntime;
    }
  }
  testSuites:
  [
    primaryActiveTallySuite:
    {
      data:
      [
        connections:
        [
          plotPrimary:
            Relational
            #{
              allotment.plot:
                'plot_code,site_code,crop_code,grade_code,sown_on,active\n'+
                'P-01,S-01,C-01,G1,2000-01-04,true\n'+
                'P-02,S-02,C-02,G2,2000-02-04,true\n'+
                'P-03,S-02,C-01,G3,2000-03-04,false\n'+
                'P-04,S-02,C-03,G4,9999-12-31,true\n'+
                'P-05,S-03,C-02,G5,2000-05-04,true\n';
              allotment.tending:
                'plot_code,tended_on,keeper_code,hours\n'+
                'P-01,2000-01-10,K-01,6\n';
              allotmentref.site:
                'site_code,site_name,district_name\n'+
                'S-01,North Field,Northern District\n'+
                'S-02,South Field,Southern District\n'+
                'S-03,Mill Field,Southern District\n';
              allotmentref.crop:
                'crop_code,crop_name,season_code\n'+
                'C-01,Broad Bean,S1\n'+
                'C-02,Leaf Chard,S2\n'+
                'C-03,Root Beet,\n';
            }#
        ]
      ]
      tests:
      [
        onlyTheFutureSownActivePlotSurvivesBothDateGuards:
        {
          serializationFormat: PURE_TDSOBJECT;
          keys: ['primary'];
          parameters:
          [
            districtName = 'Southern District',
            currentDate = %2026-08-01
          ]
          asserts:
          [
            oneCountedPlot:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"District":"Southern District","Plots":1}]';
                  }#;
              }#
          ]
        },
        aDistrictWhoseOnlyFieldFailsTheSecondGuardTalliesNothing:
        {
          serializationFormat: PURE_TDSOBJECT;
          keys: ['primary'];
          parameters:
          [
            districtName = 'Northern District',
            currentDate = %2026-08-01
          ]
          asserts:
          [
            emptyTally:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[]';
                  }#;
              }#
          ]
        }
      ]
    },
    standbyActiveTallySuite:
    {
      data:
      [
        connections:
        [
          plotStandby:
            Relational
            #{
              allotment.plot:
                'plot_code,site_code,crop_code,grade_code,sown_on,active\n'+
                'P-11,S-02,C-01,G1,9999-01-01,true\n'+
                'P-12,S-02,C-02,G2,9999-02-01,true\n'+
                'P-13,S-02,C-01,G3,9999-03-01,false\n';
              allotment.tending:
                'plot_code,tended_on,keeper_code,hours\n';
              allotmentref.site:
                'site_code,site_name,district_name\n'+
                'S-02,South Field,Southern District\n';
              allotmentref.crop:
                'crop_code,crop_name,season_code\n'+
                'C-01,Broad Bean,S1\n'+
                'C-02,Leaf Chard,S2\n';
            }#
        ]
      ]
      tests:
      [
        theStandbyEnvironmentCountsItsOwnActivePlots:
        {
          serializationFormat: PURE_TDSOBJECT;
          keys: ['standby'];
          parameters:
          [
            districtName = 'Southern District',
            currentDate = %2026-08-01
          ]
          asserts:
          [
            twoStandbyPlots:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"District":"Southern District","Plots":2}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
