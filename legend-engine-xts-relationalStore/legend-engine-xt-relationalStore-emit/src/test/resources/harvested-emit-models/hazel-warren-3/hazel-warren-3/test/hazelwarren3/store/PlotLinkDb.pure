###Relational
Database test::hazelwarren3::store::PlotLinkDb
(
  include test::hazelwarren3::store::PlotCoreDb
  include test::hazelwarren3::store::SiteReferenceDb

  Join Plot_Site_J(allotment.plot.site_code = allotmentref.site.site_code)

  Join Plot_Crop_J(allotment.plot.crop_code = allotmentref.crop.crop_code)

  Join Plot_Tending_J(allotment.plot.plot_code = allotment.tending.plot_code)
)
