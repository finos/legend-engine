###Mapping
Mapping test::fabledfjord3::mapping::ShoreReferenceMapping
(
  *test::fabledfjord3::domain::TidalZone[zone]: Relational
  {
    ~filter [test::fabledfjord3::store::TideReferenceStore]SiteZoneFilter
    ~primaryKey
    (
      [test::fabledfjord3::store::TideReferenceStore]reference.tidal_zone.zone_code
    )
    ~mainTable [test::fabledfjord3::store::TideReferenceStore]reference.tidal_zone
    zoneCode: [test::fabledfjord3::store::TideReferenceStore]reference.tidal_zone.zone_code,
    zoneName: [test::fabledfjord3::store::TideReferenceStore]reference.tidal_zone.zone_name
  }

  testSuites:
  [
    tidalZoneSuite:
    {
      function: |test::fabledfjord3::domain::TidalZone.all()->project(
        [z|$z.zoneCode, z|$z.zoneName],
        ['Code', 'Name']
      )->sort([asc('Code')]);
      tests:
      [
        referenceZones:
        {
          data:
          [
            test::fabledfjord3::store::TideReferenceStore:
              Relational
              #{
                reference.tidal_zone:
                  'zone_code,zone_name\n'+
                  'Z-1,Quiet Shelf\n'+
                  'Z-2,Outer Shelf\n'+
                  'Z-3,Spine Ledge\n';
              }#
          ];
          asserts:
          [
            threeReferenceZones:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Code":"Z-1","Name":"Quiet Shelf"},{"Code":"Z-2","Name":"Outer Shelf"},{"Code":"Z-3","Name":"Spine Ledge"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
