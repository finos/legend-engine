###Runtime
Runtime test::fabledfjord3::runtime::ShoreSurveyRuntime
{
  mappings:
  [
    test::fabledfjord3::mapping::ShoreRelationalMappings
  ];
  connections:
  [
    test::fabledfjord3::store::ShoreSurveyStore:
    [
      shore: test::fabledfjord3::connection::ShoreSurveyConnection
    ]
  ];
}

Runtime test::fabledfjord3::runtime::ShoreDigestRuntime
{
  mappings:
  [
    test::fabledfjord3::mapping::ShoreDigestMapping
  ];
  connections:
  [
    ModelStore:
    [
      digest: test::fabledfjord3::connection::ShoreDigestChain
    ]
  ];
}

Runtime test::fabledfjord3::runtime::ShoreCombinedRuntime
{
  mappings:
  [
    test::fabledfjord3::mapping::ShoreRelationalMappings,
    test::fabledfjord3::mapping::ShoreReferenceMapping,
    test::fabledfjord3::mapping::ShoreDigestMapping
  ];
  connections:
  [
    test::fabledfjord3::store::ShoreSurveyStore:
    [
      shore: test::fabledfjord3::connection::ShoreSurveyConnection
    ],
    test::fabledfjord3::store::TideReferenceStore:
    [
      tide: test::fabledfjord3::connection::TideReferenceConnection
    ],
    ModelStore:
    [
      digest: test::fabledfjord3::connection::ShoreDigestChain
    ]
  ];
}
