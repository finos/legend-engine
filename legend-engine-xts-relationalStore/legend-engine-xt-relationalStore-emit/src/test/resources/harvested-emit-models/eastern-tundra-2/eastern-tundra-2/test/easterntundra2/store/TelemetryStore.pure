###Relational
Database test::easterntundra2::store::TelemetryStore
(
  Schema telemetry
  (
    Table collar_fix
    (
      collar_code VARCHAR(24) PRIMARY KEY,
      animal_code VARCHAR(24) NOT NULL,
      herd_code VARCHAR(24) NOT NULL,
      fix_date DATE NOT NULL,
      latitude FLOAT NOT NULL,
      longitude FLOAT NOT NULL,
      altitude_metres FLOAT NOT NULL,
      collar_status VARCHAR(24) NOT NULL,
      signal_code VARCHAR(24) NOT NULL,
      habitat_code VARCHAR(24) NOT NULL,
      movement_code VARCHAR(24) NOT NULL,
      distance_km FLOAT NOT NULL,
      temperature_c FLOAT NOT NULL,
      snow_depth_cm FLOAT NOT NULL,
      vegetation_code VARCHAR(24) NOT NULL,
      observer_note VARCHAR(160),
      deployment_year_text VARCHAR(24) NOT NULL,
      capture_year_text VARCHAR(24) NOT NULL,
      survey_year_text VARCHAR(24) NOT NULL,
      age_years_text VARCHAR(24) NOT NULL,
      distance_band_text VARCHAR(24) NOT NULL,
      battery_text VARCHAR(24) NOT NULL,
      tracking_code VARCHAR(24) NOT NULL,
      gps_quality VARCHAR(24) NOT NULL,
      satellite_count INTEGER NOT NULL,
      transmission_seq INTEGER NOT NULL,
      route_code VARCHAR(24) NOT NULL,
      sex_code VARCHAR(24) NOT NULL,
      age_class VARCHAR(24) NOT NULL,
      body_mass_kg FLOAT NOT NULL,
      antler_stage VARCHAR(24) NOT NULL
    )
  )
)
