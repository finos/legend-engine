###Connection
RelationalDatabaseConnection test::easterntundra2::connection::TelemetryConnection
{
  store: test::easterntundra2::store::TelemetryStore;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'create schema if not exists telemetry;',
      'drop table if exists telemetry.collar_fix cascade;',
      'create table telemetry.collar_fix (collar_code varchar(24) primary key, animal_code varchar(24) not null, herd_code varchar(24) not null, fix_date date not null, latitude float not null, longitude float not null, altitude_metres float not null, collar_status varchar(24) not null, signal_code varchar(24) not null, habitat_code varchar(24) not null, movement_code varchar(24) not null, distance_km float not null, temperature_c float not null, snow_depth_cm float not null, vegetation_code varchar(24) not null, observer_note varchar(160), deployment_year_text varchar(24) not null, capture_year_text varchar(24) not null, survey_year_text varchar(24) not null, age_years_text varchar(24) not null, distance_band_text varchar(24) not null, battery_text varchar(24) not null, tracking_code varchar(24) not null, gps_quality varchar(24) not null, satellite_count integer not null, transmission_seq integer not null, route_code varchar(24) not null, sex_code varchar(24) not null, age_class varchar(24) not null, body_mass_kg float not null, antler_stage varchar(24) not null);'
    ];
  };
  auth: DefaultH2;
  postProcessors:
  [
    mapper
    {
      mappers:
      [
        schema {from: 'archive'; to: 'archive_lake';}
      ];
    }
  ];
}
