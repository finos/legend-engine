  test::wistfulorchard3::domain::HandlingClass: EnumerationMapping HandlingClassMapping
  {
    DRY_PACK: ['DRY/LOW'],
    VENTED_PACK: ['VENTED/MID'],
    CHILL_PACK: ['CHILL/HIGH']
  }
)
