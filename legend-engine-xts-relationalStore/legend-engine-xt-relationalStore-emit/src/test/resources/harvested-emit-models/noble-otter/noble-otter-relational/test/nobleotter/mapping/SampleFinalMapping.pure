###Mapping
Mapping test::nobleotter::mapping::SampleFinalMapping
(
  include mapping test::nobleotter::mapping::TrialEnumMapping

  test::nobleotter::domain::NutrientLine[finalLine]: Relational
  {
    ~filter [test::nobleotter::store::SampleBase]NitrateSamples
    ~primaryKey
    (
      [test::nobleotter::store::SampleBase]field.sample_value.sample_id
    )
    ~mainTable [test::nobleotter::store::SampleBase]field.sample_value
    sampleId: [test::nobleotter::store::SampleBase]field.sample_value.sample_id,
    valueName: [test::nobleotter::store::SampleBase]field.sample_value.value_name,
    reportForm: EnumerationMapping ReportFormMapping: 'F',
    lineTotal: plus([test::nobleotter::store::SampleBase]field.sample_value.amount_a, [test::nobleotter::store::SampleBase]field.sample_value.amount_b)
  }
)
