###Relational
Database test::nobleotter::store::SampleBase
(
  Schema field
  (
    Table plot_record
    (
      milestoning
      (
        business(BUS_FROM = bus_from, BUS_THRU = bus_thru)
      )

      plot_code VARCHAR(16) PRIMARY KEY,
      trial_code VARCHAR(16),
      soil_class_code CHAR(8),
      crop_code CHAR(8),
      canopy_score INTEGER,
      bus_from DATE PRIMARY KEY,
      bus_thru DATE
    )

    Table sample_value
    (
      sample_id INTEGER PRIMARY KEY,
      plot_code VARCHAR(16),
      value_name VARCHAR(32),
      amount_a INTEGER,
      amount_b INTEGER
    )
  )

  Filter MagnitudeSamples(abs(field.sample_value.amount_a) > 0 or abs(field.sample_value.amount_b) > 0)
  Filter NitrateSamples(field.sample_value.value_name = 'NITRATE')
)
