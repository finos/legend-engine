    crateCount: [test::tealprairie::store::SeedVaultDatabase]steward.steward_transfer.crate_count,
    holdingTempC: [test::tealprairie::store::SeedVaultDatabase]steward.steward_transfer.holding_temp_c,
    transferBand: case(
                     equal([test::tealprairie::store::SeedVaultDatabase]steward.steward_transfer.transfer_kind, 'FIELD'),
                     'FIELD_INTAKE',
                     case(
                       equal([test::tealprairie::store::SeedVaultDatabase]steward.steward_transfer.transfer_kind, 'VISIT'),
                       'OUT_ON_VISIT',
                       case(
                         greaterThan([test::tealprairie::store::SeedVaultDatabase]steward.steward_transfer.crate_count, 50),
                         'BULK',
                         case(
                           greaterThan([test::tealprairie::store::SeedVaultDatabase]steward.steward_transfer.crate_count, 20),
                           'LARGE',
                           case(
                             lessThan([test::tealprairie::store::SeedVaultDatabase]steward.steward_transfer.holding_temp_c, -15.0),
                             'DEEP_FROZEN',
                             case(
                               lessThan([test::tealprairie::store::SeedVaultDatabase]steward.steward_transfer.holding_temp_c, 0.0),
                               'CHILLED',
                               case(
                                 isEmpty([test::tealprairie::store::SeedVaultDatabase]steward.steward_transfer.crate_count),
                                 'UNCOUNTED',
                                 case(
                                   equal([test::tealprairie::store::SeedVaultDatabase]steward.steward_transfer.transfer_kind, 'RETURN'),
                                   'RETURNED',
                                   sqlNull()
                                 )
                               )
                             )
                           )
                         )
                       )
                     )
                   ),
    genusLabel: [test::tealprairie::store::SeedVaultDatabase]@Transfer_Collection > @Collection_Taxon > @Taxon_Genus | taxonomy.genus.genus_label,
    familyLabel: [test::tealprairie::store::SeedVaultDatabase]@Transfer_Collection > @Collection_Taxon > @Taxon_Genus > @Genus_Family | taxonomy.family.family_label
  }
