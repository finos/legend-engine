###Relational
Database test::indigoglacier::store::SkyDB
(
  Schema sky
  (
    Table observation
    (
      observation_id INTEGER PRIMARY KEY,
      telescope_code VARCHAR(20) NOT NULL,
      target_name VARCHAR(120) NOT NULL,
      magnitude INTEGER NOT NULL,
      exposure_s INTEGER NOT NULL,
      band VARCHAR(10) NOT NULL,
      observed_on DATE NOT NULL
    )
    Table sighting
    (
      sighting_id INTEGER PRIMARY KEY,
      observation_id INTEGER NOT NULL,
      quality VARCHAR(20) NOT NULL
    )
  )

  Join Observation_Sighting(sky.observation.observation_id = sky.sighting.observation_id)
)
