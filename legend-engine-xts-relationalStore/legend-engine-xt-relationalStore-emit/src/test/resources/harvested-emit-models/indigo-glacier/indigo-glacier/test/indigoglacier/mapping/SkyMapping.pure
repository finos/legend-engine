###Mapping
Mapping test::indigoglacier::mapping::SkyMapping
(
  *test::indigoglacier::domain::Observation[observation]: Relational
  {
    ~primaryKey
    (
      [test::indigoglacier::store::SkyDB]sky.observation.observation_id
    )
    ~mainTable [test::indigoglacier::store::SkyDB]sky.observation
    observationId: [test::indigoglacier::store::SkyDB]sky.observation.observation_id,
    telescopeCode: [test::indigoglacier::store::SkyDB]sky.observation.telescope_code,
    targetName: [test::indigoglacier::store::SkyDB]sky.observation.target_name,
    magnitude: [test::indigoglacier::store::SkyDB]sky.observation.magnitude,
    exposureS: [test::indigoglacier::store::SkyDB]sky.observation.exposure_s,
    band: [test::indigoglacier::store::SkyDB]sky.observation.band,
    sightings[sighting]: [test::indigoglacier::store::SkyDB]@Observation_Sighting
  }

  test::indigoglacier::domain::Sighting[sighting]: Relational
  {
    ~primaryKey
    (
      [test::indigoglacier::store::SkyDB]sky.sighting.sighting_id
    )
    ~mainTable [test::indigoglacier::store::SkyDB]sky.sighting
    sightingId: [test::indigoglacier::store::SkyDB]sky.sighting.sighting_id,
    quality: [test::indigoglacier::store::SkyDB]sky.sighting.quality
  }
)
