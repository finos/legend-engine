import test::indigoglacier::domain::*;

Class {meta::pure::profiles::doc.doc = 'A single telescope observation of a sky target captured in a given spectral band.'} test::indigoglacier::domain::Observation
{
  observationId: Integer[1];
  telescopeCode: String[1];
  targetName: String[1];
  magnitude: Integer[1];
  exposureS: Integer[1];
  band: String[1];
  sightings: Sighting[*];
}

Class {meta::pure::profiles::doc.doc = 'A quality-graded confirmation sighting attached to an observation.'} test::indigoglacier::domain::Sighting
{
  sightingId: Integer[1];
  quality: String[1];
}
