###Relational
Database test::coppercanyon3::store::CanopyDB
(
  Schema canopy
  (
    Table planting_site
    (
      site_code VARCHAR(16) PRIMARY KEY,
      district_name VARCHAR(64),
      surface_type VARCHAR(24)
    )
    Table tree_specimen
    (
      tag_code VARCHAR(16) PRIMARY KEY,
      species_name VARCHAR(96),
      trunk_cm INTEGER,
      planted_year INTEGER,
      site_code VARCHAR(16)
    )
  )

  Join Site_Specimen(canopy.tree_specimen.site_code = canopy.planting_site.site_code)
)
