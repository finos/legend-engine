###Pure
import test::coppercanyon3::domain::*;

Class test::coppercanyon3::domain::PlantingSite
{
  siteCode: String[1];
  districtName: String[1];
  surfaceType: String[1];
}

Class test::coppercanyon3::domain::TreeSpecimen
{
  tagCode: String[1];
  speciesName: String[1];
  trunkCm: Integer[1];
  plantedYear: Integer[1];
  districtName: String[0..1];
  girthBand: String[0..1];
}
