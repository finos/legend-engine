###Mapping
Mapping test::gildedlighthouse2::mapping::HarbourMapping
(
  *test::gildedlighthouse2::domain::LampWatch[watch]: Relational
  {
    watchRef: [test::gildedlighthouse2::store::HarbourDb]harbour.lamp_watch.watch_ref,
    stationCode: [test::gildedlighthouse2::store::HarbourDb]harbour.lamp_watch.station_code,
    keeperCode: [test::gildedlighthouse2::store::HarbourDb]harbour.lamp_watch.keeper_code,
    hoursLit: [test::gildedlighthouse2::store::HarbourDb]harbour.lamp_watch.hours_lit,
    oilUsed: [test::gildedlighthouse2::store::HarbourDb]harbour.lamp_watch.oil_used,
    loggedOn: [test::gildedlighthouse2::store::HarbourDb]harbour.lamp_watch.logged_on,
    watchOrigin: 'KEEPER LOG'
  }
)
