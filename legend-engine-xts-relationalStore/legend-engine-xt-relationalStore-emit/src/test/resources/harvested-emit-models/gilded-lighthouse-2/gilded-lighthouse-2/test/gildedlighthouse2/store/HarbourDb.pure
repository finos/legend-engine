###Relational
Database test::gildedlighthouse2::store::HarbourDb
(
  Schema harbour
  (
    Table lamp_watch
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      watch_id INTEGER PRIMARY KEY,
      watch_ref VARCHAR(20) NOT NULL,
      station_code VARCHAR(12) NOT NULL,
      keeper_code VARCHAR(12) NOT NULL,
      hours_lit INTEGER NOT NULL,
      oil_used FLOAT NOT NULL,
      logged_on DATE NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
  )
)
