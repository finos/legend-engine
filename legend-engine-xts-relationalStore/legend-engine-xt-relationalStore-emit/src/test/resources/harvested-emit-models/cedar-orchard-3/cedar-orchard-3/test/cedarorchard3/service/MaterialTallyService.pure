###Service
Service test::cedarorchard3::service::MaterialTallyService
{
  pattern: '/curation/v1/materials/{wing}';
  title: 'Curator - Material Tally by Wing';
  documentation: 'Counts catalogued exhibits by material for galleries in a given wing, filtering exhibits through the exhibit-to-gallery join and grouping the survivors by material.';
  autoActivateUpdates: true;
  owners:
  [
    'example-curation-team'
  ];
  execution: Single
  {
    query: {wing: String[1]|test::cedarorchard3::domain::Exhibit.all()->filter(
      e|$e.gallery.wing == $wing
    )->groupBy(
      [
        e|$e.material
      ],
      [
        agg(
          e|$e.exhibitId,
          y|$y->count()
        )
      ],
      [
        'Material',
        'Count'
      ]
    )->sort([asc('Material')])};
    mapping: test::cedarorchard3::mapping::CuratorMapping;
    runtime: test::cedarorchard3::runtime::CuratorRuntime;
  }
  testSuites:
  [
    materialTallySuite:
    {
      data:
      [
        connections:
        [
          connection_1:
            Relational
            #{
              MUSEUM.GALLERY:
                'GALLERY_ID,NAME,WING\n'+
                '1,Riverside Hall,North\n'+
                '2,Skylight Court,North\n'+
                '3,Cloister Room,East\n';

              MUSEUM.EXHIBIT:
                'EXHIBIT_ID,GALLERY_ID,TITLE,MATERIAL,ACQUISITION_YEAR\n'+
                '1,1,Woven Reed Basket,TEXTILE,1998\n'+
                '2,1,Glazed Water Jug,CERAMIC,2004\n'+
                '3,2,Carved Cedar Panel,WOOD,2011\n'+
                '4,3,Hammered Copper Bowl,METAL,2007\n';
            }#
        ]
      ]
      tests:
      [
        northWing:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            wing = 'North'
          ]
          asserts:
          [
            groupedByMaterial:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[ {\n  "Material" : "CERAMIC",\n  "Count" : 1\n}, {\n  "Material" : "TEXTILE",\n  "Count" : 1\n}, {\n  "Material" : "WOOD",\n  "Count" : 1\n} ]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
