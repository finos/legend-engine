###Relational
Database test::ivorytundra5::store::StationDb
(
  Schema tundra
  (
    Table station_custodian
    (
      custodian_code VARCHAR(32) PRIMARY KEY,
      custodian_name VARCHAR(120) NOT NULL,
      radio_note VARCHAR(120)
    )
    Table calibration_check
    (
      check_code VARCHAR(32) PRIMARY KEY,
      station_code VARCHAR(32),
      check_result VARCHAR(20) NOT NULL,
      drift_percent FLOAT
    )
    Table observation_station
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      station_code VARCHAR(32) PRIMARY KEY,
      station_name VARCHAR(120) NOT NULL,
      terrain_label VARCHAR(60) NOT NULL,
      custodian_code VARCHAR(32),
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
    Table sensor_deployment
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      deploy_code VARCHAR(32) PRIMARY KEY,
      station_code VARCHAR(32),
      instrument_name VARCHAR(120) NOT NULL,
      sample_interval INTEGER NOT NULL,
      service_state VARCHAR(20) NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
  )

  Join Register_Deployment_Station(tundra.sensor_deployment.station_code = tundra.observation_station.station_code)
  Join Register_Station_Custodian(tundra.observation_station.custodian_code = tundra.station_custodian.custodian_code)
  Join Register_Station_Check(tundra.observation_station.station_code = tundra.calibration_check.station_code)
)
