###Connection
RelationalDatabaseConnection test::russetotter::connection::HoltH2Connection
{
  store: test::russetotter::store::HoltDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists river;',
      'create schema river;',
      'create table river.holt_survey (survey_id integer primary key, reach_code varchar(20) not null, reach_name varchar(120), observer_name varchar(120), habitat_note varchar(240), spraint_tally integer, in_z date not null, out_z date not null, from_z date not null, thru_z date not null);'
      ];
  };
  auth: DefaultH2;
}
