###Relational
Database test::russetotter::store::HoltDB
(
  Schema river
  (
    Table holt_survey
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z),
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )

      survey_id INTEGER PRIMARY KEY,
      reach_code VARCHAR(20) NOT NULL,
      reach_name VARCHAR(120),
      observer_name VARCHAR(120),
      habitat_note VARCHAR(240),
      spraint_tally INTEGER,
      in_z DATE NOT NULL,
      out_z DATE NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
  )
)
