###Pure
function {meta::pure::profiles::doc.doc = 'The mass in kilograms a dressed block has to reach before the yard register reports it, held in one place so the register and the yard notices cannot drift apart.'}
test::copperquarry::function::reportableMassFloorKg(): Integer[1]
{
  500
}

function {meta::pure::profiles::doc.doc = 'The finish label the yard writes on a block that never received one, so the register can tell an undressed block from a dressed one without a null.'}
test::copperquarry::function::undressedFinishLabel(): String[1]
{
  'UNFINISHED'
}
