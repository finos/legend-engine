###Service
Service test::copperquarry::service::DressedBlockRegister
{
  pattern: '/copperquarry/v1/dressed-block-register';
  title: 'Copper Quarry - Dressed Block Register';
  documentation: 'Publishes the dressing yard register as a five-column tabular projection over the dressed block, sorted on the block reference. The reportable mass floor and the label the yard writes on a block that never received a finish are both held in standalone functions the query calls, so the predicate resolves through a function call rather than an inline literal and the plan is a single statement over the yard table. The single-execution binding pins one mapping and one runtime, and the service test drives the whole projection through a referenced relational fixture.';
  ownership: UserList { users: ['stone-yard-register-desk'] };
  autoActivateUpdates: false;
  execution: Single
  {
    query: |test::copperquarry::domain::DressedBlock.all()->filter(
      b|($b.dressedMassKg >= test::copperquarry::function::reportableMassFloorKg()) && ($b.finishLabel != test::copperquarry::function::undressedFinishLabel())
    )->project(
      [
        b|$b.blockRef,
        b|$b.benchCode,
        b|$b.stoneLabel,
        b|$b.dressedMassKg,
        b|$b.finishLabel
      ],
      [
        'Block',
        'Bench',
        'Stone',
        'DressedMass',
        'Finish'
      ]
    )->sort(
      [
        asc('Block')
      ]
    );
    mapping: test::copperquarry::mapping::YardMapping;
    runtime: test::copperquarry::runtime::YardRegisterRuntime;
  }
  testSuites:
  [
    dressedBlockRegisterSuite:
    {
      data:
      [
        connections:
        [
          yardWarehouse:
            Reference
              #{
                test::copperquarry::data::YardFixture
              }#
        ]
      ]
      tests:
      [
        onlyFinishedBlocksOverTheReportableMassSurface:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            singleReportableBlock:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Block":"BK-01","Bench":"BN-A","Stone":"LIMESTONE","DressedMass":750,"Finish":"HONED"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
