###Relational
Database test::borealcove3::store::SeedDepotDb
(
  Schema meadow
  (
    Table seed_lot
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )

      lot_code VARCHAR(16) PRIMARY KEY,
      plot_code VARCHAR(16) NOT NULL,
      taxon_name VARCHAR(128) NOT NULL,
      seed_grams INTEGER NOT NULL,
      state_code VARCHAR(4) NOT NULL,
      from_z DATE PRIMARY KEY,
      thru_z DATE
    )

    Table meadow_plot
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )

      plot_code VARCHAR(16) PRIMARY KEY,
      plot_name VARCHAR(128) NOT NULL,
      habitat_code VARCHAR(4) NOT NULL,
      keeper_code VARCHAR(16) NOT NULL,
      from_z DATE PRIMARY KEY,
      thru_z DATE
    )

    Table seed_keeper
    (
      keeper_code VARCHAR(16) PRIMARY KEY,
      keeper_name VARCHAR(128) NOT NULL,
      contact_note VARCHAR(128)
    )

    Table germination_trial
    (
      trial_code VARCHAR(16) PRIMARY KEY,
      plot_code VARCHAR(16) NOT NULL,
      trial_crew VARCHAR(64)
    )
  )

  Join Lot_Plot(meadow.seed_lot.plot_code = meadow.meadow_plot.plot_code)
  Join Plot_Keeper(meadow.meadow_plot.keeper_code = meadow.seed_keeper.keeper_code)
  Join Plot_Trial(meadow.meadow_plot.plot_code = meadow.germination_trial.plot_code)
)
