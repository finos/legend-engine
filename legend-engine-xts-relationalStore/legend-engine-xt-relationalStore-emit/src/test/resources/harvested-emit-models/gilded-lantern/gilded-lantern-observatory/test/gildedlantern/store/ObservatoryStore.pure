###Relational

Database test::gildedlantern::store::ObservatoryDB
(
  Schema sky
  (
    Table observing_session
    (
      session_id INTEGER PRIMARY KEY,
      session_code VARCHAR(32) NOT NULL,
      site_code VARCHAR(24) NOT NULL,
      observed_on DATE NOT NULL,
      exposure_seconds DOUBLE NOT NULL,
      instrument_code VARCHAR(24) NOT NULL,
      sky_quality INTEGER NOT NULL
    )
    Table telescope_instrument
    (
      instrument_id INTEGER PRIMARY KEY,
      instrument_code VARCHAR(24) NOT NULL,
      instrument_name VARCHAR(120) NOT NULL,
      aperture_meters DOUBLE NOT NULL,
      site_code VARCHAR(24) NOT NULL
    )
  )
)
