###Pure

import test::gildedlantern::profile::*;

Class <<NightSkyProfile.publicSession>> {NightSkyProfile.archiveLabel = 'public-night-log', NightSkyProfile.steward = 'skyward-observatory'} test::gildedlantern::domain::ObservingSession
{
  sessionId: Integer[1];
  <<NightSkyProfile.calibratedInstrument>> sessionCode: String[1];
  siteCode: String[1];
  observedOn: StrictDate[1];
  exposureSeconds: Float[1];
  instrumentCode: String[1];
  skyQuality: Integer[1];
}

Class <<NightSkyProfile.calibratedInstrument>> {NightSkyProfile.archiveLabel = 'instrument-catalogue'} test::gildedlantern::domain::TelescopeInstrument
{
  instrumentId: Integer[1];
  instrumentCode: String[1];
  instrumentName: String[1];
  apertureMeters: Float[1];
  siteCode: String[1];
}
