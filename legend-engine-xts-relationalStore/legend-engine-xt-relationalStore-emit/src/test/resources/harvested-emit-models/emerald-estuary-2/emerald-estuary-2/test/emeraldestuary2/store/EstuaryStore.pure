###Relational
Database test::emeraldestuary2::store::EstuaryStore
(
  include test::emeraldestuary2::store::SiteReferenceStore
  include test::emeraldestuary2::store::SynonymReferenceStore

  Schema estuary
  (
    Table reed_plot
    (
      plot_code VARCHAR(24) PRIMARY KEY,
      plot_seq INTEGER PRIMARY KEY,
      habitat_name VARCHAR(120) NOT NULL,
      reed_cover_pct INTEGER NOT NULL,
      primary_site_code VARCHAR(24) NOT NULL,
      fallback_site_code VARCHAR(24) NOT NULL,
      audit_site_code VARCHAR(24) NOT NULL,
      synonym_code VARCHAR(24) NOT NULL
    )
  )

  Join Plot_PrimarySite(estuary.reed_plot.primary_site_code = siteref.survey_site.site_code)
  Join Plot_FallbackSite(estuary.reed_plot.fallback_site_code = siteref.survey_site.site_code)
  Join Plot_AuditSite(estuary.reed_plot.audit_site_code = siteref.survey_site.site_code)
  Join Plot_Synonym(estuary.reed_plot.synonym_code = synref.species_synonym.synonym_code)
)
