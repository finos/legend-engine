import test::sableridge::domain::*;

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'A monitored coral reef survey station, versioned along a business validity window.'} test::sableridge::domain::ReefStation
{
  stationId: Integer[1];
  stationName: String[1];
  habitatCode: String[1];
  depthMetres: Integer[1];
  displayLabel() {$this.stationName + ' [' + $this.habitatCode + ']'}: String[1];
  depthBand() {if($this.depthMetres >= 30, | 'DEEP', | if($this.depthMetres >= 10, | 'MID', | 'SHALLOW'))}: String[1];
  reefTagged() {$this.habitatCode->startsWith('RF') && !$this.habitatCode->isEmpty()}: Boolean[1];
}
