###Relational
Database test::wistfulaviary2::store::HerbariumDb
(
  Schema garden
  (
    Table accession
    (
      accession_code VARCHAR(20) PRIMARY KEY,
      accession_name VARCHAR(80),
      taxon_code VARCHAR(20),
      received_on DATE,
      lake_in_id INTEGER,
      lake_out_id INTEGER
    )
    Table seed_lot
    (
      accession_code VARCHAR(20) PRIMARY KEY,
      lot_code VARCHAR(20),
      viability_pct INTEGER
    )
    Table taxon
    (
      taxon_code VARCHAR(20) PRIMARY KEY,
      family_name VARCHAR(80)
    )
    Table vault_cell
    (
      cell_code VARCHAR(20) PRIMARY KEY,
      cell_label VARCHAR(80)
    )
    Table accession_cell
    (
      accession_code VARCHAR(20),
      cell_code VARCHAR(20)
    )
  )
  Filter CurrentAccession
  (
    garden.accession.lake_out_id = 999999999
  )
  Join accessionTaxon
  (
    garden.accession.taxon_code = garden.taxon.taxon_code
  )
  Join accessionCell
  (
    garden.accession.accession_code = garden.accession_cell.accession_code
  )
  Join cellVault
  (
    garden.accession_cell.cell_code = garden.vault_cell.cell_code
  )
)
