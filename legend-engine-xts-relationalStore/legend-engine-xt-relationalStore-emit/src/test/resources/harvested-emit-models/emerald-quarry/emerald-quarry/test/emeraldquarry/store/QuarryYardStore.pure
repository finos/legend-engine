###Relational
Database test::emeraldquarry::store::QuarryYardStore
(
  Schema quarry
  (
    Table pit_face
    (
      face_id INTEGER PRIMARY KEY,
      face_code VARCHAR(4000) NOT NULL,
      division_code VARCHAR(4000) NOT NULL,
      face_status VARCHAR(4000) NOT NULL,
      opened_on DATE
    )

    Table pit_face_view
    (
      face_id INTEGER PRIMARY KEY,
      face_code VARCHAR(4000) NOT NULL,
      division_code VARCHAR(4000) NOT NULL,
      source_face_id INTEGER NOT NULL,
      exposure_class VARCHAR(4000) NOT NULL
    )

    Table pit_face_masked
    (
      face_id INTEGER PRIMARY KEY,
      face_code_masked VARCHAR(4000) NOT NULL,
      division_code VARCHAR(4000) NOT NULL
    )

    Table pit_face_staging
    (
      face_id INTEGER PRIMARY KEY,
      face_code VARCHAR(4000) NOT NULL,
      loaded_on DATE
    )

    Table pit_face_history
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )

      face_id INTEGER PRIMARY KEY,
      face_code VARCHAR(4000) NOT NULL,
      division_code VARCHAR(4000) NOT NULL,
      extracted_tonnes INTEGER NOT NULL,
      survey_note VARCHAR(40000),
      in_z DATE PRIMARY KEY,
      out_z DATE
    )

    Table division_lookup
    (
      division_code VARCHAR(4000) PRIMARY KEY,
      division_name VARCHAR(4000) NOT NULL
    )
  )

  Join Face_Division(quarry.pit_face_view.division_code = quarry.division_lookup.division_code)

  Join Face_Source(quarry.pit_face_view.source_face_id = quarry.pit_face.face_id)
)
