###Connection
RelationalDatabaseConnection test::fabledquokka::connection::SanctuaryH2Connection
{
  store: test::fabledquokka::store::SanctuaryDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists sanctuary;',
      'create schema sanctuary;',
      'create table sanctuary.sighting (record_id integer primary key, record_code varchar(20) not null, observer_name varchar(120) not null, zone_name varchar(120) not null, species_name varchar(120) not null, status_code integer not null, count_observed integer not null);'
      ];
  };
  auth: DefaultH2;
}
