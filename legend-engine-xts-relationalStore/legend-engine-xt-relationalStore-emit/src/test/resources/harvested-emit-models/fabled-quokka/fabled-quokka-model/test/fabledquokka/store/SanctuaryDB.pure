###Relational
Database test::fabledquokka::store::SanctuaryDB
(
  Schema sanctuary
  (
    Table sighting
    (
      record_id INTEGER PRIMARY KEY,
      record_code VARCHAR(20) NOT NULL,
      observer_name VARCHAR(120) NOT NULL,
      zone_name VARCHAR(120) NOT NULL,
      species_name VARCHAR(120) NOT NULL,
      status_code INTEGER NOT NULL,
      count_observed INTEGER NOT NULL
    )
  )
)
