import test::fabledquokka::domain::*;

Class {meta::pure::profiles::doc.doc = 'One observation of an animal logged by a volunteer surveyor in a sanctuary zone.'} test::fabledquokka::domain::SightingRecord
{
  recordCode: String[1];
  observerName: String[1];
  zoneName: String[1];
  speciesName: String[1];
  status: SurveyStatus[1];
  countObserved: Integer[1];
  observerLabel() {if($this.observerName->length() > 0, |$this.observerName->toUpper() + ' / ' + $this.zoneName, |'UNATTRIBUTED')}: String[1];
  isPlural() {$this.countObserved >= 2}: Boolean[1];
}
