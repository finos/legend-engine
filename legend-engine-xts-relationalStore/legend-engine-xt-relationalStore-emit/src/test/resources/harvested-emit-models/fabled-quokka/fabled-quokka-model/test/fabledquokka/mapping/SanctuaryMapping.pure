###Mapping
Mapping test::fabledquokka::mapping::SanctuaryMapping
(
  *test::fabledquokka::domain::SightingRecord[sighting]: Relational
  {
    ~primaryKey
    (
      [test::fabledquokka::store::SanctuaryDB]sanctuary.sighting.record_id
    )
    ~mainTable [test::fabledquokka::store::SanctuaryDB]sanctuary.sighting
    recordCode: [test::fabledquokka::store::SanctuaryDB]sanctuary.sighting.record_code,
    observerName: [test::fabledquokka::store::SanctuaryDB]sanctuary.sighting.observer_name,
    zoneName: [test::fabledquokka::store::SanctuaryDB]sanctuary.sighting.zone_name,
    speciesName: [test::fabledquokka::store::SanctuaryDB]sanctuary.sighting.species_name,
    status: EnumerationMapping SurveyStatusMapping: [test::fabledquokka::store::SanctuaryDB]sanctuary.sighting.status_code,
    countObserved: [test::fabledquokka::store::SanctuaryDB]sanctuary.sighting.count_observed
  }

  test::fabledquokka::domain::SurveyStatus: EnumerationMapping SurveyStatusMapping
  {
    CONFIRMED: [1],
    PROVISIONAL: [2]
  }

  testSuites:
  [
    confirmedSightingSuite:
    {
      function: |test::fabledquokka::domain::SightingRecord.all()->filter(
  s|$s.status == test::fabledquokka::domain::SurveyStatus.CONFIRMED
)->project(
  [
    s|$s.recordCode,
    s|$s.zoneName,
    s|$s.speciesName
  ],
  [
    'Record',
    'Zone',
    'Species'
  ]
);
      tests:
      [
        confirmedOnly:
        {
          doc: 'Resolves the enum-typed property through the enumeration mapping so the integral status code is compared, and keeps only confirmed rows.';
          data:
          [
            test::fabledquokka::store::SanctuaryDB:
              Relational
              #{
                sanctuary.sighting:
                  'record_id,record_code,observer_name,zone_name,species_name,status_code,count_observed\n'+
                  '1,SG-0001,Wren Halloway,North Ridge,Spotted Quoll,1,4\n'+
                  '2,SG-0002,Wren Halloway,North Ridge,Sand Goanna,2,1\n'+
                  '3,SG-0003,Otis Pemberton,Salt Marsh,Spotted Quoll,1,2\n';
              }#
          ];
          asserts:
          [
            twoConfirmedRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Record":"SG-0001","Zone":"North Ridge","Species":"Spotted Quoll"},{"Record":"SG-0003","Zone":"Salt Marsh","Species":"Spotted Quoll"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
