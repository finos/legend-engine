###Mapping
Mapping test::coppergecko3::mapping::HiveTallyMapping
(
  include mapping test::coppergecko3::mapping::ApiaryRegisterMapping

  *test::coppergecko3::domain::HiveMiteTally[hiveTally]: Relational
  {
    ~primaryKey
    (
      [test::coppergecko3::store::ApiaryDb]apiary.hive_mite_tally.hive_code
    )
    ~mainTable [test::coppergecko3::store::ApiaryDb]apiary.hive_mite_tally
    hiveCode: [test::coppergecko3::store::ApiaryDb]apiary.hive_mite_tally.hive_code,
    walkCount: [test::coppergecko3::store::ApiaryDb]apiary.hive_mite_tally.walk_count,
    peakMiteCount: [test::coppergecko3::store::ApiaryDb]apiary.hive_mite_tally.peak_mite_count,
    broodTotal: [test::coppergecko3::store::ApiaryDb]apiary.hive_mite_tally.brood_total,
    lineageBand: case(equal([test::coppergecko3::store::ApiaryDb]@Tally_Hive | [test::coppergecko3::store::ApiaryDb]apiary.hive.queen_line, 'QL-ALPINE'), 'HARDY_ALPINE', case(equal([test::coppergecko3::store::ApiaryDb]@Tally_Hive | [test::coppergecko3::store::ApiaryDb]apiary.hive.queen_line, 'QL-BOREAL'), 'HARDY_BOREAL', case(equal([test::coppergecko3::store::ApiaryDb]@Tally_Hive | [test::coppergecko3::store::ApiaryDb]apiary.hive.queen_line, 'QL-CORAL'), 'GENTLE_CORAL', case(equal([test::coppergecko3::store::ApiaryDb]@Tally_Hive | [test::coppergecko3::store::ApiaryDb]apiary.hive.queen_line, 'QL-DUNE'), 'GENTLE_DUNE', case(equal([test::coppergecko3::store::ApiaryDb]@Tally_Hive | [test::coppergecko3::store::ApiaryDb]apiary.hive.queen_line, 'QL-EMBER'), 'BRISK_EMBER', case(equal([test::coppergecko3::store::ApiaryDb]@Tally_Hive | [test::coppergecko3::store::ApiaryDb]apiary.hive.queen_line, 'QL-FERN'), 'BRISK_FERN', case(equal([test::coppergecko3::store::ApiaryDb]@Tally_Hive | [test::coppergecko3::store::ApiaryDb]apiary.hive.queen_line, 'QL-GROVE'), 'CALM_GROVE', case(equal([test::coppergecko3::store::ApiaryDb]@Tally_Hive | [test::coppergecko3::store::ApiaryDb]apiary.hive.queen_line, 'QL-HEATH'), 'CALM_HEATH', sqlNull())))))))),
    pressureFlag: case(greaterThan([test::coppergecko3::store::ApiaryDb]apiary.hive_mite_tally.peak_mite_count, 30), 'TREAT', 'WATCH'),
    siteName: [test::coppergecko3::store::ApiaryDb]@Tally_Hive > @Hive_Site | [test::coppergecko3::store::ApiaryDb]apiary.apiary_site.site_name,
    districtName: [test::coppergecko3::store::ApiaryDb]@Tally_Hive > @Hive_Site > @Site_District | [test::coppergecko3::store::ApiaryDb]apiary.district.district_name
  }

  testSuites:
  [
    hiveMiteTallySuite:
    {
      function: |test::coppergecko3::domain::HiveMiteTally.all()->project(
  [
    col(t|$t.hiveCode, 'HiveCode'),
    col(t|$t.walkCount, 'WalkCount'),
    col(t|$t.peakMiteCount, 'PeakMiteCount'),
    col(t|$t.broodTotal, 'BroodTotal'),
    col(t|$t.lineageBand, 'LineageBand'),
    col(t|$t.pressureFlag, 'PressureFlag'),
    col(t|$t.siteName, 'SiteName'),
    col(t|$t.districtName, 'DistrictName')
  ]
)->sort([asc('HiveCode')]);
      tests:
      [
        everyLineageArmOverTheGroupedTally:
        {
          doc: 'Reads the per-hive tally the grouped view folds out of the inspection walks, one hive per lineage arm of the eight-way queen-line cascade, one hive whose line falls outside the cascade and resolves to the null sentinel, and one hive whose apiary is not in the register so the two- and three-hop site and district paths have nothing to reach; the pressure flag splits on the peak mite count.';
          data:
          [
            test::coppergecko3::store::ApiaryDb:
              Relational
              #{
                apiary.hive_inspection:
                  'inspection_ref,hive_code,inspected_on,frames_of_brood,mite_count,inspector_name,site_note\n'+
                  'IN-11,HV-01,2031-06-01,6,12,A. Marsh,\n'+
                  'IN-12,HV-01,2031-06-15,7,35,A. Marsh,\n'+
                  'IN-13,HV-02,2031-06-02,5,8,B. Lowe,\n'+
                  'IN-14,HV-03,2031-06-03,4,22,C. Reed,\n'+
                  'IN-15,HV-03,2031-06-17,6,18,C. Reed,\n'+
                  'IN-16,HV-04,2031-06-04,9,41,A. Marsh,\n'+
                  'IN-17,HV-05,2031-06-05,3,5,B. Lowe,\n'+
                  'IN-18,HV-06,2031-06-06,8,30,C. Reed,\n'+
                  'IN-19,HV-06,2031-06-20,8,31,C. Reed,\n'+
                  'IN-20,HV-07,2031-06-07,2,50,A. Marsh,\n'+
                  'IN-21,HV-08,2031-06-08,7,14,B. Lowe,\n'+
                  'IN-22,HV-09,2031-06-09,5,33,C. Reed,\n'+
                  'IN-23,HV-10,2031-06-10,6,9,A. Marsh,\n'+
                  'IN-24,HV-10,2031-06-24,4,27,A. Marsh,\n';
                apiary.hive:
                  'hive_code,apiary_code,queen_line,install_year\n'+
                  'HV-01,AP-01,QL-ALPINE,2029\n'+
                  'HV-02,AP-01,QL-BOREAL,2030\n'+
                  'HV-03,AP-02,QL-CORAL,2028\n'+
                  'HV-04,AP-02,QL-DUNE,2031\n'+
                  'HV-05,AP-03,QL-EMBER,2030\n'+
                  'HV-06,AP-03,QL-FERN,2029\n'+
                  'HV-07,AP-01,QL-GROVE,2031\n'+
                  'HV-08,AP-02,QL-HEATH,2030\n'+
                  'HV-09,AP-03,QL-WILD,2027\n'+
                  'HV-10,AP-09,QL-BOREAL,2031\n';
                apiary.apiary_site:
                  'apiary_code,site_name,district_code\n'+
                  'AP-01,Ridge Meadow Apiary,D-01\n'+
                  'AP-02,Sedge Hollow Apiary,D-02\n'+
                  'AP-03,Bracken Knoll Apiary,D-01\n';
                apiary.district:
                  'district_code,district_name,region_name\n'+
                  'D-01,Upper Ridge,North Region\n'+
                  'D-02,Willow Vale,North Region\n';
              }#
          ];
          asserts:
          [
            tallyRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"HiveCode":"HV-01","WalkCount":2,"PeakMiteCount":35,"BroodTotal":13,"LineageBand":"HARDY_ALPINE","PressureFlag":"TREAT","SiteName":"Ridge Meadow Apiary","DistrictName":"Upper Ridge"},{"HiveCode":"HV-02","WalkCount":1,"PeakMiteCount":8,"BroodTotal":5,"LineageBand":"HARDY_BOREAL","PressureFlag":"WATCH","SiteName":"Ridge Meadow Apiary","DistrictName":"Upper Ridge"},{"HiveCode":"HV-03","WalkCount":2,"PeakMiteCount":22,"BroodTotal":10,"LineageBand":"GENTLE_CORAL","PressureFlag":"WATCH","SiteName":"Sedge Hollow Apiary","DistrictName":"Willow Vale"},{"HiveCode":"HV-04","WalkCount":1,"PeakMiteCount":41,"BroodTotal":9,"LineageBand":"GENTLE_DUNE","PressureFlag":"TREAT","SiteName":"Sedge Hollow Apiary","DistrictName":"Willow Vale"},{"HiveCode":"HV-05","WalkCount":1,"PeakMiteCount":5,"BroodTotal":3,"LineageBand":"BRISK_EMBER","PressureFlag":"WATCH","SiteName":"Bracken Knoll Apiary","DistrictName":"Upper Ridge"},{"HiveCode":"HV-06","WalkCount":2,"PeakMiteCount":31,"BroodTotal":16,"LineageBand":"BRISK_FERN","PressureFlag":"TREAT","SiteName":"Bracken Knoll Apiary","DistrictName":"Upper Ridge"},{"HiveCode":"HV-07","WalkCount":1,"PeakMiteCount":50,"BroodTotal":2,"LineageBand":"CALM_GROVE","PressureFlag":"TREAT","SiteName":"Ridge Meadow Apiary","DistrictName":"Upper Ridge"},{"HiveCode":"HV-08","WalkCount":1,"PeakMiteCount":14,"BroodTotal":7,"LineageBand":"CALM_HEATH","PressureFlag":"WATCH","SiteName":"Sedge Hollow Apiary","DistrictName":"Willow Vale"},{"HiveCode":"HV-09","WalkCount":1,"PeakMiteCount":33,"BroodTotal":5,"LineageBand":null,"PressureFlag":"TREAT","SiteName":"Bracken Knoll Apiary","DistrictName":"Upper Ridge"},{"HiveCode":"HV-10","WalkCount":2,"PeakMiteCount":27,"BroodTotal":10,"LineageBand":"HARDY_BOREAL","PressureFlag":"WATCH","SiteName":null,"DistrictName":null}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
