###Runtime
Runtime test::coppergecko3::runtime::ApiaryPrimaryRuntime
{
  mappings:
  [
    test::coppergecko3::mapping::HiveInspectionMapping
  ];
  connections:
  [
    test::coppergecko3::store::ApiaryDb:
    [
      primary: test::coppergecko3::connection::ApiaryPrimaryConnection
    ]
  ];
}

Runtime test::coppergecko3::runtime::ApiaryReplicaRuntime
{
  mappings:
  [
    test::coppergecko3::mapping::HiveInspectionMapping
  ];
  connections:
  [
    test::coppergecko3::store::ApiaryDb:
    [
      replica: test::coppergecko3::connection::ApiaryReplicaConnection
    ]
  ];
}
