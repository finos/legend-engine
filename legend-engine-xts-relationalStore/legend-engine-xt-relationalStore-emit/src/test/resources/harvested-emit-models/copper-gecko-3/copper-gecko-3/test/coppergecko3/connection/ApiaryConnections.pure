###Connection
RelationalDatabaseConnection test::coppergecko3::connection::ApiaryPrimaryConnection
{
  store: test::coppergecko3::store::ApiaryDb;
  type: MemSQL;
  specification: Static
  {
    name: 'apiary_register';
    host: 'apiary-primary.example.internal';
    port: 3306;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'memsql/apiary-primary.example.internal';
  };
}

RelationalDatabaseConnection test::coppergecko3::connection::ApiaryReplicaConnection
{
  store: test::coppergecko3::store::ApiaryDb;
  type: MemSQL;
  specification: Static
  {
    name: 'apiary_register';
    host: 'apiary-replica.example.internal';
    port: 3306;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'memsql/apiary-replica.example.internal';
  };
}
