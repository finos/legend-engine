###Relational
Database test::cedaraviary4::store::TramwayDb
(
  Schema tramway
  (
    Table region
    (
      region_id INTEGER PRIMARY KEY,
      region_name VARCHAR(80)
    )

    Table tram_line
    (
      line_id INTEGER PRIMARY KEY,
      line_name VARCHAR(120),
      region_id INTEGER NOT NULL,
      gauge_code VARCHAR(12)
    )

    Table depot
    (
      depot_id INTEGER PRIMARY KEY,
      depot_name VARCHAR(120) NOT NULL,
      line_id INTEGER NOT NULL,
      region_id INTEGER NOT NULL,
      shelter_code VARCHAR(12)
    )

    Table tram_car
    (
      car_id INTEGER PRIMARY KEY,
      car_ref VARCHAR(24) NOT NULL,
      depot_id INTEGER NOT NULL,
      livery_code VARCHAR(12),
      seat_count INTEGER NOT NULL,
      status_code VARCHAR(12) NOT NULL,
      retired_ts TIMESTAMP
    )

    Table service_entry
    (
      entry_id INTEGER PRIMARY KEY,
      car_id INTEGER NOT NULL,
      entry_note VARCHAR(200),
      logged_on DATE
    )
  )

  Filter RunningCars(tramway.tram_car.status_code = 'ACTIVE' and isNull(tramway.tram_car.retired_ts))

  Join Car_Depot(tramway.tram_car.depot_id = tramway.depot.depot_id)

  Join Depot_Line(tramway.depot.line_id = tramway.tram_line.line_id)

  Join Line_Region(tramway.tram_line.region_id = tramway.region.region_id)

  Join Car_Entry(tramway.tram_car.car_id = tramway.service_entry.car_id)
)
