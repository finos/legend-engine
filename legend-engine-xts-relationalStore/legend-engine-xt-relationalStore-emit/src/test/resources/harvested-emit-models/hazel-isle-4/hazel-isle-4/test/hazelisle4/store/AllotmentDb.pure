###Relational
Database test::hazelisle4::store::AllotmentDb
(
  Schema island
  (
    Table allotment_plot
    (
      plot_code VARCHAR(16) PRIMARY KEY,
      plot_name VARCHAR(96) NOT NULL,
      grower_code VARCHAR(16) NOT NULL,
      bed_count INTEGER NOT NULL,
      soil_code VARCHAR(16),
      tenure_code VARCHAR(16),
      notice_text VARCHAR(120) NOT NULL
    )
    Table tool_shed
    (
      shed_code VARCHAR(16) PRIMARY KEY,
      shed_name VARCHAR(96) NOT NULL,
      shed_kind_code VARCHAR(16),
      shelf_count INTEGER NOT NULL,
      plate_text VARCHAR(120) NOT NULL
    )
    Table grower
    (
      grower_code VARCHAR(16) PRIMARY KEY,
      grower_name VARCHAR(96) NOT NULL,
      parish_name VARCHAR(96) NOT NULL
    )
  )
)
