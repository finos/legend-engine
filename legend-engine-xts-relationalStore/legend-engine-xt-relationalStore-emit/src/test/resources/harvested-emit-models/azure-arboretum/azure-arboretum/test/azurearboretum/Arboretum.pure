  ModelStore
  #{
    demo::azurearboretum::RawReview: ExternalFormat
    #{
      contentType: 'application/json';
      data: '[{"inspectionCode":"I01","specimenId":101,"tallyText":"3","phase":"SEED","watered":"YES","groupCode":"TREE","noteCode":"OK","releaseCode":"READY","validCode":"VALID"},{"inspectionCode":"I02","specimenId":102,"tallyText":"4","phase":"SPROUT","watered":"NO","groupCode":"TREE","noteCode":"OK","releaseCode":"READY","validCode":"VALID"},{"inspectionCode":"I03","specimenId":103,"tallyText":"5","phase":"LEAF","watered":"NO","groupCode":"TREE","noteCode":"OK","releaseCode":"READY","validCode":"VALID"},{"inspectionCode":"I04","specimenId":104,"tallyText":"6","phase":"BUD","watered":"YES","groupCode":"TREE","noteCode":"OK","releaseCode":"READY","validCode":"VALID"},{"inspectionCode":"I05","specimenId":105,"tallyText":"7","phase":"FLOWER","watered":"YES","groupCode":"TREE","noteCode":"OK","releaseCode":"READY","validCode":"VALID"},{"inspectionCode":"I06","specimenId":106,"tallyText":"8","phase":"FRUIT","watered":"YES","groupCode":"TREE","noteCode":"OK","releaseCode":"READY","validCode":"VALID"},{"inspectionCode":"I07","specimenId":107,"tallyText":"9","phase":"REST","watered":"YES","groupCode":"TREE","noteCode":"OK","releaseCode":"READY","validCode":"VALID"},{"inspectionCode":"I08","specimenId":108,"tallyText":"10","phase":"DORMANT","watered":"YES","groupCode":"TREE","noteCode":"OK","releaseCode":"READY","validCode":"VALID"},{"inspectionCode":"I09","specimenId":109,"tallyText":"11","phase":null,"watered":"YES","groupCode":"TREE","noteCode":"OK","releaseCode":"READY","validCode":"VALID"},{"inspectionCode":"I10","specimenId":110,"tallyText":"12","phase":null,"watered":"YES","groupCode":"TREE","noteCode":"OK","releaseCode":"READY","validCode":"VALID"},{"inspectionCode":"I11","specimenId":101,"tallyText":"3","phase":"SEED","watered":"YES","groupCode":"TREE","noteCode":"NO","releaseCode":"READY","validCode":"VALID"},{"inspectionCode":"I12","specimenId":101,"tallyText":"3","phase":"SEED","watered":"YES","groupCode":"SHRUB","noteCode":"OK","releaseCode":"READY","validCode":"VALID"},{"inspectionCode":"I13","specimenId":101,"tallyText":"3","phase":"SEED","watered":"YES","groupCode":"TREE","noteCode":"OK","releaseCode":"WAIT","validCode":"VALID"},{"inspectionCode":"I14","specimenId":101,"tallyText":"3","phase":"SEED","watered":"YES","groupCode":"TREE","noteCode":"OK","releaseCode":"READY","validCode":"INVALID"},{"inspectionCode":"I15","specimenId":101,"tallyText":"3","phase":"SEED","watered":"UNKNOWN","groupCode":"TREE","noteCode":"OK","releaseCode":"READY","validCode":"VALID"}]';
    }#
  }#
}

