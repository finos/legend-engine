###Mapping
Mapping test::noblecavern8::mapping::CavernRegisterMapping
(
  include test::noblecavern8::mapping::CavernStationMapping

  testSuites:
  [
    passageLegRegisterSuite:
    {
      function: |test::noblecavern8::domain::PassageLeg.all()->project(
        [
          col(l|$l.legRef, 'Leg'),
          col(l|$l.lengthMetres, 'LengthM'),
          col(l|$l.run.runRef, 'Run'),
          col(l|$l.run.crew.crewName, 'Crew'),
          col(l|$l.run.surveyedSystem.systemName, 'System'),
          col(l|$l.run.surveyedSystem.regionName, 'Region')
        ]
      )->sort([asc('Leg')]);
      tests:
      [
        legReachesRunCrewAndSystem:
        {
          doc: 'Projects the single measured passage leg together with the run it belongs to, the crew reached across the crew schema and the cave system reached across the reference schema, and the gazetteer name reached through a join-reached property, so every inner join in the register chain is exercised in one row.';
          data:
          [
            test::noblecavern8::store::CavernSurveyDb:
              Relational
              #{
                ref.cave_system:
                  'system_id,system_code,system_name,karst_region\n'+
                  '1,NC-1,Noble Cavern System,KR-NORTH\n'+
                  '2,NC-2,Sinking Brook System,KR-SOUTH\n';

                ref.access_permit:
                  'permit_id,system_code,permit_ref,permit_holder\n'+
                  '1,NC-1,PM-1,north karst club\n';

                gazetteer.karst_region:
                  'region_code,region_name\n'+
                  'KR-NORTH,Northern Karst Uplands\n'+
                  'KR-SOUTH,Southern Karst Basin\n';


                survey.survey_run:
                  'run_id,run_ref,system_code,crew_code,surveyed_on\n'+
                  '1,SR-1,NC-1,CR-1,2026-05-04\n'+
                  '2,SR-2,NC-2,CR-2,2026-05-11\n';

                survey.passage_leg:
                  'leg_id,leg_ref,run_ref,length_m,depth_m\n'+
                  '1,LG-1,SR-1,120,45\n';

                survey.station_reading:
                  'reading_id,station_ref,leg_ref,azimuth_deg,inclination_deg\n'+
                  '1,ST-1,LG-1,180,12\n';

                crew.survey_crew:
                  'crew_id,crew_code,crew_name,base_camp\n'+
                  '1,CR-1,North Karst Crew,Ridge Camp\n'+
                  '2,CR-2,Sinking Brook Crew,Brook Camp\n';
              }#
          ];
          asserts:
          [
            rows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Leg":"LG-1","LengthM":120,"Run":"SR-1","Crew":"North Karst Crew","System":"Noble Cavern System","Region":"Northern Karst Uplands"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
