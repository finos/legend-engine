###Mapping
Mapping test::noblecavern8::mapping::CavernStationMapping
(
  include test::noblecavern8::mapping::CavernSurveyMapping

  *test::noblecavern8::domain::StationReading[stationReading]: Relational
  {
    ~primaryKey
    (
      [test::noblecavern8::store::CavernSurveyDb]survey.station_reading.reading_id
    )
    ~mainTable [test::noblecavern8::store::CavernSurveyDb]survey.station_reading
    stationRef: [test::noblecavern8::store::CavernSurveyDb]survey.station_reading.station_ref,
    azimuthDegrees: [test::noblecavern8::store::CavernSurveyDb]survey.station_reading.azimuth_deg,
    inclinationDegrees: [test::noblecavern8::store::CavernSurveyDb]survey.station_reading.inclination_deg
  }

  test::noblecavern8::domain::PassageLegReadings: Relational
  {
    AssociationMapping
    (
      readings[passageLeg, stationReading]: [test::noblecavern8::store::CavernSurveyDb]@Leg_Reading,
      leg[stationReading, passageLeg]: [test::noblecavern8::store::CavernSurveyDb]@Leg_Reading
    )
  }
)
