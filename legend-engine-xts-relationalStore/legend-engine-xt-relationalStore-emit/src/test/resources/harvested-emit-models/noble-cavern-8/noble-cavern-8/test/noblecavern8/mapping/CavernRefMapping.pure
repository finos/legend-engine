###Mapping
Mapping test::noblecavern8::mapping::CavernRefMapping
(
  *test::noblecavern8::domain::CaveSystem[caveSystem]: Relational
  {
    ~primaryKey
    (
      [test::noblecavern8::store::CavernRefDb]ref.cave_system.system_id
    )
    ~mainTable [test::noblecavern8::store::CavernRefDb]ref.cave_system
    systemCode: [test::noblecavern8::store::CavernRefDb]ref.cave_system.system_code,
    systemName: [test::noblecavern8::store::CavernRefDb]ref.cave_system.system_name,
    karstRegion: [test::noblecavern8::store::CavernRefDb]ref.cave_system.karst_region,
    regionName: [test::noblecavern8::store::CavernRefDb]@CaveSystem_Region | gazetteer.karst_region.region_name
  }

  *test::noblecavern8::domain::AccessPermit[accessPermit]: Relational
  {
    ~primaryKey
    (
      [test::noblecavern8::store::CavernRefDb]ref.access_permit.permit_id
    )
    ~mainTable [test::noblecavern8::store::CavernRefDb]ref.access_permit
    permitRef: [test::noblecavern8::store::CavernRefDb]ref.access_permit.permit_ref,
    permitHolder: [test::noblecavern8::store::CavernRefDb]ref.access_permit.permit_holder
  }

  test::noblecavern8::domain::CaveSystemPermits: Relational
  {
    AssociationMapping
    (
      permits[caveSystem, accessPermit]: [test::noblecavern8::store::CavernRefDb]@CaveSystem_Permit,
      system[accessPermit, caveSystem]: [test::noblecavern8::store::CavernRefDb]@CaveSystem_Permit
    )
  }
)
