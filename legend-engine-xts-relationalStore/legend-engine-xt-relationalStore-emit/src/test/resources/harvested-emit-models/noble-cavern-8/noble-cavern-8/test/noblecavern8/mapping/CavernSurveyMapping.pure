###Mapping
Mapping test::noblecavern8::mapping::CavernSurveyMapping
(
  include test::noblecavern8::mapping::CavernRefMapping
  include test::noblecavern8::mapping::CavernCrewMapping

  *test::noblecavern8::domain::SurveyRun[surveyRun]: Relational
  {
    ~primaryKey
    (
      [test::noblecavern8::store::CavernSurveyDb]survey.survey_run.run_id
    )
    ~mainTable [test::noblecavern8::store::CavernSurveyDb]survey.survey_run
    runRef: [test::noblecavern8::store::CavernSurveyDb]survey.survey_run.run_ref,
    surveyedOn: [test::noblecavern8::store::CavernSurveyDb]survey.survey_run.surveyed_on
  }

  *test::noblecavern8::domain::PassageLeg[passageLeg]: Relational
  {
    ~primaryKey
    (
      [test::noblecavern8::store::CavernSurveyDb]survey.passage_leg.leg_id
    )
    ~mainTable [test::noblecavern8::store::CavernSurveyDb]survey.passage_leg
    legRef: [test::noblecavern8::store::CavernSurveyDb]survey.passage_leg.leg_ref,
    lengthMetres: [test::noblecavern8::store::CavernSurveyDb]survey.passage_leg.length_m,
    depthMetres: [test::noblecavern8::store::CavernSurveyDb]survey.passage_leg.depth_m
  }

  test::noblecavern8::domain::SurveyRunLegs: Relational
  {
    AssociationMapping
    (
      legs[surveyRun, passageLeg]: [test::noblecavern8::store::CavernSurveyDb]@Run_Leg,
      run[passageLeg, surveyRun]: [test::noblecavern8::store::CavernSurveyDb]@Run_Leg
    )
  }

  test::noblecavern8::domain::SurveyRunCrew: Relational
  {
    AssociationMapping
    (
      crew[surveyRun, surveyCrew]: [test::noblecavern8::store::CavernSurveyDb]@Run_Crew,
      crewRuns[surveyCrew, surveyRun]: [test::noblecavern8::store::CavernSurveyDb]@Run_Crew
    )
  }

  test::noblecavern8::domain::SurveyRunSystem: Relational
  {
    AssociationMapping
    (
      surveyedSystem[surveyRun, caveSystem]: [test::noblecavern8::store::CavernSurveyDb]@Run_System,
      runs[caveSystem, surveyRun]: [test::noblecavern8::store::CavernSurveyDb]@Run_System
    )
  }
)
