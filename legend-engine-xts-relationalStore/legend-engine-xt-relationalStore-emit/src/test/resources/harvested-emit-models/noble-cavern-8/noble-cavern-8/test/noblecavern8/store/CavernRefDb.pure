###Relational
Database test::noblecavern8::store::CavernRefDb
(
  Schema ref
  (
    Table cave_system
    (
      system_id INTEGER PRIMARY KEY,
      system_code VARCHAR(20) NOT NULL,
      system_name VARCHAR(60) NOT NULL,
      karst_region VARCHAR(40) NOT NULL
    )

    Table access_permit
    (
      permit_id INTEGER PRIMARY KEY,
      system_code VARCHAR(20) NOT NULL,
      permit_ref VARCHAR(20) NOT NULL,
      permit_holder VARCHAR(60) NOT NULL
    )
  )

  Schema gazetteer
  (
    Table karst_region
    (
      region_code VARCHAR(20) PRIMARY KEY,
      region_name VARCHAR(60) NOT NULL
    )
  )

  Join CaveSystem_Permit(equal(ref.cave_system.system_code, ref.access_permit.system_code))

  Join CaveSystem_Region(equal(ref.cave_system.karst_region, gazetteer.karst_region.region_code))
)
