###Relational
Database test::azurelighthouse4::store::SkateparkDb
(
  Schema skatepark
  (
    Table inspection_visit
    (
      visit_code VARCHAR(24) PRIMARY KEY,
      park_code VARCHAR(24) NOT NULL,
      ward_name VARCHAR(40) NOT NULL,
      route_kind VARCHAR(24) NOT NULL,
      visit_grade VARCHAR(16) NOT NULL,
      ramp_count INTEGER NOT NULL,
      repair_points INTEGER NOT NULL,
      walked_on DATE NOT NULL
    )
    Table visit_finding
    (
      finding_code VARCHAR(24) PRIMARY KEY,
      visit_code VARCHAR(24) NOT NULL,
      finding_grade VARCHAR(16) NOT NULL,
      crack_metres DOUBLE NOT NULL
    )
  )
  Join Visit_Finding(skatepark.inspection_visit.visit_code = skatepark.visit_finding.visit_code)
)
