###Pure
import test::azurelighthouse4::domain::*;
import test::azurelighthouse4::profile::*;

Class <<ParkGovernance.published, ParkClassification.outdoorPark>> {ParkGovernance.owner = 'skatepark-upkeep', ParkClassification.surface = 'poured-concrete'} test::azurelighthouse4::domain::InspectionVisit
{
  visitCode: String[1];
  parkCode: String[1];
  wardName: String[1];
  routeKind: String[1];
  visitGrade: String[1];
  rampCount: Integer[1];
  repairPoints: Integer[1];
  walkedOn: StrictDate[1];
}

Class <<ParkInspection.walkedRoute>> {ParkGovernance.steward = 'upkeep-crew', ParkInspection.inspectedBy = 'ward-inspector'} test::azurelighthouse4::domain::VisitFinding
{
  findingCode: String[1];
  visitCode: String[1];
  findingGrade: String[1];
  crackMetres: Float[1];
}

Association test::azurelighthouse4::domain::Visit_Finding
{
  findings: VisitFinding[*];
  walkedVisit: InspectionVisit[1];
}
