###Pure
import test::cedarlantern::domain::*;

Enum test::cedarlantern::domain::GlassKind
{
  FRESNEL,
  PRISM,
  PLAIN
}

Class {meta::pure::profiles::doc.doc = 'One night of lamp tending booked against a harbour lantern, banded by the wick length it was trimmed to.'} test::cedarlantern::domain::LanternService
{
  serviceCode: String[1];
  serviceName: String[0..1];
  wickMm: Integer[0..1];
  burnHours: Integer[0..1];
  wickBand: String[0..1];
  glassLabel: String[0..1];
  burnScore: Integer[0..1];
  sourceLabel: String[0..1];
  towerName: String[0..1];
  keeperPost: String[0..1];
  glass: GlassKind[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A harbour tower carrying a lantern, tended by a named keeper.'} test::cedarlantern::domain::LanternTower
{
  towerCode: String[1];
  towerName: String[1];
}
