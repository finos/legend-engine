###Relational
Database test::verdantquokka4::store::ReefSiteDb
(
  Schema site
  (
    Table reef_site
    (
      region_code VARCHAR(8) PRIMARY KEY,
      site_code VARCHAR(12) PRIMARY KEY,
      site_name VARCHAR(64) NOT NULL,
      depth_m DOUBLE
    )
    Table site_condition
    (
      milestoning
      (
        business(BUS_FROM = valid_from, BUS_THRU = valid_thru)
      )
      region_code VARCHAR(8) PRIMARY KEY,
      site_code VARCHAR(12) PRIMARY KEY,
      water_temp_c DOUBLE NOT NULL,
      visibility_m DOUBLE,
      valid_from DATE,
      valid_thru DATE
    )
  )
)

Database test::verdantquokka4::store::ReefTaxonDb
(
  Schema taxa
  (
    Table taxon_status
    (
      milestoning
      (
        business(BUS_FROM = valid_from, BUS_THRU = valid_thru)
      )
      taxon_code VARCHAR(12) PRIMARY KEY,
      region_code VARCHAR(8) PRIMARY KEY,
      status_code VARCHAR(12) NOT NULL,
      colony_form VARCHAR(24),
      valid_from DATE,
      valid_thru DATE
    )
  )
)

Database test::verdantquokka4::store::ReefCrewDb
(
  Schema crew
  (
    Table diver_permit
    (
      milestoning
      (
        business(BUS_FROM = valid_from, BUS_THRU = valid_thru)
      )
      diver_code VARCHAR(12) PRIMARY KEY,
      permit_no INTEGER PRIMARY KEY,
      diver_name VARCHAR(64) NOT NULL,
      depth_limit_m DOUBLE NOT NULL,
      valid_from DATE,
      valid_thru DATE
    )
  )
)

Database test::verdantquokka4::store::ReefSurveyDb
(
  include test::verdantquokka4::store::ReefSiteDb

  Schema dive
  (
    Table transect
    (
      region_code VARCHAR(8) PRIMARY KEY,
      site_code VARCHAR(12) PRIMARY KEY,
      transect_no INTEGER PRIMARY KEY,
      length_m DOUBLE NOT NULL,
      width_m DOUBLE NOT NULL
    )
    Table sighting
    (
      sighting_id INTEGER PRIMARY KEY,
      taxon_name VARCHAR(64) NOT NULL,
      count_seen INTEGER NOT NULL
    )
    Table coral_sighting
    (
      sighting_id INTEGER PRIMARY KEY,
      region_code VARCHAR(8) NOT NULL,
      site_code VARCHAR(12) NOT NULL,
      transect_no INTEGER NOT NULL,
      taxon_name VARCHAR(64) NOT NULL,
      count_seen INTEGER NOT NULL,
      cover_pct DOUBLE
    )
    Table fish_sighting
    (
      sighting_id INTEGER PRIMARY KEY,
      site_code VARCHAR(12) NOT NULL,
      taxon_name VARCHAR(64) NOT NULL,
      count_seen INTEGER NOT NULL,
      mean_length_cm DOUBLE
    )
  )

  Join Transect_Site
  (
    dive.transect.site_code = [test::verdantquokka4::store::ReefSiteDb]site.reef_site.site_code
  )

  Join Fish_Site
  (
    dive.fish_sighting.site_code = [test::verdantquokka4::store::ReefSiteDb]site.reef_site.site_code
  )

  Join Coral_Transect
  (
    dive.coral_sighting.region_code = dive.transect.region_code
      and dive.coral_sighting.site_code = dive.transect.site_code
      and dive.coral_sighting.transect_no = dive.transect.transect_no
  )
)
