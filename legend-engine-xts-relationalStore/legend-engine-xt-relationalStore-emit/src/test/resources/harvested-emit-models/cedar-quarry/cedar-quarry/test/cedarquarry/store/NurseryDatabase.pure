###Relational
Database test::cedarquarry::store::NurseryDatabase
(
  Schema nursery
  (
    Table seedling_lot
    (
      lot_code VARCHAR(40) PRIMARY KEY,
      bed_code VARCHAR(40) NOT NULL,
      species_code VARCHAR(40) NOT NULL,
      grade_code VARCHAR(20),
      height_cm INTEGER,
      moisture_pct INTEGER,
      leaf_count INTEGER,
      seedling_count INTEGER
    )

    Table bed
    (
      bed_code VARCHAR(40) PRIMARY KEY,
      bed_name VARCHAR(200) NOT NULL,
      greenhouse_code VARCHAR(40),
      propagator_code VARCHAR(40),
      aspect VARCHAR(40),
      capacity INTEGER,
      active_flag VARCHAR(1)
    )

    Table species
    (
      species_code VARCHAR(40) PRIMARY KEY,
      species_name VARCHAR(200) NOT NULL,
      leaf_habit VARCHAR(40),
      retired_flag VARCHAR(1)
    )

    Table graft_record
    (
      graft_code VARCHAR(40) PRIMARY KEY,
      lot_code VARCHAR(40) NOT NULL,
      rootstock_code VARCHAR(40),
      grafted_on DATE
    )

    View bed_yield_vw
    (
      ~groupBy
      (
        nursery.seedling_lot.bed_code
      )
      bed_code: nursery.seedling_lot.bed_code PRIMARY KEY,
      lot_count: count(nursery.seedling_lot.lot_code),
      total_seedlings: sum(nursery.seedling_lot.seedling_count)
    )

    View lot_label_vw
    (
      lot_code: nursery.seedling_lot.lot_code PRIMARY KEY,
      species_label: concat('SPECIES-', coalesce(nursery.seedling_lot.species_code, 'NA'))
    )
  )

  Schema estate
  (
    Table greenhouse
    (
      greenhouse_code VARCHAR(40) PRIMARY KEY,
      greenhouse_name VARCHAR(200) NOT NULL,
      zone_code VARCHAR(40),
      bench_slots INTEGER
    )

    Table zone
    (
      zone_code VARCHAR(40) PRIMARY KEY,
      zone_name VARCHAR(200) NOT NULL,
      climate_band VARCHAR(40)
    )

    Table propagator
    (
      propagator_code VARCHAR(40) PRIMARY KEY,
      propagator_name VARCHAR(200) NOT NULL,
      shift_code VARCHAR(40)
    )

    View greenhouse_bench_vw
    (
      greenhouse_code: estate.greenhouse.greenhouse_code PRIMARY KEY,
      greenhouse_name: estate.greenhouse.greenhouse_name,
      bench_slots: coalesce(estate.greenhouse.bench_slots, 0)
    )
  )

  Filter ActiveBed(nursery.bed.active_flag = 'Y' and nursery.bed.capacity >= 10)
  Filter CurrentSpecies(nursery.species.retired_flag != 'Y')

  Join Lot_Bed(nursery.seedling_lot.bed_code = nursery.bed.bed_code)
  Join Lot_Species(nursery.seedling_lot.species_code = nursery.species.species_code)
  Join Lot_Label(nursery.seedling_lot.lot_code = nursery.lot_label_vw.lot_code)
  Join Lot_Yield(nursery.seedling_lot.bed_code = nursery.bed_yield_vw.bed_code)
  Join Bed_Greenhouse(nursery.bed.greenhouse_code = estate.greenhouse.greenhouse_code)
  Join Bed_Propagator(nursery.bed.propagator_code = estate.propagator.propagator_code)
  Join Greenhouse_Zone(estate.greenhouse.zone_code = estate.zone.zone_code)
  Join Greenhouse_Bench(estate.greenhouse.greenhouse_code = estate.greenhouse_bench_vw.greenhouse_code)
  Join Graft_Lot(nursery.graft_record.lot_code = nursery.seedling_lot.lot_code)
)
