###Mapping
Mapping test::cedarquarry::mapping::NurseryBaseMapping
(
  include mapping test::cedarquarry::mapping::NurseryEnumMappings

  *test::cedarquarry::domain::NurseryBed[bed]: Relational
  {
    ~filter [test::cedarquarry::store::NurseryDatabase]ActiveBed
    ~primaryKey
    (
      [test::cedarquarry::store::NurseryDatabase]nursery.bed.bed_code
    )
    ~mainTable [test::cedarquarry::store::NurseryDatabase]nursery.bed
    bedCode: [test::cedarquarry::store::NurseryDatabase]nursery.bed.bed_code,
    bedName: [test::cedarquarry::store::NurseryDatabase]nursery.bed.bed_name,
    aspect: [test::cedarquarry::store::NurseryDatabase]nursery.bed.aspect,
    capacity: [test::cedarquarry::store::NurseryDatabase]nursery.bed.capacity
  }

