###Mapping
Mapping test::cedarquarry::mapping::NurseryEnumMappings
(
  test::cedarquarry::domain::VigourGrade: EnumerationMapping VigourSource
  {
    PREMIUM: ['A', 'A/PRIME'],
    STANDARD: ['B', 'B/STD'],
    CULL: ['C', 'C/CULL']
  }

  test::cedarquarry::domain::WaterClass: EnumerationMapping WaterSource
  {
    FREQUENT: ['F', 'F/WET'],
    MODERATE: ['M', 'M/MID'],
    SPARSE: ['R', 'R/DRY']
  }

  test::cedarquarry::domain::HardinessTier: EnumerationMapping TierSource
  {
    TIER_ONE: ['T1', 'T1/HARDY'],
    TIER_TWO: ['T2', 'T2/MID'],
    TIER_THREE: ['T3', 'T3/TENDER']
  }
)
