import test::cedarquarry::domain::*;

Enum test::cedarquarry::domain::VigourGrade
{
  PREMIUM,
  STANDARD,
  CULL
}

Enum test::cedarquarry::domain::WaterClass
{
  FREQUENT,
  MODERATE,
  SPARSE
}

Enum test::cedarquarry::domain::HardinessTier
{
  TIER_ONE,
  TIER_TWO,
  TIER_THREE
}

Class test::cedarquarry::domain::StewardStamp
{
  propagatorName: String[0..1];
  greenhouseName: String[0..1];
}

Class test::cedarquarry::domain::SeedlingLot
{
  lotCode: String[1];
  speciesCode: String[1];
  heightCm: Integer[0..1];
  moisturePct: Integer[0..1];
  leafCount: Integer[0..1];
  vigour: VigourGrade[0..1];
  screenedVigour: VigourGrade[0..1];
  waterClass: WaterClass[0..1];
  hardiness: HardinessTier[0..1];
  heightBand: String[0..1];
  careNote: String[0..1];
  labelText: String[0..1];
  dispatchLabel: String[0..1];
  speciesName: String[0..1];
  speciesLabel: String[0..1];
  greenhouseName: String[0..1];
  zoneName: String[0..1];
  bedLotCount: Integer[0..1];
  stewardship: StewardStamp[0..1];
}

Class test::cedarquarry::domain::NurseryBed
{
  bedCode: String[1];
  bedName: String[1];
  aspect: String[0..1];
  capacity: Integer[0..1];
}

Association test::cedarquarry::domain::Bed_Lots
{
  lots: SeedlingLot[*];
  bed: NurseryBed[0..1];
}

Class test::cedarquarry::domain::Greenhouse
{
  greenhouseCode: String[1];
  greenhouseName: String[1];
  benchSlots: Integer[0..1];
}

Class test::cedarquarry::domain::PropagationZone
{
  zoneCode: String[1];
  zoneName: String[1];
  climateBand: String[0..1];
}

Class test::cedarquarry::domain::Propagator
{
  propagatorCode: String[1];
  propagatorName: String[1];
  shiftCode: String[0..1];
}

Class test::cedarquarry::domain::Species
{
  speciesCode: String[1];
  speciesName: String[1];
  leafHabit: String[0..1];
}

Class test::cedarquarry::domain::BedYield
{
  bedCode: String[1];
  lotCount: Integer[0..1];
  totalSeedlings: Integer[0..1];
}

Class test::cedarquarry::domain::GraftRecord
{
  graftCode: String[1];
  lotCode: String[1];
  rootstockCode: String[0..1];
  rootstockVigour: VigourGrade[0..1];
  lotSpecies: String[0..1];
  graftedOn: StrictDate[0..1];
}
