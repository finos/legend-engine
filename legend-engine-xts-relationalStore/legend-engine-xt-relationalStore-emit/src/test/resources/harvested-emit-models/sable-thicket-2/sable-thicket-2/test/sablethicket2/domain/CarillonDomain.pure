###Pure
import test::sablethicket2::domain::*;
import test::sablethicket2::reference::*;

Enum {meta::pure::profiles::doc.doc = 'Tuning temper a casting was finished to.'} test::sablethicket2::domain::ToneTemper
{
  MAJOR_THIRD,
  MINOR_THIRD,
  UNTEMPERED
}

Enum {meta::pure::profiles::doc.doc = 'Condition recorded for the crown of a casting.'} test::sablethicket2::domain::CrownState
{
  SOUND,
  HAIRLINE,
  RECAST_PENDING
}

Class {meta::pure::profiles::doc.doc = 'One cast bell in a carillon register, with the workshop that poured it, the tuning verdicts recorded against it and the closed sets that classify its temper, crown and storage.'} test::sablethicket2::domain::BellCasting
{
  castingCode: String[1];
  profileFamily: String[1];
  profileWeightBand: String[1];
  toneLabel: String[1];
  workshopName: String[1];
  founderName: String[1];
  districtName: String[1];
  districtClimate: String[1];
  tunerName: String[1];
  registerSource: String[1];
  archiveShelf: String[1];
  nominalHz: Float[1];
  crownMassKg: Float[1];
  rimDiameterCm: Float[1];
  strikeCount: Integer[1];
  temper: ToneTemper[1];
  crownState: CrownState[1];
  storageTier: StorageTier[1];
  inscriptionScript: InscriptionScript[1];
}
