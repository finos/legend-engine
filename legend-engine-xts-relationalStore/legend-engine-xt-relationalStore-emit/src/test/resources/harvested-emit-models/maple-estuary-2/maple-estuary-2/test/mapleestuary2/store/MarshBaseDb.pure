###Relational
Database test::mapleestuary2::store::MarshBaseDb
(
  Schema marsh
  (
    Table transect_north
    (
      entry_id VARCHAR(20) PRIMARY KEY,
      entry_code VARCHAR(20) NOT NULL,
      station_code VARCHAR(20),
      tally_count INTEGER,
      mean_depth_cm FLOAT,
      substrate_type VARCHAR(40),
      survey_date DATE,
      note_text VARCHAR(200)
    )
    Table transect_south
    (
      entry_id VARCHAR(20) PRIMARY KEY,
      entry_code VARCHAR(20) NOT NULL,
      station_code VARCHAR(20),
      tally_count INTEGER,
      mean_depth_cm FLOAT,
      substrate_type VARCHAR(40),
      survey_date DATE,
      note_text VARCHAR(200)
    )
    Table gauge_tidal
    (
      reading_id VARCHAR(20) PRIMARY KEY,
      reading_code VARCHAR(20) NOT NULL,
      station_code VARCHAR(20),
      gauge_height_cm FLOAT,
      taken_on DATE
    )
    Table gauge_field
    (
      reading_id VARCHAR(20) PRIMARY KEY,
      reading_code VARCHAR(20) NOT NULL,
      station_code VARCHAR(20),
      gauge_height_cm FLOAT,
      taken_on DATE
    )
    Table station
    (
      station_code VARCHAR(20) PRIMARY KEY,
      station_name VARCHAR(120) NOT NULL,
      zone_code VARCHAR(20),
      station_grade INTEGER,
      station_kind VARCHAR(20),
      active_flag CHAR(1)
    )
    Table habitat_zone
    (
      zone_code VARCHAR(20) PRIMARY KEY,
      zone_name VARCHAR(120) NOT NULL,
      grade_code VARCHAR(20),
      zone_rank INTEGER,
      hectares FLOAT
    )
    Table zone_grade
    (
      grade_code VARCHAR(20) PRIMARY KEY,
      grade_rank INTEGER,
      grade_label VARCHAR(60),
      steward_code VARCHAR(20)
    )
    Table steward
    (
      steward_code VARCHAR(20) PRIMARY KEY,
      steward_name VARCHAR(120) NOT NULL,
      reach_code VARCHAR(20)
    )
    Table reach
    (
      reach_code VARCHAR(20) PRIMARY KEY,
      reach_label VARCHAR(120) NOT NULL
    )
    Table station_note
    (
      note_id VARCHAR(20) PRIMARY KEY,
      station_code VARCHAR(20) NOT NULL,
      note_text VARCHAR(200)
    )
  )
)
