###Connection
RelationalDatabaseConnection test::mapleestuary2::connection::MarshWarehouseConnection
{
  store: test::mapleestuary2::store::MarshSurveyDb;
  type: DB2;
  specification: Static
  {
    name: 'EXAMPLE_MARSH_SURVEY';
    host: 'example-marsh-host';
    port: 50000;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'marshsurveyprincipal';
  };
}

###Connection
RelationalDatabaseConnection test::mapleestuary2::connection::MarshMemoryConnection
{
  store: test::mapleestuary2::store::MarshSurveyDb;
  type: H2;
  specification: Static
  {
    name: 'EXAMPLE_MARSH_MEMORY';
    host: 'example-marsh-memory-host';
    port: 9092;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'marshmemoryprincipal';
  };
}
