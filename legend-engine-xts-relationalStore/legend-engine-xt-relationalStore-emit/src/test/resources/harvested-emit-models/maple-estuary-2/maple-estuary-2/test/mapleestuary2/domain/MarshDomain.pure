Class {meta::pure::profiles::doc.doc = 'A walked transect count of a tidal marsh, assembled from whichever transect register currently holds the entry.'} test::mapleestuary2::domain::TransectEntry
{
  entryCode: String[1];
  sourceRegister: String[1];
  stationCode: String[0..1];
  tallyCount: Integer[0..1];
  meanDepthCm: Float[0..1];
  surveyDate: StrictDate[0..1];
  substrateType: String[0..1];
  zoneBand: String[0..1];
  stationBand: String[0..1];
  registerLabel: String[0..1];
  depthBand: String[0..1];
  noteHint: String[0..1];
  stewardName: String[0..1];
  reachLabel: String[0..1];
  noteCount: Integer[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A tide-gauge height reading taken at a marsh station, assembled from whichever gauge register recorded it.'} test::mapleestuary2::domain::GaugeReading
{
  readingCode: String[1];
  sourceRegister: String[1];
  stationCode: String[0..1];
  gaugeHeightCm: Float[0..1];
  zoneName: String[0..1];
  readingBand: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A fixed marsh observation station sitting inside a habitat zone.'} test::mapleestuary2::domain::Station
{
  stationCode: String[1];
  stationName: String[1];
  zoneCode: String[0..1];
  noteTexts: String[*];
}
