###Mapping
Mapping test::mapleestuary2::mapping::MarshSurveyMapping
(
  test::mapleestuary2::domain::TransectEntry[northTransect]: Relational
  {
    ~primaryKey
    (
      [test::mapleestuary2::store::MarshSurveyDb]marsh.transect_north.entry_id
    )
    ~mainTable [test::mapleestuary2::store::MarshSurveyDb]marsh.transect_north
    entryCode: [test::mapleestuary2::store::MarshSurveyDb]marsh.transect_north.entry_code,
    sourceRegister: 'NORTH',
    stationCode: [test::mapleestuary2::store::MarshSurveyDb]marsh.transect_north.station_code,
    tallyCount: [test::mapleestuary2::store::MarshSurveyDb]marsh.transect_north.tally_count,
    meanDepthCm: [test::mapleestuary2::store::MarshSurveyDb]marsh.transect_north.mean_depth_cm,
    surveyDate: [test::mapleestuary2::store::MarshSurveyDb]marsh.transect_north.survey_date,
    substrateType: case(isNull([test::mapleestuary2::store::MarshSurveyDb]marsh.transect_north.substrate_type), 'unrecorded', [test::mapleestuary2::store::MarshSurveyDb]marsh.transect_north.substrate_type),
    zoneBand: case(equal([test::mapleestuary2::store::MarshSurveyDb]@TransectNorth_Station > (INNER) @Station_Zone | [test::mapleestuary2::store::MarshSurveyDb]marsh.habitat_zone.zone_rank, 2), 'CORE-ZONE', 'FRINGE-ZONE'),
    stationBand: case(equal([test::mapleestuary2::store::MarshSurveyDb]@TransectNorth_Station | [test::mapleestuary2::store::MarshSurveyDb]marsh.station.station_kind, 'TIDAL'), 'TIDAL-STATION', 'INLAND-STATION'),
    registerLabel: case(equal([test::mapleestuary2::store::MarshSurveyDb]marsh.transect_north.substrate_type, 'silt'), 'SILT-BED', 'MIXED-BED'),
    depthBand: case(or(and(equal([test::mapleestuary2::store::MarshSurveyDb]marsh.transect_north.substrate_type, 'silt'), greaterThan(abs(ceiling([test::mapleestuary2::store::MarshSurveyDb]marsh.transect_north.mean_depth_cm)), 40)), and(equal([test::mapleestuary2::store::MarshSurveyDb]marsh.transect_north.substrate_type, 'sand'), equal([test::mapleestuary2::store::MarshSurveyDb]marsh.transect_north.tally_count, 7))), 'DEEP-CHANNEL', 'SHALLOW-FLAT'),
    noteHint: case(equal([test::mapleestuary2::store::MarshSurveyDb]marsh.transect_north.note_text, 'use-station-name'), [test::mapleestuary2::store::MarshSurveyDb]@TransectNorth_Station | [test::mapleestuary2::store::MarshSurveyDb]marsh.station.station_name, [test::mapleestuary2::store::MarshSurveyDb]marsh.transect_north.note_text),
    stewardName: [test::mapleestuary2::store::MarshSurveyDb]@TransectNorth_Station > (INNER) @Station_Zone > @Zone_Grade > @Grade_Steward | [test::mapleestuary2::store::MarshSurveyDb]marsh.steward.steward_name,
    reachLabel: [test::mapleestuary2::store::MarshSurveyDb]@TransectNorth_Station > (INNER) @Station_Zone > @Zone_Grade > @Grade_Steward > @Steward_Reach | [test::mapleestuary2::store::MarshSurveyDb]marsh.reach.reach_label,
    noteCount: [test::mapleestuary2::store::MarshSurveyDb]@TransectNorth_Station > @Station_NoteView | [test::mapleestuary2::store::MarshSurveyDb]marshview.station_note_view.note_count
  }

  test::mapleestuary2::domain::TransectEntry[southTransect]: Relational
  {
    ~primaryKey
    (
      [test::mapleestuary2::store::MarshSurveyDb]marsh.transect_south.entry_id
    )
    ~mainTable [test::mapleestuary2::store::MarshSurveyDb]marsh.transect_south
    entryCode: [test::mapleestuary2::store::MarshSurveyDb]marsh.transect_south.entry_code,
    sourceRegister: 'SOUTH',
    stationCode: [test::mapleestuary2::store::MarshSurveyDb]marsh.transect_south.station_code,
    tallyCount: [test::mapleestuary2::store::MarshSurveyDb]marsh.transect_south.tally_count,
    meanDepthCm: [test::mapleestuary2::store::MarshSurveyDb]marsh.transect_south.mean_depth_cm,
    surveyDate: [test::mapleestuary2::store::MarshSurveyDb]marsh.transect_south.survey_date,
    substrateType: case(isNull([test::mapleestuary2::store::MarshSurveyDb]marsh.transect_south.substrate_type), 'unrecorded', [test::mapleestuary2::store::MarshSurveyDb]marsh.transect_south.substrate_type),
    zoneBand: case(equal([test::mapleestuary2::store::MarshSurveyDb]@TransectSouth_Station > (INNER) @Station_Zone | [test::mapleestuary2::store::MarshSurveyDb]marsh.habitat_zone.zone_rank, 2), 'CORE-ZONE', 'FRINGE-ZONE'),
    stationBand: case(equal([test::mapleestuary2::store::MarshSurveyDb]@TransectSouth_Station | [test::mapleestuary2::store::MarshSurveyDb]marsh.station.station_kind, 'TIDAL'), 'TIDAL-STATION', 'INLAND-STATION'),
    registerLabel: case(equal([test::mapleestuary2::store::MarshSurveyDb]marsh.transect_south.substrate_type, 'silt'), 'SILT-BED', 'MIXED-BED'),
    depthBand: case(or(and(equal([test::mapleestuary2::store::MarshSurveyDb]marsh.transect_south.substrate_type, 'silt'), greaterThan(abs(ceiling([test::mapleestuary2::store::MarshSurveyDb]marsh.transect_south.mean_depth_cm)), 40)), and(equal([test::mapleestuary2::store::MarshSurveyDb]marsh.transect_south.substrate_type, 'sand'), equal([test::mapleestuary2::store::MarshSurveyDb]marsh.transect_south.tally_count, 7))), 'DEEP-CHANNEL', 'SHALLOW-FLAT'),
    noteHint: case(equal([test::mapleestuary2::store::MarshSurveyDb]marsh.transect_south.note_text, 'use-station-name'), [test::mapleestuary2::store::MarshSurveyDb]@TransectSouth_Station | [test::mapleestuary2::store::MarshSurveyDb]marsh.station.station_name, [test::mapleestuary2::store::MarshSurveyDb]marsh.transect_south.note_text),
    stewardName: [test::mapleestuary2::store::MarshSurveyDb]@TransectSouth_Station > (INNER) @Station_Zone > @Zone_Grade > @Grade_Steward | [test::mapleestuary2::store::MarshSurveyDb]marsh.steward.steward_name,
    reachLabel: [test::mapleestuary2::store::MarshSurveyDb]@TransectSouth_Station > (INNER) @Station_Zone > @Zone_Grade > @Grade_Steward > @Steward_Reach | [test::mapleestuary2::store::MarshSurveyDb]marsh.reach.reach_label,
    noteCount: [test::mapleestuary2::store::MarshSurveyDb]@TransectSouth_Station > @Station_NoteView | [test::mapleestuary2::store::MarshSurveyDb]marshview.station_note_view.note_count
  }

  *test::mapleestuary2::domain::TransectEntry: Operation
  {
    meta::pure::router::operations::union_OperationSetImplementation_1__SetImplementation_MANY_(northTransect, southTransect)
  }

  test::mapleestuary2::domain::GaugeReading[tidalGauge]: Relational
  {
    ~primaryKey
    (
      [test::mapleestuary2::store::MarshSurveyDb]marsh.gauge_tidal.reading_id
    )
    ~mainTable [test::mapleestuary2::store::MarshSurveyDb]marsh.gauge_tidal
    readingCode: [test::mapleestuary2::store::MarshSurveyDb]marsh.gauge_tidal.reading_code,
    sourceRegister: 'TIDAL',
    stationCode: [test::mapleestuary2::store::MarshSurveyDb]marsh.gauge_tidal.station_code,
    gaugeHeightCm: [test::mapleestuary2::store::MarshSurveyDb]marsh.gauge_tidal.gauge_height_cm,
    zoneName: [test::mapleestuary2::store::MarshSurveyDb]@GaugeTidal_Station > (INNER) @Station_Zone | [test::mapleestuary2::store::MarshSurveyDb]marsh.habitat_zone.zone_name,
    readingBand: case(equal([test::mapleestuary2::store::MarshSurveyDb]@GaugeTidal_Station | [test::mapleestuary2::store::MarshSurveyDb]marsh.station.station_kind, 'TIDAL'), 'TIDAL-GAUGE', 'CREEK-GAUGE')
  }

  test::mapleestuary2::domain::GaugeReading[fieldGauge]: Relational
  {
    ~primaryKey
    (
      [test::mapleestuary2::store::MarshSurveyDb]marsh.gauge_field.reading_id
    )
    ~mainTable [test::mapleestuary2::store::MarshSurveyDb]marsh.gauge_field
