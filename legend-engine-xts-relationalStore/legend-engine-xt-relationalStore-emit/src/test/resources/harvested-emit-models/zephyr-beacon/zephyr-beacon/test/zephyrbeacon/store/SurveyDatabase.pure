###Relational
Database test::zephyrbeacon::store::SurveyDatabase
(
  Schema survey
  (
    Table observation
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      observation_id VARCHAR(32) PRIMARY KEY,
      station_code VARCHAR(16) NOT NULL,
      species_code VARCHAR(16) NOT NULL,
      habitat_code VARCHAR(16),
      individual_count INTEGER NOT NULL,
      observer_name VARCHAR(80),
      from_z DATE PRIMARY KEY,
      thru_z DATE
    )
  )
)
