###Connection
RelationalDatabaseConnection test::zephyrbeacon::connection::PrimarySurveyConnection
{
  store: test::zephyrbeacon::store::SurveyDatabase;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists survey;',
      'create schema survey;',
      'create table survey.observation (observation_id varchar(32) not null, station_code varchar(16) not null, species_code varchar(16) not null, habitat_code varchar(16), individual_count integer not null, observer_name varchar(80), from_z date not null, thru_z date, primary key (observation_id, from_z));'
      ];
  };
  auth: DefaultH2;
}
