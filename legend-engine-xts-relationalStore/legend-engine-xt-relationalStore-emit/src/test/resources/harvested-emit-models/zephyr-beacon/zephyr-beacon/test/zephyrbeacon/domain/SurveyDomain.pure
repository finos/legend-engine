###Pure
import test::zephyrbeacon::domain::*;

Class <<temporal.businesstemporal>> test::zephyrbeacon::domain::Observation
{
  observationId: String[1];
  stationCode: String[1];
  speciesCode: String[1];
  habitatCode: String[1];
  individualCount: Integer[1];
  observerName: String[1];
  windowLabel()
  {
    $this.stationCode + '/' + $this.speciesCode
  }: String[1];
  crowded()
  {
    $this.individualCount > 12
  }: Boolean[1];
}
