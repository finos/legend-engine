###Mapping
Mapping test::zephyrbeacon::mapping::SurveyMapping
(
  *test::zephyrbeacon::domain::Observation[observation]: Relational
  {
    ~primaryKey
    (
      [test::zephyrbeacon::store::SurveyDatabase]survey.observation.observation_id
    )
    ~mainTable [test::zephyrbeacon::store::SurveyDatabase]survey.observation
    observationId: [test::zephyrbeacon::store::SurveyDatabase]survey.observation.observation_id,
    stationCode: [test::zephyrbeacon::store::SurveyDatabase]survey.observation.station_code,
    speciesCode: [test::zephyrbeacon::store::SurveyDatabase]survey.observation.species_code,
    habitatCode: case(isEmpty([test::zephyrbeacon::store::SurveyDatabase]survey.observation.habitat_code), 'UNRECORDED', [test::zephyrbeacon::store::SurveyDatabase]survey.observation.habitat_code),
    individualCount: [test::zephyrbeacon::store::SurveyDatabase]survey.observation.individual_count,
    observerName: case(isEmpty([test::zephyrbeacon::store::SurveyDatabase]survey.observation.observer_name), 'unattributed', concat([test::zephyrbeacon::store::SurveyDatabase]survey.observation.observer_name, ' (field)'))
  }
)
