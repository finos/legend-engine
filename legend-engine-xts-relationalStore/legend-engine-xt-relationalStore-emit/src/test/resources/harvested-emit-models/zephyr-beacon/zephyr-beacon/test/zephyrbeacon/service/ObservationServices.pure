###Service
Service test::zephyrbeacon::service::StationRegisterMulti
{
  pattern: '/survey/v1/station-register-multi';
  title: 'Survey - station register (multi-environment)';
  owners:
  [
    'survey-platform',
    'wetland-eng'
  ];
  documentation: 'Keyed multi-execution register: one query body pinned to a business date is bound to two environment-keyed runtimes so the plan is chosen at execution time.';
  autoActivateUpdates: true;
  execution: Multi
  {
    query: {surveyDate: StrictDate[1], station: String[1]|test::zephyrbeacon::domain::Observation.all($surveyDate)->filter(o|$o.stationCode == $station)->project([o|$o.observationId, o|$o.speciesCode, o|$o.habitatCode, o|$o.individualCount, o|$o.observerName], ['ObservationId', 'Species', 'Habitat', 'Count', 'Observer'])};
    key: 'environment';
    executions['primary']:
    {
      mapping: test::zephyrbeacon::mapping::SurveyMapping;
      runtime: test::zephyrbeacon::runtime::PrimarySurveyRuntime;
    }
    executions['auxiliary']:
    {
      mapping: test::zephyrbeacon::mapping::SurveyMapping;
      runtime: test::zephyrbeacon::runtime::AuxiliarySurveyRuntime;
    }
  }
}

###Service
Service test::zephyrbeacon::service::SpeciesSightingsMulti
{
  pattern: '/survey/v1/species-sightings-multi';
  title: 'Survey - species sightings (multi-environment)';
  owners:
  [
    'survey-platform',
    'wetland-eng'
  ];
  documentation: 'Keyed multi-execution sightings feed whose predicate is a membership test over a caller-supplied species list, bound to the same two environment keys.';
  autoActivateUpdates: true;
  execution: Multi
  {
    query: {surveyDate: StrictDate[1], species: String[*]|test::zephyrbeacon::domain::Observation.all($surveyDate)->filter(o|$o.speciesCode->in($species))->project([o|$o.observationId, o|$o.stationCode, o|$o.speciesCode, o|$o.individualCount], ['ObservationId', 'Station', 'Species', 'Count'])};
    key: 'environment';
    executions['primary']:
    {
      mapping: test::zephyrbeacon::mapping::SurveyMapping;
      runtime: test::zephyrbeacon::runtime::PrimarySurveyRuntime;
    }
    executions['auxiliary']:
    {
      mapping: test::zephyrbeacon::mapping::SurveyMapping;
      runtime: test::zephyrbeacon::runtime::AuxiliarySurveyRuntime;
    }
  }
}

###Service
Service test::zephyrbeacon::service::CrowdedHabitatsMulti
{
  pattern: '/survey/v1/crowded-habitats-multi';
  title: 'Survey - crowded habitats (multi-environment)';
  owners:
  [
    'survey-platform',
    'wetland-eng'
  ];
  documentation: 'Keyed multi-execution summary that conjoins two equality predicates and de-duplicates the projected habitat rows, so the collection operator changes the row count rather than decorating it.';
  autoActivateUpdates: true;
  execution: Multi
  {
    query: {surveyDate: StrictDate[1], station: String[1], species: String[1]|test::zephyrbeacon::domain::Observation.all($surveyDate)->filter(o|$o.stationCode == $station && ($o.speciesCode == $species || ($o.individualCount > 12)))->project([o|$o.stationCode, o|$o.habitatCode], ['Station', 'Habitat'])->distinct()->sort([asc('Habitat')])};
    key: 'environment';
    executions['primary']:
    {
      mapping: test::zephyrbeacon::mapping::SurveyMapping;
      runtime: test::zephyrbeacon::runtime::PrimarySurveyRuntime;
    }
    executions['auxiliary']:
    {
      mapping: test::zephyrbeacon::mapping::SurveyMapping;
      runtime: test::zephyrbeacon::runtime::AuxiliarySurveyRuntime;
    }
  }
}

###Service
Service test::zephyrbeacon::service::StationRegister
{
  pattern: '/survey/v1/station-register/{station}';
  title: 'Survey - station register as of a survey date';
  owners:
  [
    'survey-platform',
    'wetland-eng'
  ];
  documentation: 'Single-execution counterpart of the keyed register: pins the business-temporal observation extent to the supplied date and projects the defaulted habitat and observer derivations for one station.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {surveyDate: StrictDate[1], station: String[1]|test::zephyrbeacon::domain::Observation.all($surveyDate)->filter(o|$o.stationCode == $station)->project([o|$o.observationId, o|$o.speciesCode, o|$o.habitatCode, o|$o.individualCount, o|$o.observerName], ['ObservationId', 'Species', 'Habitat', 'Count', 'Observer'])};
    mapping: test::zephyrbeacon::mapping::SurveyMapping;
    runtime: test::zephyrbeacon::runtime::PrimarySurveyRuntime;
  }
  testSuites:
  [
    stationRegisterSuite:
    {
      data:
      [
        connections:
        [
          primarySurveyConnection:
            Reference
            #{
              test::zephyrbeacon::data::SurveyFixture
            }#
        ]
      ]
      tests:
      [
        registerWithDefaultedColumns:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            surveyDate = %2026-06-01,
            station = 'ST-NORTH'
          ]
          asserts:
          [
            defaultsAndAttributionSurface:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"ObservationId":"OBS-01","Species":"SP-WREN","Habitat":"HB-REED","Count":14,"Observer":"Ada Fern (field)"},{"ObservationId":"OBS-02","Species":"SP-WREN","Habitat":"HB-REED","Count":6,"Observer":"Ada Fern (field)"},{"ObservationId":"OBS-03","Species":"SP-EGRET","Habitat":"UNRECORDED","Count":9,"Observer":"unattributed"}]';
                  }#;
              }#
          ]
        },
        registerBeforeTheRevision:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            surveyDate = %2026-02-01,
            station = 'ST-RIDGE'
          ]
          asserts:
          [
            onlyTheSupersededVersion:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"ObservationId":"OBS-06","Species":"SP-TERN","Habitat":"HB-SCREE","Count":14,"Observer":"Cy Moss (field)"},{"ObservationId":"OBS-07","Species":"SP-WREN","Habitat":"HB-SCREE","Count":2,"Observer":"Cy Moss (field)"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

###Service
Service test::zephyrbeacon::service::SpeciesSightings
{
  pattern: '/survey/v1/species-sightings';
  title: 'Survey - sightings for a species list';
  owners:
  [
    'survey-platform',
    'wetland-eng'
  ];
  documentation: 'Single-execution counterpart of the keyed sightings feed: the membership predicate over the species list decides which observations are returned.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {surveyDate: StrictDate[1], species: String[*]|test::zephyrbeacon::domain::Observation.all($surveyDate)->filter(o|$o.speciesCode->in($species))->project([o|$o.observationId, o|$o.stationCode, o|$o.speciesCode, o|$o.individualCount], ['ObservationId', 'Station', 'Species', 'Count'])};
    mapping: test::zephyrbeacon::mapping::SurveyMapping;
    runtime: test::zephyrbeacon::runtime::PrimarySurveyRuntime;
  }
  testSuites:
  [
    speciesSightingsSuite:
    {
      data:
      [
        connections:
        [
          primarySurveyConnection:
            Reference
            #{
              test::zephyrbeacon::data::SurveyFixture
            }#
        ]
      ]
      tests:
      [
        membershipNarrowsTheExtent:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            surveyDate = %2026-06-01,
            species = ['SP-TERN', 'SP-EGRET']
          ]
          asserts:
          [
            onlyListedSpecies:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"ObservationId":"OBS-03","Station":"ST-NORTH","Species":"SP-EGRET","Count":9},{"ObservationId":"OBS-04","Station":"ST-SOUTH","Species":"SP-EGRET","Count":21},{"ObservationId":"OBS-05","Station":"ST-SOUTH","Species":"SP-TERN","Count":3},{"ObservationId":"OBS-06","Station":"ST-RIDGE","Species":"SP-TERN","Count":14}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

###Service
Service test::zephyrbeacon::service::CrowdedHabitats
{
  pattern: '/survey/v1/crowded-habitats';
  title: 'Survey - distinct habitats for a station and species';
  owners:
  [
    'survey-platform',
    'wetland-eng'
  ];
  documentation: 'Single-execution counterpart of the keyed habitat summary: two conjoined equality predicates select the slice and the de-duplication collapses the repeated habitat rows.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {surveyDate: StrictDate[1], station: String[1], species: String[1]|test::zephyrbeacon::domain::Observation.all($surveyDate)->filter(o|$o.stationCode == $station && ($o.speciesCode == $species || ($o.individualCount > 12)))->project([o|$o.stationCode, o|$o.habitatCode], ['Station', 'Habitat'])->distinct()->sort([asc('Habitat')])};
    mapping: test::zephyrbeacon::mapping::SurveyMapping;
    runtime: test::zephyrbeacon::runtime::PrimarySurveyRuntime;
  }
  testSuites:
  [
    crowdedHabitatsSuite:
    {
      data:
      [
        connections:
        [
          primarySurveyConnection:
            Reference
            #{
              test::zephyrbeacon::data::SurveyFixture
            }#
        ]
      ]
      tests:
      [
        duplicateHabitatRowsCollapse:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            surveyDate = %2026-06-01,
            station = 'ST-NORTH',
            species = 'SP-WREN'
          ]
          asserts:
          [
            oneRowPerHabitat:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Station":"ST-NORTH","Habitat":"HB-REED"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
