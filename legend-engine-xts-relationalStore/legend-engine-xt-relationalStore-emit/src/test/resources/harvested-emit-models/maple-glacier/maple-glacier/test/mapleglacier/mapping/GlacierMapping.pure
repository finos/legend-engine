###Mapping
Mapping test::mapleglacier::mapping::GlacierMapping
(
  *test::mapleglacier::domain::IceObservation[obs]: Relational
  {
    ~primaryKey
    (
      [test::mapleglacier::store::GlacierDB]cryo.ice_observation.obs_id
    )
    ~mainTable [test::mapleglacier::store::GlacierDB]cryo.ice_observation
    stationName: [test::mapleglacier::store::GlacierDB]cryo.ice_observation.station_name,
    massBalanceMm: [test::mapleglacier::store::GlacierDB]cryo.ice_observation.mass_balance_mm,
    baselineMm: [test::mapleglacier::store::GlacierDB]cryo.ice_observation.baseline_mm,
    surveyDate: [test::mapleglacier::store::GlacierDB]cryo.ice_observation.survey_date
  }

  testSuites:
  [
    observationProjectionSuite:
    {
      function: |test::mapleglacier::domain::IceObservation.all()->project(
  [
    x|$x.stationName,
    x|$x.netChange,
    x|$x.severity
  ],
  [
    'Station',
    'NetChange',
    'Severity'
  ]
)->sort(
  [
    asc('Station')
  ]
);
      tests:
      [
        allObservations:
        {
          doc: 'Projects station name with the derived net change and severity classification over the ice_observation table, exercising the arithmetic and conditional derived properties.';
          data:
          [
            test::mapleglacier::store::GlacierDB:
              Relational
              #{
                cryo.ice_observation:
                  'obs_id,station_name,mass_balance_mm,baseline_mm,survey_date\n'+
                  '1,Blue Glacier,-120,0,2024-05-01\n'+
                  '2,Rhone Field,40,10,2024-06-15\n'+
                  '3,Vatna Cap,-30,-10,2024-01-10\n';
              }#
          ];
          asserts:
          [
            threeRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Station":"Blue Glacier","NetChange":-120,"Severity":"SEVERE"},{"Station":"Rhone Field","NetChange":30,"Severity":"STABLE"},{"Station":"Vatna Cap","NetChange":-20,"Severity":"MODERATE"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
