Class {meta::pure::profiles::doc.doc = 'A single mass-balance observation recorded at a glacier monitoring station.'} test::mapleglacier::domain::IceObservation
{
  stationName: String[1];
  massBalanceMm: Integer[1];
  baselineMm: Integer[1];
  surveyDate: StrictDate[1];
  netChange() {$this.massBalanceMm - $this.baselineMm}: Integer[1];
  severity() {if($this.massBalanceMm < 0, | if($this.massBalanceMm < -100, | 'SEVERE', | 'MODERATE'), | 'STABLE')}: String[1];
  label() {$this.stationName + ' [' + $this.massBalanceMm->toString() + ']'}: String[1];
  horizonDate() {$this.surveyDate->adjust(30, DurationUnit.DAYS)}: Date[1];
}
