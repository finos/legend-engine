###Relational
Database test::ivoryhatchery::store::HatcheryStore
(
  include test::ivoryhatchery::store::HatcheryReferenceStore

  Schema hatch
  (
    Table egg_lot
    (
      lot_id INTEGER PRIMARY KEY,
      lot_name VARCHAR(64) NOT NULL,
      tray_count INTEGER NOT NULL,
      egg_count INTEGER NOT NULL,
      band_code VARCHAR(8),
      vigour_code VARCHAR(16),
      ration_code VARCHAR(16),
      size_code VARCHAR(16),
      grade_code VARCHAR(16) NOT NULL,
      note_text VARCHAR(128)
    )
  )

  Join Lot_Grade(hatch.egg_lot.grade_code = reg.clutch_grade.grade_code)
)
