###Relational
Database test::ivoryhatchery::store::HatcheryReferenceStore
(
  Schema reg
  (
    Table grow_region
    (
      region_code VARCHAR(16) PRIMARY KEY,
      region_name VARCHAR(64) NOT NULL
    )

    Table brooder_barn
    (
      barn_code VARCHAR(16) PRIMARY KEY,
      barn_name VARCHAR(64) NOT NULL,
      region_code VARCHAR(16) NOT NULL
    )

    Table setter_cabinet
    (
      cabinet_code VARCHAR(16) PRIMARY KEY,
      cabinet_name VARCHAR(64) NOT NULL,
      barn_code VARCHAR(16) NOT NULL
    )

    Table clutch_grade
    (
      grade_code VARCHAR(16) PRIMARY KEY,
      grade_label VARCHAR(64) NOT NULL,
      cabinet_code VARCHAR(16) NOT NULL
    )
  )

  Join Grade_Cabinet(reg.clutch_grade.cabinet_code = reg.setter_cabinet.cabinet_code)
  Join Cabinet_Barn(reg.setter_cabinet.barn_code = reg.brooder_barn.barn_code)
  Join Barn_Region(reg.brooder_barn.region_code = reg.grow_region.region_code)
)
