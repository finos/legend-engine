import test::ivoryfjord3::domain::*;

Class {meta::pure::profiles::doc.doc = 'A single water sample drawn by a probe unit, carrying its measured readings.'} test::ivoryfjord3::domain::WaterSample
{
  sampleCode: String[1];
  collectorName: String[1];
  collectedOn: StrictDate[1];
  temperatureC: Float[1];
  salinity: Float[1];
  depthM: Float[1];
  probe: ProbeUnit[0..1];
  collectorTag() {if($this.collectorName->length() >= 1, |$this.collectorName->toUpper(), |'UNKNOWN')}: String[1];
}
