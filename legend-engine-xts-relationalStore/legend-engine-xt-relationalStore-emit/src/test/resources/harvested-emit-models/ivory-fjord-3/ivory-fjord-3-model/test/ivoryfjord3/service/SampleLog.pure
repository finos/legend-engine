###Service
Service test::ivoryfjord3::service::SampleLog
{
  pattern: '/coastal/v1/samples/{observedOn}';
  title: 'Coastal - Sample Log As Of A Date';
  owners:
  [
    'coastal-monitoring',
    'shoreline-eng'
  ];
  documentation: 'Projects twelve columns over the water-sample extent, resolving the shore station as of the requested date, then applies the predicate to the projected result and deduplicates it.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {observedOn: StrictDate[1]|test::ivoryfjord3::domain::WaterSample.all()->project(
      [
        s|$s.sampleCode,
        s|$s.collectorName,
        s|$s.collectedOn,
        s|$s.temperatureC,
        s|$s.salinity,
        s|$s.depthM,
        s|$s.probe.probeCode,
        s|$s.probe.firmwareTag,
        s|$s.probe.station($observedOn).stationCode,
        s|$s.probe.station($observedOn).stationName,
        s|$s.probe.station($observedOn).custodian,
        s|$s.probe.station($observedOn).shoreZone
      ],
      [
        'Sample',
        'Collector',
        'CollectedOn',
        'TemperatureC',
        'Salinity',
        'DepthM',
        'Probe',
        'Firmware',
        'StationCode',
        'StationName',
        'Custodian',
        'ShoreZone'
      ]
    )->filter(
      r|$r.getStrictDate('CollectedOn') == $observedOn
    )->distinct()};
    mapping: test::ivoryfjord3::mapping::CoastalMapping;
    runtime: test::ivoryfjord3::runtime::CoastalRuntime;
  }
  testSuites:
  [
    sampleLogSuite:
    {
      data:
      [
        connections:
        [
          h2Connection:
            Relational
            #{
              coastal.water_sample:
                'sample_id,sample_code,collector_name,collected_on,temperature_c,salinity,depth_m,probe_id\n'+
                '1,SMP-0001,Iris Calder,2026-03-15,8.4,34.1,2.5,100\n'+
                '2,SMP-0001,Iris Calder,2026-03-15,8.4,34.1,2.5,100\n'+
                '3,SMP-0003,Nadia Ferrow,2026-03-15,7.1,33.2,4.0,200\n'+
                '4,SMP-0004,Nadia Ferrow,2026-02-01,6.9,33.9,1.5,100\n';

              coastal.probe_unit:
                'probe_id,probe_code,firmware_tag,station_id\n'+
                '100,PRB-100,fw-7,10\n'+
                '200,PRB-200,fw-4,20\n';

              coastal.shore_station:
                'station_id,station_code,station_name,custodian,shore_zone,from_z,thru_z\n'+
                '10,STN-10,Fjord Head Post,Iris Calder,Outer Reach,2024-01-01,2026-01-01\n'+
                '10,STN-10,Fjord Head North Post,Nadia Ferrow,Outer Reach,2026-01-01,9999-12-31\n'+
                '20,STN-20,Kelp Basin Post,Oren Vale,Inner Reach,2020-01-01,2025-01-01\n';
            }#
        ]
      ]
      tests:
      [
        logAsOfMarch:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            observedOn = %2026-03-15
          ]
          asserts:
          [
            dedupedRowsWithOutOfRangeStation:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Sample":"SMP-0001","Collector":"Iris Calder","CollectedOn":"2026-03-15","TemperatureC":8.4,"Salinity":34.1,"DepthM":2.5,"Probe":"PRB-100","Firmware":"fw-7","StationCode":"STN-10","StationName":"Fjord Head North Post","Custodian":"Nadia Ferrow","ShoreZone":"Outer Reach"},{"Sample":"SMP-0003","Collector":"Nadia Ferrow","CollectedOn":"2026-03-15","TemperatureC":7.1,"Salinity":33.2,"DepthM":4.0,"Probe":"PRB-200","Firmware":"fw-4","StationCode":null,"StationName":null,"Custodian":null,"ShoreZone":null}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
