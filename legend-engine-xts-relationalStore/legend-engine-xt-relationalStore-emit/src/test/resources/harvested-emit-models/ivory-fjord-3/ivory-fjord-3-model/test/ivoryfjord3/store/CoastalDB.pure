###Relational
Database test::ivoryfjord3::store::CoastalDB
(
  Schema coastal
  (
    Table water_sample
    (
      sample_id INTEGER PRIMARY KEY,
      sample_code VARCHAR(20) NOT NULL,
      collector_name VARCHAR(120) NOT NULL,
      collected_on DATE NOT NULL,
      temperature_c FLOAT NOT NULL,
      salinity FLOAT NOT NULL,
      depth_m FLOAT NOT NULL,
      probe_id INTEGER
    )
    Table probe_unit
    (
      probe_id INTEGER PRIMARY KEY,
      probe_code VARCHAR(20) NOT NULL,
      firmware_tag VARCHAR(20) NOT NULL,
      station_id INTEGER
    )
    Table shore_station
    (
      milestoning
      (
        business(BUS_FROM=from_z, BUS_THRU=thru_z)
      )
      station_id INTEGER PRIMARY KEY,
      station_code VARCHAR(20) NOT NULL,
      station_name VARCHAR(120) NOT NULL,
      custodian VARCHAR(120) NOT NULL,
      shore_zone VARCHAR(120) NOT NULL,
      from_z DATE PRIMARY KEY,
      thru_z DATE
    )
  )

  Join Sample_Probe(coastal.water_sample.probe_id = coastal.probe_unit.probe_id)
  Join Probe_Station(coastal.probe_unit.station_id = coastal.shore_station.station_id)
)
