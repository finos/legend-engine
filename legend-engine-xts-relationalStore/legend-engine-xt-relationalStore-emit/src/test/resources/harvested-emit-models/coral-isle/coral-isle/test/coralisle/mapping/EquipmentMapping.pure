###Mapping
Mapping test::coralisle::mapping::EquipmentMapping
(
  *test::coralisle::domain::EquipmentLog[equipmentLog]: Relational
  {
    ~primaryKey
    (
      [test::coralisle::store::FieldTeamDb]survey.equipment_log.gear_tag
    )
    ~mainTable [test::coralisle::store::FieldTeamDb]survey.equipment_log
    gearTag: [test::coralisle::store::FieldTeamDb]survey.equipment_log.gear_tag,
    gearName: [test::coralisle::store::FieldTeamDb]survey.equipment_log.gear_name,
    servicedOn: [test::coralisle::store::FieldTeamDb]survey.equipment_log.serviced_on
  }

  testSuites:
  [
    equipmentRosterSuite:
    {
      function: |test::coralisle::domain::EquipmentLog.all()->project(
  [
    e|$e.gearTag,
    e|$e.gearName
  ],
  [
    'Gear',
    'Gear Name'
  ]
)->sort(
  [
    asc('Gear')
  ]
);
      tests:
      [
        equipmentRosterRows:
        {
          doc: 'A third store contributes its own aliased main table, showing that each mapping resolves its columns through its own table alias.';
          data:
          [
            test::coralisle::store::FieldTeamDb:
              Relational
              #{
                survey.equipment_log:
                  'gear_tag,gear_name,serviced_on,gear_kind,shore_base,service_note,retired\n'+
                  'EQ-1,Plankton net frame,2026-01-14 09:00:00,net,Lantern Cove,Mesh replaced,false\n'+
                  'EQ-2,Handheld salinity probe,2026-01-21 09:30:00,probe,Lantern Cove,Recalibrated,false\n';
              }#
          ];
          asserts:
          [
            bothGearsListed:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Gear":"EQ-1","Gear Name":"Plankton net frame"},{"Gear":"EQ-2","Gear Name":"Handheld salinity probe"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
