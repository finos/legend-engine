###Connection
RelationalDatabaseConnection test::ivoryaviary::connection::AviaryH2Connection
{
  store: test::ivoryaviary::store::AviaryStore;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists aviary;',
      'create schema aviary;',
      'create table aviary.ring_record (record_id integer not null, ring_code varchar(24) not null, species_code varchar(16) not null, species_name varchar(64) not null, enclosure_code varchar(16) not null, wing_span_mm integer not null, mass_g double not null, observer_name varchar(64) not null, note_text varchar(128), age_class_code varchar(8), in_z date not null, out_z date, primary key (record_id, in_z));'
      ];
  };
  auth: DefaultH2;
}
