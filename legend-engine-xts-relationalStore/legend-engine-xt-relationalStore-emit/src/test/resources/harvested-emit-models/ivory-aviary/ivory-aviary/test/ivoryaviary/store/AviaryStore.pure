###Relational
Database test::ivoryaviary::store::AviaryStore
(
  Schema aviary
  (
    Table ring_record
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )
      record_id INTEGER PRIMARY KEY,
      ring_code VARCHAR(24) NOT NULL,
      species_code VARCHAR(16) NOT NULL,
      species_name VARCHAR(64) NOT NULL,
      enclosure_code VARCHAR(16) NOT NULL,
      wing_span_mm INTEGER NOT NULL,
      mass_g DOUBLE NOT NULL,
      observer_name VARCHAR(64) NOT NULL,
      note_text VARCHAR(128),
      age_class_code VARCHAR(8),
      in_z DATE PRIMARY KEY,
      out_z DATE
    )
  )
)
