###Mapping
Mapping test::ivoryaviary::mapping::AviaryMapping
(
  *test::ivoryaviary::domain::RingRecord[ringRecord]: Relational
  {
    ~primaryKey
    (
      [test::ivoryaviary::store::AviaryStore]aviary.ring_record.record_id
    )
    ~mainTable [test::ivoryaviary::store::AviaryStore]aviary.ring_record
    ringCode: toUpper(trim([test::ivoryaviary::store::AviaryStore]aviary.ring_record.ring_code)),
    speciesCode: [test::ivoryaviary::store::AviaryStore]aviary.ring_record.species_code,
    speciesName: [test::ivoryaviary::store::AviaryStore]aviary.ring_record.species_name,
    enclosureCode: [test::ivoryaviary::store::AviaryStore]aviary.ring_record.enclosure_code,
    wingSpanMm: [test::ivoryaviary::store::AviaryStore]aviary.ring_record.wing_span_mm,
    massG: [test::ivoryaviary::store::AviaryStore]aviary.ring_record.mass_g,
    observerTag: toLower(substring(trim([test::ivoryaviary::store::AviaryStore]aviary.ring_record.observer_name), 0, 5)),
    ageBand: case(
               equal([test::ivoryaviary::store::AviaryStore]aviary.ring_record.age_class_code, 'J'),
               'juvenile',
               case(
                 equal([test::ivoryaviary::store::AviaryStore]aviary.ring_record.age_class_code, 'A'),
                 'adult',
                 case(
                   equal([test::ivoryaviary::store::AviaryStore]aviary.ring_record.age_class_code, 'F'),
                   'first-year',
                   sqlNull()
                 )
               )
             ),
    noteLabel: coalesce([test::ivoryaviary::store::AviaryStore]aviary.ring_record.note_text, 'no remark'),
    ringWidth: length(trim([test::ivoryaviary::store::AviaryStore]aviary.ring_record.ring_code))
  }
)
