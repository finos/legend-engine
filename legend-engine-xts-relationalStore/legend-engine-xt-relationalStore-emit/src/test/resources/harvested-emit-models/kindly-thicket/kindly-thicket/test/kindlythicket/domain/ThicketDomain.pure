import test::kindlythicket::domain::*;

Class <<temporal.processingtemporal>> {meta::pure::profiles::doc.doc = 'A street tree in the civic inventory, corrected over processing time.'} test::kindlythicket::domain::TreeRecord
{
  tagCode: String[1];
  speciesCode: String[1];
  protectedSpecimen: Boolean[1];
}

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'The planting bed a street tree stands in, effective over business time.'} test::kindlythicket::domain::PlantingBed
{
  bedCode: String[1];
  surfaceType: String[1];
}

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'A civic district grouping planting beds, effective over business time.'} test::kindlythicket::domain::CivicDistrict
{
  districtName: String[1];
}

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'A maintenance crew rostered onto street trees in one of three roles, effective over business time.'} test::kindlythicket::domain::MaintenanceCrew
{
  crewCode: String[1];
  contactZone: String[1];
}

Association test::kindlythicket::domain::Tree_Bed
{
  trees: TreeRecord[*];
  bed: PlantingBed[0..1];
}

Association test::kindlythicket::domain::Bed_District
{
  beds: PlantingBed[*];
  district: CivicDistrict[0..1];
}

Association test::kindlythicket::domain::Tree_InspectionCrew
{
  inspectedTrees: TreeRecord[*];
  inspectionCrew: MaintenanceCrew[0..1];
}

Association test::kindlythicket::domain::Tree_PruningCrew
{
  prunedTrees: TreeRecord[*];
  pruningCrew: MaintenanceCrew[0..1];
}

Association test::kindlythicket::domain::Tree_WateringCrew
{
  wateredTrees: TreeRecord[*];
  wateringCrew: MaintenanceCrew[0..1];
}
