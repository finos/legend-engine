###Pure
import test::easternwarren5::domain::*;

Profile test::easternwarren5::domain::GaugeGovernance
{
  stereotypes: [curated, provisional];
  tags: [steward, cadence];
}

Class <<GaugeGovernance.curated>> {GaugeGovernance.steward = 'catchment-hydrometry-desk'} test::easternwarren5::domain::CatchmentZone
{
  zoneCode: String[1];
  zoneName: String[1];
  uplandFlag: String[1];
}

Class <<GaugeGovernance.provisional>> test::easternwarren5::domain::GaugeStation
{
  stationCode: String[1];
  stationName: String[1];
  sensorGrade: String[1];
  zone: CatchmentZone[1];
}

Class <<GaugeGovernance.curated>> {GaugeGovernance.cadence = 'daily'} test::easternwarren5::domain::GaugeReading
{
  readingCode: String[1];
  recordedOn: StrictDate[1];
  reviewState: String[1];
  stageMetres: Float[1];
  dischargeCumecs: Float[1];
  rainfallMm: Float[1];
  flowBand: String[0..1];
  advisoryNote: String[0..1];
  stationName: String[1];
  zoneName: String[1];
  station: GaugeStation[1];
}
