###Relational
Database test::easternwarren5::store::GaugeDb
(
  Schema catchment
  (
    Table catchment_zone
    (
      zone_code VARCHAR(16) PRIMARY KEY,
      zone_name VARCHAR(80) NOT NULL,
      upland_flag VARCHAR(1) NOT NULL
    )
    Table gauge_station
    (
      station_code VARCHAR(16) PRIMARY KEY,
      station_name VARCHAR(80) NOT NULL,
      zone_code VARCHAR(16) NOT NULL,
      sensor_grade VARCHAR(16) NOT NULL
    )
    Table gauge_reading
    (
      reading_code VARCHAR(16) PRIMARY KEY,
      station_code VARCHAR(16) NOT NULL,
      recorded_on DATE NOT NULL,
      review_state VARCHAR(16) NOT NULL,
      stage_metres FLOAT NOT NULL,
      discharge_cumecs FLOAT NOT NULL,
      rainfall_mm FLOAT NOT NULL,
      turbidity_ntu FLOAT
    )
  )

  Join Reading_Station(catchment.gauge_reading.station_code = catchment.gauge_station.station_code)
  Join Station_Zone(catchment.gauge_station.zone_code = catchment.catchment_zone.zone_code)
)
