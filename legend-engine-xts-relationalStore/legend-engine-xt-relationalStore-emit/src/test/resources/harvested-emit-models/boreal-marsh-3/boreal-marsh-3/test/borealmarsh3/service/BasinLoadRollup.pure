###Service
Service test::borealmarsh3::service::BasinLoadRollup
{
  pattern: '/borealmarsh3/v1/basin-load-rollup';
  title: 'Peat Marsh - Basin Folds Kept For The Basins The Caller Names';
  ownership: UserList { users: ['marsh-survey-desk'] };
  documentation: 'Reads the fold of the point book that is grouped by basin behind the class, keeps the basins the caller names, and returns the tally and stake total of each in basin order.';
  autoActivateUpdates: false;
  execution: Single
  {
    query:
    {
      basins: Integer[*]|
      test::borealmarsh3::domain::BasinLoad.all()->filter(
        x|$x.basinId->in($basins)
      )->project(
        [
          x|$x.basinId,
          x|$x.pointTally,
          x|$x.stakeTotal
        ],
        [
          'Basin',
          'Points',
          'Stakes'
        ]
      )->sort(
        [
          asc('Basin')
        ]
      )
    };
    mapping: test::borealmarsh3::mapping::MarshRefMapping;
    runtime: test::borealmarsh3::runtime::MarshRefRuntime;
  }
  testSuites:
  [
    basinLoadRollupSuite:
    {
      data:
      [
        connections:
        [
          marshConnection:
            Reference
            #{
              test::borealmarsh3::data::MarshTestData
            }#
        ]
      ]
      tests:
      [
        bothNamedBasins:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            basins = [1, 2]
          ]
          asserts:
          [
            twoFoldedBasins:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Basin":1,"Points":2,"Stakes":6},{"Basin":2,"Points":1,"Stakes":6}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
