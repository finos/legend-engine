###Relational
Database test::borealmarsh3::store::MarshSurveyDb
(
  Schema marsh
  (
    Table basin_block
    (
      basin_id INTEGER PRIMARY KEY,
      basin_code VARCHAR(24) NOT NULL,
      basin_name VARCHAR(96)
    )

    Table monitor_point
    (
      point_id INTEGER PRIMARY KEY,
      point_code VARCHAR(24) NOT NULL,
      point_name VARCHAR(96),
      basin_id INTEGER,
      point_kind VARCHAR(16),
      stake_count INTEGER
    )

    Table peat_point_detail
    (
      point_id INTEGER PRIMARY KEY,
      peat_depth_cm DOUBLE,
      probe_kind VARCHAR(24)
    )

    Table surveyor_roster
    (
      surveyor_code VARCHAR(24) PRIMARY KEY,
      surveyor_name VARCHAR(96)
    )

    Table plot_reading
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      reading_id INTEGER PRIMARY KEY,
      reading_code VARCHAR(24) NOT NULL,
      point_id INTEGER,
      surveyor_code VARCHAR(24),
      moisture_code VARCHAR(8),
      water_table_cm DOUBLE,
      peat_temp_c DOUBLE,
      probe_count INTEGER,
      reading_on DATE,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
  )

  Filter PeatPointFilter(marsh.monitor_point.point_kind = 'PEAT')

  Join Point_Basin(marsh.monitor_point.basin_id = marsh.basin_block.basin_id)
  Join Point_PeatDetail(marsh.monitor_point.point_id = marsh.peat_point_detail.point_id)
  Join Reading_Point(marsh.plot_reading.point_id = marsh.monitor_point.point_id)
  Join Reading_Surveyor(marsh.plot_reading.surveyor_code = marsh.surveyor_roster.surveyor_code)
)
