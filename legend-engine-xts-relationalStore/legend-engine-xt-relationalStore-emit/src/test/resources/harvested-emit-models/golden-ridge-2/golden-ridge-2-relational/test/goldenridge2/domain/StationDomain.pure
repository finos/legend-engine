###Pure
import demo::goldenridge2::domain::*;

Class demo::goldenridge2::domain::FieldLog
{
  logCode: String[1];
  voucherCode: String[1];
  observerName: String[1];
  stationName: String[1];
  tally: Integer[1];
}

Class demo::goldenridge2::domain::FieldStation
{
  stationCode: String[1];
  stationName: String[1];
}

Association demo::goldenridge2::domain::Duplicate_FieldLog
{
  duplicateFinding: DuplicateFinding[0..1];
  duplicateLogs: FieldLog[*];
}

Association demo::goldenridge2::domain::Mismatch_FieldLog
{
  intakeMismatch: IntakeMismatch[0..1];
  mismatchLogs: FieldLog[*];
}
