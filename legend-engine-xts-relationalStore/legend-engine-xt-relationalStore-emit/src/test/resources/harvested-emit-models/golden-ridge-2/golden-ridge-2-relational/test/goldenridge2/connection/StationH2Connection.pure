###Connection
RelationalDatabaseConnection demo::goldenridge2::connection::StationH2Connection
{
  store: demo::goldenridge2::store::FieldStationDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists station;',
      'create schema station;',
      'create table station.field_log (log_code varchar(24) primary key, voucher_code varchar(24) not null, station_code varchar(12) not null, observer_name varchar(60) not null, tally integer not null);',
      'create table station.station_ref (station_code varchar(12) primary key, station_name varchar(60) not null);'
      ];
  };
  auth: DefaultH2;
}
