###Relational
Database demo::goldenridge2::store::FieldStationDB
(
  Schema station
  (
    Table field_log
    (
      log_code VARCHAR(24) PRIMARY KEY,
      voucher_code VARCHAR(24) NOT NULL,
      station_code VARCHAR(12) NOT NULL,
      observer_name VARCHAR(60) NOT NULL,
      tally INTEGER NOT NULL
    )

    Table station_ref
    (
      station_code VARCHAR(12) PRIMARY KEY,
      station_name VARCHAR(60) NOT NULL
    )
  )

  Join Log_Station(station.field_log.station_code = station.station_ref.station_code)
)
