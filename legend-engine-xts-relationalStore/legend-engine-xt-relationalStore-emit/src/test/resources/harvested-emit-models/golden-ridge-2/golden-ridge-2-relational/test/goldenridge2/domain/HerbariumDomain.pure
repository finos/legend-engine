###Pure
import demo::goldenridge2::domain::*;

Class demo::goldenridge2::domain::SheetRecord
{
  sheetId: String[1];
  voucherCode: String[1];
  taxonCode: String[1];
  taxonName: String[1];
  collectorCode: String[1];
  mountCount: Integer[1];
  vigourScore: Integer[1];
  vigourBand: String[0..1];
  handlingNote: String[0..1];
  voucherLabel: String[1];
  sheetsOnVoucher: Integer[0..1];
  intakeOnVoucher: Integer[0..1];
}

Class demo::goldenridge2::domain::TaxonTally
{
  taxonCode: String[1];
  mountedTotal: Integer[1];
  peakVigour: Integer[1];
}

Class demo::goldenridge2::domain::DuplicateFinding
{
  voucherCode: String[1];
  sheetCount: Integer[1];
  peakMounts: Integer[1];
  duplicateVerdict: String[1];
}

Class demo::goldenridge2::domain::IntakeMismatch
{
  voucherCode: String[1];
  sheetCount: Integer[1];
  intakeTotal: Integer[0..1];
  mismatchVerdict: String[1];
}
