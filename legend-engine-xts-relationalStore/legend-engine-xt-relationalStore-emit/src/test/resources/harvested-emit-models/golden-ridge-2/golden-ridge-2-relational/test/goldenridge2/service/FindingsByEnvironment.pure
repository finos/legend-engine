###Service
Service demo::goldenridge2::service::FindingsByEnvironment
{
  pattern: '/goldenridge/v1/findings-by-environment/{environment}';
  title: 'Duplicate Findings By Environment';
  owners:
  [
    'herbarium-curation',
    'ridge-field-survey'
  ];
  documentation: 'Environment-keyed counterpart of the duplicate finding query. The execution key selects a whole execution stack, so the same projection is dispatched to the curation or the survey runtime.';
  autoActivateUpdates: true;
  execution: Multi
  {
    query: {vouchers: String[*]|demo::goldenridge2::domain::DuplicateFinding.all()->filter(
      d|$d.voucherCode->in($vouchers)
    )->project(
      ~[
        Voucher: d|$d.voucherCode,
        Verdict: d|$d.duplicateVerdict,
        Sheets: d|$d.sheetCount
      ]
    )->sort(
      [
        ~Voucher->ascending()
      ]
    )};
    key: 'environment';
    executions['curation']:
    {
      mapping: demo::goldenridge2::mapping::RidgeCrossMapping;
      runtime: demo::goldenridge2::runtime::RidgeCurationRuntime;
    }
    executions['survey']:
    {
      mapping: demo::goldenridge2::mapping::RidgeCrossMapping;
      runtime: demo::goldenridge2::runtime::RidgeSurveyRuntime;
    }
  }
}
