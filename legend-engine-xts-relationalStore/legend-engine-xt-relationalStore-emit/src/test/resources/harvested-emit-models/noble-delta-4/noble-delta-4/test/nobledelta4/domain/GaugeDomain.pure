Class {meta::pure::profiles::doc.doc = 'A river gauge on one channel of the delta.'} test::nobledelta4::domain::RiverGauge
{
  gaugeCode: String[1];
  channelName: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A gauge reading whose level, flow and crest were logged as text.'} test::nobledelta4::domain::GaugeReading
{
  readingCode: String[1];
  gaugeCode: String[1];
  levelCm: Integer[1];
  flowLitres: Integer[1];
  settledLevelCm: Integer[1];
  crestBand: String[0..1];
}
