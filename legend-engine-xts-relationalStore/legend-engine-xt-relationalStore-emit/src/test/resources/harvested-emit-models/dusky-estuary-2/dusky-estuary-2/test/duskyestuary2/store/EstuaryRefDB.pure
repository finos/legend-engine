###Relational
Database test::duskyestuary2::store::EstuaryRefDB
(
  Schema ref
  (
    Table mudflat
    (
      flat_code VARCHAR(24) PRIMARY KEY,
      flat_name VARCHAR(120) NOT NULL,
      estuary_name VARCHAR(120) NOT NULL,
      area_ha INTEGER NOT NULL
    )

    Table tide_band
    (
      band_code VARCHAR(24) PRIMARY KEY,
      band_name VARCHAR(120) NOT NULL,
      low_cm INTEGER NOT NULL,
      high_cm INTEGER NOT NULL
    )
  )
)
