###Pure
import demo::meadowarboretum3::domain::*;

Class {meta::pure::profiles::doc.doc = 'A street-tree canopy survey recorded by an upkeep crew in a city ward.'} demo::meadowarboretum3::domain::CanopySurvey
{
  surveyCode: String[1];
  wardCode: String[1];
  crewTeam: String[1];
  speciesClass: String[1];
  canopyGrade: String[0..1];
  patrolStatus: String[1];
  surveyedOn: StrictDate[1];
  seedlingCount: Integer[1];
  canopySpreadM: Float[1];
}
