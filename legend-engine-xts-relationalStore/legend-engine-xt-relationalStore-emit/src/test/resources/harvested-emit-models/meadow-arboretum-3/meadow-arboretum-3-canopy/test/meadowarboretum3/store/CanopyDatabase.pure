###Relational
Database demo::meadowarboretum3::store::CanopyDB
(
  Schema canopy
  (
    Table canopy_survey
    (
      survey_code VARCHAR(24) PRIMARY KEY,
      ward_code VARCHAR(24) NOT NULL,
      crew_team VARCHAR(40) NOT NULL,
      species_class VARCHAR(40) NOT NULL,
      canopy_grade VARCHAR(8),
      patrol_status VARCHAR(24) NOT NULL,
      surveyed_on DATE NOT NULL,
      seedling_count INTEGER NOT NULL,
      canopy_spread_m FLOAT NOT NULL
    )
  )
)
