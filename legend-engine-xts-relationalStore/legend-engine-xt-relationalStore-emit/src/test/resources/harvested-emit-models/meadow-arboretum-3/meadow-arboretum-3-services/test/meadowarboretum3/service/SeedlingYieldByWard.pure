###Service
Service demo::meadowarboretum3::service::SeedlingYieldByWard
{
  pattern: '/meadowarboretum3/v1/seedling-yield/{ward}/{patrolStatus}/{speciesClasses}';
  title: 'Meadow Arboretum 3 - Seedling Yield By Ward And Crew Team';
  owners:
  [
    'street-tree-canopy-programme',
    'canopy-survey-desk'
  ];
  documentation: 'Keeps the canopy surveys of one ward and patrol status whose survey date still falls inside a rolling window measured back from the current date, whose species class is one of the requested classes and whose canopy grade was actually recorded, then groups the survivors by species class and crew team and sums the seedling count and the canopy spread within each group. The rolling window is computed in the query rather than supplied, so the temporal arithmetic is part of the pushed-down predicate; an empty species-class collection makes the membership test false rather than faulting.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {ward: String[1], patrolStatus: String[1], speciesClasses: String[*], currentDate: StrictDate[1]|demo::meadowarboretum3::domain::CanopySurvey.all()->filter(
      s|($s.wardCode == $ward) && (($s.patrolStatus == $patrolStatus) && (($s.surveyedOn >= $currentDate->adjust(-7300, meta::pure::functions::date::DurationUnit.DAYS)) && (($s.speciesClass->in($speciesClasses)) && ($s.canopyGrade->isNotEmpty()))))
    )->groupBy(
      [
        s|$s.speciesClass,
        s|$s.crewTeam
      ],
      [
        agg(s|$s.seedlingCount, y|$y->sum()),
        agg(s|$s.canopySpreadM, y|$y->sum())
      ],
      [
        'SpeciesClass',
        'CrewTeam',
        'SeedlingTotal',
        'SpreadTotal'
      ]
    )->distinct()->sort(
      [
        asc('SpeciesClass'),
        asc('CrewTeam')
      ]
    )->take(25)};
    mapping: demo::meadowarboretum3::mapping::CanopyMapping;
    runtime: demo::meadowarboretum3::runtime::CanopyRuntime;
  }
  testSuites:
  [
    seedlingYieldSuite:
    {
      data:
      [
        connections:
        [
          canopyWarehouseConnection:
            Relational
            #{
              canopy.canopy_survey:
                'survey_code,ward_code,crew_team,species_class,canopy_grade,patrol_status,surveyed_on,seedling_count,canopy_spread_m\n'+
                'SV-01,WD-NORTH,NORTH-CREW,SMALL-LEAVED-LIME,A,PATROLLED,2026-05-02,120,6.5\n'+
                'SV-02,WD-NORTH,NORTH-CREW,SMALL-LEAVED-LIME,B,PATROLLED,2026-05-03,80,4.25\n'+
                'SV-03,WD-NORTH,SOUTH-CREW,FIELD-MAPLE,A,PATROLLED,2026-05-04,60,3.75\n'+
                'SV-04,WD-NORTH,NORTH-CREW,SMALL-LEAVED-LIME,,PATROLLED,2026-05-05,45,2.5\n'+
                'SV-05,WD-NORTH,NORTH-CREW,SMALL-LEAVED-LIME,A,DEFERRED,2026-05-06,30,1.5\n'+
                'SV-06,WD-SOUTH,NORTH-CREW,SMALL-LEAVED-LIME,A,PATROLLED,2026-05-07,25,1.25\n'+
                'SV-07,WD-NORTH,NORTH-CREW,SMALL-LEAVED-LIME,A,PATROLLED,2001-05-08,15,0.75\n'+
                'SV-08,WD-NORTH,NORTH-CREW,LONDON-PLANE,A,PATROLLED,2026-05-09,10,0.5\n';
            }#
        ]
      ]
      tests:
      [
        groupedYieldForRequestedClasses:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            ward = 'WD-NORTH',
            patrolStatus = 'PATROLLED',
            speciesClasses = ['SMALL-LEAVED-LIME', 'FIELD-MAPLE'],
            currentDate = %2026-08-01
          ]
          asserts:
          [
            twoGroupsWithSummedMeasures:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"SpeciesClass":"FIELD-MAPLE","CrewTeam":"SOUTH-CREW","SeedlingTotal":60,"SpreadTotal":3.75},{"SpeciesClass":"SMALL-LEAVED-LIME","CrewTeam":"NORTH-CREW","SeedlingTotal":200,"SpreadTotal":10.75}]';
                  }#;
              }#
          ]
        },
        emptyClassCollectionYieldsNoGroups:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            ward = 'WD-NORTH',
            patrolStatus = 'PATROLLED',
            speciesClasses = [],
            currentDate = %2026-08-01
          ]
          asserts:
          [
            noGroups:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
