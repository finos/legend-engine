###Service
Service demo::meadowarboretum3::service::SpeciesClassesSurveyed
{
  pattern: '/meadowarboretum3/v1/species-classes/{ward}/{patrolStatus}/{crewTeam}';
  title: 'Meadow Arboretum 3 - Species Classes Surveyed In A Ward';
  owners:
  [
    'street-tree-canopy-programme',
    'canopy-survey-desk'
  ];
  documentation: 'Conjoins the ward, patrol status and crew team equalities with a rolling date window measured back from the current date, projects the species class and the recorded canopy grade of the survivors and de-duplicates the projection, so the result carries set semantics rather than one row per survey.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {ward: String[1], patrolStatus: String[1], crewTeam: String[1], currentDate: StrictDate[1]|demo::meadowarboretum3::domain::CanopySurvey.all()->filter(
      s|($s.wardCode == $ward) && (($s.patrolStatus == $patrolStatus) && (($s.crewTeam == $crewTeam) && ($s.surveyedOn >= $currentDate->adjust(-7300, meta::pure::functions::date::DurationUnit.DAYS))))
    )->project(
      [
        s|$s.speciesClass,
        s|$s.canopyGrade
      ],
      [
        'SpeciesClass',
        'CanopyGrade'
      ]
    )->distinct()->sort(
      [
        asc('SpeciesClass'),
        asc('CanopyGrade')
      ]
    )};
    mapping: demo::meadowarboretum3::mapping::CanopyMapping;
    runtime: demo::meadowarboretum3::runtime::CanopyRuntime;
  }
  testSuites:
  [
    speciesClassesSuite:
    {
      data:
      [
        connections:
        [
          canopyWarehouseConnection:
            Relational
            #{
              canopy.canopy_survey:
                'survey_code,ward_code,crew_team,species_class,canopy_grade,patrol_status,surveyed_on,seedling_count,canopy_spread_m\n'+
                'SV-01,WD-NORTH,NORTH-CREW,SMALL-LEAVED-LIME,A,PATROLLED,2026-05-02,120,6.5\n'+
                'SV-02,WD-NORTH,NORTH-CREW,SMALL-LEAVED-LIME,A,PATROLLED,2026-05-03,80,4.25\n'+
                'SV-03,WD-NORTH,NORTH-CREW,FIELD-MAPLE,B,PATROLLED,2026-05-04,60,3.75\n'+
                'SV-04,WD-NORTH,SOUTH-CREW,LONDON-PLANE,A,PATROLLED,2026-05-05,45,2.5\n'+
                'SV-05,WD-NORTH,NORTH-CREW,LONDON-PLANE,A,DEFERRED,2026-05-06,30,1.5\n'+
                'SV-06,WD-NORTH,NORTH-CREW,HORNBEAM,A,PATROLLED,2001-05-07,20,1.0\n';
            }#
        ]
      ]
      tests:
      [
        distinctClassesForOneCrew:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            ward = 'WD-NORTH',
            patrolStatus = 'PATROLLED',
            crewTeam = 'NORTH-CREW',
            currentDate = %2026-08-01
          ]
          asserts:
          [
            twoDistinctPairs:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"SpeciesClass":"FIELD-MAPLE","CanopyGrade":"B"},{"SpeciesClass":"SMALL-LEAVED-LIME","CanopyGrade":"A"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
