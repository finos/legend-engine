###Mapping
Mapping test::crimsoncanyon::mapping::LayerM2M
(
  *test::crimsoncanyon::domain::StrataLayer: Pure
  {
    ~src test::crimsoncanyon::source::IncomingLayer
    unitCode: $src.code,
    name: $src.label,
    thicknessMeters: $src.thickness,
    status: $src.status
  }

  testSuites:
  [
    layerSuite:
    {
      function: |test::crimsoncanyon::domain::StrataLayer.all()->graphFetch(
        #{
          test::crimsoncanyon::domain::StrataLayer
          {
            unitCode,
            name,
            thicknessMeters,
            status,
            thicknessBand
          }
        }#
      )->serialize(
        #{
          test::crimsoncanyon::domain::StrataLayer
          {
            unitCode,
            name,
            thicknessMeters,
            status,
            thicknessBand
          }
        }#
      );
      tests:
      [
        layerAlpha:
        {
          doc: 'Round-trips an inbound strata layer record through the model-to-model transform and derived band.';
          data:
          [
            ModelStore:
              ModelStore
              #{
                test::crimsoncanyon::source::IncomingLayer:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"code":"RU-01","label":"Sandstone Bed","thickness":45.0,"status":"EXPOSED"}';
                  }#
              }#
          ];
          asserts:
          [
            mappedLayer:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"unitCode":"RU-01","name":"Sandstone Bed","thicknessMeters":45.0,"status":"EXPOSED","thicknessBand()":"MEDIUM"}';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
