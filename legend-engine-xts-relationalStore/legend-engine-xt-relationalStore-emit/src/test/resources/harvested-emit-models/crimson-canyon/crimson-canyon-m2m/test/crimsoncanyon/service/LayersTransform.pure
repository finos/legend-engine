###Service
Service test::crimsoncanyon::service::LayersTransform
{
  pattern: '/crimsoncanyon/layersTransform';
  owners:
  [
    'canyon-geology'
  ];
  documentation: 'Accepts an inbound legacy-shape strata layer record as JSON and returns the corresponding current-model StrataLayer graph including a derived thickness band, backed by the LayerM2M model-to-model mapping.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |test::crimsoncanyon::domain::StrataLayer.all()->graphFetch(
      #{
        test::crimsoncanyon::domain::StrataLayer
        {
          unitCode,
          name,
          thicknessMeters,
          status,
          thicknessBand
        }
      }#
    )->serialize(
      #{
        test::crimsoncanyon::domain::StrataLayer
        {
          unitCode,
          name,
          thicknessMeters,
          status,
          thicknessBand
        }
      }#
    );
    mapping: test::crimsoncanyon::mapping::LayerM2M;
    runtime: test::crimsoncanyon::runtime::CanyonRuntime;
  }
  testSuites:
  [
    layersServiceSuite:
    {
      data:
      [
        connections:
        [
          incomingLayerConnection:
            ExternalFormat
            #{
              contentType: 'application/json';
              data: '{"code":"RU-02","label":"Limestone Bed","thickness":150.0,"status":"BURIED"}';
            }#
        ]
      ]
      tests:
      [
        limestoneLayer:
        {
          asserts:
          [
            transformedLayer:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":{"unitCode":"RU-02","name":"Limestone Bed","thicknessMeters":150.0,"status":"BURIED","thicknessBand()":"THICK"}}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
