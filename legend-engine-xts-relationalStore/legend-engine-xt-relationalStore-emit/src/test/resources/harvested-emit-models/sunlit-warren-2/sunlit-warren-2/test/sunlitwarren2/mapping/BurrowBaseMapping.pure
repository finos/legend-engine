###Mapping
Mapping test::sunlitwarren2::mapping::BurrowBaseMapping
(
  *test::sunlitwarren2::domain::Burrow[burrow]: Relational
  {
    ~primaryKey
    (
      [test::sunlitwarren2::store::WarrenDb]warrens.burrow.burrow_id
    )
    ~mainTable [test::sunlitwarren2::store::WarrenDb]warrens.burrow
    burrowCode: [test::sunlitwarren2::store::WarrenDb]warrens.burrow.burrow_code,
    keeperCode: [test::sunlitwarren2::store::WarrenDb]warrens.burrow.keeper_code,
    zoneCode: [test::sunlitwarren2::store::WarrenDb]warrens.burrow.zone_code,
    chamberCount: [test::sunlitwarren2::store::WarrenDb]warrens.burrow.chamber_count,
    burrowLabel: concat(toUpper([test::sunlitwarren2::store::WarrenDb]warrens.burrow.burrow_code), concat('-', toLower(coalesce([test::sunlitwarren2::store::WarrenDb]@Burrow_Keeper | [test::sunlitwarren2::store::WarrenDb]warrens.keeper.keeper_name, 'unstaffed'))))
  }

  *test::sunlitwarren2::domain::Warren[warren]: Relational
  {
    ~primaryKey
    (
      [test::sunlitwarren2::store::WarrenDb]warrens.warren.warren_code
    )
    ~mainTable [test::sunlitwarren2::store::WarrenDb]warrens.warren
    warrenCode: [test::sunlitwarren2::store::WarrenDb]warrens.warren.warren_code,
    warrenName: [test::sunlitwarren2::store::WarrenDb]warrens.warren.warren_name
  }
)
