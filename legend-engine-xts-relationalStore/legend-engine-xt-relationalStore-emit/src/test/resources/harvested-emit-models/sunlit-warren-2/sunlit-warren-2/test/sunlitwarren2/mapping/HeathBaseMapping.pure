###Mapping
Mapping test::sunlitwarren2::mapping::HeathBaseMapping
(
  *test::sunlitwarren2::domain::Heath[heath]: Relational
  {
    ~primaryKey
    (
      [test::sunlitwarren2::store::WarrenDb]warrens.heath.heath_code
    )
    ~mainTable [test::sunlitwarren2::store::WarrenDb]warrens.heath
    heathCode: [test::sunlitwarren2::store::WarrenDb]warrens.heath.heath_code,
    heathName: [test::sunlitwarren2::store::WarrenDb]warrens.heath.heath_name
  }

  *test::sunlitwarren2::domain::Reserve[reserve]: Relational
  {
    ~primaryKey
    (
      [test::sunlitwarren2::store::WarrenDb]warrens.reserve.reserve_code
    )
    ~mainTable [test::sunlitwarren2::store::WarrenDb]warrens.reserve
    reserveCode: [test::sunlitwarren2::store::WarrenDb]warrens.reserve.reserve_code,
    reserveName: [test::sunlitwarren2::store::WarrenDb]warrens.reserve.reserve_name,
    biomeKind: [test::sunlitwarren2::store::WarrenDb]warrens.reserve.biome_kind
  }
)
