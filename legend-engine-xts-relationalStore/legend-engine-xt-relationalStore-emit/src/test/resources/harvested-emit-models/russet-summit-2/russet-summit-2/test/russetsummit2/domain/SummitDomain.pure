###Pure
import test::russetsummit2::domain::*;

Enum test::russetsummit2::domain::TaskStage
{
  RAISED,
  SCHEDULED,
  ACTIVE,
  COMPLETE
}

Enum test::russetsummit2::domain::SurfaceKind
{
  STONE_PITCH,
  AGGREGATE,
  BOARDWALK
}

Enum test::russetsummit2::domain::UrgencyBand
{
  ROUTINE,
  ELEVATED,
  CRITICAL
}

Enum test::russetsummit2::domain::CrewGrade
{
  LEAD,
  TRAINEE
}

Class test::russetsummit2::domain::FootpathSection
{
  sectionCode: String[1];
  sectionName: String[1];
  surface: SurfaceKind[0..1];
  lengthM: Integer[1];
}

Class test::russetsummit2::domain::RepairTask
{
  taskId: Integer[1];
  sectionCode: String[1];
  stage: TaskStage[0..1];
  urgency: UrgencyBand[0..1];
  haulNote: String[0..1];
  loadUnits: Integer[1];
  crewGrade: CrewGrade[0..1];
  wardenName: String[0..1];
  sectionName: String[0..1];
}

Class test::russetsummit2::domain::WorkCrew
{
  crewCode: String[1];
  crewName: String[1];
  crewKind: String[1];
  wardenName: String[0..1];
}

Association test::russetsummit2::domain::Section_Tasks
{
  tasks: RepairTask[*];
  section: FootpathSection[0..1];
}
