###Connection
RelationalDatabaseConnection test::opalreef2::connection::ReefH2Connection
{
  store: test::opalreef2::store::ReefSurveyDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists tidepool;',
      'create schema tidepool;',
      'create table tidepool.pool (pool_id integer primary key, pool_code varchar(16) not null, shore_zone varchar(32) not null, exposure_class varchar(32) not null);',
      'create table tidepool.census (census_id integer primary key, census_code varchar(16) not null, species_name varchar(64) not null, tally_n integer not null, survey_on date not null, surveyor_name varchar(32) not null, method_c varchar(32) not null, pool_id integer not null);'
      ];
  };
  auth: DefaultH2;
}
