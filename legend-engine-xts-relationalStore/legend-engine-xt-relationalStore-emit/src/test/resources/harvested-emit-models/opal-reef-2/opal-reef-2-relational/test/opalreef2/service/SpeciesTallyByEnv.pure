###Service
Service test::opalreef2::service::SpeciesTallyByEnv
{
  pattern: '/tidepool/v1/tally/env/{zone}';
  title: 'Species Tally by Environment';
  owners:
  [
    'shore-survey',
    'intertidal-ops'
  ];
  documentation: 'Multi-execution variant selecting the survey runtime from an environment key while sharing one query body.';
  autoActivateUpdates: true;
  execution: Multi
  {
    query: {speciesList: String[*], zone: String[1], exposure: String[1], surveyor: String[1], method: String[1]|test::opalreef2::domain::Census.all()->filter(
      c|($c.species->in($speciesList)) &&
        (($c.pool.shoreZone == $zone) &&
          (($c.pool.exposureClass == $exposure) &&
            (($c.surveyor == $surveyor) && ($c.surveyMethod == $method))))
    )->groupBy(
      [
        c|$c.species,
        c|$c.pool.shoreZone
      ],
      [
        agg(
          c|$c.tally,
          y|$y->sum()
        ),
        agg(
          c|$c.censusCode,
          y|$y->count()
        )
      ],
      [
        'Species',
        'Zone',
        'TotalTally',
        'Surveys'
      ]
    )->sort(
      [
        asc('Species')
      ]
    )};
    key: 'env';
    executions['dev']:
    {
      mapping: test::opalreef2::mapping::ReefSurveyMapping;
      runtime: test::opalreef2::runtime::ReefSurveyRuntime;
    }
    executions['prod']:
    {
      mapping: test::opalreef2::mapping::ReefSurveyMapping;
      runtime: test::opalreef2::runtime::ReefSurveyStandbyRuntime;
    }
  }
}
