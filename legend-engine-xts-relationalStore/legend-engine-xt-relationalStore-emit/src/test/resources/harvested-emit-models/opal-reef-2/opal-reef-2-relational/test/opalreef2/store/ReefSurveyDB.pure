###Relational
Database test::opalreef2::store::ReefSurveyDB
(
  Schema tidepool
  (
    Table pool
    (
      pool_id INTEGER PRIMARY KEY,
      pool_code VARCHAR(16) NOT NULL,
      shore_zone VARCHAR(32) NOT NULL,
      exposure_class VARCHAR(32) NOT NULL
    )
    Table census
    (
      census_id INTEGER PRIMARY KEY,
      census_code VARCHAR(16) NOT NULL,
      species_name VARCHAR(64) NOT NULL,
      tally_n INTEGER NOT NULL,
      survey_on DATE NOT NULL,
      surveyor_name VARCHAR(32) NOT NULL,
      method_c VARCHAR(32) NOT NULL,
      pool_id INTEGER NOT NULL
    )
  )

  Join Census_Pool(tidepool.census.pool_id = tidepool.pool.pool_id)
)
