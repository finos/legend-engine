import test::opalreef2::domain::*;

Class {meta::pure::profiles::doc.doc = 'A rock pool on the intertidal shore, classified by shore zone and wave exposure.'} test::opalreef2::domain::Tidepool
{
  poolCode: String[1];
  shoreZone: String[1];
  exposureClass: String[1];
}

Class {meta::pure::profiles::doc.doc = 'One counted species observation made in a rock pool by a survey team using a stated method.'} test::opalreef2::domain::Census
{
  censusCode: String[1];
  species: String[1];
  tally: Integer[1];
  surveyOn: StrictDate[1];
  surveyor: String[1];
  surveyMethod: String[1];
  pool: Tidepool[1];
}
