###Connection
RelationalDatabaseConnection test::goldendelta::connection::RosterH2Connection
{
  store: test::goldendelta::store::RosterDatabase;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls:
    [
      'drop table if exists roster.volunteer_record;',
      'create schema if not exists roster;',
      'create table roster.volunteer_record(record_ref varchar(16), combined_name varchar(120), depot_code varchar(8), trailhead_name varchar(64), access_note varchar(120), enrolled_on date);',
      'insert into roster.volunteer_record values (\'GD-201\', \'Ferny Wraysbury\', \'DP-N\', \'Alder Steps\', \'Gate is left unlatched in summer\', \'2026-03-02\');',
      'insert into roster.volunteer_record values (\'GD-202\', \'Marsh Kite Alderway\', \'DP-N\', \'Bramble Gate\', \'Second gate on the lower path\', \'2026-03-05\');',
      'insert into roster.volunteer_record values (\'GD-203\', \' Bracken Hollow\', \'DP-S\', \'Cinder Rise\', \'Park on the verge below the rise\', \'2026-03-09\');',
      'insert into roster.volunteer_record values (\'GD-204\', \'Cobweb \', \'DP-S\', \'Dyke Crossing\', \'Ford is impassable after rain\', \'2026-03-11\');'
    ];
  };
  auth: DefaultH2;
}

ModelChainConnection test::goldendelta::connection::RosterChainConnection
{
  mappings:
  [
    test::goldendelta::mapping::RosterRelationalMapping
  ];
}
