{
  trailheadName: String[1];
  detail: test::goldendelta::domain::TrailheadDetail[1];
}

Class test::goldendelta::domain::TrailheadDetail
{
  accessNote: String[1];
}

Class test::goldendelta::domain::Depot
{
  depotCode: String[1];
  depotName: String[1];
}
