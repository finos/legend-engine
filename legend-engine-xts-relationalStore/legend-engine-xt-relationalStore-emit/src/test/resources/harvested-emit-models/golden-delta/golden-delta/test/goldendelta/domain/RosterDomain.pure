###Pure
Class test::goldendelta::domain::Volunteer
{
  {meta::pure::profiles::doc.doc = 'Segment of the enrolment name that precedes the first separator; a name recorded without a separator has no reachable value here at all.'} givenName: String[1];
  {meta::pure::profiles::doc.doc = 'Remainder of the enrolment name after the first separator, so any further separators stay inside this segment.'} familyName: String[1];
  postedTrailhead: test::goldendelta::domain::Trailhead[1];
  homeDepot: test::goldendelta::domain::Depot[1];
}

