###Connection
RelationalDatabaseConnection test::azureestuary3::connection::EstuaryHostConnection
{
  store: test::azureestuary3::store::EstuaryDB;
  type: DB2;
  timezone: +0000;
  quoteIdentifiers: false;
  specification: Static
  {
    name: 'estuary_census';
    host: 'example-estuary-census-host';
    port: 50000;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'estuarycensusprincipal';
  };
}

###Connection
RelationalDatabaseConnection test::azureestuary3::connection::EstuaryMemoryConnection
{
  store: test::azureestuary3::store::EstuaryDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [];
  };
  auth: DefaultH2;
}
