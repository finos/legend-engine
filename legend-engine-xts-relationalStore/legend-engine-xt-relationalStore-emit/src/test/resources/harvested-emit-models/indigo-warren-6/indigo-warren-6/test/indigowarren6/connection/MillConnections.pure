###Connection
RelationalDatabaseConnection test::indigowarren6::connection::MillH2Connection
{
  store: test::indigowarren6::store::MillDb;
  type: H2;
  specification: LocalH2
  {
  };
  auth: DefaultH2;
}

RelationalDatabaseConnection test::indigowarren6::connection::MillRegisterConnection
{
  store: test::indigowarren6::store::MillDb;
  type: DB2;
  specification: Static
  {
    name: 'mill_dressing_register';
    host: 'example-mill-register-host';
    port: 50000;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'milldressingregisterprincipal';
  };
}
