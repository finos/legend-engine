###Pure
import meta::pure::profiles::*;
import test::indigowarren6::domain::*;

Class {doc.doc = 'A windmill site whose sails drive the milling floor.'} test::indigowarren6::domain::MillSite
{
  siteCode: String[1];
  siteName: String[1];
  sailKind: String[1];
  parishName: String[1];
  countyName: String[0..1];
}

Class <<temporal.businesstemporal>> {doc.doc = 'One millstone of a windmill as it stood on a business date: the dressing it carries, the site and county reached by walking the site relation, and the grinding load totalled through the grouped run view.'} test::indigowarren6::domain::Millstone
{
  stoneCode: String[1];
  stoneName: String[1];
  furrowCount: Integer[1];
  dressedOn: StrictDate[1];
  gritLabel: String[1];
  dressingNote: String[1];
  siteName: String[0..1];
  countyName: String[0..1];
  sackTotal: Integer[0..1];
  runTally: Integer[0..1];
}

Class {doc.doc = 'A parish the windmill sites are registered in.'} test::indigowarren6::domain::MillParish
{
  parishName: String[1];
  countyName: String[1];
}
