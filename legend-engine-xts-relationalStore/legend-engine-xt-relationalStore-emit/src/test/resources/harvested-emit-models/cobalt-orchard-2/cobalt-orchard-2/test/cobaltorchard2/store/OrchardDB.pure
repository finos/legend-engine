###Relational
Database test::cobaltorchard2::store::OrchardDB
(
  Schema orchard
  (
    Table tree_inspection
    (
      inspection_id VARCHAR(24) PRIMARY KEY,
      sequence_no INTEGER PRIMARY KEY,
      block_code VARCHAR(24) NOT NULL,
      inspection_kind VARCHAR(24) NOT NULL,
      canopy_note VARCHAR(200),
      recorded_at TIMESTAMP
    )

    Table graft_record
    (
      graft_id VARCHAR(24) PRIMARY KEY,
      rootstock_code VARCHAR(24) NOT NULL,
      graft_status VARCHAR(24) NOT NULL,
      scion_note VARCHAR(200),
      recorded_at TIMESTAMP
    )
  )
)
