###Service
Service test::cobaltorchard2::service::GraftsSinceSeasonStart
{
  pattern: '/orchard/v1/grafts-since-season';
  title: 'Grafts Since Season Start';
  owners:
  [
    'orchard-nursery-desk',
    'orchard-stewards'
  ];
  documentation: 'Counts graft records recorded on or after a cutoff derived from the evaluation date by subtracting the graft season window, grouped by rootstock and graft status, published against the production and rehearsal estates.';
  autoActivateUpdates: false;
  execution: Multi
  {
    query: |test::cobaltorchard2::domain::GraftRecord.all()->filter(
      g|$g.recordedAt->toOne() >= test::cobaltorchard2::function::graftSeasonCutoff()
    )->groupBy(
      [
        g|$g.rootstockCode,
        g|$g.graftStatus
      ],
      [
        agg(g|$g.graftId, y|$y->count())
      ],
      [
        'Rootstock',
        'Status',
        'GraftCount'
      ]
    )->sort(
      [
        asc('Rootstock'),
        asc('Status')
      ]
    );
    key: 'estate';
    executions['production']:
    {
      mapping: test::cobaltorchard2::mapping::GraftMapping;
      runtime: test::cobaltorchard2::runtime::OrchardProductionRuntime;
    }
    executions['rehearsal']:
    {
      mapping: test::cobaltorchard2::mapping::GraftMapping;
      runtime: test::cobaltorchard2::runtime::OrchardRehearsalRuntime;
    }
  }
}

Service test::cobaltorchard2::service::GraftsRecordedToday
{
  pattern: '/orchard/v1/grafts-today';
  title: 'Grafts Recorded Today';
  owners:
  [
    'orchard-nursery-desk',
    'orchard-stewards'
  ];
  documentation: 'Counts graft records whose timestamp sits between the start of the evaluation date and the evaluation instant, grouped by rootstock and graft status, so a rootstock worked on earlier in the season contributes nothing to the answer.';
  autoActivateUpdates: false;
  execution: Multi
  {
    query: {currentDateTime: DateTime[1], currentDate: StrictDate[1]|test::cobaltorchard2::domain::GraftRecord.all()->filter(
      g|($g.recordedAt->toOne() <= $currentDateTime) && ($g.recordedAt->toOne() >= $currentDate)
    )->groupBy(
      [
        g|$g.rootstockCode,
        g|$g.graftStatus
      ],
      [
        agg(g|$g.graftId, y|$y->count())
      ],
      [
        'Rootstock',
        'Status',
        'GraftCount'
      ]
    )->sort(
      [
        asc('Rootstock'),
        asc('Status')
      ]
    )};
    key: 'estate';
    executions['production']:
    {
      mapping: test::cobaltorchard2::mapping::GraftMapping;
      runtime: test::cobaltorchard2::runtime::OrchardProductionRuntime;
    }
    executions['rehearsal']:
    {
      mapping: test::cobaltorchard2::mapping::GraftMapping;
      runtime: test::cobaltorchard2::runtime::OrchardRehearsalRuntime;
    }
  }
}
