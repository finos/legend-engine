###Relational
Database test::quietlighthouse::store::EstateDB
(
  Schema harbour
  (
    Table station
    (
      station_id INTEGER PRIMARY KEY,
      station_code VARCHAR(16) NOT NULL,
      station_name VARCHAR(64) NOT NULL,
      first_lit DATE NOT NULL
    )

    Table lamp
    (
      lamp_id INTEGER PRIMARY KEY,
      lamp_code VARCHAR(16) NOT NULL,
      lamp_type VARCHAR(32) NOT NULL,
      wattage INTEGER NOT NULL
    )

    Table lens
    (
      lens_id INTEGER PRIMARY KEY,
      lens_code VARCHAR(16) NOT NULL,
      lens_order VARCHAR(16) NOT NULL,
      focal_length_mm INTEGER NOT NULL
    )

    Table foghorn
    (
      foghorn_id INTEGER PRIMARY KEY,
      horn_code VARCHAR(16) NOT NULL,
      blast_seconds DOUBLE NOT NULL
    )

    Table cottage
    (
      cottage_id INTEGER PRIMARY KEY,
      cottage_code VARCHAR(16) NOT NULL,
      cottage_name VARCHAR(64) NOT NULL,
      bedrooms INTEGER NOT NULL
    )

    Table jetty
    (
      jetty_id INTEGER PRIMARY KEY,
      jetty_code VARCHAR(16) NOT NULL,
      jetty_name VARCHAR(64) NOT NULL,
      length_m DOUBLE NOT NULL
    )

    Table paint_cycle
    (
      cycle_id INTEGER PRIMARY KEY,
      cycle_code VARCHAR(16) NOT NULL,
      cycle_year INTEGER NOT NULL,
      coats INTEGER NOT NULL
    )
  )
)
