###Relational
Database test::quietlighthouse::store::SurveyDB
(
  Schema survey
  (
    Table inspection
    (
      inspection_id INTEGER PRIMARY KEY,
      inspection_code VARCHAR(16) NOT NULL,
      station_code VARCHAR(16) NOT NULL,
      findings VARCHAR(128) NOT NULL,
      inspected_on DATE NOT NULL
    )

    Table station_register
    (
      station_code VARCHAR(16) PRIMARY KEY,
      station_name VARCHAR(64) NOT NULL,
      district VARCHAR(32) NOT NULL
    )
  )

  Join Inspection_Station
  (
    survey.inspection.station_code = survey.station_register.station_code
  )
)
