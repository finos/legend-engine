###Pure
Class {meta::pure::profiles::doc.doc = 'A structural inspection written up against a station. The station name and district are not held on the inspection row: they are reached across a named join onto the survey register.'} test::quietlighthouse::domain::Inspection
{
  inspectionCode: String[1];
  findings: String[1];
  inspectedOn: StrictDate[1];
  stationName: String[1];
  district: String[1];
}

Class {meta::pure::profiles::doc.doc = 'The survey office register of stations, keyed by station code and carrying the district the station is administered from.'} test::quietlighthouse::domain::StationRegisterEntry
{
  stationCode: String[1];
  stationName: String[1];
  district: String[1];
}
