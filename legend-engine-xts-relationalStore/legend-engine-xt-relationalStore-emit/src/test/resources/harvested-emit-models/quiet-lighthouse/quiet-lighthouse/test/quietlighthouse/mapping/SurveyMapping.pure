###Mapping
Mapping test::quietlighthouse::mapping::SurveyMapping
(
  *test::quietlighthouse::domain::Inspection[inspection]: Relational
  {
    ~primaryKey
    (
      [test::quietlighthouse::store::SurveyDB]survey.inspection.inspection_id
    )
    ~mainTable [test::quietlighthouse::store::SurveyDB]survey.inspection
    inspectionCode: [test::quietlighthouse::store::SurveyDB]survey.inspection.inspection_code,
    findings: [test::quietlighthouse::store::SurveyDB]survey.inspection.findings,
    inspectedOn: [test::quietlighthouse::store::SurveyDB]survey.inspection.inspected_on,
    stationName: [test::quietlighthouse::store::SurveyDB]@Inspection_Station | [test::quietlighthouse::store::SurveyDB]survey.station_register.station_name,
    district: [test::quietlighthouse::store::SurveyDB]@Inspection_Station | [test::quietlighthouse::store::SurveyDB]survey.station_register.district
  }

  *test::quietlighthouse::domain::StationRegisterEntry[stationRegisterEntry]: Relational
  {
    ~primaryKey
    (
      [test::quietlighthouse::store::SurveyDB]survey.station_register.station_code
    )
    ~mainTable [test::quietlighthouse::store::SurveyDB]survey.station_register
    stationCode: [test::quietlighthouse::store::SurveyDB]survey.station_register.station_code,
    stationName: [test::quietlighthouse::store::SurveyDB]survey.station_register.station_name,
    district: [test::quietlighthouse::store::SurveyDB]survey.station_register.district
  }

  testSuites:
  [
    inspectionReadSuite:
    {
      function: |test::quietlighthouse::domain::Inspection.all()->project(
  [
    i|$i.inspectionCode,
    i|$i.stationName,
    i|$i.district,
    i|$i.findings
  ],
  [
    'Inspection',
    'Station',
    'District',
    'Findings'
  ]
)->sort(
  [
    asc('Inspection')
  ]
);
      tests:
      [
        theStationNameAndDistrictAreReachedAcrossTheNamedJoin:
        {
          doc: 'The inspection row holds only a station code, so the station name and the district are read one hop away through the named join onto the survey register. An inspection written up against a station that never made it onto the register still returns, with both joined columns unresolved.';
          data:
          [
            test::quietlighthouse::store::SurveyDB:
              Relational
              #{
                survey.inspection:
                  'inspection_id,inspection_code,station_code,findings,inspected_on\n'+
                  '1,IN-01,ST-01,gallery rail corroded,2026-03-11\n'+
                  '2,IN-02,ST-02,lantern glazing sound,2026-03-18\n'+
                  '3,IN-03,ST-99,tower not on the register,2026-03-25\n';
                survey.station_register:
                  'station_code,station_name,district\n'+
                  'ST-01,Grey Skerry,NORTH_SHORE\n'+
                  'ST-02,Sand Point,WEST_SOUND\n';
              }#
          ];
          asserts:
          [
            theUnregisteredStationLeavesBothJoinedColumnsUnresolved:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Inspection":"IN-01","Station":"Grey Skerry","District":"NORTH_SHORE","Findings":"gallery rail corroded"},{"Inspection":"IN-02","Station":"Sand Point","District":"WEST_SOUND","Findings":"lantern glazing sound"},{"Inspection":"IN-03","Station":null,"District":null,"Findings":"tower not on the register"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
