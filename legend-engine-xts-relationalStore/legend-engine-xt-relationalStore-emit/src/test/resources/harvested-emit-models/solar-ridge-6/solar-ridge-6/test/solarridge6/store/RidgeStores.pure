###Relational
Database test::solarridge6::store::RidgeArrayDb
(
  Schema ridge
  (
    Table array_reading
    (
      reading_date DATE PRIMARY KEY,
      array_code VARCHAR(24) PRIMARY KEY,
      string_code VARCHAR(24) PRIMARY KEY,
      tilt_class VARCHAR(16),
      inverter_state VARCHAR(16),
      panel_count INTEGER,
      irradiance_wm2 DOUBLE,
      output_kwh DOUBLE,
      soiling_pct DOUBLE,
      downtime_min INTEGER,
      observer_note VARCHAR(120)
    )
  )
)
