###Mapping
Mapping test::gildedcove3::mapping::CoveKelpMapping
(
  *test::gildedcove3::domain::KelpPlot[kelpPlot]: Relational
  {
    ~primaryKey
    (
      [test::gildedcove3::store::CoveKelpDb]kelp.kelp_plot.plot_id
    )
    ~mainTable [test::gildedcove3::store::CoveKelpDb]kelp.kelp_plot
    plotCode: [test::gildedcove3::store::CoveKelpDb]kelp.kelp_plot.plot_code,
    bedCode: [test::gildedcove3::store::CoveKelpDb]kelp.kelp_plot.bed_code,
    canopyClass: [test::gildedcove3::store::CoveKelpDb]kelp.kelp_plot.canopy_class,
    plotLabel: concat(
      [test::gildedcove3::store::CoveKelpDb]kelp.kelp_plot.canopy_class,
      ' @ ',
      [test::gildedcove3::store::CoveKelpDb]kelp.kelp_plot.bed_code
    ),
    frondCount: coalesce([test::gildedcove3::store::CoveKelpDb]kelp.kelp_plot.frond_count, 0),
    surveyedOn: [test::gildedcove3::store::CoveKelpDb]kelp.kelp_plot.surveyed_on,
    bedName: [test::gildedcove3::store::CoveKelpDb]@PlotToBed | kelp.kelp_bed.bed_name
  }

  *test::gildedcove3::domain::KelpBed[kelpBed]: Relational
  {
    ~primaryKey
    (
      [test::gildedcove3::store::CoveKelpDb]kelp.kelp_bed.bed_code
    )
    ~mainTable [test::gildedcove3::store::CoveKelpDb]kelp.kelp_bed
    bedCode: [test::gildedcove3::store::CoveKelpDb]kelp.kelp_bed.bed_code,
