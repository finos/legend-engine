###Connection
RelationalDatabaseConnection test::gildedcove3::connection::CoveKelpH2Connection
{
  store: test::gildedcove3::store::CoveKelpDb;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists kelp cascade;',
      'create schema kelp;',
      'create table kelp.kelp_plot(plot_id integer primary key, plot_code varchar(24) not null, bed_code varchar(24) not null, canopy_class varchar(24) not null, frond_count integer, surveyed_on date not null, from_z date not null, thru_z date not null);',
      'create table kelp.kelp_bed(bed_code varchar(24) primary key, bed_name varchar(80) not null);'
      ];
  };
  auth: DefaultH2;
}
