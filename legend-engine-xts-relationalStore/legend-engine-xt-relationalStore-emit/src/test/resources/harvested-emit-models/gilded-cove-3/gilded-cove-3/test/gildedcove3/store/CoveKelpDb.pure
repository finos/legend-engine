###Relational
Database test::gildedcove3::store::CoveKelpDb
(
  Schema kelp
  (
    Table kelp_plot
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      plot_id INTEGER PRIMARY KEY,
      plot_code VARCHAR(24) NOT NULL,
      bed_code VARCHAR(24) NOT NULL,
      canopy_class VARCHAR(24) NOT NULL,
      frond_count INTEGER,
      surveyed_on DATE NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
    Table kelp_bed
    (
      bed_code VARCHAR(24) PRIMARY KEY,
      bed_name VARCHAR(80) NOT NULL
    )
  )

  Join PlotToBed(kelp.kelp_plot.bed_code = kelp.kelp_bed.bed_code)
)
