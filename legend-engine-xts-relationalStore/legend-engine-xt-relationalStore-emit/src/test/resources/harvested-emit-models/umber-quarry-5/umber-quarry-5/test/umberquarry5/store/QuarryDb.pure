###Relational
Database test::umberquarry5::store::QuarryDb
(
  include test::umberquarry5::store::QuarryRefDb

  Schema pit
  (
    Table quarry_pit
    (
      pit_code VARCHAR(8) PRIMARY KEY,
      pit_name VARCHAR(40),
      district_code VARCHAR(8)
    )

    Table bench
    (
      pit_code VARCHAR(8) PRIMARY KEY,
      bench_no INTEGER PRIMARY KEY,
      face_code VARCHAR(8),
      level_text VARCHAR(4)
    )

    Table block
    (
      pit_code VARCHAR(8) PRIMARY KEY,
      bench_no INTEGER PRIMARY KEY,
      block_seq INTEGER PRIMARY KEY,
      block_ref VARCHAR(24),
      type_code VARCHAR(8),
      finish_code VARCHAR(8),
      grade_code VARCHAR(8),
      shape_code VARCHAR(12),
      saw_flag VARCHAR(1),
      part_count INTEGER,
      part_1 VARCHAR(12),
      part_2 VARCHAR(12),
      part_3 VARCHAR(12),
      part_4 VARCHAR(12),
      part_5 VARCHAR(12),
      part_6 VARCHAR(12),
      part_7 VARCHAR(12),
      part_8 VARCHAR(12),
      state_code VARCHAR(2)
    )
  )

  Schema yard
  (
    Table lot
    (
      lot_code VARCHAR(8) PRIMARY KEY,
      pit_code VARCHAR(8),
      bench_no INTEGER,
      block_seq INTEGER,
      lot_kind VARCHAR(8),
      yard_code VARCHAR(8)
    )

    Table offcut_lot
    (
      lot_code VARCHAR(8) PRIMARY KEY,
      pit_code VARCHAR(8),
      bench_no INTEGER,
      block_seq INTEGER,
      yard_code VARCHAR(8)
    )

    Table stack_tag
    (
      pit_code VARCHAR(8) PRIMARY KEY,
      bench_no INTEGER PRIMARY KEY,
      block_seq INTEGER PRIMARY KEY,
      tag_group INTEGER PRIMARY KEY,
      tag_slot INTEGER PRIMARY KEY,
      tag_value VARCHAR(16)
    )

    View block_tag_vw
    (
      ~groupBy
      (
        yard.stack_tag.pit_code,
        yard.stack_tag.bench_no,
        yard.stack_tag.block_seq
      )
      pit_code: yard.stack_tag.pit_code PRIMARY KEY,
      bench_no: yard.stack_tag.bench_no PRIMARY KEY,
      block_seq: yard.stack_tag.block_seq PRIMARY KEY,
      colour_tag: max(case(and(equal(yard.stack_tag.tag_group, 1), equal(yard.stack_tag.tag_slot, 1)), yard.stack_tag.tag_value, sqlNull())),
      grit_tag: max(case(and(equal(yard.stack_tag.tag_group, 2), equal(yard.stack_tag.tag_slot, 1)), yard.stack_tag.tag_value, sqlNull()))
    )
  )

  Join Block_Bench(pit.block.pit_code = pit.bench.pit_code and pit.block.bench_no = pit.bench.bench_no)
  Join Bench_Pit(pit.bench.pit_code = pit.quarry_pit.pit_code)
  Join Pit_District(pit.quarry_pit.district_code = ref.district.district_code)
  Join Block_StoneType(pit.block.type_code = ref.stone_type.type_code and (ref.stone_type.family_code = 'IGN' or ref.stone_type.family_code = 'SED' or ref.stone_type.family_code = 'MET'))
  Join Block_Finish(coalesce(pit.block.finish_code, 'RAW') = ref.finish_code.finish_code)
  Join Block_TagView(pit.block.pit_code = yard.block_tag_vw.pit_code and pit.block.bench_no = yard.block_tag_vw.bench_no and pit.block.block_seq = yard.block_tag_vw.block_seq)
  Join Lot_Block(yard.lot.pit_code = pit.block.pit_code and yard.lot.bench_no = pit.block.bench_no and yard.lot.block_seq = pit.block.block_seq and (yard.lot.lot_kind = 'SLAB' or yard.lot.lot_kind = 'TILE'))
  Join Offcut_Block(yard.offcut_lot.pit_code = pit.block.pit_code and yard.offcut_lot.bench_no = pit.block.bench_no and yard.offcut_lot.block_seq = pit.block.block_seq)

  Filter QuarriedBlocks(equal(pit.block.state_code, 'Q'))
  Filter ActiveYardLots(notEqual(yard.lot.yard_code, 'CLOSED'))
)
