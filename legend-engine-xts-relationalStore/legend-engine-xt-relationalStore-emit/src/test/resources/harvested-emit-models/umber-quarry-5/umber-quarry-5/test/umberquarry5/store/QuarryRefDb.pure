###Relational
Database test::umberquarry5::store::QuarryRefDb
(
  Schema ref
  (
    Table stone_type
    (
      type_code VARCHAR(8) PRIMARY KEY,
      type_name VARCHAR(40),
      family_code VARCHAR(8)
    )

    Table finish_code
    (
      finish_code VARCHAR(8) PRIMARY KEY,
      finish_label VARCHAR(40)
    )

    Table district
    (
      district_code VARCHAR(8) PRIMARY KEY,
      district_name VARCHAR(40),
      active_flag VARCHAR(1)
    )
  )

  Filter OpenDistrict(equal(ref.district.active_flag, 'Y'))
)
