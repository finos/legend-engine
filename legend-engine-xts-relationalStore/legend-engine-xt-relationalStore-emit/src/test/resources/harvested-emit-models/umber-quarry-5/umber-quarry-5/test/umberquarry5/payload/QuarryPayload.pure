###Pure
import test::umberquarry5::domain::*;

Class {meta::pure::profiles::doc.doc = 'A block tally sheet as keyed in at the pit edge, every code still free text.'} test::umberquarry5::payload::BlockTally
{
  tallyCode: String[1];
  gradeCode: String[0..1];
  shapeCode: String[0..1];
  familyCode: String[0..1];
  levelText: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A tally sheet with every code resolved to its enumeration.'} test::umberquarry5::payload::BlockTallyDigest
{
  tallyCode: String[1];
  grade: BlockGrade[1];
  shape: BlockShape[1];
  family: StoneFamily[1];
  level: BenchLevel[1];
}
