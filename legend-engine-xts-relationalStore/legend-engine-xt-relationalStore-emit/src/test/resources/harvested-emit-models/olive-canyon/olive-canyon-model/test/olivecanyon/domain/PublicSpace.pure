import test::olivecanyon::domain::*;

Class <<CivicProfile.abstractRoot>> {CivicProfile.notes = 'Root of the open-space lattice; subtypes add their own surface detail.'} test::olivecanyon::domain::PublicSpace
{
  spaceCode: String[1];
  name: String[1];
  areaHectares: Float[1];
  openedOn: StrictDate[1];
}

Class <<CivicProfile.publiclyAccessible>> {CivicProfile.stewardshipTier = 'district'} test::olivecanyon::domain::Park extends PublicSpace
{
  hasDrinkingWater: Boolean[1];
  canopyCoverPercent: Integer[1];
}

Class <<CivicProfile.seasonal>> {CivicProfile.surveyCadence = 'quarterly'} test::olivecanyon::domain::Playground extends Park
{
  minAge: Integer[1];
  maxAge: Integer[1];
  surfaceMaterial: String[1];
}

Class <<CivicProfile.publiclyAccessible>> test::olivecanyon::domain::GreenCorridor extends PublicSpace
{
  lengthKilometres: Float[1];
  shoreAdjacent: Boolean[1];
}
