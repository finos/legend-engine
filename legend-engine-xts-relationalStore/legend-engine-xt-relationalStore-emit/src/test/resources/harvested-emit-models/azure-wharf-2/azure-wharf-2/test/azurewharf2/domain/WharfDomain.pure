###Pure
Class {meta::pure::profiles::doc.doc = 'One dockside mooring inspection written up by the watch crew when a vessel is tied alongside a berth.'} test::azurewharf2::domain::MooringLog
{
  logCode: String[1];
  berthName: String[1];
  quayName: String[1];
  vesselName: String[1];
  crewName: String[1];
  hullLabel: String[0..1];
  deckLabel: String[1];
  lampLabel: String[1];
  crateCount: Integer[1];
  checkedOn: StrictDate[1];
}

Class {meta::pure::profiles::doc.doc = 'A numbered mooring position along a quay where one vessel may be tied at a time.'} test::azurewharf2::domain::Berth
{
  berthCode: String[1];
  berthName: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A stretch of dockside wall carrying several mooring berths.'} test::azurewharf2::domain::Quay
{
  quayCode: String[1];
  quayName: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A boat that ties up at the wharf and is inspected while alongside.'} test::azurewharf2::domain::Vessel
{
  vesselCode: String[1];
  vesselName: String[1];
}

Class {meta::pure::profiles::doc.doc = 'The rostered dockside watch that walks the berths and writes the mooring inspections up.'} test::azurewharf2::domain::WatchCrew
{
  crewCode: String[1];
  crewName: String[1];
}
