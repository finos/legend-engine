###Connection
RelationalDatabaseConnection test::russetwarren2::connection::BenchRegisterConnection
{
  store: test::russetwarren2::store::PropagationBenchStore;
  type: MemSQL;
  specification: Static
  {
    name: 'propagation_bench_register';
    host: 'example-propagation-bench-host';
    port: 3306;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'propagationbenchregisterprincipal';
  };
  postProcessors:
  [
    mapper
    {
      mappers:
      [
        schema {from: 'bench'; to: 'bench_current';},
        table {from: 'propagation_tray'; to: 'propagation_tray_current'; schemaFrom: 'bench'; schemaTo: 'bench_current';}
      ];
    }
  ];
}

###Connection
RelationalDatabaseConnection test::russetwarren2::connection::BenchArchiveConnection
{
  store: test::russetwarren2::store::PropagationBenchStore;
  type: MemSQL;
  specification: Static
  {
    name: 'propagation_bench_archive';
    host: 'example-propagation-bench-archive-host';
    port: 3306;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'propagationbencharchiveprincipal';
  };
  postProcessors:
  [
    mapper
    {
      mappers:
      [
        schema {from: 'bench'; to: 'bench_archive';}
      ];
    }
  ];
}

###Connection
JsonModelConnection test::russetwarren2::connection::TrayPayloadConnection
{
  class: test::russetwarren2::domain::TrayPayload;
  url: 'data:application/json,%7B%7D';
}
