###Runtime
Runtime test::russetwarren2::runtime::BenchRegisterRuntime
{
  mappings:
  [
    test::russetwarren2::mapping::PropagationBenchMapping
  ];
  connections:
  [
    test::russetwarren2::store::PropagationBenchStore:
    [
      benchRegisterConnection: test::russetwarren2::connection::BenchRegisterConnection
    ]
  ];
}

Runtime test::russetwarren2::runtime::BenchArchiveRuntime
{
  mappings:
  [
    test::russetwarren2::mapping::PropagationBenchMapping
  ];
  connections:
  [
    test::russetwarren2::store::PropagationBenchStore:
    [
      benchArchiveConnection: test::russetwarren2::connection::BenchArchiveConnection
    ]
  ];
}

Runtime test::russetwarren2::runtime::TrayDigestRuntime
{
  mappings:
  [
    test::russetwarren2::mapping::TrayDigestM2M
  ];
  connections:
  [
    ModelStore:
    [
      trayPayloadConnection: test::russetwarren2::connection::TrayPayloadConnection
    ]
  ];
}
