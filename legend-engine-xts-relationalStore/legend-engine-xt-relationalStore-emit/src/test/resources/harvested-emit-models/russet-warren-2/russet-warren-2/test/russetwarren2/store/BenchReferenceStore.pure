###Relational
Database test::russetwarren2::store::BenchReferenceStore
(
  Schema reference
  (
    Table bench_zone
    (
      zone_code VARCHAR(16) PRIMARY KEY,
      zone_name VARCHAR(64) NOT NULL,
      keeper_code VARCHAR(16) NOT NULL
    )

    Table zone_keeper
    (
      keeper_code VARCHAR(16) PRIMARY KEY,
      keeper_name VARCHAR(64) NOT NULL
    )
  )

  Join Zone_Keeper(reference.bench_zone.keeper_code = reference.zone_keeper.keeper_code)
)
