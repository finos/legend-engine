###Relational
Database test::russetwarren2::store::PropagationBenchStore
(
  include test::russetwarren2::store::BenchReferenceStore

  Schema bench
  (
    Table propagation_tray
    (
      tray_id INTEGER PRIMARY KEY,
      tray_label VARCHAR(64) NOT NULL,
      cell_count INTEGER NOT NULL,
      mist_seconds FLOAT NOT NULL,
      band_code VARCHAR(8),
      stage_code VARCHAR(16),
      kind_code VARCHAR(16) NOT NULL,
      zone_code VARCHAR(16) NOT NULL,
      note_text VARCHAR(128)
    )
  )

  Join Tray_Zone(bench.propagation_tray.zone_code = reference.bench_zone.zone_code)

  Filter MistedTrayFilter(bench.propagation_tray.mist_seconds > 0.0)
)
