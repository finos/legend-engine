###Runtime
Runtime test::borealridge4::runtime::LookoutNetworkRuntime
{
  mappings:
  [
    test::borealridge4::mapping::LookoutPostingMapping
  ];
  connections:
  [
    test::borealridge4::store::LookoutNetworkDb:
    [
      networkConnection:
      #{
        RelationalDatabaseConnection
        {
          store: test::borealridge4::store::LookoutNetworkDb;
          type: H2;
          timezone: +0000;
          specification: LocalH2
          {
            testDataSetupSqls: [];
          };
          auth: DefaultH2;
        }
      }#
    ]
  ];
}

