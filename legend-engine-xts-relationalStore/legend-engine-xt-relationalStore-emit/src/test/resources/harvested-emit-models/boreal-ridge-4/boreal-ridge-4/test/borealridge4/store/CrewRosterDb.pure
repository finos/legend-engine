###Relational
Database test::borealridge4::store::CrewRosterDb
(
  Schema crew
  (
    Table watch_crew
    (
      crew_code VARCHAR(12) PRIMARY KEY,
      crew_name VARCHAR(60),
      base_code VARCHAR(12),
      active_flag VARCHAR(1)
    )
    Table crew_posting
    (
      tower_code VARCHAR(12) PRIMARY KEY,
      shift_no INTEGER PRIMARY KEY,
      crew_code VARCHAR(12),
      posting_kind VARCHAR(8)
    )
  )

  Join PostingCrew(crew.crew_posting.crew_code = crew.watch_crew.crew_code and crew.watch_crew.active_flag = 'Y')
)
