###Mapping
Mapping test::emberaviary::mapping::AviaryEnumMappings
(
  test::emberaviary::domain::BoxCondition: EnumerationMapping ConditionMapping
  {
    SOUND: ['SOUND'],
    WEATHERED: ['WEATHERED'],
    DAMAGED: ['DAMAGED']
  }

  test::emberaviary::domain::RingMode: EnumerationMapping RingModeMapping
  {
    NEW_RING: ['NR'],
    RECAPTURE: ['RC'],
    NO_RING: ['NN']
  }

  test::emberaviary::domain::BroodStage: EnumerationMapping StageMapping
  {
    EGGS: ['E'],
    CHICKS: ['C'],
    FLEDGED: ['F'],
    EMPTY: ['X']
  }

  test::emberaviary::domain::ObserverRole: EnumerationMapping RoleMapping
  {
    WARDEN: ['WARDEN'],
    VOLUNTEER: ['VOLUNTEER'],
    TRAINEE: ['TRAINEE']
  }
)
