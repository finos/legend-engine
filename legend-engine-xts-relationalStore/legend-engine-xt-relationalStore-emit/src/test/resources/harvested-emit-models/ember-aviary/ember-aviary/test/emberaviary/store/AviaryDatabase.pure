###Relational
Database test::emberaviary::store::AviaryDB
(
  Schema reference
  (
    Table habitat
    (
      habitat_code VARCHAR(16) PRIMARY KEY,
      habitat_name VARCHAR(80) NOT NULL,
      warden_team_code VARCHAR(16) NOT NULL,
      canopy_code VARCHAR(16) NOT NULL
    )

    Table warden_team
    (
      warden_team_code VARCHAR(16) PRIMARY KEY,
      team_name VARCHAR(80) NOT NULL,
      region_name VARCHAR(80) NOT NULL
    )

    Table observer
    (
      observer_code VARCHAR(16) PRIMARY KEY,
      observer_name VARCHAR(80) NOT NULL,
      role_code VARCHAR(20) NOT NULL,
      retired_flag CHAR(1) NOT NULL
    )
  )

  Schema field
  (
    Table nest_box
    (
      box_code VARCHAR(16) PRIMARY KEY,
      box_name VARCHAR(80) NOT NULL,
      habitat_code VARCHAR(16) NOT NULL,
      mount_height_cm INTEGER NOT NULL,
      installed_on DATE NOT NULL,
      last_repaired_on DATE
    )

    Table box_visit
    (
      visit_code VARCHAR(24) PRIMARY KEY,
      box_code VARCHAR(16) NOT NULL,
      observer_code VARCHAR(16) NOT NULL,
      visited_on DATE NOT NULL,
      chick_count INTEGER NOT NULL,
      egg_count INTEGER NOT NULL,
      condition_code VARCHAR(16) NOT NULL,
      ring_mode_code VARCHAR(8) NOT NULL,
      visit_note VARCHAR(120)
    )

    View box_visit_view
    (
      ~groupBy
      (
        field.box_visit.box_code
      )
      box_code: field.box_visit.box_code PRIMARY KEY,
      visit_count: count(field.box_visit.visit_code),
      total_chicks: sum(field.box_visit.chick_count),
      most_eggs: max(field.box_visit.egg_count)
    )

    View habitat_box_view
    (
      ~groupBy
      (
        field.nest_box.habitat_code
      )
      habitat_code: field.nest_box.habitat_code PRIMARY KEY,
      box_count: count(field.nest_box.box_code),
      tallest_mount_cm: max(field.nest_box.mount_height_cm)
    )
  )

  Filter ActiveObserver(reference.observer.retired_flag = 'N')

  Join Box_Habitat(field.nest_box.habitat_code = reference.habitat.habitat_code)
  Join Habitat_Team(reference.habitat.warden_team_code = reference.warden_team.warden_team_code)
  Join Visit_Box(field.box_visit.box_code = field.nest_box.box_code)
  Join Visit_Observer(field.box_visit.observer_code = reference.observer.observer_code)
  Join Box_VisitSummary(field.nest_box.box_code = field.box_visit_view.box_code)
  Join Habitat_BoxSummary(reference.habitat.habitat_code = field.habitat_box_view.habitat_code)
)
