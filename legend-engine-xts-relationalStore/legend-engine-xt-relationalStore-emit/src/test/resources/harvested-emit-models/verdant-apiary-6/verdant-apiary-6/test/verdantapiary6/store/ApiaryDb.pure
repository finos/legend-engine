###Relational
Database test::verdantapiary6::store::ApiaryDb
(
  Schema apiary
  (
    Table hive_colony
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      colony_id INTEGER PRIMARY KEY,
      colony_code VARCHAR(20) NOT NULL,
      apiary_name VARCHAR(60) NOT NULL,
      frame_count INTEGER NOT NULL,
      queen_line VARCHAR(20) NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
  )
)
