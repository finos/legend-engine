    apiaryName: [test::verdantapiary6::store::ApiaryDb]apiary.hive_colony.apiary_name,
    frameCount: [test::verdantapiary6::store::ApiaryDb]apiary.hive_colony.frame_count,
    queenLine: [test::verdantapiary6::store::ApiaryDb]apiary.hive_colony.queen_line
  }
)
