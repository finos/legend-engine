###Relational
Database test::goldenglacier5::store::MoraineDatabase
(
  Schema moraine
  (
    Table moraine_station
    (
      station_code VARCHAR(24) PRIMARY KEY,
      ridge_name VARCHAR(120) NOT NULL,
      stage_code VARCHAR(8) NOT NULL,
      instrument_code VARCHAR(8) NOT NULL,
      elevation_m DOUBLE NOT NULL,
      observed_on DATE NOT NULL,
      logged_at TIMESTAMP NOT NULL,
      basin_code VARCHAR(16) NOT NULL
    )

    Table drainage_basin
    (
      basin_code VARCHAR(16) PRIMARY KEY,
      basin_name VARCHAR(120) NOT NULL,
      catchment_area_km2 DOUBLE NOT NULL
    )
  )

  Join Station_Basin(moraine.moraine_station.basin_code = moraine.drainage_basin.basin_code)
)
