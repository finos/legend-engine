###Pure
import test::goldenglacier5::domain::*;

Enum test::goldenglacier5::domain::MoraineStage
{
  ACTIVE,
  STABILISED,
  RELICT
}

Enum test::goldenglacier5::domain::SurveyInstrument
{
  STAKE_ARRAY,
  LASER_SCAN,
  DRONE_PHOTO
}

Class test::goldenglacier5::domain::MoraineStation
{
  stationCode: String[1];
  ridgeName: String[1];
  moraineStage: MoraineStage[0..1];
  surveyInstrument: SurveyInstrument[1];
  elevationM: Float[1];
  observedOn: StrictDate[1];
  loggedAt: DateTime[1];
  basinName: String[0..1];
}

Class test::goldenglacier5::domain::DrainageBasin
{
  basinCode: String[1];
  basinName: String[1];
  catchmentAreaKm2: Float[1];
}
