###Relational
Database test::emeraldapiary::store::GraftDatabase
(
  Schema nursery
  (
    Table rootstock
    (
      rootstock_code VARCHAR(30) PRIMARY KEY,
      lot_year INTEGER PRIMARY KEY,
      vigour_grade VARCHAR(20),
      chill_hours INTEGER
    )
    Table scion
    (
      scion_code VARCHAR(30) PRIMARY KEY,
      collected_on DATE PRIMARY KEY,
      cultivar VARCHAR(60)
    )
  )

  Schema orchard
  (
    Table graft_block
    (
      block_code VARCHAR(30) PRIMARY KEY,
      planted_on DATE PRIMARY KEY,
      rootstock_code VARCHAR(30),
      scion_code VARCHAR(30)
    )
    Table block_survey
    (
      survey_id INTEGER PRIMARY KEY,
      block_code VARCHAR(30),
      surveyed_at TIMESTAMP,
      canopy_spread_m FLOAT
    )
  )

  Join Block_Rootstock(orchard.graft_block.rootstock_code = nursery.rootstock.rootstock_code)
  Join Block_Scion(orchard.graft_block.scion_code = nursery.scion.scion_code)
)
