###Relational
Database test::lunarridge5::store::TrailDb
(
  Schema registry
  (
    Table trail_region
    (
      region_code VARCHAR(16) PRIMARY KEY,
      region_name VARCHAR(80) NOT NULL
    )
    Table trail_head
    (
      head_code VARCHAR(16) PRIMARY KEY,
      head_name VARCHAR(80) NOT NULL,
      region_code VARCHAR(16) NOT NULL
    )
  )

  Schema field
  (
    Table trail_segment
    (
      segment_code VARCHAR(16) PRIMARY KEY,
      segment_name VARCHAR(80) NOT NULL,
      head_code VARCHAR(16) NOT NULL,
      surface_code VARCHAR(8) NOT NULL,
      survey_state VARCHAR(16) NOT NULL,
      crew_note VARCHAR(80) NOT NULL,
      length_metres FLOAT NOT NULL,
      ascent_metres FLOAT NOT NULL
    )
    Table maintenance_visit
    (
      visit_code VARCHAR(16) PRIMARY KEY,
      segment_code VARCHAR(16) NOT NULL,
      visit_on DATE NOT NULL,
      hours_logged FLOAT NOT NULL
    )
  )

  Filter ActiveSurvey(field.trail_segment.survey_state = 'ACTIVE')

  Join Segment_Head(field.trail_segment.head_code = registry.trail_head.head_code)
  Join Head_Region(registry.trail_head.region_code = registry.trail_region.region_code)
  Join Visit_Segment(field.maintenance_visit.segment_code = field.trail_segment.segment_code)
)
