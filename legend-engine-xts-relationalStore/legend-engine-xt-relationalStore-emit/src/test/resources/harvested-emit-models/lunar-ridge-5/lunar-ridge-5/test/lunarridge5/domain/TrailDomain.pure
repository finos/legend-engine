###Pure
import test::lunarridge5::domain::*;

Enum test::lunarridge5::domain::SurfaceType
{
  GRAVEL,
  BOARDWALK,
  SCREE,
  TURF
}

Enum test::lunarridge5::domain::SegmentTier
{
  PRIORITY,
  ROUTINE,
  DEFERRED,
  UNRATED
}

Class test::lunarridge5::domain::TrailRegion
{
  regionCode: String[1];
  regionName: String[1];
}

Class test::lunarridge5::domain::TrailHead
{
  headCode: String[1];
  headName: String[1];
  regionName: String[1];
}

Class test::lunarridge5::domain::TrailSegment
{
  segmentCode: String[1];
  segmentName: String[1];
  surface: SurfaceType[1];
  lengthMetres: Float[1];
  ascentMetres: Float[1];
  gradePercent: Float[1];
  conditionBand: String[0..1];
  crewLabel: String[0..1];
  headName: String[1];
  regionName: String[1];
}

Class test::lunarridge5::domain::SurveyedSegment extends TrailSegment
{
  surveyState: String[1];
}

Class test::lunarridge5::domain::MaintenanceVisit
{
  visitCode: String[1];
  visitOn: StrictDate[1];
  hoursLogged: Float[1];
  segmentName: String[1];
  headName: String[1];
  regionName: String[1];
}

Class test::lunarridge5::domain::SegmentNote
{
  noteRef: String[1];
  surfaceText: String[0..1];
  ascentText: String[0..1];
  lengthText: String[0..1];
}

Class test::lunarridge5::domain::SegmentDigest
{
  digestKey: String[1];
  digestBand: String[1];
  surface: SurfaceType[1];
  tier: SegmentTier[1];
  effortIndex: Float[1];
}
