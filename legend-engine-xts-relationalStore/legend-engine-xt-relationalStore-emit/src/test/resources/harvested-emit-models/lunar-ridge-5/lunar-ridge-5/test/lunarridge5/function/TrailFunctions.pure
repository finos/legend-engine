###Pure
function test::lunarridge5::function::visitWindowFloor(asOf: StrictDate[1], windowDays: Integer[1]): StrictDate[1]
{
  $asOf->adjust(-$windowDays, meta::pure::functions::date::DurationUnit.DAYS)->cast(@StrictDate)
}

function test::lunarridge5::function::gradeLabel(gradePercent: Float[1]): String[1]
{
  if($gradePercent >= 30.0, |'HAUL', |if($gradePercent >= 12.0, |'CLIMB', |'STROLL'))
}

function test::lunarridge5::function::effortHours(lengthMetres: Float[1], ascentMetres: Float[1]): Float[1]
{
  ($lengthMetres / 1000.0) + ($ascentMetres / 100.0)
}

function test::lunarridge5::function::crewTag(crewLabel: String[0..1]): String[1]
{
  if($crewLabel->isEmpty(),
     |'UNASSIGNED',
     |if($crewLabel->toOne()->length() > 14, |'LONG-CREW-TAG', |'SHORT-CREW-TAG'))
}
