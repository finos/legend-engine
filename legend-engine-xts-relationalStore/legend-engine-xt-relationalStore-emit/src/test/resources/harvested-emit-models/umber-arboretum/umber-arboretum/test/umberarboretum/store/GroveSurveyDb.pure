###Relational
Database test::umberarboretum::store::GroveSurveyDb
(
  include test::umberarboretum::store::GroveTaxonomyDb

  Schema svy
  (
    Table custodian_team
    (
      team_id INTEGER PRIMARY KEY,
      team_code VARCHAR(20),
      ward_id INTEGER
    )

    Table ward
    (
      ward_id INTEGER PRIMARY KEY,
      ward_name VARCHAR(40),
      region_id INTEGER
    )

    Table region
    (
      region_id INTEGER PRIMARY KEY,
      region_name VARCHAR(40),
      programme_id INTEGER
    )

    Table stewardship_programme
    (
      programme_id INTEGER PRIMARY KEY,
      programme_name VARCHAR(60)
    )
  )

  Join Grove_Team(arb.grove.team_id = svy.custodian_team.team_id)
  Join Team_Ward(svy.custodian_team.ward_id = svy.ward.ward_id)
  Join Ward_Region(svy.ward.region_id = svy.region.region_id)
  Join Region_Programme(svy.region.programme_id = svy.stewardship_programme.programme_id)
)
