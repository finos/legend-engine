###Relational
Database test::umberarboretum::store::GroveTaxonomyDb
(
  include test::umberarboretum::store::GroveCoreDb

  Schema tax
  (
    Table taxon
    (
      taxon_id INTEGER PRIMARY KEY,
      taxon_name VARCHAR(60),
      family_id INTEGER
    )

    Table taxon_family
    (
      family_id INTEGER PRIMARY KEY,
      family_name VARCHAR(60),
      clade_id INTEGER
    )

    Table taxon_clade
    (
      clade_id INTEGER PRIMARY KEY,
      clade_name VARCHAR(60)
    )
  )

  Join Specimen_Taxon(arb.specimen.taxon_id = tax.taxon.taxon_id)
  Join Taxon_Family(tax.taxon.family_id = tax.taxon_family.family_id)
  Join Family_Clade(tax.taxon_family.clade_id = tax.taxon_clade.clade_id)
)
