###Relational
Database test::umberarboretum::store::GroveCoreDb
(
  Schema arb
  (
    Table grove
    (
      grove_id INTEGER PRIMARY KEY,
      grove_code VARCHAR(20) NOT NULL,
      grove_name VARCHAR(60),
      team_id INTEGER
    )

    Table specimen
    (
      specimen_id INTEGER PRIMARY KEY,
      label VARCHAR(40),
      grove_id INTEGER,
      taxon_id INTEGER,
      health_code VARCHAR(4),
      canopy_pct INTEGER,
      status_code VARCHAR(12),
      surveyed_at TIMESTAMP
    )

    Table care_visit
    (
      visit_id INTEGER PRIMARY KEY,
      specimen_id INTEGER,
      visit_code VARCHAR(20),
      outcome_code VARCHAR(12),
      crew_code VARCHAR(12)
    )

    View specimen_health_vw
    (
      specimen_id: specimen.specimen_id PRIMARY KEY,
      health_code: specimen.health_code,
      canopy_band: case(greaterThan(specimen.canopy_pct, 60), 'broad', 'narrow')
    )
  )

  Join Specimen_Grove(arb.specimen.grove_id = arb.grove.grove_id)
  Join Visit_Specimen(arb.care_visit.specimen_id = arb.specimen.specimen_id)
  Join Specimen_Health(arb.specimen.specimen_id = arb.specimen_health_vw.specimen_id)
)
