###Connection
RelationalDatabaseConnection test::frostedorchard6::connection::OrchardH2Connection
{
  store: test::frostedorchard6::store::OrchardDb;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists orchard cascade;',
      'create schema orchard;',
      'create table orchard.tree_row(row_id integer primary key, row_code varchar(24) not null, variety_name varchar(60) not null, rootstock_code varchar(24) not null, graft_year integer not null, health_class varchar(24) not null, tree_count integer not null);'
      ];
  };
  auth: DefaultH2;
}
