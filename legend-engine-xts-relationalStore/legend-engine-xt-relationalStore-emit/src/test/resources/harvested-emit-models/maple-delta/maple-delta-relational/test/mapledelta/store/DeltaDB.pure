###Relational
Database test::mapledelta::store::DeltaDB
(
  Schema delta
  (
    Table channel
    (
      channel_id INTEGER PRIMARY KEY,
      channel_name VARCHAR(200) NOT NULL,
      basin_code VARCHAR(50) NOT NULL,
      channel_state VARCHAR(20) NOT NULL,
      flow_rate INTEGER NOT NULL,
      sediment_load INTEGER NOT NULL
    )
  )
)
