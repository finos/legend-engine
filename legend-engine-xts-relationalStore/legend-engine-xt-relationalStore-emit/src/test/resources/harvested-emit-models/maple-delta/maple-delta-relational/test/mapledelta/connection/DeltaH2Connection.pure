###Connection
RelationalDatabaseConnection test::mapledelta::connection::DeltaH2Connection
{
  store: test::mapledelta::store::DeltaDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists delta;',
      'create schema delta;',
      'create table delta.channel (channel_id integer primary key, channel_name varchar(200) not null, basin_code varchar(50) not null, channel_state varchar(20) not null, flow_rate integer not null, sediment_load integer not null);',
      'insert into delta.channel values (1, \'Main Stem\', \'NorthReach\', \'OPEN\', 120, 40);',
      'insert into delta.channel values (2, \'Side Cut\', \'NorthReach\', \'ACTIVE\', 80, 60);',
      'insert into delta.channel values (3, \'Dry Wash\', \'NorthReach\', \'CLOSED\', 0, 10);',
      'insert into delta.channel values (4, \'Far Bend\', \'SouthReach\', \'OPEN\', 200, 90);'
      ];
  };
  auth: DefaultH2;
}
