###Relational
Database test::jadevineyard::store::VineyardDatabase
(
  Schema vineyard
  (
    Table irrigation_run
    (
      run_id INTEGER PRIMARY KEY,
      run_code VARCHAR(24) NOT NULL,
      run_date DATE NOT NULL,
      block_id INTEGER NOT NULL,
      trellis_grade INTEGER NOT NULL,
      moisture_flag INTEGER,
      status_code INTEGER NOT NULL
    )
    Table vine_block
    (
      block_id INTEGER PRIMARY KEY,
      block_code VARCHAR(24) NOT NULL,
      parcel_id INTEGER NOT NULL
    )
    Table estate_parcel
    (
      parcel_id INTEGER PRIMARY KEY,
      parcel_code VARCHAR(24) NOT NULL,
      district_id INTEGER NOT NULL
    )
    Table vineyard_district
    (
      district_id INTEGER PRIMARY KEY,
      district_code VARCHAR(24) NOT NULL,
      climate_id INTEGER NOT NULL
    )
    Table climate_zone
    (
      climate_id INTEGER PRIMARY KEY,
      climate_name VARCHAR(80) NOT NULL
    )
  )

  Join Run_Block(vineyard.irrigation_run.block_id = vineyard.vine_block.block_id)
  Join Block_Parcel(vineyard.vine_block.parcel_id = vineyard.estate_parcel.parcel_id)
  Join Parcel_District(vineyard.estate_parcel.district_id = vineyard.vineyard_district.district_id)
  Join District_Climate(vineyard.vineyard_district.climate_id = vineyard.climate_zone.climate_id)
)
