###Relational
Database test::quietridge2::store::RidgeMastDb
(
  Schema ridge
  (
    Table mast_artifact
    (
      artifact_id INTEGER PRIMARY KEY,
      artifact_code VARCHAR(16),
      ridge_name VARCHAR(128),
      artifact_kind VARCHAR(16),
      dish_diameter_cm INTEGER,
      retired_flag VARCHAR(1)
    )
    Table mast_check
    (
      check_id INTEGER PRIMARY KEY,
      artifact_id INTEGER,
      check_code VARCHAR(16),
      check_grade VARCHAR(8)
    )
  )
  Join Artifact_Check(ridge.mast_artifact.artifact_id = ridge.mast_check.artifact_id)
  Filter ActiveMast(ridge.mast_artifact.retired_flag = 'N')
  Filter DishMastOnly(ridge.mast_artifact.artifact_kind = 'dish')
)
