###Pure
import test::quietridge2::domain::*;

Class test::quietridge2::domain::RidgeArtifact
{
  artifactCode: String[1];
  ridgeName: String[1];
  artifactKind: String[1];
}

Class test::quietridge2::domain::DishMast extends RidgeArtifact
{
  dishDiameterCm: Integer[1];
}

Class test::quietridge2::domain::MastCheck
{
  checkCode: String[1];
  checkGrade: String[1];
}

Association test::quietridge2::domain::Artifact_Check
{
  checkedArtifact: RidgeArtifact[0..1];
  checks: MastCheck[*];
}
