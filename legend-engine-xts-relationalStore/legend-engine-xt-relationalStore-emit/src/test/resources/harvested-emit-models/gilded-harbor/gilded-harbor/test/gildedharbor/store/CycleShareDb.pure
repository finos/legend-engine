###Relational
Database test::gildedharbor::store::CycleShareDb
(
  Schema network
  (
    Table dock_station
    (
      station_id INTEGER PRIMARY KEY,
      station_code VARCHAR(16),
      station_name VARCHAR(128),
      zone_code VARCHAR(16),
      status_code VARCHAR(8),
      dock_count INTEGER
    )
    Table service_zone
    (
      zone_code VARCHAR(16) PRIMARY KEY,
      zone_name VARCHAR(128),
      borough_name VARCHAR(128)
    )

    View zone_capacity_vw
    (
      ~groupBy (network.dock_station.zone_code)
      zone_code: network.dock_station.zone_code PRIMARY KEY,
      station_count: count(network.dock_station.station_id),
      max_dock_count: max(network.dock_station.dock_count)
    )
  )

  Schema fleet
  (
    Table cycle_unit
    (
      unit_id INTEGER PRIMARY KEY,
      unit_code VARCHAR(16),
      station_code VARCHAR(16),
      model_id INTEGER,
      retired_flag VARCHAR(1),
      wheel_size_mm INTEGER,
      ride_count INTEGER,
      condition_note VARCHAR(256)
    )
    Table cycle_model
    (
      model_id INTEGER PRIMARY KEY,
      model_code VARCHAR(16),
      frame_type VARCHAR(32),
      assist_flag VARCHAR(1)
    )
    Table service_visit
    (
      visit_id INTEGER PRIMARY KEY,
      unit_code VARCHAR(16),
      visit_kind VARCHAR(16),
      duration_min INTEGER
    )

    View model_label_vw
    (
      model_id: fleet.cycle_model.model_id PRIMARY KEY,
      model_code: fleet.cycle_model.model_code,
      model_label: concat('MODEL-', fleet.cycle_model.model_code)
    )
  )

  Filter OpenStation(network.dock_station.status_code != 'X')
  Filter RoadworthyUnit(fleet.cycle_unit.retired_flag != 'Y')

  Join Unit_Station(fleet.cycle_unit.station_code = network.dock_station.station_code)
  Join Station_Zone(network.dock_station.zone_code = network.service_zone.zone_code)
  Join Zone_Capacity(network.service_zone.zone_code = network.zone_capacity_vw.zone_code)
  Join Unit_Model(fleet.cycle_unit.model_id = fleet.cycle_model.model_id)
  Join Model_Label(fleet.cycle_model.model_id = fleet.model_label_vw.model_id)
)
