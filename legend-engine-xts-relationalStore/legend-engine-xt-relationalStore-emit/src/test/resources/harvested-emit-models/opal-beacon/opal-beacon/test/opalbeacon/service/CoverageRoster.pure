###Service
Service test::opalbeacon::service::CoverageRoster
{
  pattern: '/opalbeacon/v1/coverage-roster/{env}';
  title: 'Opal Beacon - Coverage Roster Keyed By Environment';
  owners:
  [
    'sky-survey',
    'station-coverage'
  ];
  documentation: 'Resolves the beacon star catalogue at one business and one processing instant and lists the observing stations reached across the four-hop coverage path. The environment key selects a whole execution stack, and two of the three keys resolve to the same runtime.';
  autoActivateUpdates: true;
  execution: Multi
  {
    query: {asOf: StrictDate[1]|test::opalbeacon::domain::BeaconStar.all($asOf, $asOf)->filter(
      s|$s.bandCode == 'RADIO'
    )->project(
      [
        s|$s.starCode,
        s|$s.sectorName,
        s|$s.stationName
      ],
      [
        'Star',
        'Sector',
        'Station'
      ]
    )->distinct()->sort(
      [
        asc('Star'),
        asc('Station')
      ]
    )};
    key: 'env';
    executions['survey']:
    {
      mapping: test::opalbeacon::mapping::SkyMapping;
      runtime: test::opalbeacon::runtime::SkySurveyRuntime;
    }
    executions['archive']:
    {
      mapping: test::opalbeacon::mapping::SkyMapping;
      runtime: test::opalbeacon::runtime::SkyArchiveRuntime;
    }
    executions['mirror']:
    {
      mapping: test::opalbeacon::mapping::SkyMapping;
      runtime: test::opalbeacon::runtime::SkySurveyRuntime;
    }
  }
}

###Service
Service test::opalbeacon::service::CoverageRosterSurvey
{
  pattern: '/opalbeacon/v1/coverage-roster-survey';
  title: 'Opal Beacon - Coverage Roster (Survey)';
  owners:
  [
    'sky-survey',
    'station-coverage'
  ];
  documentation: 'Survey-pinned counterpart of the environment-keyed roster: the same point-in-time star extent and four-hop coverage projection planned against a single execution stack, asserting the fan-out, the closed-link miss and the business-window exclusion.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {asOf: StrictDate[1]|test::opalbeacon::domain::BeaconStar.all($asOf, $asOf)->filter(
      s|$s.bandCode == 'RADIO'
    )->project(
      [
        s|$s.starCode,
        s|$s.sectorName,
        s|$s.stationName
      ],
      [
        'Star',
        'Sector',
        'Station'
      ]
    )->distinct()->sort(
      [
        asc('Star'),
        asc('Station')
      ]
    )};
    mapping: test::opalbeacon::mapping::SkyMapping;
    runtime: test::opalbeacon::runtime::SkySurveyRuntime;
  }
  testSuites:
  [
    coverageRosterSuite:
    {
      data:
      [
        connections:
        [
          skyConnection:
            Relational
            #{
              OPS.STATION:
                'station_code,station_name,dome_kind\n'+
                'ST-1,Ridge Observatory,SLIDING\n'+
                'ST-2,Plateau Observatory,ROLLOFF\n'+
                'ST-3,Basin Observatory,CLAMSHELL\n';
              OPS.OBSERVING_TEAM:
                'team_code,team_name,station_code,valid_from,valid_thru\n'+
                'TM-1,Night Watch,ST-1,2020-01-01,9999-12-31\n'+
                'TM-2,Dawn Watch,ST-2,2020-01-01,9999-12-31\n'+
                'TM-3,Retired Watch,ST-3,2020-01-01,9999-12-31\n';
              OPS.SECTOR_TEAM:
                'sector_code,team_code,valid_from,valid_thru\n'+
                'SC-1,TM-1,2020-01-01,9999-12-31\n'+
                'SC-1,TM-2,2020-01-01,9999-12-31\n'+
                'SC-2,TM-1,2020-01-01,9999-12-31\n'+
                'SC-3,TM-3,2020-01-01,2021-01-01\n';
              SKY.SKY_SECTOR:
                'sector_code,sector_name\n'+
                'SC-1,Northern Fan\n'+
                'SC-2,Southern Fan\n'+
                'SC-3,Zenith Fan\n';
              SKY.SURVEY_RUN:
                'run_code,run_name,sector_code\n'+
                'RN-1,Spring Sweep,SC-2\n';
              SKY.BEACON_STAR:
                'star_code,star_name,magnitude,band_code,sector_code,bus_from,bus_thru,proc_in,proc_out\n'+
                'BS-1,Opal Alpha,3,radio,SC-1,2026-01-01,9999-12-31,2026-01-01,9999-12-31\n'+
                'BS-2,Opal Beta,5,optical,SC-2,2026-01-01,9999-12-31,2026-01-01,9999-12-31\n'+
                'BS-3,Opal Gamma,7,radio,SC-3,2026-01-01,9999-12-31,2026-01-01,9999-12-31\n'+
                'BS-4,Opal Delta,9,radio,SC-1,2020-01-01,2021-01-01,2026-01-01,9999-12-31\n';
            }#
        ]
      ]
      tests:
      [
        pinnedInstantCoverage:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            asOf = %2026-06-01
          ]
          asserts:
          [
            fanOutMissAndOutOfRange:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Star":"BS-1","Sector":"Northern Fan","Station":"Plateau Observatory"},{"Star":"BS-1","Sector":"Northern Fan","Station":"Ridge Observatory"},{"Star":"BS-3","Sector":"Zenith Fan","Station":null}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
