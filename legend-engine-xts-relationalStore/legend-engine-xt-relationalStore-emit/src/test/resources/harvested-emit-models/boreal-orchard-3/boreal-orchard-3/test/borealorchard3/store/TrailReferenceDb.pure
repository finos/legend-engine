###Relational
Database test::borealorchard3::store::TrailReferenceDb
(
  Schema reference
  (
    Table region_block
    (
      region_code VARCHAR(24) PRIMARY KEY,
      region_name VARCHAR(96) NOT NULL,
      upland_flag BIT NOT NULL
    )

    Table surface_reference
    (
      surface_grade_code VARCHAR(16) PRIMARY KEY,
      grade_label VARCHAR(48) NOT NULL,
      walking_speed_kph DOUBLE NOT NULL
    )
  )
)
