###Relational
Database test::indigogecko::store::GeckoDb
(
  Schema vivarium_core
  (
    Table gecko_log
    (
      gecko_id INTEGER PRIMARY KEY,
      gecko_code VARCHAR(24) NOT NULL,
      clutch_code VARCHAR(16) NOT NULL,
      habitat_code VARCHAR(16),
      keeper_code VARCHAR(16),
      health_flag INTEGER,
      temp_grade INTEGER,
      feed_code VARCHAR(8),
      moult_code VARCHAR(8),
      length_mm INTEGER,
      girth_mm INTEGER,
      weight_g FLOAT,
      hatched_on DATE,
      last_weighed TIMESTAMP
    )

    View habitat_tally_view
    (
      ~groupBy
      (
        vivarium_core.gecko_log.habitat_code
      )
      habitat_code: vivarium_core.gecko_log.habitat_code PRIMARY KEY,
      gecko_count: count(vivarium_core.gecko_log.gecko_code),
      total_weight_g: sum(vivarium_core.gecko_log.weight_g)
    )
  )

  Schema vivarium_reference
  (
    Table habitat
    (
      habitat_code VARCHAR(16) PRIMARY KEY,
      habitat_name VARCHAR(96) NOT NULL,
      zone_code VARCHAR(16) NOT NULL,
      active_flag CHAR(1) NOT NULL
    )

    Table keeper_log
    (
      keeper_code VARCHAR(16) PRIMARY KEY,
      keeper_name VARCHAR(96) NOT NULL,
      shift_code VARCHAR(8) NOT NULL
    )
  )

  Filter ActiveHabitatFilter(vivarium_reference.habitat.active_flag = 'Y')

  Join Gecko_Habitat(vivarium_core.gecko_log.habitat_code = vivarium_reference.habitat.habitat_code)
  Join Gecko_Keeper(vivarium_core.gecko_log.keeper_code = vivarium_reference.keeper_log.keeper_code and vivarium_reference.keeper_log.shift_code = 'DAY')
  Join Habitat_Tally(vivarium_reference.habitat.habitat_code = vivarium_core.habitat_tally_view.habitat_code)
)
