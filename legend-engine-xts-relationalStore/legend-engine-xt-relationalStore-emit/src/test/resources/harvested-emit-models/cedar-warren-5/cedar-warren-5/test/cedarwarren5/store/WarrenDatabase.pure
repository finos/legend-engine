###Relational
Database test::cedarwarren5::store::WarrenDatabase
(
  Schema warren
  (
    Table burrow_survey
    (
      survey_id INTEGER PRIMARY KEY,
      burrow_code VARCHAR(20) NOT NULL,
      warren_name VARCHAR(60) NOT NULL,
      entrance_count INTEGER NOT NULL,
      occupied_flag INTEGER NOT NULL,
      flooded_flag INTEGER NOT NULL,
      lined_flag INTEGER NOT NULL,
      collapsed_flag INTEGER NOT NULL,
      vegetated_flag INTEGER NOT NULL,
      browsed_flag INTEGER NOT NULL,
      gated_flag INTEGER NOT NULL,
      ringed_flag INTEGER NOT NULL
    )
  )
)
