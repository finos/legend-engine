###Mapping
Mapping test::cedarwarren5::mapping::WarrenDigestMapping
(
  *test::cedarwarren5::domain::BurrowDigest[burrowDigestSet]: Pure
  {
    ~src test::cedarwarren5::domain::BurrowSurvey
    digestCode: $src.burrowCode,
    digestWarren: $src.warrenName,
    digestGrade: $src.conditionGrade,
    entranceCount: $src.entranceCount
  }

  testSuites:
  [
    burrowDigestSuite:
    {
      function: |test::cedarwarren5::domain::BurrowDigest.all()->graphFetch(
        #{
          test::cedarwarren5::domain::BurrowDigest{
            digestCode,
            digestWarren,
            digestGrade,
            entranceCount
          }
        }#
      )->serialize(
        #{
          test::cedarwarren5::domain::BurrowDigest{
            digestCode,
            digestWarren,
            digestGrade,
            entranceCount
          }
        }#
      );
      tests:
      [
        gradedAndUngradedBurrowsBothDigest:
        {
          doc: 'Two surveyed burrows are supplied as source instances, one carrying a resolved condition grade and one whose grade is absent because every observation flag was clear, so the digest is shown to carry the optional grade through unchanged instead of defaulting it.';
          data:
          [
            ModelStore:
              ModelStore
              #{
                test::cedarwarren5::domain::BurrowSurvey:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"burrowCode":"BW-0001","warrenName":"Cedar Hollow Warren","entranceCount":3,"conditionGrade":"COLLAPSED","accessNote":"DO NOT ENTER","surveyRegister":"CEDAR WARREN REGISTER"},{"burrowCode":"BW-0009","warrenName":"Stone Ride Warren","entranceCount":2,"surveyRegister":"CEDAR WARREN REGISTER"}]';
                  }#
              }#
          ];
          asserts:
          [
            bothBurrowsDigested:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"digestCode":"BW-0001","digestWarren":"Cedar Hollow Warren","digestGrade":"COLLAPSED","entranceCount":3},{"digestCode":"BW-0009","digestWarren":"Stone Ride Warren","digestGrade":null,"entranceCount":2}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
