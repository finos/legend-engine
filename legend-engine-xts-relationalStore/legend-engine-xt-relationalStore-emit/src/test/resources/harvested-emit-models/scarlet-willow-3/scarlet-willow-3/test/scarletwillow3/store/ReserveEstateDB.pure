###Relational
Database test::scarletwillow3::store::ReserveEstateDB
(
  include test::scarletwillow3::store::ReserveWarehouseDB

  View region_team_view
  (
    ~groupBy
    (
      survey_core.observer_team.region_code
    )
    region_code: survey_core.observer_team.region_code PRIMARY KEY,
    team_count: count(survey_core.observer_team.team_code)
  )

  Join Region_Teams(reserve_core.region.region_code = region_team_view.region_code)
)
