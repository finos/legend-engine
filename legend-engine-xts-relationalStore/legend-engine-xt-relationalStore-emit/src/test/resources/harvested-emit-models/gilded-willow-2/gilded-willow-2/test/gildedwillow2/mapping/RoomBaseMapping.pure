###Mapping
Mapping test::gildedwillow2::mapping::RoomBaseMapping
(
  *test::gildedwillow2::domain::RehearsalRoom[room]: Relational
  {
    ~primaryKey
    (
      [test::gildedwillow2::store::LendingDb]lending.rehearsal_room.room_id
    )
    ~mainTable [test::gildedwillow2::store::LendingDb]lending.rehearsal_room
    roomCode: [test::gildedwillow2::store::LendingDb]lending.rehearsal_room.room_code,
    roomName: substring([test::gildedwillow2::store::LendingDb]lending.rehearsal_room.room_name, 0, 60),
    wingName: [test::gildedwillow2::store::LendingDb]lending.rehearsal_room.wing_name,
    wingLabel: case(
                 equal(toUpper([test::gildedwillow2::store::LendingDb]lending.rehearsal_room.wing_name), 'NORTH WING'),
                 'WING-N',
                 case(
                   equal(toUpper([test::gildedwillow2::store::LendingDb]lending.rehearsal_room.wing_name), 'SOUTH WING'),
                   'WING-S',
                   sqlNull()
                 )
               )
  }
)
