###Pure
Enum {meta::pure::profiles::doc.doc = 'Who a school instrument was lent to; the enumeration whose members are resolved from a short stored code.'} test::gildedwillow2::domain::BorrowerKind
{
  STUDENT,
  STAFF,
  ENSEMBLE
}

Class <<meta::pure::profiles::temporal.processingtemporal>> {meta::pure::profiles::doc.doc = 'One lending of a school instrument, versioned on the processing timeline so a correction supersedes the earlier row rather than overwriting it.'} test::gildedwillow2::domain::InstrumentCheckout
{
  checkoutCode: String[1];
  programName: String[1];
  borrowerKind: test::gildedwillow2::domain::BorrowerKind[0..1];
  instrumentLabel: String[0..1];
  familyCode: String[1];
  roomName: String[0..1];
  wingName: String[0..1];
  checkedOutOn: StrictDate[0..1];
  dueDate: StrictDate[0..1];
  returnedDate: StrictDate[0..1];
  overdueDays: Integer[0..1];
  serviceHours: Float[0..1];
  overdueBand: String[0..1];
  wearLabel: String[0..1];
  hoursPerCheckout: Float[0..1];
  carryCase: test::gildedwillow2::domain::CheckoutCase[0..1];
}

Class {meta::pure::profiles::doc.doc = 'The carrying case handed out with an instrument; held as an embedded shape inside the lending row rather than as its own relation.'} test::gildedwillow2::domain::CheckoutCase
{
  caseCode: String[1];
  caseLabel: String[0..1];
  caseGrade: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A rehearsal room an instrument may be signed out to; mapped by the included base mapping rather than by the mapping that maps the lending.'} test::gildedwillow2::domain::RehearsalRoom
{
  roomCode: String[1];
  roomName: String[1];
  wingName: String[0..1];
  wingLabel: String[0..1];
}
