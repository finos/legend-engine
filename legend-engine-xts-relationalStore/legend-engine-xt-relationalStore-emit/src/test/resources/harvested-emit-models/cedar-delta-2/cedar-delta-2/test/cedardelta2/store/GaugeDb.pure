###Relational
Database demo::cedardelta2::store::GaugeDb
(
  Schema hydro
  (
    Table stage_reading
    (
      reading_id INTEGER PRIMARY KEY,
      reading_code VARCHAR(24) NOT NULL,
      station_code VARCHAR(24) NOT NULL,
      gauge_class_code VARCHAR(8),
      stage_grade_code VARCHAR(4),
      stage_cm_text VARCHAR(16),
      rainfall_mm INTEGER,
      observer_note VARCHAR(256),
      read_on DATE
    )
  )
)
