###Pure
import demo::cedardelta2::domain::*;

Enum {meta::pure::profiles::doc.doc = 'Instrument classes a river stage can be read from at a gauging station.'} demo::cedardelta2::domain::GaugeClass
{
  Staff,
  FloatWell,
  Pressure,
  Radar,
  Unrecorded
}

Class {meta::pure::profiles::doc.doc = 'One stage reading taken at a river gauging station, carrying the instrument class, the cast stage height, the graded stage band and the tidied observer note.'} demo::cedardelta2::domain::StageReading
{
  readingCode: String[1];
  stationCode: String[1];
  registerKind: String[1];
  gaugeClass: GaugeClass[1];
  stageBand: String[0..1];
  stageCm: Integer[0..1];
  rainfallMm: Integer[1];
  observerLabel: String[0..1];
}
