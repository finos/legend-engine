###Pure
import meta::pure::profiles::*;

Class <<temporal.processingtemporal>> {doc.doc = 'One bird held in a walk-through aviary, versioned on the processing timeline so a corrected holding record supersedes the row it replaces rather than overwriting it.'} test::umberaviary2::domain::BirdHolding
{
  holdingCode: String[1];
  ringId: String[0..1];
  speciesCode: String[0..1];
  houseCode: String[0..1];
  clutchSize: Integer[0..1];
}

Class {doc.doc = 'A bird house inside the aviary and the keeper responsible for it.'} test::umberaviary2::domain::BirdHouse
{
  houseCode: String[1];
  houseName: String[0..1];
  keeperName: String[0..1];
}

Class {doc.doc = 'The reference species a held bird is recorded against, with the taxon it belongs to.'} test::umberaviary2::domain::SpeciesRef
{
  speciesCode: String[1];
  speciesName: String[0..1];
  taxonName: String[0..1];
}
