###Relational
Database test::umberaviary2::store::AviaryDb
(
  Schema aviary
  (
    Table bird_holding
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )

      holding_id VARCHAR(16) PRIMARY KEY,
      holding_code VARCHAR(24) NOT NULL,
      ring_id VARCHAR(24),
      species_code VARCHAR(16),
      house_code VARCHAR(16),
      clutch_size INTEGER,
      in_z DATE NOT NULL,
      out_z DATE NOT NULL
    )

    Table bird_house
    (
      house_code VARCHAR(16) PRIMARY KEY,
      house_name VARCHAR(128),
      keeper_name VARCHAR(128)
    )

    Table species_ref
    (
      species_code VARCHAR(16) PRIMARY KEY,
      species_name VARCHAR(128),
      taxon_name VARCHAR(128)
    )
  )
)
