###Mapping
Mapping test::scarletprairie4::mapping::PrairiePlotMapping
(
  include mapping test::scarletprairie4::mapping::PrairieEnumMappings

  *test::scarletprairie4::domain::PrairiePlot[prairiePlot]: Relational
  {
    ~filter [test::scarletprairie4::store::PrairieSurveyDb]OpenPlots
    ~primaryKey
    (
      [test::scarletprairie4::store::PrairieSurveyDb]survey.plot.plot_code
    )
    ~mainTable [test::scarletprairie4::store::PrairieSurveyDb]survey.plot
    plotCode: [test::scarletprairie4::store::PrairieSurveyDb]survey.plot.plot_code,
    plotLabel: concat(toUpper(substring([test::scarletprairie4::store::PrairieSurveyDb]survey.plot.plot_code, 1, 3)), '/', trim([test::scarletprairie4::store::PrairieSurveyDb]survey.plot.plot_name)),
    areaM2: plus(times([test::scarletprairie4::store::PrairieSurveyDb]survey.plot.width_m, [test::scarletprairie4::store::PrairieSurveyDb]survey.plot.length_m), [test::scarletprairie4::store::PrairieSurveyDb]survey.plot.buffer_m2),
    soilBand: case(equal([test::scarletprairie4::store::PrairieSurveyDb]survey.plot.soil_code, 'LM'), 'LOAM-DEEP', case(equal([test::scarletprairie4::store::PrairieSurveyDb]survey.plot.soil_code, 'LS'), 'LOAM-SANDY', case(equal([test::scarletprairie4::store::PrairieSurveyDb]survey.plot.soil_code, 'CL'), 'CLAY-HEAVY', case(equal([test::scarletprairie4::store::PrairieSurveyDb]survey.plot.soil_code, 'CS'), 'CLAY-SILTY', case(equal([test::scarletprairie4::store::PrairieSurveyDb]survey.plot.soil_code, 'SA'), 'SAND-DUNE', case(equal([test::scarletprairie4::store::PrairieSurveyDb]survey.plot.soil_code, 'SG'), 'SAND-GRAVEL', case(equal([test::scarletprairie4::store::PrairieSurveyDb]survey.plot.soil_code, 'PT'), 'PEAT-WET', case(equal([test::scarletprairie4::store::PrairieSurveyDb]survey.plot.soil_code, 'RK'), 'ROCK-THIN', sqlNull())))))))),
    grazingTier: case(or(equal(substring([test::scarletprairie4::store::PrairieSurveyDb]survey.plot.grazing_code, 1, 2), 'GR'), equal(substring([test::scarletprairie4::store::PrairieSurveyDb]survey.plot.grazing_code, 1, 2), 'BV')), 'GRAZED', case(equal(substring([test::scarletprairie4::store::PrairieSurveyDb]survey.plot.grazing_code, 1, 2), 'MW'), 'MOWN', 'RESTED')),
    stemDensity: case(equal([test::scarletprairie4::store::PrairieSurveyDb]survey.plot.width_m, 0), sqlNull(), divide([test::scarletprairie4::store::PrairieSurveyDb]survey.plot.stem_count, [test::scarletprairie4::store::PrairieSurveyDb]survey.plot.width_m)),
    sourceTag: 'restoration-survey',
    parentName: [test::scarletprairie4::store::PrairieSurveyDb]@Plot_Parent | survey.plot.plot_name,
    speciesNames: [test::scarletprairie4::store::PrairieSurveyDb]@Plot_Transect > @Transect_Obs > @Obs_Species | ref.species_ref.common_name,
    habitat: EnumerationMapping HabitatCodes: case(or(equal([test::scarletprairie4::store::PrairieSurveyDb]survey.plot.habitat_code, 'TG'), or(equal([test::scarletprairie4::store::PrairieSurveyDb]survey.plot.habitat_code, 'MG'), or(equal([test::scarletprairie4::store::PrairieSurveyDb]survey.plot.habitat_code, 'MX'), equal([test::scarletprairie4::store::PrairieSurveyDb]survey.plot.habitat_code, 'SG')))), [test::scarletprairie4::store::PrairieSurveyDb]survey.plot.habitat_code, 'UN')
  }

  *test::scarletprairie4::domain::TransectSighting[transectSighting]: Relational
  {
    ~primaryKey
    (
      [test::scarletprairie4::store::PrairieSurveyDb]survey.transect_species_view.transect_tag,
      [test::scarletprairie4::store::PrairieSurveyDb]survey.transect_species_view.species_code
    )
    ~mainTable [test::scarletprairie4::store::PrairieSurveyDb]survey.transect_species_view
    transectTag: [test::scarletprairie4::store::PrairieSurveyDb]survey.transect_species_view.transect_tag,
    speciesCode: [test::scarletprairie4::store::PrairieSurveyDb]survey.transect_species_view.species_code,
    commonLabel: [test::scarletprairie4::store::PrairieSurveyDb]survey.transect_species_view.common_label
  }

  testSuites:
  [
    plotSuite:
    {
      function: |test::scarletprairie4::domain::PrairiePlot.all()->graphFetch(#{test::scarletprairie4::domain::PrairiePlot{plotCode,plotLabel,areaM2,soilBand,grazingTier,stemDensity,sourceTag,parentName,speciesNames,habitat}}#)->serialize(#{test::scarletprairie4::domain::PrairiePlot{plotCode,plotLabel,areaM2,soilBand,grazingTier,stemDensity,sourceTag,parentName,speciesNames,habitat}}#);
      tests:
      [
        everySoilArmAndJoinPath:
        {
          doc: 'Hits all eight soil arms and the null fallback, every grazing arm, the zero-width density guard, the self-joined parent, the three-hop species path (hit, literal-condition miss, missing middle hop, partial composite match) and an unmapped habitat code that lands on the sentinel; retired, merged and zero-burn plots are filtered out.';
          data:
          [
            test::scarletprairie4::store::PrairieSurveyDb:
              Relational
              #{
                survey.plot:
                  'plot_code,plot_name,parent_code,plot_state,soil_code,grazing_code,habitat_code,width_m,length_m,buffer_m2,stem_count,burn_cycle\n'+
                  'P01,North Swale,,OPEN,LM,GRAZE-A,TG,100.0,120.0,500.0,400.0,3\n'+
                  'P02,East Knoll,P01,OPEN,LS,BV-2,MG,50.0,80.0,0.0,250.0,2\n'+
                  'P03,Creek Flat,P01,SEEDED,CL,MW-1,MX,40.0,60.0,100.0,80.0,\n'+
                  'P04,Ridge Strip,,OPEN,CS,RS-9,SG,0.0,90.0,250.0,30.0,4\n'+
                  'P05,Salt Lick,P04,OPEN,SA,GR-7,ZZ,20.0,20.0,0.0,0.0,1\n'+
                  'P06,Gravel Bar,,OPEN,SG,MW-4,TG,10.0,30.0,50.0,12.0,2\n'+
                  'P07,Fen Edge,,OPEN,PT,BV-1,MG,25.0,40.0,0.0,50.0,5\n'+
                  'P08,Outcrop,,OPEN,RK,NONE,SG,15.0,15.0,25.0,9.0,1\n'+
                  'P09,Burn Scar,,OPEN,XX,GR-1,TG,30.0,30.0,0.0,45.0,2\n'+
                  'P10,Old Pasture,,RETIRED,LM,GR-2,TG,10.0,10.0,0.0,1.0,1\n'+
                  'P11,Annex Plot,,OPEN,CL,GR-3,TG,10.0,10.0,0.0,1.0,0\n'+
                  'P12,Merged Corner,,MERGED,SA,GR-4,SG,10.0,10.0,0.0,1.0,1\n';
                survey.transect:
                  'transect_code,plot_code,bearing_deg\n'+
                  'T1,P01,90\n'+
                  'T1,P02,180\n'+
                  'T3,P03,270\n'+
                  'T4,P04,0\n';
                survey.species_obs:
                  'obs_code,transect_code,plot_code,species_code,stem_tally\n'+
                  'O1,T1,P01,SP-BLUESTEM,14\n'+
                  'O2,T1,P02,SP-CONEFLOWER,6\n'+
                  'O3,T3,P03,SP-OLDROW,3\n'+
                  'O4,T1,P05,SP-BLUESTEM,2\n';
                ref.species_ref:
                  'species_code,common_name,family_code,ref_state\n'+
                  'SP-BLUESTEM,Big Bluestem,POACEAE,LIVE\n'+
                  'SP-CONEFLOWER,Purple Coneflower,ASTERACEAE,PROVISIONAL\n'+
                  'SP-OLDROW,Withdrawn Sedge,CYPERACEAE,RETIRED\n';
              }#
          ];
          asserts:
          [
            nineOpenPlots:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"plotCode":"P01","plotLabel":"P01/North Swale","areaM2":12500.0,"soilBand":"LOAM-DEEP","grazingTier":"GRAZED","stemDensity":4.0,"sourceTag":"restoration-survey","parentName":null,"speciesNames":["Big Bluestem"],"habitat":"TALLGRASS"},{"plotCode":"P02","plotLabel":"P02/East Knoll","areaM2":4000.0,"soilBand":"LOAM-SANDY","grazingTier":"GRAZED","stemDensity":5.0,"sourceTag":"restoration-survey","parentName":"North Swale","speciesNames":["Purple Coneflower"],"habitat":"MIXEDGRASS"},{"plotCode":"P03","plotLabel":"P03/Creek Flat","areaM2":2500.0,"soilBand":"CLAY-HEAVY","grazingTier":"MOWN","stemDensity":2.0,"sourceTag":"restoration-survey","parentName":"North Swale","speciesNames":[],"habitat":"MIXEDGRASS"},{"plotCode":"P04","plotLabel":"P04/Ridge Strip","areaM2":250.0,"soilBand":"CLAY-SILTY","grazingTier":"RESTED","stemDensity":null,"sourceTag":"restoration-survey","parentName":null,"speciesNames":[],"habitat":"SHORTGRASS"},{"plotCode":"P05","plotLabel":"P05/Salt Lick","areaM2":400.0,"soilBand":"SAND-DUNE","grazingTier":"GRAZED","stemDensity":0.0,"sourceTag":"restoration-survey","parentName":"Ridge Strip","speciesNames":[],"habitat":"UNRECORDED"},{"plotCode":"P06","plotLabel":"P06/Gravel Bar","areaM2":350.0,"soilBand":"SAND-GRAVEL","grazingTier":"MOWN","stemDensity":1.2,"sourceTag":"restoration-survey","parentName":null,"speciesNames":[],"habitat":"TALLGRASS"},{"plotCode":"P07","plotLabel":"P07/Fen Edge","areaM2":1000.0,"soilBand":"PEAT-WET","grazingTier":"GRAZED","stemDensity":2.0,"sourceTag":"restoration-survey","parentName":null,"speciesNames":[],"habitat":"MIXEDGRASS"},{"plotCode":"P08","plotLabel":"P08/Outcrop","areaM2":250.0,"soilBand":"ROCK-THIN","grazingTier":"RESTED","stemDensity":0.6,"sourceTag":"restoration-survey","parentName":null,"speciesNames":[],"habitat":"SHORTGRASS"},{"plotCode":"P09","plotLabel":"P09/Burn Scar","areaM2":900.0,"soilBand":null,"grazingTier":"GRAZED","stemDensity":1.5,"sourceTag":"restoration-survey","parentName":null,"speciesNames":[],"habitat":"TALLGRASS"}]';
                  }#;
              }#
          ];
        },
        everyPlotFilteredOut:
        {
          doc: 'Only retired, merged and zero-burn plots are present, so the store filter keeps nothing.';
          data:
          [
            test::scarletprairie4::store::PrairieSurveyDb:
              Relational
              #{
                survey.plot:
                  'plot_code,plot_name,parent_code,plot_state,soil_code,grazing_code,habitat_code,width_m,length_m,buffer_m2,stem_count,burn_cycle\n'+
                  'P10,Old Pasture,,RETIRED,LM,GR-2,TG,10.0,10.0,0.0,1.0,1\n'+
                  'P11,Annex Plot,,OPEN,CL,GR-3,TG,10.0,10.0,0.0,1.0,0\n'+
                  'P12,Merged Corner,,MERGED,SA,GR-4,SG,10.0,10.0,0.0,1.0,1\n';
              }#
          ];
          asserts:
          [
            noPlots:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[]';
                  }#;
              }#
          ];
        }
      ];
    },
    sightingSuite:
    {
      function: |test::scarletprairie4::domain::TransectSighting.all()->graphFetch(#{test::scarletprairie4::domain::TransectSighting{transectTag,speciesCode,commonLabel}}#)->serialize(#{test::scarletprairie4::domain::TransectSighting{transectTag,speciesCode,commonLabel}}#);
      tests:
      [
        distinctSightings:
        {
          doc: 'A duplicated observation collapses through the distinct view, and a species withdrawn from the reference list keeps its code but loses its name through the inner species hop.';
          data:
          [
            test::scarletprairie4::store::PrairieSurveyDb:
              Relational
              #{
                survey.transect:
                  'transect_code,plot_code,bearing_deg\n'+
                  't1,P01,90\n'+
                  't2,P01,45\n'+
                  't3,P03,270\n';
                survey.species_obs:
                  'obs_code,transect_code,plot_code,species_code,stem_tally\n'+
                  'O1,t1,P01,SP-BLUESTEM,14\n'+
                  'O5,t1,P01,SP-BLUESTEM,9\n'+
                  'O6,t2,P01,SP-SWITCH,4\n'+
                  'O3,t3,P03,SP-OLDROW,3\n';
                ref.species_ref:
                  'species_code,common_name,family_code,ref_state\n'+
                  'SP-BLUESTEM,Big Bluestem,POACEAE,LIVE\n'+
                  'SP-SWITCH,Switchgrass,POACEAE,LIVE\n'+
                  'SP-OLDROW,Withdrawn Sedge,CYPERACEAE,RETIRED\n';
              }#
          ];
          asserts:
          [
            threeSightings:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"transectTag":"T1-P01","speciesCode":"SP-BLUESTEM","commonLabel":"Big Bluestem"},{"transectTag":"T2-P01","speciesCode":"SP-SWITCH","commonLabel":"Switchgrass"},{"transectTag":"T3-P03","speciesCode":"SP-OLDROW","commonLabel":null}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
