###Relational
Database test::quietcove4::store::CoveDB
(
  Schema cove
  (
    Table mooring_visit
    (
      visit_id INTEGER PRIMARY KEY,
      visit_code VARCHAR(20) NOT NULL,
      cove_code VARCHAR(20) NOT NULL,
      vessel_name VARCHAR(60) NOT NULL,
      berth_code VARCHAR(4) NOT NULL,
      nights INTEGER NOT NULL,
      arrived_on DATE NOT NULL
    )

    Table dive_log
    (
      log_id INTEGER PRIMARY KEY,
      log_code VARCHAR(20) NOT NULL,
      cove_code VARCHAR(20) NOT NULL,
      site_name VARCHAR(60) NOT NULL,
      depth_m INTEGER NOT NULL,
      visibility_m INTEGER NOT NULL,
      team_size INTEGER NOT NULL,
      dived_on DATE NOT NULL
    )
  )
)
