###Mapping
Mapping test::quietcove4::mapping::CoveMapping
(
  *test::quietcove4::domain::MooringVisit[mooringVisit]: Relational
  {
    ~primaryKey
    (
      [test::quietcove4::store::CoveDB]cove.mooring_visit.visit_id
    )
    ~mainTable [test::quietcove4::store::CoveDB]cove.mooring_visit
    visitCode: [test::quietcove4::store::CoveDB]cove.mooring_visit.visit_code,
    coveCode: [test::quietcove4::store::CoveDB]cove.mooring_visit.cove_code,
    vesselName: [test::quietcove4::store::CoveDB]cove.mooring_visit.vessel_name,
    berthKind: case(
      equal([test::quietcove4::store::CoveDB]cove.mooring_visit.berth_code, 'SW'),
      'SWING',
      case(
        equal([test::quietcove4::store::CoveDB]cove.mooring_visit.berth_code, 'PN'),
        'PONTOON',
        case(
          equal([test::quietcove4::store::CoveDB]cove.mooring_visit.berth_code, 'PL'),
          'PILE',
          case(
            equal([test::quietcove4::store::CoveDB]cove.mooring_visit.berth_code, 'AN'),
            'ANCHORAGE',
            'UNBERTHED'
          )
        )
      )
    ),
    nights: [test::quietcove4::store::CoveDB]cove.mooring_visit.nights,
    arrivedOn: [test::quietcove4::store::CoveDB]cove.mooring_visit.arrived_on
  }

  *test::quietcove4::domain::DiveLog[diveLog]: Relational
  {
    ~primaryKey
    (
      [test::quietcove4::store::CoveDB]cove.dive_log.log_id
    )
    ~mainTable [test::quietcove4::store::CoveDB]cove.dive_log
    logCode: [test::quietcove4::store::CoveDB]cove.dive_log.log_code,
    coveCode: [test::quietcove4::store::CoveDB]cove.dive_log.cove_code,
    siteName: [test::quietcove4::store::CoveDB]cove.dive_log.site_name,
    depthM: [test::quietcove4::store::CoveDB]cove.dive_log.depth_m,
    visibilityM: [test::quietcove4::store::CoveDB]cove.dive_log.visibility_m,
    teamSize: [test::quietcove4::store::CoveDB]cove.dive_log.team_size,
    divedOn: [test::quietcove4::store::CoveDB]cove.dive_log.dived_on
  }
)
