###Relational
Database test::silverfjord3::store::RegionDb
(
  Schema coast
  (
    Table region
    (
      region_code VARCHAR(8) PRIMARY KEY,
      coast_code VARCHAR(8) PRIMARY KEY,
      basin_no INTEGER PRIMARY KEY,
      region_name VARCHAR(48) NOT NULL,
      surveyed_at TIMESTAMP NOT NULL
    )
  )

  Filter SurveyedSinceChartRevision(coast.region.surveyed_at >= '2018-01-01 00:00:00')
)
