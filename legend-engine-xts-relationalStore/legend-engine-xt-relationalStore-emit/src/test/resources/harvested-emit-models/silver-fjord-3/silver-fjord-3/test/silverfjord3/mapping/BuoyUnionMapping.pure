###Mapping
Mapping test::silverfjord3::mapping::BuoyUnionMapping
(
  include mapping test::silverfjord3::mapping::FjordEnumMappings

  *test::silverfjord3::domain::Buoy[allBuoys]: Operation
  {
    meta::pure::router::operations::union_OperationSetImplementation_1__SetImplementation_MANY_(liveBuoy, archivedBuoy, visitingBuoy)
  }

  test::silverfjord3::domain::Buoy[liveBuoy]: Relational
  {
    ~primaryKey
    (
      [test::silverfjord3::store::ArchiveDb]gauge.moored_buoy.buoy_code,
      [test::silverfjord3::store::ArchiveDb]gauge.moored_buoy.network_code,
      [test::silverfjord3::store::ArchiveDb]gauge.moored_buoy.mooring_no
    )
    ~mainTable [test::silverfjord3::store::ArchiveDb]gauge.moored_buoy
    buoyCode: [test::silverfjord3::store::ArchiveDb]gauge.moored_buoy.buoy_code,
    networkCode: [test::silverfjord3::store::ArchiveDb]gauge.moored_buoy.network_code,
    mooringNo: [test::silverfjord3::store::ArchiveDb]gauge.moored_buoy.mooring_no,
    kind: EnumerationMapping BuoyKindMapping: [test::silverfjord3::store::ArchiveDb]gauge.moored_buoy.buoy_kind,
    register: 'LIVE'
  }

  test::silverfjord3::domain::Buoy[archivedBuoy]: Relational
  {
    ~primaryKey
    (
      [test::silverfjord3::store::ArchiveDb]archive.archived_buoy.buoy_code,
      [test::silverfjord3::store::ArchiveDb]archive.archived_buoy.network_code,
      [test::silverfjord3::store::ArchiveDb]archive.archived_buoy.mooring_no
    )
    ~mainTable [test::silverfjord3::store::ArchiveDb]archive.archived_buoy
    buoyCode: [test::silverfjord3::store::ArchiveDb]archive.archived_buoy.buoy_code,
    networkCode: [test::silverfjord3::store::ArchiveDb]archive.archived_buoy.network_code,
    mooringNo: [test::silverfjord3::store::ArchiveDb]archive.archived_buoy.mooring_no,
    kind: EnumerationMapping BuoyKindMapping: [test::silverfjord3::store::ArchiveDb]archive.archived_buoy.buoy_kind,
    register: 'ARCHIVED'
  }

  test::silverfjord3::domain::Buoy[visitingBuoy]: Relational
  {
    ~filter [test::silverfjord3::store::ArchiveDb]VisitStillRunning
    ~primaryKey
    (
      [test::silverfjord3::store::ArchiveDb]archive.visiting_buoy.buoy_code,
      [test::silverfjord3::store::ArchiveDb]archive.visiting_buoy.network_code,
      [test::silverfjord3::store::ArchiveDb]archive.visiting_buoy.mooring_no,
      [test::silverfjord3::store::ArchiveDb]archive.visiting_buoy.host_code
    )
    ~mainTable [test::silverfjord3::store::ArchiveDb]archive.visiting_buoy
    buoyCode: [test::silverfjord3::store::ArchiveDb]archive.visiting_buoy.buoy_code,
    networkCode: [test::silverfjord3::store::ArchiveDb]archive.visiting_buoy.network_code,
    mooringNo: [test::silverfjord3::store::ArchiveDb]archive.visiting_buoy.mooring_no,
    kind: EnumerationMapping BuoyKindMapping: [test::silverfjord3::store::ArchiveDb]archive.visiting_buoy.buoy_kind,
    register: 'VISITING'
  }

  *test::silverfjord3::domain::RefittedBuoy[refittedBuoy] extends [liveBuoy]: Relational
  {
    ~filter [test::silverfjord3::store::ArchiveDb]DeployedSinceRefit
    refitMooringNo: [test::silverfjord3::store::ArchiveDb]gauge.moored_buoy.mooring_no
  }

  testSuites:
  [
    buoyUnionSuite:
    {
      function: |test::silverfjord3::domain::Buoy.all()->project(~[
        Buoy: b|$b.buoyCode,
        Network: b|$b.networkCode,
        Mooring: b|$b.mooringNo,
        Kind: b|$b.kind,
        Register: b|$b.register
      ])->sort([~Buoy->ascending(), ~Register->ascending()]);
      tests:
      [
        everyMemberContributesAcrossStores:
        {
          doc: 'The union concatenates the live buoys of the gauge store included into the archive store with its archived and visiting buoys without merging: one buoy sits in two members and surfaces twice, one visit is dated in the future and is dropped by the running-visit filter.';
          data:
          [
            test::silverfjord3::store::ArchiveDb:
              Relational
              #{
                gauge.moored_buoy:
                  'buoy_code,network_code,mooring_no,buoy_kind,deployed_at\n'+
                  'BY-01,NW-1,1,S,2023-04-01 08:00:00\n'+
                  'BY-02,NW-1,2,D,2019-09-01 08:00:00\n';
                archive.archived_buoy:
                  'buoy_code,network_code,mooring_no,buoy_kind,deployed_at\n'+
                  'BY-01,NW-1,1,S,2016-04-01 08:00:00\n'+
                  'BY-03,NW-2,1,D,2014-02-01 08:00:00\n';
                archive.visiting_buoy:
                  'buoy_code,network_code,mooring_no,host_code,buoy_kind,deployed_at\n'+
                  'BY-04,NW-2,3,HOST-1,S,2025-07-01 08:00:00\n'+
                  'BY-05,NW-2,4,HOST-2,D,2999-01-01 08:00:00\n';
              }#
          ];
          asserts:
          [
            unionedBuoys:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Buoy":"BY-01","Network":"NW-1","Mooring":1,"Kind":"SPAR","Register":"ARCHIVED"},{"Buoy":"BY-01","Network":"NW-1","Mooring":1,"Kind":"SPAR","Register":"LIVE"},{"Buoy":"BY-02","Network":"NW-1","Mooring":2,"Kind":"DISCUS","Register":"LIVE"},{"Buoy":"BY-03","Network":"NW-2","Mooring":1,"Kind":"DISCUS","Register":"ARCHIVED"},{"Buoy":"BY-04","Network":"NW-2","Mooring":3,"Kind":"SPAR","Register":"VISITING"}]';
                  }#;
              }#
          ];
        }
      ];
    },
    refittedBuoySuite:
    {
      function: |test::silverfjord3::domain::RefittedBuoy.all()->project(~[
        Buoy: b|$b.buoyCode,
        Mooring: b|$b.refitMooringNo,
        Kind: b|$b.kind
      ])->sort(~Buoy->ascending());
      tests:
      [
        onlyBuoysDeployedSinceTheRefit:
        {
          doc: 'The child class mapping extends the live buoy mapping and narrows it with the refit store filter, so the buoy deployed before the refit is dropped.';
          data:
          [
            test::silverfjord3::store::ArchiveDb:
              Relational
              #{
                gauge.moored_buoy:
                  'buoy_code,network_code,mooring_no,buoy_kind,deployed_at\n'+
                  'BY-01,NW-1,1,S,2023-04-01 08:00:00\n'+
                  'BY-02,NW-1,2,D,2019-09-01 08:00:00\n';
              }#
          ];
          asserts:
          [
            refittedBuoys:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Buoy":"BY-01","Mooring":1,"Kind":"SPAR"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
