###Pure
import test::silverfjord3::domain::*;

Enum test::silverfjord3::domain::StationStatus
{
  ACTIVE,
  SUSPENDED,
  DECOMMISSIONED
}

Enum test::silverfjord3::domain::ReadingQuality
{
  GOOD,
  SUSPECT
}

Enum test::silverfjord3::domain::BuoyKind
{
  SPAR,
  DISCUS
}

Class <<meta::pure::profiles::temporal.bitemporal>> test::silverfjord3::domain::TideStation
{
  stationCode: String[1];
  networkCode: String[1];
  regionCode: String[1];
  stationName: String[1];
  status: StationStatus[0..1];
  datumMm: Integer[0..1];
}

Class <<meta::pure::profiles::temporal.businesstemporal>> test::silverfjord3::domain::LevelReading
{
  stationCode: String[1];
  networkCode: String[1];
  sensorNo: Integer[1];
  readingKind: String[1];
  levelMm: Integer[0..1];
  quality: ReadingQuality[0..1];
}

Class <<meta::pure::profiles::temporal.processingtemporal>> test::silverfjord3::domain::RetiredStation
{
  stationCode: String[1];
  networkCode: String[1];
  regionCode: String[1];
  stationName: String[1];
}

Class test::silverfjord3::domain::Buoy
{
  buoyCode: String[1];
  networkCode: String[1];
  mooringNo: Integer[1];
  kind: BuoyKind[0..1];
  register: String[1];
}

Class test::silverfjord3::domain::RefittedBuoy extends Buoy
{
  refitMooringNo: Integer[1];
}

Class test::silverfjord3::domain::CoastalRegion
{
  regionCode: String[1];
  coastCode: String[1];
  basinNo: Integer[1];
  regionName: String[1];
}

Class test::silverfjord3::domain::ChartedRegion extends CoastalRegion
{
  chartedName: String[1];
}
