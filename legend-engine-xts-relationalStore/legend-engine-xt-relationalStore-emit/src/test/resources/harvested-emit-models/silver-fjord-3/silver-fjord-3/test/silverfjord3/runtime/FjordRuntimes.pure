###Runtime
Runtime test::silverfjord3::runtime::GaugeRuntime
{
  mappings:
  [
    test::silverfjord3::mapping::GaugeMapping
  ];
  connections:
  [
    test::silverfjord3::store::GaugeDb:
    [
      gaugeConn: test::silverfjord3::connection::GaugeConnection
    ]
  ];
}

