###Relational
Database test::silverfjord3::store::ArchiveDb
(
  include test::silverfjord3::store::GaugeDb

  Schema archive
  (
    Table retired_station
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z, INFINITY_DATE = %9999-12-31)
      )

      station_code VARCHAR(12) PRIMARY KEY,
      network_code VARCHAR(8) PRIMARY KEY,
      region_code VARCHAR(8) PRIMARY KEY,
      station_name VARCHAR(48) NOT NULL,
      retired_at TIMESTAMP,
      in_z DATE NOT NULL,
      out_z DATE NOT NULL
    )

    Table archived_buoy
    (
      buoy_code VARCHAR(12) PRIMARY KEY,
      network_code VARCHAR(8) PRIMARY KEY,
      mooring_no INTEGER PRIMARY KEY,
      buoy_kind VARCHAR(2),
      deployed_at TIMESTAMP NOT NULL
    )

    Table visiting_buoy
    (
      buoy_code VARCHAR(12) PRIMARY KEY,
      network_code VARCHAR(8) PRIMARY KEY,
      mooring_no INTEGER PRIMARY KEY,
      host_code VARCHAR(12) PRIMARY KEY,
      buoy_kind VARCHAR(2),
      deployed_at TIMESTAMP NOT NULL
    )
  )

  Filter DeployedSinceRefit(gauge.moored_buoy.deployed_at >= '2022-01-01 00:00:00')
  Filter RetiredSinceSurvey(archive.retired_station.retired_at >= '2020-01-01 00:00:00')
  Filter VisitStillRunning(archive.visiting_buoy.deployed_at <= now())
)
