###Connection
RelationalDatabaseConnection test::silverfjord3::connection::GaugeConnection
{
  store: test::silverfjord3::store::GaugeDb;
  type: Sybase;
  timezone: +0000;
  specification: Static
  {
    name: 'gauge_register';
    host: 'example-gauge-register-host';
    port: 5000;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'tidegaugeprincipal';
  };
}

RelationalDatabaseConnection test::silverfjord3::connection::ArchiveConnection
{
  store: test::silverfjord3::store::ArchiveDb;
  type: Sybase;
  timezone: +0000;
  specification: Static
  {
    name: 'gauge_archive';
    host: 'example-gauge-archive-host';
    port: 5000;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'gaugearchiveprincipal';
  };
}

RelationalDatabaseConnection test::silverfjord3::connection::RegionConnection
{
  store: test::silverfjord3::store::RegionDb;
  type: Sybase;
  timezone: +0000;
  specification: Static
  {
    name: 'coast_reference';
    host: 'example-coast-reference-host';
    port: 5000;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'coastrefprincipal';
  };
}
