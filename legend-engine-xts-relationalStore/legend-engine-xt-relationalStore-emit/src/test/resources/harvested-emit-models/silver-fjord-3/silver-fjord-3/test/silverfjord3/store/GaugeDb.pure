###Relational
Database test::silverfjord3::store::GaugeDb
(
  Schema gauge
  (
    Table station
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z, INFINITY_DATE = %9999-12-31),
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )

      station_code VARCHAR(12) PRIMARY KEY,
      network_code VARCHAR(8) PRIMARY KEY,
      region_code VARCHAR(8) PRIMARY KEY,
      station_name VARCHAR(48) NOT NULL,
      status_code VARCHAR(2),
      datum_mm INTEGER,
      in_z DATE NOT NULL,
      out_z DATE NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )

    Table level_reading
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )

      station_code VARCHAR(12) PRIMARY KEY,
      network_code VARCHAR(8) PRIMARY KEY,
      sensor_no INTEGER PRIMARY KEY,
      reading_kind VARCHAR(8) PRIMARY KEY,
      level_mm INTEGER,
      quality_code VARCHAR(2),
      logged_at TIMESTAMP NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )

    Table moored_buoy
    (
      buoy_code VARCHAR(12) PRIMARY KEY,
      network_code VARCHAR(8) PRIMARY KEY,
      mooring_no INTEGER PRIMARY KEY,
      buoy_kind VARCHAR(2),
      deployed_at TIMESTAMP NOT NULL
    )
  )

  Filter LoggedSinceNetworkUpgrade(gauge.level_reading.logged_at >= '2024-01-01 00:00:00')
)
