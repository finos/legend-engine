###Relational
Database test::meadowfjord8::store::MeadowDb
(
  Schema meadowland
  (
    Table survey_plot
    (
      plot_code VARCHAR(24) PRIMARY KEY,
      plot_name VARCHAR(120) NOT NULL,
      aspect_code VARCHAR(16) NOT NULL,
      slope_percent DOUBLE NOT NULL
    )

    Table bloom_count
    (
      count_code VARCHAR(24) PRIMARY KEY,
      plot_code VARCHAR(24) NOT NULL,
      species_code VARCHAR(24) NOT NULL,
      flower_count INTEGER NOT NULL,
      cover_percent DOUBLE NOT NULL,
      counted_on DATE NOT NULL
    )

    Table meadow_visit
    (
      visit_code VARCHAR(24) PRIMARY KEY,
      plot_code VARCHAR(24) NOT NULL,
      crew_code VARCHAR(24) NOT NULL,
      visited_on DATE NOT NULL,
      hours_spent DOUBLE NOT NULL
    )
  )
)
