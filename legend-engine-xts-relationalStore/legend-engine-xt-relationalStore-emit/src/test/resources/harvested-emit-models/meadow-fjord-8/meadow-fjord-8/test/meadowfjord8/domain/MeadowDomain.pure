###Pure
Class {meta::pure::profiles::doc.doc = 'One walked survey plot on the alpine meadow, carrying the slope it sits on and the aspect it faces.'} test::meadowfjord8::domain::SurveyPlot
{
  plotCode: String[1];
  plotName: String[1];
  aspectCode: String[1];
  slopePercent: Float[1];
}

Class {meta::pure::profiles::doc.doc = 'One flowering count taken for one species on one plot on one day, with the ground cover the species held at the time.'} test::meadowfjord8::domain::BloomCount
{
  countCode: String[1];
  plotCode: String[1];
  speciesCode: String[1];
  flowerCount: Integer[1];
  coverPercent: Float[1];
  countedOn: StrictDate[1];
}

Class {meta::pure::profiles::doc.doc = 'One visit paid to one plot by one walking crew, with the hours the crew spent on the plot.'} test::meadowfjord8::domain::MeadowVisit
{
  visitCode: String[1];
  plotCode: String[1];
  crewCode: String[1];
  visitedOn: StrictDate[1];
  hoursSpent: Float[1];
}
