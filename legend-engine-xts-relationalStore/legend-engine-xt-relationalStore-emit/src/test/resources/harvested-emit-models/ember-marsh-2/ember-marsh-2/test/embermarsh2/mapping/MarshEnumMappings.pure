  {
    PERMANENT: ['REGIME/PERM'],
    SEASONAL: ['REGIME/SEAS'],
    EPHEMERAL: ['REGIME/EPHM']
  }

  test::embermarsh2::domain::AccessClass: EnumerationMapping AccessMapping
  {
    OPEN: ['ACCESS/O'],
    PERMIT: ['ACCESS/R'],
    CLOSED: ['ACCESS/C']
  }

  test::embermarsh2::domain::LoggerState: EnumerationMapping LoggerStateMapping
  {
    ACTIVE: ['STATE/ACTIVE'],
    FAULTY: ['STATE/FAULTY']
  }

  test::embermarsh2::domain::FeedingGuild: EnumerationMapping GuildMapping
  {
