###Pure
Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'A mooring berth cut into a harbor seagrass meadow, whose recorded placement is effective over business time.'} test::meadowharbor::domain::MooringBerth
{
  berthCode: String[1];
  zoneCode: String[1];
  installedOn: StrictDate[1];
}

Class <<temporal.bitemporal>> {meta::pure::profiles::doc.doc = 'A meadow cover reading taken at a berth, corrected over processing time and effective over business time.'} test::meadowharbor::domain::PlotReading
{
  coverPct: Float[1];
  grade: String[1];
}

Association test::meadowharbor::domain::Berth_Reading
{
  berth: test::meadowharbor::domain::MooringBerth[*];
  reading: test::meadowharbor::domain::PlotReading[0..1];
}
