###Relational
Database test::meadowharbor::store::HarborDatabase
(
  Schema harbor
  (
    Table mooring_berth
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      berth_id INTEGER PRIMARY KEY,
      berth_code VARCHAR(20) NOT NULL,
      zone_code VARCHAR(20) NOT NULL,
      installed_on DATE NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
    Table plot_reading
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z),
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      reading_id INTEGER PRIMARY KEY,
      berth_id INTEGER NOT NULL,
      cover_pct DOUBLE NOT NULL,
      grade VARCHAR(20) NOT NULL,
      in_z DATE NOT NULL,
      out_z DATE NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
  )

  Join Berth_Reading(harbor.mooring_berth.berth_id = harbor.plot_reading.berth_id)
)
