###Connection
RelationalDatabaseConnection test::meadowharbor::connection::HarborH2Connection
{
  store: test::meadowharbor::store::HarborDatabase;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists harbor;',
      'create schema harbor;',
      'create table harbor.mooring_berth (berth_id integer primary key, berth_code varchar(20) not null, zone_code varchar(20) not null, installed_on date not null, from_z date not null, thru_z date not null);',
      'create table harbor.plot_reading (reading_id integer primary key, berth_id integer not null, cover_pct double not null, grade varchar(20) not null, in_z date not null, out_z date not null, from_z date not null, thru_z date not null);'
      ];
  };
  auth: DefaultH2;
}
