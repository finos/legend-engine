###Mapping
Mapping test::meadowharbor::mapping::HarborMapping
(
  *test::meadowharbor::domain::MooringBerth[berth]: Relational
  {
    ~primaryKey
    (
      [test::meadowharbor::store::HarborDatabase]harbor.mooring_berth.berth_id
    )
    ~mainTable [test::meadowharbor::store::HarborDatabase]harbor.mooring_berth
    berthCode: [test::meadowharbor::store::HarborDatabase]harbor.mooring_berth.berth_code,
    zoneCode: [test::meadowharbor::store::HarborDatabase]harbor.mooring_berth.zone_code,
    installedOn: [test::meadowharbor::store::HarborDatabase]harbor.mooring_berth.installed_on
  }

  *test::meadowharbor::domain::PlotReading[reading]: Relational
  {
    ~primaryKey
    (
      [test::meadowharbor::store::HarborDatabase]harbor.plot_reading.reading_id
    )
    ~mainTable [test::meadowharbor::store::HarborDatabase]harbor.plot_reading
    coverPct: [test::meadowharbor::store::HarborDatabase]harbor.plot_reading.cover_pct,
    grade: [test::meadowharbor::store::HarborDatabase]harbor.plot_reading.grade
  }

  test::meadowharbor::domain::Berth_Reading: Relational
  {
    AssociationMapping
    (
      reading[berth, reading]: [test::meadowharbor::store::HarborDatabase]@Berth_Reading,
      berth[reading, berth]: [test::meadowharbor::store::HarborDatabase]@Berth_Reading
    )
  }
)
