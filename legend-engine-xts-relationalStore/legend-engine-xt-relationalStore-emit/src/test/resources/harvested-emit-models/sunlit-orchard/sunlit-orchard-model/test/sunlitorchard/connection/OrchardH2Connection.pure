###Connection
RelationalDatabaseConnection test::sunlitorchard::connection::OrchardH2Connection
{
  store: test::sunlitorchard::store::OrchardDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists grove;',
      'create schema grove;',
      'create table grove.orchard (orchard_code varchar(12) primary key, orchard_name varchar(120) not null, region varchar(60) not null, hectares double not null);',
      'create table grove.variety (variety_code varchar(12) primary key, common_name varchar(120) not null, rootstock varchar(60) not null);',
      'create table grove.block (block_code varchar(12) primary key, block_name varchar(120) not null, row_count integer not null, orchard_code varchar(12) not null, variety_code varchar(12) not null);',
      'create table grove.harvest_batch (batch_code varchar(12) primary key, picked_on date not null, crate_count integer not null, block_code varchar(12) not null);',
      'insert into grove.orchard values (\'ORC1\', \'North Terrace Grove\', \'Coastal Ridge\', 12.5);',
      'insert into grove.variety values (\'VAR1\', \'Amber Crisp\', \'Dwarfing\');',
      'insert into grove.block values (\'BLK1\', \'Upper Rows\', 18, \'ORC1\', \'VAR1\');',
      'insert into grove.harvest_batch values (\'HB1\', \'2026-03-14\', 42, \'BLK1\');'
      ];
  };
  auth: DefaultH2;
}
