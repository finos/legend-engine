###Mapping
Mapping test::sunlitorchard::mapping::OrchardBaseMapping
(
  *test::sunlitorchard::domain::Orchard[orchard]: Relational
  {
    ~primaryKey
    (
      [test::sunlitorchard::store::OrchardDB]grove.orchard.orchard_code
    )
    ~mainTable [test::sunlitorchard::store::OrchardDB]grove.orchard
    orchardCode: [test::sunlitorchard::store::OrchardDB]grove.orchard.orchard_code,
    orchardName: [test::sunlitorchard::store::OrchardDB]grove.orchard.orchard_name,
    region: [test::sunlitorchard::store::OrchardDB]grove.orchard.region,
    hectares: [test::sunlitorchard::store::OrchardDB]grove.orchard.hectares
  }

  *test::sunlitorchard::domain::Variety[variety]: Relational
  {
    ~primaryKey
    (
      [test::sunlitorchard::store::OrchardDB]grove.variety.variety_code
    )
    ~mainTable [test::sunlitorchard::store::OrchardDB]grove.variety
    varietyCode: [test::sunlitorchard::store::OrchardDB]grove.variety.variety_code,
    commonName: [test::sunlitorchard::store::OrchardDB]grove.variety.common_name,
    rootstock: [test::sunlitorchard::store::OrchardDB]grove.variety.rootstock
  }

  testSuites:
  [
    orchardBaseSuite:
    {
      function: |test::sunlitorchard::domain::Orchard.all()->project(
  [
    o|$o.orchardName,
    o|$o.region
  ],
  [
    'Orchard',
    'Region'
  ]
);
      tests:
      [
        orchardRows:
        {
          doc: 'Projects the root-table columns of the included base mapping.';
          data:
          [
            test::sunlitorchard::store::OrchardDB:
              Relational
              #{
                grove.orchard:
                  'orchard_code,orchard_name,region,hectares\n'+
                  'ORC1,North Terrace Grove,Coastal Ridge,12.5\n';
              }#
          ];
          asserts:
          [
            oneOrchard:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Orchard":"North Terrace Grove","Region":"Coastal Ridge"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
