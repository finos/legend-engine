import test::sunlitorchard::source::*;

Class test::sunlitorchard::source::GaugeSite
{
  siteLabel: String[1];
  elevationMetres: Integer[1];
}

Class test::sunlitorchard::source::InboundGaugeDocument
{
  documentRef: String[1];
  depthCm: Integer[1];
  moisture: Float[1];
  site: GaugeSite[1];
}

Class test::sunlitorchard::source::InboundGradeDocument
{
  documentRef: String[1];
  grade: String[1];
  crates: Integer[1];
}
