import test::sunlitorchard::domain::*;

Class test::sunlitorchard::domain::Orchard
{
  orchardCode: String[1];
  orchardName: String[1];
  region: String[1];
  hectares: Float[1];
}

Class test::sunlitorchard::domain::Block
{
  blockCode: String[1];
  blockName: String[1];
  rowCount: Integer[1];
}

Class test::sunlitorchard::domain::Variety
{
  varietyCode: String[1];
  commonName: String[1];
  rootstock: String[1];
}

Class test::sunlitorchard::domain::HarvestBatch
{
  batchCode: String[1];
  pickedOn: StrictDate[1];
  crateCount: Integer[1];
}

Association test::sunlitorchard::domain::Orchard_Block
{
  orchard: Orchard[1];
  blocks: Block[*];
}

Association test::sunlitorchard::domain::Block_Variety
{
  variety: Variety[1];
  plantedBlocks: Block[*];
}

Association test::sunlitorchard::domain::Block_HarvestBatch
{
  block: Block[1];
  harvestBatches: HarvestBatch[*];
}
