###Mapping
Mapping test::sunlitorchard::mapping::GaugeToMoistureM2M
(
  *test::sunlitorchard::domain::MoistureReading: Pure
  {
    ~src test::sunlitorchard::source::InboundGaugeDocument
    readingCode: $src.documentRef,
    probeDepthCentimetres: $src.depthCm,
    moisturePercent: $src.moisture,
    siteName: $src.site.siteLabel
  }

  testSuites:
  [
    moistureSuite:
    {
      function: |test::sunlitorchard::domain::MoistureReading.all()->graphFetch(
  #{
    test::sunlitorchard::domain::MoistureReading{
      readingCode,
      probeDepthCentimetres,
      moisturePercent,
      siteName
    }
  }#
)->serialize(
  #{
    test::sunlitorchard::domain::MoistureReading{
      readingCode,
      probeDepthCentimetres,
      moisturePercent,
      siteName
    }
  }#
);
      tests:
      [
        nestedSiteRead:
        {
          doc: 'Transforms one inbound gauge document, reaching through its nested site property for the site name.';
          data:
          [
            ModelStore:
              ModelStore
              #{
                test::sunlitorchard::source::InboundGaugeDocument:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"documentRef":"GD-0001","depthCm":30,"moisture":24.5,"site":{"siteLabel":"Upper Rows","elevationMetres":140}}';
                  }#
              }#
          ];
          asserts:
          [
            mappedReading:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"readingCode":"GD-0001","probeDepthCentimetres":30,"moisturePercent":24.5,"siteName":"Upper Rows"}';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
