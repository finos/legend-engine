###Mapping
Mapping test::sunlitorchard::mapping::GradeSummaryM2M
(
  *test::sunlitorchard::domain::GradeSummary: Pure
  {
    ~src test::sunlitorchard::source::InboundGradeDocument
    summaryCode: $src.documentRef,
    gradeLabel: $src.grade,
    crateCount: $src.crates
  }

  testSuites:
  [
    gradeSummarySuite:
    {
      function: |test::sunlitorchard::domain::GradeSummary.all()->graphFetch(
  #{
    test::sunlitorchard::domain::GradeSummary{
      summaryCode,
      gradeLabel,
      crateCount
    }
  }#
)->serialize(
  #{
    test::sunlitorchard::domain::GradeSummary{
      summaryCode,
      gradeLabel,
      crateCount
    }
  }#
);
      tests:
      [
        gradeRead:
        {
          doc: 'Projects a single grade property out of an inbound grading document.';
          data:
          [
            ModelStore:
              ModelStore
              #{
                test::sunlitorchard::source::InboundGradeDocument:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"documentRef":"GR-0001","grade":"Premium","crates":42}';
                  }#
              }#
          ];
          asserts:
          [
            mappedSummary:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"summaryCode":"GR-0001","gradeLabel":"Premium","crateCount":42}';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
