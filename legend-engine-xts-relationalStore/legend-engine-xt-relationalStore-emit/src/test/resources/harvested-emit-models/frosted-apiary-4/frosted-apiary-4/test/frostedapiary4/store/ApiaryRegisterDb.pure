###Relational
Database test::frostedapiary4::store::ApiaryRegisterDb
(
  Schema apiary
  (
    Table hive
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )

      hive_id INTEGER PRIMARY KEY,
      hive_name VARCHAR(120) NOT NULL,
      forage_zone VARCHAR(32) NOT NULL,
      frame_count INTEGER NOT NULL,
      queen_tag VARCHAR(32),
      audit_note VARCHAR(200),
      in_z TIMESTAMP NOT NULL,
      out_z TIMESTAMP NOT NULL
    )

    Table hive_visit
    (
      visit_id INTEGER PRIMARY KEY,
      hive_id INTEGER NOT NULL,
      visit_kind VARCHAR(32) NOT NULL,
      visit_date DATE NOT NULL
    )
  )

  Join Hive_Visit
  (
    apiary.hive.hive_id = apiary.hive_visit.hive_id
  )
)
