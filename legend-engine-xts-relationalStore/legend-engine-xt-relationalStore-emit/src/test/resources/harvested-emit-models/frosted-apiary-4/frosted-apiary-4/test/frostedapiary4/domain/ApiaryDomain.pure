import test::frostedapiary4::domain::*;

Class <<temporal.processingtemporal>> {meta::pure::profiles::doc.doc = 'A monitored bee hive in the apiary register, versioned by the instant at which the observation batch reached the register.'} test::frostedapiary4::domain::Hive
{
  hiveId: Integer[1];
  hiveName: String[1];
  forageZone: String[1];
  frameCount: Integer[1];
  queenTag: String[0..1];
  auditNote: String[1];
  visits: Visit[*];
  strengthBand()
  {
    if($this.frameCount >= 20,
       | 'STRONG',
       | if($this.frameCount >= 10,
            | 'BUILDING',
            | 'NUCLEUS'))
  }: String[1];
  zoneLabel()
  {
    $this.forageZone->toLower() + '/' + $this.hiveName
  }: String[1];
}

Class test::frostedapiary4::domain::Visit
{
  visitId: Integer[1];
  visitKind: String[1];
  visitDate: StrictDate[1];
}
