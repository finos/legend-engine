###Relational
Database test::easternapiary::store::ForageDatabase
(
  Schema FORAGE
  (
    Table FORAGE_SITE
    (
      SITE_CODE VARCHAR(20) PRIMARY KEY,
      SITE_NAME VARCHAR(200) NOT NULL,
      COUNTY VARCHAR(60) NOT NULL
    )
    Table HIVE_COLONY
    (
      COLONY_CODE VARCHAR(20) PRIMARY KEY,
      SITE_CODE VARCHAR(20) NOT NULL,
      FRAME_COUNT INTEGER NOT NULL
    )
  )

  Join ForageSite_HiveColony(FORAGE.HIVE_COLONY.SITE_CODE = FORAGE.FORAGE_SITE.SITE_CODE)
)
