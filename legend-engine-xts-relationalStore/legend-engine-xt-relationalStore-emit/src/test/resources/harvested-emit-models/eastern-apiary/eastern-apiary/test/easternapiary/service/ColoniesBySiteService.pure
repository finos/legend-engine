###Service
Service test::easternapiary::service::ColoniesBySiteService
{
  pattern: '/forage/v1/colonies/{county}/{colonyCode}';
  owners:
  [
    'example-forage-survey-team'
  ];
  documentation: 'Lists a colony placement by county and colony code, projecting the site attributes reached through the colony-to-site join.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {county: String[1], colonyCode: String[1]|test::easternapiary::domain::HiveColony.all()->filter(
      c|($c.site.county == $county) && ($c.colonyCode == $colonyCode)
    )->project(
      [
        x|$x.colonyCode,
        x|$x.site.siteName,
        x|$x.frameCount
      ],
      [
        'Colony',
        'Site',
        'Frames'
      ]
    )};
    mapping: test::easternapiary::mapping::ForageMapping;
    runtime: test::easternapiary::runtime::ForageRuntime;
  }
  testSuites:
  [
    colonyLookupSuite:
    {
      data:
      [
        connections:
        [
          forageConnection:
            Relational
            #{
              FORAGE.FORAGE_SITE:
                'SITE_CODE,SITE_NAME,COUNTY\n'+
                'FS-1,Willow Bend,Ulster\n'+
                'FS-2,Cedar Hollow,Greene\n';

              FORAGE.HIVE_COLONY:
                'COLONY_CODE,SITE_CODE,FRAME_COUNT\n'+
                'HC-1,FS-1,10\n'+
                'HC-2,FS-1,8\n'+
                'HC-3,FS-2,12\n';
            }#
        ]
      ]
      tests:
      [
        bothConjunctsSatisfied:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            county = 'Ulster',
            colonyCode = 'HC-2'
          ]
          asserts:
          [
            singleMatch:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[ {\n  "Colony" : "HC-2",\n  "Site" : "Willow Bend",\n  "Frames" : 8\n} ]';
                  }#;
              }#
          ]
        },
        countyConjunctFails:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            county = 'Greene',
            colonyCode = 'HC-2'
          ]
          asserts:
          [
            noMatch:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[ ]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
