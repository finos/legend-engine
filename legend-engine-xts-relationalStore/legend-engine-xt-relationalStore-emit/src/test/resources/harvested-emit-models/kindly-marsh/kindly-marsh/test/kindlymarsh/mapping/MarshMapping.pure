###Mapping
Mapping test::kindlymarsh::mapping::MarshMapping
(
  *test::kindlymarsh::domain::BirdCount[bird]: Relational
  {
    ~primaryKey ([test::kindlymarsh::store::MarshDb]WETLAND.BIRD_COUNT.COUNT_ID)
    ~mainTable [test::kindlymarsh::store::MarshDb]WETLAND.BIRD_COUNT
    birdCode: [test::kindlymarsh::store::MarshDb]WETLAND.BIRD_COUNT.BIRD_CODE,
    countedOn: [test::kindlymarsh::store::MarshDb]WETLAND.BIRD_COUNT.COUNTED_ON,
    flockSize: [test::kindlymarsh::store::MarshDb]WETLAND.BIRD_COUNT.FLOCK_SIZE,
    wingSpan: [test::kindlymarsh::store::MarshDb]WETLAND.BIRD_COUNT.WING_SPAN
  }
  *test::kindlymarsh::domain::Observer[observer]: Relational
  {
    ~primaryKey ([test::kindlymarsh::store::MarshDb]WETLAND.OBSERVER.OBSERVER_ID)
    ~mainTable [test::kindlymarsh::store::MarshDb]WETLAND.OBSERVER
    observerCode: [test::kindlymarsh::store::MarshDb]WETLAND.OBSERVER.OBSERVER_CODE,
    observerName: [test::kindlymarsh::store::MarshDb]WETLAND.OBSERVER.OBSERVER_NAME
  }
  testSuites:
  [
    pointInTime:
    {
      function: |test::kindlymarsh::domain::BirdCount.all(%2026-06-01)->project(~[Bird: b|$b.birdCode, Size: b|$b.flockSize]);
      tests:
      [
        window:
        {
          data: [test::kindlymarsh::store::MarshDb: Reference #{test::kindlymarsh::data::MarshData}#];
          asserts:
          [
            expected: EqualToJson #{expected: ExternalFormat #{contentType: 'application/json'; data: '[{"Bird":"HER-101","Size":7}]';}#;}#
          ];
        }
      ];
    }
  ]
)
