###Relational
Database test::kindlymarsh::store::MarshDb
(
  Schema WETLAND
  (
    Table BIRD_COUNT
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      COUNT_ID INTEGER PRIMARY KEY,
      BIRD_CODE VARCHAR(24) NOT NULL,
      COUNTED_ON DATE NOT NULL,
      FLOCK_SIZE INTEGER NOT NULL,
      WING_SPAN FLOAT NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL,
      LAKE_IN_ID INTEGER NOT NULL,
      LAKE_OUT_ID INTEGER NOT NULL,
      OBSERVER_ID INTEGER NOT NULL
    )
    Table OBSERVER
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      OBSERVER_ID INTEGER PRIMARY KEY,
      OBSERVER_CODE VARCHAR(24) NOT NULL,
      OBSERVER_NAME VARCHAR(64) NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
  )
)
