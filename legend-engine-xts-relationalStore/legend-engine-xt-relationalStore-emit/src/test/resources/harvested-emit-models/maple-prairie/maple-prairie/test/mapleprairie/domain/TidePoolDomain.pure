###Pure
import demo::mapleprairie::domain::*;

Class {meta::pure::profiles::doc.doc = 'A surveyed rocky-shore quadrat with its algal cover and water readings, recorded by a polymorphic survey recorder.'} demo::mapleprairie::domain::PoolQuadrat
{
  quadratRef: String[1];
  shoreZone: String[1];
  tidePhase: String[1];
  transectName: String[1];
  algaCoverPct: Float[1];
  waterTempC: Float[1];
  salinityPsu: Float[1];
  recorder: SurveyRecorder[0..1];
}

Class {meta::pure::profiles::doc.doc = 'Whoever recorded a quadrat, known only by name at this level of the hierarchy.'} demo::mapleprairie::domain::SurveyRecorder
{
  recorderName: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A recorder holding a shore-survey accreditation, adding the accreditation code and the holdfast tally only trained recorders report.'} demo::mapleprairie::domain::AccreditedRecorder extends SurveyRecorder
{
  accreditationCode: String[1];
  holdfastCount: Integer[1];
}
