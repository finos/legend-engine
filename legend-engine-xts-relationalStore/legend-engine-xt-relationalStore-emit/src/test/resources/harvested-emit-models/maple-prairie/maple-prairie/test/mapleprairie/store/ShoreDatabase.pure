###Relational
Database demo::mapleprairie::store::ShoreDatabase
(
  Schema shore
  (
    Table quadrat
    (
      quadrat_ref VARCHAR(20) PRIMARY KEY,
      shore_zone VARCHAR(30) NOT NULL,
      tide_phase VARCHAR(20) NOT NULL,
      transect_name VARCHAR(60) NOT NULL,
      alga_cover_pct DOUBLE NOT NULL,
      water_temp_c DOUBLE NOT NULL,
      salinity_psu DOUBLE NOT NULL,
      recorder_ref VARCHAR(20)
    )
    Table recorder
    (
      recorder_ref VARCHAR(20) PRIMARY KEY,
      recorder_name VARCHAR(60) NOT NULL,
      recorder_kind VARCHAR(20) NOT NULL,
      accreditation_code VARCHAR(20),
      holdfast_count INTEGER
    )
  )

  Join Quadrat_Recorder(shore.quadrat.recorder_ref = shore.recorder.recorder_ref)
)
