###Service
Service demo::mapleprairie::service::QuadratCover
{
  pattern: '/mapleprairie/v1/quadrat-cover/{tidePhase}';
  ownership: UserList { users: ['shore-survey-desk'] };
  documentation: 'Returns the surveyed quadrats of the recognised shore zones for one tide phase, guarded by a compound membership-and-equality predicate and projected as a relation whose recorder columns are reachable only by narrowing the polymorphic recorder to its accredited subtype.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: {tidePhase: String[1]|demo::mapleprairie::domain::PoolQuadrat.all()->filter(
      q|($q.shoreZone->in(['UPPER_SHORE', 'MID_SHORE', 'LOW_SHORE', 'SPLASH_ZONE', 'SUBTIDAL_FRINGE'])) && ($q.tidePhase == $tidePhase)
    )->project(
      ~[
        Quadrat: q|$q.quadratRef,
        Zone: q|$q.shoreZone,
        Transect: q|$q.transectName,
        Phase: q|$q.tidePhase,
        ZoneLabel: q|$q.shoreZone->toUpper() + '/' + $q.transectName->toLower(),
        CoverPct: q|$q.algaCoverPct,
        CoverBand: q|($q.algaCoverPct / 10.0)->floor(),
        TempC: q|$q.waterTempC,
        Salinity: q|$q.salinityPsu,
        Recorder: q|$q.recorder->toOne().recorderName,
        Accreditation: q|$q.recorder->toOne()->subType(@demo::mapleprairie::domain::AccreditedRecorder).accreditationCode,
        Holdfasts: q|$q.recorder->toOne()->subType(@demo::mapleprairie::domain::AccreditedRecorder).holdfastCount
      ]
    )->sort(~Quadrat->ascending())};
    mapping: demo::mapleprairie::mapping::ShoreQuadratMapping;
    runtime: demo::mapleprairie::runtime::TidePoolRuntime;
  }
  testSuites:
  [
    quadratCoverSuite:
    {
      data:
      [
        connections:
        [
          shoreConnection:
            Relational
            #{
              shore.recorder:
                'recorder_ref,recorder_name,recorder_kind,accreditation_code,holdfast_count\n'+
                'REC-1,Nia Foreshore,accredited,SHORE-A2,7\n'+
                'REC-2,Owen Kelp,accredited,SHORE-B1,2\n'+
                'REC-3,Ines Wrack,accredited,SHORE-A1,5\n';

              shore.quadrat:
                'quadrat_ref,shore_zone,tide_phase,transect_name,alga_cover_pct,water_temp_c,salinity_psu,recorder_ref\n'+
                'Q-01,MID_SHORE,SPRING_LOW,North Ledge,62.5,12.4,34.2,REC-1\n'+
                'Q-02,HARBOUR_WALL,SPRING_LOW,East Steps,18.0,13.1,33.8,REC-2\n'+
                'Q-03,LOW_SHORE,NEAP_HIGH,South Gully,47.25,11.8,34.6,REC-3\n';
            }#
        ]
      ]
      tests:
      [
        springLowRecognisedZones:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            tidePhase = 'SPRING_LOW'
          ]
          asserts:
          [
            onlyTheRecognisedZoneQuadrat:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Quadrat":"Q-01","Zone":"MID_SHORE","Transect":"North Ledge","Phase":"SPRING_LOW","ZoneLabel":"MID_SHORE/north ledge","CoverPct":62.5,"CoverBand":6,"TempC":12.4,"Salinity":34.2,"Recorder":"Nia Foreshore","Accreditation":"SHORE-A2","Holdfasts":7}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
