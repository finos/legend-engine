###Mapping
Mapping demo::mapleprairie::mapping::ShoreQuadratMapping
(
  demo::mapleprairie::domain::PoolQuadrat[poolQuadrat]: Relational
  {
    ~primaryKey
    (
      [demo::mapleprairie::store::ShoreDatabase]shore.quadrat.quadrat_ref
    )
    ~mainTable [demo::mapleprairie::store::ShoreDatabase]shore.quadrat
    quadratRef: [demo::mapleprairie::store::ShoreDatabase]shore.quadrat.quadrat_ref,
    shoreZone: [demo::mapleprairie::store::ShoreDatabase]shore.quadrat.shore_zone,
    tidePhase: [demo::mapleprairie::store::ShoreDatabase]shore.quadrat.tide_phase,
    transectName: [demo::mapleprairie::store::ShoreDatabase]shore.quadrat.transect_name,
    algaCoverPct: [demo::mapleprairie::store::ShoreDatabase]shore.quadrat.alga_cover_pct,
    waterTempC: [demo::mapleprairie::store::ShoreDatabase]shore.quadrat.water_temp_c,
    salinityPsu: [demo::mapleprairie::store::ShoreDatabase]shore.quadrat.salinity_psu,
    recorder[accreditedRecorder]: [demo::mapleprairie::store::ShoreDatabase]@Quadrat_Recorder
  }

  demo::mapleprairie::domain::SurveyRecorder[surveyRecorder]: Relational
  {
    ~primaryKey
    (
      [demo::mapleprairie::store::ShoreDatabase]shore.recorder.recorder_ref
    )
    ~mainTable [demo::mapleprairie::store::ShoreDatabase]shore.recorder
    recorderName: [demo::mapleprairie::store::ShoreDatabase]shore.recorder.recorder_name
  }

  demo::mapleprairie::domain::AccreditedRecorder[accreditedRecorder] extends [surveyRecorder]: Relational
  {
    ~primaryKey
    (
      [demo::mapleprairie::store::ShoreDatabase]shore.recorder.recorder_ref
    )
    ~mainTable [demo::mapleprairie::store::ShoreDatabase]shore.recorder
    accreditationCode: [demo::mapleprairie::store::ShoreDatabase]shore.recorder.accreditation_code,
    holdfastCount: [demo::mapleprairie::store::ShoreDatabase]shore.recorder.holdfast_count
  }
)
