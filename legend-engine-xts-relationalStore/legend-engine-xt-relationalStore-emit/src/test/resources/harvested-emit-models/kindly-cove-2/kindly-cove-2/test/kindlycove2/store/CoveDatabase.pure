###Relational
Database test::kindlycove2::store::CoveDatabase
(
  Schema cove
  (
    Table survey_plot
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      plot_id INTEGER PRIMARY KEY,
      plot_code VARCHAR(30) NOT NULL,
      cove_name VARCHAR(80) NOT NULL,
      ranger_id INTEGER NOT NULL,
      zone_code VARCHAR(20) NOT NULL,
      opened_on DATE NOT NULL,
      visitor_capacity INTEGER NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )

    Table patrol_visit
    (
      visit_id INTEGER PRIMARY KEY,
      plot_id INTEGER NOT NULL,
      visit_code VARCHAR(30) NOT NULL,
      visited_on DATE NOT NULL,
      ranger_note VARCHAR(120)
    )

    Table visitor_tally
    (
      tally_id INTEGER PRIMARY KEY,
      plot_id INTEGER NOT NULL,
      tally_date DATE NOT NULL,
      visitor_count INTEGER NOT NULL
    )
  )

  Join Plot_Visit
  (
    cove.survey_plot.plot_id = cove.patrol_visit.plot_id
  )

  Join Plot_Tally
  (
    cove.survey_plot.plot_id = cove.visitor_tally.plot_id
  )
)
