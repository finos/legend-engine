###Connection
RelationalDatabaseConnection test::duskylantern2::connection::LampH2Connection
{
  store: test::duskylantern2::store::LampDb;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists lighting;',
      'drop schema if exists survey;',
      'create schema lighting;',
      'create schema survey;',
      'create table lighting.lamp_post (lamp_code varchar(16) primary key, lamp_label varchar(64) not null, district_code varchar(16) not null, lamp_kind varchar(24) not null, retired_flag varchar(12) not null);',
      'create table survey.lamp_visit (visit_code varchar(16) primary key, lamp_code varchar(16) not null, visited_on date not null, walker_label varchar(64) not null, lumen_reading integer not null, visit_note varchar(128));'
      ];
  };
  auth: DefaultH2;
}
