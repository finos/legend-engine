###Relational
Database test::duskylantern2::store::LampDb
(
  Schema lighting
  (
    Table lamp_post
    (
      lamp_code VARCHAR(16) PRIMARY KEY,
      lamp_label VARCHAR(64) NOT NULL,
      district_code VARCHAR(16) NOT NULL,
      lamp_kind VARCHAR(24) NOT NULL,
      retired_flag VARCHAR(12) NOT NULL
    )
  )

  Schema survey
  (
    Table lamp_visit
    (
      visit_code VARCHAR(16) PRIMARY KEY,
      lamp_code VARCHAR(16) NOT NULL,
      visited_on DATE NOT NULL,
      walker_label VARCHAR(64) NOT NULL,
      lumen_reading INTEGER NOT NULL,
      visit_note VARCHAR(128)
    )
  )

  Join Visit_Lamp(survey.lamp_visit.lamp_code = lighting.lamp_post.lamp_code)
)
