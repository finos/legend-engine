###Pure
import test::duskylantern2::domain::*;

Class {meta::pure::profiles::doc.doc = 'A street lantern held on the parks lighting register, kept in the lighting schema.'} test::duskylantern2::domain::LampPost
{
  lampCode: String[1];
  lampLabel: String[1];
  districtCode: String[1];
  lampKind: String[1];
  retiredFlag: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A night walk visit to one lantern, kept in the survey schema, whose lantern attributes are reached across the schema boundary.'} test::duskylantern2::domain::LampVisit
{
  visitCode: String[1];
  visitedOn: StrictDate[1];
  walkerLabel: String[1];
  lumenReading: Integer[1];
  visitNote: String[0..1];
  lampLabel: String[1];
  districtCode: String[1];
  lampKind: String[1];
  retiredFlag: String[1];
}
