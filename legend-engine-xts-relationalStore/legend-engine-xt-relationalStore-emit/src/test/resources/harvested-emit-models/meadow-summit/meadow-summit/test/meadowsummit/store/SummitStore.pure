###Relational
Database test::meadowsummit::store::SummitStore
(
  Schema trail
  (
    Table trail_segment
    (
      segment_id INTEGER PRIMARY KEY,
      segment_code VARCHAR(16) NOT NULL,
      segment_name VARCHAR(64) NOT NULL,
      grade_code VARCHAR(8) NOT NULL,
      surface_code VARCHAR(8),
      length_m INTEGER NOT NULL,
      waypoint_note VARCHAR(128)
    )

    Table maintenance_visit
    (
      visit_id INTEGER PRIMARY KEY,
      segment_id INTEGER NOT NULL,
      crew_id INTEGER NOT NULL,
      visit_kind_code VARCHAR(8) NOT NULL,
      work_hours DOUBLE NOT NULL,
      visit_note VARCHAR(128)
    )

    Table crew_roster
    (
      crew_id INTEGER PRIMARY KEY,
      crew_name VARCHAR(64) NOT NULL,
      depot_code VARCHAR(16) NOT NULL
    )

    Table depot_register
    (
      depot_code VARCHAR(16) PRIMARY KEY,
      depot_name VARCHAR(64) NOT NULL
    )

    View segment_visit_summary
    (
      ~groupBy (trail.maintenance_visit.segment_id)
      segment_id: trail.maintenance_visit.segment_id PRIMARY KEY,
      visit_count: count(trail.maintenance_visit.visit_id),
      total_hours: sum(trail.maintenance_visit.work_hours)
    )
  )

  Schema terrain
  (
    Table slope_grade
    (
      grade_code VARCHAR(8) PRIMARY KEY,
      grade_label VARCHAR(64) NOT NULL,
      terrain_kind VARCHAR(16) NOT NULL
    )
  )

  Join Segment_Visit(trail.trail_segment.segment_id = trail.maintenance_visit.segment_id)

  Join Visit_Crew(trail.maintenance_visit.crew_id = trail.crew_roster.crew_id)

  Join Crew_Depot(trail.crew_roster.depot_code = trail.depot_register.depot_code)

  Join Segment_Grade(trail.trail_segment.grade_code = terrain.slope_grade.grade_code)

  Join Summary_Segment(trail.segment_visit_summary.segment_id = trail.trail_segment.segment_id)
)
