###Runtime
Runtime test::meadowsummit::runtime::SummitRuntime
{
  mappings:
  [
    test::meadowsummit::mapping::SummitMapping
  ];
  connections:
  [
    test::meadowsummit::store::SummitStore:
    [
      summitConnection: test::meadowsummit::connection::SummitH2Connection
    ]
  ];
}

Runtime test::meadowsummit::runtime::SummitReliefRuntime
{
  mappings:
  [
    test::meadowsummit::mapping::SummitMapping
  ];
  connections:
  [
    test::meadowsummit::store::SummitStore:
    [
      summitReliefConnection: test::meadowsummit::connection::SummitH2Connection
    ]
  ];
}
