import test::amberreef::domain::*;

Class test::amberreef::domain::Observation
{
  observationRef: String[1];
  taxonName: String[1];
  individualsCounted: Integer[1];
  method: SurveyMethod[1];
  severity: BleachingSeverity[0..1];
}

Class test::amberreef::domain::Station
{
  stationRef: String[1];
  stationName: String[1];
  depthMetres: Float[1];
}

Class test::amberreef::domain::Diver
{
  diverRef: String[1];
  fullName: String[1];
}

Association test::amberreef::domain::SurveyRecord_Observation
{
  survey: SurveyRecord[1];
  observations: Observation[*];
}

Association test::amberreef::domain::Station_SurveyRecord
{
  station: Station[1];
  surveys: SurveyRecord[*];
}

Association test::amberreef::domain::CoralSurvey_Diver
{
  coralSurvey: CoralSurvey[0..1];
  divers: Diver[*];
}
