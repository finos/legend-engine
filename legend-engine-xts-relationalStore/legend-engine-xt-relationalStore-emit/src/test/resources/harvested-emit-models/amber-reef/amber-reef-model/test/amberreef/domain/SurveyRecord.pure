import test::amberreef::domain::*;

Class <<ReefProfile.abstractRoot, temporal.businesstemporal>> {ReefProfile.notes = 'Root of the reef survey lattice; subtypes add gear-specific detail.'} test::amberreef::domain::SurveyRecord
[
  coverageWithinBounds
  (
    ~function: $this.coveragePercent->isEmpty() ||
  (($this.coveragePercent->toOne() >= 0) &&
  ($this.coveragePercent->toOne() <= 100))
    ~enforcementLevel: Error
    ~message: 'Live coral coverage must be expressed as a percentage between 0 and 100'
  )
]
{
  surveyRef: String[1];
  stationRef: String[1];
  coveragePercent: Integer[0..1];
  bleachingIndex: Integer[0..1];
  conditionBand: String[0..1];
  observedOn: StrictDate[1];
  deepObservations(floor: Integer[1])
  {
    $this.observations->filter(o | $o.individualsCounted > $floor)
  }: Observation[*];
  observationsForMethod(method: SurveyMethod[1])
  {
    $this.observations->filter(o | $o.method == $method)
  }: Observation[*];
  countedIndividuals()
  {
    $this.observations->map(o | $o.individualsCounted)->sum()
  }: Integer[1];
  hasCrowdedQuadrat()
  {
    $this.observations->exists(o | $o.individualsCounted > 40)
  }: Boolean[1];
  provisionalLabel()
  {
    if($this.conditionBand->isEmpty(), | 'unassessed-' + $this.surveyRef, | $this.conditionBand->toOne())
  }: String[1];
}

Class <<ReefProfile.fieldCollected>> test::amberreef::domain::CoralSurvey extends SurveyRecord
{
  transectMetres: Float[1];
  divers: Integer[1];
}

Class <<ReefProfile.provisional>> test::amberreef::domain::PhotoMosaicSurvey extends CoralSurvey
{
  frameCount: Integer[1];
  overlapPercent: Float[1];
}

Class test::amberreef::domain::FishCountSurvey extends SurveyRecord
{
  swimMinutes: Integer[1];
}
