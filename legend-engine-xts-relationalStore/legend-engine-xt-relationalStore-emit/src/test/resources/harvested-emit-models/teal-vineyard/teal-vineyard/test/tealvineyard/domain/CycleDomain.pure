###Pure
import test::tealvineyard::domain::*;

Class {meta::pure::profiles::doc.doc = 'A docking point in a city cycle-share network, sized by the number of stands it holds and banded into a service tier from that size alone.'} test::tealvineyard::domain::DockStation
{
  stationId: Integer[1];
  stationCode: String[1];
  stationName: String[1];
  districtCode: String[1];
  surfaceKind: String[1];
  standCount: Integer[1];
  overrideBand: String[0..1];
  installedOn: StrictDate[1];
  serviceBand()
  {
    if($this.standCount >= 200,
       | 'TIER-HARBOUR',
       | if($this.standCount >= 150,
            | 'TIER-TERMINUS',
            | if($this.standCount >= 120,
                 | 'TIER-PROMENADE',
                 | if($this.standCount >= 90,
                      | 'TIER-MARKET',
                      | if($this.standCount >= 60,
                           | 'TIER-CAMPUS',
                           | if($this.standCount >= 40,
                                | 'TIER-PARKSIDE',
                                | if($this.standCount >= 25,
                                     | 'TIER-LANEWAY',
                                     | if($this.standCount >= 10,
                                          | 'TIER-FOOTBRIDGE',
                                          | $this.overrideBand))))))))
  }: String[0..1];
  installedYear()
  {
    $this.installedOn->year()
  }: Integer[1];
  installedMonth()
  {
    $this.installedOn->monthNumber()
  }: Integer[1];
}

Class {meta::pure::profiles::doc.doc = 'One completed hire on the cycle-share network, recorded against the docking point it started from and the rider category it was booked under.'} test::tealvineyard::domain::JourneyRecord
{
  journeyId: Integer[1];
  journeyCode: String[1];
  stationCode: String[1];
  riderClass: String[1];
  tripKind: String[1];
  durationMinutes: Integer[1];
  startedOn: StrictDate[1];
}
