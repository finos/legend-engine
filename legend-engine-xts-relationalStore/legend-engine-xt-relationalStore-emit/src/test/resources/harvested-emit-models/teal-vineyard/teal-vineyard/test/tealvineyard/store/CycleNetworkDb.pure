###Relational
Database test::tealvineyard::store::CycleNetworkDb
(
  Schema cyclenet
  (
    Table dock_station
    (
      station_id INTEGER PRIMARY KEY,
      station_code VARCHAR(20) NOT NULL,
      station_name VARCHAR(200) NOT NULL,
      district_code VARCHAR(20) NOT NULL,
      surface_kind VARCHAR(30) NOT NULL,
      stand_count INTEGER NOT NULL,
      override_band VARCHAR(30),
      installed_on DATE NOT NULL
    )

    Table journey_record
    (
      journey_id INTEGER PRIMARY KEY,
      journey_code VARCHAR(20) NOT NULL,
      station_code VARCHAR(20) NOT NULL,
      rider_class VARCHAR(30) NOT NULL,
      trip_kind VARCHAR(30) NOT NULL,
      duration_minutes INTEGER NOT NULL,
      started_on DATE NOT NULL
    )
  )
)
