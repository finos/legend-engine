###Mapping
Mapping test::jadeestuary::mapping::EstuaryEnumMapping
(
  test::jadeestuary::domain::PlumageKind: EnumerationMapping PlumageKindMapping
  {
    JUVENILE: ['JUVENILE'],
    IMMATURE: ['IMMATURE'],
    ADULT: ['ADULT'],
    WORN: ['WORN']
  }

  test::jadeestuary::domain::EffortBand: EnumerationMapping EffortBandMapping
  {
    LIGHT: ['LIGHT/DAY', 'LIGHT/DUSK'],
    STEADY: ['STEADY/DAY', 'STEADY/DUSK'],
    HEAVY: ['HEAVY/DAY', 'HEAVY/DUSK']
  }

  test::jadeestuary::domain::MoultStage: EnumerationMapping MoultStageMapping
  {
    PRIMARY_MOULT: ['P/ACTIVE'],
    SECONDARY_MOULT: ['S/ACTIVE'],
    BODY_MOULT: ['B/ACTIVE'],
    NO_MOULT: ['N/NONE']
  }

  test::jadeestuary::domain::LaneGrade: EnumerationMapping LaneGradeMapping
  {
    LANE_OPEN: ['Y/FULL'],
    LANE_PARTIAL: ['Y/PART'],
    LANE_CLOSED: ['N/FULL', 'N/PART']
  }
)
