###Mapping
Mapping test::jadeestuary::mapping::EstuaryBaseMapping
(
  *test::jadeestuary::domain::NetLane[netLane]: Relational
  {
    ~filter [test::jadeestuary::store::EstuaryRegisterDb]OpenLaneFilter
    ~primaryKey
    (
      [test::jadeestuary::store::EstuaryRegisterDb]ringing.net_lane.lane_code
    )
    ~mainTable [test::jadeestuary::store::EstuaryRegisterDb]ringing.net_lane
    laneCode: [test::jadeestuary::store::EstuaryRegisterDb]ringing.net_lane.lane_code,
    laneName: [test::jadeestuary::store::EstuaryRegisterDb]ringing.net_lane.lane_name,
    mesh() Inline[laneMesh]
  }

  test::jadeestuary::domain::LaneMesh[laneMesh]: Relational
  {
    ~primaryKey
    (
      [test::jadeestuary::store::EstuaryRegisterDb]ringing.net_lane.lane_code
    )
    ~mainTable [test::jadeestuary::store::EstuaryRegisterDb]ringing.net_lane
    meshCode: [test::jadeestuary::store::EstuaryRegisterDb]ringing.net_lane.mesh_code,
    meshLabel: [test::jadeestuary::store::EstuaryRegisterDb]ringing.net_lane.mesh_label
  }

  *test::jadeestuary::domain::RingHolder[ringHolder]: Relational
  {
    ~primaryKey
    (
      [test::jadeestuary::store::EstuaryRegisterDb]ringing.ring_holder.holder_code
    )
    ~mainTable [test::jadeestuary::store::EstuaryRegisterDb]ringing.ring_holder
    holderCode: [test::jadeestuary::store::EstuaryRegisterDb]ringing.ring_holder.holder_code,
    holderName: [test::jadeestuary::store::EstuaryRegisterDb]ringing.ring_holder.holder_name
  }

  test::jadeestuary::domain::CertifiedHolder[certifiedHolder] extends [ringHolder]: Relational
  {
    ~primaryKey
    (
      [test::jadeestuary::store::EstuaryRegisterDb]ringing.ring_holder.holder_code
    )
    ~mainTable [test::jadeestuary::store::EstuaryRegisterDb]ringing.ring_holder
    permitGrade: [test::jadeestuary::store::EstuaryRegisterDb]@Holder_Permit | [test::jadeestuary::store::EstuaryRegisterDb]ringing.holder_permit.permit_grade,
    issuedOn: [test::jadeestuary::store::EstuaryRegisterDb]@Holder_Permit | [test::jadeestuary::store::EstuaryRegisterDb]ringing.holder_permit.issued_on
  }
)
