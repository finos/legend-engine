###Relational
Database test::tealreef2::store::NetworkDb
(
  Schema network
  (
    Table zone_register
    (
      zone_number INTEGER PRIMARY KEY,
      zone_name VARCHAR(64) NOT NULL,
      district VARCHAR(48) NOT NULL,
      patrol_day VARCHAR(12)
    )

    Table pump_station
    (
      station_code VARCHAR(12) PRIMARY KEY,
      station_name VARCHAR(64) NOT NULL,
      district VARCHAR(48) NOT NULL,
      headroom_m3 DOUBLE
    )
  )
)
