###Relational
Database test::scarletmarsh::store::OrchardCoreDB
(
  include test::scarletmarsh::store::KeeperRefDB

  Schema orchard
  (
    Table plot
    (
      plot_code VARCHAR(24) PRIMARY KEY,
      plot_label VARCHAR(120) NOT NULL,
      district VARCHAR(60) NOT NULL,
      plot_state VARCHAR(16) NOT NULL,
      parent_plot_code VARCHAR(24)
    )

    Table graft_log
    (
      graft_code VARCHAR(24) PRIMARY KEY,
      plot_code VARCHAR(24) NOT NULL,
      variety_code VARCHAR(24) NOT NULL,
      rootstock VARCHAR(40) NOT NULL,
      keeper_code VARCHAR(16),
      grade_code VARCHAR(16),
      graft_status VARCHAR(16) NOT NULL,
      grafted_on DATE NOT NULL,
      survival_score INTEGER NOT NULL
    )
  )

  Schema reference
  (
    Table variety
    (
      variety_code VARCHAR(24) PRIMARY KEY,
      variety_name VARCHAR(120) NOT NULL,
      ripening VARCHAR(16)
    )
  )

  Join Graft_Plot(orchard.graft_log.plot_code = orchard.plot.plot_code)

  Join Graft_Variety(orchard.graft_log.variety_code = reference.variety.variety_code)

  Join Graft_Keeper(orchard.graft_log.keeper_code = keeper.keeper_record.keeper_code)

  Join Plot_Parent(orchard.plot.parent_plot_code = {target}.plot_code)

  Filter LivePlots(orchard.plot.plot_state = 'LIVE')
)
