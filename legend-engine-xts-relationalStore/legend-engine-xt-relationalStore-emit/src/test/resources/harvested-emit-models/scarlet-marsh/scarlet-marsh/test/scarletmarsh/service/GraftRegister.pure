###Service
Service test::scarletmarsh::service::GraftRegister
{
  pattern: '/orchard/v1/graft-register/{minScore}';
  title: 'Community Orchard - Graft Register';
  documentation: 'Graft register for an optional status guard and a survival-score floor, narrowed to grafts whose keeper is on the paid rota, ordered by graft code and capped.';
  autoActivateUpdates: true;
  owners:
  [
    'community-orchard',
    'orchard-propagation'
  ];
  execution: Single
  {
    query: {statuses: String[*], minScore: Integer[1]|test::scarletmarsh::domain::GraftLog.all()->filter(
      g|(($statuses->isEmpty()) || ($g.graftStatus->in($statuses))) && (($g.survivalScore >= $minScore) && ($g.keeper->subType(@test::scarletmarsh::domain::RotaKeeper).rotaCode->isNotEmpty()))
    )->project(
      [
        g|$g.graftCode,
        g|$g.plotLabel,
        g|$g.varietyName,
        g|$g.survivalScore,
        g|$g.keeper.keeperName,
        g|$g.keeper->subType(@test::scarletmarsh::domain::RotaKeeper).rotaCode
      ],
      [
        'Graft/Code',
        'Graft/Plot',
        'Graft/Variety',
        'Graft/Score',
        'Keeper/Name',
        'Keeper/Rota'
      ]
    )->sort(
      [
        asc('Graft/Code')
      ]
    )->limit(10)};
    mapping: test::scarletmarsh::mapping::OrchardCrossMapping;
    runtime: test::scarletmarsh::runtime::OrchardCrossRuntime;
  }
  testSuites:
  [
    graftRegisterSuite:
    {
      data:
      [
        connections:
        [
          orchardConnection:
            Relational
            #{
              keeper.keeper_record:
                'keeper_code,keeper_name,keeper_kind,rota_code,badge_expiry,guild_name\n'+
                'K-1,Ada Fern,ROTA,R-1001,2027-04-30,\n'+
                'K-2,Bram Holt,GUILD,,,Hollow Lane Growers\n'+
                'K-3,Cleo Rand,ROTA,R-1002,2026-11-30,\n';
              orchard.plot:
                'plot_code,plot_label,district,plot_state,parent_plot_code\n'+
                'P-1,Riverbend Row,North,LIVE,\n'+
                'P-2,Kiln Lane Row,East,LIVE,P-1\n'+
                'P-3,Fallow Corner,East,RETIRED,\n';
              reference.variety:
                'variety_code,variety_name,ripening\n'+
                'V-1,Warren Russet,LATE\n'+
                'V-2,Marsh Pippin,EARLY\n';
              orchard.graft_log:
                'graft_code,plot_code,variety_code,rootstock,keeper_code,grade_code,graft_status,grafted_on,survival_score\n'+
                'G-1,P-1,V-1,STOCK-A,K-1,PRIME,ACTIVE,2026-02-01,40\n'+
                'G-2,P-1,V-2,STOCK-B,K-3,STANDARD,ACTIVE,2026-02-03,24\n'+
                'G-3,P-2,V-1,STOCK-A,K-2,WATCH,ACTIVE,2026-02-05,12\n'+
                'G-4,P-3,V-2,STOCK-B,K-1,PRIME,ACTIVE,2026-02-07,30\n';
            }#,
          pickingConnection:
            Relational
            #{
              picking.harvest_ticket:
                'ticket_code,plot_ref,crates,picked_on\n'+
                'T-1,P-1,12,2026-09-01\n';
            }#
        ]
      ]
      tests:
      [
        activeGraftsAboveScoreTwenty:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            statuses = ['ACTIVE'],
            minScore = 20
          ]
          asserts:
          [
            twoRotaKeptGrafts:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Graft/Code":"G-1","Graft/Plot":"Riverbend Row","Graft/Variety":"Warren Russet","Graft/Score":40,"Keeper/Name":"Ada Fern","Keeper/Rota":"R-1001"},{"Graft/Code":"G-2","Graft/Plot":"Riverbend Row","Graft/Variety":"Marsh Pippin","Graft/Score":24,"Keeper/Name":"Cleo Rand","Keeper/Rota":"R-1002"}]';
                  }#;
              }#
          ]
        },
        unguardedStatusesAboveScoreThirty:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            statuses = [],
            minScore = 30
          ]
          asserts:
          [
            oneHighScoringGraft:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Graft/Code":"G-1","Graft/Plot":"Riverbend Row","Graft/Variety":"Warren Russet","Graft/Score":40,"Keeper/Name":"Ada Fern","Keeper/Rota":"R-1001"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
