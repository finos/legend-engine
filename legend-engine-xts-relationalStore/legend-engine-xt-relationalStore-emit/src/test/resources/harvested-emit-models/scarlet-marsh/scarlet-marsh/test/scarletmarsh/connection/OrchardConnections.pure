###Connection
RelationalDatabaseConnection test::scarletmarsh::connection::OrchardConnection
{
  store: test::scarletmarsh::store::OrchardCoreDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists keeper;',
      'drop schema if exists orchard;',
      'drop schema if exists reference;',
      'create schema keeper;',
      'create schema orchard;',
      'create schema reference;',
      'create table keeper.keeper_record (keeper_code varchar(16), keeper_name varchar(120) not null, keeper_kind varchar(16) not null, rota_code varchar(24), badge_expiry date, guild_name varchar(120));',
      'create table orchard.plot (plot_code varchar(24), plot_label varchar(120) not null, district varchar(60) not null, plot_state varchar(16) not null, parent_plot_code varchar(24));',
      'create table orchard.graft_log (graft_code varchar(24), plot_code varchar(24) not null, variety_code varchar(24) not null, rootstock varchar(40) not null, keeper_code varchar(16), grade_code varchar(16), graft_status varchar(16) not null, grafted_on date not null, survival_score integer not null);',
      'create table reference.variety (variety_code varchar(24), variety_name varchar(120) not null, ripening varchar(16));'
      ];
  };
  auth: DefaultH2;
}

RelationalDatabaseConnection test::scarletmarsh::connection::PickingConnection
{
  store: test::scarletmarsh::store::HarvestSideDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists picking;',
      'create schema picking;',
      'create table picking.harvest_ticket (ticket_code varchar(24), plot_ref varchar(24) not null, crates integer not null, picked_on date not null);'
      ];
  };
  auth: DefaultH2;
}
