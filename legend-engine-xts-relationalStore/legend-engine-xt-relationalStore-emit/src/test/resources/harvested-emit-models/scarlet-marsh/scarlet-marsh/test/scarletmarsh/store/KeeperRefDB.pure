###Relational
Database test::scarletmarsh::store::KeeperRefDB
(
  Schema keeper
  (
    Table keeper_record
    (
      keeper_code VARCHAR(16) PRIMARY KEY,
      keeper_name VARCHAR(120) NOT NULL,
      keeper_kind VARCHAR(16) NOT NULL,
      rota_code VARCHAR(24),
      badge_expiry DATE,
      guild_name VARCHAR(120)
    )
  )

  Filter RotaKeeperFilter(keeper.keeper_record.keeper_kind = 'ROTA')

  Filter GuildKeeperFilter(keeper.keeper_record.keeper_kind = 'GUILD')
)
