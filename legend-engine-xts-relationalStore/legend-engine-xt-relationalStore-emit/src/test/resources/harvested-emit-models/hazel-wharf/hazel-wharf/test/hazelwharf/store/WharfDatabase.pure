###Relational
Database test::hazelwharf::store::WharfDatabase
(
  Schema marine
  (
    Table berth
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z),
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      berth_id INTEGER PRIMARY KEY,
      berth_code VARCHAR(24) NOT NULL,
      berth_label VARCHAR(60) NOT NULL,
      berth_status VARCHAR(24) NOT NULL,
      steward_id INTEGER,
      in_z DATE NOT NULL,
      out_z DATE NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )

    Table mooring_visit
    (
      visit_id INTEGER PRIMARY KEY,
      berth_id INTEGER NOT NULL,
      visit_code VARCHAR(24) NOT NULL,
      visit_kind VARCHAR(24) NOT NULL
    )

    Table sample_lot
    (
      lot_id INTEGER PRIMARY KEY,
      visit_id INTEGER NOT NULL,
      lot_code VARCHAR(24) NOT NULL,
      crate_tag VARCHAR(24)
    )

    Table berth_steward
    (
      steward_id INTEGER PRIMARY KEY,
      steward_name VARCHAR(60) NOT NULL,
      station_id INTEGER NOT NULL
    )

    Table monitoring_station
    (
      station_id INTEGER PRIMARY KEY,
      station_name VARCHAR(60) NOT NULL,
      registry_id INTEGER NOT NULL
    )

    Table station_registry
    (
      registry_id INTEGER PRIMARY KEY,
      registry_code VARCHAR(24) NOT NULL,
      registry_name VARCHAR(60) NOT NULL
    )
  )

  Join Berth_Visit(marine.berth.berth_id = marine.mooring_visit.berth_id)
  Join Visit_Lot(marine.mooring_visit.visit_id = marine.sample_lot.visit_id)
  Join Berth_Steward(marine.berth.steward_id = marine.berth_steward.steward_id)
  Join Steward_Station(marine.berth_steward.station_id = marine.monitoring_station.station_id)
  Join Station_Registry(marine.monitoring_station.registry_id = marine.station_registry.registry_id)
)
