###Pure
import meta::pure::profiles::*;
import test::hazelwharf::domain::*;

Enum {doc.doc = 'The operating condition a berth is held in; the service predicate compares against a member of this enumeration rather than against a string.'} test::hazelwharf::domain::BerthStatus
{
  OPERATIONAL,
  RESTRICTED,
  CLOSED
}

Class <<temporal.bitemporal>> {doc.doc = 'A mooring berth on the research wharf, corrected over processing time and effective over business time, so the service must open both dimensions.'} test::hazelwharf::domain::MooringBerth
{
  berthCode: String[1];
  berthLabel: String[1];
  status: BerthStatus[1];
  visits: MooringVisit[*];
  steward: BerthSteward[0..1];
}

Class {doc.doc = 'One vessel call at a berth; the first collection hop the nested existence test quantifies over.'} test::hazelwharf::domain::MooringVisit
{
  visitCode: String[1];
  visitKind: String[1];
  lots: SampleLot[*];
}

Class {doc.doc = 'A sample lot landed by a visit, whose crate identifier is absent until the lot is crated; the second collection hop, tested for a present identifier.'} test::hazelwharf::domain::SampleLot
{
  lotCode: String[1];
  crateTag: String[0..1];
  visit: MooringVisit[1];
}

Class {doc.doc = 'The steward accountable for a berth; absent for unstewarded berths, which is where the projected registry identifier turns up empty.'} test::hazelwharf::domain::BerthSteward
{
  stewardName: String[1];
  station: MonitoringStation[1];
}

Class {doc.doc = 'The monitoring station a steward reports through; the middle hop of the three-hop projection path.'} test::hazelwharf::domain::MonitoringStation
{
  stationName: String[1];
  registry: StationRegistry[1];
}

Class {doc.doc = 'The registry a monitoring station is listed in; the nested identifier the deep projection column reaches.'} test::hazelwharf::domain::StationRegistry
{
  registryCode: String[1];
  registryName: String[1];
}
