###Pure
Class test::sunlitlagoon2::domain::RawCheckoutRecord
{
  checkoutCode: String[1];
  borrowerCode: String[1];
  itemTitle: String[1];
  statusCode: String[0..1];
  overdueDays: Integer[0..1];
  renewalText: String[0..1];
  channelCodes: String[*];
  programmeTag: String[1];
}

Class test::sunlitlagoon2::domain::RawBorrowerRecord
{
  borrowerCode: String[1];
  displayName: String[1];
  homeBranch: String[0..1];
  membershipTier: String[0..1];
}

Class test::sunlitlagoon2::domain::CirculationView
{
  checkoutCode: String[1];
  titleLabel: String[1];
  borrower: test::sunlitlagoon2::domain::BorrowerSnapshot[0..1];
  circulationBand: String[1];
  renewalCount: Integer[1];
  sourceChannels: String[*];
  branchTag: String[1];
  programmeTag: String[1];
}

Class test::sunlitlagoon2::domain::BorrowerSnapshot
{
  borrowerCode: String[1];
  displayName: String[1];
}
