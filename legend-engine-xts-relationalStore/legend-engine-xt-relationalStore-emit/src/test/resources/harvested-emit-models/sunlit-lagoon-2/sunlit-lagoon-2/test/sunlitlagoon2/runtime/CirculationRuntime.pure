###Runtime
Runtime test::sunlitlagoon2::runtime::CirculationRuntime
{
  mappings:
  [
    test::sunlitlagoon2::mapping::CirculationMapping,
    test::sunlitlagoon2::mapping::LibraryRelationalMapping
  ];
  connections:
  [
    test::sunlitlagoon2::store::BranchCatalogueDb:
    [
      branchCatalogue: test::sunlitlagoon2::store::BranchCatalogueConnection
    ],
    test::sunlitlagoon2::store::CirculationDb:
    [
      circulation: test::sunlitlagoon2::store::CirculationConnection
    ]
  ];
}
