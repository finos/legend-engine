###Mapping
Mapping test::sunlitlagoon2::mapping::LandingRelationalMapping
(
  *test::sunlitlagoon2::domain::RawCheckoutRecord[checkout]: Relational
  {
    ~primaryKey
    (
      [test::sunlitlagoon2::store::BranchCatalogueDb]branches.checkout_register.checkout_code
    )
    ~mainTable [test::sunlitlagoon2::store::BranchCatalogueDb]branches.checkout_register
    checkoutCode: [test::sunlitlagoon2::store::BranchCatalogueDb]branches.checkout_register.checkout_code,
    borrowerCode: [test::sunlitlagoon2::store::BranchCatalogueDb]branches.checkout_register.borrower_code,
    itemTitle: [test::sunlitlagoon2::store::BranchCatalogueDb]branches.checkout_register.item_title,
    statusCode: [test::sunlitlagoon2::store::BranchCatalogueDb]branches.checkout_register.status_code,
    overdueDays: [test::sunlitlagoon2::store::BranchCatalogueDb]branches.checkout_register.overdue_days,
    renewalText: [test::sunlitlagoon2::store::BranchCatalogueDb]branches.checkout_register.renewal_text,
    channelCodes: [test::sunlitlagoon2::store::BranchCatalogueDb]branches.checkout_register.channel_codes
  }

  *test::sunlitlagoon2::domain::RawBorrowerRecord[borrower]: Relational
  {
    ~primaryKey
    (
      [test::sunlitlagoon2::store::CirculationDb]members.borrower_register.borrower_code
    )
    ~mainTable [test::sunlitlagoon2::store::CirculationDb]members.borrower_register
    borrowerCode: [test::sunlitlagoon2::store::CirculationDb]members.borrower_register.borrower_code,
    displayName: [test::sunlitlagoon2::store::CirculationDb]members.borrower_register.display_name,
    homeBranch: [test::sunlitlagoon2::store::CirculationDb]members.borrower_register.home_branch,
    membershipTier: 'COMMUNITY'
  }
)
