###Relational
Database test::sunlitlagoon2::store::BranchCatalogueDb
(
  Schema branches
  (
    Table checkout_register
    (
      checkout_code VARCHAR(40),
      borrower_code VARCHAR(40),
      item_title VARCHAR(160),
      status_code VARCHAR(24),
      overdue_days INTEGER,
      renewal_text VARCHAR(12),
      channel_codes VARCHAR(160)
    )
  )
)

Database test::sunlitlagoon2::store::CirculationDb
(
  Schema members
  (
    Table borrower_register
    (
      borrower_code VARCHAR(40),
      display_name VARCHAR(160),
      home_branch VARCHAR(80),
      membership_tier VARCHAR(30)
    )
  )
)

###Connection
RelationalDatabaseConnection test::sunlitlagoon2::store::BranchCatalogueConnection
{
  store: test::sunlitlagoon2::store::BranchCatalogueDb;
  type: H2;
  specification: LocalH2 { testDataSetupSqls: []; };
  auth: DefaultH2;
}

RelationalDatabaseConnection test::sunlitlagoon2::store::CirculationConnection
{
  store: test::sunlitlagoon2::store::CirculationDb;
  type: H2;
  specification: LocalH2 { testDataSetupSqls: []; };
  auth: DefaultH2;
}
