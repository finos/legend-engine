###Pure
function test::sunlitlagoon2::function::renewalNumber(text: String[0..1]): Integer[1]
{
  if($text->isEmpty() || $text->toOne() == '', |0, |parseInteger($text->toOne()->toString()))
}

function test::sunlitlagoon2::function::titleLabel(title: String[1], code: String[1]): String[1]
{
  $title->toString() + ' [' + $code->toString() + ']'
}
