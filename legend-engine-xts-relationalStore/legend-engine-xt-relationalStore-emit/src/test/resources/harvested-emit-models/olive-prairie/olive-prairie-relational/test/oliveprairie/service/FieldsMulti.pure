###Service
Service test::oliveprairie::service::FieldsMulti
{
  pattern: '/prairie/v1/fields-multi';
  title: 'Prairie - Fields (multi-environment)';
  owners:
  [
    'prairie-platform',
    'grassland-eng'
  ];
  documentation: 'Multi-execution service selecting a region-keyed mapping/runtime binding at execution time and graph-fetching field names.';
  autoActivateUpdates: true;
  execution: Multi
  {
    query: {|test::oliveprairie::domain::Field.all()->graphFetch(
      #{
        test::oliveprairie::domain::Field{
          name,
          region
        }
      }#
    )->serialize(
      #{
        test::oliveprairie::domain::Field{
          name,
          region
        }
      }#
    )};
    key: 'region';
    executions['plains']:
    {
      mapping: test::oliveprairie::mapping::PrairieMapping;
      runtime: test::oliveprairie::runtime::PrairieRuntime;
    }
    executions['valley']:
    {
      mapping: test::oliveprairie::mapping::PrairieMapping;
      runtime: test::oliveprairie::runtime::PrairieRuntime;
    }
  }
}
