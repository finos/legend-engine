###Mapping
Mapping test::oliveprairie::mapping::PrairieMapping
(
  *test::oliveprairie::domain::Field[field]: Relational
  {
    ~primaryKey
    (
      [test::oliveprairie::store::PrairieDB]prairie.field.field_id
    )
    ~mainTable [test::oliveprairie::store::PrairieDB]prairie.field
    fieldId: [test::oliveprairie::store::PrairieDB]prairie.field.field_id,
    name: [test::oliveprairie::store::PrairieDB]prairie.field.name,
    region: [test::oliveprairie::store::PrairieDB]prairie.field.region,
    plots: [test::oliveprairie::store::PrairieDB]@Field_Plot
  }

  *test::oliveprairie::domain::Plot[plot]: Relational
  {
    ~filter [test::oliveprairie::store::PrairieDB]BigPlots
    ~primaryKey
    (
      [test::oliveprairie::store::PrairieDB]prairie.plot.plot_id
    )
    ~mainTable [test::oliveprairie::store::PrairieDB]prairie.plot
    plotId: [test::oliveprairie::store::PrairieDB]prairie.plot.plot_id,
    cropCount: [test::oliveprairie::store::PrairieDB]prairie.plot.crop_count,
    field: [test::oliveprairie::store::PrairieDB]@Field_Plot
  }
)
