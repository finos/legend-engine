Class {meta::pure::profiles::doc.doc = 'A cultivated field within a prairie holding.'} test::oliveprairie::domain::Field
{
  fieldId: Integer[1];
  name: String[1];
  region: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A planted plot inside a field, with a crop count.'} test::oliveprairie::domain::Plot
{
  plotId: Integer[1];
  cropCount: Integer[1];
}

Association test::oliveprairie::domain::Field_Plots
{
  field: test::oliveprairie::domain::Field[0..1];
  plots: test::oliveprairie::domain::Plot[*];
}
