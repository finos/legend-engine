###Relational
Database test::oliveprairie::store::PrairieDB
(
  Schema prairie
  (
    Table field
    (
      field_id INTEGER PRIMARY KEY,
      name VARCHAR(120) NOT NULL,
      region VARCHAR(40) NOT NULL
    )
    Table plot
    (
      plot_id INTEGER PRIMARY KEY,
      field_id INTEGER NOT NULL,
      crop_count INTEGER NOT NULL
    )
  )

  Join Field_Plot(prairie.field.field_id = prairie.plot.field_id)

  Filter BigPlots(prairie.plot.crop_count > 100)
)
