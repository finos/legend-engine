###Runtime
Runtime test::quietlighthouse2::runtime::LightRegisterRuntime
{
  mappings:
  [
    test::quietlighthouse2::mapping::LightRelationalMapping
  ];
  connections:
  [
    test::quietlighthouse2::store::LightDB:
    [
      lightRegister: test::quietlighthouse2::connection::LightRegisterConnection
    ]
  ];
}

Runtime test::quietlighthouse2::runtime::LampSheetChainRuntime
{
  mappings:
  [
    test::quietlighthouse2::mapping::LampSheetMapping
  ];
  connections:
  [
    ModelStore:
    [
      lampChain: test::quietlighthouse2::connection::LampChainConnection
    ],
    test::quietlighthouse2::store::LightDB:
    [
      lightRegisterForChain: test::quietlighthouse2::connection::LightRegisterConnection
    ]
  ];
}
