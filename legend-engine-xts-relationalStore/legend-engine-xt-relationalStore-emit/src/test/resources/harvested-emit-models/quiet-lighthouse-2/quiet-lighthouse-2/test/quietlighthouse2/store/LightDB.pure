###Relational
Database test::quietlighthouse2::store::LightDB
(
  Schema lights
  (
    Table beacon
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )

      beacon_code VARCHAR(12) PRIMARY KEY,
      in_z DATE PRIMARY KEY,
      out_z DATE NOT NULL,
      beacon_name VARCHAR(64) NOT NULL,
      section_code VARCHAR(12),
      status_code VARCHAR(2) NOT NULL,
      lamp_kind_code VARCHAR(2),
      beacon_type VARCHAR(2) NOT NULL,
      lens_order INTEGER,
      range_nm INTEGER NOT NULL
    )

    Table coast_section
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )

      section_code VARCHAR(12) PRIMARY KEY,
      in_z DATE PRIMARY KEY,
      out_z DATE NOT NULL,
      section_name VARCHAR(64) NOT NULL
    )

    Table beacon_alias
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )

      alias_id INTEGER PRIMARY KEY,
      in_z DATE PRIMARY KEY,
      out_z DATE NOT NULL,
      beacon_code VARCHAR(12) NOT NULL,
      alias_kind VARCHAR(8) NOT NULL,
      alias_text VARCHAR(64)
    )

    Table lamp_record
    (
      lamp_code VARCHAR(12) PRIMARY KEY,
      beacon_code VARCHAR(12),
      lamp_text VARCHAR(64),
      wattage INTEGER,
      fitted_flag VARCHAR(1) NOT NULL,
      glass_text VARCHAR(32),
      aspect_code VARCHAR(4)
    )

    View fitted_lamp
    (
      ~filter FittedLamp
      lamp_code: lights.lamp_record.lamp_code PRIMARY KEY,
      beacon_code: lights.lamp_record.beacon_code,
      lamp_text: lights.lamp_record.lamp_text,
      wattage: lights.lamp_record.wattage,
      glass_text: lights.lamp_record.glass_text,
      aspect_code: lights.lamp_record.aspect_code
    )
  )

  Join Beacon_Section(lights.beacon.section_code = lights.coast_section.section_code and lights.coast_section.out_z = '9999-12-31')
  Join Beacon_Alias(lights.beacon.beacon_code = lights.beacon_alias.beacon_code and lights.beacon.out_z = '9999-12-31' and lights.beacon_alias.out_z = '9999-12-31')
  Join Beacon_Lamp(lights.beacon.beacon_code = lights.fitted_lamp.beacon_code)

  Filter ListedBeacon(lights.beacon.status_code != 'X' and lights.beacon.range_nm >= 1)
  Filter LensOnly(lights.beacon.beacon_type = 'L')
  Filter NamedAlias(lights.beacon_alias.alias_text is not null)
  Filter FittedLamp(lights.lamp_record.fitted_flag = 'Y')
)
