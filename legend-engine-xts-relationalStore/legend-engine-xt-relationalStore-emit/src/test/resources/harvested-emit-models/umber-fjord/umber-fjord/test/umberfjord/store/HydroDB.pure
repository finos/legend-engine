###Relational
Database test::umberfjord::store::HydroDB
(
  Schema hydro
  (
    Table reading
    (
      reading_id INTEGER PRIMARY KEY,
      station_id INTEGER NOT NULL,
      flow_rate INTEGER NOT NULL,
      temperature_c INTEGER NOT NULL,
      recorded_on DATE NOT NULL
    )
    Table station
    (
      station_id INTEGER PRIMARY KEY,
      station_name VARCHAR(120) NOT NULL,
      region_code VARCHAR(20) NOT NULL,
      catchment_id INTEGER NOT NULL
    )
    Table catchment
    (
      catchment_id INTEGER PRIMARY KEY,
      catchment_name VARCHAR(120) NOT NULL,
      basin_id INTEGER NOT NULL
    )
    Table basin
    (
      basin_id INTEGER PRIMARY KEY,
      basin_name VARCHAR(120) NOT NULL
    )
    Table sample
    (
      sample_id INTEGER PRIMARY KEY,
      reading_id INTEGER NOT NULL,
      status VARCHAR(20) NOT NULL
    )
  )

  Join Reading_Station(hydro.reading.station_id = hydro.station.station_id)
  Join Station_Catchment(hydro.station.catchment_id = hydro.catchment.catchment_id)
  Join Catchment_Basin(hydro.catchment.basin_id = hydro.basin.basin_id)
  Join Reading_Sample(hydro.reading.reading_id = hydro.sample.reading_id)
)
