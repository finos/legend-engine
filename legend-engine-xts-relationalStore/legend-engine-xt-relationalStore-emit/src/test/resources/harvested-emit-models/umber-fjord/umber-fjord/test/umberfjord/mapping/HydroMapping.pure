###Mapping
Mapping test::umberfjord::mapping::HydroMapping
(
  *test::umberfjord::domain::Reading[reading]: Relational
  {
    ~primaryKey
    (
      [test::umberfjord::store::HydroDB]hydro.reading.reading_id
    )
    ~mainTable [test::umberfjord::store::HydroDB]hydro.reading
    readingId: [test::umberfjord::store::HydroDB]hydro.reading.reading_id,
    flowRate: [test::umberfjord::store::HydroDB]hydro.reading.flow_rate,
    temperatureC: [test::umberfjord::store::HydroDB]hydro.reading.temperature_c,
    regionCode: [test::umberfjord::store::HydroDB]@Reading_Station | [test::umberfjord::store::HydroDB]hydro.station.region_code,
    flowBand: case(
                greaterThan([test::umberfjord::store::HydroDB]hydro.reading.flow_rate, 300), 'CRITICAL',
                case(
                  greaterThan([test::umberfjord::store::HydroDB]hydro.reading.flow_rate, 150), 'HIGH',
                  'LOW'
                )
              ),
    basinName: [test::umberfjord::store::HydroDB]@Reading_Station > @Station_Catchment > @Catchment_Basin | [test::umberfjord::store::HydroDB]hydro.basin.basin_name,
    samples[sample]: [test::umberfjord::store::HydroDB]@Reading_Sample
  }

  test::umberfjord::domain::Sample[sample]: Relational
  {
    ~primaryKey
    (
      [test::umberfjord::store::HydroDB]hydro.sample.sample_id
    )
    ~mainTable [test::umberfjord::store::HydroDB]hydro.sample
    sampleId: [test::umberfjord::store::HydroDB]hydro.sample.sample_id,
    status: [test::umberfjord::store::HydroDB]hydro.sample.status
  }
)
