###Relational
Database test::scarletreef3::store::StudioDb
(
  Schema studio
  (
    Table kiln_unit
    (
      kiln_code VARCHAR(16) PRIMARY KEY,
      kiln_label VARCHAR(64) NOT NULL,
      chamber_litres INTEGER NOT NULL,
      installed_on DATE NOT NULL
    )

    Table studio_member
    (
      member_code VARCHAR(16) PRIMARY KEY,
      member_label VARCHAR(64) NOT NULL,
      joined_on DATE NOT NULL
    )

    Table firing_run
    (
      run_code VARCHAR(16) PRIMARY KEY,
      kiln_code VARCHAR(16) NOT NULL,
      member_code VARCHAR(16) NOT NULL,
      clay_code VARCHAR(16) NOT NULL,
      glaze_code VARCHAR(16) NOT NULL,
      started_at TIMESTAMP NOT NULL,
      peak_celsius INTEGER NOT NULL,
      run_note VARCHAR(128)
    )
  )

  Schema reference
  (
    Table clay_body
    (
      clay_code VARCHAR(16) PRIMARY KEY,
      clay_label VARCHAR(64) NOT NULL,
      shrink_percent INTEGER NOT NULL
    )

    Table glaze_recipe
    (
      glaze_code VARCHAR(16) PRIMARY KEY,
      glaze_label VARCHAR(64) NOT NULL,
      cone_number INTEGER NOT NULL
    )
  )

  Join Run_Kiln(studio.firing_run.kiln_code = studio.kiln_unit.kiln_code)

  Join Run_Clay(studio.firing_run.clay_code = reference.clay_body.clay_code)

  Join Run_Glaze(studio.firing_run.glaze_code = reference.glaze_recipe.glaze_code)
)
