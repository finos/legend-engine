###Mapping
Mapping test::scarletreef3::mapping::FiringAuditMapping
(
  *test::scarletreef3::domain::KilnUnit[kiln]: Relational
  {
    ~primaryKey
    (
      [test::scarletreef3::store::StudioDb]studio.kiln_unit.kiln_code
    )
    ~mainTable [test::scarletreef3::store::StudioDb]studio.kiln_unit
    kilnCode: [test::scarletreef3::store::StudioDb]studio.kiln_unit.kiln_code,
    kilnLabel: [test::scarletreef3::store::StudioDb]studio.kiln_unit.kiln_label,
    chamberLitres: [test::scarletreef3::store::StudioDb]studio.kiln_unit.chamber_litres,
    installedOn: [test::scarletreef3::store::StudioDb]studio.kiln_unit.installed_on
  }

  *test::scarletreef3::domain::FiringRun[run]: Relational
  {
    ~primaryKey
    (
      [test::scarletreef3::store::StudioDb]studio.firing_run.run_code
    )
    ~mainTable [test::scarletreef3::store::StudioDb]studio.firing_run
    runCode: [test::scarletreef3::store::StudioDb]studio.firing_run.run_code,
    startedAt: [test::scarletreef3::store::StudioDb]studio.firing_run.started_at,
    peakCelsius: [test::scarletreef3::store::StudioDb]studio.firing_run.peak_celsius,
    runNote: [test::scarletreef3::store::StudioDb]studio.firing_run.run_note,
    kilnLabel: [test::scarletreef3::store::StudioDb]@Run_Kiln | studio.kiln_unit.kiln_label
  }
)
