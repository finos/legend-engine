###Service
Service test::emeraldcanyon2::service::DistrictCrateTallyService
{
  pattern: '/emeraldcanyon/v1/districts/{businessDate}';
  title: 'District Orchard Tally';
  owners:
  [
    'grove-register',
    'district-reporting'
  ];
  documentation: 'Rolls the orchards holding a densely planted picking block up to their growing district as of the requested business date, so the grouping key is navigated off the root extent rather than read from a local property, and caps the ordered result.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {businessDate: StrictDate[1], minTrees: Integer[1]|test::emeraldcanyon2::domain::Orchard.all($businessDate)->filter(
      o|$o.blocks->exists(b|$b.treeCount >= $minTrees)
    )->groupBy(
      [
        o|$o.cooperative.districtName
      ],
      [
        agg(o|$o.elevationM, y|$y->sum()),
        agg(o|$o.orchardCode, y|$y->count())
      ],
      [
        'District',
        'TotalElevationM',
        'OrchardCount'
      ]
    )->sort(
      [
        asc('District')
      ]
    )->limit(5)};
    mapping: test::emeraldcanyon2::mapping::GroveMapping;
    runtime: test::emeraldcanyon2::runtime::GroveRuntime;
  }
  testSuites:
  [
    districtCrateTallySuite:
    {
      data:
      [
        connections:
        [
          groveConnection:
            Relational
            #{
              grove.cooperative:
                'coop_code,coop_name,district_name,climate_zone\n'+
                'CO-01,Ridgeline Growers,Highland District,cool-temperate\n'+
                'CO-02,Meadowbrook Growers,Lowland District,mild-temperate\n'+
                'CO-03,Stonefield Growers,Highland District,cool-temperate\n';
              grove.orchard:
                'orchard_code,coop_code,orchard_name,elevation_m,from_z,thru_z\n'+
                'OR-01,CO-01,North Terrace Orchard,420,2026-01-01,9999-12-31\n'+
                'OR-02,CO-02,Brookside Orchard,180,2026-01-01,9999-12-31\n'+
                'OR-03,CO-01,Summit Slope Orchard,910,2026-01-01,9999-12-31\n'+
                'OR-04,CO-03,Old Kiln Orchard,300,2025-01-01,2025-12-31\n'+
                'OR-05,CO-01,Fern Hollow Orchard,260,2026-01-01,9999-12-31\n';
              harvest.picking_block:
                'block_code,orchard_code,block_name,tree_count\n'+
                'BK-01,OR-01,North Terrace Block A,120\n'+
                'BK-02,OR-01,North Terrace Block B,35\n'+
                'BK-03,OR-02,Brookside Block A,90\n'+
                'BK-04,OR-03,Summit Slope Block A,150\n'+
                'BK-05,OR-04,Old Kiln Block A,140\n'+
                'BK-06,OR-05,Fern Hollow Block A,60\n';
            }#
        ]
      ]
      tests:
      [
        highlandDistrictTally:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            businessDate = %2026-06-01,
            minTrees = 100
          ]
          asserts:
          [
            oneDistrict:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"District":"Highland District","TotalElevationM":1330,"OrchardCount":2}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
