###Relational
Database test::emeraldcanyon2::store::GroveCoreDb
(
  Schema grove
  (
    Table cooperative
    (
      coop_code VARCHAR(24) PRIMARY KEY,
      coop_name VARCHAR(96) NOT NULL,
      district_name VARCHAR(96) NOT NULL,
      climate_zone VARCHAR(32) NOT NULL
    )
    Table orchard
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      orchard_code VARCHAR(24) PRIMARY KEY,
      coop_code VARCHAR(24) NOT NULL,
      orchard_name VARCHAR(96) NOT NULL,
      elevation_m INTEGER NOT NULL,
      from_z DATE PRIMARY KEY,
      thru_z DATE
    )
  )

  Join Orchard_Cooperative(grove.orchard.coop_code = grove.cooperative.coop_code)
)
