###Pure
import test::emeraldcanyon2::domain::*;

Class {meta::pure::profiles::doc.doc = 'A growers cooperative that publishes an orchard register for one growing district.'} test::emeraldcanyon2::domain::Cooperative
{
  coopCode: String[1];
  coopName: String[1];
  districtName: String[1];
  climateZone: String[1];
}

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'A registered orchard, versioned on the business timeline the cooperative register is published against.'} test::emeraldcanyon2::domain::Orchard
{
  orchardCode: String[1];
  orchardName: String[1];
  elevationM: Integer[1];
  cooperative: test::emeraldcanyon2::domain::Cooperative[1];
  blocks: test::emeraldcanyon2::domain::PickingBlock[*];
}

Class {meta::pure::profiles::doc.doc = 'A picking block within an orchard, holding the planted tree count the pickers are rostered against.'} test::emeraldcanyon2::domain::PickingBlock
{
  blockCode: String[1];
  blockName: String[1];
  treeCount: Integer[1];
  consignments: test::emeraldcanyon2::domain::Consignment[*];
}

Class {meta::pure::profiles::doc.doc = 'A crate consignment picked out of one block and graded on despatch.'} test::emeraldcanyon2::domain::Consignment
{
  consignmentCode: String[1];
  gradeLabel: String[1];
  crateCount: Integer[1];
  pickedOn: StrictDate[1];
}

Class <<temporal.processingtemporal>> {meta::pure::profiles::doc.doc = 'A packhouse quality check whose recorded state is versioned on the processing timeline.'} test::emeraldcanyon2::domain::PackhouseCheck
{
  checkCode: String[1];
  consignmentCode: String[1];
  inspectorTeam: String[1];
  defectPercent: Integer[1];
}

Class {meta::pure::profiles::doc.doc = 'The serialized shape a packhouse feed record arrives in; bound to the in-memory feed connection and never mapped to a table.'} test::emeraldcanyon2::domain::HarvestFeedRecord
{
  feedKey: String[1];
  payloadLabel: String[1];
}
