###Relational
Database test::emeraldcanyon2::store::GroveHarvestDb
(
  include test::emeraldcanyon2::store::GroveCoreDb

  Schema harvest
  (
    Table picking_block
    (
      block_code VARCHAR(24) PRIMARY KEY,
      orchard_code VARCHAR(24) NOT NULL,
      block_name VARCHAR(96) NOT NULL,
      tree_count INTEGER NOT NULL
    )
    Table consignment
    (
      consignment_code VARCHAR(24) PRIMARY KEY,
      block_code VARCHAR(24) NOT NULL,
      grade_label VARCHAR(32) NOT NULL,
      crate_count INTEGER NOT NULL,
      picked_on DATE NOT NULL
    )
    Table packhouse_check
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )
      check_code VARCHAR(24) PRIMARY KEY,
      consignment_code VARCHAR(24) NOT NULL,
      inspector_team VARCHAR(96) NOT NULL,
      defect_percent INTEGER NOT NULL,
      in_z DATE PRIMARY KEY,
      out_z DATE
    )
  )

  Join Block_Consignment(harvest.picking_block.block_code = harvest.consignment.block_code)
  Join Orchard_Block(grove.orchard.orchard_code = harvest.picking_block.orchard_code)
)
