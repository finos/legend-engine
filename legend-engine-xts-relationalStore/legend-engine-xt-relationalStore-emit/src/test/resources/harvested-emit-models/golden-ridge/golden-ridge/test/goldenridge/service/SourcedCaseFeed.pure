###Service
Service test::goldenridge::service::SourcedCaseFeed
{
  pattern: '/goldenRidge/v1/sourcedCases';
  title: 'Sourced Case Feed';
  owners:
  [
    'ridge-planning-office',
    'intake-desk'
  ];
  documentation: 'Publishes the same review-case column contract reconstructed from the normalized intake tables, restricted to three-storey cases whose inspector is actually recorded. The conjunction pairs a value-level equality with a multiplicity-level emptiness guard, so a case with a dangling reviewer reference drops out independently of its storey count.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |test::goldenridge::domain::SourcedCase.all()->filter(
      c|(($c.storeys == 3) && ($c.inspector->isEmpty()->not()))
    )->project(
      [
        x|$x.caseCode,
        x|$x.siteLabel,
        x|$x.storeys,
        x|$x.floorArea,
        x|$x.filedOn,
        x|$x.intakeOfficer,
        x|$x.inspector,
        x|$x.approver,
        x|$x.wardName,
        x|$x.districtLabel
      ],
      [
        'CaseCode',
        'SiteLabel',
        'Storeys',
        'FloorArea',
        'FiledOn',
        'IntakeOfficer',
        'Inspector',
        'Approver',
        'WardName',
        'DistrictLabel'
      ]
    )->sort(
      [
        asc('CaseCode')
      ]
    );
    mapping: test::goldenridge::mapping::SourceJoinMapping;
    runtime: test::goldenridge::runtime::RidgeSourceRuntime;
  }
  testSuites:
  [
    sourcedCaseFeedSuite:
    {
      data:
      [
        connections:
        [
          h2Connection:
            Relational
            #{
              intake.reviewer:
                'reviewer_id,reviewer_name,unit_label\n'+
                '1,Nadia Osei,Intake Desk\n'+
                '2,Roman Fisk,Site Inspection\n'+
                '3,Priya Vale,Approvals\n';
              reference.parcel:
                'parcel_id,parcel_code\n'+
                '1,PCL-7781\n';
              reference.ward:
                'ward_id,ward_name,district_label\n'+
                '1,Ridge Crest Ward,North Heights District\n'+
                '2,Fern Hollow Ward,South Flats District\n';
              reference.ward_link:
                'link_id,parcel_id,ward_id,link_kind\n'+
                '1,1,1,PRIMARY_WARD\n'+
                '2,1,2,SECONDARY_WARD\n';
              intake.permit_case:
                'case_id,case_code,site_label,storeys,floor_area,filed_on,intake_officer_id,inspector_id,approver_id,parcel_id\n'+
                '1,PMT-1001,Old Mill Terrace,3,420.5,2024-03-11,1,2,3,1\n'+
                '2,PMT-1002,Cedar Slope Annex,3,610.75,2024-04-02,1,77,3,1\n'+
                '3,PMT-1003,Harbour Steps Lot,5,210.25,2024-05-20,1,2,3,1\n'+
                '4,PMT-1004,Quarry Edge Plot,3,150.5,2024-06-15,1,2,3,88\n';
            }#
        ]
      ]
      tests:
      [
        restrictedFeedFromBaseTables:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            onlyGuardedThreeStoreyCases:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"CaseCode":"PMT-1001","SiteLabel":"Old Mill Terrace","Storeys":3,"FloorArea":420.5,"FiledOn":"2024-03-11","IntakeOfficer":"Nadia Osei","Inspector":"Roman Fisk","Approver":"Priya Vale","WardName":"Ridge Crest Ward","DistrictLabel":"North Heights District"},{"CaseCode":"PMT-1004","SiteLabel":"Quarry Edge Plot","Storeys":3,"FloorArea":150.5,"FiledOn":"2024-06-15","IntakeOfficer":"Nadia Osei","Inspector":"Roman Fisk","Approver":"Priya Vale","WardName":null,"DistrictLabel":null}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
