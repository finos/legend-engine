###Pure
import test::goldenridge::domain::*;

Class {meta::pure::profiles::doc.doc = 'A ridge-side development review case as published from the pre-joined reporting view.'} test::goldenridge::domain::ReportedCase
{
  caseCode: String[1];
  siteLabel: String[1];
  storeys: Integer[0..1];
  floorArea: Float[0..1];
  filedOn: StrictDate[0..1];
  intakeOfficer: String[0..1];
  inspector: String[0..1];
  approver: String[0..1];
  wardName: String[0..1];
  districtLabel: String[0..1];
  caseLabel() {$this.caseCode->toUpper() + ' - ' + $this.siteLabel}: String[1];
}

Class {meta::pure::profiles::doc.doc = 'The same ridge-side development review case reconstructed from the normalized intake tables.'} test::goldenridge::domain::SourcedCase
{
  caseCode: String[1];
  siteLabel: String[1];
  storeys: Integer[0..1];
  floorArea: Float[0..1];
  filedOn: StrictDate[0..1];
  intakeOfficer: String[0..1];
  inspector: String[0..1];
  approver: String[0..1];
  wardName: String[0..1];
  districtLabel: String[0..1];
  caseLabel() {$this.caseCode->toUpper() + ' - ' + $this.siteLabel}: String[1];
  areaNote() {if($this.floorArea->isNotEmpty(), | 'FLOOR AREA ' + $this.floorArea->toOne()->toString(), | 'FLOOR AREA UNRECORDED')}: String[1];
}
