###Connection
RelationalDatabaseConnection test::goldenridge::connection::RidgeH2Connection
{
  store: test::goldenridge::store::RidgeDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists intake cascade;',
      'drop schema if exists reference cascade;',
      'create schema intake;',
      'create schema reference;',
      'create table intake.reviewer (reviewer_id integer primary key, reviewer_name varchar(200) not null, unit_label varchar(100));',
      'create table intake.permit_case (case_id integer primary key, case_code varchar(40) not null, site_label varchar(200) not null, storeys integer, floor_area double, filed_on date, intake_officer_id integer, inspector_id integer, approver_id integer, parcel_id integer);',
      'create table reference.parcel (parcel_id integer primary key, parcel_code varchar(40) not null);',
      'create table reference.ward (ward_id integer primary key, ward_name varchar(120) not null, district_label varchar(120) not null);',
      'create table reference.ward_link (link_id integer primary key, parcel_id integer not null, ward_id integer not null, link_kind varchar(40) not null);'
      ];
  };
  auth: DefaultH2;
}
