###Relational
Database test::lunarharbor3::store::HarbourDB
(
  Schema harbourside
  (
    Table mooring_log
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )

      log_code VARCHAR(24) PRIMARY KEY,
      pontoon_code VARCHAR(24) NOT NULL,
      vessel_name VARCHAR(120) NOT NULL,
      hull_code CHAR(2),
      state_code CHAR(2),
      lantern_code CHAR(2),
      keel_depth_cm INTEGER NOT NULL,
      tide_reading VARCHAR(12),
      logged_on DATE NOT NULL,
      in_z DATE NOT NULL,
      out_z DATE NOT NULL
    )
    Table pontoon
    (
      pontoon_code VARCHAR(24) PRIMARY KEY,
      pontoon_name VARCHAR(120) NOT NULL,
      quay_code VARCHAR(24) NOT NULL
    )
    Table quay
    (
      quay_code VARCHAR(24) PRIMARY KEY,
      quay_name VARCHAR(120) NOT NULL,
      station_code VARCHAR(24) NOT NULL
    )
    Table watch_station
    (
      station_code VARCHAR(24) PRIMARY KEY,
      station_name VARCHAR(120) NOT NULL
    )
  )

  Join Log_Pontoon(harbourside.mooring_log.pontoon_code = harbourside.pontoon.pontoon_code)
  Join Pontoon_Quay(harbourside.pontoon.quay_code = harbourside.quay.quay_code)
  Join Quay_Station(harbourside.quay.station_code = harbourside.watch_station.station_code)
)
