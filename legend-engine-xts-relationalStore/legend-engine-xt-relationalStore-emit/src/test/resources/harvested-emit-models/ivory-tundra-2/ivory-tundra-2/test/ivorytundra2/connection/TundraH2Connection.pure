###Connection
RelationalDatabaseConnection test::ivorytundra2::connection::TundraH2Connection
{
  store: test::ivorytundra2::store::TundraDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists tundra;',
      'create schema tundra;',
      'create table tundra.field_station (station_id integer primary key, station_name varchar(60) not null, region_code varchar(24) not null);',
      'create table tundra.range_zone (zone_id integer primary key, zone_name varchar(60) not null, terrain_class varchar(24) not null, station_id integer not null);',
      'create table tundra.herd_season (season_id integer primary key, season_label varchar(60) not null, forage_index integer not null, zone_id integer not null, in_z date not null, out_z date not null, from_z date not null, thru_z date not null);',
      'create table tundra.observation (observation_id integer primary key, record_code varchar(24) not null, herd_code varchar(24) not null, collar_code varchar(24) not null, observer_code varchar(24) not null, observed_on date not null, survey_method varchar(24) not null, verified boolean not null, sighting_count integer not null, season_id integer not null);'
      ];
  };
  auth: DefaultH2;
}
