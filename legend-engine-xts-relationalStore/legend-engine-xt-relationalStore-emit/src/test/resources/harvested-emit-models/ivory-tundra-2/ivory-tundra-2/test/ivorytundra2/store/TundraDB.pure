###Relational
Database test::ivorytundra2::store::TundraDB
(
  Schema tundra
  (
    Table observation
    (
      observation_id INTEGER PRIMARY KEY,
      record_code VARCHAR(24) NOT NULL,
      herd_code VARCHAR(24) NOT NULL,
      collar_code VARCHAR(24) NOT NULL,
      observer_code VARCHAR(24) NOT NULL,
      observed_on DATE NOT NULL,
      survey_method VARCHAR(24) NOT NULL,
      verified BIT NOT NULL,
      sighting_count INTEGER NOT NULL,
      season_id INTEGER NOT NULL
    )
    Table herd_season
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z),
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      season_id INTEGER PRIMARY KEY,
      season_label VARCHAR(60) NOT NULL,
      forage_index INTEGER NOT NULL,
      zone_id INTEGER NOT NULL,
      in_z DATE NOT NULL,
      out_z DATE NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
    Table range_zone
    (
      zone_id INTEGER PRIMARY KEY,
      zone_name VARCHAR(60) NOT NULL,
      terrain_class VARCHAR(24) NOT NULL,
      station_id INTEGER NOT NULL
    )
    Table field_station
    (
      station_id INTEGER PRIMARY KEY,
      station_name VARCHAR(60) NOT NULL,
      region_code VARCHAR(24) NOT NULL
    )
  )

  Join Observation_HerdSeason(tundra.observation.season_id = tundra.herd_season.season_id)

  Join HerdSeason_RangeZone(tundra.herd_season.zone_id = tundra.range_zone.zone_id)

  Join RangeZone_FieldStation(tundra.range_zone.station_id = tundra.field_station.station_id)
)
