###Mapping
Mapping demo::sunlittundra4::mapping::ObservatoryMapping
(
  include mapping demo::sunlittundra4::mapping::ObservatoryBaseMapping

  *demo::sunlittundra4::domain::ScanRecord: Operation
  {
    meta::pure::router::operations::union_OperationSetImplementation_1__SetImplementation_MANY_(plateAsRecord, spectrumAsRecord)
  }

  demo::sunlittundra4::domain::ScanRecord[plateAsRecord]: Relational
  {
    ~primaryKey
    (
      [demo::sunlittundra4::store::ObservatoryDB]sky.plate_scan.scan_code
    )
    ~mainTable [demo::sunlittundra4::store::ObservatoryDB]sky.plate_scan
    recordCode: [demo::sunlittundra4::store::ObservatoryDB]sky.plate_scan.scan_code,
    domeCode: [demo::sunlittundra4::store::ObservatoryDB]sky.plate_scan.dome_code
  }

  demo::sunlittundra4::domain::ScanRecord[spectrumAsRecord]: Relational
  {
    ~primaryKey
    (
      [demo::sunlittundra4::store::ObservatoryDB]sky.spectrum_scan.spectrum_code
    )
    ~mainTable [demo::sunlittundra4::store::ObservatoryDB]sky.spectrum_scan
    recordCode: [demo::sunlittundra4::store::ObservatoryDB]sky.spectrum_scan.spectrum_code,
    domeCode: [demo::sunlittundra4::store::ObservatoryDB]sky.spectrum_scan.dome_code
  }

  *demo::sunlittundra4::domain::SpectrumScan[spectrumDetail]: Relational
  {
    ~primaryKey
    (
      [demo::sunlittundra4::store::ObservatoryDB]sky.spectrum_scan.spectrum_code
    )
    ~mainTable [demo::sunlittundra4::store::ObservatoryDB]sky.spectrum_scan
    recordCode: [demo::sunlittundra4::store::ObservatoryDB]sky.spectrum_scan.spectrum_code,
    domeCode: [demo::sunlittundra4::store::ObservatoryDB]sky.spectrum_scan.dome_code,
    gratingLines: [demo::sunlittundra4::store::ObservatoryDB]sky.spectrum_scan.grating_lines
  }

  testSuites:
  [
    recordUnionSuite:
    {
      function: |demo::sunlittundra4::domain::ScanRecord.all()->project(
  ~[
     RecordCode: r|$r.recordCode,
     DomeCode: r|$r.domeCode
   ]
)->sort(~RecordCode->ascending());
      tests:
      [
        bothScanSurfacesBehindOneRecord:
        {
          doc: 'Reads the shared record through the union operation so plate and spectrum relations answer one query, with the plate surface contributing rows regardless of the archive status the detail set filters on.';
          data:
          [
            demo::sunlittundra4::store::ObservatoryDB:
              Relational
              #{
                sky.plate_scan:
                  'scan_code,dome_code,band_code,seeing_code,exposure_secs,sky_mag,plate_note,archive_status,observed_on\n'+
                  'PS-21,D-1,B,S,30,15.0,plate one,ARCHIVED,2026-04-01\n'+
                  'PS-22,D-2,V,F,60,14.0,plate two,DRAFT,2026-04-01\n';
                sky.spectrum_scan:
                  'spectrum_code,dome_code,grating_lines,archive_status\n'+
                  'SP-01,D-1,600,ARCHIVED\n'+
                  'SP-02,D-3,1200,DRAFT\n';
              }#
          ];
          asserts:
          [
            fourRecordsAcrossTwoRelations:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"RecordCode":"PS-21","DomeCode":"D-1"},{"RecordCode":"PS-22","DomeCode":"D-2"},{"RecordCode":"SP-01","DomeCode":"D-1"},{"RecordCode":"SP-02","DomeCode":"D-3"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
