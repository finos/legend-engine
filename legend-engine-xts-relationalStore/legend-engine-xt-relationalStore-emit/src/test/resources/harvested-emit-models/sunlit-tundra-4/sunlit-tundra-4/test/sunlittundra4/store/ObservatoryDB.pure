###Relational
Database demo::sunlittundra4::store::ObservatoryDB
(
  Schema sky
  (
    Table plate_scan
    (
      scan_code VARCHAR(20) PRIMARY KEY,
      dome_code VARCHAR(20) NOT NULL,
      band_code VARCHAR(10) NOT NULL,
      seeing_code VARCHAR(10) NOT NULL,
      exposure_secs INTEGER,
      sky_mag DOUBLE,
      plate_note VARCHAR(200),
      archive_status VARCHAR(20),
      observed_on DATE
    )

    Table spectrum_scan
    (
      spectrum_code VARCHAR(20) PRIMARY KEY,
      dome_code VARCHAR(20) NOT NULL,
      grating_lines INTEGER,
      archive_status VARCHAR(20)
    )

    Table dome
    (
      dome_code VARCHAR(20) PRIMARY KEY,
      dome_name VARCHAR(120) NOT NULL,
      ridge_name VARCHAR(120)
    )
  )

  Join Scan_Dome
  (
    sky.plate_scan.dome_code = sky.dome.dome_code
  )

  Filter ArchivedPlateFilter(sky.plate_scan.archive_status = 'ARCHIVED')
)
