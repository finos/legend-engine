###Relational
Database test::copperwillow4::store::CoppiceDatabase
(
  Schema woodland
  (
    Table coppice_stool
    (
      stool_id INTEGER PRIMARY KEY,
      stool_code VARCHAR(20) NOT NULL,
      condition_code VARCHAR(20) NOT NULL,
      field_note VARCHAR(120)
    )
    Table cut_cycle
    (
      cycle_id INTEGER PRIMARY KEY,
      stool_code VARCHAR(20) NOT NULL,
      cycle_code VARCHAR(20) NOT NULL,
      cut_on DATE NOT NULL,
      crew_label VARCHAR(80) NOT NULL
    )
  )
)
