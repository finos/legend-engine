###Relational
Database test::emberestuary::store::CuratorialDatabase
(
  Schema curation
  (
    Table condition_review
    (
      milestoning
      (
        business(BUS_FROM = bus_from, BUS_THRU = bus_thru, INFINITY_DATE = %9999-12-31T00:00:00.000000+0000)
      )

      review_id INTEGER PRIMARY KEY,
      object_ref VARCHAR(24),
      gallery_code VARCHAR(16),
      material_class VARCHAR(24),
      condition_grade VARCHAR(4),
      items_checked INTEGER,
      review_month INTEGER,
      review_year INTEGER,
      bus_from TIMESTAMP NOT NULL,
      bus_thru TIMESTAMP NOT NULL
    )
  )
)
