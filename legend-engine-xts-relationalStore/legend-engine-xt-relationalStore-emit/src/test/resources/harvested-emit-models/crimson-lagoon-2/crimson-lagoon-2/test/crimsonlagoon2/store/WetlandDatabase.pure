###Relational
Database test::crimsonlagoon2::store::WetlandDatabase
(
  Schema wetland
  (
    Table water_reading
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )
      reading_id INTEGER PRIMARY KEY,
      station_name VARCHAR(200) NOT NULL,
      turbidity_ntu DOUBLE NOT NULL,
      sampled_on DATE NOT NULL,
      in_z DATE NOT NULL,
      out_z DATE NOT NULL
    )
  )
)
