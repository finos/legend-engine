###Mapping
Mapping test::crimsonlagoon2::mapping::WetlandMapping
(
  test::crimsonlagoon2::domain::WaterReading: Relational
  {
    ~primaryKey
    (
      [test::crimsonlagoon2::store::WetlandDatabase]wetland.water_reading.reading_id
    )
    ~mainTable [test::crimsonlagoon2::store::WetlandDatabase]wetland.water_reading
    stationName: [test::crimsonlagoon2::store::WetlandDatabase]wetland.water_reading.station_name,
    turbidityNtu: [test::crimsonlagoon2::store::WetlandDatabase]wetland.water_reading.turbidity_ntu,
    sampledOn: [test::crimsonlagoon2::store::WetlandDatabase]wetland.water_reading.sampled_on
  }
)
