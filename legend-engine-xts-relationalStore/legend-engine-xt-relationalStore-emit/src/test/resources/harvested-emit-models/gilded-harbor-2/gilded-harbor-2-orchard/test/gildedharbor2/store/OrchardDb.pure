###Relational
Database test::gildedharbor2::store::OrchardDb
(
  Schema orchard
  (
    Table grafted_block
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z, INFINITY_DATE = %9999-12-31T00:00:00.0000)
      )

      planting_code VARCHAR(24) PRIMARY KEY,
      block_code VARCHAR(20) NOT NULL,
      planted_on DATE NOT NULL,
      row_count INTEGER NOT NULL,
      cultivar_name VARCHAR(48) NOT NULL,
      rootstock_code VARCHAR(20) NOT NULL,
      canopy_area_sqm FLOAT NOT NULL,
      lot_code VARCHAR(20) NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )

    Table nursery_lot
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z, INFINITY_DATE = %9999-12-31T00:00:00.0000)
      )

      lot_code VARCHAR(20) PRIMARY KEY,
      lot_name VARCHAR(48) NOT NULL,
      steward_code VARCHAR(20) NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )

    Table steward_desk
    (
      steward_code VARCHAR(20) PRIMARY KEY,
      steward_name VARCHAR(48) NOT NULL,
      zone_code VARCHAR(20) NOT NULL
    )
  )

  Join BlockToLot(orchard.grafted_block.lot_code = orchard.nursery_lot.lot_code)
  Join LotToSteward(orchard.nursery_lot.steward_code = orchard.steward_desk.steward_code)
)
