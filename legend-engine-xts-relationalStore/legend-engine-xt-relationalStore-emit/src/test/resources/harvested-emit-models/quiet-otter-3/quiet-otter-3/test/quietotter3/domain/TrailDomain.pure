###Pure
Class {meta::pure::profiles::doc.doc = 'A trailhead signage record with a stable marker code, trail label and installation timestamp, serving as the base shape for the distinct relational fixture.'} test::quietotter3::domain::TrailMarker
{
  markerCode: String[1];
  trailName: String[1];
  installedAt: DateTime[1];
}

Class {meta::pure::profiles::doc.doc = 'A lit trail marker specialization that adds the reflective surface note and elevation used to prove inheritance beside mapping-level distinctness.'} test::quietotter3::domain::LitTrailMarker extends test::quietotter3::domain::TrailMarker
{
  surfaceNote: String[1];
  elevationMetres: Float[1];
}

Class {meta::pure::profiles::doc.doc = 'An upkeep inspection round with its walk timestamp, inspector note and count of checked markers, exercising the second relational store.'} test::quietotter3::domain::InspectionRound
{
  roundCode: String[1];
  inspectorNote: String[1];
  walkedAt: DateTime[1];
  checkedMarkers: Integer[1];
}
