###Relational
Database test::cedarbeacon::store::ShelterRegisterDb
(
  Schema shelters
  (
    Table route_corridor
    (
      corridor_code VARCHAR(16) PRIMARY KEY,
      corridor_name VARCHAR(64) NOT NULL
    )

    Table shelter_unit
    (
      milestoning
      (
        business(BUS_FROM = valid_from, BUS_THRU = valid_thru)
      )
      unit_code VARCHAR(16) PRIMARY KEY,
      unit_kind VARCHAR(32) NOT NULL,
      corridor_code VARCHAR(16) NOT NULL,
      valid_from DATE PRIMARY KEY,
      valid_thru DATE
    )
  )

  Join UnitCorridor(shelters.shelter_unit.corridor_code = shelters.route_corridor.corridor_code)
)
