import test::cedarbeacon::domain::*;

Profile test::cedarbeacon::domain::NetworkMeta
{
  stereotypes: [surveyed, provisional];
  tags: [steward, reviewCadence];
}

Class <<NetworkMeta.surveyed>> {NetworkMeta.steward = 'network-planning'} test::cedarbeacon::domain::ServiceDistrict
{
  districtCode: String[1];
  districtName: String[1];
}

Class <<temporal.businesstemporal, NetworkMeta.surveyed>> {NetworkMeta.reviewCadence = 'quarterly'} test::cedarbeacon::domain::NetworkZone
{
  zoneCode: String[1];
  zoneName: String[1];
  districtName: String[0..1];
}

Class <<temporal.businesstemporal, NetworkMeta.provisional>> {NetworkMeta.steward = 'stop-register'} test::cedarbeacon::domain::StopPoint
{
  stopCode: String[1];
  stopName: String[1];
  shelterCount: Integer[1];
  zoneName: String[0..1];
  districtName: String[0..1];
}

Class <<NetworkMeta.surveyed>> test::cedarbeacon::domain::RouteCorridor
{
  corridorCode: String[1];
  corridorName: String[1];
}

Class <<temporal.businesstemporal, NetworkMeta.provisional>> test::cedarbeacon::domain::ShelterUnit
{
  unitCode: String[1];
  unitKind: String[1];
  corridorName: String[0..1];
}
