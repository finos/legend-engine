import test::russetmeadow::function::*;

Class <<meta::pure::profiles::temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'A surveyed grassland plot versioned on a business timeline by its survey validity window.'} test::russetmeadow::domain::MeadowPlot
{
  plotCode: String[1];
  plotName: String[1];
  elevationM: Integer[1];
  soilType: String[1];
  wildflowerCount: Integer[1];
  habitatBand() {habitatBand($this.elevationM)}: String[1];
  displayLabel() {$this.plotName->trim()->toUpper()->substring(0, 6) + '/' + $this.soilType->toLower()}: String[1];
  richTag(minFlowers: Integer[1])
  {
    if($this.wildflowerCount >= $minFlowers,
      | if($this.elevationM <= 1200,
        | ($this.plotName->trim()->toUpper()->substring(0, $this.plotCode->length())),
        | $this.soilType->toLower()
      ),
      | ('SPARSE/' + $this.plotCode->toUpper() + '/' + $minFlowers->toString())
    )
  }: String[1];
}
