###Relational
Database test::russetmeadow::store::MeadowDB
(
  Schema grassland
  (
    Table plot
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z, INFINITY_DATE = %9999-12-31T00:00:00.000000+0000)
      )

      plot_code VARCHAR(20) PRIMARY KEY,
      plot_name VARCHAR(200) NOT NULL,
      elevation_m INTEGER NOT NULL,
      soil_type VARCHAR(20) NOT NULL,
      wildflower_count INTEGER NOT NULL,
      from_z TIMESTAMP NOT NULL,
      thru_z TIMESTAMP NOT NULL
    )
  )
)
