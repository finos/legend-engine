    ~mainTable [test::russetmeadow::store::MeadowDB]grassland.plot
    plotCode: [test::russetmeadow::store::MeadowDB]grassland.plot.plot_code,
    plotName: [test::russetmeadow::store::MeadowDB]grassland.plot.plot_name,
    elevationM: [test::russetmeadow::store::MeadowDB]grassland.plot.elevation_m,
    soilType: [test::russetmeadow::store::MeadowDB]grassland.plot.soil_type,
    wildflowerCount: [test::russetmeadow::store::MeadowDB]grassland.plot.wildflower_count
  }
)
