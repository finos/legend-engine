###Mapping
Mapping demo::verdantmeadow4::mapping::MeadowEnumMappings
(
  demo::verdantmeadow4::domain::SwardClass: EnumerationMapping SwardMapping
  {
    HAY_MEADOW: ['HAY'],
    PASTURE: ['PAS'],
    FEN_MEADOW: ['FEN']
  }

  demo::verdantmeadow4::domain::GrazingRegime: EnumerationMapping GrazingMapping
  {
    CATTLE: ['CAT'],
    SHEEP: ['SHE'],
    UNGRAZED: ['UNG']
  }

  demo::verdantmeadow4::domain::ConditionGrade: EnumerationMapping ConditionMapping
  {
    FAVOURABLE: ['FAV'],
    RECOVERING: ['REC'],
    UNFAVOURABLE: ['UNF']
  }
)
