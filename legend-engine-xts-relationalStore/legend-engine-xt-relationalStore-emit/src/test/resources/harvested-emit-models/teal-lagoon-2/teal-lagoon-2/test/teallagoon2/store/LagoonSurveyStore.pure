###Relational
Database test::teallagoon2::store::LagoonSurveyStore
(
  Schema lagoon
  (
    Table seagrass_patch
    (
      patch_code VARCHAR(16) PRIMARY KEY,
      patch_name VARCHAR(64),
      meadow_code VARCHAR(16),
      planted_year INTEGER,
      shoot_density FLOAT,
      mapped_on DATE,
      patrol_note VARCHAR(64)
    )

    Table meadow_zone
    (
      meadow_code VARCHAR(16) PRIMARY KEY,
      meadow_name VARCHAR(64),
      sector_code VARCHAR(16)
    )

    Table lagoon_sector
    (
      sector_code VARCHAR(16) PRIMARY KEY,
      sector_name VARCHAR(64),
      warden_code VARCHAR(16)
    )

    Table sector_warden
    (
      warden_code VARCHAR(16) PRIMARY KEY,
      warden_name VARCHAR(64),
      radio_call VARCHAR(16)
    )

    Table survey_visit
    (
      visit_id INTEGER PRIMARY KEY,
      patch_code VARCHAR(16),
      visited_on DATE,
      shoot_tally INTEGER,
      water_temp_c FLOAT,
      visibility_code VARCHAR(16),
      tide_state VARCHAR(16),
      survey_round INTEGER
    )
  )

  Join Patch_Meadow(lagoon.seagrass_patch.meadow_code = lagoon.meadow_zone.meadow_code)
  Join Meadow_Sector(lagoon.meadow_zone.sector_code = lagoon.lagoon_sector.sector_code)
  Join Sector_Warden(lagoon.lagoon_sector.warden_code = lagoon.sector_warden.warden_code)
  Join Visit_Patch(lagoon.survey_visit.patch_code = lagoon.seagrass_patch.patch_code)
)
