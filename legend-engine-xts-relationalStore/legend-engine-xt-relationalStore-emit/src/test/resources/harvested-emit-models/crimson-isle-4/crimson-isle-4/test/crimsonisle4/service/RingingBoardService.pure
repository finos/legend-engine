###Service
Service test::crimsonisle4::service::RingingBoardService
{
  pattern: '/crimson-isle-4/v1/station-visits';
  title: 'Crimson Isle 4 - Station Visits';
  documentation: 'Returns larger-wing bird visits from the island ringing station.';
  autoActivateUpdates: false;
  ownership: DID { identifier: '000000' };
  execution: Single
  {
    query: test::crimsonisle4::function::stationVisits()->filter(v|$v.wingMm >= 80)->project(
      [
        x|$x.ringNumber,
        x|$x.speciesCode->toUpper(),
        x|$x.observerCode->trim(),
        x|$x.wingMm
      ],
      ['Ring', 'Species', 'Observer', 'Wing']
    );
    mapping: test::crimsonisle4::mapping::RingingMapping;
    runtime: test::crimsonisle4::runtime::RingingEngineRuntime;
  }
  testSuites:
  [
    ringingBoardSuite:
    {
      data:
      [
        connections:
        [
          ringing:
            Reference
            #{
              test::crimsonisle4::data::RingingData
            }#
        ]
      ]
      tests:
      [
        largeWingVisits:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            result:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Ring":"RI-101","Species":"TERN","Observer":"OB-7","Wing":84},{"Ring":"RI-103","Species":"TERN","Observer":"OB-9","Wing":91}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
