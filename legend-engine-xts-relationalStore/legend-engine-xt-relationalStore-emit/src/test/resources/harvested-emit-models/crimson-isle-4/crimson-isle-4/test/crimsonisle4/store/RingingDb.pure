###Relational
Database test::crimsonisle4::store::RingingDb
(
  Schema OBSERVATORY
  (
    Table RINGING_VISIT
    (
      VISIT_ID INTEGER PRIMARY KEY,
      RING_NUMBER VARCHAR(32) NOT NULL,
      SPECIES_CODE VARCHAR(32) NOT NULL,
      OBSERVER_CODE VARCHAR(32) NOT NULL,
      WING_MM INTEGER NOT NULL,
      VISITED_ON DATE NOT NULL
    )
  )
)
