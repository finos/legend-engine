###Mapping
Mapping test::duskyfjord8::mapping::VesselBaseMapping
(
  *test::duskyfjord8::domain::SurveyVessel[vessel]: Relational
  {
    ~primaryKey
    (
      [test::duskyfjord8::store::SurveyDb]survey.survey_vessel.vessel_id
    )
    ~mainTable [test::duskyfjord8::store::SurveyDb]survey.survey_vessel
    vesselCode: [test::duskyfjord8::store::SurveyDb]survey.survey_vessel.vessel_code,
    vesselName: [test::duskyfjord8::store::SurveyDb]survey.survey_vessel.vessel_name,
    vesselGrade: [test::duskyfjord8::store::SurveyDb]survey.survey_vessel.vessel_grade,
    ratedHours: [test::duskyfjord8::store::SurveyDb]survey.survey_vessel.rated_hours
  }
)
