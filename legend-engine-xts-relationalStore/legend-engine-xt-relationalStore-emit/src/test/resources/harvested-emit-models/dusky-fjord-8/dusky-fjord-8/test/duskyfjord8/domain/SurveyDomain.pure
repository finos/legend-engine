###Pure
import test::duskyfjord8::domain::*;

Class {meta::pure::profiles::doc.doc = 'One plankton tow taken in the fjord, logged against the vessel that took it and the mooring station it was launched from.'} test::duskyfjord8::domain::PlanktonTow
{
  towCode: String[1];
  vesselName: String[0..1];
  vesselGrade: String[0..1];
  stationName: String[0..1];
  netCount: Integer[0..1];
  depthMetres: Decimal[0..1];
  towDate: StrictDate[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A research vessel available to the fjord survey; mapped by the included base mapping rather than by the mapping that maps the tow.'} test::duskyfjord8::domain::SurveyVessel
{
  vesselCode: String[1];
  vesselName: String[1];
  vesselGrade: String[0..1];
  ratedHours: Float[0..1];
}

Class {meta::pure::profiles::doc.doc = 'The catch of one tow totalled over its sorted taxa, banded by abundance and traced back through the tow, its mooring station and the station region to the monitoring programme that covers it.'} test::duskyfjord8::domain::TowCatchTotal
{
  towCode: String[0..1];
  taxonCount: Integer[0..1];
  totalIndividuals: Integer[0..1];
  peakIndividuals: Integer[0..1];
  lowIndividuals: Integer[0..1];
  abundanceBand: String[0..1];
  programmeName: String[0..1];
}
