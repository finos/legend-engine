###Relational
Database test::frostedthistle3::store::TrailNetworkDb
(
  Schema trail
  (
    Table trail_segment
    (
      segment_code VARCHAR(20) PRIMARY KEY,
      path_code VARCHAR(40) NOT NULL,
      crew_code VARCHAR(20) NOT NULL,
      surface_code VARCHAR(20),
      gradient_pct INTEGER NOT NULL,
      span_metres INTEGER NOT NULL,
      last_inspected_on DATE NOT NULL,
      waymark_label VARCHAR(40),
      ridge_flag VARCHAR(1),
      ridge_exposure INTEGER
    )
  )

  Filter RidgeSegments(trail.trail_segment.ridge_flag = 'Y')
)
