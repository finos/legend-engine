import test::frostedthistle3::domain::*;

Enum {meta::pure::profiles::doc.doc = 'The walking surface laid down along a footpath segment.'} test::frostedthistle3::domain::TrailSurface
{
  GRAVEL,
  BOARDWALK,
  STONE_PITCH,
  TIMBER
}

Class {meta::pure::profiles::doc.doc = 'A numbered stretch of public footpath, the crew that keeps it and the surface it is laid with.'} test::frostedthistle3::domain::TrailSegment
{
  segmentCode: String[1];
  pathCode: String[1];
  crewCode: String[1];
  surface: TrailSurface[0..1];
  gradientPct: Integer[1];
  spanMetres: Integer[1];
  lastInspectedOn: StrictDate[1];
  waymarkLabel: String[0..1];
  logSource: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A footpath stretch that runs along an exposed ridge line and therefore carries an exposure rating.'} test::frostedthistle3::domain::RidgeSegment extends TrailSegment
{
  exposureRating: Integer[0..1];
}
