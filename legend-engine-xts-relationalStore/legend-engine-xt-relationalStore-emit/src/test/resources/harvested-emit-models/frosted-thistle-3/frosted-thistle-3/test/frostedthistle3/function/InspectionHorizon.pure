function {meta::pure::profiles::doc.doc = 'Opens an inspection window one month before the date it is anchored on, so a segment walked shortly before the anchor still counts as inspected.'} test::frostedthistle3::function::inspectionHorizon(anchor: StrictDate[1]): StrictDate[1]
{
  $anchor->adjust(-1, meta::pure::functions::date::DurationUnit.MONTHS)->cast(@StrictDate)
}
