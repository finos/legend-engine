###Pure
import test::crimsonisle5::domain::*;

Class {meta::pure::profiles::doc.doc = 'One seabird census sweep of a nesting plot, keyed on its own reference and reaching the plot it was taken on over a declared equality join.'} test::crimsonisle5::domain::PlotCensus
{
  censusRef: String[1];
  plotCode: String[1];
  nestCount: Integer[1];
  fledgedCount: Integer[1];
  surveyedOn: StrictDate[1];
  unfledgedCount: Integer[0..1];
  effortIndex: Integer[0..1];
  plotLabel: String[0..1];
  plot: IslePlot[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A nesting plot on the isle, reached from the census extent and carried by its own table so a plot with no sweep never surfaces through the join.'} test::crimsonisle5::domain::IslePlot
{
  plotCode: String[1];
  plotName: String[1];
  habitatCode: String[1];
}

Class {meta::pure::profiles::doc.doc = 'An inbound census payload as the field recorders hand it over, nested and loosely typed, refined into a published digest by a model-to-model mapping.'} test::crimsonisle5::domain::CensusPayload
{
  censusRef: String[0..1];
  revision: Integer[0..1];
  record: CensusRecord[0..1];
}

Class {meta::pure::profiles::doc.doc = 'The recorded body of an inbound census payload.'} test::crimsonisle5::domain::CensusRecord
{
  observerCode: String[0..1];
  nestCount: Integer[0..1];
  fledgedCount: Integer[0..1];
  plot: PayloadPlot[0..1];
}

Class {meta::pure::profiles::doc.doc = 'The plot block carried inside an inbound census payload.'} test::crimsonisle5::domain::PayloadPlot
{
  plotName: String[0..1];
  habitatCode: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'The published digest of a census payload, whose brood band and observer label are derived rather than carried.'} test::crimsonisle5::domain::CensusDigest
{
  censusRef: String[1];
  observerLabel: String[1];
  broodBand: String[1];
  plotView: PlotDigest[0..1];
}

Class {meta::pure::profiles::doc.doc = 'The plot view nested inside a published census digest.'} test::crimsonisle5::domain::PlotDigest
{
  plotName: String[0..1];
  habitatHint: String[1];
}
