###Pure
import meta::pure::profiles::*;

Class {doc.doc = 'A wheel of cheese ripening in the cave cellar.'} test::lunarmeadow::domain::CheeseWheel
{
  wheelId: Integer[1];
  wheelCode: String[1];
  milkType: String[1];
  formedOn: StrictDate[1];
  weightGrams: Integer[1];
  chamberName: String[1];
  humidityPct: Integer[1];
  makerName: String[1];
  rack: test::lunarmeadow::domain::RipeningRack[1];
}

Class {doc.doc = 'A ripening rack holding wheels inside one cave chamber.'} test::lunarmeadow::domain::RipeningRack
{
  rackCode: String[1];
  rackTier: Integer[1];
}

Class {doc.doc = 'A climate-controlled chamber of the ripening cave.'} test::lunarmeadow::domain::CaveChamber
{
  chamberCode: String[1];
  chamberName: String[1];
  humidityPct: Integer[1];
  tempCelsius: Integer[1];
}

Class {doc.doc = 'A cheesemaker accountable for the racks in a chamber.'} test::lunarmeadow::domain::Cheesemaker
{
  makerCode: String[1];
  makerName: String[1];
  certifiedOn: StrictDate[1];
}
