###Service
Service test::lunarmeadow::service::RipeningWheelsGraded
{
  pattern: '/lunarmeadow/v1/ripening-wheels-graded/{chamberPrefix}/{minAgeDays}';
  title: 'Lunar Meadow - Ripening Wheels By Chamber';
  owners:
  [
    'cave-cellar-registry',
    'creamery-eng'
  ];
  documentation: 'Single-execution counterpart of the keyed ripening-wheels service, pinned to the primary runtime and carrying the tested suite for the ripeness predicate, the chamber-prefix or upper-tier disjunction and the two multi-hop join paths.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {chamberPrefix: String[1], minAgeDays: Integer[1], currentDate: StrictDate[1]|test::lunarmeadow::domain::CheeseWheel.all()->filter(
      w|((($w.formedOn->dateDiff($currentDate, meta::pure::functions::date::DurationUnit.DAYS) >= $minAgeDays) && ($w.milkType->in(['GOAT', 'SHEEP', 'COW']))) && ((($w.chamberName->toUpper()->startsWith($chamberPrefix)) || ($w.rack.rackTier > 2)) && ((($w.weightGrams + 500) / 1000) >= 1)))
    )->project(
      [
        w|$w.wheelCode,
        w|$w.milkType->toLower(),
        w|$w.chamberName,
        w|$w.makerName,
        w|$w.wheelCode->length()
      ],
      [
        'WheelCode',
        'MilkType',
        'Chamber',
        'Maker',
        'CodeLen'
      ]
    )->distinct()->sort([asc('WheelCode')])->take(50)};
    mapping: test::lunarmeadow::mapping::CellarMapping;
    runtime: test::lunarmeadow::runtime::CellarPrimaryRuntime;
  }
  testSuites:
  [
    ripenessSuite:
    {
      data:
      [
        connections:
        [
          cellarConnection:
            Relational
            #{
              dairy.wheel:
                'wheel_id,wheel_code,milk_type,rack_code,formed_on,weight_grams\n'+
                '1,W-001,GOAT,R1,2024-01-10,4200\n'+
                '2,W-002,SHEEP,R2,2024-02-15,5100\n'+
                '3,W-003,COW,R1,2024-03-20,9800\n'+
                '4,W-004,GOAT,R3,2025-06-01,3000\n'+
                '5,W-005,BUFFALO,R4,2024-04-05,2500\n'+
                '6,W-006,GOAT,R1,2099-01-01,6000\n';

              dairy.rack:
                'rack_code,chamber_code,maker_code,rack_tier\n'+
                'R1,C-NORTH,M1,1\n'+
                'R2,C-SOUTH,M2,3\n'+
                'R3,C-NORTH,M1,2\n'+
                'R4,C-WEST,M3,4\n';

              cellar.chamber:
                'chamber_code,chamber_name,humidity_pct,temp_celsius\n'+
                'C-NORTH,NORTHVAULT,88,11\n'+
                'C-SOUTH,SOUTHVAULT,84,13\n'+
                'C-WEST,WESTVAULT,80,12\n';

              roster.cheesemaker:
                'maker_code,maker_name,certified_on\n'+
                'M1,Rowan Pike,2019-05-01\n'+
                'M2,Ines Fell,2021-08-12\n'+
                'M3,Tomas Kerr,2020-02-02\n';
            }#
        ]
      ]
      tests:
      [
        northChamberRipe:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            chamberPrefix = 'NORTH',
            minAgeDays = 30,
            currentDate = %2026-08-01
          ]
          asserts:
          [
            keepsNorthVaultAndUpperTier:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"WheelCode":"W-001","MilkType":"goat","Chamber":"NORTHVAULT","Maker":"Rowan Pike","CodeLen":5},{"WheelCode":"W-002","MilkType":"sheep","Chamber":"SOUTHVAULT","Maker":"Ines Fell","CodeLen":5},{"WheelCode":"W-003","MilkType":"cow","Chamber":"NORTHVAULT","Maker":"Rowan Pike","CodeLen":5},{"WheelCode":"W-004","MilkType":"goat","Chamber":"NORTHVAULT","Maker":"Rowan Pike","CodeLen":5}]';
                  }#;
              }#
          ]
        },
        westChamberRipe:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            chamberPrefix = 'WEST',
            minAgeDays = 30,
            currentDate = %2026-08-01
          ]
          asserts:
          [
            keepsOnlyUpperTierWheel:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"WheelCode":"W-002","MilkType":"sheep","Chamber":"SOUTHVAULT","Maker":"Ines Fell","CodeLen":5}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
