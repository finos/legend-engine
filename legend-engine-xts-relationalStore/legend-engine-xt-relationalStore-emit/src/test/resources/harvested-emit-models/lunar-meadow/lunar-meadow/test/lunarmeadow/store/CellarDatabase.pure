###Relational
Database test::lunarmeadow::store::CellarDatabase
(
  Schema dairy
  (
    Table wheel
    (
      wheel_id INTEGER PRIMARY KEY,
      wheel_code VARCHAR(24) NOT NULL,
      milk_type VARCHAR(16) NOT NULL,
      rack_code VARCHAR(16) NOT NULL,
      formed_on DATE NOT NULL,
      weight_grams INTEGER NOT NULL
    )

    Table rack
    (
      rack_code VARCHAR(16) PRIMARY KEY,
      chamber_code VARCHAR(16) NOT NULL,
      maker_code VARCHAR(16) NOT NULL,
      rack_tier INTEGER NOT NULL
    )
  )

  Schema cellar
  (
    Table chamber
    (
      chamber_code VARCHAR(16) PRIMARY KEY,
      chamber_name VARCHAR(32) NOT NULL,
      humidity_pct INTEGER NOT NULL,
      temp_celsius INTEGER NOT NULL
    )
  )

  Schema roster
  (
    Table cheesemaker
    (
      maker_code VARCHAR(16) PRIMARY KEY,
      maker_name VARCHAR(64) NOT NULL,
      certified_on DATE NOT NULL
    )
  )

  Join Wheel_Rack(dairy.wheel.rack_code = dairy.rack.rack_code)
  Join Rack_Chamber(dairy.rack.chamber_code = cellar.chamber.chamber_code)
  Join Rack_Maker(dairy.rack.maker_code = roster.cheesemaker.maker_code)
)
