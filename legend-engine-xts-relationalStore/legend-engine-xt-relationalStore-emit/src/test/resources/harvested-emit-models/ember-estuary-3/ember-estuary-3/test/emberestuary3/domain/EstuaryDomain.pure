###Pure
Class {meta::pure::profiles::doc.doc = 'One water level read off a tide gauge on one estuary tide, held against the code of the gauge that produced it.'} test::emberestuary3::domain::GaugeReading
{
  readingCode: String[1];
  gaugeCode: String[1];
  readOn: StrictDate[1];
  waterLevelMetres: Decimal[1];
  surgeMetres: Decimal[0..1];
  readingNote: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A tide gauge installed on one reach of the estuary, mapped onto its own main table beside the readings it produces.'} test::emberestuary3::domain::TideGauge
{
  gaugeCode: String[1];
  gaugeName: String[1];
  reachName: String[1];
  datumMetres: Decimal[0..1];
}
