###Data
Data test::emberestuary3::data::GaugeReadingData
{
  Relational
  #{
    estuary.tide_gauge:
      'gauge_id,gauge_code,gauge_name,reach_name,datum_metres\n'+
      '1,TG-01,Outer Sill Gauge,North Reach,2.500\n'+
      '2,TG-02,Inner Basin Gauge,South Reach,\n';

    estuary.gauge_reading:
      'reading_id,reading_code,gauge_code,read_on,water_level_metres,surge_metres,reading_note\n'+
      '1,GR-0001,TG-01,2026-04-01,4.250,0.400,Spring tide crest\n'+
      '2,GR-0002,TG-01,2026-04-02,3.900,,\n'+
      '3,GR-0003,TG-02,2026-04-01,2.750,0.150,Wind against the ebb\n'+
      '4,GR-0004,TG-02,2026-04-03,2.100,0.050,\n';
  }#
}
