###Relational
Database test::emberestuary3::store::EstuaryDb
(
  Schema estuary
  (
    Table gauge_reading
    (
      reading_id INTEGER PRIMARY KEY,
      reading_code VARCHAR(24) NOT NULL,
      gauge_code VARCHAR(24) NOT NULL,
      read_on DATE NOT NULL,
      water_level_metres DECIMAL(9, 3) NOT NULL,
      surge_metres DECIMAL(9, 3),
      reading_note VARCHAR(160)
    )

    Table tide_gauge
    (
      gauge_id INTEGER PRIMARY KEY,
      gauge_code VARCHAR(24) NOT NULL,
      gauge_name VARCHAR(120) NOT NULL,
      reach_name VARCHAR(60) NOT NULL,
      datum_metres DECIMAL(9, 3)
    )
  )
)
