###Pure
import demo::crimsonprairie2::domain::*;

Enum demo::crimsonprairie2::domain::CoverBand
{
  TALLGRASS,
  MIXEDGRASS,
  SHORTGRASS
}

Class <<temporal.bitemporal>> demo::crimsonprairie2::domain::BurnUnit
{
  unitCode: String[1];
  unitName: String[1];
  coverBand: CoverBand[1];
  moistureIndex: Integer[1];
  moistureNote: String[1];
  breakFlag: String[1];
  gradeFlag: String[1];
  tierFlag: String[1];
  seedFlag: String[1];
  grazeFlag: String[1];
  markerLabel: String[0..1];
  regionName: String[0..1];
  parentName: String[0..1];
  ancestorName: String[0..1];
  ancestorSteward: String[0..1];
  ancestorOffice: String[0..1];
}
