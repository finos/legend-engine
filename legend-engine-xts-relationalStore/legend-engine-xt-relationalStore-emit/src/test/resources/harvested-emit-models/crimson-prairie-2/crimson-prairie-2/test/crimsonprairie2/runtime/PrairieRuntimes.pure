###Runtime
Runtime demo::crimsonprairie2::runtime::PrairieFieldRuntime
{
  mappings:
  [
    demo::crimsonprairie2::mapping::PrairieMapping
  ];
  connections:
  [
    demo::crimsonprairie2::store::PrairieRangeDatabase:
    [
      prairieField: demo::crimsonprairie2::connection::PrairieFieldConnection
    ]
  ];
}

###Runtime
Runtime demo::crimsonprairie2::runtime::PrairieArchiveRuntime
{
  mappings:
  [
    demo::crimsonprairie2::mapping::PrairieMapping
  ];
  connections:
  [
    demo::crimsonprairie2::store::PrairieRangeDatabase:
    [
      prairieArchive: demo::crimsonprairie2::connection::PrairieArchiveConnection
    ]
  ];
}
