###Pure
import test::cobaltreef2::domain::*;

Class test::cobaltreef2::domain::CanopyPlot
{
  plotCode: String[1];
  avenueName: String[1];
  surveyNote: String[0..1];
  inspectionId: Integer[1];
  regionName: String[1];
}

Class test::cobaltreef2::domain::CanopyInspection
{
  inspectionCode: String[1];
  plotCode: String[1];
  crewCode: String[1];
  inspectionNote: String[0..1];
  depotRegion: String[1];
}

Class test::cobaltreef2::domain::SurveyCrew
{
  crewCode: String[1];
  crewName: String[1];
  depotCode: String[1];
}
