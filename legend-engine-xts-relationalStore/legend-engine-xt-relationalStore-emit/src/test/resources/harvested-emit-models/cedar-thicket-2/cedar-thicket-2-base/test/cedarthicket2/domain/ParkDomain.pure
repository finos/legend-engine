###Pure
import test::cedarthicket2::domain::*;

Class test::cedarthicket2::domain::TrailRun
{
  runId: Integer[1];
  trailCode: String[1];
  trailName: String[1];
  eventOn: StrictDate[1];
  snapshotTag: String[1];
  distanceMetres: Integer[0..1];
  surfaceLabel: String[0..1];
}

Class test::cedarthicket2::domain::StayIdentifier
{
  registryCode: String[0..1];
  permitRef: String[0..1];
  sequenceNo: Integer[0..1];
}

Class test::cedarthicket2::domain::ShelterStay
{
  stayId: Integer[1];
  shelterCode: String[1];
  shelterName: String[1];
  zoneCode: String[0..1];
  partySize: Integer[0..1];
  nightsBooked: Integer[0..1];
  validThru: DateTime[1];
  stayLabel: String[0..1];
  identifier: StayIdentifier[0..1];
}
