###Relational
Database test::lunarreef2::store::ReefLogDb
(
  Schema reeflog
  (
    Table transect_log
    (
      log_id INTEGER PRIMARY KEY,
      transect_code VARCHAR(24),
      reef_label VARCHAR(80),
      shore_zone VARCHAR(40),
      depth_text VARCHAR(24),
      surveyor_names VARCHAR(200),
      colony_tally INTEGER,
      grade_code VARCHAR(8)
    )
    Table sector_note
    (
      note_id INTEGER PRIMARY KEY,
      transect_code VARCHAR(24),
      sector_label VARCHAR(80),
      tally_text VARCHAR(24),
      roster_size INTEGER
    )
  )
)
