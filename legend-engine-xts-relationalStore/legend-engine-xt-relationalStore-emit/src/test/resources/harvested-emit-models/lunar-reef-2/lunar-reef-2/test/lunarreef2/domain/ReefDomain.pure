###Pure
import test::lunarreef2::domain::*;

Enum test::lunarreef2::domain::HealthGrade
{
  THRIVING,
  STABLE,
  BLEACHING,
  DEGRADED
}

Class test::lunarreef2::domain::TransectFeed
{
  feedRow: String[1];
  gradeCode: String[1];
  colonyTallies: Integer[*];
  surveyorNames: String[*];
  depthReading: Number[0..1];
}

Class test::lunarreef2::domain::ReefTransect
{
  transectCode: String[1];
  reefLabel: String[1];
  shoreZone: String[1];
  depthTag: String[0..1];
  surveyorRoster: String[1];
  colonyTotal: Integer[1];
  healthGrade: HealthGrade[1];
}

Class test::lunarreef2::domain::ColonyDigest
{
  digestKey: String[1];
  tallyBand: String[1];
  rosterSize: Integer[1];
}
