###Service
Service test::verdantgecko2::service::StopRegister
{
  pattern: '/tramnet/v1/stop-register';
  title: 'Tram Network Registry - Stop Register';
  ownership: DID { identifier: 'tram-network-registry-office' };
  documentation: 'Publishes the currently valid stops as a flat table, reaching the line, the stabling depot and the sector group of each stop through two and three chained association ends over validity-filtered views.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: |test::verdantgecko2::domain::TramStop.all()->project(
      [
        s|$s.stopId,
        s|$s.stopName,
        s|$s.openedOn,
        s|$s.platformLengthM,
        s|$s.line.lineCode,
        s|$s.line.depot.depotName,
        s|$s.sector.sectorName,
        s|$s.sector.sectorGroup.groupName
      ],
      [
        'StopId',
        'StopName',
        'OpenedOn',
        'PlatformLengthM',
        'LineCode',
        'DepotName',
        'SectorName',
        'GroupName'
      ]
    );
    mapping: test::verdantgecko2::mapping::TramNetworkMapping;
    runtime: test::verdantgecko2::runtime::TramNetworkRuntime;
  }
  testSuites:
  [
    stopRegisterSuite:
    {
      data:
      [
        connections:
        [
          registryConnection:
            Relational
            #{
              network.depot:
                'depot_id,depot_name,borough_name,bay_count,amended_by,valid_from,valid_thru\n'+
                '1,Willowbank Depot,Northgate,14,planner.a,2020-01-01 00:00:00,9999-12-31 00:00:00\n';

              network.tram_line:
                'line_id,depot_id,line_code,line_name,night_service,amended_by,valid_from,valid_thru\n'+
                '10,1,L4,Willowbank Loop,YES,planner.a,2020-01-01 00:00:00,9999-12-31 00:00:00\n';

              network.sector_group:
                'group_id,group_name,parent_group_name,amended_by,valid_from,valid_thru\n'+
                '30,Inner Ring,City Network,planner.c,2020-01-01 00:00:00,9999-12-31 00:00:00\n';

              network.stop_sector:
                'sector_id,group_id,sector_name,amended_by,valid_from,valid_thru\n'+
                '20,30,Northgate Quarter,planner.c,2020-01-01 00:00:00,9999-12-31 00:00:00\n';

              network.tram_stop:
                'stop_id,line_id,sector_id,stop_name,platform_length_m,opened_on,amended_by,valid_from,valid_thru\n'+
                '40,10,20,Willowbank Gardens,32.5,1996-04-02,planner.a,2020-01-01 00:00:00,9999-12-31 00:00:00\n'+
                '41,10,20,Kiln Road Sidings,12.0,1988-09-14,planner.b,2020-01-01 00:00:00,9999-12-31 00:00:00\n';
            }#
        ]
      ]
      tests:
      [
        longPlatformStopRow:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            oneLongPlatformStop:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"StopId":40,"StopName":"Willowbank Gardens","OpenedOn":"1996-04-02","PlatformLengthM":32.5,"LineCode":"L4","DepotName":"Willowbank Depot","SectorName":"Northgate Quarter","GroupName":"Inner Ring"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
