###Mapping
Mapping test::verdantgecko2::mapping::TramNetworkMapping
(
  *test::verdantgecko2::domain::Depot[depot]: Relational
  {
    ~primaryKey
    (
      [test::verdantgecko2::store::TramNetworkDB]network.current_depot.depot_id
    )
    ~mainTable [test::verdantgecko2::store::TramNetworkDB]network.current_depot
    depotId: [test::verdantgecko2::store::TramNetworkDB]network.current_depot.depot_id,
    depotName: [test::verdantgecko2::store::TramNetworkDB]network.current_depot.depot_name,
    boroughName: [test::verdantgecko2::store::TramNetworkDB]network.current_depot.borough_name,
    bayCount: [test::verdantgecko2::store::TramNetworkDB]network.current_depot.bay_count
  }

  *test::verdantgecko2::domain::TramLine[line]: Relational
  {
    ~primaryKey
    (
      [test::verdantgecko2::store::TramNetworkDB]network.current_line.line_id
    )
    ~mainTable [test::verdantgecko2::store::TramNetworkDB]network.current_line
    lineId: [test::verdantgecko2::store::TramNetworkDB]network.current_line.line_id,
    lineCode: [test::verdantgecko2::store::TramNetworkDB]network.current_line.line_code,
    lineName: [test::verdantgecko2::store::TramNetworkDB]network.current_line.line_name,
    nightService: [test::verdantgecko2::store::TramNetworkDB]network.current_line.night_service
  }

  *test::verdantgecko2::domain::TramStop[stop]: Relational
  {
    ~primaryKey
    (
      [test::verdantgecko2::store::TramNetworkDB]network.current_stop.stop_id
    )
    ~mainTable [test::verdantgecko2::store::TramNetworkDB]network.current_stop
    stopId: [test::verdantgecko2::store::TramNetworkDB]network.current_stop.stop_id,
    stopName: [test::verdantgecko2::store::TramNetworkDB]network.current_stop.stop_name,
    platformLengthM: [test::verdantgecko2::store::TramNetworkDB]network.current_stop.platform_length_m,
    openedOn: [test::verdantgecko2::store::TramNetworkDB]network.current_stop.opened_on
  }

  *test::verdantgecko2::domain::StopSector[sector]: Relational
  {
    ~primaryKey
    (
      [test::verdantgecko2::store::TramNetworkDB]network.current_sector.sector_id
    )
    ~mainTable [test::verdantgecko2::store::TramNetworkDB]network.current_sector
    sectorId: [test::verdantgecko2::store::TramNetworkDB]network.current_sector.sector_id,
    sectorName: [test::verdantgecko2::store::TramNetworkDB]network.current_sector.sector_name
  }

  *test::verdantgecko2::domain::SectorGroup[sectorGroup]: Relational
  {
    ~primaryKey
    (
      [test::verdantgecko2::store::TramNetworkDB]network.current_group.group_id
    )
    ~mainTable [test::verdantgecko2::store::TramNetworkDB]network.current_group
    groupId: [test::verdantgecko2::store::TramNetworkDB]network.current_group.group_id,
    groupName: [test::verdantgecko2::store::TramNetworkDB]network.current_group.group_name,
    parentGroupName: [test::verdantgecko2::store::TramNetworkDB]network.current_group.parent_group_name
  }

  *test::verdantgecko2::domain::TramVehicle[vehicle]: Relational
  {
    ~primaryKey
    (
      [test::verdantgecko2::store::TramNetworkDB]network.current_vehicle.vehicle_id
    )
    ~mainTable [test::verdantgecko2::store::TramNetworkDB]network.current_vehicle
    vehicleId: [test::verdantgecko2::store::TramNetworkDB]network.current_vehicle.vehicle_id,
    fleetNumber: [test::verdantgecko2::store::TramNetworkDB]network.current_vehicle.fleet_number,
    seatCount: [test::verdantgecko2::store::TramNetworkDB]network.current_vehicle.seat_count,
    axleLoadT: [test::verdantgecko2::store::TramNetworkDB]network.current_vehicle.axle_load_t
  }

  *test::verdantgecko2::domain::ServicePeriod[period]: Relational
  {
    ~primaryKey
    (
      [test::verdantgecko2::store::TramNetworkDB]network.current_period.period_id
    )
    ~mainTable [test::verdantgecko2::store::TramNetworkDB]network.current_period
    periodId: [test::verdantgecko2::store::TramNetworkDB]network.current_period.period_id,
    periodName: [test::verdantgecko2::store::TramNetworkDB]network.current_period.period_name,
    opensOn: [test::verdantgecko2::store::TramNetworkDB]network.current_period.opens_on,
    closesOn: [test::verdantgecko2::store::TramNetworkDB]network.current_period.closes_on
