###Pure
Enum {meta::pure::profiles::doc.doc = 'How recently a prairie plot was last put through a management burn.'} test::quietprairie4::domain::BurnState
{
  RECENT,
  RESTED,
  UNBURNT
}

Class {meta::pure::profiles::doc.doc = 'A grassland plot of the prairie reserve, carrying the seed lifted off it and the burn state it stands in.'} test::quietprairie4::domain::GrassPlot
{
  plotCode: String[1];
  plotName: String[1];
  seedKg: Float[1];
  burnState: test::quietprairie4::domain::BurnState[1];
  tractName: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A submitted seed-return document standing for one grassland plot before it is folded into the reserve digest.'} test::quietprairie4::domain::PlotReturn
{
  plotCode: String[0..1];
  plotName: String[0..1];
  seedKg: Float[0..1];
  burnCode: String[0..1];
  collectorCode: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'The digested form of a submitted seed return, with its label built up and its seed weight carried in grams.'} test::quietprairie4::domain::PlotDigest
{
  digestCode: String[1];
  digestLabel: String[1];
  seedGrams: Float[1];
  burnState: test::quietprairie4::domain::BurnState[1];
}
