###Relational
Database test::quietprairie4::store::PrairieDb
(
  Schema prairie
  (
    Table grass_plot
    (
      plot_id INTEGER PRIMARY KEY,
      plot_code VARCHAR(24) NOT NULL,
      plot_name VARCHAR(80) NOT NULL,
      seed_kg DOUBLE NOT NULL,
      burn_state_code VARCHAR(4) NOT NULL,
      tract_code VARCHAR(24) NOT NULL
    )

    Table prairie_tract
    (
      tract_code VARCHAR(24) PRIMARY KEY,
      tract_name VARCHAR(80) NOT NULL
    )
  )

  Join Plot_Tract(prairie.grass_plot.tract_code = prairie.prairie_tract.tract_code)
)
