###Runtime
Runtime test::lunarlagoon3::runtime::GaugeH2Runtime
{
  mappings:
  [
    test::lunarlagoon3::mapping::GaugeMapping
  ];
  connections:
  [
    test::lunarlagoon3::store::GaugeDb:
    [
      h2Connection: test::lunarlagoon3::connection::GaugeH2Connection
    ]
  ];
}

Runtime test::lunarlagoon3::runtime::GaugeUpstreamRuntime
{
  mappings:
  [
    test::lunarlagoon3::mapping::GaugeMapping
  ];
  connections:
  [
    test::lunarlagoon3::store::GaugeDb:
    [
      upstreamConnection: test::lunarlagoon3::connection::GaugeUpstreamConnection
    ]
  ];
}

Runtime test::lunarlagoon3::runtime::GaugeArchiveRuntime
{
  mappings:
  [
    test::lunarlagoon3::mapping::GaugeMapping
  ];
  connections:
  [
    test::lunarlagoon3::store::GaugeDb:
    [
      archiveConnection: test::lunarlagoon3::connection::GaugeArchiveConnection
    ]
  ];
}
