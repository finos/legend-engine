###Relational
Database test::lunarlagoon3::store::GaugeDb
(
  Schema tidewatch
  (
    Table gauge_station
    (
      station_code VARCHAR(24) PRIMARY KEY,
      station_name VARCHAR(120) NOT NULL,
      district_code VARCHAR(16) NOT NULL,
      station_kind VARCHAR(16) NOT NULL
    )

    Table gauge_reading
    (
      reading_code VARCHAR(24) PRIMARY KEY,
      station_code VARCHAR(24) NOT NULL,
      reading_state VARCHAR(16) NOT NULL,
      sensor_code VARCHAR(24) NOT NULL,
      water_level_cm INTEGER NOT NULL,
      salinity_ppt INTEGER NOT NULL,
      taken_on DATE NOT NULL
    )
  )

  Join Station_Reading(tidewatch.gauge_station.station_code = tidewatch.gauge_reading.station_code)
)
