###Service
Service test::lunarlagoon3::service::GaugeSensorRoster
{
  pattern: '/lunarlagoon/v1/sensor-roster/{districtCode}';
  title: 'Tidewatch - District Sensor Roster';
  documentation: 'Rosters the distinct working sensors that reported into one district, keeping a reading either when it is accepted at a gauge other than the retired sluice or when it is still held, so the generated plan carries a disjunction beneath a duplicate-free projection.';
  autoActivateUpdates: false;
  ownership: UserList { users: ['tidewatch-survey-desk'] };
  execution: Single
  {
    query: {districtCode: String[1]|test::lunarlagoon3::domain::GaugeReading.all()->filter(
      r|(!($r.sensorCode->in(['XS-1', 'XS-2']))) && ((($r.readingState == 'ACCEPTED') && (($r.stationName->toOne() != 'Old Sluice') && ($r.districtCode->toOne() == $districtCode))) || ($r.readingState == 'HELD'))
    )->project(
      [
        r|$r.districtCode,
        r|$r.sensorCode
      ],
      [
        'District',
        'Sensor'
      ]
    )->distinct()->sort(
      [
        asc('District'),
        asc('Sensor')
      ]
    )};
    mapping: test::lunarlagoon3::mapping::GaugeMapping;
    runtime: test::lunarlagoon3::runtime::GaugeH2Runtime;
  }
  testSuites:
  [
    sensorRosterSuite:
    {
      data:
      [
        connections:
        [
          h2Connection: Reference
            #{
              test::lunarlagoon3::data::GaugeTestData
            }#
        ]
      ]
      tests:
      [
        workingSensorsOfTheNorthDistrictOnly:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            districtCode = 'DC-N'
          ]
          asserts:
          [
            spareSensorsAndOtherDistrictsNeverReachTheRoster:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"District":"DC-N","Sensor":"SN-1"},{"District":"DC-N","Sensor":"SN-2"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
