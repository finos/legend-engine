###Connection
RelationalDatabaseConnection test::lunarlagoon3::connection::GaugeH2Connection
{
  store: test::lunarlagoon3::store::GaugeDb;
  type: H2;
  specification: LocalH2 { testDataSetupSqls: []; };
  auth: DefaultH2;
}

RelationalDatabaseConnection test::lunarlagoon3::connection::GaugeUpstreamConnection
{
  store: test::lunarlagoon3::store::GaugeDb;
  type: MemSQL;
  specification: Static
  {
    name: 'lunar_lagoon_tidewatch_upstream';
    host: 'example-tidewatch-upstream-host';
    port: 3306;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'tidewatchupstreamprincipal';
  };
}

RelationalDatabaseConnection test::lunarlagoon3::connection::GaugeArchiveConnection
{
  store: test::lunarlagoon3::store::GaugeDb;
  type: MemSQL;
  specification: Static
  {
    name: 'lunar_lagoon_tidewatch_archive';
    host: 'example-tidewatch-archive-host';
    port: 3306;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'tidewatcharchiveprincipal';
  };
}
