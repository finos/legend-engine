###Mapping
Mapping test::goldenquokka2::mapping::ReserveSouthMapping
(
  include mapping test::goldenquokka2::mapping::ReserveEnumMappings
  include mapping test::goldenquokka2::mapping::ReserveReferenceMapping

  *test::goldenquokka2::domain::Burrow[burrow]: Relational
  {
    ~primaryKey
    (
      [test::goldenquokka2::store::ReserveDb]south.burrow.burrow_code
    )
    ~mainTable [test::goldenquokka2::store::ReserveDb]south.burrow
    burrowCode: [test::goldenquokka2::store::ReserveDb]south.burrow.burrow_code,
    burrowName: [test::goldenquokka2::store::ReserveDb]south.burrow.burrow_name,
    zoneCode: [test::goldenquokka2::store::ReserveDb]south.burrow.zone_code,
    entranceCount: [test::goldenquokka2::store::ReserveDb]south.burrow.entrance_count,
    condition: EnumerationMapping ConditionMapping: case(
                 equal([test::goldenquokka2::store::ReserveDb]south.burrow.condition_code, '-'),
                 'Z',
                 trim([test::goldenquokka2::store::ReserveDb]south.burrow.condition_code)
               ),
    conditionNote: case(
                     equal([test::goldenquokka2::store::ReserveDb]south.burrow.condition_code, 'A'),
                     'SOUND CHAMBER',
                     case(
                       equal([test::goldenquokka2::store::ReserveDb]south.burrow.condition_code, 'B'),
                       'SETTLING FLOOR',
                       case(
                         equal([test::goldenquokka2::store::ReserveDb]south.burrow.condition_code, 'C'),
                         'MINOR COLLAPSE',
                         case(
                           equal([test::goldenquokka2::store::ReserveDb]south.burrow.condition_code, 'D'),
                           'MAJOR COLLAPSE',
                           case(
                             equal([test::goldenquokka2::store::ReserveDb]south.burrow.condition_code, 'E'),
                             'FLOOD WATCH',
                             case(
                               equal([test::goldenquokka2::store::ReserveDb]south.burrow.condition_code, 'F'),
                               'SILT CLEARANCE',
                               case(
                                 equal([test::goldenquokka2::store::ReserveDb]south.burrow.condition_code, 'G'),
                                 concat('ABANDONED-', [test::goldenquokka2::store::ReserveDb]south.burrow.burrow_code),
                                 case(
                                   equal([test::goldenquokka2::store::ReserveDb]south.burrow.condition_code, 'H'),
                                   'REOCCUPIED - LOG',
                                   sqlNull()
                                 )
                               )
                             )
                           )
                         )
                       )
                     )
                   ),
    siltNote: case(
                equal([test::goldenquokka2::store::ReserveDb]south.burrow.silt_note, '-1'),
                sqlNull(),
                [test::goldenquokka2::store::ReserveDb]south.burrow.silt_note
              ),
    labelText: concat(
                 concat(
                   toUpper(trim([test::goldenquokka2::store::ReserveDb]south.burrow.burrow_name)),
                   '-'
                 ),
                 [test::goldenquokka2::store::ReserveDb]south.burrow.burrow_code
               ),
    speciesCommonName: [test::goldenquokka2::store::ReserveDb]@South_Burrow_Species | [test::goldenquokka2::store::ReserveDb]ref.species_reference.common_name
  }

  *test::goldenquokka2::domain::HabitatZone[zone]: Relational
  {
    ~primaryKey
    (
      [test::goldenquokka2::store::ReserveDb]south.habitat_zone.zone_code
    )
    ~mainTable [test::goldenquokka2::store::ReserveDb]south.habitat_zone
    zoneCode: [test::goldenquokka2::store::ReserveDb]south.habitat_zone.zone_code,
    zoneName: [test::goldenquokka2::store::ReserveDb]south.habitat_zone.zone_name,
    hectares: [test::goldenquokka2::store::ReserveDb]south.habitat_zone.hectares,
    kind: EnumerationMapping HabitatKindMapping: trim([test::goldenquokka2::store::ReserveDb]south.habitat_zone.kind_code)
  }

  *test::goldenquokka2::domain::BurrowInspection[inspection]: Relational
  {
    ~primaryKey
    (
      [test::goldenquokka2::store::ReserveDb]south.burrow_inspection.inspection_code
    )
    ~mainTable [test::goldenquokka2::store::ReserveDb]south.burrow_inspection
    inspectionCode: [test::goldenquokka2::store::ReserveDb]south.burrow_inspection.inspection_code,
    burrowCode: [test::goldenquokka2::store::ReserveDb]south.burrow_inspection.burrow_code,
    inspectedOn: [test::goldenquokka2::store::ReserveDb]south.burrow_inspection.inspected_on,
    depthCm: [test::goldenquokka2::store::ReserveDb]south.burrow_inspection.depth_cm,
    wardenGrade: EnumerationMapping WardenGradeMapping: trim([test::goldenquokka2::store::ReserveDb]south.burrow_inspection.warden_grade_code)
  }

  *test::goldenquokka2::domain::ForageRecord[forage]: Relational
  {
    ~primaryKey
    (
      [test::goldenquokka2::store::ReserveDb]south.forage_record.record_code
    )
    ~mainTable [test::goldenquokka2::store::ReserveDb]south.forage_record
    recordCode: [test::goldenquokka2::store::ReserveDb]south.forage_record.record_code,
    burrowCode: [test::goldenquokka2::store::ReserveDb]south.forage_record.burrow_code,
    grams: [test::goldenquokka2::store::ReserveDb]south.forage_record.grams,
    quality: EnumerationMapping ForageQualityMapping: trim([test::goldenquokka2::store::ReserveDb]south.forage_record.quality_code)
  }

  test::goldenquokka2::domain::Burrow_Inspections: Relational
  {
    AssociationMapping
    (
      inspections[burrow, inspection]: [test::goldenquokka2::store::ReserveDb]@South_Burrow_Inspection,
      burrow[inspection, burrow]: [test::goldenquokka2::store::ReserveDb]@South_Burrow_Inspection
    )
  }

  test::goldenquokka2::domain::Burrow_Species: Relational
  {
    AssociationMapping
    (
      species[burrow, species]: [test::goldenquokka2::store::ReserveDb]@South_Burrow_Species,
      burrows[species, burrow]: [test::goldenquokka2::store::ReserveDb]@South_Burrow_Species
    )
  }

  test::goldenquokka2::domain::Inspection_Warden: Relational
  {
    AssociationMapping
    (
      warden[inspection, warden]: [test::goldenquokka2::store::ReserveDb]@South_Inspection_Warden,
      wardenInspections[warden, inspection]: [test::goldenquokka2::store::ReserveDb]@South_Inspection_Warden
    )
  }

  test::goldenquokka2::domain::Forage_Species: Relational
  {
    AssociationMapping
    (
      forageSpecies[forage, species]: [test::goldenquokka2::store::ReserveDb]@South_Forage_Species,
      forageRecords[species, forage]: [test::goldenquokka2::store::ReserveDb]@South_Forage_Species
    )
  }

  testSuites:
  [
    southSegmentDerivationSuite:
    {
      function: |test::goldenquokka2::domain::Burrow.all()->project(
  [
    b|$b.burrowCode,
    b|$b.condition,
    b|$b.conditionNote,
    b|$b.siltNote,
    b|$b.speciesCommonName
  ],
  [
    'BurrowCode',
    'Condition',
    'ConditionNote',
    'SiltNote',
    'Species'
  ]
)->sort(
  [
    asc('BurrowCode')
  ]
);
      tests:
      [
        theSecondSegmentDerivesIdenticallyFromItsOwnSchema:
        {
          doc: 'Runs the same derivation against the second segment mapping, whose transform logic is byte-for-byte identical to the first and differs only in the physical schema its aliases and joins point at, so the parallel schema variant is proven to carry the same semantics over its own copy of the layout.';
          data:
          [
            test::goldenquokka2::store::ReserveDb:
              Relational
              #{
                south.burrow:
                  'burrow_code,burrow_name,zone_code,species_code,sector_code,condition_code,entrance_count,silt_note\n'+
                  'BR-51,Salt Warren,ZS-01,SP-01,SC-03,C,3,silted rim\n'+
                  'BR-52,Tussock Warren,ZS-01,SP-02,SC-03,Z,2,unclassified\n'+
                  'BR-53,Basin Warren,ZS-02,SP-01,SC-03,A,4,-1\n';
                ref.species_reference:
                  'species_code,common_name,family_name\n'+
                  'SP-01,Sandy Hopper,Hoppers\n'+
                  'SP-02,Reed Hopper,Hoppers\n';
              }#
          ];
          asserts:
          [
            threeDerivedSouthernBurrows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"BurrowCode":"BR-51","Condition":"MINOR_COLLAPSE","ConditionNote":"MINOR COLLAPSE","SiltNote":"silted rim","Species":"Sandy Hopper"},{"BurrowCode":"BR-52","Condition":null,"ConditionNote":null,"SiltNote":"unclassified","Species":"Reed Hopper"},{"BurrowCode":"BR-53","Condition":"SOUND","ConditionNote":"SOUND CHAMBER","SiltNote":null,"Species":"Sandy Hopper"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
