###Mapping
Mapping test::goldenquokka2::mapping::ReserveEnumMappings
(
  test::goldenquokka2::domain::BurrowCondition: EnumerationMapping ConditionMapping
  {
    SOUND: ['A', 'A/OK'],
    SETTLING: ['B'],
    MINOR_COLLAPSE: ['C', 'C/RE'],
    MAJOR_COLLAPSE: ['D'],
    FLOODED: ['E', 'E/WT'],
    SILTED: ['F'],
    ABANDONED: ['G'],
    REOCCUPIED: ['H']
  }

  test::goldenquokka2::domain::HabitatKind: EnumerationMapping HabitatKindMapping
  {
    HEATH: ['HE'],
    DUNE: ['DU'],
    RIPARIAN: ['RI'],
    WOODLAND: ['WO']
  }

  test::goldenquokka2::domain::ForageQuality: EnumerationMapping ForageQualityMapping
  {
    RICH: ['R'],
    ADEQUATE: ['A'],
    SPARSE: ['S']
  }

  test::goldenquokka2::domain::WardenGrade: EnumerationMapping WardenGradeMapping
  {
    SENIOR: ['S'],
    JUNIOR: ['J'],
    HONORARY: ['H']
  }
)
