###Pure
import test::sablebeacon2::domain::*;

Profile test::sablebeacon2::domain::BeaconMeta
{
  stereotypes: [surveyed, provisional];
  tags: [steward, inventoryRound];
}

Enum test::sablebeacon2::domain::CanopyHealth
{
  VIGOROUS,
  STABLE,
  STRESSED,
  DECLINING
}

Enum test::sablebeacon2::domain::SurfaceKind
{
  VERGE,
  PLAZA
}

Class test::sablebeacon2::domain::InventoryRecord
{
  recordCode: String[1];
}

Class <<BeaconMeta.surveyed>> {BeaconMeta.steward = 'City Tree Board'} test::sablebeacon2::domain::StreetTree extends InventoryRecord
{
  treeCode: String[1];
  treeName: String[1];
  treeAbbrev: String[1];
  trunkCm: Integer[1];
  crownSpreadM: Float[1];
  nameLength: Integer[1];
  canopyBand: String[0..1];
  plaqueLabel: String[1];
  tallyNote: String[1];
  health: CanopyHealth[0..1];
  surface: SurfaceKind[0..1];
  stewardPost: String[0..1];
  genusName: String[0..1];
}

Class <<BeaconMeta.provisional>> test::sablebeacon2::domain::VeteranTree extends StreetTree
{
  heritageLabel: String[1];
}

Class test::sablebeacon2::domain::PlantingSite extends InventoryRecord
{
  siteCode: String[1];
  siteName: String[1];
  surfaceType: String[1];
  treeCount: Integer[0..1];
  maxTrunkCm: Integer[0..1];
}

Class test::sablebeacon2::domain::WardCrew
{
  crewCode: String[1];
  crewName: String[1];
  siteCode: String[1];
}

Class test::sablebeacon2::domain::RawCrew
{
  crewCode: String[1];
  crewName: String[1];
  siteCode: String[1];
}

Association test::sablebeacon2::domain::SiteTrees
{
  site: PlantingSite[0..1];
  trees: StreetTree[*];
}

Association test::sablebeacon2::domain::SiteCrew
{
  crew: WardCrew[*];
  postedSite: PlantingSite[0..1];
}
