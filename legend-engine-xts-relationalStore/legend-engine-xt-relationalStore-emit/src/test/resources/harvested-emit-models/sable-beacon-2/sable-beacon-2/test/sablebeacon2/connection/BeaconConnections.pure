###Connection
RelationalDatabaseConnection test::sablebeacon2::connection::BeaconVaultConnection
{
  store: test::sablebeacon2::store::BeaconInventoryStore;
  type: DB2;
  specification: Static
  {
    name: 'EXAMPLE_TREE_INVENTORY';
    host: 'tree-inventory.example';
    port: 50000;
  };
  auth: UserNamePassword
  {
    baseVaultReference: 'tree-inventory-vault';
    userNameVaultReference: 'tree-inventory-user';
    passwordVaultReference: 'tree-inventory-secret';
  };
}

RelationalDatabaseConnection test::sablebeacon2::connection::BeaconKerberosConnection
{
  store: test::sablebeacon2::store::BeaconInventoryStore;
  type: DB2;
  specification: Static
  {
    name: 'EXAMPLE_TREE_INVENTORY_RO';
    host: 'tree-inventory-ro.example';
    port: 50000;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'tree-inventory/example';
  };
}
