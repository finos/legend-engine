###Service
Service test::sablebeacon2::service::CanopyRosterService
{
  pattern: '/beacon/v1/canopy-roster/{minTrunkCm}';
  title: 'Sable Beacon 2 - Street Tree Canopy Roster';
  owners:
  [
    'city-tree-inventory',
    'urban-canopy-eng'
  ];
  documentation: 'Single-execution service that narrows the street-tree inventory to the trees whose trunk girth reaches a caller-supplied threshold and projects the plaque, canopy band, genus and steward post reached through the multi-hop reference chain.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: {minTrunkCm: Integer[1]|test::sablebeacon2::domain::StreetTree.all()->filter(
      t|$t.trunkCm >= $minTrunkCm
    )->project(~[RecordCode: t|$t.recordCode, TreeName: t|$t.treeName, PlaqueLabel: t|$t.plaqueLabel, CanopyBand: t|$t.canopyBand, GenusName: t|$t.genusName, StewardPost: t|$t.stewardPost])->select(~[RecordCode, TreeName, PlaqueLabel, CanopyBand, GenusName, StewardPost])->sort(~RecordCode->ascending())->limit(25)};
    mapping: test::sablebeacon2::mapping::BeaconMapping;
    runtime: test::sablebeacon2::runtime::BeaconVaultRuntime;
  }
  testSuites:
  [
    canopyRosterSuite:
    {
      data:
      [
        connections:
        [
          beaconConnection:
            Relational
            #{
              reference.genus_steward:
                'steward_name,post_name\n'+
                'north steward,Northern depot\n'+
                'south steward,Southern depot\n';

              reference.tree_genus:
                'genus_code,genus_name,steward_name\n'+
                'G1,Tilia,north steward\n'+
                'G2,Platanus,south steward\n';

              reference.tree_species:
                'species_code,species_name,genus_code\n'+
                'S1,Small-leaved lime,G1\n'+
                'S2,London plane,G2\n';

              inventory.planting_site:
                'site_code,site_name,surface_type,ward_code\n'+
                'P1,Kiln Row,GRASS VERGE,W1\n'+
                'P2,Market Walk,PAVED PLAZA,W2\n';

              inventory.street_tree:
                'tree_id,tree_name,trunk_cm,crown_spread_m,band_code,health_code,surface_code,species_code,site_code,plaque_text,heritage_flag\n'+
                '1,kiln row lime,64,7.5,A,vigorous,grass verge,S1,P1,planted 1974,Y\n'+
                '2,market walk plane,88,11.0,B,stable,paved plaza,S2,P2,,N\n'+
                '3,quarry lane rowan,21,3.0,Z,stressed,kerb strip,S1,P1,young stock,N\n';
            }#
        ]
      ]
      tests:
      [
        girthThreshold:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            minTrunkCm = 60
          ]
          asserts:
          [
            slenderTreeExcludedAndMultiHopStewardResolved:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"RecordCode":"TREE-1","TreeName":"KILN ROW LIME","PlaqueLabel":"planted 1974","CanopyBand":"broad","GenusName":"Tilia","StewardPost":"Northern depot"},{"RecordCode":"TREE-2","TreeName":"MARKET WALK PLANE","PlaqueLabel":"unplaqued","CanopyBand":"columnar","GenusName":"Platanus","StewardPost":"Southern depot"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
