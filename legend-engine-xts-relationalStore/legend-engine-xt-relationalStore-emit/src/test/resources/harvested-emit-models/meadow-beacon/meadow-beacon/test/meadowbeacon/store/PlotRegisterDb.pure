###Relational
Database test::meadowbeacon::store::PlotRegisterDb
(
  Schema plotreg
  (
    Table plot_entry
    (
      plot_code VARCHAR(20) PRIMARY KEY,
      site_code VARCHAR(20) NOT NULL,
      season_on DATE NOT NULL,
      record_number INTEGER NOT NULL,
      body_code VARCHAR(20) NOT NULL,
      crop_code VARCHAR(20),
      bed_tally INTEGER,
      entry_label VARCHAR(120),
      registered_on DATE
    )

    Table site_entry
    (
      site_code VARCHAR(20) PRIMARY KEY,
      site_label VARCHAR(120),
      zone_category VARCHAR(20),
      zone_marker VARCHAR(20),
      opened_on DATE
    )
  )
)
