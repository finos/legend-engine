      synonymHolder[cropSynonym, holderMaster]: [test::meadowbeacon::store::AllotmentComposedDb]@HolderMaster_CropSynonym
    )
  }

  testSuites:
  [
    allocationPathSuite:
    {
      function: |test::meadowbeacon::domain::PlotAllocation.all()->project(
        [
          a|$a.allocationCode,
          a|$a.plotCode,
          a|$a.groupCode,
          a|$a.entryLabel,
          a|$a.entryBedTally,
          a|$a.holderLabel,
          a|$a.holderJoinedOn
        ],
        [
          'Allocation',
          'Plot',
          'Group',
          'EntryLabel',
          'EntryBeds',
          'HolderLabel',
          'HolderJoined'
        ]
      )->sort([asc('Allocation')]);
      tests:
      [
        allocationsAcrossIncludedStores:
        {
          doc: 'Walks the composed store from the local view onto the register table and on into the record-master table, with one allocation whose register row is absent so both hops empty.';
          data:
          [
            test::meadowbeacon::store::AllotmentComposedDb:
              Relational
              #{
                meadow.plot_allocation_vw:
                  'allocation_code,plot_code,site_code,season_on,group_code,unit_code,holder_code,record_number,body_code,milestone_marker,bed_quantity,valid_from,valid_thru,crop_code,status_label\n'+
                  'AL-01,PL-01,ST-01,2026-03-01,GRP-A,BED,HD-01,101,BODY-1,CURRENT,12.50,2026-03-01,2026-12-31,CR-01,ACTIVE\n'+
                  'AL-02,PL-02,ST-01,2026-03-01,,BED,HD-02,102,BODY-1,CURRENT,8.00,2026-03-01,2026-12-31,CR-02,ACTIVE\n'+
                  'AL-03,PL-09,ST-02,2026-04-01,GRP-B,,HD-03,109,BODY-2,PENDING,4.25,2026-04-01,2026-11-30,CR-01,PENDING\n';
                plotreg.plot_entry:
                  'plot_code,site_code,season_on,record_number,body_code,crop_code,bed_tally,entry_label,registered_on\n'+
                  'PL-01,ST-01,2026-03-01,101,BODY-1,CR-01,6,north row beds,2026-02-20\n'+
                  'PL-02,ST-01,2026-03-01,102,BODY-1,CR-02,,south row beds,2026-02-21\n';
                holderrec.holder_master:
                  'record_number,body_code,holder_code,holder_label,crop_code,joined_on\n'+
                  '101,BODY-1,HD-01,Ridge Growers Circle,CR-01,2024-05-01\n';
              }#
          ];
          asserts:
          [
            threeAllocationsWithOneMissingPath:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Allocation":"AL-01","Plot":"PL-01","Group":"GRP-A","EntryLabel":"north row beds","EntryBeds":6,"HolderLabel":"Ridge Growers Circle","HolderJoined":"2024-05-01"},{"Allocation":"AL-02","Plot":"PL-02","Group":null,"EntryLabel":"south row beds","EntryBeds":null,"HolderLabel":null,"HolderJoined":null},{"Allocation":"AL-03","Plot":"PL-09","Group":"GRP-B","EntryLabel":null,"EntryBeds":null,"HolderLabel":null,"HolderJoined":null}]';
                  }#;
              }#
          ];
        }
      ];
    },
    synonymPathSuite:
    {
      function: |test::meadowbeacon::domain::PlotEntry.all()->project(
        [
          e|$e.plotCode,
          e|$e.masterHolderLabel,
          e|$e.primarySynonymText,
          e|$e.primarySynonymStartedOn
        ],
        [
          'Plot',
          'HolderLabel',
          'Synonym',
          'SynonymFrom'
        ]
      )->sort([asc('Plot')]);
      tests:
      [
        twoHopSynonymPathWithExpiredRow:
        {
          doc: 'Reaches the reference-data synonym two joins away from the register table, trimming the padded stored value, with one entry whose only synonym row is expired and one whose synonym type does not match the join restriction.';
          data:
          [
            test::meadowbeacon::store::AllotmentComposedDb:
              Relational
              #{
                plotreg.plot_entry:
                  'plot_code,site_code,season_on,record_number,body_code,crop_code,bed_tally,entry_label,registered_on\n'+
                  'PL-01,ST-01,2026-03-01,101,BODY-1,CR-01,6,north row beds,2026-02-20\n'+
                  'PL-02,ST-01,2026-03-01,102,BODY-1,CR-02,4,south row beds,2026-02-21\n'+
                  'PL-03,ST-02,2026-03-01,103,BODY-2,CR-03,2,east row beds,2026-02-22\n';
                holderrec.holder_master:
                  'record_number,body_code,holder_code,holder_label,crop_code,joined_on\n'+
                  '101,BODY-1,HD-01,Ridge Growers Circle,CR-01,2024-05-01\n'+
                  '102,BODY-1,HD-02,Fen Growers Circle,CR-02,2024-06-01\n'+
                  '103,BODY-2,HD-03,Moor Growers Circle,CR-03,2024-07-01\n';
                cropref.crop_synonym:
                  'synonym_key,crop_code,synonym_type,synonym_text,started_on,ended_on\n'+
                  '1,CR-01,PRIMARY,  broad bean  ,2024-01-01,\n'+
                  '2,CR-02,PRIMARY,summer squash,2024-01-01,2025-12-31\n'+
                  '3,CR-03,ALTERNATE,winter kale,2024-01-01,\n';
              }#
          ];
          asserts:
          [
            oneTrimmedHitAndTwoEmptyPaths:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Plot":"PL-01","HolderLabel":"Ridge Growers Circle","Synonym":"broad bean","SynonymFrom":"2024-01-01"},{"Plot":"PL-02","HolderLabel":"Fen Growers Circle","Synonym":null,"SynonymFrom":null},{"Plot":"PL-03","HolderLabel":"Moor Growers Circle","Synonym":null,"SynonymFrom":null}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
