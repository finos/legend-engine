###Relational
Database test::meadowbeacon::store::HolderRecordDb
(
  Schema holderrec
  (
    Table holder_master
    (
      record_number INTEGER PRIMARY KEY,
      body_code VARCHAR(20) NOT NULL,
      holder_code VARCHAR(20),
      holder_label VARCHAR(120),
      crop_code VARCHAR(20),
      joined_on DATE
    )

    Table holder_contact
    (
      contact_key INTEGER PRIMARY KEY,
      record_number INTEGER,
      contact_label VARCHAR(120),
      contact_kind VARCHAR(20)
    )
  )
)
