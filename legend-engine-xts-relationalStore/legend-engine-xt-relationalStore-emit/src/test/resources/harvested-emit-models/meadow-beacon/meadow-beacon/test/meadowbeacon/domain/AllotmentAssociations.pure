import test::meadowbeacon::domain::*;

Association {meta::pure::profiles::doc.doc = 'A register entry covers at most one seasonal allocation of the local view, and an allocation names exactly one entry.'} test::meadowbeacon::domain::PlotEntry_PlotAllocation
{
  coveredAllocations: PlotAllocation[*];
  registerEntries: PlotEntry[*];
}

Association {meta::pure::profiles::doc.doc = 'Every register entry names a holding body record, and a record covers at most one entry of this consumer.'} test::meadowbeacon::domain::PlotEntry_HolderMasterLink
{
  holderRecord: HolderMaster[0..1];
  registeredEntries: PlotEntry[1];
}

Association {meta::pure::profiles::doc.doc = 'A holder record resolves to the one open primary synonym of its crop code; a synonym describes exactly one holder record.'} test::meadowbeacon::domain::HolderMaster_CropSynonymLink
{
  openSynonym: CropSynonym[0..1];
  synonymHolder: HolderMaster[1];
}
