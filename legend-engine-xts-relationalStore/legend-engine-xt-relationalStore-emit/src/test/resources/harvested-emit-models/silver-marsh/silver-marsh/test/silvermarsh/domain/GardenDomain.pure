Class {meta::pure::profiles::doc.doc = 'A botanical garden that groups planting beds.'} test::silvermarsh::domain::Garden
{
  name: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A planting bed that belongs to a botanical garden.'} test::silvermarsh::domain::Bed
{
  code: String[1];
  garden: test::silvermarsh::domain::Garden[1];
}

Class {meta::pure::profiles::doc.doc = 'An individual plant growing in a planting bed.'} test::silvermarsh::domain::Plant
{
  species: String[1];
  heightCm: Integer[1];
  bed: test::silvermarsh::domain::Bed[1];
}
