###Relational
Database test::silvermarsh::store::GardenDB
(
  Schema garden
  (
    Table garden
    (
      garden_id INTEGER PRIMARY KEY,
      garden_name VARCHAR(200) NOT NULL
    )
    Table bed
    (
      bed_id INTEGER PRIMARY KEY,
      bed_code VARCHAR(50) NOT NULL,
      garden_id INTEGER NOT NULL
    )
    Table plant
    (
      plant_id INTEGER PRIMARY KEY,
      species VARCHAR(200) NOT NULL,
      height_cm INTEGER NOT NULL,
      bed_id INTEGER NOT NULL
    )
  )

  Join Plant_Bed(garden.plant.bed_id = garden.bed.bed_id)
  Join Bed_Garden(garden.bed.garden_id = garden.garden.garden_id)
)
