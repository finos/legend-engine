###Mapping
Mapping test::silvermarsh::mapping::GardenMapping
(
  *test::silvermarsh::domain::Garden[garden]: Relational
  {
    ~primaryKey
    (
      [test::silvermarsh::store::GardenDB]garden.garden.garden_id
    )
    ~mainTable [test::silvermarsh::store::GardenDB]garden.garden
    name: [test::silvermarsh::store::GardenDB]garden.garden.garden_name
  }
  *test::silvermarsh::domain::Bed[bed]: Relational
  {
    ~primaryKey
    (
      [test::silvermarsh::store::GardenDB]garden.bed.bed_id
    )
    ~mainTable [test::silvermarsh::store::GardenDB]garden.bed
    code: [test::silvermarsh::store::GardenDB]garden.bed.bed_code,
    garden[garden]: [test::silvermarsh::store::GardenDB]@Bed_Garden
  }
  *test::silvermarsh::domain::Plant[plant]: Relational
  {
    ~primaryKey
    (
      [test::silvermarsh::store::GardenDB]garden.plant.plant_id
    )
    ~mainTable [test::silvermarsh::store::GardenDB]garden.plant
    species: [test::silvermarsh::store::GardenDB]garden.plant.species,
    heightCm: [test::silvermarsh::store::GardenDB]garden.plant.height_cm,
    bed[bed]: [test::silvermarsh::store::GardenDB]@Plant_Bed
  }

  testSuites:
  [
    plantProjectionSuite:
    {
      function: |test::silvermarsh::domain::Plant.all()->project(
  [
    x|$x.species,
    x|$x.bed.code,
    x|$x.bed.garden.name
  ],
  [
    'Species',
    'Bed',
    'Garden'
  ]
);
      tests:
      [
        plantNestedJoinProjection:
        {
          doc: 'Projects a plant with its bed and garden, exercising the chained Plant_Bed > Bed_Garden nested join.';
          data:
          [
            test::silvermarsh::store::GardenDB:
              Relational
              #{
                garden.garden:
                  'garden_id,garden_name\n'+
                  '1,Highland Botanic\n';
                garden.bed:
                  'bed_id,bed_code,garden_id\n'+
                  '1,B-01,1\n';
                garden.plant:
                  'plant_id,species,height_cm,bed_id\n'+
                  '1,Blue Gentian,18,1\n';
              }#
          ];
          asserts:
          [
            oneRow:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Species":"Blue Gentian","Bed":"B-01","Garden":"Highland Botanic"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
