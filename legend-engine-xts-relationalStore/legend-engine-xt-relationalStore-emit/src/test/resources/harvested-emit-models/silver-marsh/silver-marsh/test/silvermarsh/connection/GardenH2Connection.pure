###Connection
RelationalDatabaseConnection test::silvermarsh::connection::GardenH2Connection
{
  store: test::silvermarsh::store::GardenDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists garden;',
      'create schema garden;',
      'create table garden.garden (garden_id integer primary key, garden_name varchar(200) not null);',
      'create table garden.bed (bed_id integer primary key, bed_code varchar(50) not null, garden_id integer not null);',
      'create table garden.plant (plant_id integer primary key, species varchar(200) not null, height_cm integer not null, bed_id integer not null);',
      'insert into garden.garden values (1, \'Highland Botanic\');',
      'insert into garden.garden values (2, \'Coastal Arboretum\');',
      'insert into garden.bed values (1, \'B-01\', 1);',
      'insert into garden.bed values (2, \'B-02\', 2);',
      'insert into garden.plant values (1, \'Blue Gentian\', 18, 1);',
      'insert into garden.plant values (2, \'Alpine Aster\', 25, 1);',
      'insert into garden.plant values (3, \'Sea Holly\', 40, 2);'
      ];
  };
  auth: DefaultH2;
}
