###Pure
import test::jadelighthouse::domain::*;

Enum test::jadelighthouse::domain::OpticClass
{
  Fresnel,
  Catadioptric,
  Reflector,
  Unclassed
}

Enum test::jadelighthouse::domain::PowerSource
{
  Mains,
  Solar,
  Wind,
  Battery,
  Unknown
}

Enum test::jadelighthouse::domain::ConditionGrade
{
  Sound,
  Serviceable,
  Degraded,
  Failed
}

Enum test::jadelighthouse::domain::HazardBand
{
  Calm,
  Moderate,
  Exposed,
  Severe
}

Class test::jadelighthouse::domain::NavigationAid
{
  aidCode: String[1];
  aidName: String[1];
  regionCode: String[1];
}

Class test::jadelighthouse::domain::Station extends NavigationAid
{
  stationType: String[1];
  statusLabel: String[1];
  keeperNote: String[1];
  towerHeightM: Integer[1];
  rosterLabel: String[0..1];
}

Class test::jadelighthouse::domain::AidRecord extends NavigationAid
{
  recordKind: String[1];
}

Class test::jadelighthouse::domain::Lamp
{
  lampCode: String[1];
  opticClass: OpticClass[1];
  powerSource: PowerSource[1];
  powerLabel: String[0..1];
}

Class test::jadelighthouse::domain::Region
{
  regionCode: String[1];
  regionName: String[1];
  coastSide: String[1];
  summary: RegionSummary[0..1];
}

Class test::jadelighthouse::domain::RegionSummary
{
  regionCode: String[1];
  stationCount: Integer[1];
  maxTowerHeightM: Integer[1];
}

Class <<temporal.bitemporal>> test::jadelighthouse::domain::Inspection
{
  inspectionId: Integer[1];
  inspectorName: String[1];
  conditionGrade: ConditionGrade[1];
  hazardBand: HazardBand[1];
  regionStationCount: Integer[0..1];
}

Class <<temporal.processingtemporal>> test::jadelighthouse::domain::KeeperLog
{
  logId: Integer[1];
  entryText: String[1];
}

Class test::jadelighthouse::domain::RawAidNote
{
  noteCode: String[1];
  stationCode: String[1];
  opticText: String[1];
  powerText: String[1];
}

Class test::jadelighthouse::domain::AidNote
{
  noteCode: String[1];
  stationCode: String[1];
  noteLabel: String[1];
  opticClass: OpticClass[1];
  powerSource: PowerSource[1];
}

Association test::jadelighthouse::domain::Station_Lamp
{
  lampStation: Station[*];
  lamp: Lamp[0..1];
}

Association test::jadelighthouse::domain::Station_Region
{
  regionStations: Station[*];
  region: Region[0..1];
}

Association test::jadelighthouse::domain::Inspection_Station
{
  inspections: Inspection[*];
  station: Station[0..1];
}

Association test::jadelighthouse::domain::Station_Logs
{
  loggedStation: Station[0..1];
  logs: KeeperLog[*];
}
