  {
    Mains: ['M'],
    Solar: ['S'],
    Wind: ['W'],
    Battery: ['B'],
    Unknown: ['U']
  }

  test::jadelighthouse::domain::ConditionGrade: EnumerationMapping ConditionMapping
  {
    Sound: ['1'],
    Serviceable: ['2'],
    Degraded: ['3'],
    Failed: ['4']
  }

  test::jadelighthouse::domain::HazardBand: EnumerationMapping HazardMapping
  {
    Calm: ['CA'],
    Moderate: ['MO'],
    Exposed: ['EX'],
    Severe: ['SE']
  }
)
