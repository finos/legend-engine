###Connection
RelationalDatabaseConnection test::fabledgecko::connection::GeckoSurveyH2Connection
{
  store: test::fabledgecko::store::GeckoSurveyDb;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists survey;',
      'create schema survey;',
      'create table survey.call_observation (observation_id integer primary key, transect_name varchar(64) not null, call_type varchar(48) not null);',
      'insert into survey.call_observation values (1, \'Riverside Trail\', \'chirp\');',
      'insert into survey.call_observation values (2, \'Riverside Trail\', \'bark\');',
      'insert into survey.call_observation values (3, \'Riverside Trail\', \'chirp\');',
      'insert into survey.call_observation values (4, \'Quarry Ridge\', \'click\');',
      'insert into survey.call_observation values (5, \'Quarry Ridge\', \'click\');',
      'insert into survey.call_observation values (6, \'Kelp Cove\', \'warble\');'
      ];
  };
  auth: DefaultH2;
}
