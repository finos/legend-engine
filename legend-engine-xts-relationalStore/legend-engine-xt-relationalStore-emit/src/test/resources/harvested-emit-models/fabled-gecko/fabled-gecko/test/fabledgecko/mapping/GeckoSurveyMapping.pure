###Mapping
Mapping test::fabledgecko::mapping::GeckoSurveyMapping
(
  *test::fabledgecko::domain::CallObservation[call_observation]: Relational
  {
    ~primaryKey
    (
      [test::fabledgecko::store::GeckoSurveyDb]survey.call_observation.observation_id
    )
    ~mainTable [test::fabledgecko::store::GeckoSurveyDb]survey.call_observation
    transectName: [test::fabledgecko::store::GeckoSurveyDb]survey.call_observation.transect_name,
    callType: [test::fabledgecko::store::GeckoSurveyDb]survey.call_observation.call_type
  }

  testSuites:
  [
    callObservationColumnSuite:
    {
      function: |test::fabledgecko::domain::CallObservation.all()->project(
  [
    o|$o.transectName,
    o|$o.callType
  ],
  [
    'Transect',
    'CallType'
  ]
);
      tests:
      [
        everyObservationRowSurfaces:
        {
          doc: 'Projects both mapped properties of every observation so the property-to-column bindings are observable on their own, independently of the aggregate service query. The identity-only primary key keeps the two repeated transect/call-type pairs as distinct rows.';
          data:
          [
            test::fabledgecko::store::GeckoSurveyDb:
              Relational
              #{
                survey.call_observation:
                  'observation_id,transect_name,call_type\n'+
                  '1,Riverside Trail,chirp\n'+
                  '2,Riverside Trail,bark\n'+
                  '3,Riverside Trail,chirp\n'+
                  '4,Quarry Ridge,click\n'+
                  '5,Quarry Ridge,click\n'+
                  '6,Kelp Cove,warble\n';
              }#
          ];
          asserts:
          [
            sixProjectedRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Transect":"Riverside Trail","CallType":"chirp"},{"Transect":"Riverside Trail","CallType":"bark"},{"Transect":"Riverside Trail","CallType":"chirp"},{"Transect":"Quarry Ridge","CallType":"click"},{"Transect":"Quarry Ridge","CallType":"click"},{"Transect":"Kelp Cove","CallType":"warble"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
