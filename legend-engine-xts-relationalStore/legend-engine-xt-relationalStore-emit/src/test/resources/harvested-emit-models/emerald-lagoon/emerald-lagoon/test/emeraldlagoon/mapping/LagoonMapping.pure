###Mapping
Mapping test::emeraldlagoon::mapping::LagoonMapping
(
  *test::emeraldlagoon::domain::ReefPatch[patch]: Relational
  {
    ~primaryKey
    (
      [test::emeraldlagoon::store::LagoonDatabase]lagoon.reef_patch.patch_id
    )
    ~mainTable [test::emeraldlagoon::store::LagoonDatabase]lagoon.reef_patch
    patchCode: [test::emeraldlagoon::store::LagoonDatabase]lagoon.reef_patch.patch_code,
    zoneCode: [test::emeraldlagoon::store::LagoonDatabase]lagoon.reef_patch.zone_code,
    patchStatus: [test::emeraldlagoon::store::LagoonDatabase]lagoon.reef_patch.patch_status,
    surveyedOn: [test::emeraldlagoon::store::LagoonDatabase]lagoon.reef_patch.surveyed_on,
    coverPct: [test::emeraldlagoon::store::LagoonDatabase]lagoon.reef_patch.cover_pct,
    depthM: [test::emeraldlagoon::store::LagoonDatabase]lagoon.reef_patch.depth_m
  }

  *test::emeraldlagoon::domain::InflowReading[reading]: Relational
  {
    ~primaryKey
    (
      [test::emeraldlagoon::store::LagoonDatabase]lagoon.inflow_reading.reading_id
    )
    ~mainTable [test::emeraldlagoon::store::LagoonDatabase]lagoon.inflow_reading
    readingCode: [test::emeraldlagoon::store::LagoonDatabase]lagoon.inflow_reading.reading_code,
    zoneCode: [test::emeraldlagoon::store::LagoonDatabase]lagoon.inflow_reading.zone_code,
    readingStatus: [test::emeraldlagoon::store::LagoonDatabase]lagoon.inflow_reading.reading_status,
    measuredOn: [test::emeraldlagoon::store::LagoonDatabase]lagoon.inflow_reading.measured_on,
    litresPerMin: [test::emeraldlagoon::store::LagoonDatabase]lagoon.inflow_reading.litres_per_min,
    turbidityNtu: [test::emeraldlagoon::store::LagoonDatabase]lagoon.inflow_reading.turbidity_ntu
  }
)
