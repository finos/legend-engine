###Pure
Class {meta::pure::profiles::doc.doc = 'A surveyed reef patch of a lagoon zone, carrying the cover measured on the survey date.'} test::emeraldlagoon::domain::ReefPatch
{
  patchCode: String[1];
  zoneCode: String[1];
  patchStatus: String[1];
  surveyedOn: StrictDate[1];
  coverPct: Float[1];
  depthM: Float[1];
}

Class {meta::pure::profiles::doc.doc = 'A freshwater inflow reading taken in a lagoon zone on the measurement date.'} test::emeraldlagoon::domain::InflowReading
{
  readingCode: String[1];
  zoneCode: String[1];
  readingStatus: String[1];
  measuredOn: StrictDate[1];
  litresPerMin: Float[1];
  turbidityNtu: Float[1];
}
