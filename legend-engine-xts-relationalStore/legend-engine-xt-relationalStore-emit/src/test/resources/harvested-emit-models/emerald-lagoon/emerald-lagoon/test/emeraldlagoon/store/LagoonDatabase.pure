###Relational
Database test::emeraldlagoon::store::LagoonDatabase
(
  Schema lagoon
  (
    Table reef_patch
    (
      patch_id INTEGER PRIMARY KEY,
      patch_code VARCHAR(20) NOT NULL,
      zone_code VARCHAR(20) NOT NULL,
      patch_status VARCHAR(20) NOT NULL,
      surveyed_on DATE NOT NULL,
      cover_pct DOUBLE NOT NULL,
      depth_m DOUBLE NOT NULL
    )
    Table inflow_reading
    (
      reading_id INTEGER PRIMARY KEY,
      reading_code VARCHAR(20) NOT NULL,
      zone_code VARCHAR(20) NOT NULL,
      reading_status VARCHAR(20) NOT NULL,
      measured_on DATE NOT NULL,
      litres_per_min DOUBLE NOT NULL,
      turbidity_ntu DOUBLE NOT NULL
    )
  )
)
