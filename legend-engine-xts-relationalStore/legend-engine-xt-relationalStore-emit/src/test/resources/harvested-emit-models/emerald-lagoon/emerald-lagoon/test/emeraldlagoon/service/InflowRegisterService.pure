###Service
Service test::emeraldlagoon::service::InflowRegisterService
{
  pattern: '/emeraldlagoon/v1/inflow-register/{zoneCode}/{asOf}';
  title: 'Emerald Lagoon - Freshwater Inflow Register';
  owners:
  [
    'emerald-lagoon-survey',
    'inflow-monitoring'
  ];
  documentation: 'Counterpart of the reef-patch register over the inflow readings of one lagoon zone: the same four-operand window predicate closing on the requested date, and rows carrying the measured rate, the hourly rate derived from it and the age of the reading counted from the requested date.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: {zoneCode: String[1], asOf: StrictDate[1], processingDate: StrictDate[1]|test::emeraldlagoon::domain::InflowReading.all()->filter(
      r|(($r.zoneCode == $zoneCode) && ($r.readingStatus == 'ACTIVE')) && (($r.measuredOn >= $asOf->adjust(-45, meta::pure::functions::date::DurationUnit.DAYS)) && ($r.measuredOn <= $processingDate))
    )->project(
      [
        r|$r.readingCode,
        r|$r.zoneCode,
        r|$r.litresPerMin,
        r|$r.litresPerMin * 60.0,
        r|dateDiff($r.measuredOn, $asOf, meta::pure::functions::date::DurationUnit.DAYS)
      ],
      [
        'Reading/Code',
        'Reading/Zone',
        'Reading/LitresPerMin',
        'Reading/LitresPerHour',
        'Reading/AgeDays'
      ]
    )->distinct()->sort([asc('Reading/Code')])};
    mapping: test::emeraldlagoon::mapping::LagoonMapping;
    runtime: test::emeraldlagoon::runtime::LagoonH2Runtime;
  }
  testSuites:
  [
    inflowRegisterSuite:
    {
      data:
      [
        connections:
        [
          h2Connection:
            Relational
            #{
              lagoon.inflow_reading:
                'reading_id,reading_code,zone_code,reading_status,measured_on,litres_per_min,turbidity_ntu\n'+
                '1,IR-01,LAGOON-NORTH,ACTIVE,2026-07-20,118.5,4.25\n'+
                '2,IR-02,LAGOON-NORTH,ACTIVE,2026-04-30,90.25,7.5\n'+
                '3,IR-03,LAGOON-SOUTH,ACTIVE,2026-07-22,140.0,3.0\n'+
                '4,IR-04,LAGOON-NORTH,PAUSED,2026-07-21,101.75,5.5\n'+
                '5,IR-05,LAGOON-NORTH,ACTIVE,2099-07-21,130.5,2.25\n';

              lagoon.reef_patch:
                'patch_id,patch_code,zone_code,patch_status,surveyed_on,cover_pct,depth_m\n'+
                '1,RP-01,LAGOON-NORTH,MONITORED,2026-07-15,42.5,3.5\n';
            }#
        ]
      ]
      tests:
      [
        onlyTheRecentActiveReadingOfTheZone:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            zoneCode = 'LAGOON-NORTH',
            asOf = %2026-08-01,
            processingDate = %2026-08-01
          ]
          asserts:
          [
            oneQualifyingReading:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Reading/Code":"IR-01","Reading/Zone":"LAGOON-NORTH","Reading/LitresPerMin":118.5,"Reading/LitresPerHour":7110.0,"Reading/AgeDays":12}]';
                  }#;
              }#
          ]
        },
        aPausedOnlyZoneRegister:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            zoneCode = 'LAGOON-EAST',
            asOf = %2026-08-01,
            processingDate = %2026-08-01
          ]
          asserts:
          [
            noQualifyingReading:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
