###Pure
import test::meadowfjord9::domain::*;

Class {meta::pure::profiles::doc.doc = 'A survey zone that meadow plots are grouped into.'} test::meadowfjord9::domain::SurveyZone
{
  zoneCode: String[1];
  zoneName: String[1];
}

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'A wildflower survey plot whose recording status, staffing and species tally are effective over business time.'} test::meadowfjord9::domain::MeadowPlot
{
  plotCode: String[1];
  zoneCode: String[1];
  statusCode: String[1];
  surveyorCode: String[1];
  reviewerCode: String[1];
  speciesCount: Integer[1];
  richnessBand() {if($this.speciesCount >= 40, |'RICH', |if($this.speciesCount >= 15, |'MIXED', |'SPARSE'))}: String[1];
}
