###Relational
Database test::coralcavern2::store::CavernDB
(
  Schema survey
  (
    Table cave_chamber
    (
      chamber_code VARCHAR(24) PRIMARY KEY,
      chamber_name VARCHAR(120) NOT NULL,
      cavern_code VARCHAR(24) NOT NULL,
      ceiling_height_cm INTEGER NOT NULL,
      open_flag INTEGER NOT NULL,
      lamp_flag INTEGER NOT NULL
    )

    Table chamber_revision
    (
      chamber_code VARCHAR(24) PRIMARY KEY,
      revision_seq INTEGER PRIMARY KEY,
      chamber_name VARCHAR(120) NOT NULL,
      open_flag INTEGER NOT NULL,
      superseded_flag INTEGER NOT NULL
    )

    Table formation_record
    (
      formation_code VARCHAR(24) PRIMARY KEY,
      chamber_code VARCHAR(24) NOT NULL,
      formation_type VARCHAR(64) NOT NULL,
      growth_mm_per_century INTEGER NOT NULL,
      protected_flag INTEGER NOT NULL
    )
  )
)
