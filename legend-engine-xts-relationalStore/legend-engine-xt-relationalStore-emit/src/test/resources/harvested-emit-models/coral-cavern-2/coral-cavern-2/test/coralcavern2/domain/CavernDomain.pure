###Pure
import test::coralcavern2::domain::*;

Class {meta::pure::profiles::doc.doc = 'A named chamber of a show cave as it currently stands.'} test::coralcavern2::domain::CaveChamber
{
  chamberCode: String[1];
  chamberName: String[1];
  cavernCode: String[1];
  ceilingHeightCm: Integer[1];
  openToVisitors: Boolean[1];
  lampsInstalled: Boolean[1];
  accessNote: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'One historical revision of a chamber record, kept in a twin history table.'} test::coralcavern2::domain::ChamberRevision
{
  chamberCode: String[1];
  revisionSeq: Integer[1];
  chamberName: String[1];
  openToVisitors: Boolean[1];
  supersededRevision: Boolean[1];
}

Class {meta::pure::profiles::doc.doc = 'A mineral formation surveyed inside a chamber, with its growth rate banded by the mapping.'} test::coralcavern2::domain::FormationRecord
{
  formationCode: String[1];
  chamberCode: String[1];
  formationType: String[1];
  growthMmPerCentury: Integer[1];
  protectedFeature: Boolean[1];
  sizeBand: String[0..1];
}
