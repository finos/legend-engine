###Connection
RelationalDatabaseConnection test::coralcavern2::connection::CavernConnection
{
  store: test::coralcavern2::store::CavernDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists survey;',
      'create schema survey;',
      'create table survey.cave_chamber (chamber_code varchar(24) primary key, chamber_name varchar(120) not null, cavern_code varchar(24) not null, ceiling_height_cm integer not null, open_flag integer not null, lamp_flag integer not null);',
      'create table survey.chamber_revision (chamber_code varchar(24) not null, revision_seq integer not null, chamber_name varchar(120) not null, open_flag integer not null, superseded_flag integer not null);',
      'create table survey.formation_record (formation_code varchar(24) primary key, chamber_code varchar(24) not null, formation_type varchar(64) not null, growth_mm_per_century integer not null, protected_flag integer not null);'
      ];
  };
  auth: DefaultH2;
}
