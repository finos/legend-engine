###Pure
import test::crimsonthistle3::domain::*;

Class test::crimsonthistle3::domain::AccessionHolding
{
  accessionCode: String[1];
  accessionName: String[0..1];
  glasshouseName: String[0..1];
  displayStatusClass: String[0..1];
  livingPlantCount: Integer[0..1];
  labelledOn: StrictDate[0..1];
  lastAuditedAt: DateTime[0..1];
  onDisplayFlag: Boolean[0..1];
  currentGrowth: GrowthMeasure[1];
  priorPeriodGrowthDelta: GrowthMeasure[1];
  taxon: TaxonLookup[1];
  provenance: ProvenanceLookup[1];
  parentAccession: AccessionHolding[0..1];
  curatorNotes: CuratorNote[*];
}

Class test::crimsonthistle3::domain::BeddedAccessionHolding extends AccessionHolding
{
  bed: GardenBed[1];
}
