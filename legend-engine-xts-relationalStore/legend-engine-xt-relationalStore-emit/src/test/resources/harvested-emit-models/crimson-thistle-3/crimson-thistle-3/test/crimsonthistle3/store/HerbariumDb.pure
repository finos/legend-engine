###Relational
Database test::crimsonthistle3::store::HerbariumDb
(
  Schema herbarium
  (
    Table label_sheet
    (
      sheet_id INTEGER PRIMARY KEY,
      label_text VARCHAR(60) NOT NULL,
      specimen_code VARCHAR(20) NOT NULL,
      life_form_code VARCHAR(4),
      conservation_code VARCHAR(4)
    )
    Table sheet_register
    (
      specimen_code VARCHAR(20) PRIMARY KEY,
      sheet_code VARCHAR(20) NOT NULL
    )
  )

  Join Label_Register(herbarium.label_sheet.specimen_code = herbarium.sheet_register.specimen_code)
)
