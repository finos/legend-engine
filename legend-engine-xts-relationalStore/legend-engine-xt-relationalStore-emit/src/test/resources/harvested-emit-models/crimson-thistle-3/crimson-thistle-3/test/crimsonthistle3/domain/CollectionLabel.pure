###Pure
import test::crimsonthistle3::domain::*;

Class test::crimsonthistle3::domain::CollectionLabel
{
  labelText: String[1];
}

Class test::crimsonthistle3::domain::LabelledSpecimen extends CollectionLabel
{
  specimenCode: String[1];
  herbariumSheetCode: String[0..1];
  lifeFormClass: String[0..1];
  conservationClass: String[0..1];
}

Class test::crimsonthistle3::domain::CuratorNote
{
  noteCode: String[1];
  noteText: String[0..1];
  authoredBy: String[0..1];
  authoredAt: DateTime[0..1];
  followUpFlag: Boolean[0..1];
}
