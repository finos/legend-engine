###Relational
Database test::fabledvineyard5::store::VineyardDb
(
  Schema trellis
  (
    Table vine_block
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      block_id INTEGER PRIMARY KEY,
      block_code VARCHAR(20) NOT NULL,
      variety_code VARCHAR(20) NOT NULL,
      block_status VARCHAR(20) NOT NULL,
      prune_crew_code VARCHAR(20) NOT NULL,
      train_crew_code VARCHAR(20) NOT NULL,
      check_crew_code VARCHAR(20) NOT NULL,
      row_count_total INTEGER NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
  )
)
