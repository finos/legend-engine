###Runtime
Runtime test::fabledvineyard5::runtime::NorthSlopeRuntime
{
  mappings:
  [
    test::fabledvineyard5::mapping::VineyardMapping
  ];
  connections:
  [
    test::fabledvineyard5::store::VineyardDb:
    [
      northSlope: test::fabledvineyard5::connection::NorthSlopeConnection
    ]
  ];
}

Runtime test::fabledvineyard5::runtime::RiverTerraceRuntime
{
  mappings:
  [
    test::fabledvineyard5::mapping::VineyardMapping
  ];
  connections:
  [
    test::fabledvineyard5::store::VineyardDb:
    [
      riverTerrace: test::fabledvineyard5::connection::RiverTerraceConnection
    ]
  ];
}
