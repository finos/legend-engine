###Mapping
Mapping test::ambertundra5::mapping::BoreMapping
(
  include test::ambertundra5::mapping::SiteMapping

  *test::ambertundra5::domain::Borehole[bore]: Relational
  {
    ~filter [test::ambertundra5::store::ReadingDb]LiveBoreFilter
    ~primaryKey
    (
      [test::ambertundra5::store::ReadingDb]probe.borehole.bore_code
    )
    ~mainTable [test::ambertundra5::store::ReadingDb]probe.borehole
    boreCode: [test::ambertundra5::store::ReadingDb]probe.borehole.bore_code,
    tagSerial: parseInteger(substring([test::ambertundra5::store::ReadingDb]probe.borehole.bore_tag, 4, 4)),
    depthCm: [test::ambertundra5::store::ReadingDb]probe.borehole.depth_cm,
    network: 'TUNDRA ARRAY',
    site[site]: [test::ambertundra5::store::ReadingDb]@Bore_Site
  }

  *test::ambertundra5::domain::SiteBoreTally[tally]: Relational
  {
    ~primaryKey
    (
      [test::ambertundra5::store::ReadingDb]probe.site_bore_view.site_code
    )
    ~mainTable [test::ambertundra5::store::ReadingDb]probe.site_bore_view
    siteCode: [test::ambertundra5::store::ReadingDb]probe.site_bore_view.site_code,
    boreCount: [test::ambertundra5::store::ReadingDb]probe.site_bore_view.bore_count,
    maxDepthCm: [test::ambertundra5::store::ReadingDb]probe.site_bore_view.max_depth_cm
  }
)
