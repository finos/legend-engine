###Relational
Database test::ambertundra5::store::SiteDb
(
  Schema site
  (
    Table field_site
    (
      site_code VARCHAR(16) PRIMARY KEY,
      region_code VARCHAR(16) NOT NULL,
      site_name VARCHAR(80) NOT NULL,
      parent_site_code VARCHAR(16)
    )
    Table region
    (
      region_code VARCHAR(16) PRIMARY KEY,
      region_name VARCHAR(80) NOT NULL,
      biome_code VARCHAR(16)
    )
  )

  Join Site_Region(site.field_site.region_code = site.region.region_code)
  Join Site_Parent(site.field_site.parent_site_code = {target}.site_code)
)
