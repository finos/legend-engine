###Pure
Class {meta::pure::profiles::doc.doc = 'A tundra region grouping field sites of one biome.'} test::ambertundra5::domain::Region
{
  regionCode: String[1];
  regionName: String[1];
  biome: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A field site; sub-sites point at the site they were split from.'} test::ambertundra5::domain::FieldSite
{
  siteCode: String[1];
  siteName: String[1];
  region: test::ambertundra5::domain::Region[0..1];
  parent: test::ambertundra5::domain::FieldSite[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A permafrost borehole drilled at a field site.'} test::ambertundra5::domain::Borehole
{
  boreCode: String[1];
  tagSerial: Integer[0..1];
  depthCm: Integer[1];
  network: String[1];
  site: test::ambertundra5::domain::FieldSite[0..1];
}

Class {meta::pure::profiles::doc.doc = 'Per-site borehole tally kept by a grouped store view.'} test::ambertundra5::domain::SiteBoreTally
{
  siteCode: String[1];
  boreCount: Integer[1];
  maxDepthCm: Integer[0..1];
}

Class {meta::pure::profiles::doc.doc = 'Where in the borehole string a probe sits, read from the same reading row.'} test::ambertundra5::domain::ProbePlacement
{
  slotCode: String[1];
  offsetCm: Integer[0..1];
}

Class <<meta::pure::profiles::temporal.processingtemporal>> {meta::pure::profiles::doc.doc = 'A ground temperature reading from a borehole probe, corrected over processing time.'} test::ambertundra5::domain::ThawReading
{
  readingId: Integer[1];
  readingRef: String[1];
  kindLabel: String[1];
  thawClass: String[0..1];
  netDepthCm: Integer[0..1];
  siteName: String[0..1];
  regionName: String[0..1];
  source: String[1];
  placement: test::ambertundra5::domain::ProbePlacement[0..1];
  bore: test::ambertundra5::domain::Borehole[0..1];
}
