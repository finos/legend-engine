###Service
Service test::sunlitfossil4::service::BedTallyService
{
  pattern: '/sunlitfossil4/bedTally';
  title: 'Quarry Bed Specimen Tally';
  owners:
  [
    'palaeontology-collections-desk'
  ];
  documentation: 'Rolls every logged specimen find up behind the quarry and bed pair it was lifted from, publishing the summed specimen count, the summed matrix mass, the largest single block lifted and the number of logged finds standing behind each summary row.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |test::sunlitfossil4::domain::SpecimenFind.all()->groupBy(
      [
        f|$f.quarryName,
        f|$f.bedName
      ],
      [
        agg(f|$f.specimenCount, y|$y->sum()),
        agg(f|$f.matrixMassKg, y|$y->sum()),
        agg(f|$f.specimenCount, y|$y->max()),
        agg(f|$f.findCode, y|$y->count())
      ],
      [
        'Quarry',
        'Bed',
        'Specimen Total',
        'Matrix Mass Total',
        'Largest Find Specimens',
        'Find Count'
      ]
    )->sort(
      [
        asc('Quarry'),
        asc('Bed')
      ]
    );
    mapping: test::sunlitfossil4::mapping::QuarryMapping;
    runtime: test::sunlitfossil4::runtime::QuarryRuntime;
  }
  testSuites:
  [
    bedTallySuite:
    {
      data:
      [
        connections:
        [
          quarryH2Connection:
            Reference
            #{
              test::sunlitfossil4::data::QuarrySeasonData
            }#
        ]
      ]
      tests:
      [
        bedRollup:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            rows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Quarry":"DUSTY BENCH","Bed":"LOWER MARL","Specimen Total":10,"Matrix Mass Total":21.25,"Largest Find Specimens":9,"Find Count":2},{"Quarry":"DUSTY BENCH","Bed":"UPPER SHALE","Specimen Total":5,"Matrix Mass Total":5.0,"Largest Find Specimens":5,"Find Count":1},{"Quarry":"SUNLIT SCARP","Bed":"LOWER MARL","Specimen Total":10,"Matrix Mass Total":19.75,"Largest Find Specimens":6,"Find Count":2},{"Quarry":"SUNLIT SCARP","Bed":"UPPER SHALE","Specimen Total":2,"Matrix Mass Total":3.0,"Largest Find Specimens":2,"Find Count":1}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
