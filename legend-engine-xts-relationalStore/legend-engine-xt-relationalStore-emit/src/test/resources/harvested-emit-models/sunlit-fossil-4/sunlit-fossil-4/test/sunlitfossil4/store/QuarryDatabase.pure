###Relational
Database test::sunlitfossil4::store::QuarryDatabase
(
  Schema dig
  (
    Table specimen_find
    (
      find_id INTEGER PRIMARY KEY,
      find_code VARCHAR(48) NOT NULL,
      quarry_name VARCHAR(48) NOT NULL,
      bed_name VARCHAR(48) NOT NULL,
      specimen_count INTEGER NOT NULL,
      matrix_mass_kg DOUBLE NOT NULL,
      collector_name VARCHAR(64) NOT NULL
    )
  )
)
