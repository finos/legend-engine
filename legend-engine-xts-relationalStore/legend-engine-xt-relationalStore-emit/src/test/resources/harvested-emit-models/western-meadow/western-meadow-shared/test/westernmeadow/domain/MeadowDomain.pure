import test::westernmeadow::domain::*;

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'A named volunteer walking roster whose coordinator is effective over business time.'} test::westernmeadow::domain::WalkRoster
{
  rosterCode: String[1];
  rosterName: String[1];
  coordinatorName: String[1];
}

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'One volunteer enrolled on a roster, whose habitat assignment is effective over business time.'} test::westernmeadow::domain::RosterMember
{
  memberRef: String[1];
  memberName: String[1];
  habitatProfileAsOf(processingDate: Date[1], businessDate: Date[1])
  {
    $this.habitatProfile($processingDate, $businessDate)
  }: HabitatProfile[*];
}

Class <<temporal.bitemporal>> {meta::pure::profiles::doc.doc = 'A wide habitat reference-data version corrected over processing time and effective over business time.'} test::westernmeadow::domain::HabitatProfile
{
  profileCode: String[1];
  habitatName: String[1];
  swardHeightBand: String[1];
  indicatorSpecies: String[1];
  managementRegime: String[1];
  mowingWindow: String[1];
  grazingUnit: Float[1];
  soilSeries: String[1];
  drainageClass: String[1];
  phBand: String[1];
  effectiveFrom: StrictDate[1];
  lakeBatchRef: String[1];
  surveyAuthority: String[1];
  profileNote: String[0..1];
}

Association test::westernmeadow::domain::Roster_Member
{
  roster: WalkRoster[0..1];
  members: RosterMember[*];
}

Association test::westernmeadow::domain::Member_Habitat
{
  profileMember: RosterMember[0..1];
  habitatProfile: HabitatProfile[*];
}
