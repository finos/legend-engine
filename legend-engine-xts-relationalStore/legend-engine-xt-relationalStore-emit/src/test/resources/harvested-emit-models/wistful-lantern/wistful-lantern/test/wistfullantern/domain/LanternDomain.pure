###Pure
import demo::wistfullantern::domain::*;

Profile demo::wistfullantern::domain::LanternProfile
{
  stereotypes: [navigational, decommissioned];
  tags: [custodian, inspectionCadence];
}

Class demo::wistfullantern::domain::ShoreSector
{
  sectorCode: String[1];
  coastName: String[1];
}

Class <<LanternProfile.navigational, temporal.businesstemporal>> {LanternProfile.custodian = 'coastal-signals-desk'} demo::wistfullantern::domain::LightStation
{
  stationCode: String[1];
  stationName: String[1];
  focalHeightMetres: Integer[1];
  characterCode: String[0..1];
  sector: ShoreSector[1];
}

Class demo::wistfullantern::domain::LanternOptic
{
  opticCode: String[1];
  lampWattage: Integer[1];
}

Class {LanternProfile.inspectionCadence = 'quarterly'} demo::wistfullantern::domain::RotatingOptic extends LanternOptic
{
  rotationSeconds: Integer[1];
}

Class demo::wistfullantern::domain::MaintenanceVisit
{
  visitCode: String[1];
  visitDate: StrictDate[1];
  workSummary: String[0..1];
}

Class demo::wistfullantern::domain::TenderVessel
{
  vesselCode: String[1];
  homePortName: String[1];
}

Class <<LanternProfile.decommissioned>> demo::wistfullantern::domain::FogSignal
{
  signalCode: String[1];
  blastPatternCode: String[1];
}

Class demo::wistfullantern::domain::KeeperRoster
{
  rosterCode: String[1];
  keeperName: String[1];
}

Association demo::wistfullantern::domain::Visit_Vessel
{
  vessel: TenderVessel[0..1];
  visits: MaintenanceVisit[*];
}
