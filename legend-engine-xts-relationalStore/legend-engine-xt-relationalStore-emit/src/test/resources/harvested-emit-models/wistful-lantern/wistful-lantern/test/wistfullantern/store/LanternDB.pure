###Relational
Database demo::wistfullantern::store::LanternDB
(
  Schema beacon
  (
    Table shore_sector
    (
      sector_code VARCHAR(20) PRIMARY KEY,
      coast_name VARCHAR(80) NOT NULL
    )
    Table rotating_optic
    (
      optic_code VARCHAR(20) PRIMARY KEY,
      lamp_wattage INTEGER NOT NULL,
      rotation_seconds INTEGER NOT NULL
    )
    Table tender_vessel
    (
      vessel_code VARCHAR(20) PRIMARY KEY,
      home_port_name VARCHAR(80) NOT NULL
    )
    Table maintenance_visit
    (
      visit_code VARCHAR(20) PRIMARY KEY,
      visit_date DATE NOT NULL,
      work_summary VARCHAR(240),
      station_code VARCHAR(20) NOT NULL,
      vessel_code VARCHAR(20)
    )
    Table light_station
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      station_code VARCHAR(20) PRIMARY KEY,
      station_name VARCHAR(80) NOT NULL,
      focal_height_metres INTEGER NOT NULL,
      character_code VARCHAR(20),
      sector_code VARCHAR(20) NOT NULL,
      from_z DATE PRIMARY KEY,
      thru_z DATE
    )
  )

  Join Station_Sector(beacon.light_station.sector_code = beacon.shore_sector.sector_code)
  Join Visit_Tender(beacon.maintenance_visit.vessel_code = beacon.tender_vessel.vessel_code)
)
