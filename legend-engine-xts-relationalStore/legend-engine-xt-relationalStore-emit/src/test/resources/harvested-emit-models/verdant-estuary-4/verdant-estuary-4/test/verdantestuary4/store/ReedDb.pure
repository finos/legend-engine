###Relational
Database test::verdantestuary4::store::ReedDb
(
  Schema marsh
  (
    Table reed_plot
    (
      plot_code VARCHAR(16) PRIMARY KEY,
      transect_code VARCHAR(16),
      survey_wave VARCHAR(16),
      salinity_code VARCHAR(8),
      state_code INTEGER,
      stem_count INTEGER,
      reed_height_cm INTEGER,
      litter_depth_mm INTEGER,
      plot_note VARCHAR(120),
      surveyed_on DATE
    )
  )

  Filter EarlyWaveFilter(marsh.reed_plot.survey_wave = 'EARLY')
  Filter LateWaveFilter(marsh.reed_plot.survey_wave = 'LATE')
)
