###Pure
Enum {meta::pure::profiles::doc.doc = 'Closed set of salinity bands a saltmarsh reed plot can be classed into.'} test::verdantestuary4::domain::SalinityBand
{
  FRESH,
  BRACKISH,
  SALINE,
  HYPERSALINE
}

Class {meta::pure::profiles::doc.doc = 'One surveyed saltmarsh reed plot, assembled from both survey waves of the same register.'} test::verdantestuary4::domain::ReedPlot
{
  plotCode: String[1];
  transectCode: String[1];
  waveLabel: String[1];
  salinity: test::verdantestuary4::domain::SalinityBand[0..1];
  heightBand: String[0..1];
  stemCount: Integer[0..1];
  plotNote: String[0..1];
  surveyedOn: StrictDate[0..1];
}
