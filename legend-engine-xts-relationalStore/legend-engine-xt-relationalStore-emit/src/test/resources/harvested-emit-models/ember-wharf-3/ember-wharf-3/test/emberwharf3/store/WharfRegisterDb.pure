###Relational
Database test::emberwharf3::store::WharfRegisterDb
(
  Schema wharf
  (
    Table berth_assignment
    (
      milestoning
      (
        business(BUS_FROM = bus_from, BUS_THRU = bus_thru)
      )
      assignment_ref VARCHAR(32) PRIMARY KEY,
      berth_code VARCHAR(24),
      vessel_name VARCHAR(120),
      service_route VARCHAR(120),
      call_status VARCHAR(24),
      passenger_cap INTEGER,
      draught_m DOUBLE,
      scheduled_on DATE,
      ramp_fitted BIT,
      bus_from DATE,
      bus_thru DATE
    )
  )
)
