###Pure
import test::tealquokka::domain::*;

Enum test::tealquokka::domain::TagStatus
{
  ACTIVE,
  RETIRED,
  LOST
}

Enum test::tealquokka::domain::HabitatKind
{
  HEATH,
  WOODLAND,
  DUNE
}

Enum test::tealquokka::domain::SurveyMethod
{
  TRANSECT,
  CAMERA_TRAP,
  SPOTLIGHT
}

Class test::tealquokka::domain::Sighting
{
  sightingId: String[1];
  observedOn: StrictDate[1];
  conditionBand: String[0..1];
  noteLabel: String[0..1];
  tagStatus: TagStatus[0..1];
  habitat: HabitatKind[0..1];
  method: SurveyMethod[0..1];
  nickname: String[1];
  commonName: String[1];
  familyName: String[1];
}

Class test::tealquokka::domain::SightingStaging
{
  stationCode: String[1];
  animalCode: String[1];
  bodyCondition: Integer[1];
  tagState: String[1];
  habitatCode: String[1];
}

Class test::tealquokka::domain::SightingDigest
{
  digestKey: String[1];
  conditionBand: String[1];
  tagStatus: TagStatus[0..1];
  habitat: HabitatKind[0..1];
}
