###Mapping
Mapping test::russetorchard::mapping::OrchardMapping
(
  *test::russetorchard::domain::Orchard[orchard]: Relational
  {
    ~primaryKey
    (
      [test::russetorchard::store::OrchardDB]grove.orchard.orchard_id
    )
    ~mainTable [test::russetorchard::store::OrchardDB]grove.orchard
    name: [test::russetorchard::store::OrchardDB]grove.orchard.orchard_name
  }

  *test::russetorchard::domain::FruitTree[fruitTree]: Relational
  {
    ~filter [test::russetorchard::store::OrchardDB] HeavyYield
    ~primaryKey
    (
      [test::russetorchard::store::OrchardDB]grove.fruit_tree.tree_id
    )
    ~mainTable [test::russetorchard::store::OrchardDB]grove.fruit_tree
    label: [test::russetorchard::store::OrchardDB]grove.fruit_tree.label,
    kind: EnumerationMapping FruitKindMapping: [test::russetorchard::store::OrchardDB]grove.fruit_tree.kind_code,
    yieldKg: [test::russetorchard::store::OrchardDB]grove.fruit_tree.yield_kg
  }

  test::russetorchard::domain::Orchard_Tree: Relational
  {
    AssociationMapping
    (
      orchard[fruitTree, orchard]: [test::russetorchard::store::OrchardDB]@Tree_Orchard,
      trees[orchard, fruitTree]: [test::russetorchard::store::OrchardDB]@Tree_Orchard
    )
  }

  test::russetorchard::domain::FruitKind: EnumerationMapping FruitKindMapping
  {
    APPLE: ['A'],
    PEAR: ['P'],
    CHERRY: ['C']
  }
)
