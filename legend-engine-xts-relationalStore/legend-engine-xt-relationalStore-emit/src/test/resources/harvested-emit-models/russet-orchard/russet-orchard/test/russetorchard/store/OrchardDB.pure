###Relational
Database test::russetorchard::store::OrchardDB
(
  Schema grove
  (
    Table orchard
    (
      orchard_id INTEGER PRIMARY KEY,
      orchard_name VARCHAR(200) NOT NULL
    )
    Table fruit_tree
    (
      tree_id INTEGER PRIMARY KEY,
      label VARCHAR(200) NOT NULL,
      kind_code CHAR(1) NOT NULL,
      yield_kg DOUBLE NOT NULL,
      orchard_id INTEGER NOT NULL
    )
  )

  Filter HeavyYield(grove.fruit_tree.yield_kg >= 10.0)

  Join Tree_Orchard(grove.fruit_tree.orchard_id = grove.orchard.orchard_id)
)
