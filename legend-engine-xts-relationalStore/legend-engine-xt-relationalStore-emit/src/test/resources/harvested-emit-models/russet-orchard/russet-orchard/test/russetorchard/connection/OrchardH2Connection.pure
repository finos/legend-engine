###Connection
RelationalDatabaseConnection test::russetorchard::connection::OrchardH2Connection
{
  store: test::russetorchard::store::OrchardDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists grove;',
      'create schema grove;',
      'create table grove.orchard (orchard_id integer primary key, orchard_name varchar(200) not null);',
      'create table grove.fruit_tree (tree_id integer primary key, label varchar(200) not null, kind_code char(1) not null, yield_kg double not null, orchard_id integer not null);',
      'insert into grove.orchard values (1, \'Ridgeline Grove\');',
      'insert into grove.fruit_tree values (1, \'Row A Apple\', \'A\', 12.0, 1);',
      'insert into grove.fruit_tree values (2, \'Row B Cherry\', \'C\', 4.0, 1);',
      'insert into grove.fruit_tree values (3, \'Row C Pear\', \'P\', 18.0, 1);'
      ];
  };
  auth: DefaultH2;
}
