Enum {meta::pure::profiles::doc.doc = 'Closed set of orchard fruit kinds.'} test::russetorchard::domain::FruitKind
{
  APPLE,
  PEAR,
  CHERRY
}

Class {meta::pure::profiles::doc.doc = 'A cultivated orchard.'} test::russetorchard::domain::Orchard
{
  name: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A catalogued tree with a display label.'} test::russetorchard::domain::Tree
{
  label: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A fruit-bearing tree, specialising a tree with kind and annual yield.'} test::russetorchard::domain::FruitTree extends test::russetorchard::domain::Tree
{
  kind: test::russetorchard::domain::FruitKind[1];
  yieldKg: Float[1];
}

Association {meta::pure::profiles::doc.doc = 'Associates an orchard with the fruit trees planted in it.'} test::russetorchard::domain::Orchard_Tree
{
  orchard: test::russetorchard::domain::Orchard[1];
  trees: test::russetorchard::domain::FruitTree[*];
}
