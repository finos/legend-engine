###Relational
Database test::emeraldquokka::store::ParkDb
(
  Schema park
  (
    Table feeding_round
    (
      round_code VARCHAR(24) PRIMARY KEY,
      station_code VARCHAR(24) NOT NULL,
      keeper_name VARCHAR(128) NOT NULL,
      portions_kg INTEGER NOT NULL,
      served_on DATE NOT NULL
    )
    Table browse_station
    (
      station_code VARCHAR(24) PRIMARY KEY,
      station_name VARCHAR(128) NOT NULL,
      enclosure_zone VARCHAR(32) NOT NULL
    )
  )
)
