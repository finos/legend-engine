###Pure
import test::umbervineyard5::domain::*;

Class {meta::pure::profiles::doc.doc = 'A community vineyard holding whose blocks are worked by rota crews.'} test::umbervineyard5::domain::Vineyard
{
  vineyardCode: String[1];
  vineyardName: String[1];
  regionName: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A trellis style fitted to a planted block.'} test::umbervineyard5::domain::Trellis
{
  trellisCode: String[1];
  trellisStyle: String[1];
  wireCount: Integer[1];
}

Class {meta::pure::profiles::doc.doc = 'A pruning crew on the vineyard rota.'} test::umbervineyard5::domain::PruningCrew
{
  crewCode: String[1];
  crewName: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A rota member who reviews the block notes.'} test::umbervineyard5::domain::NoteReviewer
{
  reviewerCode: String[1];
  reviewerName: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A planted block of vines, reported with the holding, trellis and crew it belongs to and with the review note recorded against it where one exists.'} test::umbervineyard5::domain::VineBlock
{
  blockCode: String[1];
  blockName: String[1];
  vineCount: Integer[1];
  rowLengthMetres: Integer[1];
  plantedVineMetres: Integer[1];
  vineyardLabel: String[1];
  regionName: String[1];
  trellisStyle: String[1];
  wireCount: Integer[1];
  crewName: String[1];
  noteText: String[0..1];
  reviewerName: String[0..1];
  reviewerTag: String[0..1];
}
