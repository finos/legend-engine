###Relational
Database test::umbervineyard5::store::VineyardDB
(
  Schema vines
  (
    Table vine_block
    (
      block_code VARCHAR(16) PRIMARY KEY,
      block_name VARCHAR(128),
      vineyard_code VARCHAR(16),
      trellis_code VARCHAR(16),
      crew_code VARCHAR(16),
      vine_count INTEGER,
      row_length_m INTEGER
    )
    Table vineyard
    (
      vineyard_code VARCHAR(16) PRIMARY KEY,
      vineyard_name VARCHAR(128),
      region_name VARCHAR(128)
    )
    Table trellis
    (
      trellis_code VARCHAR(16) PRIMARY KEY,
      trellis_style VARCHAR(64),
      wire_count INTEGER
    )
    Table crew
    (
      crew_code VARCHAR(16) PRIMARY KEY,
      crew_name VARCHAR(128)
    )
    Table block_note
    (
      block_code VARCHAR(16) PRIMARY KEY,
      reviewer_code VARCHAR(16),
      note_text VARCHAR(256)
    )
    Table reviewer
    (
      reviewer_code VARCHAR(16) PRIMARY KEY,
      reviewer_name VARCHAR(128)
    )
  )

  Join Block_Vineyard(vines.vine_block.vineyard_code = vines.vineyard.vineyard_code)
  Join Block_Trellis(vines.vine_block.trellis_code = vines.trellis.trellis_code)
  Join Block_Crew(vines.vine_block.crew_code = vines.crew.crew_code)
  Join Block_Note(vines.vine_block.block_code = vines.block_note.block_code)
  Join Note_Reviewer(vines.block_note.reviewer_code = vines.reviewer.reviewer_code)
)
