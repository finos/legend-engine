###Service
Service test::silvermarsh4::service::HabitatEffortService
{
  pattern: '/silvermarsh4/habitatEffort';
  title: 'Habitat Reed Cut Effort';
  ownership: DID { identifier: 'wetland-reserve-volunteering' };
  documentation: 'Rolls the reed-cutting season up behind the habitat alone, so the whole requested window collapses into one row per habitat classification.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {seasonStart: StrictDate[1], habitat: String[1]|test::silvermarsh4::domain::ReedCut.all()->filter(
      c|($c.cutOn >= $seasonStart) && ($c.habitatType == $habitat)
    )->groupBy(
      [
        c|$c.habitatType
      ],
      [
        agg(c|$c.metresCut, y|$y->sum()),
        agg(c|$c.volunteerHours, y|$y->sum()),
        agg(c|$c.sessionCode, y|$y->count())
      ],
      [
        'Habitat',
        'Metres Cut',
        'Volunteer Hours',
        'Session Count'
      ]
    )->sort(
      [
        asc('Habitat')
      ]
    )};
    mapping: test::silvermarsh4::mapping::ReserveMapping;
    runtime: test::silvermarsh4::runtime::ReserveRuntime;
  }
  testSuites:
  [
    habitatEffortSuite:
    {
      data:
      [
        connections:
        [
          reserveH2Connection:
            Reference
            #{
              test::silvermarsh4::data::ReedCutSeasonData
            }#
        ]
      ]
      tests:
      [
        reedbedWindowExcludesTheWinterCut:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            seasonStart = %2026-03-01,
            habitat = 'REEDBED'
          ]
          asserts:
          [
            fourReedbedSessions:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Habitat":"REEDBED","Metres Cut":256.5,"Volunteer Hours":20.0,"Session Count":4}]';
                  }#;
              }#
          ]
        },
        fenWindowHoldsTheSingleSedgeSession:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            seasonStart = %2026-03-01,
            habitat = 'FEN'
          ]
          asserts:
          [
            oneFenSession:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Habitat":"FEN","Metres Cut":30.0,"Volunteer Hours":3.0,"Session Count":1}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
