###Relational
Database test::silverapiary3::store::ApiaryDatabase
(
  Schema apiary
  (
    Table sample
    (
      sample_code VARCHAR(24) PRIMARY KEY,
      zone_code VARCHAR(24) NOT NULL,
      condition_code VARCHAR(8) NOT NULL,
      inspection_level INTEGER NOT NULL
    )
    Table zone
    (
      zone_code VARCHAR(24) PRIMARY KEY,
      zone_label VARCHAR(80) NOT NULL
    )
  )
  Join Sample_Zone
  (
    [test::silverapiary3::store::ApiaryDatabase]apiary.sample.zone_code = [test::silverapiary3::store::ApiaryDatabase]apiary.zone.zone_code
  )
)
