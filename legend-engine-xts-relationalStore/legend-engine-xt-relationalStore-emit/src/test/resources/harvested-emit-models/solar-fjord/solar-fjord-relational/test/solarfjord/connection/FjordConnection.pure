###Connection
RelationalDatabaseConnection test::solarfjord::connection::FjordConnection
{
  store: test::solarfjord::store::FjordDatabase;
  type: DB2;
  specification: Static
  {
    name: 'EXAMPLE_FJORD_DB';
    host: 'example-fjord-host';
    port: 50000;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'fjordharvestprincipal';
  };
  postProcessors:
  [
    mapper
    {
      mappers:
      [
        schema {from: 'kelp'; to: 'kelp_curated';},
        table {from: 'shore_gather'; to: 'shore_gather_current'; schemaFrom: 'kelp'; schemaTo: 'kelp_curated';}
      ];
    }
  ];
}
###Connection
RelationalDatabaseConnection test::solarfjord::connection::FjordH2Connection
{
  store: test::solarfjord::store::FjordDatabase;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists kelp;',
      'create schema kelp;',
      'create table kelp.farm_site (site_code varchar(20) primary key, site_name varchar(120) not null, fjord_arm varchar(60) not null);',
      'create table kelp.line_harvest (harvest_id integer primary key, lot_code varchar(30) not null, site_code varchar(20) not null, wet_mass_kg integer not null, blade_grade varchar(30) not null, qc_flag varchar(10) not null);',
      'create table kelp.shore_gather (gather_id integer primary key, lot_code varchar(30) not null, site_code varchar(20) not null, wet_mass_kg integer not null, drift_grade varchar(30));'
      ];
  };
  auth: DefaultH2
  {
  };
}
