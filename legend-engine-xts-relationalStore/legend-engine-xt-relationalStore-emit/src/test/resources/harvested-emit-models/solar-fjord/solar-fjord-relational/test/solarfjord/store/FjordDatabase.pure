###Relational
Database test::solarfjord::store::FjordDatabase
(
  Schema kelp
  (
    Table line_harvest
    (
      harvest_id INTEGER PRIMARY KEY,
      lot_code VARCHAR(30) NOT NULL,
      site_code VARCHAR(20) NOT NULL,
      wet_mass_kg INTEGER NOT NULL,
      blade_grade VARCHAR(30) NOT NULL,
      qc_flag VARCHAR(10) NOT NULL
    )

    Table shore_gather
    (
      gather_id INTEGER PRIMARY KEY,
      lot_code VARCHAR(30) NOT NULL,
      site_code VARCHAR(20) NOT NULL,
      wet_mass_kg INTEGER NOT NULL,
      drift_grade VARCHAR(30)
    )

    Table farm_site
    (
      site_code VARCHAR(20) PRIMARY KEY,
      site_name VARCHAR(120) NOT NULL,
      fjord_arm VARCHAR(60) NOT NULL
    )
  )

  Filter AcceptedHarvestFilter(trim(kelp.line_harvest.qc_flag) = 'ACCEPTED')

  Join Line_Site(kelp.line_harvest.site_code = kelp.farm_site.site_code)
  Join Gather_Site(kelp.shore_gather.site_code = kelp.farm_site.site_code)
)
