###Relational
Database test::quietquokka3::store::RegistryDb
(
  include test::quietquokka3::store::NurseryDb

  Schema registry
  (
    Table cultivar_registration
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )

      registration_code VARCHAR(24) PRIMARY KEY,
      cultivar_code VARCHAR(24) NOT NULL,
      custodian_code VARCHAR(24) NOT NULL,
      listing_path VARCHAR(60) NOT NULL,
      kind_raw VARCHAR(24),
      region_raw VARCHAR(24),
      granted_on DATE NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )

    Table custodian
    (
      custodian_code VARCHAR(24) PRIMARY KEY,
      custodian_name VARCHAR(60) NOT NULL
    )
  )

  Join Registration_Custodian(registry.cultivar_registration.custodian_code = registry.custodian.custodian_code)
  Join Registration_Cultivar(registry.cultivar_registration.cultivar_code = nursery.cultivar_current_vw.cultivar_code)
)
