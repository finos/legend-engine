###Mapping
Mapping test::quietquokka3::mapping::CultivarRegistryMapping
(
  include mapping test::quietquokka3::mapping::NurseryEnumMappings

  *test::quietquokka3::domain::CultivarRegistration[registration]: Relational
  {
    ~primaryKey
    (
      [test::quietquokka3::store::RegistryDb]registry.cultivar_registration.registration_code
    )
    ~mainTable [test::quietquokka3::store::RegistryDb]registry.cultivar_registration
    registrationCode: [test::quietquokka3::store::RegistryDb]registry.cultivar_registration.registration_code,
    listingLevel: substring([test::quietquokka3::store::RegistryDb]registry.cultivar_registration.listing_path, 1, 2),
    listingClass: EnumerationMapping ListingClassMapping: concat(
                    case(
                      equal(toUpper(trim([test::quietquokka3::store::RegistryDb]registry.cultivar_registration.kind_raw)), 'ACCEPTED'),
                      'ACCEPTED',
                      case(
                        equal(toUpper(trim([test::quietquokka3::store::RegistryDb]registry.cultivar_registration.kind_raw)), 'SYNONYM'),
                        'SYNONYM',
                        'UNSTATED'
                      )
                    ),
                    concat(
                      '/',
                      case(
                        equal(toUpper(trim([test::quietquokka3::store::RegistryDb]registry.cultivar_registration.region_raw)), 'NORTH'),
                        'NORTH',
                        case(
                          equal(toUpper(trim([test::quietquokka3::store::RegistryDb]registry.cultivar_registration.region_raw)), 'SOUTH'),
                          'SOUTH',
                          'NONE'
                        )
                      )
                    )
                  ),
    grantedOn: [test::quietquokka3::store::RegistryDb]registry.cultivar_registration.granted_on,
    custodianName: [test::quietquokka3::store::RegistryDb]@Registration_Custodian | rtrim([test::quietquokka3::store::RegistryDb]registry.custodian.custodian_name),
    cultivarName: [test::quietquokka3::store::RegistryDb]@Registration_Cultivar | rtrim([test::quietquokka3::store::RegistryDb]nursery.cultivar_current_vw.cultivar_name)
  }

  testSuites:
  [
    registrationAsOfSuite:
    {
      function: |test::quietquokka3::domain::CultivarRegistration.all(%2026-06-01)->project(
  [
    r|$r.registrationCode,
    r|$r.listingLevel,
    r|$r.listingClass,
    r|$r.listingLabel(%2026-06-01),
    r|$r.custodianName,
    r|$r.cultivarName
  ],
  [
    'Registration',
    'Level',
    'Class',
    'Label',
    'Custodian',
    'Cultivar'
  ]
)->sort(
  [
    asc('Registration')
  ]
);
      tests:
      [
        listingsAtMidSeason:
        {
          doc: 'The business-temporal listing extent resolved at a mid-season instant keeps the two open registrations, drops the one whose validity window closed before it, and passes the same instant into the qualified label so the listing granted earlier reads as listed while the one granted later reads as pending; the listing class is bucketed from a concatenation of two independently rewritten codes rather than a stored one; the custodian name comes from a same-schema join and the cultivar name from a join whose far side only exists in the composing store.';
          data:
          [
            test::quietquokka3::store::RegistryDb:
              Relational
              #{
                registry.cultivar_registration:
                  'registration_code,cultivar_code,custodian_code,listing_path,kind_raw,region_raw,granted_on,from_z,thru_z\n'+
                  'RG-01,CV-S1,CUS-1,AA/NORTH,accepted,north,2026-01-15,2026-01-01,9999-12-31\n'+
                  'RG-02,CV-S2,CUS-2,BB/SOUTH,synonym,south,2026-07-01,2026-01-01,9999-12-31\n'+
                  'RG-03,CV-A1,CUS-1,CC/WEST,,,2025-05-01,2025-01-01,2026-01-01\n';

                registry.custodian:
                  'custodian_code,custodian_name\n'+
                  'CUS-1,Bench Records Office\n'+
                  'CUS-2,Propagation Registry Desk\n';

                nursery.cultivar_stage:
                  'cultivar_code,valid_from,valid_thru_seq,cultivar_name,accepted_code,kind_code\n'+
                  'CV-S1,2026-01-01,99999999,Amber Pippin Synonym,CV-A1,SYNONYM\n'+
                  'CV-S2,2026-01-01,99999999,Bramble Russet Synonym,CV-A2,SYNONYM\n'+
                  'CV-A1,2026-01-01,99999999,Amber Pippin,CV-A1,ACCEPTED\n';
              }#
          ];
          asserts:
          [
            listingRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Registration":"RG-01","Level":"AA","Class":"NorthAccepted","Label":"LISTED RG-01","Custodian":"Bench Records Office","Cultivar":"Amber Pippin Synonym"},{"Registration":"RG-02","Level":"BB","Class":"SouthSynonym","Label":"PENDING RG-02","Custodian":"Propagation Registry Desk","Cultivar":"Bramble Russet Synonym"}]';
                  }#;
              }#
          ];
        }
      ];
    },
    registrationSentinelSuite:
    {
      function: |test::quietquokka3::domain::CultivarRegistration.all(%2999-12-31)->project(
  [
    r|$r.registrationCode,
    r|$r.listingLabel(%2999-12-31),
    r|$r.listingClass,
    r|$r.cultivarName
  ],
  [
    'Registration',
    'Label',
    'Class',
    'Cultivar'
  ]
)->sort(
  [
    asc('Registration')
  ]
);
      tests:
      [
        listingsAtFarFutureSentinel:
        {
          doc: 'Resolved at a far-future sentinel instant the same extent keeps only the registrations left open to the end of the validity window, and both of them read as listed because the sentinel is past every grant date; the registration closed in the past stays out of range, and the cultivar whose staged row is hidden by the view filter contributes no name.';
          data:
          [
            test::quietquokka3::store::RegistryDb:
              Relational
              #{
                registry.cultivar_registration:
                  'registration_code,cultivar_code,custodian_code,listing_path,kind_raw,region_raw,granted_on,from_z,thru_z\n'+
                  'RG-01,CV-S1,CUS-1,AA/NORTH,accepted,north,2026-01-15,2026-01-01,9999-12-31\n'+
                  'RG-02,CV-S2,CUS-2,BB/SOUTH,synonym,south,2026-07-01,2026-01-01,9999-12-31\n'+
                  'RG-03,CV-A1,CUS-1,CC/WEST,,,2025-05-01,2025-01-01,2026-01-01\n';

                registry.custodian:
                  'custodian_code,custodian_name\n'+
                  'CUS-1,Bench Records Office\n'+
                  'CUS-2,Propagation Registry Desk\n';

                nursery.cultivar_stage:
                  'cultivar_code,valid_from,valid_thru_seq,cultivar_name,accepted_code,kind_code\n'+
                  'CV-S1,2026-01-01,99999999,Amber Pippin Synonym,CV-A1,SYNONYM\n'+
                  'CV-S2,2025-01-01,20251231,Bramble Russet Synonym,CV-A2,SYNONYM\n';
              }#
          ];
          asserts:
          [
            sentinelRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Registration":"RG-01","Label":"LISTED RG-01","Class":"NorthAccepted","Cultivar":"Amber Pippin Synonym"},{"Registration":"RG-02","Label":"LISTED RG-02","Class":"SouthSynonym","Cultivar":null}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
