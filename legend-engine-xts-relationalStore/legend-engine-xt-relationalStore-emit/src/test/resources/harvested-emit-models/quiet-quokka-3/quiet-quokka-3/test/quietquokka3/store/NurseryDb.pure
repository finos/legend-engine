###Relational
Database test::quietquokka3::store::NurseryDb
(
  Schema nursery
  (
    Table graft_stage
    (
      graft_code VARCHAR(24) PRIMARY KEY,
      valid_from DATE PRIMARY KEY,
      valid_thru_seq INTEGER NOT NULL,
      block_code VARCHAR(24),
      rootstock_code VARCHAR(24),
      scion_code VARCHAR(24),
      grade_path VARCHAR(60),
      condition_raw VARCHAR(24),
      vigour_raw VARCHAR(24),
      kind_raw VARCHAR(24),
      caliper_mm INTEGER,
      bay_label VARCHAR(40),
      row_label VARCHAR(40),
      tray_label VARCHAR(40),
      grafted_on DATE
    )

    Table block_stage
    (
      block_code VARCHAR(24) PRIMARY KEY,
      valid_from DATE PRIMARY KEY,
      valid_thru_seq INTEGER NOT NULL,
      block_name VARCHAR(60),
      bench_code VARCHAR(24)
    )

    Table bench_stage
    (
      bench_code VARCHAR(24) PRIMARY KEY,
      valid_from DATE PRIMARY KEY,
      valid_thru_seq INTEGER NOT NULL,
      bench_name VARCHAR(60),
      climate_code VARCHAR(24)
    )

    Table climate_stage
    (
      climate_code VARCHAR(24) PRIMARY KEY,
      valid_from DATE PRIMARY KEY,
      valid_thru_seq INTEGER NOT NULL,
      climate_name VARCHAR(60),
      band_raw VARCHAR(24)
    )

    Table rootstock_stage
    (
      rootstock_code VARCHAR(24) PRIMARY KEY,
      valid_from DATE PRIMARY KEY,
      valid_thru_seq INTEGER,
      rootstock_name VARCHAR(60),
      vigour_raw VARCHAR(24)
    )

    Table cultivar_stage
    (
      cultivar_code VARCHAR(24) PRIMARY KEY,
      valid_from DATE PRIMARY KEY,
      valid_thru_seq INTEGER NOT NULL,
      cultivar_name VARCHAR(60),
      accepted_code VARCHAR(24),
      kind_code VARCHAR(24)
    )

    View graft_current_vw
    (
      ~filter [test::quietquokka3::store::NurseryDb]CurrentGraft
      graft_code: nursery.graft_stage.graft_code PRIMARY KEY,
      valid_from: nursery.graft_stage.valid_from PRIMARY KEY,
      block_code: nursery.graft_stage.block_code,
      rootstock_code: nursery.graft_stage.rootstock_code,
      scion_code: nursery.graft_stage.scion_code,
      condition_raw: nursery.graft_stage.condition_raw,
      vigour_raw: nursery.graft_stage.vigour_raw,
      kind_raw: nursery.graft_stage.kind_raw,
      caliper_mm: nursery.graft_stage.caliper_mm,
      bay_label: nursery.graft_stage.bay_label,
      row_label: nursery.graft_stage.row_label,
      tray_label: nursery.graft_stage.tray_label,
      grafted_on: nursery.graft_stage.grafted_on,
      level_code: substring(nursery.graft_stage.grade_path, 1, 3)
    )

    View block_current_vw
    (
      ~filter [test::quietquokka3::store::NurseryDb]CurrentBlock
      block_code: nursery.block_stage.block_code PRIMARY KEY,
      valid_from: nursery.block_stage.valid_from PRIMARY KEY,
      block_name: nursery.block_stage.block_name,
      bench_code: nursery.block_stage.bench_code
    )

    View bench_current_vw
    (
      ~filter [test::quietquokka3::store::NurseryDb]CurrentBench
      bench_code: nursery.bench_stage.bench_code PRIMARY KEY,
      valid_from: nursery.bench_stage.valid_from PRIMARY KEY,
      bench_name: nursery.bench_stage.bench_name,
      climate_code: nursery.bench_stage.climate_code,
      shelter_label: concat('BENCH ', nursery.bench_stage.bench_code)
    )

    View climate_current_vw
    (
      ~filter [test::quietquokka3::store::NurseryDb]CurrentClimate
      climate_code: nursery.climate_stage.climate_code PRIMARY KEY,
      valid_from: nursery.climate_stage.valid_from PRIMARY KEY,
      climate_name: nursery.climate_stage.climate_name,
      band_raw: nursery.climate_stage.band_raw
    )

    View rootstock_current_vw
    (
      ~filter [test::quietquokka3::store::NurseryDb]CurrentRootstock
      rootstock_code: nursery.rootstock_stage.rootstock_code PRIMARY KEY,
      valid_from: nursery.rootstock_stage.valid_from PRIMARY KEY,
      rootstock_name: nursery.rootstock_stage.rootstock_name,
      vigour_raw: nursery.rootstock_stage.vigour_raw
    )

    View cultivar_current_vw
    (
      ~filter [test::quietquokka3::store::NurseryDb]CurrentCultivar
      cultivar_code: nursery.cultivar_stage.cultivar_code PRIMARY KEY,
      valid_from: nursery.cultivar_stage.valid_from PRIMARY KEY,
      cultivar_name: nursery.cultivar_stage.cultivar_name,
      accepted_code: nursery.cultivar_stage.accepted_code,
      kind_code: nursery.cultivar_stage.kind_code
    )
  )

  Filter CurrentGraft(nursery.graft_stage.valid_thru_seq = 99999999)
  Filter CurrentBlock(nursery.block_stage.valid_thru_seq = 99999999)
  Filter CurrentBench(nursery.bench_stage.valid_thru_seq = 99999999)
  Filter CurrentClimate(nursery.climate_stage.valid_thru_seq = 99999999)
  Filter CurrentRootstock(coalesce(nursery.rootstock_stage.valid_thru_seq, 99999999) = 99999999)
  Filter CurrentCultivar(nursery.cultivar_stage.valid_thru_seq = 99999999 and nursery.cultivar_stage.cultivar_name != '')

  Join Graft_Block(nursery.graft_current_vw.block_code = nursery.block_current_vw.block_code)
  Join Block_Bench(nursery.block_current_vw.bench_code = nursery.bench_current_vw.bench_code)
  Join Bench_Climate(nursery.bench_current_vw.climate_code = nursery.climate_current_vw.climate_code)
  Join Graft_Rootstock(coalesce(nursery.graft_current_vw.rootstock_code, 'RS-000') = nursery.rootstock_current_vw.rootstock_code)
  Join Graft_Cultivar(nursery.graft_current_vw.scion_code = nursery.cultivar_current_vw.cultivar_code and nursery.cultivar_current_vw.kind_code = 'SYNONYM')
  Join Cultivar_Accepted(nursery.cultivar_current_vw.accepted_code = {target}.cultivar_code)
)
