###Relational
Database test::ivoryestuary2::store::EstuaryRegisterDb
(
  Schema estuary
  (
    Table roost_site
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      site_code VARCHAR(32) PRIMARY KEY,
      site_name VARCHAR(120) NOT NULL,
      habitat_code VARCHAR(40) NOT NULL,
      warden_code VARCHAR(60),
      last_count_on DATE NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
    Table roost_tally
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      tally_code VARCHAR(32) PRIMARY KEY,
      site_code VARCHAR(32) NOT NULL,
      bird_count INTEGER NOT NULL,
      ring_code VARCHAR(40),
      flock_label VARCHAR(40) NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
  )

  Join Site_Tally(estuary.roost_site.site_code = estuary.roost_tally.site_code)
)
