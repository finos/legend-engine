###Mapping
Mapping test::ivoryestuary2::mapping::EstuaryMapping
(
  *test::ivoryestuary2::domain::RoostSite[roostSite]: Relational
  {
    ~primaryKey
    (
      [test::ivoryestuary2::store::EstuaryRegisterDb]estuary.roost_site.site_code
    )
    ~mainTable [test::ivoryestuary2::store::EstuaryRegisterDb]estuary.roost_site
    siteCode: [test::ivoryestuary2::store::EstuaryRegisterDb]estuary.roost_site.site_code,
    siteName: [test::ivoryestuary2::store::EstuaryRegisterDb]estuary.roost_site.site_name,
    habitatCode: toUpper([test::ivoryestuary2::store::EstuaryRegisterDb]estuary.roost_site.habitat_code),
    wardenCode: trim([test::ivoryestuary2::store::EstuaryRegisterDb]estuary.roost_site.warden_code),
    lastCountOn: [test::ivoryestuary2::store::EstuaryRegisterDb]estuary.roost_site.last_count_on,
    tallies[roostTally]: [test::ivoryestuary2::store::EstuaryRegisterDb]@Site_Tally
  }

  *test::ivoryestuary2::domain::RoostTally[roostTally]: Relational
  {
    ~primaryKey
    (
      [test::ivoryestuary2::store::EstuaryRegisterDb]estuary.roost_tally.tally_code
    )
    ~mainTable [test::ivoryestuary2::store::EstuaryRegisterDb]estuary.roost_tally
    tallyCode: [test::ivoryestuary2::store::EstuaryRegisterDb]estuary.roost_tally.tally_code,
    birdCount: [test::ivoryestuary2::store::EstuaryRegisterDb]estuary.roost_tally.bird_count,
    ringCode: toLower([test::ivoryestuary2::store::EstuaryRegisterDb]estuary.roost_tally.ring_code),
    flockLabel: toUpper([test::ivoryestuary2::store::EstuaryRegisterDb]estuary.roost_tally.flock_label)
  }
)
