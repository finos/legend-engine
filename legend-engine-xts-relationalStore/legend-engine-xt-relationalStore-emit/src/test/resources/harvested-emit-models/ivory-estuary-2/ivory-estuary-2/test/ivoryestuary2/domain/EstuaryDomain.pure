import test::ivoryestuary2::domain::*;

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'One counted flock at a roost site, held as a to-many sub-collection so an existence test can qualify the site.'} test::ivoryestuary2::domain::RoostTally
{
  tallyCode: String[1];
  birdCount: Integer[1];
  ringCode: String[0..1];
  flockLabel: String[1];
}

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'An estuary roost site read at one business instant, reaching its counted flocks through an instant-parameterized property.'} test::ivoryestuary2::domain::RoostSite
{
  siteCode: String[1];
  siteName: String[1];
  habitatCode: String[1];
  wardenCode: String[0..1];
  lastCountOn: StrictDate[1];
  tallies: RoostTally[*];
}
