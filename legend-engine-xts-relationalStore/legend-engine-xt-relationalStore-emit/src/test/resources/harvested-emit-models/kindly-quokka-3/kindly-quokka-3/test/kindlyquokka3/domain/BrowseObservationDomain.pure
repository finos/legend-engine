import meta::pure::profiles::*;

Class {doc.doc = 'One denormalised browse-observation row from a quokka sanctuary field log: a required observation reference plus a wide tail of optional scalar readings whose property names are camel-cased renamings of the abbreviated physical columns.'} test::kindlyquokka3::domain::BrowseObservation
{
  observationRef: String[1];
  colonyLabel: String[0..1];
  sanctuaryName: String[0..1];
  habitatBand: String[0..1];
  shelterCode: String[0..1];
  browseSpeciesCode: String[0..1];
  forageStage: String[0..1];
  observerInitials: String[0..1];
  weatherSummary: String[0..1];
  moonPhaseLabel: String[0..1];
  trackSurfaceKind: String[0..1];
  observedOn: StrictDate[0..1];
  sightedAt: DateTime[0..1];
  quokkaCount: Integer[0..1];
  pouchYoungCount: Integer[0..1];
  browseCoverPct: Float[0..1];
  transectLengthM: Float[0..1];
  notesText: String[0..1];
}
