###Relational
Database test::sablelighthouse2::store::ConservatorStore
(
  Schema staff
  (
    Table conservator
    (
      conservator_id VARCHAR(16) PRIMARY KEY,
      full_name VARCHAR(80),
      studio_code VARCHAR(8)
    )
  )
)

Database test::sablelighthouse2::store::WorkshopDB
(
  include test::sablelighthouse2::store::ConservatorStore

  Schema ticketing
  (
    Table conservation_case
    (
      case_id VARCHAR(16) PRIMARY KEY,
      record_kind VARCHAR(16),
      case_status VARCHAR(16),
      object_label VARCHAR(80),
      priority_level INTEGER,
      conservator_id VARCHAR(16)
    )
    Table case_note
    (
      note_id VARCHAR(16) PRIMARY KEY,
      case_id VARCHAR(16),
      note_text VARCHAR(200),
      note_state VARCHAR(16)
    )
    Table record_kind_ref
    (
      kind_code VARCHAR(16) PRIMARY KEY,
      kind_label VARCHAR(80)
    )
  )

  Join CaseToConservator(ticketing.conservation_case.conservator_id = staff.conservator.conservator_id)
  Join NoteToCase(ticketing.case_note.case_id = ticketing.conservation_case.case_id and ticketing.case_note.note_state <> 'VOID')
  Join CaseToKind(ticketing.conservation_case.record_kind = ticketing.record_kind_ref.kind_code)

  Filter TreatmentCaseFilter(ticketing.conservation_case.record_kind = 'TREATMENT' and ticketing.conservation_case.case_status <> 'CANCELLED')
  Filter SurveyCaseFilter(ticketing.conservation_case.record_kind = 'SURVEY' and ticketing.conservation_case.priority_level >= 1)
)
