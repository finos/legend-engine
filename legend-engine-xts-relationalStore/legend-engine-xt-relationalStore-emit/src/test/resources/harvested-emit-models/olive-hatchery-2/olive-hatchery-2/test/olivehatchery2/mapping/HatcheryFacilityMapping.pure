###Mapping
Mapping test::olivehatchery2::mapping::HatcheryFacilityMapping
(
  *test::olivehatchery2::domain::RearingTank[tank]: Relational
  {
    ~primaryKey
    (
      [test::olivehatchery2::store::HatcheryDb]facility.rearing_tank.tank_code
    )
    ~mainTable [test::olivehatchery2::store::HatcheryDb]facility.rearing_tank
    tankCode: [test::olivehatchery2::store::HatcheryDb]facility.rearing_tank.tank_code,
    volumeLitres: [test::olivehatchery2::store::HatcheryDb]facility.rearing_tank.volume_litres
  }

  *test::olivehatchery2::domain::HatcheryHall[hall]: Relational
  {
    ~primaryKey
    (
      [test::olivehatchery2::store::HatcheryDb]facility.hatchery_hall.hall_code
    )
    ~mainTable [test::olivehatchery2::store::HatcheryDb]facility.hatchery_hall
    hallCode: [test::olivehatchery2::store::HatcheryDb]facility.hatchery_hall.hall_code,
    hallName: rtrim([test::olivehatchery2::store::HatcheryDb]facility.hatchery_hall.hall_name)
  }

  *test::olivehatchery2::domain::HatcherySite[site]: Relational
  {
    ~primaryKey
    (
      [test::olivehatchery2::store::HatcheryDb]facility.hatchery_site.site_code
    )
    ~mainTable [test::olivehatchery2::store::HatcheryDb]facility.hatchery_site
    siteCode: [test::olivehatchery2::store::HatcheryDb]facility.hatchery_site.site_code,
    siteName: rtrim([test::olivehatchery2::store::HatcheryDb]facility.hatchery_site.site_name),
    shoreline: toUpper([test::olivehatchery2::store::HatcheryDb]facility.hatchery_site.shoreline)
  }

  *test::olivehatchery2::domain::WaterSource[waterSource]: Relational
  {
    ~primaryKey
    (
      [test::olivehatchery2::store::HatcheryDb]facility.water_source.source_code
    )
    ~mainTable [test::olivehatchery2::store::HatcheryDb]facility.water_source
    sourceCode: [test::olivehatchery2::store::HatcheryDb]facility.water_source.source_code,
    sourceKind: toUpper([test::olivehatchery2::store::HatcheryDb]facility.water_source.source_kind)
  }

  test::olivehatchery2::domain::Tank_Hall: Relational
  {
    AssociationMapping
    (
      tanks[hall, tank]: [test::olivehatchery2::store::HatcheryDb]@Tank_Hall,
      hall[tank, hall]: [test::olivehatchery2::store::HatcheryDb]@Tank_Hall
    )
  }

  test::olivehatchery2::domain::Hall_Site: Relational
  {
    AssociationMapping
    (
      halls[site, hall]: [test::olivehatchery2::store::HatcheryDb]@Hall_Site,
      site[hall, site]: [test::olivehatchery2::store::HatcheryDb]@Hall_Site
    )
  }

  test::olivehatchery2::domain::Site_Water: Relational
  {
    AssociationMapping
    (
      sources[site, waterSource]: [test::olivehatchery2::store::HatcheryDb]@Site_Water,
      waterSite[waterSource, site]: [test::olivehatchery2::store::HatcheryDb]@Site_Water
    )
  }

  testSuites:
  [
    facilityHierarchySuite:
    {
      function: |test::olivehatchery2::domain::RearingTank.all()->project(
        [
          t|$t.tankCode,
          t|$t.volumeLitres,
          t|$t.hall.hallName,
          t|$t.hall.site.siteName,
          t|$t.hall.site.shoreline,
          t|$t.hall.site.sources.sourceKind
        ],
        [
          'Tank',
          'Volume',
          'Hall',
          'Site',
          'Shoreline',
          'Water'
        ]
      )->sort([asc('Tank')]);
      tests:
      [
        facilityHierarchy:
        {
          doc: 'Walks the facility hierarchy from the rearing tank through the hall to the site and its water intake over the cross-schema joins mapped as association implementations, with the site shoreline and intake kind folded to upper case by the store-side transforms.';
          data:
          [
            test::olivehatchery2::store::HatcheryDb:
              Relational
              #{
                facility.rearing_tank:
                  'tank_code,hall_code,volume_litres\n'+
                  'TK-1,HL-1,4000\n'+
                  'TK-2,HL-1,6000\n'+
                  'TK-3,HL-2,8000\n';

                facility.hatchery_hall:
                  'hall_code,site_code,hall_name\n'+
                  'HL-1,ST-1,North Rearing Hall\n'+
                  'HL-2,ST-2,South Rearing Hall\n';

                facility.hatchery_site:
                  'site_code,site_name,shoreline\n'+
                  'ST-1,Cold Inlet Hatchery,North Shore\n'+
                  'ST-2,Warm Inlet Hatchery,South Shore\n';

                facility.water_source:
                  'source_code,site_code,source_kind\n'+
                  'WS-1,ST-1,seawater\n'+
                  'WS-2,ST-2,borehole\n';
              }#
          ];
          asserts:
          [
            rows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Tank":"TK-1","Volume":4000,"Hall":"North Rearing Hall","Site":"Cold Inlet Hatchery","Shoreline":"NORTH SHORE","Water":"SEAWATER"},{"Tank":"TK-2","Volume":6000,"Hall":"North Rearing Hall","Site":"Cold Inlet Hatchery","Shoreline":"NORTH SHORE","Water":"SEAWATER"},{"Tank":"TK-3","Volume":8000,"Hall":"South Rearing Hall","Site":"Warm Inlet Hatchery","Shoreline":"SOUTH SHORE","Water":"BOREHOLE"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
