###Pure
import meta::pure::profiles::*;
import test::olivehatchery2::domain::*;

Class {doc.doc = 'A conditioned batch of adult shellfish held for spawning, with the derived label that folds a missing conditioning note onto a fixed sentinel.'} test::olivehatchery2::domain::BroodstockLot
{
  recordCode: String[1];
  lotCode: String[1];
  originBay: String[1];
  conditionedOn: StrictDate[1];
  lotNote: String[1];
  lotLabel() {$this.lotCode + ' from ' + $this.originBay}: String[1];
}

Class {doc.doc = 'One induced spawning of a broodstock lot, recording the day of release and the water temperature held during it.'} test::olivehatchery2::domain::SpawningRun
{
  recordCode: String[1];
  runCode: String[1];
  spawnedOn: StrictDate[1];
  waterTemperature: Float[1];
}

Class {doc.doc = 'A rearing batch of larvae stocked into one tank from a spawning run. The vigour label is resolved from the recorded vigour code through eight case arms with an unrecorded fallback, the batch note folds onto a sentinel when unrecorded, and three properties are reached through join paths of increasing length: the tank volume one hop out, the hall name two hops out through an inner hop, and the site name three hops out.'} test::olivehatchery2::domain::LarvalBatch
{
  recordCode: String[1];
  batchCode: String[1];
  stockedCount: Integer[1];
  stockedOn: StrictDate[1];
  vigourLabel: String[1];
  batchNote: String[1];
  tankVolumeLitres: Integer[0..1];
  hallLabel: String[0..1];
  siteLabel: String[0..1];
  batchLabel() {$this.batchCode->toUpper() + ' / ' + $this.vigourLabel}: String[1];
  stockingMark() {if($this.stockedCount >= 100000, | 'H', | if($this.stockedCount >= 50000, | 'M', | $this.stockedCount->toOne()->toString()))}: String[1];
}

Class {doc.doc = 'One dated reading of larval density, survival and feed taken from a rearing batch.'} test::olivehatchery2::domain::TankReading
{
  readingId: Integer[1];
  readOn: StrictDate[1];
  larvalDensity: Integer[1];
  survivalPercent: Integer[1];
  feedGrams: Float[1];
  densityMark() {if($this.larvalDensity >= 800, | 'H', | if($this.larvalDensity >= 500, | 'M', | $this.larvalDensity->toOne()->toString()))}: String[1];
}

Class {doc.doc = 'A grading pass over a rearing batch, recording the mesh the larvae were screened on and how many were retained.'} test::olivehatchery2::domain::GradingEvent
{
  eventId: Integer[1];
  gradedOn: StrictDate[1];
  retainedCount: Integer[1];
  meshMicron: Integer[1];
}

Class {doc.doc = 'A rearing tank in a hatchery hall, the physical vessel a larval batch occupies.'} test::olivehatchery2::domain::RearingTank
{
  tankCode: String[1];
  volumeLitres: Integer[1];
}

Class {doc.doc = 'A hall of rearing tanks: the second level of the facility hierarchy.'} test::olivehatchery2::domain::HatcheryHall
{
  hallCode: String[1];
  hallName: String[1];
}

Class {doc.doc = 'A hatchery site: the third level of the facility hierarchy, the level the throughput rollups are published at.'} test::olivehatchery2::domain::HatcherySite
{
  siteCode: String[1];
  siteName: String[1];
  shoreline: String[1];
}

Class {doc.doc = 'An intake the hatchery site draws its rearing water from.'} test::olivehatchery2::domain::WaterSource
{
  sourceCode: String[1];
  sourceKind: String[1];
}

Association {doc.doc = 'Relates a broodstock lot to the spawning runs induced from it.'} test::olivehatchery2::domain::Lot_Run
{
  lot: BroodstockLot[1];
  runs: SpawningRun[*];
}

Association {doc.doc = 'Relates a spawning run to the larval batches stocked from it.'} test::olivehatchery2::domain::Run_Batch
{
  run: SpawningRun[1];
  batches: LarvalBatch[*];
}

Association {doc.doc = 'Relates a larval batch to the rearing tank it occupies.'} test::olivehatchery2::domain::Batch_Tank
{
  batches: LarvalBatch[*];
  tank: RearingTank[1];
}

Association {doc.doc = 'Relates a rearing tank to the hall it stands in.'} test::olivehatchery2::domain::Tank_Hall
{
  tanks: RearingTank[*];
  hall: HatcheryHall[1];
}

Association {doc.doc = 'Relates a hatchery hall to the site it belongs to.'} test::olivehatchery2::domain::Hall_Site
{
  halls: HatcheryHall[*];
  site: HatcherySite[1];
}

Association {doc.doc = 'Relates a hatchery site to the water intakes feeding it.'} test::olivehatchery2::domain::Site_Water
{
  waterSite: HatcherySite[1];
  sources: WaterSource[*];
}

Association {doc.doc = 'Relates a larval batch to the dated readings taken from it.'} test::olivehatchery2::domain::Batch_Reading
{
  readBatch: LarvalBatch[1];
  readings: TankReading[*];
}

Association {doc.doc = 'Relates a larval batch to the grading passes run over it.'} test::olivehatchery2::domain::Batch_Grading
{
  gradedBatch: LarvalBatch[1];
  gradings: GradingEvent[*];
}
