###Runtime
Runtime test::opalquarry::runtime::QuarryYardRuntime
{
  mappings:
  [
    test::opalquarry::mapping::QuarryMapping
  ];
  connections:
  [
    test::opalquarry::store::QuarryDB:
    [
      yardConnection: test::opalquarry::connection::QuarryYardConnection
    ]
  ];
}

Runtime test::opalquarry::runtime::QuarryArchiveRuntime
{
  mappings:
  [
    test::opalquarry::mapping::QuarryMapping
  ];
  connections:
  [
    test::opalquarry::store::QuarryDB:
    [
      archiveConnection: test::opalquarry::connection::QuarryArchiveConnection
    ]
  ];
}
