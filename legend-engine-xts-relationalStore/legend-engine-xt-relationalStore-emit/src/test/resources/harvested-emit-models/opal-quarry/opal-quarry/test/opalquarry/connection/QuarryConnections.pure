###Connection
RelationalDatabaseConnection test::opalquarry::connection::QuarryYardConnection
{
  store: test::opalquarry::store::QuarryDB;
  type: MemSQL;
  specification: Static
  {
    name: 'EXAMPLE_STONEYARD_DB';
    host: 'example-stoneyard-host';
    port: 3306;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'stoneyardserviceprincipal';
  };
}

RelationalDatabaseConnection test::opalquarry::connection::QuarryArchiveConnection
{
  store: test::opalquarry::store::QuarryDB;
  type: MemSQL;
  specification: Static
  {
    name: 'EXAMPLE_STONEYARD_ARCHIVE_DB';
    host: 'example-stoneyard-archive-host';
    port: 3307;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'stoneyardarchiveprincipal';
  };
}
