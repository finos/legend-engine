###Pure
import test::borealthicket4::domain::*;

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'One snow-course reading taken on a stake of the boreal thicket survey, effective over business time so a re-measured stake supersedes its earlier reading while the window it was reported for stays put. The stand, tier, species and crew context is reached out of the survey store rather than held on the stake row.'} test::borealthicket4::domain::SnowStake
{
  stakeCode: String[1];
  stakeName: String[1];
  standCode: String[0..1];
  speciesCode: String[0..1];
  crewCode: String[0..1];
  depthCm: Float[1];
  densityPct: Integer[1];
  readOn: StrictDate[1];
  standName: String[0..1];
  standTier: String[0..1];
  speciesName: String[0..1];
  crewRoster: SurveyCrew[*];
}

Class {meta::pure::profiles::doc.doc = 'A named stand block of the thicket survey, carrying the canopy tier the stakes inside it are reported against.'} test::borealthicket4::domain::StandBlock
{
  standCode: String[1];
  standName: String[1];
  standTier: String[1];
}

Class {meta::pure::profiles::doc.doc = 'The species tag a stake reading is filed under.'} test::borealthicket4::domain::SpeciesTag
{
  speciesCode: String[1];
  speciesName: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A survey crew that walks the snow course and records the stake readings.'} test::borealthicket4::domain::SurveyCrew
{
  crewCode: String[1];
  crewName: String[1];
}
