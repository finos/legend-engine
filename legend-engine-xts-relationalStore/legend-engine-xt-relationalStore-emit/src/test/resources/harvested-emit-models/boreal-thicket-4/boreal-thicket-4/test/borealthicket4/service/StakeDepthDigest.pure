###Service
Service test::borealthicket4::service::StakeDepthDigest
{
  pattern: '/borealthicket4/v1/stake-depth-digest/{asOf}';
  title: 'Boreal Thicket - Snow Depth Digest At An Instant';
  owners:
  [
    'snow-course-survey',
    'thicket-monitoring'
  ];
  documentation: 'Point-in-time digest of the snow-course readings: the milestoning instant is threaded into the stake traversal, the surviving readings are narrowed by density, depth, canopy tier, species and a crew-roster collection test, and the survivors are grouped by their joined stand with their depths summed and counted.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {asOf: StrictDate[1], minDepth: Float[1], tiers: String[*]|test::borealthicket4::domain::SnowStake.all($asOf)->filter(
      s|($s.densityPct > 20) && (($s.depthCm >= $minDepth) && (($s.standTier->toOne()->in($tiers)) && (($s.speciesName->toOne() == 'Black Spruce') && ($s.crewRoster->exists(c|$c.crewName != 'Unassigned Crew')))))
    )->groupBy(
      [
        s|$s.standName->toOne()
      ],
      [
        agg(s|$s.depthCm, y|$y->sum()),
        agg(s|$s.depthCm, y|$y->count())
      ],
      [
        'Stand',
        'TotalDepth',
        'Stakes'
      ]
    )->sort(
      [
        asc('Stand')
      ]
    )->limit(5)};
    mapping: test::borealthicket4::mapping::ThicketMapping;
    runtime: test::borealthicket4::runtime::ThicketPrimaryRuntime;
  }
  testSuites:
  [
    stakeDepthDigestSuite:
    {
      data:
      [
      connections:
      [
        thicketConnection:
          Relational
          #{
            thicket.snow_stake:
              'stake_code,stake_name,stand_code,species_code,crew_code,depth_cm,density_pct,read_on,valid_from,valid_thru\n'+
              'S-1,Stake Ridge North,ST-1,SP-1,CR-1,92.5,45,2026-03-01,2026-01-01,9999-12-31\n'+
              'S-2,Stake Hollow Mid,ST-2,SP-2,CR-2,64.0,55,2026-03-02,2026-02-01,9999-12-31\n'+
              'S-3,Stake Burn Old,ST-1,SP-1,CR-1,40.0,70,2025-05-01,2025-01-01,2025-09-01\n'+
              'S-4,Stake Muskeg Edge,,,,18.0,30,2026-03-05,2026-01-15,9999-12-31\n';
            thicket.stand_block:
              'stand_code,stand_name,stand_tier\n'+
              'ST-1,North Ridge Stand,UPPER\n'+
              'ST-2,Hollow Stand,LOWER\n';
            thicket.species_tag:
              'species_code,species_name\n'+
              'SP-1,Black Spruce\n'+
              'SP-2,Jack Pine\n';
            thicket.survey_crew:
              'crew_code,crew_name\n'+
              'CR-1,Ridge Crew\n'+
              'CR-2,Hollow Crew\n';
          }#
      ]
      ]
      tests:
      [
        onlyTheLiveBlackSpruceRidgeReadingIsGrouped:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            asOf = %2026-03-15,
            minDepth = 20.0,
            tiers = ['UPPER', 'LOWER']
          ]
          asserts:
          [
            oneStandGroupSurvives:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Stand":"North Ridge Stand","TotalDepth":92.5,"Stakes":1}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
