###Relational
Database test::borealthicket4::store::ThicketDb
(
  Schema thicket
  (
    Table snow_stake
    (
      milestoning
      (
        business(BUS_FROM = valid_from, BUS_THRU = valid_thru)
      )
      stake_code VARCHAR(16) PRIMARY KEY,
      stake_name VARCHAR(48) NOT NULL,
      stand_code VARCHAR(16),
      species_code VARCHAR(16),
      crew_code VARCHAR(16),
      depth_cm DOUBLE NOT NULL,
      density_pct INTEGER NOT NULL,
      read_on DATE NOT NULL,
      valid_from DATE NOT NULL,
      valid_thru DATE NOT NULL
    )

    Table stand_block
    (
      stand_code VARCHAR(16) PRIMARY KEY,
      stand_name VARCHAR(48) NOT NULL,
      stand_tier VARCHAR(16) NOT NULL
    )

    Table species_tag
    (
      species_code VARCHAR(16) PRIMARY KEY,
      species_name VARCHAR(48) NOT NULL
    )

    Table survey_crew
    (
      crew_code VARCHAR(16) PRIMARY KEY,
      crew_name VARCHAR(48) NOT NULL
    )
  )

  Join Stake_Stand(thicket.snow_stake.stand_code = thicket.stand_block.stand_code)
  Join Stake_Species(thicket.snow_stake.species_code = thicket.species_tag.species_code)
  Join Stake_Crew(thicket.snow_stake.crew_code = thicket.survey_crew.crew_code)
)
