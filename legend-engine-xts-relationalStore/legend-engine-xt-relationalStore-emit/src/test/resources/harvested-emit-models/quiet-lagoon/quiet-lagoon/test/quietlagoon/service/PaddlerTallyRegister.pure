###Service
Service test::quietlagoon::service::PaddlerTallyRegister
{
  pattern: '/quietlagoon/v1/paddler-tally/{topN}';
  title: 'Quiet Lagoon - Busiest Craft Kinds';
  ownership: DID { identifier: '000000' };
  documentation: 'Tallies the paddlers carried by each craft kind out of the home lagoon, orders the tally so the busiest kind leads and publishes only as many rows as the caller asks for, so a caller asking for one row receives the busiest kind alone.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: {topN: Integer[1]|test::quietlagoon::domain::LaunchLog.all()->filter(
      l|($l.lagoonName == 'Quiet Lagoon') && ($l.paddlerName->isNotEmpty())
    )->groupBy(
      [
        l|$l.craftKind
      ],
      [
        agg(l|$l.crewSize, y|$y->sum())
      ],
      [
        'Craft',
        'Paddlers'
      ]
    )->distinct()->sort([desc('Paddlers')])->limit($topN)};
    mapping: test::quietlagoon::mapping::LagoonMapping;
    runtime: test::quietlagoon::runtime::LagoonRuntime;
  }
  testSuites:
  [
    paddlerTallySuite:
    {
      data:
      [
        connections:
        [
          lagoonConnection:
            Relational
            #{
              lagoon.launch_log:
                'launch_code,paddler_name,craft_kind,hull_material,lagoon_name,dock_code,paddler_minutes,crew_size\n'+
                'LG-01,Ada Wren,SEA KAYAK,FIBREGLASS,Quiet Lagoon,D-101,45,2\n'+
                'LG-02,Bo Finch,SEA KAYAK,FIBREGLASS,Quiet Lagoon,D-102,20,1\n'+
                'LG-03,Cy Heron,CANOE,CEDAR,Quiet Lagoon,D-201,60,3\n'+
                'LG-04,Di Egret,PACKRAFT,VINYL,Still Lagoon,D-101,50,2\n'+
                'LG-05,El Rail,CANOE,CEDAR,Quiet Lagoon,D-201,35,1\n';
            }#
        ]
      ]
      tests:
      [
        theBusiestCraftKindAlone:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            topN = 1
          ]
          asserts:
          [
            onlyTheLeadingKind:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Craft":"CANOE","Paddlers":4}]';
                  }#;
              }#
          ]
        },
        theWholeTallyWhenTheCeilingExceedsTheKinds:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            topN = 10
          ]
          asserts:
          [
            bothKindsInDescendingOrder:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Craft":"CANOE","Paddlers":4},{"Craft":"SEA KAYAK","Paddlers":3}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
