###Pure
function test::quietlagoon::function::normalisedCode(code: String[1]): String[1]
{
  $code->toUpper()->trim()
}

function test::quietlagoon::function::craftBadge(craftKind: String[1], paddlerMinutes: Integer[1]): String[1]
{
  if($paddlerMinutes > 30, |((test::quietlagoon::function::normalisedCode($craftKind)->substring(0, 4) + '/') + ($paddlerMinutes * 2)->toString()), |'SHORT PADDLE')
}

function test::quietlagoon::function::isLongHaul(paddlerMinutes: Integer[1], floorMinutes: Integer[1]): Boolean[1]
{
  $paddlerMinutes >= $floorMinutes
}

function test::quietlagoon::function::isCrewed(crewSize: Integer[1]): Boolean[1]
{
  $crewSize > 1
}

function test::quietlagoon::function::dockBand(dockCode: String[1]): String[1]
{
  if(test::quietlagoon::function::normalisedCode($dockCode)->startsWith('D-1'), |'INNER DOCKS', |'OUTER DOCKS')
}
