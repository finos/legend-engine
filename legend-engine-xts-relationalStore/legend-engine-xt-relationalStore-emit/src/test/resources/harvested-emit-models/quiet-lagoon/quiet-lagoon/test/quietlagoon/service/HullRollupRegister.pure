###Service
Service test::quietlagoon::service::HullRollupRegister
{
  pattern: '/quietlagoon/v1/hull-rollup';
  title: 'Quiet Lagoon - Crewed Canoe Hull Rollup';
  ownership: DID { identifier: '000000' };
  documentation: 'Counts the crewed canoe paddles that stayed out past a standing floor and whose hull material sits in a caller-supplied set, with every arm of the predicate answered by a function rather than a stored column, so a solo paddle in the same hull is struck out.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: {hullMaterials: String[*]|test::quietlagoon::domain::LaunchLog.all()->filter(
      l|(test::quietlagoon::function::isLongHaul($l.paddlerMinutes, 30)) && ((test::quietlagoon::function::isCrewed($l.crewSize)) && (($l.hullMaterial->in($hullMaterials)) && (test::quietlagoon::function::normalisedCode($l.craftKind) == 'CANOE')))
    )->groupBy(
      [
        l|$l.hullMaterial
      ],
      [
        agg(l|$l.launchCode, y|$y->count())
      ],
      [
        'Hull',
        'Launches'
      ]
    )->distinct()->sort([asc('Hull')])};
    mapping: test::quietlagoon::mapping::LagoonMapping;
    runtime: test::quietlagoon::runtime::LagoonRuntime;
  }
  testSuites:
  [
    hullRollupSuite:
    {
      data:
      [
        connections:
        [
          lagoonConnection:
            Relational
            #{
              lagoon.launch_log:
                'launch_code,paddler_name,craft_kind,hull_material,lagoon_name,dock_code,paddler_minutes,crew_size\n'+
                'LG-01,Ada Wren,SEA KAYAK,FIBREGLASS,Quiet Lagoon,D-101,45,2\n'+
                'LG-03,Cy Heron,CANOE,CEDAR,Quiet Lagoon,D-201,60,3\n'+
                'LG-04,Di Egret,PACKRAFT,VINYL,Still Lagoon,D-101,50,2\n'+
                'LG-05,El Rail,CANOE,CEDAR,Quiet Lagoon,D-201,35,1\n';
            }#
        ]
      ]
      tests:
      [
        theCrewedCanoeHullAlone:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            hullMaterials = ['CEDAR', 'VINYL']
          ]
          asserts:
          [
            oneCedarHullPaddle:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Hull":"CEDAR","Launches":1}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
