###Relational
Database test::quietlagoon::store::LagoonDb
(
  Schema lagoon
  (
    Table launch_log
    (
      launch_code VARCHAR(24) PRIMARY KEY,
      paddler_name VARCHAR(120) NOT NULL,
      craft_kind VARCHAR(32) NOT NULL,
      hull_material VARCHAR(32) NOT NULL,
      lagoon_name VARCHAR(120) NOT NULL,
      dock_code VARCHAR(24) NOT NULL,
      paddler_minutes INTEGER NOT NULL,
      crew_size INTEGER NOT NULL
    )
  )
)
