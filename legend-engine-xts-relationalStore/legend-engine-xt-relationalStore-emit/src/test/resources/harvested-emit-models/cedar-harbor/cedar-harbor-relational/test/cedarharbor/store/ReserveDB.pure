###Relational
Database test::cedarharbor::store::ReserveDB
(
  Schema census
  (
    Table animal_count
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )

      reserve_code VARCHAR(20) PRIMARY KEY,
      species VARCHAR(60) PRIMARY KEY,
      headcount INTEGER NOT NULL,
      from_z TIMESTAMP NOT NULL,
      thru_z TIMESTAMP
    )
  )
)
