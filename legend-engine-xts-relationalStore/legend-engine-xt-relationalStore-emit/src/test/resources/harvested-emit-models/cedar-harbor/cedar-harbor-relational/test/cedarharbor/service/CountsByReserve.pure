###Service
Service test::cedarharbor::service::CountsByReserve
{
  pattern: '/reserve/v1/counts/{reserveCode}';
  title: 'Reserve - Species Counts by Reserve';
  owners:
  [
    'reserve-platform',
    'wildlife-eng'
  ];
  documentation: 'Returns the species and headcount observed in a given reserve as of a business date, over the business-temporal animal_count table via ReserveMapping and ReserveRuntime.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {reserveCode: String[1], businessDate: StrictDate[1]|test::cedarharbor::domain::AnimalCount.all($businessDate)->filter(
      a|$a.reserveCode == $reserveCode
    )->project(
      [
        a|$a.species,
        a|$a.headcount
      ],
      [
        'Species',
        'Headcount'
      ]
    )};
    mapping: test::cedarharbor::mapping::ReserveMapping;
    runtime: test::cedarharbor::runtime::ReserveRuntime;
  }
  testSuites:
  [
    countsByReserveSuite:
    {
      data:
      [
        connections:
        [
          reserveConnection:
            Relational
            #{
              census.animal_count:
                'reserve_code,species,headcount,from_z,thru_z\n'+
                'NORTH,Osprey,12,2020-01-01,2999-12-31\n'+
                'NORTH,Grey Heron,7,2020-01-01,2999-12-31\n'+
                'SOUTH,Osprey,3,2020-01-01,2999-12-31\n';
            }#
        ]
      ]
      tests:
      [
        northAsOf2023:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            reserveCode = 'NORTH',
            businessDate = %2023-06-01
          ]
          asserts:
          [
            twoNorthSpecies:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Species":"Osprey","Headcount":12},{"Species":"Grey Heron","Headcount":7}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
