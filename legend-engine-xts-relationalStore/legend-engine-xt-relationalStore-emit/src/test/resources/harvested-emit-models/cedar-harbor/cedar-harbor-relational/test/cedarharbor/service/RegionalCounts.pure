###Service
Service test::cedarharbor::service::RegionalCounts
{
  pattern: '/reserve/v1/regional-counts';
  title: 'Reserve - Regional Species Counts (multi-environment)';
  owners:
  [
    'reserve-platform',
    'wildlife-eng'
  ];
  documentation: 'Multi-execution service that selects a region-keyed mapping/runtime binding at execution time and projects species headcounts as of a business date over the business-temporal animal_count table.';
  autoActivateUpdates: true;
  execution: Multi
  {
    query: {businessDate: StrictDate[1]|test::cedarharbor::domain::AnimalCount.all($businessDate)->project(
      [
        a|$a.reserveCode,
        a|$a.species,
        a|$a.headcount
      ],
      [
        'Reserve',
        'Species',
        'Headcount'
      ]
    )};
    key: 'region';
    executions['coastal']:
    {
      mapping: test::cedarharbor::mapping::ReserveMapping;
      runtime: test::cedarharbor::runtime::ReserveRuntime;
    }
    executions['inland']:
    {
      mapping: test::cedarharbor::mapping::ReserveMapping;
      runtime: test::cedarharbor::runtime::ReserveRuntime;
    }
  }
}
