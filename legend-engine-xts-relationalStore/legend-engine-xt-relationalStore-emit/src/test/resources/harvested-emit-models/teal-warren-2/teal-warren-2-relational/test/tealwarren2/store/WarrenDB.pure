###Relational
Database test::tealwarren2::store::WarrenDB
(
  Schema habitat
  (
    Table warren_colony
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z, INFINITY_DATE = %9999-12-31T00:00:00.000000+0000)
      )

      colony_code VARCHAR(20) PRIMARY KEY,
      warren_name VARCHAR(200) NOT NULL,
      burrow_count INTEGER NOT NULL,
      soil_code VARCHAR(10) NOT NULL,
      surveyor_first VARCHAR(60) NOT NULL,
      surveyor_last VARCHAR(60) NOT NULL,
      from_z TIMESTAMP NOT NULL,
      thru_z TIMESTAMP NOT NULL
    )
  )
)
