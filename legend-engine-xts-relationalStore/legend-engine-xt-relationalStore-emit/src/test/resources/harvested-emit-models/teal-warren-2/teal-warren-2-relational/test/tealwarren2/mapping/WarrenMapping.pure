###Mapping
Mapping test::tealwarren2::mapping::WarrenMapping
(
  *test::tealwarren2::domain::WarrenColony[colony]: Relational
  {
    ~primaryKey
    (
      [test::tealwarren2::store::WarrenDB]habitat.warren_colony.colony_code
    )
    ~mainTable [test::tealwarren2::store::WarrenDB]habitat.warren_colony
    colonyCode: [test::tealwarren2::store::WarrenDB]habitat.warren_colony.colony_code,
    warrenLabel: concat([test::tealwarren2::store::WarrenDB]habitat.warren_colony.warren_name, concat(' #', [test::tealwarren2::store::WarrenDB]habitat.warren_colony.colony_code)),
    burrowCount: [test::tealwarren2::store::WarrenDB]habitat.warren_colony.burrow_count,
    soilCode: [test::tealwarren2::store::WarrenDB]habitat.warren_colony.soil_code,
    surveyorInitials: concat([test::tealwarren2::store::WarrenDB]habitat.warren_colony.surveyor_first, concat(' ', [test::tealwarren2::store::WarrenDB]habitat.warren_colony.surveyor_last))
  }

  testSuites:
  [
    colonyProjectionSuite:
    {
      function: |test::tealwarren2::domain::WarrenColony.all(%2025-06-01T00:00:00)->project(
        [
          c|$c.colonyCode,
          c|$c.warrenLabel,
          c|$c.burrowCount,
          c|$c.densityTier
        ],
        [
          'ColonyCode',
          'WarrenLabel',
          'BurrowCount',
          'DensityTier'
        ]
      )->sort([asc('ColonyCode')]);
      tests:
      [
        coloniesAsOfMid2025:
        {
          doc: 'Projects the colonies whose business validity window contains the queried date, with the concatenated warren label and the derived density tier; the retired colony row falls outside the window and is excluded.';
          data:
          [
            test::tealwarren2::store::WarrenDB:
              Relational
              #{
                habitat.warren_colony:
                  'colony_code,warren_name,burrow_count,soil_code,surveyor_first,surveyor_last,from_z,thru_z\n'+
                  'WC-01,Bracken Slope,72,CHALK,Ada,Fenwick,2024-01-01 00:00:00,9999-12-31 00:00:00\n'+
                  'WC-02,Hollow Ridge,31,LOAM,Ivo,Marsden,2024-01-01 00:00:00,9999-12-31 00:00:00\n'+
                  'WC-03,Gorse Ledge,9,SAND,Rhea,Colby,2023-01-01 00:00:00,2024-06-30 00:00:00\n';
              }#
          ];
          asserts:
          [
            twoLiveColonies:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"ColonyCode":"WC-01","WarrenLabel":"Bracken Slope #WC-01","BurrowCount":72,"DensityTier":"ESTABLISHED"},{"ColonyCode":"WC-02","WarrenLabel":"Hollow Ridge #WC-02","BurrowCount":31,"DensityTier":"GROWING"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
