###Relational
Database test::easternquokka4::store::RouteDb
(
  Schema district
  (
    Table route_assignment
    (
      milestoning
      (
        processing(PROCESSING_IN = in_date, PROCESSING_OUT = out_date)
      )
      assignment_code VARCHAR(20) PRIMARY KEY,
      route_code VARCHAR(20) NOT NULL,
      school_code VARCHAR(20) NOT NULL,
      driver_code VARCHAR(20) NOT NULL,
      rider_count INTEGER NOT NULL,
      service_band VARCHAR(20) NOT NULL,
      in_date DATE NOT NULL,
      out_date DATE
    )
  )
)
