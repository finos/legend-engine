###Service
Service test::easternquokka4::service::RouteRosterService
{
  pattern: '/district/routes/{processingDate}';
  documentation: 'Returns the active district shuttle assignments and their operational labels.';
  execution: Single
  {
    query: {processingDate: StrictDate[1]|test::easternquokka4::function::activeRosterRows($processingDate)};
    mapping: test::easternquokka4::mapping::RouteRelationalMapping;
    runtime: test::easternquokka4::runtime::RouteEngineRuntime;
  }
  testSuites:
  [
    routeRosterSuite:
    {
      data:
      [
        connections:
        [
          route:
            Relational
            #{
              district.route_assignment:
                'assignment_code,route_code,school_code,driver_code,rider_count,service_band,in_date,out_date\n'+
                'RA-06,ROUTE-6,SCHOOL-F,DRIVER-1,19,CORE,2026-01-01,9999-12-31\n'+
                'RA-07,ROUTE-8,SCHOOL-G,DRIVER-3,12,FLEX,2026-01-01,9999-12-31\n'+
                'RA-08,ROUTE-3,SCHOOL-H,DRIVER-5,9,NIGHT,2026-01-01,9999-12-31\n';
            }#
        ]
      ]
      tests:
      [
        activeRoster:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            processingDate = %2026-02-01
          ]
          asserts:
          [
            activeAssignment:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Assignment":"RA-06","Route":"SCHOOL-F/ROUTE-6","School":"SCHOOL-F","Driver":"DRIVER-1/ROUTE-6","Riders":22,"Band":"CORE","Label":"core-route"},{"Assignment":"RA-07","Route":"SCHOOL-G/ROUTE-8","School":"SCHOOL-G","Driver":"DRIVER-3/ROUTE-8","Riders":15,"Band":"FLEX","Label":"flex-route"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
