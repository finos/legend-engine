###Runtime
Runtime test::easternquokka4::runtime::RouteEngineRuntime
{
  mappings:
  [
    test::easternquokka4::mapping::RouteRelationalMapping
  ];
  connections:
  [
    test::easternquokka4::store::RouteDb:
    [
      route: test::easternquokka4::connection::RouteConnection
    ]
  ];
}

Runtime test::easternquokka4::runtime::RosterEngineRuntime
{
  mappings:
  [
    test::easternquokka4::mapping::RouteRelationalMapping,
    test::easternquokka4::mapping::RosterM2MMapping
  ];
  connections:
  [
    test::easternquokka4::store::RouteDb:
    [
      route: test::easternquokka4::connection::RouteConnection
    ]
  ];
}
