###Relational
Database test::duskytundra::store::TundraDatabase
(
  Schema tundra
  (
    Table lichen_plot
    (
      plot_code VARCHAR(12) PRIMARY KEY,
      range_name VARCHAR(40) NOT NULL,
      grazing_band VARCHAR(20) NOT NULL,
      lichen_cover_pct INTEGER NOT NULL,
      moss_depth_mm INTEGER NOT NULL,
      surveyed_on DATE NOT NULL
    )
  )
)
