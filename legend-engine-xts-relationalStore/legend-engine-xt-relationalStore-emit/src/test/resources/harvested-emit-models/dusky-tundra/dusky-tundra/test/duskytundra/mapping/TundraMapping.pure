###Mapping
Mapping test::duskytundra::mapping::TundraMapping
(
  *test::duskytundra::domain::LichenPlot[plot]: Relational
  {
    ~primaryKey
    (
      [test::duskytundra::store::TundraDatabase]tundra.lichen_plot.plot_code
    )
    ~mainTable [test::duskytundra::store::TundraDatabase]tundra.lichen_plot
    plotCode: [test::duskytundra::store::TundraDatabase]tundra.lichen_plot.plot_code,
    rangeName: [test::duskytundra::store::TundraDatabase]tundra.lichen_plot.range_name,
    grazingBand: [test::duskytundra::store::TundraDatabase]tundra.lichen_plot.grazing_band,
    lichenCoverPct: [test::duskytundra::store::TundraDatabase]tundra.lichen_plot.lichen_cover_pct,
    mossDepthMm: [test::duskytundra::store::TundraDatabase]tundra.lichen_plot.moss_depth_mm,
    surveyedOn: [test::duskytundra::store::TundraDatabase]tundra.lichen_plot.surveyed_on
  }

  testSuites:
  [
    plotSuite:
    {
      function: |test::duskytundra::domain::LichenPlot.all()->project(
  [
    col(
      p|$p.plotCode,
      'Plot'
    ),
    col(
      p|$p.rangeName,
      'Range'
    ),
    col(
      p|$p.grazingBand,
      'Band'
    ),
    col(
      p|$p.lichenCoverPct,
      'Cover'
    )
  ]
)->sort([asc('Plot')]);
      tests:
      [
        allPlots:
        {
          doc: 'Every directly bound column of the plot table surfaces in the projection, in plot order.';
          data:
          [
            test::duskytundra::store::TundraDatabase:
              Relational
              #{
                tundra.lichen_plot:
                  'plot_code,range_name,grazing_band,lichen_cover_pct,moss_depth_mm,surveyed_on\n'+
                  'LP-01,NORTH RIDGE,ROTATIONAL,40,18,2026-05-02\n'+
                  'LP-02,SOUTH BENCH,RESTED,72,31,2026-05-03\n';
              }#
          ];
          asserts:
          [
            plots:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Plot":"LP-01","Range":"NORTH RIDGE","Band":"ROTATIONAL","Cover":40},{"Plot":"LP-02","Range":"SOUTH BENCH","Band":"RESTED","Cover":72}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
