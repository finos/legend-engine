        ^TestResultRow(values = ['Alice', 'Science', 90, 'Charlie']),
        ^TestResultRow(values = ['Bob', 'Science', 88, 'Charlie']),
        ^TestResultRow(values = ['Charlie', 'Science', 85, 'Charlie']),
        ^TestResultRow(values = ['Frank', 'Arts', 84, 'Hannah']),
        ^TestResultRow(values = ['Greece', 'Arts', 83, 'Hannah']),
        ^TestResultRow(values = ['Hannah', 'Arts', 80, 'Hannah'])
      ]
    )    
  )
}

function meta::external::store::relational::sdt::framework::testConfigForWindowProcessor(identifier: String[1], window: meta::external::query::sql::metamodel::Window[1], expected: TestResult[1]): SqlDialectTest[1]
{
  ^SqlDialectTest(
    identifier = $identifier,
    setupStatements = [
      ^DropTestTable(tableName = 'testTable', isTempTable = true),
      ^CreateTestTable(tableName = 'testTable', columns = [pair('student', ^ColumnType(name = 'varchar')), pair('dept', ^ColumnType(name = 'varchar')), pair('score', ^ColumnType(name = 'integer'))], isTempTable = true),
      ^InsertIntoTestTable(tableName = 'testTable', columns = ['student', 'dept', 'score'], values = [
        list([literal('Alice'), literal('Science'), literal(90)]), 
        list([literal('Bob'), literal('Science'), literal(88)]), 
        list([literal('Charlie'), literal('Science'), literal(85)]), 
        list([literal('Frank'), literal('Arts'), literal(84)]),
        list([literal('Greece'), literal('Arts'), literal(83)]),
        list([literal('Hannah'), literal('Arts'), literal(80)])
    ])],
    teardownStatements = [
      ^DropTestTable(tableName = 'testTable', isTempTable = true)
    ],
    testQuery = ^Query(
      queryBody = ^QuerySpecification(
      select = ^Select(
        distinct = false,
        selectItems = [
        ^SingleColumn(expression = ^QualifiedNameReference(name = ^QualifiedName(parts = ['testTable', 'student']))),
        ^SingleColumn(expression = ^QualifiedNameReference(name = ^QualifiedName(parts = ['testTable', 'dept']))),
        ^SingleColumn(expression = ^QualifiedNameReference(name = ^QualifiedName(parts = ['testTable', 'score']))),
        ^SingleColumn(
          expression = ^FunctionCall(
            name = ^QualifiedName(parts = 'last_value'), 
            arguments = [^QualifiedNameReference(name = ^QualifiedName(parts = 'student'))],
            window = $window
          ),
          alias = 'result'
        )
      ]),
      from = ^Table(name = ^QualifiedName(parts = 'testTable')),
      orderBy = ^SortItem(
          sortKey = ^QualifiedNameReference(name = ^QualifiedName(parts = 'student')),
          ordering = SortItemOrdering.ASCENDING, 
          nullOrdering = SortItemNullOrdering.LAST
        )
      )
    ),
    expectedResult = $expected
  );
}

// LISTAGG/STRING_AGG WITHIN GROUP (ORDER BY id <nullOrdering>) over a table with one null id, so an
// explicit null ordering on the aggregate's own orderBy (FunctionCall.orderBy, as opposed to a plain
// sort or window sortBy) is actually observable in the concatenated result.
function meta::external::store::relational::sdt::framework::testConfigForOrderedAggregate(identifier: String[1], nullOrdering: SortItemNullOrdering[1], expected: TestResult[1]): SqlDialectTest[1]
{
  ^SqlDialectTest(
    identifier = $identifier,
    setupStatements = [
      ^DropTestTable(tableName = 'testTable', isTempTable = true),
      ^CreateTestTable(tableName = 'testTable', columns = [pair('id', ^ColumnType(name = 'integer')), pair('name', ^ColumnType(name = 'varchar'))], isTempTable = true),
      ^InsertIntoTestTable(tableName = 'testTable', columns = ['id', 'name'], values = [
        list([literal(1), literal('B')]),
        list([^NullLiteral(), literal('D')]),
        list([literal(2), literal('A')]),
        list([literal(3), literal('C')])
      ])
    ],
    teardownStatements = [
      ^DropTestTable(tableName = 'testTable', isTempTable = true)
    ],
    testQuery = ^Query(
      queryBody = ^QuerySpecification(
        select = ^Select(
          distinct = false,
          selectItems = ^SingleColumn(
            expression = ^FunctionCall(
              name = ^QualifiedName(parts = 'string_agg'),
              arguments = [^QualifiedNameReference(name = ^QualifiedName(parts = 'name')), ^StringLiteral(value = ',')],
              orderBy = [
                ^SortItem(
                  sortKey = ^QualifiedNameReference(name = ^QualifiedName(parts = 'id')),
                  ordering = SortItemOrdering.ASCENDING,
                  nullOrdering = $nullOrdering
                )
              ]
            ),
            alias = 'result'
          )
        ),
        from = ^Table(name = ^QualifiedName(parts = 'testTable'))
      )
    ),
    expectedResult = $expected
  );
}

// Same partitioned-by-dept, dense_rank() shape as testConfigForWindowProcessor, but with a null score
// in each partition (Bob/Frank) so an explicit window-level null ordering is actually observable --
// exercises the window-sortBy null-order clause (see convertWindowColumn / NullOrder in the relational
// metamodel) rather than just the top-level ORDER BY covered by testConfigForNulls.
function meta::external::store::relational::sdt::framework::testConfigForWindowProcessorWithNulls(identifier: String[1], nullOrdering: SortItemNullOrdering[1], expected: TestResult[1]): SqlDialectTest[1]
{
  ^SqlDialectTest(
    identifier = $identifier,
    setupStatements = [
      ^DropTestTable(tableName = 'testTable', isTempTable = true),
      ^CreateTestTable(tableName = 'testTable', columns = [pair('student', ^ColumnType(name = 'varchar')), pair('dept', ^ColumnType(name = 'varchar')), pair('score', ^ColumnType(name = 'integer'))], isTempTable = true),
      ^InsertIntoTestTable(tableName = 'testTable', columns = ['student', 'dept', 'score'], values = [
        list([literal('Alice'), literal('Science'), literal(90)]),
        list([literal('Bob'), literal('Science'), ^NullLiteral()]),
        list([literal('Charlie'), literal('Science'), literal(85)]),
        list([literal('Frank'), literal('Arts'), ^NullLiteral()]),
        list([literal('Greece'), literal('Arts'), literal(83)]),
        list([literal('Hannah'), literal('Arts'), literal(80)])
    ])],
    teardownStatements = [
      ^DropTestTable(tableName = 'testTable', isTempTable = true)
    ],
    testQuery = ^Query(
      queryBody = ^QuerySpecification(
      select = ^Select(
        distinct = false,
        selectItems = [
        ^SingleColumn(expression = ^QualifiedNameReference(name = ^QualifiedName(parts = ['testTable', 'student']))),
        ^SingleColumn(expression = ^QualifiedNameReference(name = ^QualifiedName(parts = ['testTable', 'dept']))),
        ^SingleColumn(expression = ^QualifiedNameReference(name = ^QualifiedName(parts = ['testTable', 'score']))),
        ^SingleColumn(
          expression = ^FunctionCall(
            name = ^QualifiedName(parts = 'dense_rank'),
            arguments = [],
            window = ^meta::external::query::sql::metamodel::Window(
              orderBy = [
                ^SortItem(
                  sortKey = ^QualifiedNameReference(name = ^QualifiedName(parts = 'score')),
                  ordering = SortItemOrdering.DESCENDING,
                  nullOrdering = $nullOrdering
                )
              ],
              partitions = [^QualifiedNameReference(name = ^QualifiedName(parts = 'dept'))]
            )
          ),
          alias = 'result'
        )
      ]),
      from = ^Table(name = ^QualifiedName(parts = 'testTable')),
      orderBy = ^SortItem(
          sortKey = ^QualifiedNameReference(name = ^QualifiedName(parts = 'student')),
          ordering = SortItemOrdering.ASCENDING,
          nullOrdering = SortItemNullOrdering.LAST
        )
      )
    ),
    expectedResult = $expected
  );
}
