          )
      ],
      partitions = [^QualifiedNameReference(name = ^QualifiedName(parts = 'dept'))],
      windowFrame = ^WindowFrame(mode = WindowFrameMode.ROWS, start = ^FrameBound(type = FrameBoundType.UNBOUNDED_PRECEDING), end = ^FrameBound(type = FrameBoundType.UNBOUNDED_FOLLOWING))
    ),
    ^TestResult(
      columnNames = ['student', 'dept', 'score', 'result'],
      rows = [
        ^TestResultRow(values = ['Alice', 'Science', 90, 'Charlie']),
        ^TestResultRow(values = ['Bob', 'Science', 88, 'Charlie']),
        ^TestResultRow(values = ['Charlie', 'Science', 85, 'Charlie']),
        ^TestResultRow(values = ['Frank', 'Arts', 84, 'Hannah']),
        ^TestResultRow(values = ['Greece', 'Arts', 83, 'Hannah']),
        ^TestResultRow(values = ['Hannah', 'Arts', 80, 'Hannah'])
      ]
    )    
  )
} 

// SELECT testTable.student, testTable.dept, testTable.score, dense_rank() OVER (PARTITION BY dept ORDER BY score DESC NULLS FIRST) AS result FROM testTable ORDER BY student ASC NULLS LAST
function <<SDT.test>> meta::external::store::relational::sdt::suite::windowColumn::testWindowSortByWithNullsFirst(): SqlDialectTest[1]
{
  testConfigForWindowProcessorWithNulls(
    'SQLStructureTests - WindowSortByWithNullsFirst',
    SortItemNullOrdering.FIRST,
    ^TestResult(
      columnNames = ['student', 'dept', 'score', 'result'],
      rows = [
        ^TestResultRow(values = ['Alice', 'Science', 90, 2]),
        ^TestResultRow(values = ['Bob', 'Science', null(), 1]),
        ^TestResultRow(values = ['Charlie', 'Science', 85, 3]),
        ^TestResultRow(values = ['Frank', 'Arts', null(), 1]),
        ^TestResultRow(values = ['Greece', 'Arts', 83, 2]),
        ^TestResultRow(values = ['Hannah', 'Arts', 80, 3])
      ]
    )
  )
}

// SELECT testTable.student, testTable.dept, testTable.score, dense_rank() OVER (PARTITION BY dept ORDER BY score DESC NULLS LAST) AS result FROM testTable ORDER BY student ASC NULLS LAST
function <<SDT.test>> meta::external::store::relational::sdt::suite::windowColumn::testWindowSortByWithNullsLast(): SqlDialectTest[1]
{
  testConfigForWindowProcessorWithNulls(
    'SQLStructureTests - WindowSortByWithNullsLast',
    SortItemNullOrdering.LAST,
    ^TestResult(
      columnNames = ['student', 'dept', 'score', 'result'],
      rows = [
        ^TestResultRow(values = ['Alice', 'Science', 90, 1]),
        ^TestResultRow(values = ['Bob', 'Science', null(), 3]),
        ^TestResultRow(values = ['Charlie', 'Science', 85, 2]),
        ^TestResultRow(values = ['Frank', 'Arts', null(), 3]),
        ^TestResultRow(values = ['Greece', 'Arts', 83, 1]),
        ^TestResultRow(values = ['Hannah', 'Arts', 80, 2])
      ]
    )
  )
}

// SELECT testTable.student, testTable.dept, testTable.score, dense_rank() OVER (PARTITION BY dept ORDER BY score DESC) AS result FROM testTable ORDER BY student ASC NULLS LAST
//
// No explicit null ordering on the window sort. Nulls must still rank as the largest value, which on
// a descending sort means first -- so the null-score rows (Bob, Frank) take rank 1 on every dialect,
// matching the NULLS FIRST case above.
function <<SDT.test>> meta::external::store::relational::sdt::suite::windowColumn::testWindowSortByWithDefaultNullOrdering(): SqlDialectTest[1]
{
  testConfigForWindowProcessorWithNulls(
    'SQLStructureTests - WindowSortByWithDefaultNullOrdering',
    SortItemNullOrdering.UNDEFINED,
    ^TestResult(
      columnNames = ['student', 'dept', 'score', 'result'],
      rows = [
        ^TestResultRow(values = ['Alice', 'Science', 90, 2]),
        ^TestResultRow(values = ['Bob', 'Science', null(), 1]),
        ^TestResultRow(values = ['Charlie', 'Science', 85, 3]),
        ^TestResultRow(values = ['Frank', 'Arts', null(), 1]),
        ^TestResultRow(values = ['Greece', 'Arts', 83, 2]),
        ^TestResultRow(values = ['Hannah', 'Arts', 80, 3])
      ]
    )
  )
}

