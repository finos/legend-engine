###Relational
Database meta::relational::tests::sqlOptimizer::duckDbRefusals::RefusalDb
(
  Schema SQLOPT
  (
    Table DDR_L (ID INT, K INT, BK BIGINT, S VARCHAR(10), F DOUBLE, D DECIMAL(10,2), G VARCHAR(10), V INT)
    Table DDR_R (ID INT PRIMARY KEY, NAME VARCHAR(10), S VARCHAR(20), F DOUBLE, D DECIMAL(10,2), D4 DECIMAL(12,4))
    Table DDR_LC (ID INT, C CHAR(5))
    Table DDR_RC (ID INT PRIMARY KEY, NAME VARCHAR(10), S VARCHAR(20), C CHAR(5))
    Table DDR_R2 (ID INT PRIMARY KEY, NAME VARCHAR(10))
    Table DDR_RK (A INT PRIMARY KEY, B INT PRIMARY KEY, NAME VARCHAR(10))
    Table DDR_RN (ID INT, NAME VARCHAR(10))
    Table DDR_RF (F DOUBLE PRIMARY KEY, NAME VARCHAR(10))
    Table DDR_RM
    (
      milestoning(
        business(BUS_FROM=FROM_Z, BUS_THRU=THRU_Z, INFINITY_DATE=%9999-12-31T00:00:00.0000)
      )
      ID INT PRIMARY KEY,
      NAME VARCHAR(10),
      FROM_Z DATE,
      THRU_Z DATE
    )
  )
)

