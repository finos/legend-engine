import meta::core::runtime::*;
import meta::pure::functions::collection::*;
import meta::pure::mapping::*;
import meta::relational::mapping::*;
import meta::relational::metamodel::*;
import meta::relational::runtime::*;
import meta::relational::metamodel::join::*;
import meta::relational::metamodel::relation::*;
import meta::relational::sqlOptimizer::*;
import meta::relational::sqlOptimizer::rules::*;
import meta::relational::sqlOptimizer::tree::*;

// Only marks a connection: it enables the ExtractSubQueriesAsCTEs optimizer rule, which runs after every other rule.
Class meta::relational::sqlOptimizer::rules::ExtractSubQueriesAsCTEsPostProcessor extends meta::pure::alloy::connections::PostProcessor {}

function meta::relational::sqlOptimizer::rules::requestsCTEExtraction(connection: meta::external::store::relational::runtime::DatabaseConnection[0..1]): Boolean[1]
{
  $connection->match([
    r: meta::external::store::relational::runtime::RelationalDatabaseConnection[1] | $r.postProcessors->exists(p | $p->instanceOf(ExtractSubQueriesAsCTEsPostProcessor)),
    a: Any[*] | false
  ])
}

function meta::relational::sqlOptimizer::rules::extractSubQueriesAsCTEsRule(): meta::relational::sqlOptimizer::SqlOptimizationRule[1]
{
  ^meta::relational::sqlOptimizer::SqlOptimizationRule(
    name = 'ExtractSubQueriesAsCTEs',
    featureName = 'EXTRACT_SUB_QUERIES_AS_CTES',
    enabledByDefault = false,
    enabledByAll = false,
    runsOnceAfterFixedPoint = true,
    databaseSupport = ^meta::external::store::relational::sqlPlanning::ruleBasedTransformation::AllDatabaseSupport(),
    transform = {query: SelectSQLQuery[1], ctx: meta::relational::sqlOptimizer::SqlOptimizerContext[1] |
      let extracted = $query->extractSubqueriesAsCTEs();
      meta::relational::sqlOptimizer::changedIf($extracted, $extracted.commonTableExpressions->size() > $query.commonTableExpressions->size());
    }
  )
}

function meta::relational::sqlOptimizer::rules::extractSubQueriesAsCTEsSqlQueryPostProcessor(select: SelectSQLQuery[1]): meta::pure::mapping::Result<SelectSQLQuery|1>[1]
{
   ^meta::pure::mapping::Result<SelectSQLQuery|1>(values = $select->extractSubqueriesAsCTEs())
}

function meta::relational::sqlOptimizer::rules::extractSubqueriesAsCTEs(select: SelectSQLQuery[1]): SelectSQLQuery[1]
{
   let levelCountMap = $select->countSubqueriesAtDifferentLevels(1, ^Map<Integer, Integer>());
   let subQueryTotalCount = $levelCountMap->keyValues().second->sum();

   if ($subQueryTotalCount == 0,
       | $select,
       | let cteResultHolder = ^CTEExtractionResultHolder(currentSelect = $select, levelIndexMap = $levelCountMap->keyValues()->map(p | pair($p.first, 0))->newMap());
         let processedResult = $cteResultHolder->extractSubqueriesAsCTEsRecursively(1);
         let transformedSelect = $processedResult.currentSelect;
         ^$transformedSelect(commonTableExpressions += $processedResult.extractedCTEs);
   );
}

function <<access.private>> meta::relational::sqlOptimizer::rules::countSubqueriesAtDifferentLevels(select: SelectSQLQuery[1], level: Integer[1], levelCountMap: Map<Integer, Integer>[1]): Map<Integer, Integer>[1]
{
   if ($select.data->isNotEmpty(),
       | let subSelects = $select->extractableSubSelectNodes().alias.relationalElement->cast(@SelectSQLQuery);
         let updatedLevelCountMap = $levelCountMap->put($level, $levelCountMap->get($level)->defaultIfEmpty(0)->toOne() + $subSelects->size());
         $subSelects->fold({sub, agg | $sub->countSubqueriesAtDifferentLevels($level + 1, $agg)}, $updatedLevelCountMap);,
       | $levelCountMap
   )
}

Class <<access.private>> meta::relational::sqlOptimizer::rules::CTEExtractionResultHolder
{
   currentSelect: SelectSQLQuery[1];
   levelIndexMap: Map<Integer, Integer>[1];
   extractedCTEs: CommonTableExpression[*];
}

function <<access.private>> meta::relational::sqlOptimizer::rules::extractSubqueriesAsCTEsRecursively(input: CTEExtractionResultHolder[1], level: Integer[1]): CTEExtractionResultHolder[1]
{
   let select = $input.currentSelect;
   if ($select.data->isNotEmpty(),
       | let subSelectNodes = $select->extractableSubSelectNodes();
         $subSelectNodes->fold({node, agg |
            let currentSelect = $agg.currentSelect;
            let nodeAlias = $node.alias;
            let cteName = 'subquery_cte_' + toString($level) + '_' + toString($agg.levelIndexMap->get($level)->toOne() + 1);
            let processedCteResult  = ^$agg(currentSelect = $nodeAlias.relationalElement->cast(@SelectSQLQuery))->extractSubqueriesAsCTEsRecursively($level + 1);
            let cte = ^CommonTableExpression(name = $cteName, sqlQuery = $processedCteResult.currentSelect);
            let cteReference = ^CommonTableExpressionReference(name = $cteName);
            ^$agg
            (
               currentSelect = ^$currentSelect(data = $currentSelect.data->toOne()->replaceTreeNode($node->meta::relational::functions::pureToSqlQuery::findOneNode($select.data->toOne(), $currentSelect.data->toOne()), ^$node(alias = ^$nodeAlias(relationalElement = $cteReference)))->cast(@RootJoinTreeNode)),
               extractedCTEs = $processedCteResult.extractedCTEs->concatenate($cte),
               levelIndexMap = $processedCteResult.levelIndexMap->put($level, $processedCteResult.levelIndexMap->get($level)->toOne() + 1)  
            );
         }, $input);,
       | $input
   );
}

// A lateral subselect reads the row it is joined to, so it cannot be defined once, up front, as a CTE.
function <<access.private>> meta::relational::sqlOptimizer::rules::extractableSubSelectNodes(select: SelectSQLQuery[1]): RelationalTreeNode[*]
{
   $select.data->toOne()->allNodes()->filter(n | $n.alias.relationalElement->instanceOf(SelectSQLQuery) && !$n->match([j: JoinTreeNode[1] | $j.lateral == true, a: Any[1] | false]))
}
