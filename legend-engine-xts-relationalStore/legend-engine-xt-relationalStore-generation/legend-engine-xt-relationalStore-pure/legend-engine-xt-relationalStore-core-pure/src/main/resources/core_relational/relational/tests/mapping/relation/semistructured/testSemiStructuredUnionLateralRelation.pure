}

function <<access.private>> meta::relational::tests::mapping::relation::semistructured::unionlateral::lateral::lateralExecute(
  conn: Connection[1],
  func: FunctionDefinition<Any>[1],
  expected: String[1]
):Boolean[1]
{
  executeLegendFunction(
    $func,
    meta::relational::tests::mapping::relation::semistructured::unionlateral::lateral::LateralSemiStructuredMapping,
    meta::relational::tests::mapping::relation::semistructured::unionlateral::lateral::H2DB,
    $conn,
    [meta::relational::tests::mapping::relation::semistructured::unionlateral::lateral::orderCsvA(),
     meta::relational::tests::mapping::relation::semistructured::unionlateral::lateral::orderCsvB(),
     meta::relational::tests::mapping::relation::semistructured::unionlateral::lateral::fulfillmentCsvA(),
     meta::relational::tests::mapping::relation::semistructured::unionlateral::lateral::fulfillmentCsvB()],
    $expected,
    false
  );
}

function <<paramTest.Test>> meta::relational::tests::mapping::relation::semistructured::unionlateral::lateral::testSemiStructuredUnionFlattenWithAssociation(conn: Connection[1]):Boolean[1]
{
  meta::relational::tests::mapping::relation::semistructured::unionlateral::lateral::lateralExecute(
      $conn,
      |meta::relational::tests::mapping::relation::semistructured::unionlateral::lateral::Order.all()
        ->filter(x|$x.orderId != '')
        ->project(~[
          'Order Id'           : x|$x.orderId,
          'Order Status'       : x|$x.orderStatus,
          'Order Version'      : x|$x.fulfillment.orderVersion,
          'Fulfillment Version': x|$x.fulfillment.fulfillmentVersion,
          'Item Categories'    : x|$x.fulfillment.itemCategories
        ]),
      'Order Id,Order Status,Order Version,Fulfillment Version,Item Categories\n' +
      '1,Open,10,1,Electronics\n' +
      '1,Open,10,1,Books\n' +
      '2,Closed,20,1,Clothing\n' +
      '3,Open,30,1,Food\n' +
      '3,Open,30,1,Toys\n'
    );
}
