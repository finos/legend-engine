import meta::relational::tests::semistructured::modelChainTypeName::*;
import meta::pure::test::*;
import meta::core::runtime::*;

function meta::relational::tests::semistructured::modelChainTypeName::modelChainTypeNameCsv(): String[1]
{
  'FIRM_SCHEMA\n' +
  'FIRM_TABLE\n' +
  'ID,FIRM_DETAILS\n' +
  '1,"{""terms"": [{""@type"": ""RepoTerms"", ""termId"": ""T1""}, {""@type"": ""Terms"", ""termId"": ""T2""}]}"\n' +
  '2,"{""terms"": [{""@type"": ""Terms"", ""termId"": ""T3""}]}"\n'
}

function <<paramTest.Test>> meta::relational::tests::semistructured::modelChainTypeName::testModelChainTypeNameWhenMappingLambdaParameterSharesQueryLambdaParameterName(conn: Connection[1]):Boolean[1]
{
  meta::relational::metamodel::execute::tests::executeLegendFunctionWithModelChain(
    $conn,
    modelChainTypeNameCsv(),
    '/core_relational/relational/tests/semistructured/model/semiStructuredModelChainTypeName.legend',
    'chainTypeName::firmTermTypesTds__TabularDataSet_1_',
    'chainTypeName::mapping::M2M',
    'chainTypeName::mapping::Relational',
    'chainTypeName::store::DB',
    'Id,Term Type\n' +
    '1,RepoTerms\n' +
    '1,Terms\n' +
    '2,Terms\n'
  );
}

function <<paramTest.Test>> meta::relational::tests::semistructured::modelChainTypeName::testModelChainTypeNameWhenMappingLambdaParameterSharesQueryLambdaParameterNameInColForm(conn: Connection[1]):Boolean[1]
{
  meta::relational::metamodel::execute::tests::executeLegendFunctionWithModelChain(
    $conn,
    modelChainTypeNameCsv(),
    '/core_relational/relational/tests/semistructured/model/semiStructuredModelChainTypeName.legend',
    'chainTypeName::firmTermTypesColTds__TabularDataSet_1_',
    'chainTypeName::mapping::M2M',
    'chainTypeName::mapping::Relational',
    'chainTypeName::store::DB',
    'Id,Term Type\n' +
    '1,RepoTerms\n' +
    '1,Terms\n' +
    '2,Terms\n'
  );
}
