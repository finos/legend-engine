###Pure
import meta::pure::graphFetch::*;
import meta::pure::graphFetch::execution::*;
import meta::relational::metamodel::execute::*;
import meta::relational::tests::mapping::relation::graphFetch::unionSubType::*;

function <<test.BeforePackage>> meta::relational::tests::mapping::relation::graphFetch::unionSubType::setUp():Boolean[1]
{
  setUpTables();
}

function meta::relational::tests::mapping::relation::graphFetch::unionSubType::setUpTables():Boolean[1]
{
  let connection = usRuntime().connectionByElement(UsDB)->cast(@meta::external::store::relational::runtime::TestDatabaseConnection);

  executeInDb('Drop table if exists RFGF_US_WORKER;', $connection);
  executeInDb('Create Table RFGF_US_WORKER(ID INT, NAME VARCHAR(100), KIND VARCHAR(10), DEPTID INT, SALARY INT, AGENCY VARCHAR(100));', $connection);
  executeInDb('insert into RFGF_US_WORKER values (1, \'Ann\', \'E\', 1, 100, null);', $connection);
  executeInDb('insert into RFGF_US_WORKER values (2, \'Ben\', \'C\', 1, null, \'Acme\');', $connection);
  executeInDb('insert into RFGF_US_WORKER values (3, \'Cat\', \'E\', 2, 200, null);', $connection);
  executeInDb('insert into RFGF_US_WORKER values (4, \'Dov\', \'C\', 2, null, \'Bolt\');', $connection);
  executeInDb('insert into RFGF_US_WORKER values (5, \'Eve\', \'E\', 1, 300, null);', $connection);

  executeInDb('Drop table if exists RFGF_US_DEPT;', $connection);
  executeInDb('Create Table RFGF_US_DEPT(ID INT, NAME VARCHAR(100));', $connection);
  executeInDb('insert into RFGF_US_DEPT values (1, \'Sales\');', $connection);
  executeInDb('insert into RFGF_US_DEPT values (2, \'Ops\');', $connection);
  executeInDb('insert into RFGF_US_DEPT values (3, \'Legal\');', $connection);

  executeInDb('Drop table if exists RFGF_US_LAPTOP;', $connection);
  executeInDb('Create Table RFGF_US_LAPTOP(ID INT, MODEL VARCHAR(100), OWNERID INT);', $connection);
  executeInDb('insert into RFGF_US_LAPTOP values (1, \'L-100\', 1);', $connection);
  executeInDb('insert into RFGF_US_LAPTOP values (2, \'L-200\', 3);', $connection);

  executeInDb('Drop table if exists RFGF_US_TRADE1;', $connection);
  executeInDb('Create Table RFGF_US_TRADE1(ID INT, QTY INT, INSTRID INT, BOOKID INT, TRADER VARCHAR(100));', $connection);
  executeInDb('insert into RFGF_US_TRADE1 values (1, 100, 30, 1, \'abc\');', $connection);
  executeInDb('insert into RFGF_US_TRADE1 values (2, 200, 31, 2, \'abc\');', $connection);

  executeInDb('Drop table if exists RFGF_US_TRADE2;', $connection);
  executeInDb('Create Table RFGF_US_TRADE2(ID INT, QTY INT, INSTRID INT, BOOKID INT, TRADER VARCHAR(100));', $connection);
  executeInDb('insert into RFGF_US_TRADE2 values (3, 300, 30, 1, \'xyz\');', $connection);
  executeInDb('insert into RFGF_US_TRADE2 values (4, 400, 40, 2, \'xyz\');', $connection);

  executeInDb('Drop table if exists RFGF_US_TRADE3;', $connection);
  executeInDb('Create Table RFGF_US_TRADE3(ID INT, QTY INT, INSTRID INT, BOOKID INT, TRADER VARCHAR(100));', $connection);
  executeInDb('insert into RFGF_US_TRADE3 values (5, 500, 40, 1, \'pqr\');', $connection);

  executeInDb('Drop table if exists RFGF_US_INSTR1;', $connection);
  executeInDb('Create Table RFGF_US_INSTR1(ID INT, NAME VARCHAR(100));', $connection);
  executeInDb('insert into RFGF_US_INSTR1 values (30, \'Instr_30\');', $connection);
  executeInDb('insert into RFGF_US_INSTR1 values (31, \'Instr_31\');', $connection);

  executeInDb('Drop table if exists RFGF_US_INSTR2;', $connection);
  executeInDb('Create Table RFGF_US_INSTR2(ID INT, NAME VARCHAR(100));', $connection);
  executeInDb('insert into RFGF_US_INSTR2 values (40, \'Instr_40\');', $connection);

  executeInDb('Drop table if exists RFGF_US_BOOK1;', $connection);
  executeInDb('Create Table RFGF_US_BOOK1(ID INT, NAME VARCHAR(100));', $connection);
  executeInDb('insert into RFGF_US_BOOK1 values (1, \'Book A\');', $connection);
  executeInDb('insert into RFGF_US_BOOK1 values (3, \'Book C\');', $connection);

  executeInDb('Drop table if exists RFGF_US_BOOK2;', $connection);
  executeInDb('Create Table RFGF_US_BOOK2(ID INT, NAME VARCHAR(100));', $connection);
  executeInDb('insert into RFGF_US_BOOK2 values (2, \'Book B\');', $connection);

  executeInDb('Drop table if exists RFGF_US_ORDER;', $connection);
  executeInDb('Create Table RFGF_US_ORDER(ID INT, PRODID INT);', $connection);
  executeInDb('insert into RFGF_US_ORDER values (1, 1);', $connection);
  executeInDb('insert into RFGF_US_ORDER values (2, 2);', $connection);
  executeInDb('insert into RFGF_US_ORDER values (3, 3);', $connection);
  executeInDb('insert into RFGF_US_ORDER values (4, 9);', $connection);

  executeInDb('Drop table if exists RFGF_US_ORDER_U;', $connection);
  executeInDb('Create Table RFGF_US_ORDER_U(ID INT, PRODID INT);', $connection);
  executeInDb('insert into RFGF_US_ORDER_U values (1, 1);', $connection);
  executeInDb('insert into RFGF_US_ORDER_U values (2, 5);', $connection);
  executeInDb('insert into RFGF_US_ORDER_U values (3, 6);', $connection);

  executeInDb('Drop table if exists RFGF_US_PRODUCT_BT;', $connection);
  executeInDb('Create Table RFGF_US_PRODUCT_BT(ID INT, NAME VARCHAR(100), TYPE VARCHAR(10), CLASSID INT, FROM_Z DATE, THRU_Z DATE);', $connection);
  executeInDb('insert into RFGF_US_PRODUCT_BT values (1, \'Prod1 v1\', \'STOCK\',  10, \'2015-01-01\', \'2016-01-01\');', $connection);
  executeInDb('insert into RFGF_US_PRODUCT_BT values (1, \'Prod1 v2\', \'STOCK\',  10, \'2016-01-01\', \'9999-12-31\');', $connection);
  executeInDb('insert into RFGF_US_PRODUCT_BT values (2, \'Prod2\',    \'OPTION\', 20, \'2015-06-01\', \'9999-12-31\');', $connection);
  executeInDb('insert into RFGF_US_PRODUCT_BT values (3, \'Prod3\',    \'STOCK\',  30, \'2017-01-01\', \'9999-12-31\');', $connection);
  executeInDb('insert into RFGF_US_PRODUCT_BT values (4, \'Prod4\',    \'BOND\',   10, \'2014-01-01\', \'2015-03-01\');', $connection);

  executeInDb('Drop table if exists RFGF_US_PRODUCT_BT2;', $connection);
  executeInDb('Create Table RFGF_US_PRODUCT_BT2(ID INT, NAME VARCHAR(100), TYPE VARCHAR(10), CLASSID INT, FROM_Z DATE, THRU_Z DATE);', $connection);
  executeInDb('insert into RFGF_US_PRODUCT_BT2 values (5, \'Prod5\',    \'STOCK\',  20, \'2015-01-01\', \'9999-12-31\');', $connection);
  executeInDb('insert into RFGF_US_PRODUCT_BT2 values (6, \'Prod6 v1\', \'OPTION\', 40, \'2015-01-01\', \'2017-01-01\');', $connection);
  executeInDb('insert into RFGF_US_PRODUCT_BT2 values (6, \'Prod6 v2\', \'OPTION\', 40, \'2017-01-01\', \'9999-12-31\');', $connection);

  executeInDb('Drop table if exists RFGF_US_CLASSIF_BT;', $connection);
  executeInDb('Create Table RFGF_US_CLASSIF_BT(ID INT, DESCRIPTION VARCHAR(100), FROM_Z DATE, THRU_Z DATE);', $connection);
  executeInDb('insert into RFGF_US_CLASSIF_BT values (10, \'Equity v1\',  \'2015-01-01\', \'2017-01-01\');', $connection);
  executeInDb('insert into RFGF_US_CLASSIF_BT values (10, \'Equity v2\',  \'2017-01-01\', \'9999-12-31\');', $connection);
  executeInDb('insert into RFGF_US_CLASSIF_BT values (20, \'Derivative\', \'2015-01-01\', \'9999-12-31\');', $connection);
  executeInDb('insert into RFGF_US_CLASSIF_BT values (30, \'Equity new\', \'2017-06-01\', \'9999-12-31\');', $connection);

  executeInDb('Drop table if exists RFGF_US_CLASSIF_BT2;', $connection);
  executeInDb('Create Table RFGF_US_CLASSIF_BT2(ID INT, DESCRIPTION VARCHAR(100), FROM_Z DATE, THRU_Z DATE);', $connection);
  executeInDb('insert into RFGF_US_CLASSIF_BT2 values (40, \'Commodity v1\', \'2015-01-01\', \'2017-03-01\');', $connection);
  executeInDb('insert into RFGF_US_CLASSIF_BT2 values (40, \'Commodity v2\', \'2017-03-01\', \'9999-12-31\');', $connection);

  executeInDb('Drop table if exists RFGF_US_PRODUCT_SNAP;', $connection);
  executeInDb('Create Table RFGF_US_PRODUCT_SNAP(ID INT, NAME VARCHAR(100), CLASSID INT, SNAPSHOTDATE DATE);', $connection);
  executeInDb('insert into RFGF_US_PRODUCT_SNAP values (1, \'SnapA old\', 10, \'2017-06-14\');', $connection);
  executeInDb('insert into RFGF_US_PRODUCT_SNAP values (1, \'SnapA\',     10, \'2017-06-15\');', $connection);
  executeInDb('insert into RFGF_US_PRODUCT_SNAP values (2, \'SnapB\',     20, \'2017-06-15\');', $connection);
  executeInDb('insert into RFGF_US_PRODUCT_SNAP values (3, \'SnapC\',     10, \'2017-06-14\');', $connection);

  executeInDb('Drop table if exists RFGF_US_CLASSIF_SNAP;', $connection);
  executeInDb('Create Table RFGF_US_CLASSIF_SNAP(ID INT, DESCRIPTION VARCHAR(100), SNAPSHOTDATE DATE);', $connection);
  executeInDb('insert into RFGF_US_CLASSIF_SNAP values (10, \'Equity old\', \'2017-06-14\');', $connection);
  executeInDb('insert into RFGF_US_CLASSIF_SNAP values (10, \'Equity\',     \'2017-06-15\');', $connection);
  executeInDb('insert into RFGF_US_CLASSIF_SNAP values (20, \'Bond\',       \'2017-06-15\');', $connection);
  true;
}

function meta::relational::tests::mapping::relation::graphFetch::unionSubType::usRuntime():meta::core::runtime::Runtime[1]
{
  meta::external::store::relational::tests::testRuntime(UsDB)
}

function meta::relational::tests::mapping::relation::graphFetch::unionSubType::workerTree(treeBody:String[1]):RootGraphFetchTree<Worker>[1]
{
  meta::legend::compileLegendValueSpecification('#{meta::relational::tests::mapping::relation::graphFetch::unionSubType::Worker {' + $treeBody + '}}#')->cast(@RootGraphFetchTree<Worker>)
}

function meta::relational::tests::mapping::relation::graphFetch::unionSubType::fetchWorkers(tree:RootGraphFetchTree<Worker>[1]):String[1]
{
  execute(
    |Worker.all()->graphFetch($tree)->serialize($tree),
    SubTypeUnionMapping,
    usRuntime(),
    meta::relational::extension::relationalExtensions()
  ).values->toOne()
}

function meta::relational::tests::mapping::relation::graphFetch::unionSubType::sortedByKey(json:String[1], key:String[1]):String[1]
{
  let array = $json->meta::json::parseJSON()->cast(@meta::json::JSONArray);
  ^meta::json::JSONArray(values = $array.values->sortBy(v | $v->cast(@meta::json::JSONObject)->meta::json::getValue($key)->cast(@meta::json::JSONNumber).value->toOne()->cast(@Integer)))->meta::json::toCompactJSONString();
}

function meta::relational::tests::mapping::relation::graphFetch::unionSubType::planString(query:FunctionDefinition<Any>[1], mapping:meta::pure::mapping::Mapping[1]):String[1]
{
  meta::pure::executionPlan::executionPlan($query, $mapping, usRuntime(), meta::relational::extension::relationalExtensions())
    ->meta::pure::executionPlan::toString::planToString(meta::relational::extension::relationalExtensions());
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::unionSubType::testRootSubTypeWithSimpleProperty():Boolean[1]
{
  assertJsonStringsEqual(
    '[{"id":1,"salary":100},{"id":3,"salary":200},{"id":5,"salary":300},{"id":2},{"id":4}]',
    fetchWorkers(workerTree('id, ->subType(@meta::relational::tests::mapping::relation::graphFetch::unionSubType::Employee) {salary}'))
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::unionSubType::testRootMultipleSubTypes():Boolean[1]
{
  assertJsonStringsEqual(
    '[{"id":1,"name":"Ann","salary":100},{"id":3,"name":"Cat","salary":200},{"id":5,"name":"Eve","salary":300},' +
    '{"id":2,"name":"Ben","agency":"Acme"},{"id":4,"name":"Dov","agency":"Bolt"}]',
    fetchWorkers(workerTree(
      'id, name,' +
      '->subType(@meta::relational::tests::mapping::relation::graphFetch::unionSubType::Employee) {salary},' +
      '->subType(@meta::relational::tests::mapping::relation::graphFetch::unionSubType::Contractor) {agency}'
    ))
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::unionSubType::testRootCommonPropertyAlongsideSubTypeTrees():Boolean[1]
{
  assertJsonStringsEqual(
    '[{"kind":"E","name":"Ann"},{"kind":"E","name":"Cat"},{"kind":"E","name":"Eve"},{"kind":"C","name":"Ben"},{"kind":"C","name":"Dov"}]',
    fetchWorkers(workerTree(
      'kind,' +
      '->subType(@meta::relational::tests::mapping::relation::graphFetch::unionSubType::Employee) {name},' +
      '->subType(@meta::relational::tests::mapping::relation::graphFetch::unionSubType::Contractor) {name}'
    ))
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::unionSubType::testRootSubTypeWithFilter():Boolean[1]
{
  let tree = workerTree(
    'id,' +
    '->subType(@meta::relational::tests::mapping::relation::graphFetch::unionSubType::Employee) {salary},' +
    '->subType(@meta::relational::tests::mapping::relation::graphFetch::unionSubType::Contractor) {agency}'
  );
  let result = execute(
    |Worker.all()->filter(w | $w.id->in([1, 4]))->graphFetch($tree)->serialize($tree),
    SubTypeUnionMapping,
    usRuntime(),
    meta::relational::extension::relationalExtensions()
  );

  assertJsonStringsEqual('[{"id":1,"salary":100},{"id":4,"agency":"Bolt"}]', $result.values);
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::unionSubType::testRootSubTypeWithComplexProperty():Boolean[1]
{
  assertJsonStringsEqual(
    '[{"id":1,"department":{"name":"Sales"},"salary":100,"laptop":{"model":"L-100"}},' +
    '{"id":3,"department":{"name":"Ops"},"salary":200,"laptop":{"model":"L-200"}},' +
    '{"id":5,"department":{"name":"Sales"},"salary":300,"laptop":null},' +
    '{"id":2,"department":{"name":"Sales"}},' +
    '{"id":4,"department":{"name":"Ops"}}]',
    fetchWorkers(workerTree(
      'id, department {name},' +
      '->subType(@meta::relational::tests::mapping::relation::graphFetch::unionSubType::Employee) {salary, laptop {model}}'
    ))
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::unionSubType::testRootSubTypeWithQualifiedProperty():Boolean[1]
{
  assertJsonStringsEqual(
    '[{"id":1,"laptopModel()":"L-100"},{"id":3,"laptopModel()":"L-200"},{"id":5,"laptopModel()":null},{"id":2},{"id":4}]',
    fetchWorkers(workerTree('id, ->subType(@meta::relational::tests::mapping::relation::graphFetch::unionSubType::Employee) {laptopModel}'))
  );
}

// ToFix, not relation-function specific: graphFetchChecked drops the base properties of root subtype trees (serialize.pure toPropertyTree);
// the Relational RootSubTypeWithSubtypeLevelPropertyUnionMappingChecked produces the same output.
function <<test.Test, test.AlloyOnly, test.ToFix>> meta::relational::tests::mapping::relation::graphFetch::unionSubType::testRootSubTypeChecked():Boolean[1]
{
  let tree = workerTree(
    'id,' +
    '->subType(@meta::relational::tests::mapping::relation::graphFetch::unionSubType::Employee) {salary},' +
    '->subType(@meta::relational::tests::mapping::relation::graphFetch::unionSubType::Contractor) {agency}'
  );
  let result = execute(
    |Worker.all()->graphFetchChecked($tree)->serialize($tree),
    SubTypeUnionMapping,
    usRuntime(),
    meta::relational::extension::relationalExtensions()
  );

  assertJsonStringsEqual(
    '[{"defects":[],"value":{"id":1,"salary":100}},{"defects":[],"value":{"id":3,"salary":200}},{"defects":[],"value":{"id":5,"salary":300}},' +
    '{"defects":[],"value":{"id":2,"agency":"Acme"}},{"defects":[],"value":{"id":4,"agency":"Bolt"}}]',
    $result.values
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::unionSubType::testUnionOfSubTypeSetsWithoutSubTypeTree():Boolean[1]
{
  let tree = #{
    Worker {
      id,
      name,
      department {
        name
      }
    }
  }#;
  let result = execute(
    |Worker.all()->graphFetch($tree)->serialize($tree),
    SubTypeUnionMapping,
    usRuntime(),
    meta::relational::extension::relationalExtensions()
  );

  assertJsonStringsEqual(
    '[{"id":1,"name":"Ann","department":{"name":"Sales"}},{"id":3,"name":"Cat","department":{"name":"Ops"}},{"id":5,"name":"Eve","department":{"name":"Sales"}},' +
    '{"id":2,"name":"Ben","department":{"name":"Sales"}},{"id":4,"name":"Dov","department":{"name":"Ops"}}]',
    $result.values
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::unionSubType::testPropertyLevelSubTypeOverUnionTarget():Boolean[1]
{
  let tree = #{
    Department {
      name,
      workers->subType(@Employee) {
        name,
        salary
      }
    }
  }#;
  let result = execute(
    |Department.all()->graphFetch($tree)->serialize($tree),
    SubTypeUnionMapping,
    usRuntime(),
    meta::relational::extension::relationalExtensions()
  );

  assertJsonStringsEqual(
    '[{"name":"Sales","workers":[{"name":"Ann","salary":100},{"name":"Eve","salary":300}]},' +
    '{"name":"Ops","workers":[{"name":"Cat","salary":200}]},' +
    '{"name":"Legal","workers":[]}]',
    $result.values
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::unionSubType::testPropertyLevelSubTypeWithComplexProperty():Boolean[1]
{
  let tree = #{
    Department {
      name,
      workers->subType(@Employee) {
        name,
        laptop {
          model
        }
      }
    }
  }#;
  let result = execute(
    |Department.all()->graphFetch($tree)->serialize($tree),
    SubTypeUnionMapping,
    usRuntime(),
    meta::relational::extension::relationalExtensions()
  );

  assertJsonStringsEqual(
    '[{"name":"Sales","workers":[{"name":"Ann","laptop":{"model":"L-100"}},{"name":"Eve","laptop":null}]},' +
    '{"name":"Ops","workers":[{"name":"Cat","laptop":{"model":"L-200"}}]},' +
    '{"name":"Legal","workers":[]}]',
    $result.values
  );
}

// ToFix, not relation-function specific: aliased subtype trees on one property generate the same serializer method name
// (serialize.pure names methods by property, not alias), whatever the store.
function <<test.Test, test.AlloyOnly, test.ToFix>> meta::relational::tests::mapping::relation::graphFetch::unionSubType::testPropertyLevelMultipleAliasedSubTypes():Boolean[1]
{
  let tree = #{
    Department {
      name,
      'employees': workers->subType(@Employee) {
        name,
        salary
      },
      'contractors': workers->subType(@Contractor) {
        name,
        agency
      }
    }
  }#;
  let result = execute(
    |Department.all()->graphFetch($tree)->serialize($tree),
    SubTypeUnionMapping,
    usRuntime(),
    meta::relational::extension::relationalExtensions()
  );

  assertJsonStringsEqual(
    '[{"name":"Sales","employees":[{"name":"Ann","salary":100},{"name":"Eve","salary":300}],"contractors":[{"name":"Ben","agency":"Acme"}]},' +
    '{"name":"Ops","employees":[{"name":"Cat","salary":200}],"contractors":[{"name":"Dov","agency":"Bolt"}]},' +
    '{"name":"Legal","employees":[],"contractors":[]}]',
    $result.values
  );
}


function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::unionSubType::testMilestonedRootQualifierUsesBusinessDate():Boolean[1]
{
  let tree = #{
    Product {
      name,
      classificationDescription
    }
  }#;
  let result = execute(
    |Product.all(%2016-06-01)->graphFetch($tree)->serialize($tree),
    MilestoningMapping,
    usRuntime(),
    meta::relational::extension::relationalExtensions()
  );

  assertJsonStringsEqual(
    '[{"name":"Prod1 v2","classificationDescription()":"Equity v1"},{"name":"Prod2","classificationDescription()":"Derivative"}]',
    $result.values
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::unionSubType::testMilestonedRootWithFilter():Boolean[1]
{
  let tree = #{
    Product {
      id,
      name
    }
  }#;
  let result = execute(
    |Product.all(%2017-06-15)->filter(p | $p.type == 'STOCK')->graphFetch($tree)->serialize($tree),
    MilestoningMapping,
    usRuntime(),
    meta::relational::extension::relationalExtensions()
  );

  assertJsonStringsEqual('[{"id":1,"name":"Prod1 v2"},{"id":3,"name":"Prod3"}]', $result.values);
}

// ToFix, not relation-function specific: %latest as a graph fetch property parameter has no Java type (LatestDate in conventions.pure);
// the Relational testMilestonedPropertyWithLatest is also ToFix.
function <<test.Test, test.AlloyOnly, test.ToFix>> meta::relational::tests::mapping::relation::graphFetch::unionSubType::testMilestonedPropertyWithLatestDate():Boolean[1]
{
  let tree = #{
    Order {
      id,
      product(%latest) {
        name
      }
    }
  }#;
  let result = execute(
    |Order.all()->graphFetch($tree)->serialize($tree),
    MilestoningMapping,
    usRuntime(),
    meta::relational::extension::relationalExtensions()
  );

  assertJsonStringsEqual(
    '[{"id":1,"product(%latest)":{"name":"Prod1 v2"}},{"id":2,"product(%latest)":{"name":"Prod2"}},{"id":3,"product(%latest)":{"name":"Prod3"}},{"id":4,"product(%latest)":null}]',
    $result.values
  );
}

