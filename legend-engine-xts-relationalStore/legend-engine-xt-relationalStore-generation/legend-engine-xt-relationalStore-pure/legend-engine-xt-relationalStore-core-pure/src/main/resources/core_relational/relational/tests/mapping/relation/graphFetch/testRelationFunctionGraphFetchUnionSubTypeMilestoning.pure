    {|
      let bd = %2017-06-15;
      Order.all()
        ->graphFetch(#{Order {id, product($bd) {name, businessDate, classification($bd) {description, businessDate}}}}#)
        ->serialize(#{Order {id, product($bd) {name, businessDate, classification($bd) {description, businessDate}}}}#);
    },
    MilestoningMapping,
    usRuntime(),
    meta::relational::extension::relationalExtensions()
  );

  assertJsonStringsEqual(
    '[{"id":1,"product($bd)":{"name":"Prod1 v2","businessDate":"2017-06-15","classification($bd)":{"description":"Equity v2","businessDate":"2017-06-15"}}},' +
    '{"id":2,"product($bd)":{"name":"Prod2","businessDate":"2017-06-15","classification($bd)":{"description":"Derivative","businessDate":"2017-06-15"}}},' +
    '{"id":3,"product($bd)":{"name":"Prod3","businessDate":"2017-06-15","classification($bd)":{"description":"Equity new","businessDate":"2017-06-15"}}},' +
    '{"id":4,"product($bd)":null}]',
    $result.values
  );
}

