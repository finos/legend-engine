function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::unionSubType::testRootUnionOfUnion():Boolean[1]
{
  let tree = #{
    Trade {
      tradeId,
      quantity,
      trader
    }
  }#;
  let result = execute(
    |Trade.all()->graphFetch($tree)->serialize($tree),
    NestedRootUnionMapping,
    usRuntime(),
    meta::relational::extension::relationalExtensions()
  );

  assertJsonStringsEqual(
    '[{"tradeId":1,"quantity":100,"trader":"abc"},{"tradeId":2,"quantity":200,"trader":"abc"},' +
    '{"tradeId":3,"quantity":300,"trader":"xyz"},{"tradeId":4,"quantity":400,"trader":"xyz"},' +
    '{"tradeId":5,"quantity":500,"trader":"pqr"}]',
    sortedByKey($result.values->toOne(), 'tradeId')
  );
}

function <<test.Test>> meta::relational::tests::mapping::relation::graphFetch::unionSubType::testRootUnionWithPropertyUnmappedInOneSetFails():Boolean[1]
{
  let tree = #{
    Trade {
      tradeId,
      trader
    }
  }#;

  assertError(
    | planString({|Trade.all()->graphFetch($tree)->serialize($tree)}, PartialRootUnionMapping),
    'Property "trader" is not mapped in the set: "us_trade2"'
  );
}

