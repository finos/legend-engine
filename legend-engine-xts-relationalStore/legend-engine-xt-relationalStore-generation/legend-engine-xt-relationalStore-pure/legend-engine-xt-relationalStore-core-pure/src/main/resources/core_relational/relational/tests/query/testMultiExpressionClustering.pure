import meta::pure::executionPlan::*;
import meta::pure::mapping::*;
import meta::pure::profiles::*;
import meta::relational::mapping::*;
import meta::relational::tests::model::simple::*;
import meta::relational::tests::*;
import meta::external::store::relational::tests::*;

//from(<lambda>, mapping, runtime) hands clustering an expression that carries the lambda on func
//rather than on parametersValues, so nothing can be derived from it directly. Routing records the
//store it resolved, and clustering keys off that. These two tests pin both sides of that decision:
//a relational body must reach the store as one node, and a platform-only body must not be sent
//there at all.

function <<test.Test>> meta::relational::tests::query::multiExpression::testRelationalMultiExpressionIsOneRelationalNode():Boolean[1]
{
  let fn = {| from({| let p = Person.all()->project([x | $x.firstName], ['firstName']);
                      $p->filter(r | $r.getString('firstName') == 'John'); },
                   simpleRelationalMapping,
                   meta::external::store::relational::tests::testRuntime()) };

  let plan = meta::pure::executionPlan::executionPlan($fn, meta::relational::extension::relationalExtensions(), noDebug());

  //the cast fails if the lets were materialised into separate nodes with the body left in memory
  let sql = $plan.rootExecutionNode
              ->cast(@RelationalTdsInstantiationExecutionNode).executionNodes
              ->cast(@SQLExecutionNode).sqlQuery->toOne();

  assert($sql->startsWith('with '), | 'expected a common table expression, got: ' + $sql);
}

function <<test.Test>> meta::relational::tests::query::multiExpression::testPlatformOnlyMultiExpressionStaysOnPlatform():Boolean[1]
{
  let fn = {| from({| let a = 1 + 1; $a + 2; },
                   simpleRelationalMapping,
                   meta::external::store::relational::tests::testRuntime()) };

  let plan = meta::pure::executionPlan::executionPlan($fn, meta::relational::extension::relationalExtensions(), noDebug());

  assert($plan.rootExecutionNode->instanceOf(PureExpressionPlatformExecutionNode),
         | 'arithmetic with no relational content must not be pushed to the store, got: '
             + $plan.rootExecutionNode->genericType().rawType->toOne()->meta::pure::functions::meta::elementToPath());
}
