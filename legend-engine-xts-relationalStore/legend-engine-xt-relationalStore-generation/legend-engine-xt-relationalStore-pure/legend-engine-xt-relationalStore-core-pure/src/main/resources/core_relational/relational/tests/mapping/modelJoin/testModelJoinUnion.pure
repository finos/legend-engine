// =============================================================================
// Union on both sides with a condition that navigates Person.address
// (employees.address.city == firm.city), for Relation, Relational and mixed unions.
// From Person the address join sits on the source side of the join line; from Firm it
// sits on the target side and materializes the target.
//
// Expected: Apple (NYC) employs Alice and Charlie, Google (London) employs Bob.
// =============================================================================
function <<access.private>> meta::relational::tests::mapping::modelJoin::union::navigatingConditionRuntime():meta::core::runtime::Runtime[1]
{
  let fullTimeCsv =
    'default\n' +
    'fullTimeTable\n' +
    'ID,FIRSTNAME,LASTNAME,FIRMID,AGE\n' +
    '1,Alice,Smith,1,30\n';
  let contractCsv =
    'default\n' +
    'contractTable\n' +
    'ID,FIRSTNAME,LASTNAME,FIRMID,AGE\n' +
    '2,Bob,Jones,2,25\n' +
    '3,Charlie,Brown,9,35\n';
  let firmCsv =
    'default\n' +
    'firmTable\n' +
    'ID,LEGALNAME,CODE,CITY,COUNTRY\n' +
    '1,Apple,,NYC,US\n';
  let firmBCsv =
    'default\n' +
    'firmTableB\n' +
    'ID,LEGALNAME,CODE,CITY,COUNTRY\n' +
    '2,Google,,London,UK\n';
  let addrACsv =
    'default\n' +
    'addressTableA\n' +
    'ID,PERSONID,CITY,COUNTRY\n' +
    '1,1,NYC,US\n' +
    '2,2,London,UK\n' +
    '3,3,NYC,US\n';

  let db = meta::relational::tests::mapping::modelJoin::union::store::Db;
  let runtime = meta::external::store::relational::tests::testRuntime($db);
  meta::relational::tests::mapping::modelJoin::setupTestData([$fullTimeCsv, $contractCsv, $firmCsv, $firmBCsv, $addrACsv], $db, $runtime);
  $runtime;
}

function <<access.private>> meta::relational::tests::mapping::modelJoin::union::assertSourceSideNavigation(mapping:Mapping[1]):Boolean[1]
{
  let result = execute(
    |Person.all()->project(~['First Name': x|$x.firstName, 'Legal Name': x|$x.firm.legalName]),
    $mapping,
    meta::relational::tests::mapping::modelJoin::union::navigatingConditionRuntime(),
    meta::relational::extension::relationalExtensions()
  );
  assertEquals(
    #TDS
       'First Name', 'Legal Name'
       Alice, Apple
       Bob, Google
       Charlie, Apple
    #->toString(),
    $result.values->at(0)->sort([~'First Name'->ascending()])->toString());
}

function <<access.private>> meta::relational::tests::mapping::modelJoin::union::assertTargetSideNavigation(mapping:Mapping[1]):Boolean[1]
{
  let result = execute(
    |Firm.all()->project(~['Legal Name': x|$x.legalName, 'Employee First Name': x|$x.employees.firstName]),
    $mapping,
    meta::relational::tests::mapping::modelJoin::union::navigatingConditionRuntime(),
    meta::relational::extension::relationalExtensions()
  );
  assertEquals(
    #TDS
       'Legal Name', 'Employee First Name'
       Apple, Alice
       Apple, Charlie
       Google, Bob
    #->toString(),
    $result.values->at(0)->sort([~'Legal Name'->ascending(), ~'Employee First Name'->ascending()])->toString());
}

// ToFix: each branch pair compiles its own copy of the Relation-mapped address subselect, so the union code cannot
// match the intermediate across join lines: "Match failure: TdsSelectSqlQuery" (reprocessJoinTreeNode).
function <<test.ToFix, test.AlloyOnly>> meta::relational::tests::mapping::modelJoin::union::testRelationUnionConditionWithSourceIntermediateJoin():Boolean[1]
{
  meta::relational::tests::mapping::modelJoin::union::assertSourceSideNavigation(meta::relational::tests::mapping::modelJoin::union::RelationUnionNavigatingConditionMapping);
}

// ToFix: the union rebuilds the target from its set implementations and drops the materialized target's address join,
// so the ON clause reads a column no branch exposes: "Column fulltimetable_0.CITY not found".
function <<test.ToFix, test.AlloyOnly>> meta::relational::tests::mapping::modelJoin::union::testRelationUnionConditionWithMaterializedTarget():Boolean[1]
{
  meta::relational::tests::mapping::modelJoin::union::assertTargetSideNavigation(meta::relational::tests::mapping::modelJoin::union::RelationUnionNavigatingConditionMapping);
}

