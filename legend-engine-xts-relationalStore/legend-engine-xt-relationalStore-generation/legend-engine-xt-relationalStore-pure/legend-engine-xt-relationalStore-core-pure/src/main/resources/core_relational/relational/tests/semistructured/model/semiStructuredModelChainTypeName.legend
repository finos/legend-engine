###Pure
Class chainTypeName::source::S_Row
{
  id: Integer[1];
  firm: chainTypeName::source::S_Firm[1];
}

Class chainTypeName::source::S_Firm
{
  terms: chainTypeName::source::S_Terms[*];
}

Class chainTypeName::source::S_Terms
{
  termId: String[1];
}

Class chainTypeName::source::S_RepoTerms extends chainTypeName::source::S_Terms
{
  repoRate: Float[0..1];
}

Class chainTypeName::model::Firm
{
  id: Integer[1];
  termTypes: String[*];
}


###Relational
Database chainTypeName::store::DB
(
  Schema FIRM_SCHEMA
  (
    Table FIRM_TABLE
    (
      ID INTEGER PRIMARY KEY,
      FIRM_DETAILS SEMISTRUCTURED
    )
  )
)


###ExternalFormat
Binding chainTypeName::store::FirmBinding
{
  contentType: 'application/json';
  modelIncludes: [
    chainTypeName::source::S_Firm,
    chainTypeName::source::S_Terms,
    chainTypeName::source::S_RepoTerms
  ];
}


###Mapping
Mapping chainTypeName::mapping::Relational
(
  chainTypeName::source::S_Row: Relational
  {
    ~primaryKey
    (
      [chainTypeName::store::DB]FIRM_SCHEMA.FIRM_TABLE.ID
    )
    ~mainTable [chainTypeName::store::DB]FIRM_SCHEMA.FIRM_TABLE
    id: [chainTypeName::store::DB]FIRM_SCHEMA.FIRM_TABLE.ID,
    firm: Binding chainTypeName::store::FirmBinding : [chainTypeName::store::DB]FIRM_SCHEMA.FIRM_TABLE.FIRM_DETAILS
  }
)

Mapping chainTypeName::mapping::M2M
(
  *chainTypeName::model::Firm: Pure
  {
    ~src chainTypeName::source::S_Row
    id: $src.id,
    termTypes: $src.firm.terms->map(x | $x->toOne()->typeName())
  }
)


###Pure
function chainTypeName::firmTermTypesTds(): TabularDataSet[1]
{
  chainTypeName::model::Firm.all()->project(
    [x | $x.id, x | $x.termTypes],
    ['Id', 'Term Type']
  )
}

function chainTypeName::firmTermTypesColTds(): TabularDataSet[1]
{
  chainTypeName::model::Firm.all()->project(
    [col(x | $x.id, 'Id'), col(x | $x.termTypes, 'Term Type')]
  );
}
