import meta::relational::tests::semistructured::supertype::*;
import meta::pure::test::*;
import meta::core::runtime::*;

function meta::relational::tests::semistructured::supertype::supertypeExecute(conn: Connection[1], func: String[1], expected: String[1]):Boolean[1]
{
  let csv =
        'ITEM_SCHEMA\n' +
        'ITEM_TABLE\n' +
        'ID,NAME,PARENT_ID\n' +
        '1,Root,\n' +
        '2,Child,1\n' +
        '3,Loner,\n';

  let model = '/core_relational/relational/tests/semistructured/model/semiStructuredSupertypeParameter.legend';

  meta::relational::metamodel::execute::tests::executeLegendFunction($conn, $csv, $model, $func, 'supertype::mapping::H2Mapping', 'supertype::store::H2DB', $expected);
}

function <<paramTest.Test>> meta::relational::tests::semistructured::supertype::testQualifiedPropertyPassingThisToSupertypeParameterOnSubclass(conn: Connection[1]):Boolean[1]
{
  supertypeExecute($conn,
    'supertype::labelOfSubItems__TabularDataSet_1_',
    'Id,Label\n' +
    '1,Root\n' +
    '2,Root\n' +
    '3,Loner\n'
  );
}

function <<paramTest.Test>> meta::relational::tests::semistructured::supertype::testQualifiedPropertyPassingThisToSupertypeParameterOnBaseClass(conn: Connection[1]):Boolean[1]
{
  supertypeExecute($conn,
    'supertype::labelOfBaseItems__TabularDataSet_1_',
    'Id,Label\n' +
    '1,Root\n' +
    '2,Root\n' +
    '3,Loner\n'
  );
}
