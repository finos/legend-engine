function <<test.Test>> meta::relational::tests::sqlOptimizer::semantics::elimination::testPassThroughCollapseKeepsAnOutputAliasTheInnerWhereClauseReads():Boolean[1]
{
  let f = fixture('elim_ownwhere');
  let t = tableAlias('t', $f.t);
  let s = tableAlias('s', ^SelectSQLQuery(columns = [named(ref($t, 'ID'), 'A'), named(fn('plus', [ref($t, 'V'), lit(1)]), 'Q')], data = root($t), filteringOperation = fn('greaterThan', [columnName('Q'), lit(2)])));
  assertNotEliminated(sel(named(ref($s, 'A'), 'A'), root($s)));
}

function <<paramTest.Test>> meta::relational::tests::sqlOptimizer::semantics::elimination::testEveryRuleKeepsLiteralsOutOfGroupByAndOrderBy(conn:Connection[1]):Boolean[1]
{
  let f = fixture('every_literalkeys', $conn);
  let s = tableAlias('s', literalColumns($f));
  assertSameRows($f, ^SelectSQLQuery(columns = named(fn('max', ref($s, '"v"')), '"m"'), data = root($s), groupBy = ref($s, '"one"')), false);
  assertSameRows($f, ^SelectSQLQuery(columns = named(fn('count', ref($s, '"id"')), '"n"'), data = root($s), groupBy = ref($s, '"k"')), false);
  assertSameRows($f, ^SelectSQLQuery(columns = [named(ref($s, '"g"'), '"g"'), named(ref($s, '"id"'), '"id"')], data = root($s), orderBy = [orderAsc(ref($s, '"k"')), orderDesc(ref($s, '"id"'))]), true);
}
