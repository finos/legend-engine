}

function <<test.Test>> meta::relational::tests::sqlOptimizer::semantics::elimination::testAnInnerOrderByFeedingAnOuterLimitIsNotMerged():Boolean[1]
{
  let f = fixture('elim_orderfeedslimit');
  let t = tableAlias('t', $f.t);
