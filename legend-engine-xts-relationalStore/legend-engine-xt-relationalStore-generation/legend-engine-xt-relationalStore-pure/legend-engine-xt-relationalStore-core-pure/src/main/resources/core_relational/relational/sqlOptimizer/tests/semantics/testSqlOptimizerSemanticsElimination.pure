function <<paramTest.Test>> meta::relational::tests::sqlOptimizer::semantics::elimination::testALiteralOnTheNullableSideOfALeftJoinStaysNullExtended(conn:Connection[1]):Boolean[1]
{
  let f = fixture('elim_nullableliteral', $conn);
