  assertSameSQL('select "t".V as "id", "t".ID as "v" from SQLOPT.SQLOPT_T_elim_swappedorder as "t" order by "id" asc, "v" asc', $query->optimizedSql(elimination()));
  assertSameRows($f, $query, true);
}

function <<paramTest.Test>> meta::relational::tests::sqlOptimizer::semantics::elimination::testEliminationDoesNotInlineAComputedColumnIntoTheOuterQuery(conn:Connection[1]):Boolean[1]
{
