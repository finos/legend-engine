###Pure
import meta::pure::mapping::*;
import meta::pure::graphFetch::execution::*;
import meta::core::runtime::*;
import meta::relational::metamodel::execute::*;
import meta::relational::tests::mapping::relation::graphFetch::pk::*;

function <<test.BeforePackage>> meta::relational::tests::mapping::relation::graphFetch::pk::setUp():Boolean[1]
{
  setUpTables();
}

function meta::relational::tests::mapping::relation::graphFetch::pk::setUpTables():Boolean[1]
{
  let connection = meta::external::store::relational::tests::testRuntime(PkDB).connectionByElement(PkDB)->cast(@meta::external::store::relational::runtime::TestDatabaseConnection);

  executeInDb('Drop table if exists RFGF_PK_FIRM;', $connection);
  executeInDb('Create Table RFGF_PK_FIRM(ID INT, CODE VARCHAR(10), LEGALNAME VARCHAR(100));', $connection);
  executeInDb('insert into RFGF_PK_FIRM (ID, CODE, LEGALNAME) values (1, \'FX\', \'Firm X\');', $connection);
  executeInDb('insert into RFGF_PK_FIRM (ID, CODE, LEGALNAME) values (2, \'FA\', \'Firm A\');', $connection);
  executeInDb('insert into RFGF_PK_FIRM (ID, CODE, LEGALNAME) values (3, \'FB\', \'Firm B\');', $connection);

  executeInDb('Drop table if exists RFGF_PK_PERSON;', $connection);
  executeInDb('Create Table RFGF_PK_PERSON(ID INT, NAME VARCHAR(100), FIRMID INT, MANAGERID INT);', $connection);
  executeInDb('insert into RFGF_PK_PERSON (ID, NAME, FIRMID, MANAGERID) values (1, \'Alice\', 1, NULL);', $connection);
  executeInDb('insert into RFGF_PK_PERSON (ID, NAME, FIRMID, MANAGERID) values (2, \'Bob\', 1, 1);', $connection);
  executeInDb('insert into RFGF_PK_PERSON (ID, NAME, FIRMID, MANAGERID) values (3, \'Carol\', 2, 2);', $connection);
  executeInDb('insert into RFGF_PK_PERSON (ID, NAME, FIRMID, MANAGERID) values (4, \'Dave\', 99, 2);', $connection);
  executeInDb('insert into RFGF_PK_PERSON (ID, NAME, FIRMID, MANAGERID) values (5, \'Eve\', 2, 3);', $connection);

  executeInDb('Drop table if exists RFGF_PK_ACCOUNT;', $connection);
  executeInDb('Create Table RFGF_PK_ACCOUNT(BRANCH VARCHAR(10), ACCNO INT, FIRMID INT, BALANCE INT);', $connection);
  executeInDb('insert into RFGF_PK_ACCOUNT (BRANCH, ACCNO, FIRMID, BALANCE) values (\'LDN\', 1, 1, 100);', $connection);
  executeInDb('insert into RFGF_PK_ACCOUNT (BRANCH, ACCNO, FIRMID, BALANCE) values (\'NYC\', 1, 2, 200);', $connection);
  executeInDb('insert into RFGF_PK_ACCOUNT (BRANCH, ACCNO, FIRMID, BALANCE) values (\'LDN\', 2, 1, 300);', $connection);

  executeInDb('Drop table if exists RFGF_PK_TXN;', $connection);
  executeInDb('Create Table RFGF_PK_TXN(ID INT, BRANCH VARCHAR(10), ACCNO INT, AMOUNT INT);', $connection);
  executeInDb('insert into RFGF_PK_TXN (ID, BRANCH, ACCNO, AMOUNT) values (1, \'LDN\', 1, 10);', $connection);
  executeInDb('insert into RFGF_PK_TXN (ID, BRANCH, ACCNO, AMOUNT) values (2, \'LDN\', 1, 20);', $connection);
  executeInDb('insert into RFGF_PK_TXN (ID, BRANCH, ACCNO, AMOUNT) values (3, \'NYC\', 1, 30);', $connection);
  executeInDb('insert into RFGF_PK_TXN (ID, BRANCH, ACCNO, AMOUNT) values (4, \'LDN\', 2, 40);', $connection);

  let otherConnection = meta::external::store::relational::tests::testRuntime(PkOtherDB).connectionByElement(PkOtherDB)->cast(@meta::external::store::relational::runtime::TestDatabaseConnection);
  executeInDb('Drop table if exists RFGF_PK_OTHER;', $otherConnection);
  executeInDb('Create Table RFGF_PK_OTHER(ID INT, NAME VARCHAR(100));', $otherConnection);
  executeInDb('insert into RFGF_PK_OTHER (ID, NAME) values (1, \'Other\');', $otherConnection);

  true;
}

function <<access.private>> meta::relational::tests::mapping::relation::graphFetch::pk::twoStoreRuntime():Runtime[1]
{
  ^Runtime(connectionStores = meta::external::store::relational::tests::testRuntime(PkDB).connectionStores
                                ->concatenate(meta::external::store::relational::tests::testRuntime(PkOtherDB).connectionStores));
}

function <<access.private>> meta::relational::tests::mapping::relation::graphFetch::pk::planString(query:FunctionDefinition<Any>[1], mapping:Mapping[1]):String[1]
{
  meta::pure::executionPlan::executionPlan($query, $mapping, meta::external::store::relational::tests::testRuntime(PkDB), meta::relational::extension::relationalExtensions())
    ->meta::pure::executionPlan::toString::planToString(meta::relational::extension::relationalExtensions());
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::pk::testExplicitPrimaryKeyOnNonKeyColumnDrivesToManyChild():Boolean[1]
{
  let tree = #{
    Firm {
      legalName,
      employees {
        name
      }
    }
  }#;
  let query = {|Firm.all()->graphFetch($tree)->serialize($tree)};

  assert(planString($query, ExplicitPrimaryKeyMapping)->contains('select "root"."CODE" as "pk_0"'));

  let result = execute($query, ExplicitPrimaryKeyMapping, meta::external::store::relational::tests::testRuntime(PkDB), meta::relational::extension::relationalExtensions());

  assertJsonStringsEqual(
    '[{"legalName":"Firm X","employees":[{"name":"Alice"},{"name":"Bob"}]},' +
    '{"legalName":"Firm A","employees":[{"name":"Carol"},{"name":"Eve"}]},' +
    '{"legalName":"Firm B","employees":[]}]',
    $result.values
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::pk::testExplicitPrimaryKeyWhenRelationFunctionDropsKeyDrivesToOneChild():Boolean[1]
{
  let tree = #{
    Person {
      name,
      firm {
        legalName
      }
    }
  }#;

  let result = execute(
    |Person.all()->graphFetch($tree)->serialize($tree),
    PersonWithoutIdExplicitPrimaryKeyMapping,
    meta::external::store::relational::tests::testRuntime(PkDB),
    meta::relational::extension::relationalExtensions()
  );

  assertJsonStringsEqual(
    '[{"name":"Alice","firm":{"legalName":"Firm X"}},' +
    '{"name":"Bob","firm":{"legalName":"Firm X"}},' +
    '{"name":"Carol","firm":{"legalName":"Firm A"}},' +
    '{"name":"Dave","firm":null},' +
    '{"name":"Eve","firm":{"legalName":"Firm A"}}]',
    $result.values
  );
}

// ACCNO alone is not unique (LDN/1 and NYC/1), so only the full composite key links each child to the right account.
function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::pk::testExplicitCompositePrimaryKeyDrivesToManyChild():Boolean[1]
{
  let tree = #{
    Account {
      branch,
      accountNumber,
      transactions {
        amount
      }
    }
  }#;

  let result = execute(
    |Account.all()->graphFetch($tree)->serialize($tree),
    ExplicitPrimaryKeyMapping,
    meta::external::store::relational::tests::testRuntime(PkDB),
    meta::relational::extension::relationalExtensions()
  );

  assertJsonStringsEqual(
    '[{"branch":"LDN","accountNumber":1,"transactions":[{"amount":10},{"amount":20}]},' +
    '{"branch":"NYC","accountNumber":1,"transactions":[{"amount":30}]},' +
    '{"branch":"LDN","accountNumber":2,"transactions":[{"amount":40}]}]',
    $result.values
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::pk::testExplicitCompositePrimaryKeyDrivesToOneChild():Boolean[1]
{
  let tree = #{
    Account {
      branch,
      accountNumber,
      balance,
      owner {
        legalName
      }
    }
  }#;

  let result = execute(
    |Account.all()->graphFetch($tree)->serialize($tree),
    ExplicitPrimaryKeyMapping,
    meta::external::store::relational::tests::testRuntime(PkDB),
    meta::relational::extension::relationalExtensions()
  );

  assertJsonStringsEqual(
    '[{"branch":"LDN","accountNumber":1,"balance":100,"owner":{"legalName":"Firm X"}},' +
    '{"branch":"NYC","accountNumber":1,"balance":200,"owner":{"legalName":"Firm A"}},' +
    '{"branch":"LDN","accountNumber":2,"balance":300,"owner":{"legalName":"Firm X"}}]',
    $result.values
  );
}

function <<test.Test>> meta::relational::tests::mapping::relation::graphFetch::pk::testMissingPrimaryKeyOnTableWithoutKeyFails():Boolean[1]
{
  let tree = #{
    Account {
      branch,
      transactions {
        amount
      }
    }
  }#;

  assertError(
    | planString({|Account.all()->graphFetch($tree)->serialize($tree)}, PkMapping),
    'Primary Key definition is must in graph fetch flow'
  );
}

function <<test.Test>> meta::relational::tests::mapping::relation::graphFetch::pk::testMissingPrimaryKeyWhenRelationFunctionDropsKeyFails():Boolean[1]
{
  let tree = #{
    Person {
      name,
      firm {
        legalName
      }
    }
  }#;

  assertError(
    | planString({|Person.all()->graphFetch($tree)->serialize($tree)}, PersonWithoutIdMapping),
    'Primary Key definition is must in graph fetch flow'
  );
}

