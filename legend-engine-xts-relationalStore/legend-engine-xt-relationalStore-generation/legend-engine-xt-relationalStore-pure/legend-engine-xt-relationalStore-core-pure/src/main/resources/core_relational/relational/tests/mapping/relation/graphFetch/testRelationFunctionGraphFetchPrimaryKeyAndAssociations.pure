###Mapping
import meta::relational::tests::mapping::relation::graphFetch::pk::*;

Mapping meta::relational::tests::mapping::relation::graphFetch::pk::PkMapping
(
  *Firm[pk_firm]: Relation
  {
    ~func meta::relational::tests::mapping::relation::graphFetch::pk::firmFunction__Relation_1_
    legalName: LEGALNAME,
    +id: Integer[1]: ID
  }

  *Person[pk_person]: Relation
  {
    ~func meta::relational::tests::mapping::relation::graphFetch::pk::personFunction__Relation_1_
    name: NAME,
    +id: Integer[1]: ID,
    +firmId: Integer[1]: FIRMID,
    +managerId: Integer[0..1]: MANAGERID
  }

  *Account[pk_account]: Relation
  {
    ~func meta::relational::tests::mapping::relation::graphFetch::pk::accountFunction__Relation_1_
    branch: BRANCH,
    accountNumber: ACCNO,
    balance: BALANCE,
    +firmId: Integer[1]: FIRMID
  }

  *Txn[pk_txn]: Relation
  {
    ~func meta::relational::tests::mapping::relation::graphFetch::pk::txnFunction__Relation_1_
    amount: AMOUNT,
    +branch: String[1]: BRANCH,
    +accountNumber: Integer[1]: ACCNO
  }

  Employment: XStore
  {
    employees[pk_firm, pk_person]: $this.id == $that.firmId,
    firm[pk_person, pk_firm]: $this.firmId == $that.id
  }

  Management: XStore
  {
    manager[pk_person, pk_person]: $this.managerId == $that.id,
    reports[pk_person, pk_person]: $this.id == $that.managerId
  }

  AccountTxn: XStore
  {
    transactions[pk_account, pk_txn]: ($this.branch == $that.branch) && ($this.accountNumber == $that.accountNumber),
    account[pk_txn, pk_account]: ($this.branch == $that.branch) && ($this.accountNumber == $that.accountNumber)
  }

  AccountFirm: XStore
  {
    owner[pk_account, pk_firm]: $this.firmId == $that.id,
    accounts[pk_firm, pk_account]: $this.id == $that.firmId
  }
)

Mapping meta::relational::tests::mapping::relation::graphFetch::pk::PersonWithoutIdMapping
(
  *Person[pk_person_no_id]: Relation
  {
    ~func meta::relational::tests::mapping::relation::graphFetch::pk::personWithoutIdFunction__Relation_1_
    name: NAME,
    +firmId: Integer[1]: FIRMID
  }

  *Firm[pk_firm]: Relation
  {
    ~func meta::relational::tests::mapping::relation::graphFetch::pk::firmFunction__Relation_1_
    legalName: LEGALNAME,
    +id: Integer[1]: ID
  }

  Employment: ModelJoin
  {
    {firm: meta::relational::tests::mapping::relation::graphFetch::pk::Firm[1], employees: meta::relational::tests::mapping::relation::graphFetch::pk::Person[1] | $firm.id == $employees.firmId}
  }
)

Mapping meta::relational::tests::mapping::relation::graphFetch::pk::ExplicitPrimaryKeyMapping
(
  *Firm[pk_firm]: Relation
  {
    ~func meta::relational::tests::mapping::relation::graphFetch::pk::firmFunction__Relation_1_
    ~primaryKey: CODE
    legalName: LEGALNAME,
    +id: Integer[1]: ID
  }

  *Person[pk_person]: Relation
  {
    ~func meta::relational::tests::mapping::relation::graphFetch::pk::personFunction__Relation_1_
    name: NAME,
    +firmId: Integer[1]: FIRMID
  }

  *Account[pk_account]: Relation
  {
    ~func meta::relational::tests::mapping::relation::graphFetch::pk::accountFunction__Relation_1_
    ~primaryKey: [BRANCH, ACCNO]
    branch: BRANCH,
    accountNumber: ACCNO,
    balance: BALANCE,
    +firmId: Integer[1]: FIRMID
  }

  *Txn[pk_txn]: Relation
  {
    ~func meta::relational::tests::mapping::relation::graphFetch::pk::txnFunction__Relation_1_
    amount: AMOUNT,
    +branch: String[1]: BRANCH,
    +accountNumber: Integer[1]: ACCNO
  }

  Employment: ModelJoin
  {
    {firm: meta::relational::tests::mapping::relation::graphFetch::pk::Firm[1], employees: meta::relational::tests::mapping::relation::graphFetch::pk::Person[1] | $firm.id == $employees.firmId}
  }

  AccountTxn: ModelJoin
  {
    {account: meta::relational::tests::mapping::relation::graphFetch::pk::Account[1], transactions: meta::relational::tests::mapping::relation::graphFetch::pk::Txn[1] | ($account.branch == $transactions.branch) && ($account.accountNumber == $transactions.accountNumber)}
  }

  AccountFirm: ModelJoin
  {
    {owner: meta::relational::tests::mapping::relation::graphFetch::pk::Firm[1], accounts: meta::relational::tests::mapping::relation::graphFetch::pk::Account[1] | $accounts.firmId == $owner.id}
  }
)

