    '{"name":"Bob","firm":{"legalName":"Firm X"}},' +
    '{"name":"Carol","firm":{"legalName":"Firm A"}},' +
    '{"name":"Dave","firm":null},' +
    '{"name":"Eve","firm":{"legalName":"Firm A"}}]',
    $result.values
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::pk::testToOneAssociationWithoutMatchResolvesToNull():Boolean[1]
{
  let tree = #{
    Person {
      name,
      firm {
        legalName
      }
    }
  }#;

  let result = execute(
    |Person.all()->filter(p | $p.name->in(['Alice', 'Dave']))->graphFetch($tree)->serialize($tree),
    PkMapping,
    meta::external::store::relational::tests::testRuntime(PkDB),
    meta::relational::extension::relationalExtensions()
  );

  assertJsonStringsEqual(
    '[{"name":"Alice","firm":{"legalName":"Firm X"}},{"name":"Dave","firm":null}]',
    $result.values
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::pk::testEmptyRootResultWithNestedChild():Boolean[1]
{
  let tree = #{
    Firm {
      legalName,
      employees {
        name
      }
    }
  }#;

  let result = execute(
    |Firm.all()->filter(f | $f.legalName == 'No Such Firm')->graphFetch($tree)->serialize($tree),
    PkMapping,
    meta::external::store::relational::tests::testRuntime(PkDB),
    meta::relational::extension::relationalExtensions()
  );

  assertJsonStringsEqual('[]', $result.values);
}

// A single-set XStore self-association is never localized (routing.pure maybeConvertXStoreToModelJoin expects two
// distinct sets) and the unlocalized XStorePropertyMapping then fails in pureToSQLQuery processPropertyMapping.
function <<test.Test, test.AlloyOnly, test.ToFix>> meta::relational::tests::mapping::relation::graphFetch::pk::testSelfAssociationToOneChain():Boolean[1]
{
  let tree = #{
    Person {
      name,
      manager {
        name,
        manager {
          name
        }
      }
    }
  }#;

  let result = execute(
    |Person.all()->graphFetch($tree)->serialize($tree),
    PkMapping,
    meta::external::store::relational::tests::testRuntime(PkDB),
    meta::relational::extension::relationalExtensions()
  );

  assertJsonStringsEqual(
    '[{"name":"Alice","manager":null},' +
    '{"name":"Bob","manager":{"name":"Alice","manager":null}},' +
    '{"name":"Carol","manager":{"name":"Bob","manager":{"name":"Alice"}}},' +
    '{"name":"Dave","manager":{"name":"Bob","manager":{"name":"Alice"}}},' +
    '{"name":"Eve","manager":{"name":"Carol","manager":{"name":"Bob"}}}]',
    $result.values
  );
}

// A single-set XStore self-association is never localized (routing.pure maybeConvertXStoreToModelJoin expects two
// distinct sets) and the unlocalized XStorePropertyMapping then fails in pureToSQLQuery processPropertyMapping.
function <<test.Test, test.AlloyOnly, test.ToFix>> meta::relational::tests::mapping::relation::graphFetch::pk::testSelfAssociationToMany():Boolean[1]
{
  let tree = #{
    Person {
      name,
      reports {
        name
      }
    }
  }#;

  let result = execute(
    |Person.all()->graphFetch($tree)->serialize($tree),
    PkMapping,
    meta::external::store::relational::tests::testRuntime(PkDB),
    meta::relational::extension::relationalExtensions()
  );

  assertJsonStringsEqual(
    '[{"name":"Alice","reports":[{"name":"Bob"}]},' +
    '{"name":"Bob","reports":[{"name":"Carol"},{"name":"Dave"}]},' +
    '{"name":"Carol","reports":[{"name":"Eve"}]},' +
    '{"name":"Dave","reports":[]},' +
    '{"name":"Eve","reports":[]}]',
    $result.values
  );
}

