{
  branch: String[1];
  accountNumber: Integer[1];
  balance: Integer[1];
}

Class meta::relational::tests::mapping::relation::graphFetch::pk::Txn
{
  amount: Integer[1];
}

Association meta::relational::tests::mapping::relation::graphFetch::pk::Employment
{
  firm: Firm[0..1];
  employees: Person[*];
}

Association meta::relational::tests::mapping::relation::graphFetch::pk::Management
{
  manager: Person[0..1];
  reports: Person[*];
}

Association meta::relational::tests::mapping::relation::graphFetch::pk::AccountTxn
{
  account: Account[0..1];
  transactions: Txn[*];
}

Association meta::relational::tests::mapping::relation::graphFetch::pk::AccountFirm
{
  owner: Firm[0..1];
  accounts: Account[*];
}

