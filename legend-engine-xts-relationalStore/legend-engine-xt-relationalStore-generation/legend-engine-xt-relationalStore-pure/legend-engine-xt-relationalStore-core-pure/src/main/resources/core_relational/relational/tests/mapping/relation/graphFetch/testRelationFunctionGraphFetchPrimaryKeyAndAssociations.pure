###Relational
Database meta::relational::tests::mapping::relation::graphFetch::pk::PkDB
(
  Table RFGF_PK_FIRM
  (
    ID INTEGER PRIMARY KEY,
    CODE VARCHAR(10) NOT NULL,
    LEGALNAME VARCHAR(100) NOT NULL
  )

  Table RFGF_PK_PERSON
  (
    ID INTEGER PRIMARY KEY,
    NAME VARCHAR(100) NOT NULL,
    FIRMID INTEGER NOT NULL,
    MANAGERID INTEGER
  )

  Table RFGF_PK_ACCOUNT
  (
    BRANCH VARCHAR(10) NOT NULL,
    ACCNO INTEGER NOT NULL,
    FIRMID INTEGER NOT NULL,
    BALANCE INTEGER NOT NULL
  )

  Table RFGF_PK_TXN
  (
    ID INTEGER PRIMARY KEY,
    BRANCH VARCHAR(10) NOT NULL,
    ACCNO INTEGER NOT NULL,
    AMOUNT INTEGER NOT NULL
  )
)

###Relational
Database meta::relational::tests::mapping::relation::graphFetch::pk::PkOtherDB
(
  Table RFGF_PK_OTHER
  (
    ID INTEGER PRIMARY KEY,
    NAME VARCHAR(100) NOT NULL
  )
)

