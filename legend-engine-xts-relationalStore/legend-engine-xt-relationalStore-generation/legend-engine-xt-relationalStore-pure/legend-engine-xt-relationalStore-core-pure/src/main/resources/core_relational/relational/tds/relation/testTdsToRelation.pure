function <<test.Test>> meta::pure::tds::toRelation::testJoinUsingSingleColumnListFails():Boolean[1]
{
  assertError(
    | {| TestClass.all()->project([
          col(x | $x.string, 'str1'),
          col(x | $x.integer, 'int')
        ])->join(TestClass.all()->project([
                  col(x | $x.string, 'str2'),
                  col(x | $x.integer, 'int')
                ]), JoinType.INNER, ['int']
        )
      }->meta::pure::tds::toRelation::transform(meta::relational::extension::relationalExtensions());,
    'conversion of join on a single column list [int] is currently not supported, rename the column(s) on one side and join on separate left and right column lists'
  );
}

function <<test.Test>> meta::pure::tds::toRelation::testJoinUsingPartiallySharedColumnNamesFails():Boolean[1]
{
  assertError(
    | {| TestClass.all()->project([
          col(x | $x.string, 'str'),
          col(x | $x.integer, 'int1')
        ])->join(TestClass.all()->project([
                  col(x | $x.string, 'str'),
                  col(x | $x.integer, 'int2')
                ]), JoinType.LEFT_OUTER, ['int1', 'str'], ['int2', 'str']
        )
      }->meta::pure::tds::toRelation::transform(meta::relational::extension::relationalExtensions());,
    'conversion of join on column(s) [str] present on both sides is currently not supported, rename the column(s) on one side and join on separate left and right column lists'
  );
}

function <<test.Test>> meta::pure::tds::toRelation::testJoinUsingCrossedColumnNamesFails():Boolean[1]
{
  assertError(
    | {| TestClass.all()->project([
          col(x | $x.string, 'str'),
          col(x | $x.integer, 'int')
        ])->join(TestClass.all()->project([
                  col(x | $x.integer, 'int'),
                  col(x | $x.string, 'str')
                ]), JoinType.INNER, ['str', 'int'], ['int', 'str']
        )
      }->meta::pure::tds::toRelation::transform(meta::relational::extension::relationalExtensions());,
    'conversion of join on column(s) [str, int] present on both sides is currently not supported, rename the column(s) on one side and join on separate left and right column lists'
  );
}
