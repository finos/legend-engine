function <<access.private>> meta::relational::functions::pureToSqlQuery::processVariantEmpty(f:FunctionExpression[1], isEmpty:Boolean[1], currentPropertyMapping:PropertyMapping[*], operation:SelectWithCursor[1], vars:Map<VariableExpression, ValueSpecification>[1], state:State[1], joinType:JoinType[1], nodeId:String[1], aggFromMap:List<ColumnGroup>[1], context:DebugContext[1], extensions:Extension[*]):RelationalOperationElement[1]
{
  // Use compiler-resolved overload to decide: MANY = array (size check), 0..1 = scalar (null check)
  let isArray = $f.func == isEmpty_Any_MANY__Boolean_1_ || $f.func == isNotEmpty_Any_MANY__Boolean_1_;
  let effectiveState = if($f->isSemiStructuredArrayInput($vars, $state), |^$state(disableAutoFlatten = true), |$state);
  if($isArray,
    | // Array input: size-based check
      let eqResult = processEquals($f->getVariantEmptyFunctionExpression()->evaluateAndDeactivate(), $currentPropertyMapping, $operation, $vars, $effectiveState, $joinType, $nodeId, $aggFromMap, $context, $extensions)->cast(@SelectWithCursor);
      if($isEmpty,
        | $eqResult,
        | let sel = $eqResult.select;
          let eqOp = $effectiveState.inFilter->if(|$sel.filteringOperation->toOne(), |$sel.columns->toOne());
          let notOp = newDynaFunction('not', [$eqOp]);
          ^$eqResult(select = $effectiveState.inFilter->if(|^$sel(filteringOperation = $notOp), |^$sel(columns = $notOp)));
      );,
    | // Scalar variant: null check
      let processed = $f.parametersValues->at(0)->processValueSpecification($currentPropertyMapping, $operation, $vars, $effectiveState, $joinType, $nodeId, $aggFromMap, $context, $extensions)->cast(@SelectWithCursor)->toOne();
      let sel = $processed.select;
      let col = $effectiveState.inFilter->if(|$sel.filteringOperation->toOne(), |$sel.columns->toOne());
      let nullCheck = newDynaFunction(if($isEmpty, |'isNull', |'isNotNull'), [$col]);
      ^$processed(select = $effectiveState.inFilter->if(|^$sel(filteringOperation = $nullCheck), |^$sel(columns = $nullCheck)));
  );
}

function meta::relational::functions::pureToSqlQuery::getVariantEmptyFunctionExpression(f:FunctionExpression[1]):SimpleFunctionExpression[1]
{
  ^SimpleFunctionExpression(
