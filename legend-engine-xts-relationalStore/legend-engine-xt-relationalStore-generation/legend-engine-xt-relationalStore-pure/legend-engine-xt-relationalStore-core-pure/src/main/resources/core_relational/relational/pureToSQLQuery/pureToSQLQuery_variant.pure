function meta::relational::functions::pureToSqlQuery::isVariantInput(v: ValueSpecification[1], vars:Map<VariableExpression, ValueSpecification>[1], state: State[1]):Boolean[1]
{
  $v->isVariantInputImpl($vars, $state, false);
}

function meta::relational::functions::pureToSqlQuery::isVariantInputWithInstanceValue(v: ValueSpecification[1], vars:Map<VariableExpression, ValueSpecification>[1], state: State[1]):Boolean[1]
{
  $v->isVariantInputImpl($vars, $state, true);
}

function meta::relational::functions::pureToSqlQuery::isVariantInputImpl(v: ValueSpecification[1], vars:Map<VariableExpression, ValueSpecification>[1], state: State[1], instanceValueLookup: Boolean[1]):Boolean[1]
{
  if($v.genericType.rawType == meta::pure::metamodel::variant::Variant,
    |
      true,
    |
      $v->match([
        fe: FunctionExpression[1] | 
          $fe.parametersValues->head()->map(x | $x->isVariantInputImpl($vars, $state, $instanceValueLookup))->orElse(false),
        ve: VariableExpression[1] |
          $state.functionReferenceScope->map(frs | $frs.resolveFunctionReferenceByName($ve.name)).select.columns->match([
            rlp: RelationalLambdaParameter[1] | 
              $rlp.type->type()->in(
                  [
                    meta::relational::metamodel::datatype::SemiStructured,
                    meta::relational::metamodel::datatype::Object, 
                    meta::relational::metamodel::datatype::Array
                  ]
                ),
            any: Any[*] |
               $vars->get($ve)->map(x | $x->isVariantInputImpl($vars, $state, $instanceValueLookup))->orElse(false);
          ]);,
        iv: InstanceValue[1]      | 
          $instanceValueLookup && ($iv.values->type()->instanceOf(PrimitiveType) || $iv.values->type() == Nil),
        rvs: RoutedValueSpecification[1] | 
          $rvs.value->isVariantInputImpl($vars, $state, $instanceValueLookup),
        any: Any[1] | 
          false;
      ])
  );
}

function meta::relational::functions::pureToSqlQuery::isAutomapWithVariantInput(v: ValueSpecification[1], vars:Map<VariableExpression, ValueSpecification>[1], state: State[1]):Boolean[1]
{
  $v->cast(@FunctionExpression)->instanceValuesAtParameter(1, $vars, $state.inScopeVars)->match([
    func: FunctionDefinition<Any>[1] |
      $func.expressionSequence->at(0)->byPassRouterInfo()->match([
        prop: FunctionExpression[1] |
          let isAutoMap = $prop.func->instanceOf(AbstractProperty) && $prop.parametersValues->at(0)->instanceOf(VariableExpression) && $prop.parametersValues->at(0)->cast(@VariableExpression).name == 'v_automap';
          $isAutoMap && isVariantInputWithInstanceValue($v, $vars, $state); 
        ,
        any :Any[1] | false
      ]);
    ,
    any: Any[1] | false
  ]);
}

// Returns true if any sub-expression of `v` involves a Variant. Used by the
// RelationFunctionPropertyMapping lift router (processRelationFunctionPropertyMapping)
// to decide whether to wrap the synthesised property mapping as semi-structured.
// Walks the head spine first via isVariantInputWithInstanceValue (covers most cases:
// `$row.payload->...`, `arr->filter(...)`, `arr->size()`, etc.), then recurses into
// all parametersValues and routed-value-spec wrappers for completeness (covers
// non-head-spine variants e.g. `if($cond, $variantA, $variantB)`).
function meta::relational::functions::pureToSqlQuery::expressionTouchesVariant(v:ValueSpecification[1], state:State[1]):Boolean[1]
{
  let emptyVars = newMap([]->cast(@Pair<VariableExpression, ValueSpecification>));
  if($v->isVariantInputWithInstanceValue($emptyVars, $state),
     | true,
     | $v->match([
         fe: FunctionExpression[1]        | $fe.parametersValues->exists(p | $p->expressionTouchesVariant($state)),
         rvs: RoutedValueSpecification[1] | $rvs.value->expressionTouchesVariant($state),
         a: Any[1]                        | false
       ]));
}

function meta::relational::functions::pureToSqlQuery::isSemiStructuredArrayInput(v: ValueSpecification[1], vars:Map<VariableExpression, ValueSpecification>[1], state: State[1]):Boolean[1]
{
  let firstParam = $v->cast(@FunctionExpression).parametersValues->evaluateAndDeactivate()->at(0)->byPassRouterInfo();
  $firstParam->isSemiStructuredArrayExpression($vars, $state);
}

function meta::relational::functions::pureToSqlQuery::isSemiStructuredArrayInputWithAutoFlattenDisabled(v: ValueSpecification[1], vars:Map<VariableExpression, ValueSpecification>[1], state: State[1]):Boolean[1]
{
  $state.disableAutoFlatten == true && $v->isSemiStructuredArrayInput($vars, $state);
}

function meta::relational::functions::pureToSqlQuery::isSemiStructuredArrayInputForFirstAt(v: ValueSpecification[1], vars:Map<VariableExpression, ValueSpecification>[1], state: State[1]):Boolean[1]
{
  // If disableAutoFlatten is already set, always allow (chained from isEmpty/size/fold)
  let result = if($state.disableAutoFlatten == true,
    | $v->isSemiStructuredArrayInput($vars, $state),
    | // Entry point case: check that the first param is a non-property function
      // and exclude automaps (which are compiler-generated map(collection, v_automap | v_automap.prop))
      let firstParam = $v->cast(@FunctionExpression).parametersValues->evaluateAndDeactivate()->at(0)->byPassRouterInfo();
      // Outer call distinction: this predicate is registered for ->at(), ->first(), and ->last().
      // For ->at() on a direct property access (e.g. `addresses->at(0)`) we skip the
      // semi-structured path -- the regular relational at() handler is the right fit.
      // For ->first() / ->last() on a direct property access (e.g. `addresses->first()`,
      // `addresses->last()`) we still want to enter the semi-structured path so a
      // variant-backed array can be picked up.
      let isFirstOrLast = $v->cast(@FunctionExpression).func == meta::pure::functions::collection::first_T_MANY__T_$0_1$_
                       || $v->cast(@FunctionExpression).func == meta::pure::functions::collection::last_T_MANY__T_$0_1$_;
      $firstParam->match([
        fe: FunctionExpression[1] |
          let firstParamFuncIsProp = $fe.func->instanceOf(AbstractProperty);
          if($firstParamFuncIsProp && !$isFirstOrLast,
            | false;,
            | // Check if this is an automap
              let isAutomap = $fe.functionName == 'map' && $fe->instanceValuesAtParameter(1, $vars, $state.inScopeVars)->match([
                func: FunctionDefinition<Any>[1] |
                  $func.expressionSequence->at(0)->byPassRouterInfo()->match([
                    innerFe: FunctionExpression[1] |
                      $innerFe.func->instanceOf(AbstractProperty) &&
                      $innerFe.parametersValues->at(0)->instanceOf(VariableExpression) &&
                      $innerFe.parametersValues->at(0)->cast(@VariableExpression).name == 'v_automap';,
                    a: Any[1] | false
                  ]);,
                a: Any[1] | false
              ]);
              let ssArrExprResult = $firstParam->isSemiStructuredArrayExpression($vars, $state);
              !$isAutomap && $ssArrExprResult;
          );,
        a: Any[1] | false;
      ]);
  );

  $result;
}

function meta::relational::functions::pureToSqlQuery::isRelationalToManyPropertyInput(v: ValueSpecification[1], vars:Map<VariableExpression, ValueSpecification>[1], state: State[1]):Boolean[1]
{
  let input = $v->cast(@FunctionExpression).parametersValues->evaluateAndDeactivate()->at(0)->byPassRouterInfo();
  $input->match([e:Expression[1] | !$e.multiplicity->hasToOneUpperBound(), a:Any[1] | false]) && $input->reachesPropertyNavigation();
}

function <<access.private>> meta::relational::functions::pureToSqlQuery::reachesPropertyNavigation(v: ValueSpecification[1]):Boolean[1]
{
  $v->byPassRouterInfo()->match([
    fe: FunctionExpression[1] | $fe.func->instanceOf(AbstractProperty)
                                  || ($fe.parametersValues->evaluateAndDeactivate()->isNotEmpty() && $fe.parametersValues->evaluateAndDeactivate()->at(0)->reachesPropertyNavigation()),
    a: Any[1]                 | false
  ]);
}

// Reached only when neither the semi-structured nor the variant predicate claimed the call. The
// operator would otherwise render as an array function over a plain column, which is not an array.
function meta::relational::functions::pureToSqlQuery::processUnsupportedArrayOperationOnRelationalToMany(f:FunctionExpression[1], currentPropertyMapping:PropertyMapping[*], operation:SelectWithCursor[1], vars:Map<VariableExpression, ValueSpecification>[1], state:State[1], joinType:JoinType[1], nodeId:String[1], aggFromMap:List<ColumnGroup>[1], context:DebugContext[1], extensions:Extension[*]):RelationalOperationElement[1]
{
  fail('\'' + $f.func.functionName->toOne() + '\' on a to-many relational property is not supported - collapse the collection first (e.g. ->first(), ->toOne())');
  ^Literal(value = '');
}

// Walks back from a property access in a Pure expression like
//   $p.firmInfo.address.lines->first()  OR  $p.firmInfo.countries->first().someToManyProp->first()
// to locate the *entry-point* property mapping — the one sitting at the boundary between the
// relational source (StoreMappingRouted seed) and whatever comes after it.
//
// The walker threads a `candidate` property through the recursion: each property FE overwrites
// `candidate` with its own property and descends into the receiver; each non-property FE
// (first/filter/map/cast/...) RESETS `candidate` to `[]` and descends into its first parameter
// (Pure's ->fn pipeline desugaring) — the entry property must be directly connected to the source
// with no intervening non-property hop, or it isn't at the boundary. When the walk terminates at a
// StoreMappingRouted, `candidate` (if any) is by construction the property closest to the source;
// its property mappings are resolved against `$s.sets` in place.
//
// NoSetRouted, FunctionRouted and (non-mapping) ExtendedRouted wrappers are stripped without
// disturbing `candidate`. The seed SMR (wrapping the class InstanceValue or a lambda
// VariableExpression) never has `.propertyMapping` populated by routing, so resolution goes
// through `$s.sets` and a property-name lookup instead.
function <<access.private>> meta::relational::functions::pureToSqlQuery::findSourceRelationalPropertyMapping(receiver: ValueSpecification[1], candidate: AbstractProperty<Any>[0..1], state: State[1]):PropertyMapping[*]
{
  $receiver->evaluateAndDeactivate()->match([
    n: NoSetRoutedValueSpecification[1]        | $n.value->findSourceRelationalPropertyMapping($candidate, $state),
    f: FunctionRoutedValueSpecification[1]     | $f.value->findSourceRelationalPropertyMapping($candidate, $state),
    s: StoreMappingRoutedValueSpecification[1] |
      // An empty candidate means the receiver was the source itself (no upstream property access)
      // — nothing to look up.
      if ($candidate->isEmpty(),
        | [],
        | $s.sets->resolveOperation($s.mapping)->candidatePropertyMappings($candidate->toOne());
      );,
    r: ExtendedRoutedValueSpecification[1]     | $r.value->findSourceRelationalPropertyMapping($candidate, $state),
    // Inside a qualified property body `$this` is an unrouted variable, so there is no
    // StoreMappingRouted seed to terminate on; the qualifier base recorded in the state stands in.
    v: VariableExpression[1] |
      if ($v.name != 'this' || $state.qualifierBase->isEmpty(),
        | [],
        | let basePms = $state.qualifierBase->toOne().currentPropertyMapping;
          if ($candidate->isEmpty() || $basePms->exists(pm | $pm->isSemiStructuredPropertyMapping()),
            | $basePms,
            | []
          );
      );,
    fe: FunctionExpression[1] |
      $fe.func->match([
        prop: AbstractProperty<Any>[1] |
          // Property hop — this property becomes the new candidate. Deeper recursion decides
          // whether it survives (bottoms out at StoreMappingRouted) or gets superseded.
          $fe.parametersValues->evaluateAndDeactivate()->at(0)->findSourceRelationalPropertyMapping($prop, $state);,
        a: Any[1] |
          // Intermediate non-property call (first/filter/map/cast/...). Step over by descending
          // into the first parameter, resetting candidate — see block comment above.
          let firstParam = $fe.parametersValues->evaluateAndDeactivate()->first();
          if ($firstParam->isEmpty(),
            | [],
            | $firstParam->toOne()->findSourceRelationalPropertyMapping([], $state);
          );
      ]);,
    a: Any[1] | []
  ]);
}

function <<access.private>> meta::relational::functions::pureToSqlQuery::findSourceRelationalPropertyMapping(receiver: ValueSpecification[1], state: State[1]):PropertyMapping[*]
{
  $receiver->findSourceRelationalPropertyMapping([], $state);
}

// The walker runs as a dispatch predicate for every filter/exists/isEmpty/..., so an unmapped
// candidate must yield no mappings rather than fail. propertyMappingsByPropertyName fails on a
// plain or inline embedded set that does not map the property, which is always the case for a
// qualified property such as `$e.dept.label()`.
function <<access.private>> meta::relational::functions::pureToSqlQuery::candidatePropertyMappings(sets: InstanceSetImplementation[*], candidate: AbstractProperty<Any>[1]):PropertyMapping[*]
{
  let name = $candidate.name->toOne();
  $sets->map(s | if ($s->instanceOf(EmbeddedSetImplementation) && !$s->instanceOf(OtherwiseEmbeddedSetImplementation),
                   | $s->_propertyMappingsByPropertyName($name),
                   | $s->propertyMappingsByPropertyName($name)));
}

// True iff the entry PM is one of the SS-eligible PM kinds: SemiStructuredRelationalPropertyMapping
// (modern path), a RelationFunctionPropertyMapping with a class target (Variant / user Class), or
// one with a BindingTransformer (legacy SS path). Mirrors the conditions that drive NoSet emission
// in routing.pure (`isAutoMappedRelationFunctionPropertyMapping`).
function <<access.private>> meta::relational::functions::pureToSqlQuery::isSemiStructuredPropertyMapping(pm: PropertyMapping[1]):Boolean[1]
{
  $pm->match([
    sspm: SemiStructuredRelationalPropertyMapping[1] | true,
    rfpm: RelationFunctionPropertyMapping[1]         |
      $rfpm.property->isClassTargetedRelationFunctionProperty()
      || ($rfpm.transformer->isNotEmpty() && $rfpm.transformer->toOne()->instanceOf(BindingTransformer))
      || (!$rfpm.property.multiplicity->hasToOneUpperBound() && $rfpm.valueFn.expressionSequence->evaluateAndDeactivate()->exists(e | $e->hasVariantTypedSubExpression())),
    a: PropertyMapping[1]                            | false
  ]);
}

function <<access.private>> meta::relational::functions::pureToSqlQuery::hasVariantTypedSubExpression(v: ValueSpecification[1]):Boolean[1]
{
  $v->match([
    fe: FunctionExpression[1] | ($fe.genericType.rawType->isNotEmpty() && $fe.genericType.rawType->toOne() == Variant)
                                  || $fe.parametersValues->evaluateAndDeactivate()->exists(p | $p->hasVariantTypedSubExpression()),
    a: Any[1]                 | false
  ]);
}

// Cheap, intentionally over-inclusive early-out: skips the walker entirely for a mapping that
// cannot possibly contain a semi-structured-eligible property mapping, so a classic relational
// query never pays for (or risks) the recursive walk above. Does not need to recurse into embedded
// sets below the top level — Mapping.classMappings() already lists every InstanceSetImplementation,
// embedded ones included.
function <<access.private>> meta::relational::functions::pureToSqlQuery::mappingMayHaveSemiStructuredPropertyMapping(state: State[1]):Boolean[1]
{
  $state.mapping->isNotEmpty() &&
    $state.mapping->toOne()->classMappings()
      ->filter(cm | $cm->instanceOf(InstanceSetImplementation))->cast(@InstanceSetImplementation)
      ->exists(cm | $cm.propertyMappings->exists(pm | $pm->isSemiStructuredPropertyMapping()));
}

function <<access.private>> meta::relational::functions::pureToSqlQuery::isSemiStructuredArrayExpression(v: ValueSpecification[1], vars:Map<VariableExpression, ValueSpecification>[1], state: State[1]):Boolean[1]
{
  $v->match([
    fe: FunctionExpression[1] |
      $fe.func->match([
        prop: AbstractProperty<Any>[1] |
          // A property access qualifies as a semi-structured array iff:
          //   1. it is to-many (cardinality > 1),
          //   2. walking its receiver back to the chain source yields an entry PM whose type
          //      indicates an auto-mapped semi-structured chain (SemiStructured PM, class-target
          //      RFPM, or BindingTransformer RFPM), and
          //   3. that entry PM does NOT cross a JOIN (the disableAutoFlatten strategy does not
          //      support array operations across joins, e.g. `location: Binding ... : @Join | ...`).
          let isToMany = !$prop.multiplicity->hasToOneUpperBound();
          if (!$isToMany || !$state->mappingMayHaveSemiStructuredPropertyMapping(),
            | false,
            | let receiver  = $fe.parametersValues->evaluateAndDeactivate()->at(0);
              let receiverPm = $receiver->findSourceRelationalPropertyMapping($state);
              // A receiver that is the source itself has no property of its own: the array
              // property is the entry.
              let entryPm = if($receiverPm->isEmpty(), | $fe->findSourceRelationalPropertyMapping($state), | $receiverPm);
              let isEntrySS = $entryPm->exists(pm | $pm->isSemiStructuredPropertyMapping());
              let notAcrossJoin = !$entryPm->exists(pm |
                                      $pm->instanceOf(SemiStructuredRelationalPropertyMapping)
                                      && $pm->cast(@SemiStructuredRelationalPropertyMapping).relationalOperationElement->instanceOf(RelationalOperationElementWithJoin)
                                   );
              $isEntrySS && $notAcrossJoin;
          );,
        a: Any[1] |
          let hasParams = $fe.parametersValues->evaluateAndDeactivate()->isNotEmpty();
          if ($hasParams,
            | $fe.parametersValues->evaluateAndDeactivate()->at(0)->byPassRouterInfo()->isSemiStructuredArrayExpression($vars, $state),
            | false
          );
      ]);,
    rvs: RoutedValueSpecification[1] |
      $rvs.value->isSemiStructuredArrayExpression($vars, $state);,
    a: Any[1] |
      false;
  ]);
}

function <<access.private>> meta::relational::functions::pureToSqlQuery::resolveSemiStructuredBasePropertyMapping(v: ValueSpecification[1], currentPropertyMapping:PropertyMapping[*], operation:SelectWithCursor[1], vars:Map<VariableExpression, ValueSpecification>[1], state:State[1], joinType:JoinType[1], nodeId:String[1], aggFromMap:List<ColumnGroup>[1], context:DebugContext[1], extensions:Extension[*]):PropertyMapping[*]
{
  let expr = $v;
  $expr->match([
    fe: FunctionExpression[1] |
      $fe.func->match([
        prop: AbstractProperty<Any>[1] |
          // This is the base property — resolve its mapping
          processValueSpecificationReturnPropertyMapping($expr, $currentPropertyMapping, $operation, $vars, ^$state(disableAutoFlatten = true), $joinType, $nodeId, $aggFromMap, $context, $extensions)->toOne().currentPropertyMapping;,
        a: Any[1] |
          // Intermediate function (filter, map, etc.) — recurse into its first parameter
          if ($fe.parametersValues->evaluateAndDeactivate()->isNotEmpty(),
            | $fe.parametersValues->evaluateAndDeactivate()->at(0)->resolveSemiStructuredBasePropertyMapping($currentPropertyMapping, $operation, $vars, $state, $joinType, $nodeId, $aggFromMap, $context, $extensions),
            | []
          );
      ]);,
    rvs: RoutedValueSpecification[1] |
      $rvs.value->resolveSemiStructuredBasePropertyMapping($currentPropertyMapping, $operation, $vars, $state, $joinType, $nodeId, $aggFromMap, $context, $extensions),
    a: Any[1] | []
  ]);
}

// A semi-structured array is typed before an array function or lambda sees it, so every dialect gets
// concrete elements to compare and order. A single value (e.g. the element first() returned, mapped
// over by a property navigation) is not an array and is left as it is.
function <<access.private>> meta::relational::functions::pureToSqlQuery::asTypedSemiStructuredArray(cols:RelationalOperationElement[*], dataType:meta::relational::metamodel::datatype::DataType[0..1], input:ValueSpecification[1], f:FunctionExpression[1], vars:Map<VariableExpression, ValueSpecification>[1], state:State[1]):RelationalOperationElement[1]
{
  if($input.multiplicity->isToMany(), | $cols->toVariantFriendlyValue($dataType, $f, $vars, $state), | $cols->toVariantFriendlyValue($dataType));
}

function meta::relational::functions::pureToSqlQuery::processSemiStructuredArrayFirst(f:FunctionExpression[1], currentPropertyMapping:PropertyMapping[*], operation:SelectWithCursor[1], vars:Map<VariableExpression, ValueSpecification>[1], state:State[1], joinType:JoinType[1], nodeId:String[1], aggFromMap:List<ColumnGroup>[1], context:DebugContext[1], extensions:Extension[*]):RelationalOperationElement[1]
{
  let firstParam = $f.parametersValues->evaluateAndDeactivate()->at(0);
  // Resolve property mapping by walking through the chain to find the base semi-structured property
  let semiStructuredPropertyMapping = $firstParam->resolveSemiStructuredBasePropertyMapping($currentPropertyMapping, $operation, $vars, $state, $joinType, $nodeId, $aggFromMap, $context, $extensions);
  // Process the input chain with disableAutoFlatten — the chain (filter, map, etc.) will be
  // dispatched to their variant handlers which produce FilterRelationalLambda/MapRelationalLambda
  let disableAutoFlattenState = ^$state(disableAutoFlatten = true);
  let inputResult = $firstParam->processValueSpecification($currentPropertyMapping, $operation, $vars, ^$disableAutoFlattenState(inFilter = false), $joinType, $nodeId, $aggFromMap, $context, $extensions)
    ->cast(@SelectWithCursor)->toOne();
  let inputRelOp = $inputResult.select.columns->toOne();
  let arrayFirstDyna = newDynaFunction('array_first', [$inputRelOp->toVariantFriendlyValue($firstParam.genericType->genericTypeToDataType($firstParam.multiplicity), $f, $vars, $state)]);
  // Built on the input's select: resolving the input can join in nodes $operation lacks (e.g. a ModelJoin target).
  let select = $inputResult.select;
  let resultOp = ^$inputResult(select = $state.inFilter->if(|^$select(columns = $operation.select.columns, filteringOperation = $arrayFirstDyna), |^$select(columns = $arrayFirstDyna)));
  ^OperationWithParentPropertyMapping(element = $resultOp, currentPropertyMapping = $semiStructuredPropertyMapping);
}

function meta::relational::functions::pureToSqlQuery::processSemiStructuredArrayLast(f:FunctionExpression[1], currentPropertyMapping:PropertyMapping[*], operation:SelectWithCursor[1], vars:Map<VariableExpression, ValueSpecification>[1], state:State[1], joinType:JoinType[1], nodeId:String[1], aggFromMap:List<ColumnGroup>[1], context:DebugContext[1], extensions:Extension[*]):RelationalOperationElement[1]
{
  let firstParam = $f.parametersValues->evaluateAndDeactivate()->at(0);
  // Resolve property mapping by walking through the chain to find the base semi-structured property
  let semiStructuredPropertyMapping = $firstParam->resolveSemiStructuredBasePropertyMapping($currentPropertyMapping, $operation, $vars, $state, $joinType, $nodeId, $aggFromMap, $context, $extensions);
  // Process the input chain with disableAutoFlatten — keeps the raw variant array intact so
  // dialect-level array_last operates on the JSON array (not on a LATERAL-flattened scalar).
  let disableAutoFlattenState = ^$state(disableAutoFlatten = true);
  let inputResult = $firstParam->processValueSpecification($currentPropertyMapping, $operation, $vars, ^$disableAutoFlattenState(inFilter = false), $joinType, $nodeId, $aggFromMap, $context, $extensions)
    ->cast(@SelectWithCursor)->toOne();
  let inputRelOp = $inputResult.select.columns->toOne();
  let arrayLastDyna = newDynaFunction('array_last', [$inputRelOp->toVariantFriendlyValue($firstParam.genericType->genericTypeToDataType($firstParam.multiplicity), $f, $vars, $state)]);
  // Built on the input's select: resolving the input can join in nodes $operation lacks (e.g. a ModelJoin target).
  let select = $inputResult.select;
  let resultOp = ^$inputResult(select = $state.inFilter->if(|^$select(columns = $operation.select.columns, filteringOperation = $arrayLastDyna), |^$select(columns = $arrayLastDyna)));
  ^OperationWithParentPropertyMapping(element = $resultOp, currentPropertyMapping = $semiStructuredPropertyMapping);
}

function meta::relational::functions::pureToSqlQuery::processSemiStructuredArrayAt(f:FunctionExpression[1], currentPropertyMapping:PropertyMapping[*], operation:SelectWithCursor[1], vars:Map<VariableExpression, ValueSpecification>[1], state:State[1], joinType:JoinType[1], nodeId:String[1], aggFromMap:List<ColumnGroup>[1], context:DebugContext[1], extensions:Extension[*]):RelationalOperationElement[1]
{
  let params = $f.parametersValues->evaluateAndDeactivate();
  let firstParam = $params->at(0);
  // Resolve property mapping by walking through the chain to find the base semi-structured property
  let semiStructuredPropertyMapping = $firstParam->resolveSemiStructuredBasePropertyMapping($currentPropertyMapping, $operation, $vars, $state, $joinType, $nodeId, $aggFromMap, $context, $extensions);
  // Process the input chain with disableAutoFlatten
  let disableAutoFlattenState = ^$state(disableAutoFlatten = true);
  let inputResult = $firstParam->processValueSpecification($currentPropertyMapping, $operation, $vars, ^$disableAutoFlattenState(inFilter = false), $joinType, $nodeId, $aggFromMap, $context, $extensions)
    ->cast(@SelectWithCursor)->toOne();
  let inputRelOp = $inputResult.select.columns->toOne();
  let indexResult = $params->at(1)->processValueSpecification($currentPropertyMapping, $operation, $vars, ^$state(inFilter = false), $joinType, $nodeId, $aggFromMap, $context, $extensions)
    ->cast(@SelectWithCursor);
  let indexOp = $indexResult.select.columns->toOne();
  let arrayElementAccess = ^SemiStructuredArrayElementAccess(index = $indexOp, operand = $inputRelOp->toVariantFriendlyValue($firstParam.genericType->genericTypeToDataType($firstParam.multiplicity), $f, $vars, $state), returnType = $f.genericType.rawType);
  // Built on the input's select: resolving the input can join in nodes $operation lacks (e.g. a ModelJoin target).
  let select = $inputResult.select;
  let resultOp = ^$inputResult(select = $state.inFilter->if(|^$select(columns = $operation.select.columns, filteringOperation = $arrayElementAccess), |^$select(columns = $arrayElementAccess)));
  ^OperationWithParentPropertyMapping(element = $resultOp, currentPropertyMapping = $semiStructuredPropertyMapping);
}

