###Pure
Class meta::relational::tests::mapping::relation::inlineJoin::computedTarget::ComputedTargetPerson
{
  firstName: String[1];
  firmRef: meta::relational::tests::mapping::relation::inlineJoin::computedTarget::ComputedTargetFirm[0..1];
  firmRefByCondition: meta::relational::tests::mapping::relation::inlineJoin::computedTarget::ComputedTargetFirm[0..1];
  extendedTargetKey: String[0..1];
  conditionalTargetKey: String[0..1];
  emptyBranchTargetKey: String[0..1];
  textTargetKey: String[0..1];
  mixedCaseTargetKey: String[0..1];
  stackedExtendTargetKey: String[0..1];
  selectedTargetKey: String[0..1];
  filteredTargetKey: String[0..1];
  projectedTargetKey: Integer[0..1];
  gatedByTargetKey: String[0..1];
  countryOfExtendedFirmKey: String[0..1];
  extendedCountryKeyOfFirm: String[0..1];
  countryThroughBothKeys: String[0..1];
  countryThroughFirstHopKey: String[0..1];
  gatedCountryThroughKeys: String[0..1];
}

Class meta::relational::tests::mapping::relation::inlineJoin::computedTarget::ComputedTargetFirm
{
  id: Integer[1];
  legalName: String[1];
  keyPlus: Integer[0..1];
  keyIf: Integer[0..1];
}

###Mapping
import meta::relational::tests::mapping::relation::inlineJoin::*;
import meta::relational::tests::mapping::relation::inlineJoin::computedTarget::*;

Mapping meta::relational::tests::mapping::relation::inlineJoin::computedTarget::ComputedTargetJoinMapping
(
  *ComputedTargetPerson[computedTargetPerson]: Relation
  {
    ~func meta::relational::tests::mapping::relation::inlineJoin::personRel():Relation<Any>[1]
    firstName: FIRSTNAME,
    +firmId: Integer[0..1]: FIRMID,
    firmRef: modelJoin({p, f | $p.firmId == $f.keyPlus}),
    firmRefByCondition: modelJoin({p, f | $p.firmId == $f.keyIf}),
    extendedTargetKey: $src->navigationJoin(meta::relational::tests::mapping::relation::inlineJoin::firmRel()->extend(~KEY: x | $x.ID + 1), {p, f | $p.FIRMID == $f.KEY}).LEGALNAME,
    conditionalTargetKey: $src->navigationJoin(meta::relational::tests::mapping::relation::inlineJoin::firmRel()->extend(~KEY: x | if($x.ID > 0, | $x.ID, | $x.ID * 2)), {p, f | $p.FIRMID == $f.KEY}).LEGALNAME,
    emptyBranchTargetKey: $src->navigationJoin(meta::relational::tests::mapping::relation::inlineJoin::firmRel()->extend(~KEY: x | if($x.ID > 0, | $x.ID, | [])), {p, f | $p.FIRMID == $f.KEY}).LEGALNAME,
    textTargetKey: $src->navigationJoin(meta::relational::tests::mapping::relation::inlineJoin::firmRel()->extend(~KEY: x | $x.LEGALNAME + 'x'), {p, f | $p.FIRSTNAME == $f.KEY}).LEGALNAME,
    mixedCaseTargetKey: $src->navigationJoin(meta::relational::tests::mapping::relation::inlineJoin::firmRel()->extend(~firmKey: x | $x.ID + 1), {p, f | $p.FIRMID == $f.firmKey}).LEGALNAME,
    stackedExtendTargetKey: $src->navigationJoin(meta::relational::tests::mapping::relation::inlineJoin::firmRel()->extend(~KEY: x | $x.ID + 1)->extend(~KEY2: x | $x.KEY + 1), {p, f | $p.FIRMID == $f.KEY2}).LEGALNAME,
    selectedTargetKey: $src->navigationJoin(meta::relational::tests::mapping::relation::inlineJoin::firmRel()->extend(~KEY: x | $x.ID + 1)->select(~[KEY, LEGALNAME]), {p, f | $p.FIRMID == $f.KEY}).LEGALNAME,
    filteredTargetKey: $src->navigationJoin(meta::relational::tests::mapping::relation::inlineJoin::firmRel()->extend(~KEY: x | $x.ID + 1)->filter(x | $x.KEY > 1), {p, f | $p.FIRMID == $f.KEY}).LEGALNAME,
    projectedTargetKey: $src->navigationJoin(meta::relational::tests::mapping::relation::inlineJoin::firmRel()->extend(~KEY: x | $x.ID + 1), {p, f | $p.FIRMID == $f.KEY}).KEY,
    gatedByTargetKey: $src->filterJoin(meta::relational::tests::mapping::relation::inlineJoin::firmRel()->extend(~KEY: x | $x.ID + 1), {p, f | $p.FIRMID == $f.KEY}).FIRSTNAME,
    countryOfExtendedFirmKey: $src->navigationJoin(meta::relational::tests::mapping::relation::inlineJoin::chainFirmRel()->extend(~KEY: x | $x.ID + 1), {p, f | $p.FIRMID == $f.KEY})->navigationJoin(meta::relational::tests::mapping::relation::inlineJoin::countryRel(), {f, c | $f.COUNTRYID == $c.ID}).COUNTRYNAME,
    extendedCountryKeyOfFirm: $src->navigationJoin(meta::relational::tests::mapping::relation::inlineJoin::chainFirmRel(), {p, f | $p.FIRMID == $f.ID})->navigationJoin(meta::relational::tests::mapping::relation::inlineJoin::countryRel()->extend(~KEY: c | $c.ID + 1), {f, c | $f.COUNTRYID == $c.KEY}).COUNTRYNAME,
    countryThroughBothKeys: $src->navigationJoin(meta::relational::tests::mapping::relation::inlineJoin::chainFirmRel()->extend(~KEY: x | $x.ID + 1), {p, f | $p.FIRMID == $f.KEY})->navigationJoin(meta::relational::tests::mapping::relation::inlineJoin::countryRel()->extend(~CKEY: c | $c.ID + 1), {f, c | $f.COUNTRYID == $c.CKEY}).COUNTRYNAME,
    countryThroughFirstHopKey: $src->navigationJoin(meta::relational::tests::mapping::relation::inlineJoin::chainFirmRel()->extend(~CKEY: x | $x.COUNTRYID + 1), {p, f | $p.FIRMID == $f.ID})->navigationJoin(meta::relational::tests::mapping::relation::inlineJoin::countryRel()->extend(~KEY: c | $c.ID + 1), {f, c | $f.CKEY == $c.KEY}).COUNTRYNAME,
    gatedCountryThroughKeys: $src->filterJoin(meta::relational::tests::mapping::relation::inlineJoin::chainFirmRel()->extend(~KEY: x | $x.ID + 1), {p, f | $p.FIRMID == $f.KEY})->navigationJoin(meta::relational::tests::mapping::relation::inlineJoin::countryRel()->extend(~CKEY: c | $c.ID + 1), {p, c | $p.FIRMID == $c.CKEY}).COUNTRYNAME
  }
  *ComputedTargetFirm[computedTargetFirm]: Relation
  {
    ~func meta::relational::tests::mapping::relation::inlineJoin::firmRel():Relation<Any>[1]
    id: ID,
    legalName: LEGALNAME,
    keyPlus: $row.ID + 1,
    keyIf: if($row.ID > 0, | $row.ID, | 0)
  }
)

###Pure
import meta::relational::tests::mapping::relation::inlineJoin::*;
import meta::relational::tests::mapping::relation::inlineJoin::computedTarget::*;
import meta::pure::metamodel::relation::*;
import meta::pure::executionPlan::*;
import meta::relational::metamodel::execute::*;
import meta::relational::functions::asserts::*;

function <<access.private>> meta::relational::tests::mapping::relation::inlineJoin::computedTarget::computedTargetSql(query:FunctionDefinition<Any>[1]):String[1]
{
  executionPlan($query, ComputedTargetJoinMapping, meta::external::store::relational::tests::testRuntime(JoinDB), meta::relational::extension::relationalExtensions())
    .rootExecutionNode.executionNodes->at(0)->cast(@meta::relational::mapping::SQLExecutionNode).sqlQuery;
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::computedTarget::testExtendedTargetKeyReadsTheExposedColumnInTheJoinCondition():Boolean[1]
{
  assertSameSQL(
    'select "persontable_0".FIRSTNAME as "firstName", "firmtable_0".LEGALNAME as "v" from (select "persontable_1".ID as ID, "persontable_1".FIRSTNAME as FIRSTNAME, "persontable_1".FIRMID as FIRMID from PersonTable as "persontable_1") as "persontable_0" left outer join (select "firmtable_1".ID as ID, "firmtable_1".LEGALNAME as LEGALNAME, "firmtable_1".ID + 1 as "KEY" from FirmTable as "firmtable_1") as "firmtable_0" on ("persontable_0".FIRMID = "firmtable_0".KEY)',
    computedTargetSql({|ComputedTargetPerson.all()->project([p | $p.firstName, p | $p.extendedTargetKey], ['firstName', 'v'])})
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::computedTarget::testConditionalTargetKeyReadsTheExposedColumnInTheJoinCondition():Boolean[1]
{
  assertSameSQL(
    'select "persontable_0".FIRSTNAME as "firstName", "firmtable_0".LEGALNAME as "v" from (select "persontable_1".ID as ID, "persontable_1".FIRSTNAME as FIRSTNAME, "persontable_1".FIRMID as FIRMID from PersonTable as "persontable_1") as "persontable_0" left outer join (select "firmtable_1".ID as ID, "firmtable_1".LEGALNAME as LEGALNAME, case when "firmtable_1".ID > 0 then "firmtable_1".ID else "firmtable_1".ID * 2 end as "KEY" from FirmTable as "firmtable_1") as "firmtable_0" on ("persontable_0".FIRMID = "firmtable_0".KEY)',
    computedTargetSql({|ComputedTargetPerson.all()->project([p | $p.firstName, p | $p.conditionalTargetKey], ['firstName', 'v'])})
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::computedTarget::testEmptyBranchTargetKeyReadsTheExposedColumnInTheJoinCondition():Boolean[1]
{
  assertSameSQL(
    'select "persontable_0".FIRSTNAME as "firstName", "firmtable_0".LEGALNAME as "v" from (select "persontable_1".ID as ID, "persontable_1".FIRSTNAME as FIRSTNAME, "persontable_1".FIRMID as FIRMID from PersonTable as "persontable_1") as "persontable_0" left outer join (select "firmtable_1".ID as ID, "firmtable_1".LEGALNAME as LEGALNAME, case when "firmtable_1".ID > 0 then "firmtable_1".ID else null end as "KEY" from FirmTable as "firmtable_1") as "firmtable_0" on ("persontable_0".FIRMID = "firmtable_0".KEY)',
    computedTargetSql({|ComputedTargetPerson.all()->project([p | $p.firstName, p | $p.emptyBranchTargetKey], ['firstName', 'v'])})
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::computedTarget::testTextTargetKeyReadsTheExposedColumnInTheJoinCondition():Boolean[1]
{
  assertSameSQL(
    'select "persontable_0".FIRSTNAME as "firstName", "firmtable_0".LEGALNAME as "v" from (select "persontable_1".ID as ID, "persontable_1".FIRSTNAME as FIRSTNAME, "persontable_1".FIRMID as FIRMID from PersonTable as "persontable_1") as "persontable_0" left outer join (select "firmtable_1".ID as ID, "firmtable_1".LEGALNAME as LEGALNAME, concat("firmtable_1".LEGALNAME, \'x\') as "KEY" from FirmTable as "firmtable_1") as "firmtable_0" on ("persontable_0".FIRSTNAME = "firmtable_0".KEY)',
    computedTargetSql({|ComputedTargetPerson.all()->project([p | $p.firstName, p | $p.textTargetKey], ['firstName', 'v'])})
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::computedTarget::testMixedCaseTargetKeyReadsTheExposedColumnInTheJoinCondition():Boolean[1]
{
  assertSameSQL(
    'select "persontable_0".FIRSTNAME as "firstName", "firmtable_0".LEGALNAME as "v" from (select "persontable_1".ID as ID, "persontable_1".FIRSTNAME as FIRSTNAME, "persontable_1".FIRMID as FIRMID from PersonTable as "persontable_1") as "persontable_0" left outer join (select "firmtable_1".ID as ID, "firmtable_1".LEGALNAME as LEGALNAME, "firmtable_1".ID + 1 as "firmKey" from FirmTable as "firmtable_1") as "firmtable_0" on ("persontable_0".FIRMID = "firmtable_0"."firmKey")',
    computedTargetSql({|ComputedTargetPerson.all()->project([p | $p.firstName, p | $p.mixedCaseTargetKey], ['firstName', 'v'])})
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::computedTarget::testStackedExtendTargetKeyReadsTheExposedColumnInTheJoinCondition():Boolean[1]
{
  assertSameSQL(
    'select "persontable_0".FIRSTNAME as "firstName", "firmtable_0".LEGALNAME as "v" from (select "persontable_1".ID as ID, "persontable_1".FIRSTNAME as FIRSTNAME, "persontable_1".FIRMID as FIRMID from PersonTable as "persontable_1") as "persontable_0" left outer join (select "firmtable_1".ID as ID, "firmtable_1".LEGALNAME as LEGALNAME, "firmtable_1".ID + 1 as "KEY", "firmtable_1".ID + 1 + 1 as "KEY2" from FirmTable as "firmtable_1") as "firmtable_0" on ("persontable_0".FIRMID = "firmtable_0".KEY2)',
    computedTargetSql({|ComputedTargetPerson.all()->project([p | $p.firstName, p | $p.stackedExtendTargetKey], ['firstName', 'v'])})
  );
}

