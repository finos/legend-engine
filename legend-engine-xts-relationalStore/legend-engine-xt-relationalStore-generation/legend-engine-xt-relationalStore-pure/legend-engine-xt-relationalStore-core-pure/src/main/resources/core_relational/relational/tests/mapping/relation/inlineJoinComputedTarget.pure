function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::computedTarget::testGatedCountryThroughKeysReadsTheExposedColumnInTheJoinCondition():Boolean[1]
{
  assertSameSQL(
    'select "persontable_0".FIRSTNAME as "firstName", "persontable_2".COUNTRYNAME as "v" from (select "persontable_1".ID as ID, "persontable_1".FIRSTNAME as FIRSTNAME, "persontable_1".FIRMID as FIRMID from PersonTable as "persontable_1") as "persontable_0" left outer join (select "persontable_3".ID as relJoinKey_ID, "countrytable_0".ID as "ID", "countrytable_0".COUNTRYNAME as "COUNTRYNAME", "countrytable_0".CKEY as "CKEY" from (select "persontable_4".ID as ID, "persontable_4".FIRSTNAME as FIRSTNAME, "persontable_4".FIRMID as FIRMID from PersonTable as "persontable_4") as "persontable_3" inner join (select "chainfirmtable_1".ID as ID, "chainfirmtable_1".LEGALNAME as LEGALNAME, "chainfirmtable_1".COUNTRYID as COUNTRYID, "chainfirmtable_1".ID + 1 as "KEY" from ChainFirmTable as "chainfirmtable_1") as "chainfirmtable_0" on ("persontable_3".FIRMID = "chainfirmtable_0".KEY) left outer join (select "countrytable_1".ID as ID, "countrytable_1".COUNTRYNAME as COUNTRYNAME, "countrytable_1".ID + 1 as "CKEY" from CountryTable as "countrytable_1") as "countrytable_0" on ("persontable_3".FIRMID = "countrytable_0".CKEY)) as "persontable_2" on ("persontable_0".ID is not distinct from "persontable_2".relJoinKey_ID)',
    computedTargetSql({|ComputedTargetPerson.all()->project([p | $p.firstName, p | $p.gatedCountryThroughKeys], ['firstName', 'v'])})
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::computedTarget::testModelJoinOnAComputedTargetPropertyComparesTheExpression():Boolean[1]
{
  assertSameSQL(
    'select "persontable_0".FIRSTNAME as "firstName", "firmtable_0"."LEGALNAME" as "v" from (select "persontable_1".ID as ID, "persontable_1".FIRSTNAME as FIRSTNAME, "persontable_1".FIRMID as FIRMID from PersonTable as "persontable_1") as "persontable_0" left outer join (select "firmtable_1".ID as "ID", "firmtable_1".LEGALNAME as "LEGALNAME" from (select "firmtable_2".ID as ID, "firmtable_2".LEGALNAME as LEGALNAME from FirmTable as "firmtable_2") as "firmtable_1") as "firmtable_0" on ("persontable_0"."FIRMID" is not distinct from "firmtable_0"."ID" + 1)',
    computedTargetSql({|ComputedTargetPerson.all()->project([p | $p.firstName, p | $p.firmRef.legalName], ['firstName', 'v'])})
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::computedTarget::testModelJoinOnAConditionalTargetPropertyComparesTheExpression():Boolean[1]
{
  assertSameSQL(
    'select "persontable_0".FIRSTNAME as "firstName", "firmtable_0"."LEGALNAME" as "v" from (select "persontable_1".ID as ID, "persontable_1".FIRSTNAME as FIRSTNAME, "persontable_1".FIRMID as FIRMID from PersonTable as "persontable_1") as "persontable_0" left outer join (select "firmtable_1".ID as "ID", "firmtable_1".LEGALNAME as "LEGALNAME" from (select "firmtable_2".ID as ID, "firmtable_2".LEGALNAME as LEGALNAME from FirmTable as "firmtable_2") as "firmtable_1") as "firmtable_0" on ("persontable_0"."FIRMID" is not distinct from case when "firmtable_0"."ID" > 0 then "firmtable_0"."ID" else 0 end)',
    computedTargetSql({|ComputedTargetPerson.all()->project([p | $p.firstName, p | $p.firmRefByCondition.legalName], ['firstName', 'v'])})
  );
}
