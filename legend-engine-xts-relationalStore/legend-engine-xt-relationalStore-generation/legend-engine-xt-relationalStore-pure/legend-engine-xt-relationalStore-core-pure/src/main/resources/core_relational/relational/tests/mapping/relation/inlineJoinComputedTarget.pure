{
  assertSameSQL(
    'select "persontable_0".FIRSTNAME as "firstName", "firmtable_0".LEGALNAME as "v" from (select "persontable_1".ID as ID, "persontable_1".FIRSTNAME as FIRSTNAME, "persontable_1".FIRMID as FIRMID from PersonTable as "persontable_1") as "persontable_0" left outer join (select "firmtable_1".ID + 1 as "KEY", "firmtable_1".LEGALNAME as LEGALNAME from FirmTable as "firmtable_1") as "firmtable_0" on ("persontable_0".FIRMID = "firmtable_0".KEY)',
    computedTargetSql({|ComputedTargetPerson.all()->project([p | $p.firstName, p | $p.selectedTargetKey], ['firstName', 'v'])})
