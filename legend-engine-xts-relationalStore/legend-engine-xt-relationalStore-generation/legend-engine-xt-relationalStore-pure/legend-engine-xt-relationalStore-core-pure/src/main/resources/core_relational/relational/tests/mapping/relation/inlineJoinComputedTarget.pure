function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::computedTarget::testFilteredTargetKeyReadsTheExposedColumnInTheJoinCondition():Boolean[1]
{
  assertSameSQL(
    'select "persontable_0".FIRSTNAME as "firstName", "firmtable_0".LEGALNAME as "v" from (select "persontable_1".ID as ID, "persontable_1".FIRSTNAME as FIRSTNAME, "persontable_1".FIRMID as FIRMID from PersonTable as "persontable_1") as "persontable_0" left outer join (select "firmtable_1".ID as ID, "firmtable_1".LEGALNAME as LEGALNAME, "firmtable_1".ID + 1 as "KEY" from FirmTable as "firmtable_1" where "firmtable_1".ID + 1 > 1) as "firmtable_0" on ("persontable_0".FIRMID = "firmtable_0".KEY)',
    computedTargetSql({|ComputedTargetPerson.all()->project([p | $p.firstName, p | $p.filteredTargetKey], ['firstName', 'v'])})
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::computedTarget::testProjectedTargetKeyReadsTheExposedColumnInTheJoinCondition():Boolean[1]
{
  assertSameSQL(
    'select "persontable_0".FIRSTNAME as "firstName", "firmtable_0".KEY as "v" from (select "persontable_1".ID as ID, "persontable_1".FIRSTNAME as FIRSTNAME, "persontable_1".FIRMID as FIRMID from PersonTable as "persontable_1") as "persontable_0" left outer join (select "firmtable_1".ID as ID, "firmtable_1".LEGALNAME as LEGALNAME, "firmtable_1".ID + 1 as "KEY" from FirmTable as "firmtable_1") as "firmtable_0" on ("persontable_0".FIRMID = "firmtable_0".KEY)',
    computedTargetSql({|ComputedTargetPerson.all()->project([p | $p.firstName, p | $p.projectedTargetKey], ['firstName', 'v'])})
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::computedTarget::testGatedByTargetKeyReadsTheExposedColumnInTheJoinCondition():Boolean[1]
{
  assertSameSQL(
    'select "persontable_0".FIRSTNAME as "firstName", "persontable_2".FIRSTNAME as "v" from (select "persontable_1".ID as ID, "persontable_1".FIRSTNAME as FIRSTNAME, "persontable_1".FIRMID as FIRMID from PersonTable as "persontable_1") as "persontable_0" left outer join (select "persontable_3".ID as relJoinKey_ID, "persontable_3".ID as "ID", "persontable_3".FIRSTNAME as "FIRSTNAME", "persontable_3".FIRMID as "FIRMID" from (select "persontable_4".ID as ID, "persontable_4".FIRSTNAME as FIRSTNAME, "persontable_4".FIRMID as FIRMID from PersonTable as "persontable_4") as "persontable_3" inner join (select "firmtable_1".ID as ID, "firmtable_1".LEGALNAME as LEGALNAME, "firmtable_1".ID + 1 as "KEY" from FirmTable as "firmtable_1") as "firmtable_0" on ("persontable_3".FIRMID = "firmtable_0".KEY)) as "persontable_2" on ("persontable_0".ID is not distinct from "persontable_2".relJoinKey_ID)',
    computedTargetSql({|ComputedTargetPerson.all()->project([p | $p.firstName, p | $p.gatedByTargetKey], ['firstName', 'v'])})
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::computedTarget::testCountryOfExtendedFirmKeyReadsTheExposedColumnInTheJoinCondition():Boolean[1]
{
  assertSameSQL(
    'select "persontable_0".FIRSTNAME as "firstName", "persontable_2".COUNTRYNAME as "v" from (select "persontable_1".ID as ID, "persontable_1".FIRSTNAME as FIRSTNAME, "persontable_1".FIRMID as FIRMID from PersonTable as "persontable_1") as "persontable_0" left outer join (select "persontable_3".ID as relJoinKey_ID, "countrytable_0".ID as "ID", "countrytable_0".COUNTRYNAME as "COUNTRYNAME" from (select "persontable_4".ID as ID, "persontable_4".FIRSTNAME as FIRSTNAME, "persontable_4".FIRMID as FIRMID from PersonTable as "persontable_4") as "persontable_3" left outer join (select "chainfirmtable_1".ID as ID, "chainfirmtable_1".LEGALNAME as LEGALNAME, "chainfirmtable_1".COUNTRYID as COUNTRYID, "chainfirmtable_1".ID + 1 as "KEY" from ChainFirmTable as "chainfirmtable_1") as "chainfirmtable_0" on ("persontable_3".FIRMID = "chainfirmtable_0".KEY) left outer join (select "countrytable_1".ID as ID, "countrytable_1".COUNTRYNAME as COUNTRYNAME from CountryTable as "countrytable_1") as "countrytable_0" on ("chainfirmtable_0".COUNTRYID = "countrytable_0".ID)) as "persontable_2" on ("persontable_0".ID is not distinct from "persontable_2".relJoinKey_ID)',
    computedTargetSql({|ComputedTargetPerson.all()->project([p | $p.firstName, p | $p.countryOfExtendedFirmKey], ['firstName', 'v'])})
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::computedTarget::testExtendedCountryKeyOfFirmReadsTheExposedColumnInTheJoinCondition():Boolean[1]
{
  assertSameSQL(
    'select "persontable_0".FIRSTNAME as "firstName", "persontable_2".COUNTRYNAME as "v" from (select "persontable_1".ID as ID, "persontable_1".FIRSTNAME as FIRSTNAME, "persontable_1".FIRMID as FIRMID from PersonTable as "persontable_1") as "persontable_0" left outer join (select "persontable_3".ID as relJoinKey_ID, "countrytable_0".ID as "ID", "countrytable_0".COUNTRYNAME as "COUNTRYNAME", "countrytable_0".KEY as "KEY" from (select "persontable_4".ID as ID, "persontable_4".FIRSTNAME as FIRSTNAME, "persontable_4".FIRMID as FIRMID from PersonTable as "persontable_4") as "persontable_3" left outer join (select "chainfirmtable_1".ID as ID, "chainfirmtable_1".LEGALNAME as LEGALNAME, "chainfirmtable_1".COUNTRYID as COUNTRYID from ChainFirmTable as "chainfirmtable_1") as "chainfirmtable_0" on ("persontable_3".FIRMID = "chainfirmtable_0".ID) left outer join (select "countrytable_1".ID as ID, "countrytable_1".COUNTRYNAME as COUNTRYNAME, "countrytable_1".ID + 1 as "KEY" from CountryTable as "countrytable_1") as "countrytable_0" on ("chainfirmtable_0".COUNTRYID = "countrytable_0".KEY)) as "persontable_2" on ("persontable_0".ID is not distinct from "persontable_2".relJoinKey_ID)',
    computedTargetSql({|ComputedTargetPerson.all()->project([p | $p.firstName, p | $p.extendedCountryKeyOfFirm], ['firstName', 'v'])})
  );
}

