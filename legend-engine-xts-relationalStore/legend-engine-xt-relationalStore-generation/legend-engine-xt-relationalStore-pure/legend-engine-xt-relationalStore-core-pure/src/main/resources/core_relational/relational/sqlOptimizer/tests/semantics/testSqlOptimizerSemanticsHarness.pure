###Relational
Database meta::relational::tests::sqlOptimizer::semantics::SemanticsDb
(
  Schema SQLOPT
  (
    Table SQLOPT_T (ID INTEGER PRIMARY KEY, G VARCHAR(10), V INTEGER, W INTEGER)
    Table SQLOPT_U (ID INTEGER PRIMARY KEY, TID INTEGER, X INTEGER, G VARCHAR(10))
    View SQLOPT_UMAX
    (
      ~groupBy (SQLOPT.SQLOPT_U.TID)
      TID : SQLOPT.SQLOPT_U.TID,
      MAXX : max(SQLOPT.SQLOPT_U.X)
    )
  )
  Join TtoU(SQLOPT.SQLOPT_T.ID = SQLOPT.SQLOPT_U.TID)
  Join TgToUx(SQLOPT.SQLOPT_T.G = SQLOPT.SQLOPT_U.X)
  Join TgToUg(SQLOPT.SQLOPT_T.G = SQLOPT.SQLOPT_U.G)
  Join TtoUMax(SQLOPT.SQLOPT_T.ID = SQLOPT.SQLOPT_UMAX.TID)
)

###Pure
import meta::relational::tests::sqlOptimizer::semantics::*;

Class meta::relational::tests::sqlOptimizer::semantics::T
{
  id: Integer[0..1];
  g: String[0..1];
  v: Integer[0..1];
  w: Integer[0..1];
  maxX: Integer[0..1];
  uWithId(id:Integer[1]) {$this.us->filter(u | $u.id == $id)->toOne()}:U[1];
}

Class meta::relational::tests::sqlOptimizer::semantics::U
{
  id: Integer[0..1];
  tid: Integer[0..1];
  x: Integer[0..1];
  g: String[0..1];
}

Association meta::relational::tests::sqlOptimizer::semantics::TtoU
{
  t: T[0..1];
  us: U[*];
}

Association meta::relational::tests::sqlOptimizer::semantics::TgToUx
{
  tsByX: T[*];
  usByX: U[*];
}

Association meta::relational::tests::sqlOptimizer::semantics::TgToUg
{
  tsByG: T[*];
  usByG: U[*];
}

Class meta::relational::tests::sqlOptimizer::semantics::Item
{
  id: Integer[0..1];
  grp: String[0..1];
  v: Integer[0..1];
  one: Integer[1];
  k: String[1];
  five: Integer[1];
}

function meta::relational::tests::sqlOptimizer::semantics::itemRelation():meta::pure::metamodel::relation::Relation<Any>[1]
{
  #>{meta::relational::tests::sqlOptimizer::semantics::SemanticsDb.SQLOPT.SQLOPT_T}#->extend(~[ONE: x | 1, KK: x | 'k', FIVE: x | 5])
}

###Mapping
import meta::relational::tests::sqlOptimizer::semantics::*;

Mapping meta::relational::tests::sqlOptimizer::semantics::SemanticsMapping
(
  T: Relational
  {
    id: [SemanticsDb]SQLOPT.SQLOPT_T.ID,
    g: [SemanticsDb]SQLOPT.SQLOPT_T.G,
    v: [SemanticsDb]SQLOPT.SQLOPT_T.V,
    w: [SemanticsDb]SQLOPT.SQLOPT_T.W,
    maxX: [SemanticsDb]@TtoUMax | SQLOPT.SQLOPT_UMAX.MAXX
  }
  U: Relational
  {
    id: [SemanticsDb]SQLOPT.SQLOPT_U.ID,
    tid: [SemanticsDb]SQLOPT.SQLOPT_U.TID,
    x: [SemanticsDb]SQLOPT.SQLOPT_U.X,
    g: [SemanticsDb]SQLOPT.SQLOPT_U.G
  }
  TtoU: Relational { AssociationMapping ( t: [SemanticsDb]@TtoU, us: [SemanticsDb]@TtoU ) }
  TgToUx: Relational { AssociationMapping ( tsByX: [SemanticsDb]@TgToUx, usByX: [SemanticsDb]@TgToUx ) }
  TgToUg: Relational { AssociationMapping ( tsByG: [SemanticsDb]@TgToUg, usByG: [SemanticsDb]@TgToUg ) }
)

Mapping meta::relational::tests::sqlOptimizer::semantics::ItemMapping
(
  *Item: Relation
  {
    ~func meta::relational::tests::sqlOptimizer::semantics::itemRelation():Relation<Any>[1]
    id: ID,
    grp: G,
    v: V,
    one: ONE,
    k: KK,
    five: FIVE
  }
)

