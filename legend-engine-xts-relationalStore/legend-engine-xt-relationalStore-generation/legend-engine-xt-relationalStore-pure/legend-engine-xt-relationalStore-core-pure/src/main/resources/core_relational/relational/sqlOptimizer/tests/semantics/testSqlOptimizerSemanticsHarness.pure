function meta::relational::tests::sqlOptimizer::semantics::root(alias:TableAlias[1], joins:JoinTreeNode[*]):RootJoinTreeNode[1]
{
  ^RootJoinTreeNode(alias = $alias, childrenData = $joins)
}

function meta::relational::tests::sqlOptimizer::semantics::joined(parent:TableAlias[1], alias:TableAlias[1], condition:RelationalOperationElement[1], joinType:JoinType[1]):JoinTreeNode[1]
{
  ^JoinTreeNode(alias = $alias, database = SemanticsDb, joinName = 'j_' + $alias.name, joinType = $joinType,
                join = ^Join(name = 'j_' + $alias.name, target = $alias, aliases = [pair($parent, $alias), pair($alias, $parent)], operation = $condition->cast(@meta::relational::metamodel::operation::Operation)))
}

function meta::relational::tests::sqlOptimizer::semantics::lateral(parent:TableAlias[1], alias:TableAlias[1]):JoinTreeNode[1]
{
  let node = joined($parent, $alias, sqlEquals(lit(1), lit(1)), JoinType.INNER);
  ^$node(lateral = true);
}

function meta::relational::tests::sqlOptimizer::semantics::sel(columns:RelationalOperationElement[*], data:RootJoinTreeNode[1]):SelectSQLQuery[1]
{
  ^SelectSQLQuery(columns = $columns, data = $data)
}

function meta::relational::tests::sqlOptimizer::semantics::unionAll(name:String[1], branches:SelectSQLQuery[*]):TableAlias[1]
{
  tableAlias($name, ^UnionAll(queries = $branches))
}

function meta::relational::tests::sqlOptimizer::semantics::orderAsc(element:RelationalOperationElement[1]):OrderBy[1]
{
  ^OrderBy(column = $element, direction = meta::relational::metamodel::SortDirection.ASC)
}

function meta::relational::tests::sqlOptimizer::semantics::orderDesc(element:RelationalOperationElement[1]):OrderBy[1]
{
  ^OrderBy(column = $element, direction = meta::relational::metamodel::SortDirection.DESC)
}

function meta::relational::tests::sqlOptimizer::semantics::subSelects(query:SelectSQLQuery[1]):SelectSQLQuery[*]
{
  $query->extractRelationalElements(true).elements->filter(e | $e->instanceOf(SelectSQLQuery))->cast(@SelectSQLQuery)->filter(s | !is($s, $query))
}

###Pure
import meta::pure::functions::relation::*;
import meta::pure::tds::*;
import meta::relational::tests::sqlOptimizer::semantics::*;

function meta::relational::tests::sqlOptimizer::semantics::lateralOverALimitedRelation():FunctionDefinition<{->Any[*]}>[1]
{
  {|#>{meta::relational::tests::sqlOptimizer::semantics::SemanticsDb.SQLOPT.SQLOPT_T}#->select(~[ID, G, V])->limit(100)->lateral(r | #>{meta::relational::tests::sqlOptimizer::semantics::SemanticsDb.SQLOPT.SQLOPT_U}#->filter(u | $u.TID == $r.V)->select(~[X]))->select(~[G, X])}
}

function meta::relational::tests::sqlOptimizer::semantics::lateralOverARenamedRelation():FunctionDefinition<{->Any[*]}>[1]
{
  {|#>{meta::relational::tests::sqlOptimizer::semantics::SemanticsDb.SQLOPT.SQLOPT_T}#->rename(~V, ~vv)->lateral(r | #>{meta::relational::tests::sqlOptimizer::semantics::SemanticsDb.SQLOPT.SQLOPT_U}#->filter(u | $u.TID == $r.vv)->select(~[X]))->select(~[G, X])}
}

function meta::relational::tests::sqlOptimizer::semantics::itemsSortedByTheStringLiteralProperty():FunctionDefinition<{->Any[*]}>[1]
{
  {|Item.all()->sortBy(i | $i.k)->project([col(i | $i.grp, 'g'), col(i | $i.id, 'id')])}
}

function meta::relational::tests::sqlOptimizer::semantics::itemsSortedByTheIntegerLiteralProperty():FunctionDefinition<{->Any[*]}>[1]
{
  {|Item.all()->sortBy(i | $i.five)->project([col(i | $i.grp, 'g'), col(i | $i.id, 'id')])}
}

function meta::relational::tests::sqlOptimizer::semantics::startsWithAcrossAVarcharToIntegerJoin():FunctionDefinition<{->Any[*]}>[1]
{
  {|T.all()->filter(t | $t.g->startsWith('0'))->project([t | $t.id, t | $t.g, t | $t.usByX.id], ['id', 'g', 'uid'])}
}
