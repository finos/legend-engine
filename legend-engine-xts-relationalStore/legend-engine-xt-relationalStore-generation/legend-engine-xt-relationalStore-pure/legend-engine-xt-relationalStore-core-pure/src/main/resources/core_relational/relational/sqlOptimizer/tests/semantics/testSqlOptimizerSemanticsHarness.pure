function meta::relational::tests::sqlOptimizer::semantics::ruleSets(dbType:DatabaseType[1]):Pair<String, List<SqlOptimizationRule>>[*]
{
  [
    pair('trimming', list(trimming())),
    pair('elimination', list(elimination())),
    pair('pushDown', list(pushDown())),
    pair('all rules', list(defaultSqlOptimizationRules()->filter(r | $r.enabledByAll)))
  ]->map(rs | pair($rs.first, list($rs.second.values->filter(r | $r->isSupportedOn($dbType)))))
   ->filter(rs | $rs.second.values->isNotEmpty())
}

