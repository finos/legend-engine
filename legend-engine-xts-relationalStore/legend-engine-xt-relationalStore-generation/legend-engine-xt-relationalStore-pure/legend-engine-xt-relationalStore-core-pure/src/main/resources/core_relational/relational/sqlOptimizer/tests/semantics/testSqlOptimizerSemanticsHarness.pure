function meta::relational::tests::sqlOptimizer::semantics::dataVariants():String[*]
{
  ['nullsAndDuplicates', 'empty', 'ties', 'allNull']
}

function meta::relational::tests::sqlOptimizer::semantics::rowsOf(variant:String[1]):Pair<String,String>[*]
{
  if($variant == 'nullsAndDuplicates',
    | [pair('T', '1,a,1,10\n1,a,1,10\n2,a,,20\n3,,3,\n4,b,4,40\n5,b,,\n6,B,4,5'),
       pair('U', '1,1,100,a\n2,1,100,a\n3,2,,\n4,,7,b\n5,9,9,z\n5,9,9,z\n6,4,4,b')],
    | if($variant == 'ties',
        | [pair('T', '1,a,1,1\n2,a,1,1\n3,a,1,2\n4,b,1,1'),
           pair('U', '1,1,1,a\n2,3,1,a')],
        | if($variant == 'allNull',
            | [pair('T', ',,,'), pair('U', ',,,')],
            | if($variant == 'numericStrings',
                | [pair('T', '1,7,1,1\n2,12,2,2\n3,x,3,3\n4,,4,4'),
                   pair('U', '1,1,1,7')],
                | if($variant == 'coercibleStrings',
                    | [pair('T', '1,01,1,1\n2,1,1,1\n3,001,1,1'),
                       pair('U', '10,0,1,u\n11,0,2,u')],
                    | []
                  )
              )
          )
      )
  )
}

function meta::relational::tests::sqlOptimizer::semantics::tableData(fixture:Fixture[1], variant:String[1]):Pair<Table,String>[*]
{
  let rows = rowsOf($variant);
  [
    pair($fixture.t, $rows->filter(r | $r.first == 'T').second->joinStrings('')),
    pair($fixture.u, $rows->filter(r | $r.first == 'U').second->joinStrings(''))
  ];
}

function meta::relational::tests::sqlOptimizer::semantics::csvBlock(table:Table[1], rows:String[1]):String[1]
{
  $table.schema.name + '\n' + $table.name + '\n' + $table.columns->cast(@Column).name->joinStrings(',') + if($rows == '', | '', | '\n' + $rows) + '\n'
}

function meta::relational::tests::sqlOptimizer::semantics::unconstrainedDatabase(tables:Table[*]):Database[1]
{
  ^Database(name = 'SqlOptimizerTestData', package = meta::relational::tests::sqlOptimizer::semantics,
            schemas = ^Schema(name = $tables.schema.name->distinct()->toOne(), database = ^Database(name = 'SqlOptimizerTestData'), tables = $tables->map(t | ^$t(primaryKey = [], columns = $t.columns->cast(@Column)->map(c | ^$c(nullable = true))))))
}

function meta::relational::tests::sqlOptimizer::semantics::setUpNodes(connection:DatabaseConnection[1], data:Pair<Table,String>[*]):ExecutionNode[1]
{
  let database = unconstrainedDatabase($data.first);
  let runtime = ^Runtime(connectionStores = ^ConnectionStore(element = $database, connection = $connection));
  let setupDatabase = 'meta::relational::tests::pct::process::setupDatabase_String_MANY__Database_1__Runtime_1__DebugContext_1__SequenceExecutionNode_1_'
    ->pathToElement()->cast(@Function<{String[*], Database[1], Runtime[1], meta::pure::tools::DebugContext[1]->SequenceExecutionNode[1]}>);
  $setupDatabase->eval($data->map(d | csvBlock($d.first, $d.second)), $database, $runtime, meta::pure::tools::noDebug());
}

function meta::relational::tests::sqlOptimizer::semantics::queryResult(sql:String[1], connection:DatabaseConnection[1], data:Pair<Table,String>[*]):String[*]
{
  let query = ^RelationalTdsInstantiationExecutionNode(
    resultType = ^TDSResultType(genericType = ^GenericType(rawType = meta::pure::tds::TabularDataSet), tdsColumns = []),
    executionNodes = ^SQLExecutionNode(sqlQuery = $sql, resultColumns = [], isResultColumnsDynamic = true, connection = $connection, resultType = ^ResultType(genericType = ^GenericType(rawType = Any)))
  );
  let plan = ^ExecutionPlan(
    func = {|'sqlOptimizerTest'},
    mapping = ^Mapping(package = meta::relational::tests::sqlOptimizer::semantics, name = 'NoMapping'),
    runtime = ^Runtime(connectionStores = ^ConnectionStore(element = SemanticsDb, connection = $connection)),
    rootExecutionNode = ^RelationalBlockExecutionNode(executionNodes = [setUpNodes($connection, $data), $query], resultType = $query.resultType),
    authDependent = false
  );
  let json = $plan->meta::protocols::pure::vX_X_X::transformation::fromPureGraph::executionPlan::transformPlan(meta::relational::extension::relationalExtensions())
                  ->meta::json::toJSON(1000, meta::json::config(false, false, true, true));
  meta::legend::executePlanAsJSON($json, []->cast(@Pair<String, Any>), 'CSV')->split('\n')->map(l | $l->replace('\r', ''))->filter(l | $l->isNotEmpty());
}

function meta::relational::tests::sqlOptimizer::semantics::resultRows(sql:String[1], fixture:Fixture[1], variant:String[1]):String[*]
{
  queryResult($sql, $fixture.connection, $fixture->tableData($variant))
}

