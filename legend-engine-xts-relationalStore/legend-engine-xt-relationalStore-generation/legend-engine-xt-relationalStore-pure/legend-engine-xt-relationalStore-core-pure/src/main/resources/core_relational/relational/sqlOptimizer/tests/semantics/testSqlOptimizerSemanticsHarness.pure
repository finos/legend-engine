function meta::relational::tests::sqlOptimizer::semantics::assertSameRows(fixture:Fixture[1], query:SelectSQLQuery[1], ordered:Boolean[1]):Boolean[1]
{
  assertSameRows($fixture, $query, $ordered, dataVariants())
}

function meta::relational::tests::sqlOptimizer::semantics::assertSameRows(fixture:Fixture[1], query:SelectSQLQuery[1], ordered:Boolean[1], variants:String[*]):Boolean[1]
{
  let dbType = $fixture.connection.type;
  let context = optimizerContext($fixture.connection);
  let candidates = ruleSets($dbType)->map(rs | pair($rs.first, applySqlOptimizationRules($query, $rs.second.values, $context)->printedFor($dbType)));
  assertRulesReturnTheirInputAtTheFixedPoint($query, $context);
  assertSameRows($fixture, $query->printedFor($dbType), $candidates, $ordered, $variants);
}

// The optimizer validates only what a rule changed, so a rule with nothing left to do must hand back the very same query (or a
// rewrite the validator refuses, which the optimizer discards).
function meta::relational::tests::sqlOptimizer::semantics::assertRulesReturnTheirInputAtTheFixedPoint(query:SelectSQLQuery[1], context:SqlOptimizerContext[1]):Boolean[1]
{
  let rules = defaultSqlOptimizationRules()->filter(r | $r.enabledByAll && $r->isSupportedOn($context.dbType));
  let fixedPoint = applySqlOptimizationRules($query, $rules, $context);
  $rules->forAll({r |
    let result = $r.transform->eval($fixedPoint, $context);
    assert(is($result.query, $fixedPoint) || $result->introducesProblems($fixedPoint), | $r.name + ' rebuilt a query it had nothing left to change on ' + $context.dbType->toString() + '\n  ' + $fixedPoint->printedFor($context.dbType));
  });
}

function meta::relational::tests::sqlOptimizer::semantics::assertSameRows(fixture:Fixture[1], before:String[1], candidates:Pair<String,String>[*], ordered:Boolean[1], variants:String[*]):Boolean[1]
{
  let changed = $candidates->filter(c | $c.second != $before);
  assert($changed->isNotEmpty(), | 'no rule changed the query on ' + $fixture.connection.type->toString() + ', so its rows were never compared; use assertUnchanged if that is the intent\n  ' + $before);
  $variants->map({variant |
    let expected = $before->resultRows($fixture, $variant);
    $changed->map({c |
      let actual = $c.second->resultRows($fixture, $variant);
      assertEquals($expected->sameRowsForm($ordered), $actual->sameRowsForm($ordered),
        | $c.first + ' changed the result on ' + $variant + ' data (' + $fixture.connection.type->toString() + ')\n  before: ' + $before + '\n  after:  ' + $c.second);
    });
  });
  true;
}

function meta::relational::tests::sqlOptimizer::semantics::sameRowsForm(table:String[*], ordered:Boolean[1]):String[*]
{
  if($ordered || $table->isEmpty(), | $table, | $table->head()->concatenate($table->tail()->sort()))
}

function meta::relational::tests::sqlOptimizer::semantics::legacyH2ResultRows(sql:String[1], connection:DatabaseConnection[1]):String[*]
{
  executeInDb($sql, $connection).rows->map(r | $r.values->map(v | $v->match([n:SQLNull[1] | 'NULL', a:Any[1] | $a->toString()]))->joinStrings('|'))
}

function meta::relational::tests::sqlOptimizer::semantics::semanticsRuntime(connection:DatabaseConnection[1]):Runtime[1]
{
  ^Runtime(connectionStores = ^ConnectionStore(element = SemanticsDb, connection = $connection))
}

function meta::relational::tests::sqlOptimizer::semantics::planNode(query:FunctionDefinition<{->Any[*]}>[1], mapping:Mapping[1], runtime:Runtime[1], enabled:String[*], disabled:String[*]):SQLExecutionNode[1]
{
  let plan = meta::pure::executionPlan::executionPlan($query, $mapping, $runtime->withGenerationFeatures($enabled, $disabled), meta::relational::extension::relationalExtensions());
  $plan.rootExecutionNode->meta::pure::executionPlan::allNodes(meta::relational::extension::relationalExtensions())->filter(n | $n->instanceOf(SQLExecutionNode))->cast(@SQLExecutionNode)->filter(n | $n.sqlQuery->toLower()->trim()->startsWith('select') || $n.sqlQuery->toLower()->trim()->startsWith('with'))->toOne();
}

function meta::relational::tests::sqlOptimizer::semantics::planSql(query:FunctionDefinition<{->Any[*]}>[1], mapping:Mapping[1], connection:DatabaseConnection[1], enabled:String[*], disabled:String[*]):String[1]
{
  planNode($query, $mapping, semanticsRuntime($connection), $enabled, $disabled).sqlQuery
}

function meta::relational::tests::sqlOptimizer::semantics::unoptimizedPlanSql(query:FunctionDefinition<{->Any[*]}>[1], mapping:Mapping[1], connection:DatabaseConnection[1]):String[1]
{
  planSql($query, $mapping, $connection, [], 'SQL_OPTIMIZATION_ALL')
}

function meta::relational::tests::sqlOptimizer::semantics::featureSets():Pair<String, List<String>>[*]
{
  [
    pair('default features', list([]->cast(@String))),
    pair('SQL_OPTIMIZATION_UNUSED_COLUMN_TRIMMING', list('SQL_OPTIMIZATION_UNUSED_COLUMN_TRIMMING')),
    pair('SQL_OPTIMIZATION_REDUNDANT_SUB_SELECT_ELIMINATION', list('SQL_OPTIMIZATION_REDUNDANT_SUB_SELECT_ELIMINATION')),
    pair('SQL_OPTIMIZATION_ALL', list('SQL_OPTIMIZATION_ALL'))
  ]
}

function meta::relational::tests::sqlOptimizer::semantics::optimizedPlanSqls(query:FunctionDefinition<{->Any[*]}>[1], mapping:Mapping[1], connection:DatabaseConnection[1]):Pair<String,String>[*]
{
  featureSets()->map(fs | pair($fs.first, planSql($query, $mapping, $connection, $fs.second.values, [])))
}

function meta::relational::tests::sqlOptimizer::semantics::assertSameRowsWithEveryFeature(query:FunctionDefinition<{->Any[*]}>[1], mapping:Mapping[1], connection:Connection[1], ordered:Boolean[1], variants:String[*]):Boolean[1]
{
  let fixture = sharedFixture($connection);
  assertSameRows($fixture, unoptimizedPlanSql($query, $mapping, $fixture.connection), optimizedPlanSqls($query, $mapping, $fixture.connection), $ordered, $variants);
}

function meta::relational::tests::sqlOptimizer::semantics::assertUnchanged(fixture:Fixture[1], query:SelectSQLQuery[1]):Boolean[1]
{
  let dbType = $fixture.connection.type;
  let before = $query->printedFor($dbType);
  ruleSets($dbType)->map(rs | assertEquals($before, applySqlOptimizationRules($query, $rs.second.values, optimizerContext($fixture.connection))->printedFor($dbType), | $rs.first + ' changed the query on ' + $dbType->toString()));
  true;
}

function meta::relational::tests::sqlOptimizer::semantics::assertUnchangedWithEveryFeature(query:FunctionDefinition<{->Any[*]}>[1], mapping:Mapping[1], connection:Connection[1]):Boolean[1]
{
  let fixture = sharedFixture($connection);
  let before = unoptimizedPlanSql($query, $mapping, $fixture.connection);
  optimizedPlanSqls($query, $mapping, $fixture.connection)->map(c | assertEquals($before, $c.second, | $c.first + ' changed the query on ' + $fixture.connection.type->toString()));
  true;
}

function meta::relational::tests::sqlOptimizer::semantics::pushDownFeatures():String[*]
{
  ['SQL_OPTIMIZATION_JOIN_FILTER_PUSH_DOWN', 'SQL_OPTIMIZATION_SUB_QUERY_FILTER_PUSH_DOWN']
}

// With every other rule off, any difference from the unoptimized plan's SQL is the push-down's doing.
function meta::relational::tests::sqlOptimizer::semantics::pushDownSql(query:FunctionDefinition<{->Any[*]}>[1], mapping:Mapping[1], connection:DatabaseConnection[1]):Pair<String,String>[1]
{
  pair(unoptimizedPlanSql($query, $mapping, $connection), planSql($query, $mapping, $connection, pushDownFeatures(), 'SQL_OPTIMIZATION_ALL'))
}

function meta::relational::tests::sqlOptimizer::semantics::assertPushesDown(query:FunctionDefinition<{->Any[*]}>[1], mapping:Mapping[1], connection:Connection[1]):Boolean[1]
{
  let fixture = sharedFixture($connection);
  let sql = pushDownSql($query, $mapping, $fixture.connection);
  assert($sql.first != $sql.second, | 'push-down left the query unchanged on ' + $fixture.connection.type->toString() + '\n  ' + $sql.first);
}

function meta::relational::tests::sqlOptimizer::semantics::assertDoesNotPushDown(query:FunctionDefinition<{->Any[*]}>[1], mapping:Mapping[1], connection:Connection[1]):Boolean[1]
{
  let fixture = sharedFixture($connection);
  let sql = pushDownSql($query, $mapping, $fixture.connection);
  assert($sql.first == $sql.second, | 'push-down changed the query on ' + $fixture.connection.type->toString() + '\n  ' + $sql.second);
}

function meta::relational::tests::sqlOptimizer::semantics::assertSameRowsWithCTEExtraction(query:FunctionDefinition<{->Any[*]}>[1], connection:Connection[1], extractsCTEs:Boolean[1], ordered:Boolean[1]):String[1]
{
  let fixture = sharedFixture($connection);
  let extracted = planSql($query, SemanticsMapping, $fixture.connection, ['SQL_OPTIMIZATION_ALL', 'SQL_OPTIMIZATION_EXTRACT_SUB_QUERIES_AS_CTES'], []);
  assertEquals($extractsCTEs, $extracted->toLower()->trim()->startsWith('with '), | 'CTE extraction on ' + $fixture.connection.type->toString() + ': ' + $extracted);
  let before = unoptimizedPlanSql($query, SemanticsMapping, $fixture.connection);
  if($extracted == $before && !$extractsCTEs, | true, | assertSameRows($fixture, $before, pair('SQL_OPTIMIZATION_ALL with CTE extraction', $extracted), $ordered, dataVariants()));
  $extracted;
}

