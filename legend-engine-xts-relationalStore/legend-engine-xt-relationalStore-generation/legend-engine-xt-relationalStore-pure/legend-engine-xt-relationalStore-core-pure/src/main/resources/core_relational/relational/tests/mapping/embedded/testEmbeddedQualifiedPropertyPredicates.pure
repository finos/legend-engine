import meta::relational::tests::mapping::embedded::qualifiedProperty::*;

Class meta::relational::tests::mapping::embedded::qualifiedProperty::Employee
{
  name: String[1];
  dept: Dept[1];
}

Class meta::relational::tests::mapping::embedded::qualifiedProperty::Dept
{
  deptName: String[1];
  office: Office[0..1];
  label() { $this.deptName + '!' }: String[1];
  center() { if($this.label()->isEmpty(), |'none', |$this.label()) }: String[1];
  officeName(d: Date[1]) { $this.office($d).name->toOne() }: String[1];
}

Class <<temporal.businesstemporal>> meta::relational::tests::mapping::embedded::qualifiedProperty::Office
{
  name: String[1];
}

###Relational
Database meta::relational::tests::mapping::embedded::qualifiedProperty::DB
(
  Table EmployeeTable
  (
    id INTEGER PRIMARY KEY,
    name VARCHAR(200),
    deptName VARCHAR(200),
    officeId INTEGER
  )
  Table DeptTable
  (
    deptName VARCHAR(200) PRIMARY KEY
  )
  Table OfficeTable
  (
    milestoning(business(BUS_FROM = from_z, BUS_THRU = thru_z))
    id INTEGER PRIMARY KEY,
    name VARCHAR(200),
    from_z DATE,
    thru_z DATE
  )

  Join Employee_Dept(EmployeeTable.deptName = DeptTable.deptName)
  Join Employee_Office(EmployeeTable.officeId = OfficeTable.id)
)

###Mapping
import meta::relational::tests::mapping::embedded::qualifiedProperty::*;

Mapping meta::relational::tests::mapping::embedded::qualifiedProperty::EmbeddedMapping
(
  *Employee: Relational
  {
    ~mainTable [DB]EmployeeTable
    name: [DB]EmployeeTable.name,
    dept
    (
      deptName: [DB]EmployeeTable.deptName,
      office: [DB]@Employee_Office
    )
  }

  Office: Relational
  {
    ~mainTable [DB]OfficeTable
    name: [DB]OfficeTable.name
  }
)

Mapping meta::relational::tests::mapping::embedded::qualifiedProperty::InlineEmbeddedMapping
(
  *Employee: Relational
  {
    ~mainTable [DB]EmployeeTable
    name: [DB]EmployeeTable.name,
    dept() Inline[deptRoot]
  }

  Dept[deptRoot]: Relational
  {
    deptName: [DB]EmployeeTable.deptName
  }
)

Mapping meta::relational::tests::mapping::embedded::qualifiedProperty::OtherwiseEmbeddedMapping
(
  *Employee: Relational
  {
    ~mainTable [DB]EmployeeTable
    name: [DB]EmployeeTable.name,
    dept
    (
      deptName: [DB]EmployeeTable.deptName
    ) Otherwise([deptRoot]: [DB]@Employee_Dept)
  }

  Dept[deptRoot]: Relational
  {
    deptName: [DB]DeptTable.deptName
  }
)

###Pure
import meta::relational::functions::sqlstring::*;
import meta::relational::tests::mapping::embedded::qualifiedProperty::*;

function meta::relational::tests::mapping::embedded::qualifiedProperty::toH2SQL(query: FunctionDefinition<{->Any[*]}>[1], mapping: meta::pure::mapping::Mapping[1]): String[1]
{
  toSQLString($query, $mapping, meta::relational::runtime::DatabaseType.H2, meta::relational::extension::relationalExtensions());
}

function <<test.Test>> meta::relational::tests::mapping::embedded::qualifiedProperty::testQualifiedPropertyOfEmbeddedClassInIsNotEmpty():Boolean[1]
{
  assertEquals(
    'select "root".name as "n" from EmployeeTable as "root" where concat("root".deptName, \'!\') is not null',
    toH2SQL(|Employee.all()->filter(e | $e.dept.label()->isNotEmpty())->project([e | $e.name], ['n']), EmbeddedMapping)
  );
}

function <<test.Test>> meta::relational::tests::mapping::embedded::qualifiedProperty::testQualifiedPropertyOfEmbeddedClassUsingIsEmptyOnThis():Boolean[1]
{
  assertEquals(
    'select case when concat("root".deptName, \'!\') is null then \'none\' else concat("root".deptName, \'!\') end as "c" from EmployeeTable as "root"',
    toH2SQL(|Employee.all()->project([e | $e.dept.center()], ['c']), EmbeddedMapping)
  );
}

function <<test.Test>> meta::relational::tests::mapping::embedded::qualifiedProperty::testQualifiedPropertyOfInlineEmbeddedClassInIsNotEmpty():Boolean[1]
{
  assertEquals(
    'select "root".name as "n" from EmployeeTable as "root" where concat("root".deptName, \'!\') is not null',
    toH2SQL(|Employee.all()->filter(e | $e.dept.label()->isNotEmpty())->project([e | $e.name], ['n']), InlineEmbeddedMapping)
  );
}

function <<test.Test>> meta::relational::tests::mapping::embedded::qualifiedProperty::testQualifiedPropertyOfOtherwiseEmbeddedClassInIsNotEmpty():Boolean[1]
{
  assertEquals(
    'select "root".name as "n" from EmployeeTable as "root" where concat("root".deptName, \'!\') is not null',
    toH2SQL(|Employee.all()->filter(e | $e.dept.label()->isNotEmpty())->project([e | $e.name], ['n']), OtherwiseEmbeddedMapping)
  );
}

function <<test.Test>> meta::relational::tests::mapping::embedded::qualifiedProperty::testQualifiedPropertyOfEmbeddedClassInSize():Boolean[1]
{
  assertEquals(
    'select count(concat("root".deptName, \'!\')) as "s" from EmployeeTable as "root"',
    toH2SQL(|Employee.all()->project([e | $e.dept.label()->size()], ['s']), EmbeddedMapping)
  );
}

function <<test.Test>> meta::relational::tests::mapping::embedded::qualifiedProperty::testMilestonedPropertyOfEmbeddedClassInIsNotEmpty():Boolean[1]
{
  assertEquals(
    'select "root".name as "n" from EmployeeTable as "root" left outer join OfficeTable as "OfficeTable_d#9_d#2_m1" on ("root".officeId = "OfficeTable_d#9_d#2_m1".id and "OfficeTable_d#9_d#2_m1".from_z <= DATE\'2020-01-01\' and "OfficeTable_d#9_d#2_m1".thru_z > DATE\'2020-01-01\') where "OfficeTable_d#9_d#2_m1".name is not null',
    toH2SQL(|Employee.all()->filter(e | $e.dept.office(%2020-01-01).name->isNotEmpty())->project([e | $e.name], ['n']), EmbeddedMapping)
  );
}

function <<test.Test>> meta::relational::tests::mapping::embedded::qualifiedProperty::testQualifiedPropertyOfEmbeddedClassNavigatingMilestonedPropertyOnThis():Boolean[1]
{
  assertEquals(
    'select "root".name as "n", "OfficeTable_d#9_d_m2".name as "o" from EmployeeTable as "root" left outer join OfficeTable as "OfficeTable_d#11_d#2_m1" on ("root".officeId = "OfficeTable_d#11_d#2_m1".id and "OfficeTable_d#11_d#2_m1".from_z <= DATE\'2020-01-01\' and "OfficeTable_d#11_d#2_m1".thru_z > DATE\'2020-01-01\') left outer join OfficeTable as "OfficeTable_d#9_d_m2" on ("root".officeId = "OfficeTable_d#9_d_m2".id and "OfficeTable_d#9_d_m2".from_z <= DATE\'2020-01-01\' and "OfficeTable_d#9_d_m2".thru_z > DATE\'2020-01-01\') where "OfficeTable_d#11_d#2_m1".name is not null',
    toH2SQL(|Employee.all()->filter(e | $e.dept.officeName(%2020-01-01)->isNotEmpty())->project([e | $e.name, e | $e.dept.officeName(%2020-01-01)], ['n', 'o']), EmbeddedMapping)
  );
}
