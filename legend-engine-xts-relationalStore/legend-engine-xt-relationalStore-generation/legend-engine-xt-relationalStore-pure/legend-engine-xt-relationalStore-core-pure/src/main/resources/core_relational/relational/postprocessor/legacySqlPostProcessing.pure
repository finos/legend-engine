import meta::external::query::sql::metamodel::*;
import meta::external::store::relational::runtime::*;
import meta::external::store::relational::sqlPlanning::*;
import meta::pure::extension::*;
import meta::pure::mapping::*;
import meta::relational::metamodel::relation::*;
import meta::relational::runtime::*;
import meta::relational::postProcessor::legacy::*;

// A per-process kill switch (-Dpure.options.LegacySqlPostProcessing=true) that restores the SQL post-processing from before the
// SQL optimizer stage: the optimizer runs no rules, and the filter push-down post processor, plan-time CTE extraction and the H2
// SQL planner run where they used to. The code they run is kept as it was, so switching back reproduces the old SQL.
function meta::relational::postProcessor::legacy::legacySqlPostProcessingOptionName(): String[1]
{
  'LegacySqlPostProcessing'
}

function meta::relational::postProcessor::legacy::isLegacySqlPostProcessing(): Boolean[1]
{
  meta::core::runtime::isOptionSet(legacySqlPostProcessingOptionName())
}

function meta::relational::postProcessor::legacy::pushFiltersDownToJoinsIfLegacy(selectSQLQuery:SelectSQLQuery[1], dbConnection:DatabaseConnection[0..1], exeCtx:meta::pure::runtime::ExecutionContext[1], extensions:Extension[*]):Result<SelectSQLQuery|1>[1]
{
  if(isLegacySqlPostProcessing(),
    | meta::relational::postProcessor::filterPushDown::pushFiltersDownToJoins($selectSQLQuery, $dbConnection, $exeCtx, $extensions),
    | ^Result<SelectSQLQuery|1>(values = $selectSQLQuery)
  )
}

function meta::relational::postProcessor::legacy::planSqlStatementIfLegacy(statement:Statement[1], dbType:DatabaseType[1], extensions:Extension[*]):Statement[1]
{
  if(isLegacySqlPostProcessing(),
    | $statement->planSqlStatement(^SqlPlanningConfig(dbType = $dbType->toString()), $extensions),
    | $statement
  )
}
