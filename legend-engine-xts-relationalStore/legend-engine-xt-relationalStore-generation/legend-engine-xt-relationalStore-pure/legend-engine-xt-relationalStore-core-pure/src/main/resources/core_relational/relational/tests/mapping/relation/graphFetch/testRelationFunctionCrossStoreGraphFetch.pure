###Mapping
import meta::relational::tests::mapping::relation::graphFetch::crossStore::*;

Mapping meta::relational::tests::mapping::relation::graphFetch::crossStore::RfFirmRelationalEmployeeMapping
(
  Firm: Relation
  {
    ~func meta::relational::tests::mapping::relation::graphFetch::crossStore::firmFunction__Relation_1_
    +id: Integer[1]: ID,
    name: NAME
  }

  Employee: Relational
  {
    +firmId: Integer[1]: [XsDB2]RFGF_XS_EMPLOYEE.FIRM_ID,
    name: [XsDB2]RFGF_XS_EMPLOYEE.NAME
  }

  Firm_Employee: XStore
  {
    employees: $this.id == $that.firmId,
    firm: $this.firmId == $that.id
  }
)

###Mapping
import meta::relational::tests::mapping::relation::graphFetch::crossStore::*;

Mapping meta::relational::tests::mapping::relation::graphFetch::crossStore::RelationalFirmRfEmployeeMapping
(
  Firm: Relational
  {
    +id: Integer[1]: [XsDB1]RFGF_XS_FIRM.ID,
    name: [XsDB1]RFGF_XS_FIRM.NAME
  }

  Employee: Relation
  {
    ~func meta::relational::tests::mapping::relation::graphFetch::crossStore::employeeFunction__Relation_1_
    +firmId: Integer[1]: FIRM_ID,
    name: NAME
  }

  Firm_Employee: XStore
  {
    employees: $this.id == $that.firmId,
    firm: $this.firmId == $that.id
  }
)

###Mapping
import meta::relational::tests::mapping::relation::graphFetch::crossStore::*;

Mapping meta::relational::tests::mapping::relation::graphFetch::crossStore::AllRfMapping
(
  Firm[firm]: Relation
  {
    ~func meta::relational::tests::mapping::relation::graphFetch::crossStore::firmFunction__Relation_1_
    +id: Integer[1]: ID,
    name: NAME
  }

  Country[country]: Relation
  {
    ~func meta::relational::tests::mapping::relation::graphFetch::crossStore::countryFunction__Relation_1_
    +id: Integer[1]: ID,
    name: NAME
  }

  Employee[employee]: Relation
  {
    ~func meta::relational::tests::mapping::relation::graphFetch::crossStore::employeeFunction__Relation_1_
    +firmId: Integer[1]: FIRM_ID,
    +addressId: Integer[1]: ADDRESS_ID,
    +countryId: Integer[1]: COUNTRY_ID,
    name: NAME
  }

  Address[address]: Relation
  {
    ~func meta::relational::tests::mapping::relation::graphFetch::crossStore::addressFunction__Relation_1_
    +id: Integer[1]: ID,
    city: CITY
  }

  Firm_Employee: XStore
  {
    employees[firm, employee]: $this.id == $that.firmId,
    firm[employee, firm]: $this.firmId == $that.id
  }

  Employee_Address: ModelJoin
  {
    {address: meta::relational::tests::mapping::relation::graphFetch::crossStore::Address[1], residents: meta::relational::tests::mapping::relation::graphFetch::crossStore::Employee[1] | $residents.addressId == $address.id}
  }

  Employee_Country: XStore
  {
    country[employee, country]: $this.countryId == $that.id,
    countryEmployees[country, employee]: $this.id == $that.countryId
  }
)

###Mapping
import meta::relational::tests::mapping::relation::graphFetch::crossStore::*;

Mapping meta::relational::tests::mapping::relation::graphFetch::crossStore::ChainM2MMapping
(
  T_Employee: Pure
  {
    ~src Employee
    fullName: $src.name->toUpper(),
    cityName: $src.address.city,
    address: $src.address
  }

  T_Address: Pure
  {
    ~src Address
    cityName: $src.city,
    residentCount: $src.residents->count(),
    residents: $src.residents
  }
)

###Mapping
import meta::relational::tests::mapping::relation::graphFetch::crossStore::*;

Mapping meta::relational::tests::mapping::relation::graphFetch::crossStore::JsonTradeRfFirmMapping
(
  Trade[trade]: Pure
  {
    ~src S_Trade
    tradeId: $src.s_tradeId,
    quantity: $src.s_details->split(':')->at(1)->parseInteger(),
    +firmId: Integer[1]: $src.s_details->split(':')->at(0)->parseInteger()
  }

  Firm[firm]: Relation
  {
    ~func meta::relational::tests::mapping::relation::graphFetch::crossStore::firmFunction__Relation_1_
    +id: Integer[1]: ID,
    name: NAME
  }

  Employee[employee]: Relation
  {
    ~func meta::relational::tests::mapping::relation::graphFetch::crossStore::employeeFunction__Relation_1_
    +firmId: Integer[1]: FIRM_ID,
    name: NAME
  }

  FirmTrade[firmTrade]: Pure
  {
    ~src S_Trade
    tradeId: $src.s_tradeId,
    firmId: $src.s_details->split(':')->at(0)->parseInteger()
  }

  Trade_Firm: XStore
  {
    tradedFirm[trade, firm]: $this.firmId == $that.id,
    trades[firm, trade]: $this.id == $that.firmId
  }

  Firm_FirmTrade: XStore
  {
    firmTrades[firm, firmTrade]: $this.id == $that.firmId
  }

  Firm_Employee: XStore
  {
    employees[firm, employee]: $this.id == $that.firmId,
    firm[employee, firm]: $this.firmId == $that.id
  }
)

###Pure
import meta::pure::graphFetch::execution::*;
import meta::core::runtime::*;
import meta::relational::metamodel::execute::*;
import meta::external::store::relational::runtime::*;
import meta::relational::runtime::*;
import meta::relational::tests::mapping::relation::graphFetch::crossStore::*;

function <<test.BeforePackage>> meta::relational::tests::mapping::relation::graphFetch::crossStore::setUpTables():Boolean[1]
{
  let connection1 = meta::external::store::relational::tests::testRuntime(XsDB1).connectionStores.connection->toOne()->cast(@DatabaseConnection);
  executeInDb('Drop table if exists RFGF_XS_FIRM;', $connection1);
  executeInDb('Create Table RFGF_XS_FIRM(ID INT PRIMARY KEY, NAME VARCHAR(100) NOT NULL);', $connection1);
  executeInDb('Insert into RFGF_XS_FIRM values (1, \'Acme\');', $connection1);
  executeInDb('Insert into RFGF_XS_FIRM values (2, \'Globex\');', $connection1);
  executeInDb('Insert into RFGF_XS_FIRM values (3, \'Initech\');', $connection1);
  executeInDb('Drop table if exists RFGF_XS_COUNTRY;', $connection1);
  executeInDb('Create Table RFGF_XS_COUNTRY(ID INT PRIMARY KEY, NAME VARCHAR(100) NOT NULL);', $connection1);
  executeInDb('Insert into RFGF_XS_COUNTRY values (1, \'UK\');', $connection1);
  executeInDb('Insert into RFGF_XS_COUNTRY values (2, \'US\');', $connection1);
  executeInDb('Insert into RFGF_XS_COUNTRY values (3, \'France\');', $connection1);

  let connection2 = meta::external::store::relational::tests::testRuntime(XsDB2).connectionStores.connection->toOne()->cast(@DatabaseConnection);
  executeInDb('Drop table if exists RFGF_XS_EMPLOYEE;', $connection2);
  executeInDb('Create Table RFGF_XS_EMPLOYEE(ID INT PRIMARY KEY, NAME VARCHAR(100) NOT NULL, FIRM_ID INT NOT NULL, ADDRESS_ID INT NOT NULL, COUNTRY_ID INT NOT NULL);', $connection2);
  executeInDb('Insert into RFGF_XS_EMPLOYEE values (1, \'Alice\', 1, 1, 1);', $connection2);
  executeInDb('Insert into RFGF_XS_EMPLOYEE values (2, \'Bob\', 1, 2, 2);', $connection2);
  executeInDb('Insert into RFGF_XS_EMPLOYEE values (3, \'Carol\', 2, 1, 1);', $connection2);
  executeInDb('Insert into RFGF_XS_EMPLOYEE values (4, \'Dave\', 2, 3, 2);', $connection2);
  executeInDb('Drop table if exists RFGF_XS_ADDRESS;', $connection2);
  executeInDb('Create Table RFGF_XS_ADDRESS(ID INT PRIMARY KEY, CITY VARCHAR(100) NOT NULL);', $connection2);
  executeInDb('Insert into RFGF_XS_ADDRESS values (1, \'London\');', $connection2);
  executeInDb('Insert into RFGF_XS_ADDRESS values (2, \'NYC\');', $connection2);
  executeInDb('Insert into RFGF_XS_ADDRESS values (3, \'Boston\');', $connection2);
  executeInDb('Insert into RFGF_XS_ADDRESS values (4, \'Paris\');', $connection2);
  true;
}

function meta::relational::tests::mapping::relation::graphFetch::crossStore::crossDbRuntime():Runtime[1]
{
  ^Runtime(connectionStores = meta::external::store::relational::tests::testRuntime(XsDB1).connectionStores
    ->concatenate(meta::external::store::relational::tests::testRuntime(XsDB2).connectionStores))
}

function meta::relational::tests::mapping::relation::graphFetch::crossStore::chainRuntime():Runtime[1]
{
  ^Runtime(connectionStores = meta::external::store::relational::tests::testRuntime(XsDB2).connectionStores
    ->concatenate(^ConnectionStore(
      element = ^meta::external::store::model::ModelStore(),
      connection = ^meta::external::store::model::ModelChainConnection(mappings = [AllRfMapping])
    )))
}

function meta::relational::tests::mapping::relation::graphFetch::crossStore::jsonTradeRuntime():Runtime[1]
{
  let jsonConnection = ^meta::external::store::model::JsonModelConnection(
    class = S_Trade,
    url = 'data:application/json,' +
          '{"s_tradeId": 1, "s_details": "1:100"}' +
          '{"s_tradeId": 2, "s_details": "2:200"}' +
          '{"s_tradeId": 3, "s_details": "1:300"}'
  );
  ^Runtime(connectionStores = crossDbRuntime().connectionStores
    ->concatenate(^ConnectionStore(element = ^meta::external::store::model::ModelStore(), connection = $jsonConnection)));
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::crossStore::testCrossDbRfRootToRelationalChildToMany():Boolean[1]
{
  let tree = #{Firm {name, employees {name}}}#;
  let result = execute(|Firm.all()->graphFetch($tree)->serialize($tree), RfFirmRelationalEmployeeMapping, crossDbRuntime(), meta::relational::extension::relationalExtensions());
  assertJsonStringsEqual(
    '[' +
      '{"name":"Acme","employees":[{"name":"Alice"},{"name":"Bob"}]},' +
      '{"name":"Globex","employees":[{"name":"Carol"},{"name":"Dave"}]},' +
      '{"name":"Initech","employees":[]}' +
    ']',
    $result.values
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::crossStore::testCrossDbRelationalRootToRfChildToOne():Boolean[1]
{
  let tree = #{Employee {name, firm {name}}}#;
  let result = execute(|Employee.all()->graphFetch($tree)->serialize($tree), RfFirmRelationalEmployeeMapping, crossDbRuntime(), meta::relational::extension::relationalExtensions());
  assertJsonStringsEqual(
    '[' +
      '{"name":"Alice","firm":{"name":"Acme"}},' +
      '{"name":"Bob","firm":{"name":"Acme"}},' +
      '{"name":"Carol","firm":{"name":"Globex"}},' +
      '{"name":"Dave","firm":{"name":"Globex"}}' +
    ']',
    $result.values
  );
}

