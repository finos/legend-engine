function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::crossStore::testCrossDbRfChildWithLocalChild():Boolean[1]
{
  let tree = #{Firm {name, employees {name, address {city}}}}#;
  let result = execute(|Firm.all()->graphFetch($tree)->serialize($tree), AllRfMapping, crossDbRuntime(), meta::relational::extension::relationalExtensions());
  assertJsonStringsEqual(
    '[' +
