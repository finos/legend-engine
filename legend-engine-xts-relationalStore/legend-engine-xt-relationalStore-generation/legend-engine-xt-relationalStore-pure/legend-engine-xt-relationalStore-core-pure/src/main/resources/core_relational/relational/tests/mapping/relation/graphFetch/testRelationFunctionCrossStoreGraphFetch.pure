###Pure
import meta::relational::tests::mapping::relation::graphFetch::crossStore::*;

Class meta::relational::tests::mapping::relation::graphFetch::crossStore::Firm
{
  name: String[1];
}

Class meta::relational::tests::mapping::relation::graphFetch::crossStore::Employee
{
  name: String[1];
}

Class meta::relational::tests::mapping::relation::graphFetch::crossStore::Address
{
  city: String[1];
}

Class meta::relational::tests::mapping::relation::graphFetch::crossStore::Country
{
  name: String[1];
}

Class meta::relational::tests::mapping::relation::graphFetch::crossStore::Trade
{
  tradeId: Integer[1];
  quantity: Integer[1];
}

Class meta::relational::tests::mapping::relation::graphFetch::crossStore::S_Trade
{
  s_tradeId: Integer[1];
  s_details: String[1];
}

Association meta::relational::tests::mapping::relation::graphFetch::crossStore::Firm_Employee
{
  firm: Firm[0..1];
  employees: Employee[*];
}

Association meta::relational::tests::mapping::relation::graphFetch::crossStore::Employee_Address
{
  address: Address[0..1];
  residents: Employee[*];
}

Association meta::relational::tests::mapping::relation::graphFetch::crossStore::Employee_Country
{
  country: Country[0..1];
  countryEmployees: Employee[*];
}

Association meta::relational::tests::mapping::relation::graphFetch::crossStore::Trade_Firm
{
  tradedFirm: Firm[0..1];
  trades: Trade[*];
}

Class meta::relational::tests::mapping::relation::graphFetch::crossStore::FirmTrade
{
  tradeId: Integer[1];
  firmId: Integer[1];
}

Association meta::relational::tests::mapping::relation::graphFetch::crossStore::Firm_FirmTrade
{
  owningFirm: Firm[0..1];
  firmTrades: FirmTrade[*];
}

Class meta::relational::tests::mapping::relation::graphFetch::crossStore::T_Employee
{
  fullName: String[1];
  cityName: String[0..1];
  address: T_Address[0..1];
}

Class meta::relational::tests::mapping::relation::graphFetch::crossStore::T_Address
{
  cityName: String[1];
  residentCount: Integer[1];
  residents: T_Employee[*];
}

###Relational
Database meta::relational::tests::mapping::relation::graphFetch::crossStore::XsDB1
(
  Table RFGF_XS_FIRM(ID INT PRIMARY KEY, NAME VARCHAR(100) NOT NULL)
  Table RFGF_XS_COUNTRY(ID INT PRIMARY KEY, NAME VARCHAR(100) NOT NULL)
)

###Relational
Database meta::relational::tests::mapping::relation::graphFetch::crossStore::XsDB2
(
  Table RFGF_XS_EMPLOYEE(ID INT PRIMARY KEY, NAME VARCHAR(100) NOT NULL, FIRM_ID INT NOT NULL, ADDRESS_ID INT NOT NULL, COUNTRY_ID INT NOT NULL)
  Table RFGF_XS_ADDRESS(ID INT PRIMARY KEY, CITY VARCHAR(100) NOT NULL)
)

