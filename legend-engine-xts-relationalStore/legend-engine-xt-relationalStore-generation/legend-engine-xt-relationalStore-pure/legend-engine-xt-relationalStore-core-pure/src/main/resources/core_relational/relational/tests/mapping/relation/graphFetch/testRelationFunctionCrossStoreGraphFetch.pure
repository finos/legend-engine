function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::crossStore::testCrossDbRfTreeWithRootFilter():Boolean[1]
{
  let tree = #{Firm {name, employees {name, address {city}, country {name}}}}#;
  let result = execute(|Firm.all()->filter(f | $f.name == 'Globex')->graphFetch($tree)->serialize($tree), AllRfMapping, crossDbRuntime(), meta::relational::extension::relationalExtensions());
  assertJsonStringsEqual(
    '{"name":"Globex","employees":[' +
      '{"name":"Carol","address":{"city":"London"},"country":{"name":"UK"}},' +
      '{"name":"Dave","address":{"city":"Boston"},"country":{"name":"US"}}' +
    ']}',
    $result.values
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::crossStore::testM2MChainOverRfFlat():Boolean[1]
{
  let tree = #{T_Address {cityName, residentCount}}#;
  let result = execute(|T_Address.all()->graphFetch($tree)->serialize($tree), ChainM2MMapping, chainRuntime(), meta::relational::extension::relationalExtensions());
  assertJsonStringsEqual(
    '[' +
      '{"cityName":"London","residentCount":2},' +
      '{"cityName":"NYC","residentCount":1},' +
      '{"cityName":"Boston","residentCount":1},' +
      '{"cityName":"Paris","residentCount":0}' +
    ']',
    $result.values
  );
}

