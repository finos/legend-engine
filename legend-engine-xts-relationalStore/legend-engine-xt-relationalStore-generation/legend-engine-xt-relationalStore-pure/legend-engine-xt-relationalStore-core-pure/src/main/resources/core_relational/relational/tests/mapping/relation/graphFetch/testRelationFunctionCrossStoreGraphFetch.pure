function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::crossStore::testCrossStoreJsonM2MRootToRfChild():Boolean[1]
{
  let tree = #{Trade {tradeId, quantity, tradedFirm {name}}}#;
  let result = execute(|Trade.all()->graphFetch($tree)->serialize($tree), JsonTradeRfFirmMapping, jsonTradeRuntime(), meta::relational::extension::relationalExtensions());
  assertJsonStringsEqual(
    '[' +
      '{"tradeId":1,"quantity":100,"tradedFirm":{"name":"Acme"}},' +
      '{"tradeId":2,"quantity":200,"tradedFirm":{"name":"Globex"}},' +
      '{"tradeId":3,"quantity":300,"tradedFirm":{"name":"Acme"}}' +
    ']',
    $result.values
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::crossStore::testCrossStoreJsonM2MRootToRfChildWithCrossDbGrandchild():Boolean[1]
{
  let tree = #{Trade {tradeId, tradedFirm {name, employees {name}}}}#;
  let result = execute(|Trade.all()->graphFetch($tree)->serialize($tree), JsonTradeRfFirmMapping, jsonTradeRuntime(), meta::relational::extension::relationalExtensions());
  assertJsonStringsEqual(
    '[' +
      '{"tradeId":1,"tradedFirm":{"name":"Acme","employees":[{"name":"Alice"},{"name":"Bob"}]}},' +
      '{"tradeId":2,"tradedFirm":{"name":"Globex","employees":[{"name":"Carol"},{"name":"Dave"}]}},' +
      '{"tradeId":3,"tradedFirm":{"name":"Acme","employees":[{"name":"Alice"},{"name":"Bob"}]}}' +
    ']',
    $result.values
  );
}

// The in-memory cross-store node ignores the XStore condition when the child key is a local (+) property:
// graphFetchInMemory.pure addInMemoryCrossStoreMethods makes attemptAddingChildToParent return true, so every
// trade is attached to every firm. Same result with a plain Relational Firm, so this is not RF-specific.
function <<test.Test, test.AlloyOnly, test.ToFix>> meta::relational::tests::mapping::relation::graphFetch::crossStore::testCrossStoreRfRootToJsonM2MChildJoinedOnLocalProperty():Boolean[1]
{
  let tree = #{Firm {name, trades {tradeId}}}#;
  let result = execute(|Firm.all()->graphFetch($tree)->serialize($tree), JsonTradeRfFirmMapping, jsonTradeRuntime(), meta::relational::extension::relationalExtensions());
  assertJsonStringsEqual(
    '[' +
      '{"name":"Acme","trades":[{"tradeId":1},{"tradeId":3}]},' +
      '{"name":"Globex","trades":[{"tradeId":2}]},' +
      '{"name":"Initech","trades":[]}' +
    ']',
    $result.values
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::crossStore::testCrossStoreRfRootToJsonM2MChildJoinedOnMappedProperty():Boolean[1]
{
  let tree = #{Firm {name, firmTrades {tradeId}}}#;
  let result = execute(|Firm.all()->graphFetch($tree)->serialize($tree), JsonTradeRfFirmMapping, jsonTradeRuntime(), meta::relational::extension::relationalExtensions());
  assertJsonStringsEqual(
    '[' +
      '{"name":"Acme","firmTrades":[{"tradeId":1},{"tradeId":3}]},' +
      '{"name":"Globex","firmTrades":[{"tradeId":2}]},' +
      '{"name":"Initech","firmTrades":[]}' +
    ']',
    $result.values
  );
}
