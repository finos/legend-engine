      +firmId: Integer[1]: $row.FirmID->toOne()
   }

   Coworkers: ModelJoin
   {
      {colleagues: Colleague[1], coworkers: Colleague[1]|$colleagues.firmId == $coworkers.firmId}
   }
)

###Pure
import meta::relational::tests::model::simple::*;
import meta::relational::tests::mapping::union::*;
import meta::relational::tests::mapping::union::relation::combinations::*;
import meta::pure::mapping::*;

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::union::relation::combinations::testBothSidesUnion_FilterAndProjectThroughFirm():Boolean[1]
{
   let result = execute(
      |Person.all()->filter(p|$p.firm.legalName == 'Firm X')->project(~[name:p|$p.lastName, firm:p|$p.firm.legalName]),
      unionOnBothSides,
      meta::external::store::relational::tests::testRuntime(myDB),
      meta::relational::extension::relationalExtensions()
   );
   assertEquals(
     #TDS
        name, firm
        Anand, Firm X
        Scott, Firm X
        Taylor, Firm X
        Wright, Firm X
     #->toString(),
     $result.values->at(0)->sort([~name->ascending()])->toString());
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::union::relation::combinations::testBothSidesUnion_ProjectToManyEmployees():Boolean[1]
{
   let result = execute(
      |Firm.all()->project(~[legalName:f|$f.legalName, name:f|$f.employees.lastName]),
      unionOnBothSides,
      meta::external::store::relational::tests::testRuntime(myDB),
      meta::relational::extension::relationalExtensions()
   );
   assertEquals(
     #TDS
        legalName, name
        Firm A, Roberts
        Firm X, Anand
        Firm X, Scott
        Firm X, Taylor
        Firm X, Wright
     #->toString(),
     $result.values->at(0)->sort([~legalName->ascending(), ~name->ascending()])->toString());
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::union::relation::combinations::testBothSidesUnion_GroupByFirm():Boolean[1]
{
   let result = execute(
      |Person.all()->project(~[firm:p|$p.firm.legalName, name:p|$p.lastName])->groupBy(~firm, ~count:x|$x.name:y|$y->count()),
      unionOnBothSides,
      meta::external::store::relational::tests::testRuntime(myDB),
      meta::relational::extension::relationalExtensions()
   );
   assertEquals(
     #TDS
        firm, count
        Firm A, 1
        Firm X, 4
     #->toString(),
     $result.values->at(0)->sort([~firm->ascending()])->toString());
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::union::relation::combinations::testBothSidesUnion_FilterOnEmployeesOfFirm():Boolean[1]
{
   let result = execute(
      |Firm.all()->filter(f|$f.employees->exists(e|$e.lastName == 'Taylor') && $f.employees->exists(e|$e.lastName == 'Scott'))->project(~[legalName:f|$f.legalName]),
      unionOnBothSides,
      meta::external::store::relational::tests::testRuntime(myDB),
      meta::relational::extension::relationalExtensions()
   );
   assertEquals(
     #TDS
        legalName
        Firm X
     #->toString(),
     $result.values->at(0)->sort([~legalName->ascending()])->toString());
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::union::relation::combinations::testBothSidesUnion_MultiHopColleaguesThroughFirm():Boolean[1]
{
   let result = execute(
      |Person.all()->filter(p|$p.firm.employees->exists(e|$e.lastName == 'Wright'))->project(~[name:p|$p.lastName]),
      unionOnBothSides,
      meta::external::store::relational::tests::testRuntime(myDB),
      meta::relational::extension::relationalExtensions()
   );
   assertEquals(
     #TDS
        name
        Anand
        Scott
        Taylor
        Wright
     #->toString(),
     $result.values->at(0)->sort([~name->ascending()])->toString());
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::union::relation::combinations::testSubAggregationsToFirmUnion_FilterAndProject():Boolean[1]
{
   let result = execute(
      |Person.all()->filter(p|$p.firm.legalName == 'Firm X')->project(~[name:p|$p.lastName, firm:p|$p.firm.legalName]),
      subAggregationsToFirmUnion,
      meta::external::store::relational::tests::testRuntime(myDB),
      meta::relational::extension::relationalExtensions()
   );
   assertEquals(
     #TDS
        name, firm
        Scott, Firm X
        Wright, Firm X
     #->toString(),
     $result.values->at(0)->sort([~name->ascending()])->toString());
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::union::relation::combinations::testRelationAndRelationalFirmUnion_FilterAndProjectThroughFirm():Boolean[1]
{
   let result = execute(
      |Person.all()->filter(p|$p.firm.legalName == 'Firm A')->project(~[name:p|$p.lastName, firm:p|$p.firm.legalName]),
      relationAndRelationalFirmUnion,
      meta::external::store::relational::tests::testRuntime(myDB),
      meta::relational::extension::relationalExtensions()
