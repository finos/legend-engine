import meta::relational::tests::mapping::union::*;
import meta::relational::tests::model::simple::*;
import meta::relational::tests::mapping::union::relation::combinations::*;

Mapping meta::relational::tests::mapping::union::relation::combinations::mixedOnBothSides
(
   *Person : Operation
   {
      meta::pure::router::operations::union_OperationSetImplementation_1__SetImplementation_MANY_(rfPerson1, relPerson2)
   }

   Person[rfPerson1] : Relation
   {
      ~func meta::relational::tests::mapping::union::relation::advanced::personSet1WithFirmIdFunc():Relation<Any>[1]
      lastName: $row.lastName_s1->toOne(),
      +firmId: Integer[1]: $row.FirmID->toOne()
   }

   Person[relPerson2] : Relational
   {
      ~primaryKey
      (
         [myDB]PersonSet2.ID
      )
      ~mainTable [myDB]PersonSet2
      lastName: [myDB]PersonSet2.lastName_s2,
      +firmId: Integer[1]: [myDB]PersonSet2.FirmID
   }

   *Firm : Operation
   {
      meta::pure::router::operations::union_OperationSetImplementation_1__SetImplementation_MANY_(relFirm1, rfFirm2)
   }

   Firm[relFirm1] : Relational
   {
      ~primaryKey
      (
         [myDB]FirmSet1.ID
      )
      ~mainTable [myDB]FirmSet1
      legalName: [myDB]FirmSet1.name,
      +id: Integer[1]: [myDB]FirmSet1.ID
   }

   Firm[rfFirm2] : Relation
   {
      ~func meta::relational::tests::mapping::union::relation::combinations::firmSet2Func():Relation<Any>[1]
      legalName: $row.name->toOne(),
      +id: Integer[1]: $row.ID->toOne()
   }

   Employment: ModelJoin
   {
      {employees: Person[1], firm: Firm[1]|$employees.firmId == $firm.id}
   }
)

