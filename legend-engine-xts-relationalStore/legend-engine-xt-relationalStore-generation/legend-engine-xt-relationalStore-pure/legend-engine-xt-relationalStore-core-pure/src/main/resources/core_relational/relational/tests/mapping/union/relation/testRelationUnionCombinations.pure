}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::union::relation::combinations::testRelationAndRelationalFirmUnion_ProjectToManyEmployees():Boolean[1]
{
   let result = execute(
      |Firm.all()->project(~[legalName:f|$f.legalName, name:f|$f.employees.lastName]),
