     #->toString(),
     $result.values->at(0)->sort([~legalName->ascending(), ~name->ascending()])->toString());
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::union::relation::combinations::testSelfModelJoinAcrossUnion_ProjectCoworkers():Boolean[1]
{
   let result = execute(
      |Colleague.all()->filter(c|$c.name == 'Taylor')->project(~[name:c|$c.name, coworker:c|$c.coworkers.name]),
      selfModelJoinAcrossUnion,
      meta::external::store::relational::tests::testRuntime(myDB),
      meta::relational::extension::relationalExtensions()
   );
   assertEquals(
     #TDS
        name, coworker
        Taylor, Anand
        Taylor, Scott
        Taylor, Taylor
        Taylor, Wright
     #->toString(),
     $result.values->at(0)->sort([~coworker->ascending()])->toString());
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::union::relation::combinations::testSelfModelJoinAcrossUnion_FilterOnCoworkers():Boolean[1]
{
   let result = execute(
      |Colleague.all()->filter(c|$c.coworkers->exists(w|$w.name == 'Roberts'))->project(~[name:c|$c.name]),
      selfModelJoinAcrossUnion,
      meta::external::store::relational::tests::testRuntime(myDB),
      meta::relational::extension::relationalExtensions()
   );
   assertEquals(
     #TDS
        name
        Roberts
     #->toString(),
     $result.values->at(0)->sort([~name->ascending()])->toString());
}

