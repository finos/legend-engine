function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::union::relation::combinations::testMixedBothSides_FilterAndProjectThroughFirm():Boolean[1]
{
   let result = execute(
      |Person.all()->filter(p|$p.firm.legalName == 'Firm X')->project(~[name:p|$p.lastName, firm:p|$p.firm.legalName]),
      mixedOnBothSides,
      meta::external::store::relational::tests::testRuntime(myDB),
      meta::relational::extension::relationalExtensions()
   );
   assertEquals(
     #TDS
        name, firm
        Anand, Firm X
        Scott, Firm X
        Taylor, Firm X
        Wright, Firm X
     #->toString(),
     $result.values->at(0)->sort([~name->ascending()])->toString());
}

