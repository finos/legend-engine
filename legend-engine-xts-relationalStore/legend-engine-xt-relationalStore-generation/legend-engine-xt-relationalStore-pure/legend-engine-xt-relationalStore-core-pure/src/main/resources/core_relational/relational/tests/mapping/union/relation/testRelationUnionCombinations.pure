Mapping meta::relational::tests::mapping::union::relation::combinations::relationAndRelationalFirmUnion
(
   *Person : Operation
   {
      meta::pure::router::operations::union_OperationSetImplementation_1__SetImplementation_MANY_(rfPerson1, rfPerson2)
   }

   Person[rfPerson1] : Relation
   {
      ~func meta::relational::tests::mapping::union::relation::advanced::personSet1WithFirmIdFunc():Relation<Any>[1]
      lastName: $row.lastName_s1->toOne(),
      +firmId: Integer[1]: $row.FirmID->toOne()
   }

   Person[rfPerson2] : Relation
   {
      ~func meta::relational::tests::mapping::union::relation::advanced::personSet2WithFirmIdFunc():Relation<Any>[1]
      lastName: $row.lastName_s2->toOne(),
      +firmId: Integer[1]: $row.FirmID->toOne()
   }

   *Firm : Operation
   {
      meta::pure::router::operations::union_OperationSetImplementation_1__SetImplementation_MANY_(rfFirm1, relFirm2)
   }

   Firm[rfFirm1] : Relation
   {
      ~func meta::relational::tests::mapping::union::relation::combinations::firmSet1Func():Relation<Any>[1]
      legalName: $row.name->toOne(),
      +id: Integer[1]: $row.ID->toOne()
   }

   Firm[relFirm2] : Relational
   {
      ~primaryKey
      (
         [myDB]FirmSet2.ID
      )
      ~mainTable [myDB]FirmSet2
      legalName: [myDB]FirmSet2.name,
      +id: Integer[1]: [myDB]FirmSet2.ID
   }

   Employment: ModelJoin
   {
      {employees: Person[1], firm: Firm[1]|$employees.firmId == $firm.id}
   }
)

Mapping meta::relational::tests::mapping::union::relation::combinations::selfModelJoinAcrossUnion
(
   *Colleague : Operation
   {
      meta::pure::router::operations::union_OperationSetImplementation_1__SetImplementation_MANY_(rfColleague1, rfColleague2)
   }

   Colleague[rfColleague1] : Relation
