###Pure
import meta::pure::metamodel::relation::*;

Class meta::relational::tests::mapping::union::relation::combinations::Colleague
{
   name : String[1];
}

Association meta::relational::tests::mapping::union::relation::combinations::Coworkers
{
   colleagues : meta::relational::tests::mapping::union::relation::combinations::Colleague[*];
   coworkers  : meta::relational::tests::mapping::union::relation::combinations::Colleague[*];
}

function <<test.BeforePackage>> meta::relational::tests::mapping::union::relation::combinations::setUp():Boolean[1]
{
   meta::relational::tests::mapping::union::createTablesAndFillDb();
}

function meta::relational::tests::mapping::union::relation::combinations::firmSet1Func():Relation<Any>[1]
{
   #>{meta::relational::tests::mapping::union::myDB.FirmSet1}#->select(~[ID, name]);
}

function meta::relational::tests::mapping::union::relation::combinations::firmSet2Func():Relation<Any>[1]
{
   #>{meta::relational::tests::mapping::union::myDB.FirmSet2}#->select(~[ID, name]);
}

###Mapping
import meta::relational::tests::mapping::union::*;
import meta::relational::tests::model::simple::*;
import meta::relational::tests::mapping::union::relation::combinations::*;

Mapping meta::relational::tests::mapping::union::relation::combinations::unionOnBothSides
(
   *Person : Operation
   {
      meta::pure::router::operations::union_OperationSetImplementation_1__SetImplementation_MANY_(rfPerson1, rfPerson2)
   }

   Person[rfPerson1] : Relation
   {
      ~func meta::relational::tests::mapping::union::relation::advanced::personSet1WithFirmIdFunc():Relation<Any>[1]
      lastName: $row.lastName_s1->toOne(),
      +firmId: Integer[1]: $row.FirmID->toOne()
   }

   Person[rfPerson2] : Relation
   {
      ~func meta::relational::tests::mapping::union::relation::advanced::personSet2WithFirmIdFunc():Relation<Any>[1]
      lastName: $row.lastName_s2->toOne(),
      +firmId: Integer[1]: $row.FirmID->toOne()
   }

   *Firm : Operation
   {
      meta::pure::router::operations::union_OperationSetImplementation_1__SetImplementation_MANY_(rfFirm1, rfFirm2)
   }

   Firm[rfFirm1] : Relation
   {
      ~func meta::relational::tests::mapping::union::relation::combinations::firmSet1Func():Relation<Any>[1]
      legalName: $row.name->toOne(),
      +id: Integer[1]: $row.ID->toOne()
   }

   Firm[rfFirm2] : Relation
   {
      ~func meta::relational::tests::mapping::union::relation::combinations::firmSet2Func():Relation<Any>[1]
      legalName: $row.name->toOne(),
      +id: Integer[1]: $row.ID->toOne()
   }

   Employment: ModelJoin
   {
      {employees: Person[1], firm: Firm[1]|$employees.firmId == $firm.id}
   }
)

