###Pure
import meta::relational::tests::mapping::relation::inlineJoin::filteredTarget::*;
import meta::pure::executionPlan::*;
import meta::pure::graphFetch::execution::*;
import meta::relational::metamodel::execute::*;
import meta::relational::functions::asserts::*;

function <<access.private>> meta::relational::tests::mapping::relation::inlineJoin::filteredTarget::sqlOf(query:FunctionDefinition<Any>[1], mapping:meta::pure::mapping::Mapping[1]):String[1]
{
  executionPlan($query, $mapping, meta::external::store::relational::tests::testRuntime(FilteredTargetDB), meta::relational::extension::relationalExtensions())
    .rootExecutionNode.executionNodes->at(0)->cast(@meta::relational::mapping::SQLExecutionNode).sqlQuery;
}

function <<access.private>> meta::relational::tests::mapping::relation::inlineJoin::filteredTarget::planOf(query:FunctionDefinition<Any>[1], mapping:meta::pure::mapping::Mapping[1]):String[1]
{
  executionPlan($query, $mapping, meta::external::store::relational::tests::testRuntime(FilteredTargetDB), meta::relational::extension::relationalExtensions())
    ->meta::pure::executionPlan::toString::planToString(meta::relational::extension::relationalExtensions());
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::filteredTarget::testProjectingTheTargetNameKeepsTheTargetFilterInTheJoinedSubSelect():Boolean[1]
{
  assertSameSQL(
    'select "persontable_1".NAME as "person", "firmtable_0".NAME as "firm" from PersonTable as "persontable_1" left outer join (select "root".NAME as "name", "root".CODE as "code", "root".CODE as CODE, "root".NAME as NAME from FirmTable as "root" where "root".ACTIVE = \'Y\') as "firmtable_0" on ("persontable_1".FIRMCODE = "firmtable_0".CODE)',
    sqlOf({|Person.all()->project([p | $p.name, p | $p.firm.name], ['person', 'firm'])}, FilteredTargetMapping)
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::filteredTarget::testProjectingTargetNameAndTargetAssociationKeepsEveryColumnTheJoinNeeds():Boolean[1]
{
  assertSameSQL(
    'select "firmtable_0".NAME as "firm", "hqtable_0".CITY as "city" from PersonTable as "persontable_1" left outer join (select "root".NAME as "name", "root".CODE as "code", "root".CODE as CODE, "root".NAME as NAME, "root".HQID as HQID from FirmTable as "root" where "root".ACTIVE = \'Y\') as "firmtable_0" on ("persontable_1".FIRMCODE = "firmtable_0".CODE) left outer join HqTable as "hqtable_0" on ("firmtable_0".HQID = "hqtable_0".ID)',
    sqlOf({|Person.all()->project([p | $p.firm.name, p | $p.firm.hq.city], ['firm', 'city'])}, FilteredTargetMapping)
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::filteredTarget::testFilteringOnTheTargetNameReadsTheFilteredSubSelect():Boolean[1]
{
  assertSameSQL(
    'select "persontable_1".NAME as "person" from PersonTable as "persontable_1" left outer join (select "root".NAME as "name", "root".CODE as "code", "root".CODE as CODE, "root".NAME as NAME from FirmTable as "root" where "root".ACTIVE = \'Y\') as "firmtable_0" on ("persontable_1".FIRMCODE = "firmtable_0".CODE) where "firmtable_0".NAME = \'Acme\'',
    sqlOf({|Person.all()->filter(p | $p.firm.name == 'Acme')->project([p | $p.name], ['person'])}, FilteredTargetMapping)
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::filteredTarget::testTargetIsEmptyReadsTheFilteredSubSelect():Boolean[1]
{
  assertSameSQL(
    'select "persontable_0".NAME as "person" from (select "persontable_1".NAME as NAME, "persontable_1".FIRMCODE as FIRMCODE from PersonTable as "persontable_1") as "persontable_0" where not exists (select 1 from (select "root".CODE as "code", "root".CODE as CODE from FirmTable as "root" where "root".ACTIVE = \'Y\') as "firmtable_0" where "persontable_0"."FIRMCODE" = "firmtable_0".CODE)',
    sqlOf({|Person.all()->filter(p | $p.firm->isEmpty())->project([p | $p.name], ['person'])}, FilteredTargetMapping)
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::filteredTarget::testToManyTargetFilterReadsTheFilteredSubSelect():Boolean[1]
{
  assertSameSQL(
    'select "persontable_1".NAME as "person" from PersonTable as "persontable_1" left outer join (select "root".NAME as "name", "root".GROUPCODE as GROUPCODE, "root".NAME as NAME from FirmTable as "root" where "root".ACTIVE = \'Y\') as "firmtable_0" on ("persontable_1".GROUPCODE is not distinct from "firmtable_0".GROUPCODE) where "firmtable_0".NAME = \'Acme\'',
    sqlOf({|Person.all()->filter(p | $p.firms.name == 'Acme')->project([p | $p.name], ['person'])}, FilteredTargetMapping)
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::filteredTarget::testGraphFetchOfTheTargetReadsTheColumnsTheSubSelectExposes():Boolean[1]
{
  let tree = #{Person {name, firm {name}}}#;
  let plan = planOf({|Person.all()->graphFetch($tree)->serialize($tree)}, FilteredTargetMapping);
  assertSQLContains(
    'select distinct "temp_table_node_0_0".pk_0 as "parent_key_gen_0", "firmtable_0".ID as "pk_0", "firmtable_0".NAME as "name" from (select * from (${temp_table_node_0}) as "root") as "temp_table_node_0_0" inner join (select "persontable_2".ID as "ID", "persontable_2".NAME as "NAME", "persontable_2".FIRMCODE as "FIRMCODE" from PersonTable as "persontable_2") as "root" on ("temp_table_node_0_0".pk_0 = "root"."ID") left outer join (select "root".NAME as "name", "root".CODE as "code", "root".CODE as CODE, "root".ID as ID, "root".NAME as NAME from FirmTable as "root" where "root".ACTIVE = \'Y\') as "firmtable_0" on ("root"."FIRMCODE" = "firmtable_0".CODE) where "firmtable_0".ID is not null',
    $plan
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::filteredTarget::testGraphFetchOfTheNestedTargetReadsTheColumnsTheSubSelectExposes():Boolean[1]
{
  let tree = #{Person {name, firm {name, hq {city}}}}#;
  let plan = planOf({|Person.all()->graphFetch($tree)->serialize($tree)}, FilteredTargetMapping);
  assertSQLContains(
    'select distinct "temp_table_node_0_0".pk_0 as "parent_key_gen_0", "firmtable_0".ID as "pk_0", "firmtable_0".NAME as "name" from (select * from (${temp_table_node_0}) as "root") as "temp_table_node_0_0" inner join (select "persontable_2".ID as "ID", "persontable_2".NAME as "NAME", "persontable_2".FIRMCODE as "FIRMCODE" from PersonTable as "persontable_2") as "root" on ("temp_table_node_0_0".pk_0 = "root"."ID") left outer join (select "root".NAME as "name", "root".CODE as "code", "root".CODE as CODE, "root".ID as ID, "root".NAME as NAME from FirmTable as "root" where "root".ACTIVE = \'Y\') as "firmtable_0" on ("root"."FIRMCODE" = "firmtable_0".CODE) where "firmtable_0".ID is not null',
    $plan
  );
  assertSQLContains(
    'select distinct "temp_table_node_2_0".pk_0 as "parent_key_gen_0", "hqtable_0".ID as "pk_0", "hqtable_0".CITY as "city" from (select * from (${temp_table_node_2}) as "root") as "temp_table_node_2_0" inner join FirmTable as "root" on ("temp_table_node_2_0".pk_0 = "root".ID) left outer join HqTable as "hqtable_0" on ("root".HQID = "hqtable_0".ID) where "hqtable_0".ID is not null and "root".ACTIVE = \'Y\'',
    $plan
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::filteredTarget::testGraphFetchOfTheToManyTargetReadsTheColumnsTheSubSelectExposes():Boolean[1]
{
  let tree = #{Person {name, firms {name}}}#;
  let plan = planOf({|Person.all()->graphFetch($tree)->serialize($tree)}, FilteredTargetMapping);
  assertSQLContains(
    'select distinct "temp_table_node_0_0".pk_0 as "parent_key_gen_0", "firmtable_0".ID as "pk_0", "firmtable_0".NAME as "name" from (select * from (${temp_table_node_0}) as "root") as "temp_table_node_0_0" inner join (select "persontable_2".ID as "ID", "persontable_2".NAME as "NAME", "persontable_2".GROUPCODE as "GROUPCODE" from PersonTable as "persontable_2") as "root" on ("temp_table_node_0_0".pk_0 = "root"."ID") left outer join (select "root".NAME as "name", "root".GROUPCODE as GROUPCODE, "root".ID as ID, "root".NAME as NAME from FirmTable as "root" where "root".ACTIVE = \'Y\') as "firmtable_0" on ("root"."GROUPCODE" is not distinct from "firmtable_0".GROUPCODE) where "firmtable_0".ID is not null',
    $plan
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::filteredTarget::testProcessingTemporalTargetFilterReadsTheFilteredSubSelect():Boolean[1]
{
  assertSameSQL(
    'select "processingpersontable_1".NAME as "person" from ProcessingPersonTable as "processingpersontable_1" left outer join (select "root".NAME as "name", "root".CODE as "code", "root".CODE as CODE, "root".NAME as NAME from ProcessingFirmTable as "root" where "root".ACTIVE = \'Y\' and "root".IN_Z <= DATE\'2024-01-01\' and "root".OUT_Z > DATE\'2024-01-01\') as "processingfirmtable_0" on ("processingpersontable_1".FIRMCODE = "processingfirmtable_0".CODE) where "processingpersontable_1".IN_Z <= DATE\'2024-01-01\' and "processingpersontable_1".OUT_Z > DATE\'2024-01-01\' and "processingfirmtable_0".NAME = \'Acme\'',
    sqlOf({|ProcessingPerson.all(%2024-01-01)->filter(p | $p.firm(%2024-01-01).name == 'Acme')->project([p | $p.name], ['person'])}, ProcessingFilteredTargetMapping)
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::filteredTarget::testProcessingTemporalTargetIsEmptyReadsTheFilteredSubSelect():Boolean[1]
{
  assertSameSQL(
    'select "processingpersontable_0".NAME as "person" from (select "processingpersontable_1".NAME as NAME, "processingpersontable_1".FIRMCODE as FIRMCODE from ProcessingPersonTable as "processingpersontable_1" where "processingpersontable_1".IN_Z <= DATE\'2024-01-01\' and "processingpersontable_1".OUT_Z > DATE\'2024-01-01\') as "processingpersontable_0" where not exists (select 1 from (select "root".CODE as "code", "root".CODE as CODE from ProcessingFirmTable as "root" where "root".ACTIVE = \'Y\' and "root".IN_Z <= DATE\'2024-01-01\' and "root".OUT_Z > DATE\'2024-01-01\') as "processingfirmtable_0" where "processingpersontable_0"."FIRMCODE" = "processingfirmtable_0".CODE)',
    sqlOf({|ProcessingPerson.all(%2024-01-01)->filter(p | $p.firm(%2024-01-01)->isEmpty())->project([p | $p.name], ['person'])}, ProcessingFilteredTargetMapping)
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::filteredTarget::testGraphFetchOfTheProcessingTemporalTargetReadsTheMilestoningColumnsTheSubSelectExposes():Boolean[1]
{
  let tree = #{ProcessingPerson {name, firm(%2024-01-01) {name}}}#;
  let plan = planOf({|ProcessingPerson.all(%2024-01-01)->graphFetch($tree)->serialize($tree)}, ProcessingFilteredTargetMapping);
  assertSQLContains(
    'select distinct "temp_table_node_0_0".pk_0 as "parent_key_gen_0", "temp_table_node_0_0".pk_1 as "parent_key_gen_1", "processingfirmtable_0".ID as "pk_0", "processingfirmtable_0".IN_Z as "pk_1", "processingfirmtable_0".NAME as "name", \'2024-01-01\' as "k_processingDate" from (select * from (${temp_table_node_0}) as "root") as "temp_table_node_0_0" inner join (select "processingpersontable_2".ID as "ID", "processingpersontable_2".NAME as "NAME", "processingpersontable_2".FIRMCODE as "FIRMCODE", "processingpersontable_2".IN_Z as "IN_Z", "processingpersontable_2".OUT_Z as "OUT_Z" from ProcessingPersonTable as "processingpersontable_2" where "processingpersontable_2".IN_Z <= DATE\'2024-01-01\' and "processingpersontable_2".OUT_Z > DATE\'2024-01-01\') as "root" on ("temp_table_node_0_0".pk_1 = "root"."IN_Z" and "temp_table_node_0_0".pk_0 = "root"."ID") left outer join (select "root".NAME as "name", "root".CODE as "code", "root".CODE as CODE, "root".ID as ID, "root".IN_Z as IN_Z, "root".NAME as NAME from ProcessingFirmTable as "root" where "root".ACTIVE = \'Y\' and "root".IN_Z <= DATE\'2024-01-01\' and "root".OUT_Z > DATE\'2024-01-01\') as "processingfirmtable_0" on ("root"."FIRMCODE" = "processingfirmtable_0".CODE) where "processingfirmtable_0".IN_Z is not null and "processingfirmtable_0".ID is not null',
    $plan
  );
}
