###Mapping
import meta::relational::tests::mapping::relation::inlineJoin::filteredTarget::*;

Mapping meta::relational::tests::mapping::relation::inlineJoin::filteredTarget::FilteredTargetMapping
(
  Person: Relation
  {
    ~func meta::relational::tests::mapping::relation::inlineJoin::filteredTarget::personRel():Relation<Any>[1]
    ~primaryKey: [ID]
    name: NAME,
    firm: modelJoin({p, f | $p.firmKey == $f.code}),
    firms: modelJoin({p, f | $p.groupKey == $f.group}),
    +firmKey: String[0..1]: FIRMCODE,
    +groupKey: String[0..1]: GROUPCODE
  }

  Firm: Relational
  {
    ~filter [meta::relational::tests::mapping::relation::inlineJoin::filteredTarget::FilteredTargetDB]ActiveFirm
    ~mainTable [meta::relational::tests::mapping::relation::inlineJoin::filteredTarget::FilteredTargetDB]FirmTable
    name: [meta::relational::tests::mapping::relation::inlineJoin::filteredTarget::FilteredTargetDB]FirmTable.NAME,
    code: [meta::relational::tests::mapping::relation::inlineJoin::filteredTarget::FilteredTargetDB]FirmTable.CODE,
    +group: String[0..1]: [meta::relational::tests::mapping::relation::inlineJoin::filteredTarget::FilteredTargetDB]FirmTable.GROUPCODE,
    hq: [meta::relational::tests::mapping::relation::inlineJoin::filteredTarget::FilteredTargetDB]@FirmHq
  }

  Hq: Relational
  {
    ~mainTable [meta::relational::tests::mapping::relation::inlineJoin::filteredTarget::FilteredTargetDB]HqTable
    city: [meta::relational::tests::mapping::relation::inlineJoin::filteredTarget::FilteredTargetDB]HqTable.CITY
  }
)

