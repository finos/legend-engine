###Relational
Database meta::relational::tests::mapping::relation::inlineJoin::filteredTarget::FilteredTargetDB
(
  Table PersonTable
  (
    ID INTEGER PRIMARY KEY,
    NAME VARCHAR(100) NOT NULL,
    FIRMCODE VARCHAR(10),
    GROUPCODE VARCHAR(10)
  )
  Table FirmTable
  (
    ID INTEGER PRIMARY KEY,
    CODE VARCHAR(10) NOT NULL,
    NAME VARCHAR(100) NOT NULL,
    ACTIVE VARCHAR(1) NOT NULL,
    GROUPCODE VARCHAR(10),
    HQID INTEGER
  )
  Table HqTable
  (
    ID INTEGER PRIMARY KEY,
    CITY VARCHAR(50) NOT NULL
  )
  Table ProcessingPersonTable
  (
    milestoning
    (
      processing(PROCESSING_IN = IN_Z, PROCESSING_OUT = OUT_Z, INFINITY_DATE = %9999-12-31T00:00:00.0000)
    )
    ID INTEGER PRIMARY KEY,
    NAME VARCHAR(100) NOT NULL,
    FIRMCODE VARCHAR(10),
    GROUPCODE VARCHAR(10),
    IN_Z TIMESTAMP PRIMARY KEY,
    OUT_Z TIMESTAMP NOT NULL
  )
  Table ProcessingFirmTable
  (
    milestoning
    (
      processing(PROCESSING_IN = IN_Z, PROCESSING_OUT = OUT_Z, INFINITY_DATE = %9999-12-31T00:00:00.0000)
    )
    ID INTEGER PRIMARY KEY,
    CODE VARCHAR(10) NOT NULL,
    NAME VARCHAR(100) NOT NULL,
    ACTIVE VARCHAR(1) NOT NULL,
    GROUPCODE VARCHAR(10),
    IN_Z TIMESTAMP PRIMARY KEY,
    OUT_Z TIMESTAMP NOT NULL
  )
  Join PersonFirmByCode(PersonTable.FIRMCODE = FirmTable.CODE)
  Join PersonFirmByGroup(PersonTable.GROUPCODE = FirmTable.GROUPCODE)
  Join FirmHq(FirmTable.HQID = HqTable.ID)
  Join ProcessingPersonFirmByCode(ProcessingPersonTable.FIRMCODE = ProcessingFirmTable.CODE)
  Join ProcessingPersonFirmByGroup(ProcessingPersonTable.GROUPCODE = ProcessingFirmTable.GROUPCODE)
  Filter ActiveFirm(FirmTable.ACTIVE = 'Y')
  Filter ActiveProcessingFirm(ProcessingFirmTable.ACTIVE = 'Y')
)

