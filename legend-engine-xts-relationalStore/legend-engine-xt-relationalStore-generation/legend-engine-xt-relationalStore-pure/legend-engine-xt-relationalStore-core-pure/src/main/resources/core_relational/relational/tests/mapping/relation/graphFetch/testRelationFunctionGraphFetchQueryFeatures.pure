###Pure
import meta::pure::graphFetch::*;
import meta::pure::graphFetch::execution::*;
import meta::relational::metamodel::execute::*;
import meta::relational::tests::mapping::relation::graphFetch::features::*;

function <<test.BeforePackage>> meta::relational::tests::mapping::relation::graphFetch::features::setUp():Boolean[1]
{
  meta::relational::tests::mapping::relation::graphFetch::features::setUpTables();
}

function meta::relational::tests::mapping::relation::graphFetch::features::setUpTables():Boolean[1]
{
  let connection = meta::external::store::relational::tests::testRuntime(featuresDB).connectionByElement(featuresDB)->cast(@meta::external::store::relational::runtime::TestDatabaseConnection);
  executeInDb('Drop table if exists RFGF_FT_PERSON;', $connection);
  executeInDb('Create Table RFGF_FT_PERSON(ID INT, FIRSTNAME VARCHAR(100), AGE INT, FIRMID INT, EMPLOYEE_TYPE VARCHAR(20), STREET VARCHAR(100), CITY VARCHAR(100));', $connection);
  executeInDb('insert into RFGF_FT_PERSON values (1, \'Peter\',   23, 1, \'CONTRACT\',  \'Main St\',  \'New York\');', $connection);
  executeInDb('insert into RFGF_FT_PERSON values (2, \'John\',    30, 1, \'FULL_TIME\', \'Oak Ave\',  \'Chicago\');', $connection);
  executeInDb('insert into RFGF_FT_PERSON values (3, \'Jane\',    24, 2, \'SALARY\',    \'Pine Rd\',  \'Boston\');', $connection);
  executeInDb('insert into RFGF_FT_PERSON values (4, \'Fabrice\', 45, 3, \'FULL_TIME\', \'Elm Blvd\', \'Seattle\');', $connection);
  executeInDb('insert into RFGF_FT_PERSON values (5, \'Oliver\',  26, 3, \'CONTRACT\',  \'Lake Dr\',  \'Denver\');', $connection);
  executeInDb('insert into RFGF_FT_PERSON values (6, \'David\',   52, 3, \'CONTRACT\',  \'Hill St\',  \'Austin\');', $connection);
  executeInDb('Drop table if exists RFGF_FT_FIRM;', $connection);
  executeInDb('Create Table RFGF_FT_FIRM(ID INT, LEGALNAME VARCHAR(100));', $connection);
  executeInDb('insert into RFGF_FT_FIRM values (1, \'Firm X\');', $connection);
  executeInDb('insert into RFGF_FT_FIRM values (2, \'Firm A\');', $connection);
  executeInDb('insert into RFGF_FT_FIRM values (3, \'Firm C\');', $connection);
  true;
}

function meta::relational::tests::mapping::relation::graphFetch::features::runFeatures(query: FunctionDefinition<{->Any[*]}>[1], mapping: meta::pure::mapping::Mapping[1]):String[1]
{
  execute(
    $query,
    $mapping,
    meta::external::store::relational::tests::testRuntime(featuresDB),
    meta::relational::extension::relationalExtensions()
  ).values->toOne()->cast(@String);
}

function meta::relational::tests::mapping::relation::graphFetch::features::inferredPk(func: FunctionDefinition<Any>[1]):String[*]
{
  meta::relational::mapping::inferPrimaryKeyColumnNames($func.expressionSequence->evaluateAndDeactivate()->at(0));
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::features::testNestedChildEnumProperty():Boolean[1]
{
  let tree = #{Firm {legalName, employees {firstName, employeeType}}}#;
  assertJsonStringsEqual(
    '[{"legalName":"Firm X","employees":[{"firstName":"Peter","employeeType":"CONTRACT"},{"firstName":"John","employeeType":"FULL_TIME"}]},' +
    '{"legalName":"Firm A","employees":[{"firstName":"Jane","employeeType":"FULL_TIME"}]},' +
    '{"legalName":"Firm C","employees":[{"firstName":"Fabrice","employeeType":"FULL_TIME"},{"firstName":"Oliver","employeeType":"CONTRACT"},{"firstName":"David","employeeType":"CONTRACT"}]}]',
    runFeatures(|Firm.all()->graphFetch($tree)->serialize($tree), FeaturesMapping)
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::features::testNestedChildEmbeddedProperty():Boolean[1]
{
  let tree = #{Firm {legalName, employees {firstName, address {city}}}}#;
  assertJsonStringsEqual(
    '[{"legalName":"Firm X","employees":[{"firstName":"Peter","address":{"city":"New York"}},{"firstName":"John","address":{"city":"Chicago"}}]},' +
    '{"legalName":"Firm A","employees":[{"firstName":"Jane","address":{"city":"Boston"}}]},' +
    '{"legalName":"Firm C","employees":[{"firstName":"Fabrice","address":{"city":"Seattle"}},{"firstName":"Oliver","address":{"city":"Denver"}},{"firstName":"David","address":{"city":"Austin"}}]}]',
    runFeatures(|Firm.all()->graphFetch($tree)->serialize($tree), FeaturesMapping)
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::features::testNestedChildInlineEmbeddedProperty():Boolean[1]
{
  let tree = #{Firm {legalName, employees {firstName, address {street, city}}}}#;
  assertJsonStringsEqual(
    '[{"legalName":"Firm X","employees":[{"firstName":"Peter","address":{"street":"Main St","city":"New York"}},{"firstName":"John","address":{"street":"Oak Ave","city":"Chicago"}}]},' +
    '{"legalName":"Firm A","employees":[{"firstName":"Jane","address":{"street":"Pine Rd","city":"Boston"}}]},' +
    '{"legalName":"Firm C","employees":[{"firstName":"Fabrice","address":{"street":"Elm Blvd","city":"Seattle"}},{"firstName":"Oliver","address":{"street":"Lake Dr","city":"Denver"}},{"firstName":"David","address":{"street":"Hill St","city":"Austin"}}]}]',
    runFeatures(|Firm.all()->graphFetch($tree)->serialize($tree), InlineEmbeddedFeaturesMapping)
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::features::testBatchSizeOneWithNestedToOne():Boolean[1]
{
  let tree = #{Person {firstName, firm {legalName}}}#;
  assertJsonStringsEqual(
    '[{"firstName":"Peter","firm":{"legalName":"Firm X"}},{"firstName":"John","firm":{"legalName":"Firm X"}},' +
    '{"firstName":"Jane","firm":{"legalName":"Firm A"}},{"firstName":"Fabrice","firm":{"legalName":"Firm C"}},' +
    '{"firstName":"Oliver","firm":{"legalName":"Firm C"}},{"firstName":"David","firm":{"legalName":"Firm C"}}]',
    runFeatures(|Person.all()->graphFetch($tree, 1)->serialize($tree), FeaturesMapping)
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::features::testBatchSizeTwoWithNestedToMany():Boolean[1]
{
  let tree = #{Firm {legalName, employees {firstName}}}#;
  assertJsonStringsEqual(
    '[{"legalName":"Firm X","employees":[{"firstName":"Peter"},{"firstName":"John"}]},' +
    '{"legalName":"Firm A","employees":[{"firstName":"Jane"}]},' +
    '{"legalName":"Firm C","employees":[{"firstName":"Fabrice"},{"firstName":"Oliver"},{"firstName":"David"}]}]',
    runFeatures(|Firm.all()->graphFetch($tree, 2)->serialize($tree), FeaturesMapping)
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::features::testCheckedWithNestedChildNoDefects():Boolean[1]
{
  let tree = #{Person {firstName, firm {legalName}}}#;
  assertJsonStringsEqual(
    '[{"defects":[],"value":{"firstName":"Peter","firm":{"legalName":"Firm X"}}},' +
    '{"defects":[],"value":{"firstName":"John","firm":{"legalName":"Firm X"}}},' +
    '{"defects":[],"value":{"firstName":"Jane","firm":{"legalName":"Firm A"}}},' +
    '{"defects":[],"value":{"firstName":"Fabrice","firm":{"legalName":"Firm C"}}},' +
    '{"defects":[],"value":{"firstName":"Oliver","firm":{"legalName":"Firm C"}}},' +
    '{"defects":[],"value":{"firstName":"David","firm":{"legalName":"Firm C"}}}]',
    runFeatures(|Person.all()->graphFetchChecked($tree)->serialize($tree), FeaturesMapping)
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::features::testCheckedWithConstraintViolations():Boolean[1]
{
  let tree = #{ConstrainedPerson {firstName, age, employer {legalName}}}#;
  let under50 = '{"id":"under50","externalId":null,"message":"Age must be below 50","enforcementLevel":"Error","ruleType":"ClassConstraint","ruleDefinerPath":"meta::relational::tests::mapping::relation::graphFetch::features::ConstrainedPerson","path":[]}';
  let notFirmA = '{"id":"notFirmA","externalId":null,"message":"Employer must not be Firm A","enforcementLevel":"Error","ruleType":"ClassConstraint","ruleDefinerPath":"meta::relational::tests::mapping::relation::graphFetch::features::ConstrainedPerson","path":[]}';
  assertJsonStringsEqual(
    '[{"defects":[],"value":{"firstName":"Peter","age":23,"employer":{"legalName":"Firm X"}}},' +
    '{"defects":[],"value":{"firstName":"John","age":30,"employer":{"legalName":"Firm X"}}},' +
    '{"defects":[' + $notFirmA + '],"value":{"firstName":"Jane","age":24,"employer":{"legalName":"Firm A"}}},' +
    '{"defects":[],"value":{"firstName":"Fabrice","age":45,"employer":{"legalName":"Firm C"}}},' +
    '{"defects":[],"value":{"firstName":"Oliver","age":26,"employer":{"legalName":"Firm C"}}},' +
    '{"defects":[' + $under50 + '],"value":{"firstName":"David","age":52,"employer":{"legalName":"Firm C"}}}]',
    runFeatures(|ConstrainedPerson.all()->graphFetchChecked($tree)->serialize($tree), FeaturesMapping)
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::features::testCapturedLetVariableInRootFilter():Boolean[1]
{
  let tree = #{Person {firstName, firm {legalName}}}#;
  let name = 'Oliver';
  assertJsonStringsEqual(
    '{"firstName":"Oliver","firm":{"legalName":"Firm C"}}',
    runFeatures(|Person.all()->filter(p | $p.firstName == $name)->graphFetch($tree)->serialize($tree), FeaturesMapping)
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::features::testQueryParameterInRootFilter():Boolean[1]
{
  let query = {minAge: Integer[1] |
    Person.all()->filter(p | $p.age > $minAge)
      ->graphFetch(#{Person {firstName, firm {legalName}}}#)
      ->serialize(#{Person {firstName, firm {legalName}}}#)
      ->meta::pure::mapping::from(FeaturesMapping, meta::external::store::relational::tests::testRuntime(featuresDB))
  };
  let result = meta::legend::executeLegendQuery($query, [pair('minAge', '40')], ^meta::pure::runtime::ExecutionContext(), meta::relational::extension::relationalExtensions());
  assertJsonStringsEqual(
    '{"builder":{"_type":"json"},"values":[{"firstName":"Fabrice","firm":{"legalName":"Firm C"}},{"firstName":"David","firm":{"legalName":"Firm C"}}]}',
    $result
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::features::testRootFilterOnToOneAssociation():Boolean[1]
{
  let tree = #{Person {firstName, firm {legalName}}}#;
  assertJsonStringsEqual(
    '[{"firstName":"Fabrice","firm":{"legalName":"Firm C"}},{"firstName":"Oliver","firm":{"legalName":"Firm C"}},{"firstName":"David","firm":{"legalName":"Firm C"}}]',
    runFeatures(|Person.all()->filter(p | $p.firm.legalName == 'Firm C')->graphFetch($tree)->serialize($tree), FeaturesMapping)
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::features::testRootFilterOnToManyAssociationExists():Boolean[1]
{
  let tree = #{Firm {legalName, employees {firstName, age}}}#;
  assertJsonStringsEqual(
    '{"legalName":"Firm C","employees":[{"firstName":"Fabrice","age":45},{"firstName":"Oliver","age":26},{"firstName":"David","age":52}]}',
    runFeatures(|Firm.all()->filter(f | $f.employees->exists(e | $e.age > 50))->graphFetch($tree)->serialize($tree), FeaturesMapping)
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::features::testQualifierWithParameter():Boolean[1]
{
  let tree = #{Person {firstName, greetingWith('Hi')}}#;
  assertJsonStringsEqual(
    '[{"firstName":"Peter","greetingWith(\'Hi\')":"Hi Peter"},{"firstName":"John","greetingWith(\'Hi\')":"Hi John"},' +
    '{"firstName":"Jane","greetingWith(\'Hi\')":"Hi Jane"},{"firstName":"Fabrice","greetingWith(\'Hi\')":"Hi Fabrice"},' +
    '{"firstName":"Oliver","greetingWith(\'Hi\')":"Hi Oliver"},{"firstName":"David","greetingWith(\'Hi\')":"Hi David"}]',
    runFeatures(|Person.all()->graphFetch($tree)->serialize($tree), FeaturesMapping)
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::features::testQualifierNavigatingAssociation():Boolean[1]
{
  let tree = #{Person {firstName, firmName}}#;
  assertJsonStringsEqual(
    '[{"firstName":"Peter","firmName()":"Firm X"},{"firstName":"John","firmName()":"Firm X"},' +
    '{"firstName":"Jane","firmName()":"Firm A"},{"firstName":"Fabrice","firmName()":"Firm C"},' +
    '{"firstName":"Oliver","firmName()":"Firm C"},{"firstName":"David","firmName()":"Firm C"}]',
    runFeatures(|Person.all()->graphFetch($tree)->serialize($tree), FeaturesMapping)
  );
}

// ToFix: the filter inside the qualifier resolves AGE against the Firm relation-function sub-select instead of the joined Person one;
// the same query also fails under project(), so this is not graph-fetch specific.
function <<test.Test, test.AlloyOnly, test.ToFix>> meta::relational::tests::mapping::relation::graphFetch::features::testQualifierWithParameterReturningAssociatedClass():Boolean[1]
{
  let tree = #{Firm {legalName, employeesOlderThan(40) {firstName}}}#;
  assertJsonStringsEqual(
    '[{"legalName":"Firm X","employeesOlderThan(40)":[]},' +
    '{"legalName":"Firm A","employeesOlderThan(40)":[]},' +
    '{"legalName":"Firm C","employeesOlderThan(40)":[{"firstName":"Fabrice"},{"firstName":"David"}]}]',
    runFeatures(|Firm.all()->graphFetch($tree)->serialize($tree), FeaturesMapping)
  );
}

function <<test.Test>> meta::relational::tests::mapping::relation::graphFetch::features::testInferredPkOfGroupByDistinctAndWindowExtendFunctions():Boolean[1]
{
  assertEquals(['FIRMID'], inferredPk(firmStatsFn__Relation_1_));
  assertSameElements(['FIRMID', 'EMPLOYEE_TYPE'], inferredPk(firmRoleFn__Relation_1_));
  assertEquals(['ID'], inferredPk(rankedPersonFn__Relation_1_));
}

