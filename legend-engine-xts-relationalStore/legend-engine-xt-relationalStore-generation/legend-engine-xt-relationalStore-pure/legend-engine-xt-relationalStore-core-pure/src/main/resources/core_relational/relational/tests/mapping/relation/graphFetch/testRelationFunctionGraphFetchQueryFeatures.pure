function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::features::testAlloySerializationConfig():Boolean[1]
{
  let tree = #{Person {firstName, employeeType, address {city}}}#;
  let config = alloyConfig(true, true, false, false);
  let personType = '"@type":"meta::relational::tests::mapping::relation::graphFetch::features::Person"';
  let addressType = '"@type":"meta::relational::tests::mapping::relation::Address"';
  let enumPrefix = 'meta::relational::tests::mapping::relation::EmployeeType.';
  assertJsonStringsEqual(
    '[{' + $personType + ',"firstName":"Peter","employeeType":"' + $enumPrefix + 'CONTRACT","address":{' + $addressType + ',"city":"New York"}},' +
    '{' + $personType + ',"firstName":"John","employeeType":"' + $enumPrefix + 'FULL_TIME","address":{' + $addressType + ',"city":"Chicago"}},' +
    '{' + $personType + ',"firstName":"Jane","employeeType":"' + $enumPrefix + 'FULL_TIME","address":{' + $addressType + ',"city":"Boston"}},' +
    '{' + $personType + ',"firstName":"Fabrice","employeeType":"' + $enumPrefix + 'FULL_TIME","address":{' + $addressType + ',"city":"Seattle"}},' +
    '{' + $personType + ',"firstName":"Oliver","employeeType":"' + $enumPrefix + 'CONTRACT","address":{' + $addressType + ',"city":"Denver"}},' +
    '{' + $personType + ',"firstName":"David","employeeType":"' + $enumPrefix + 'CONTRACT","address":{' + $addressType + ',"city":"Austin"}}]',
    runFeatures(|Person.all()->graphFetch($tree)->serialize($tree, $config), NoLocalPropertiesMapping)
  );
}

// ToFix: @type is emitted as the synthesized mapping class (e.g. Person_FeaturesMapping_person) because the sets declare local
// mapping properties (+firmId/+id); plain Relational mappings with local properties behave the same way.
function <<test.Test, test.AlloyOnly, test.ToFix>> meta::relational::tests::mapping::relation::graphFetch::features::testAlloySerializationConfigWithNestedChild():Boolean[1]
{
  let tree = #{Person {firstName, employeeType, firm {legalName}}}#;
  let config = alloyConfig(true, true, false, false);
  let personType = '"@type":"meta::relational::tests::mapping::relation::graphFetch::features::Person"';
  let firmType = '"@type":"meta::relational::tests::mapping::relation::graphFetch::features::Firm"';
  let enumPrefix = 'meta::relational::tests::mapping::relation::EmployeeType.';
  assertJsonStringsEqual(
    '[{' + $personType + ',"firstName":"Peter","employeeType":"' + $enumPrefix + 'CONTRACT","firm":{' + $firmType + ',"legalName":"Firm X"}},' +
    '{' + $personType + ',"firstName":"John","employeeType":"' + $enumPrefix + 'FULL_TIME","firm":{' + $firmType + ',"legalName":"Firm X"}},' +
    '{' + $personType + ',"firstName":"Jane","employeeType":"' + $enumPrefix + 'FULL_TIME","firm":{' + $firmType + ',"legalName":"Firm A"}},' +
    '{' + $personType + ',"firstName":"Fabrice","employeeType":"' + $enumPrefix + 'FULL_TIME","firm":{' + $firmType + ',"legalName":"Firm C"}},' +
    '{' + $personType + ',"firstName":"Oliver","employeeType":"' + $enumPrefix + 'CONTRACT","firm":{' + $firmType + ',"legalName":"Firm C"}},' +
    '{' + $personType + ',"firstName":"David","employeeType":"' + $enumPrefix + 'CONTRACT","firm":{' + $firmType + ',"legalName":"Firm C"}}]',
    runFeatures(|Person.all()->graphFetch($tree)->serialize($tree, $config), FeaturesMapping)
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::features::testSortByAndTakeBeforeGraphFetch():Boolean[1]
{
  let tree = #{Person {firstName, age, firm {legalName}}}#;
  assertJsonStringsEqual(
    '[{"firstName":"Peter","age":23,"firm":{"legalName":"Firm X"}},' +
    '{"firstName":"Jane","age":24,"firm":{"legalName":"Firm A"}},' +
    '{"firstName":"Oliver","age":26,"firm":{"legalName":"Firm C"}}]',
    runFeatures(|Person.all()->sortBy(p | $p.age)->take(3)->graphFetch($tree)->serialize($tree), FeaturesMapping)
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::features::testSortByAssociationBeforeGraphFetch():Boolean[1]
{
  let tree = #{Person {firstName, firm {legalName}}}#;
  assertJsonStringsEqual(
    '[{"firstName":"Jane","firm":{"legalName":"Firm A"}},' +
    '{"firstName":"David","firm":{"legalName":"Firm C"}}]',
    runFeatures(|Person.all()->filter(p | $p.age > 50 || $p.firm.legalName == 'Firm A')->sortBy(p | $p.firm.legalName)->graphFetch($tree)->serialize($tree), FeaturesMapping)
  );
}
