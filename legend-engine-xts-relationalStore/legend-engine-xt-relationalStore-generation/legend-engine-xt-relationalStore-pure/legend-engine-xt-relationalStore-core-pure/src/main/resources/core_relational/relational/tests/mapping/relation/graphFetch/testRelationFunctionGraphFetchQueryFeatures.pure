###Relational
Database meta::relational::tests::mapping::relation::graphFetch::features::featuresDB
(
  Table RFGF_FT_PERSON
  (
    ID INTEGER PRIMARY KEY,
    FIRSTNAME VARCHAR(100) NOT NULL,
    AGE INTEGER NOT NULL,
    FIRMID INTEGER NOT NULL,
    EMPLOYEE_TYPE VARCHAR(20) NOT NULL,
    STREET VARCHAR(100) NOT NULL,
    CITY VARCHAR(100) NOT NULL
  )

  Table RFGF_FT_FIRM
  (
    ID INTEGER PRIMARY KEY,
    LEGALNAME VARCHAR(100) NOT NULL
  )
)

###Pure
Class meta::relational::tests::mapping::relation::graphFetch::features::Person
{
  firstName: String[1];
  age: Integer[1];
  employeeType: meta::relational::tests::mapping::relation::EmployeeType[1];
  address: meta::relational::tests::mapping::relation::Address[1];
  greetingWith(prefix: String[1]) {$prefix + ' ' + $this.firstName}: String[1];
  firmName() {$this.firm.legalName}: String[1];
}

Class meta::relational::tests::mapping::relation::graphFetch::features::Firm
{
  legalName: String[1];
  employeesOlderThan(minAge: Integer[1]) {$this.employees->filter(e | $e.age > $minAge)}: meta::relational::tests::mapping::relation::graphFetch::features::Person[*];
}

Association meta::relational::tests::mapping::relation::graphFetch::features::Person_Firm
{
  employees: meta::relational::tests::mapping::relation::graphFetch::features::Person[*];
  firm: meta::relational::tests::mapping::relation::graphFetch::features::Firm[1];
}

Class meta::relational::tests::mapping::relation::graphFetch::features::ConstrainedPerson
[
  under50
  (
    ~function: $this.age < 50
    ~enforcementLevel: Error
    ~message: 'Age must be below 50'
  ),
  notFirmA
  (
    ~function: $this.employer.legalName != 'Firm A'
    ~enforcementLevel: Error
    ~message: 'Employer must not be Firm A'
  )
]
{
  firstName: String[1];
  age: Integer[1];
}

Association meta::relational::tests::mapping::relation::graphFetch::features::ConstrainedPerson_Firm
{
  constrainedEmployees: meta::relational::tests::mapping::relation::graphFetch::features::ConstrainedPerson[*];
  employer: meta::relational::tests::mapping::relation::graphFetch::features::Firm[1];
}

Class meta::relational::tests::mapping::relation::graphFetch::features::FirmStats
{
  firmId: Integer[1];
  headcount: Integer[1];
  totalAge: Integer[1];
}

Association meta::relational::tests::mapping::relation::graphFetch::features::FirmStats_Firm
{
  stats: meta::relational::tests::mapping::relation::graphFetch::features::FirmStats[0..1];
  statsFirm: meta::relational::tests::mapping::relation::graphFetch::features::Firm[1];
}

Class meta::relational::tests::mapping::relation::graphFetch::features::FirmRole
{
  firmId: Integer[1];
  role: String[1];
}

Association meta::relational::tests::mapping::relation::graphFetch::features::FirmRole_Firm
{
  roles: meta::relational::tests::mapping::relation::graphFetch::features::FirmRole[*];
  roleFirm: meta::relational::tests::mapping::relation::graphFetch::features::Firm[1];
}

Class meta::relational::tests::mapping::relation::graphFetch::features::RankedPerson
{
  firstName: String[1];
  ageRankInFirm: Integer[1];
  upperName: String[1];
}

Association meta::relational::tests::mapping::relation::graphFetch::features::RankedPerson_Firm
{
  rankedEmployees: meta::relational::tests::mapping::relation::graphFetch::features::RankedPerson[*];
  rankedFirm: meta::relational::tests::mapping::relation::graphFetch::features::Firm[1];
}

function meta::relational::tests::mapping::relation::graphFetch::features::personFn(): meta::pure::metamodel::relation::Relation<Any>[1]
{
  #>{meta::relational::tests::mapping::relation::graphFetch::features::featuresDB.RFGF_FT_PERSON}#
    ->select(~[ID, FIRSTNAME, AGE, FIRMID, EMPLOYEE_TYPE, STREET, CITY])
}

function meta::relational::tests::mapping::relation::graphFetch::features::firmFn(): meta::pure::metamodel::relation::Relation<Any>[1]
{
  #>{meta::relational::tests::mapping::relation::graphFetch::features::featuresDB.RFGF_FT_FIRM}#
    ->select(~[ID, LEGALNAME])
}

function meta::relational::tests::mapping::relation::graphFetch::features::personSrc(): meta::pure::metamodel::relation::Relation<(ID:Integer, FIRSTNAME:String, AGE:Integer, FIRMID:Integer)>[1]
{
  #>{meta::relational::tests::mapping::relation::graphFetch::features::featuresDB.RFGF_FT_PERSON}#
    ->select(~[ID, FIRSTNAME, AGE, FIRMID])
}

function meta::relational::tests::mapping::relation::graphFetch::features::firmSrc(): meta::pure::metamodel::relation::Relation<(ID:Integer, LEGALNAME:String)>[1]
{
  #>{meta::relational::tests::mapping::relation::graphFetch::features::featuresDB.RFGF_FT_FIRM}#
    ->select(~[ID, LEGALNAME])
}

function meta::relational::tests::mapping::relation::graphFetch::features::firmStatsFn(): meta::pure::metamodel::relation::Relation<Any>[1]
{
  #>{meta::relational::tests::mapping::relation::graphFetch::features::featuresDB.RFGF_FT_PERSON}#
    ->groupBy(~FIRMID, ~[HEADCOUNT: x | $x.ID : y | $y->count(), TOTAL_AGE: x | $x.AGE : y | $y->sum()])
    ->sort(~FIRMID->ascending())
}

function meta::relational::tests::mapping::relation::graphFetch::features::firmRoleFn(): meta::pure::metamodel::relation::Relation<Any>[1]
{
  #>{meta::relational::tests::mapping::relation::graphFetch::features::featuresDB.RFGF_FT_PERSON}#
    ->distinct(~[FIRMID, EMPLOYEE_TYPE])
    ->sort([~FIRMID->ascending(), ~EMPLOYEE_TYPE->ascending()])
}

function meta::relational::tests::mapping::relation::graphFetch::features::rankedPersonFn(): meta::pure::metamodel::relation::Relation<Any>[1]
{
  #>{meta::relational::tests::mapping::relation::graphFetch::features::featuresDB.RFGF_FT_PERSON}#
    ->extend(over(~FIRMID, ~AGE->descending()), ~[AGE_RANK: {p, w, r | $p->rank($w, $r)}])
    ->extend(~UPPER_NAME: x | $x.FIRSTNAME->toOne()->toUpper())
    ->sort(~ID->ascending())
}

###Mapping
import meta::relational::tests::mapping::relation::*;
import meta::relational::tests::mapping::relation::graphFetch::features::*;

Mapping meta::relational::tests::mapping::relation::graphFetch::features::FeaturesMapping
(
  *meta::relational::tests::mapping::relation::graphFetch::features::Person[person]: Relation
  {
    ~func meta::relational::tests::mapping::relation::graphFetch::features::personFn():Relation<Any>[1]
    firstName: FIRSTNAME,
    age: AGE,
    +firmId: Integer[1]: FIRMID,
    employeeType: EnumerationMapping employeeTypeMapping: EMPLOYEE_TYPE,
    address
    (
      street: STREET,
      city: CITY
    )
  }

  *meta::relational::tests::mapping::relation::graphFetch::features::Firm[firm]: Relation
  {
    ~func meta::relational::tests::mapping::relation::graphFetch::features::firmFn():Relation<Any>[1]
    legalName: LEGALNAME,
    +id: Integer[1]: ID
  }

  *meta::relational::tests::mapping::relation::graphFetch::features::ConstrainedPerson[constrainedPerson]: Relation
  {
    ~func meta::relational::tests::mapping::relation::graphFetch::features::personFn():Relation<Any>[1]
    firstName: FIRSTNAME,
    age: AGE,
    +firmId: Integer[1]: FIRMID
  }

  *meta::relational::tests::mapping::relation::graphFetch::features::FirmStats[firmStats]: Relation
  {
    ~func meta::relational::tests::mapping::relation::graphFetch::features::firmStatsFn():Relation<Any>[1]
    firmId: FIRMID,
    headcount: HEADCOUNT,
    totalAge: TOTAL_AGE
  }

  *meta::relational::tests::mapping::relation::graphFetch::features::FirmRole[firmRole]: Relation
  {
    ~func meta::relational::tests::mapping::relation::graphFetch::features::firmRoleFn():Relation<Any>[1]
    firmId: FIRMID,
    role: EMPLOYEE_TYPE
  }

  *meta::relational::tests::mapping::relation::graphFetch::features::RankedPerson[rankedPerson]: Relation
  {
    ~func meta::relational::tests::mapping::relation::graphFetch::features::rankedPersonFn():Relation<Any>[1]
    firstName: FIRSTNAME,
    ageRankInFirm: AGE_RANK,
    upperName: UPPER_NAME,
    +firmId: Integer[1]: FIRMID
  }

  meta::relational::tests::mapping::relation::graphFetch::features::Person_Firm: ModelJoin
{
  {employees: meta::relational::tests::mapping::relation::Person[1], firm: meta::relational::tests::mapping::relation::Firm[1] | $firm.id == $employees.firmId}
}

  meta::relational::tests::mapping::relation::graphFetch::features::ConstrainedPerson_Firm: ModelJoin
{
  {constrainedEmployees: meta::relational::tests::mapping::relation::graphFetch::features::ConstrainedPerson[1], employer: meta::relational::tests::mapping::relation::graphFetch::features::Firm[1] | $employer.id == $constrainedEmployees.firmId}
}

  meta::relational::tests::mapping::relation::graphFetch::features::FirmStats_Firm: ModelJoin
{
  {stats: meta::relational::tests::mapping::relation::graphFetch::features::FirmStats[1], statsFirm: meta::relational::tests::mapping::relation::graphFetch::features::Firm[1] | $statsFirm.id == $stats.firmId}
}

  meta::relational::tests::mapping::relation::graphFetch::features::FirmRole_Firm: ModelJoin
{
  {roles: meta::relational::tests::mapping::relation::graphFetch::features::FirmRole[1], roleFirm: meta::relational::tests::mapping::relation::graphFetch::features::Firm[1] | $roleFirm.id == $roles.firmId}
}

  meta::relational::tests::mapping::relation::graphFetch::features::RankedPerson_Firm: ModelJoin
{
  {rankedEmployees: meta::relational::tests::mapping::relation::graphFetch::features::RankedPerson[1], rankedFirm: meta::relational::tests::mapping::relation::graphFetch::features::Firm[1] | $rankedFirm.id == $rankedEmployees.firmId}
}

  meta::relational::tests::mapping::relation::EmployeeType: EnumerationMapping employeeTypeMapping
  {
    CONTRACT: 'CONTRACT',
    FULL_TIME: ['SALARY', 'FULL_TIME']
  }
)

