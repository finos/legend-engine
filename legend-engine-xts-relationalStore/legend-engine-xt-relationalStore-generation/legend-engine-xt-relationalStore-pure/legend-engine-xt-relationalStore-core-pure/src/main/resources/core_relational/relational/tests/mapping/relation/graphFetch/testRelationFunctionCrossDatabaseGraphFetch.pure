###Pure
import meta::relational::tests::mapping::relation::crossDb::*;

Class meta::relational::tests::mapping::relation::crossDb::Firm
{
   legalName : String[1];
}

Class meta::relational::tests::mapping::relation::crossDb::Employee
{
   name : String[1];
}

Class meta::relational::tests::mapping::relation::crossDb::Ceo
{
   id   : Integer[1];
   name : String[1];
}

Association meta::relational::tests::mapping::relation::crossDb::EmploymentAssociation
{
   firm      : Firm[0..1];
   employees : Employee[*];
}

Association meta::relational::tests::mapping::relation::crossDb::CeoAssociation
{
   firm : Firm[0..1];
   ceo  : Ceo[1];
}

###Relational
Database meta::relational::tests::mapping::relation::crossDb::RfpmFirmDB
(
   // Key columns are NOT NULL so the RFPM lift maps them to [1] properties cleanly (the lift path is
   // stricter about nullable-column -> [1]-property than plain Relational).
   Table firm(id INT PRIMARY KEY, legalName VARCHAR(100) NOT NULL, ceoIdentifier INT NOT NULL)
)

###Relational
Database meta::relational::tests::mapping::relation::crossDb::RfpmEmployeeDB
(
   Table employee(name VARCHAR(100) PRIMARY KEY, ceoId INT NOT NULL)

   Table ceo(name VARCHAR(100) PRIMARY KEY, identifier INT NOT NULL)
)

###Pure
function meta::relational::tests::mapping::relation::crossDb::firmFunction(): meta::pure::metamodel::relation::Relation<Any>[1]
{
   #>{meta::relational::tests::mapping::relation::crossDb::RfpmFirmDB.firm}#
}

function meta::relational::tests::mapping::relation::crossDb::employeeFunction(): meta::pure::metamodel::relation::Relation<Any>[1]
{
   #>{meta::relational::tests::mapping::relation::crossDb::RfpmEmployeeDB.employee}#
}

function meta::relational::tests::mapping::relation::crossDb::ceoFunction(): meta::pure::metamodel::relation::Relation<Any>[1]
{
   #>{meta::relational::tests::mapping::relation::crossDb::RfpmEmployeeDB.ceo}#
}

###Mapping
import meta::relational::tests::mapping::relation::crossDb::*;

Mapping meta::relational::tests::mapping::relation::crossDb::RfpmCrossDatabaseMapping
(
   Firm[firm] : Relation
   {
      ~func meta::relational::tests::mapping::relation::crossDb::firmFunction__Relation_1_
      +ceoId : Integer[1] : ceoIdentifier,
      legalName : legalName
   }

   Employee[employee] : Relation
   {
      ~func meta::relational::tests::mapping::relation::crossDb::employeeFunction__Relation_1_
      +ceoId : Integer[1] : ceoId,
      name : name
   }

   Ceo[ceo] : Relation
   {
      ~func meta::relational::tests::mapping::relation::crossDb::ceoFunction__Relation_1_
      +ceoId : Integer[1] : identifier,
      id : identifier,
      name : name
   }

   CeoAssociation : XStore
   {
      ceo[firm, ceo] : $this.ceoId == $that.ceoId
   }

   EmploymentAssociation : XStore
   {
      employees[firm, employee] : $this.ceoId == $that.ceoId
   }
)

###Pure
import meta::pure::graphFetch::execution::*;
import meta::core::runtime::*;
import meta::relational::metamodel::execute::*;
import meta::external::store::relational::runtime::*;
import meta::relational::runtime::*;
import meta::relational::tests::mapping::relation::crossDb::*;

function <<test.BeforePackage>> meta::relational::tests::mapping::relation::crossDb::setUpCrossDbs():Any[*]
{
   let runtime1 = meta::external::store::relational::tests::testRuntime(RfpmEmployeeDB);
   let connection1 = $runtime1.connectionStores.connection->toOne()->cast(@meta::external::store::relational::runtime::DatabaseConnection);

   executeInDb('Drop table if exists employee;', $connection1);
   executeInDb('Create Table employee(name VARCHAR(100), ceoId INT);', $connection1);
   executeInDb('Insert into employee values (\'E1\', 1);', $connection1);
   executeInDb('Insert into employee values (\'E2\', 1);', $connection1);
   executeInDb('Insert into employee values (\'E3\', 2);', $connection1);

   executeInDb('Drop table if exists ceo;', $connection1);
   executeInDb('Create Table ceo(name VARCHAR(100), identifier INT);', $connection1);
   executeInDb('Insert into ceo values (\'C1\', 1);', $connection1);
   executeInDb('Insert into ceo values (\'C2\', 2);', $connection1);

   let runtime2 = meta::external::store::relational::tests::testRuntime(RfpmFirmDB);
   let connection2 = $runtime2.connectionStores.connection->toOne()->cast(@meta::external::store::relational::runtime::DatabaseConnection);

   executeInDb('Drop table if exists firm;', $connection2);
   executeInDb('Create Table firm(id INT, legalName VARCHAR(100), ceoIdentifier INT);', $connection2);
   executeInDb('Insert into firm values (1, \'F1\', 1);', $connection2);
   executeInDb('Insert into firm values (2, \'F2\', 2);', $connection2);
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::crossDb::testRelationFunctionCrossDatabaseGraphFetch():Boolean[1]
{
   let tree = #{
      Firm {
         legalName,
         ceo {
            name
         },
         employees {
            name
         }
      }
   }#;

   let runtime = ^Runtime(connectionStores = meta::external::store::relational::tests::testRuntime(RfpmEmployeeDB)->concatenate(meta::external::store::relational::tests::testRuntime(RfpmFirmDB)).connectionStores);

   let result = execute(
      {|Firm.all()->graphFetch($tree)->serialize($tree)},
      RfpmCrossDatabaseMapping,
      $runtime,
      meta::relational::extension::relationalExtensions()
   ).values;

   assertJsonStringsEqual(
      '[' +
         '{"legalName":"F1","ceo":{"name":"C1"},"employees":[{"name":"E1"},{"name":"E2"}]},' +
         '{"legalName":"F2","ceo":{"name":"C2"},"employees":[{"name":"E3"}]}' +
      ']',
      $result
   );
}
