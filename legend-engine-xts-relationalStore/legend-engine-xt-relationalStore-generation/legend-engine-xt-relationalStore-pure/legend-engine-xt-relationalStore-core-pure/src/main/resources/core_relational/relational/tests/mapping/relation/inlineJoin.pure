###Relational
Database meta::relational::tests::mapping::relation::inlineJoin::JoinDB
(
  Table PersonTable
  (
    ID INTEGER PRIMARY KEY,
    FIRSTNAME VARCHAR(100) NOT NULL,
    FIRMID INTEGER NOT NULL
  )
  Table FirmTable
  (
    ID INTEGER PRIMARY KEY,
    LEGALNAME VARCHAR(100) NOT NULL
  )
  Table ChainPersonTable
  (
    ID INTEGER PRIMARY KEY,
    FIRSTNAME VARCHAR(100) NOT NULL,
    FIRMID INTEGER NOT NULL,
    COUNTRYID INTEGER NOT NULL
  )
  Table ChainFirmTable
  (
    ID INTEGER PRIMARY KEY,
    LEGALNAME VARCHAR(100) NOT NULL,
    COUNTRYID INTEGER NOT NULL
  )
  Table CountryTable
  (
    ID INTEGER PRIMARY KEY,
    COUNTRYNAME VARCHAR(100) NOT NULL
  )
)

