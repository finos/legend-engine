function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::testNavigationJoinToProcessingTemporalTargetAtLatest():Boolean[1]
{
  let result = executionPlan(
    {|ProcessingProduct.all(%latest)->project([p | $p.market], ['market'])},
