    meta::external::store::relational::tests::testRuntime(JoinDB),
    meta::relational::extension::relationalExtensions()
  );
  assertSameSQL(
    'select "processinglistingtable_0".MARKET as "market" from (select "processingproducttable_1".ID as ID, "processingproducttable_1".NAME as NAME, "processingproducttable_1".IN_Z as IN_Z, "processingproducttable_1".OUT_Z as OUT_Z, \'9999-12-31T00:00:00.0000+0000\' as "k_processingDate" from ProcessingProductTable as "processingproducttable_1" where "processingproducttable_1".OUT_Z = TIMESTAMP\'9999-12-31 00:00:00.0000\') as "processingproducttable_0" left outer join (select "processinglistingtable_1".PRODUCTID as PRODUCTID, "processinglistingtable_1".MARKET as MARKET, "processinglistingtable_1".EXCHANGEID as EXCHANGEID, "processinglistingtable_1".IN_Z as IN_Z, "processinglistingtable_1".OUT_Z as OUT_Z, \'9999-12-31T00:00:00.0000+0000\' as "k_processingDate" from ProcessingListingTable as "processinglistingtable_1" where "processinglistingtable_1".OUT_Z = TIMESTAMP\'9999-12-31 00:00:00.0000\') as "processinglistingtable_0" on ("processingproducttable_0".ID = "processinglistingtable_0".PRODUCTID)',
    $result.rootExecutionNode.executionNodes->at(0)->cast(@meta::relational::mapping::SQLExecutionNode).sqlQuery
  );
}

