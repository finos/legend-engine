function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::testGraphFetchThroughModelJoinKeyedOnInnerNavigationJoinReadsTheTargetColumns():Boolean[1]
{
  let tree = #{Person {firstName, firmRef {id, legalName}}}#;
  let result = executionPlan(
    {|Person.all()->graphFetch($tree)->serialize($tree)},
    InnerKeyedModelJoinMapping,
    meta::external::store::relational::tests::testRuntime(JoinDB),
    meta::relational::extension::relationalExtensions()
  );
  let firmNode = $result.rootExecutionNode.executionNodes->at(0)->cast(@meta::pure::graphFetch::executionPlan::StoreMappingGlobalGraphFetchExecutionNode)
                   .localGraphFetchExecutionNode->cast(@meta::relational::graphFetch::executionPlan::RelationalGraphFetchExecutionNode).children->toOne();
  assertSameSQL(
    'select distinct "temp_table_node_0_0".pk_0 as "parent_key_gen_0", "persontable_3"."ID_1" as "pk_0", "persontable_3"."ID_1" as "id", "persontable_3"."LEGALNAME" as "legalName" from (select * from (${temp_table_node_0}) as "root") as "temp_table_node_0_0" inner join (select "persontable_1".ID as "ID", "persontable_1".FIRSTNAME as "FIRSTNAME", "persontable_1".FIRMID as "FIRMID" from (select "persontable_2".ID as ID, "persontable_2".FIRSTNAME as FIRSTNAME, "persontable_2".FIRMID as FIRMID from PersonTable as "persontable_2") as "persontable_1") as "root" on ("temp_table_node_0_0".pk_0 = "root"."ID") left outer join (select "persontable_1".ID as "ID", "persontable_1".FIRSTNAME as "FIRSTNAME", "persontable_1".FIRMID as "FIRMID", "firmtable_2"."ID" as "ID_1", "firmtable_2"."LEGALNAME" as "LEGALNAME" from (select "persontable_2".ID as ID, "persontable_2".FIRSTNAME as FIRSTNAME, "persontable_2".FIRMID as FIRMID from PersonTable as "persontable_2") as "persontable_1" inner join (select "firmtable_1".ID as ID, "firmtable_1".LEGALNAME as LEGALNAME from FirmTable as "firmtable_1") as "firmtable_0" on ("persontable_1".FIRMID = "firmtable_0".ID) left outer join (select "firmtable_3".ID as "ID", "firmtable_3".LEGALNAME as "LEGALNAME" from (select "firmtable_4".ID as ID, "firmtable_4".LEGALNAME as LEGALNAME from FirmTable as "firmtable_4") as "firmtable_3") as "firmtable_2" on ("firmtable_0".ID = "firmtable_2"."ID")) as "persontable_3" on ("root"."ID" = "persontable_3"."ID") where "persontable_3"."ID_1" is not null',
    $firmNode.executionNodes->toOne()->cast(@meta::relational::mapping::SQLExecutionNode).sqlQuery
  );
}

// filterJoin->navigationJoin: gate person rows on a matching firm, then navigate (via the
// person's own COUNTRYID, not through the firm) to the country name.
function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::testChainedFilterJoinThenNavigationJoin():Boolean[1]
{
  let result = executionPlan(
    {|Person.all()->project([p | $p.countryNameForMatchedFirm], ['countryNameForMatchedFirm'])},
    ChainedJoinMapping,
    meta::external::store::relational::tests::testRuntime(JoinDB),
    meta::relational::extension::relationalExtensions()
  );
  assertSameSQL(
    'select "chainpersontable_2".COUNTRYNAME as "countryNameForMatchedFirm" from (select "chainpersontable_1".ID as ID, "chainpersontable_1".FIRSTNAME as FIRSTNAME, "chainpersontable_1".FIRMID as FIRMID, "chainpersontable_1".COUNTRYID as COUNTRYID from ChainPersonTable as "chainpersontable_1") as "chainpersontable_0" left outer join (select "chainpersontable_3".ID as relJoinKey_ID, "countrytable_0".ID as "ID", "countrytable_0".COUNTRYNAME as "COUNTRYNAME" from (select "chainpersontable_4".ID as ID, "chainpersontable_4".FIRSTNAME as FIRSTNAME, "chainpersontable_4".FIRMID as FIRMID, "chainpersontable_4".COUNTRYID as COUNTRYID from ChainPersonTable as "chainpersontable_4") as "chainpersontable_3" inner join (select "chainfirmtable_1".ID as ID, "chainfirmtable_1".LEGALNAME as LEGALNAME, "chainfirmtable_1".COUNTRYID as COUNTRYID from ChainFirmTable as "chainfirmtable_1") as "chainfirmtable_0" on ("chainpersontable_3".FIRMID = "chainfirmtable_0".ID) left outer join (select "countrytable_1".ID as ID, "countrytable_1".COUNTRYNAME as COUNTRYNAME from CountryTable as "countrytable_1") as "countrytable_0" on ("chainpersontable_3".COUNTRYID = "countrytable_0".ID)) as "chainpersontable_2" on ("chainpersontable_0".ID is not distinct from "chainpersontable_2".relJoinKey_ID)',
    $result.rootExecutionNode.executionNodes->at(0)->cast(@meta::relational::mapping::SQLExecutionNode).sqlQuery
  );
}

