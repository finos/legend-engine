  );
  assertSameSQL(
    'select "businessproducttable_2".EXCHANGENAME as "exchangeName" from (select "businessproducttable_1".ID as ID, "businessproducttable_1".NAME as NAME, "businessproducttable_1".FROM_Z as FROM_Z, "businessproducttable_1".THRU_Z as THRU_Z, \'2022-06-01\' as "k_businessDate" from BusinessProductTable as "businessproducttable_1" where "businessproducttable_1".FROM_Z <= DATE\'2022-06-01\' and "businessproducttable_1".THRU_Z > DATE\'2022-06-01\') as "businessproducttable_0" left outer join (select "businessproducttable_3".ID as relJoinKey_ID, "businessproducttable_3".FROM_Z as relJoinKey_FROM_Z, "exchangetable_0".ID as "ID", "exchangetable_0".EXCHANGENAME as "EXCHANGENAME" from (select "businessproducttable_4".ID as ID, "businessproducttable_4".NAME as NAME, "businessproducttable_4".FROM_Z as FROM_Z, "businessproducttable_4".THRU_Z as THRU_Z, \'2022-06-01\' as "k_businessDate" from BusinessProductTable as "businessproducttable_4" where "businessproducttable_4".FROM_Z <= DATE\'2022-06-01\' and "businessproducttable_4".THRU_Z > DATE\'2022-06-01\') as "businessproducttable_3" left outer join (select "businesslistingtable_1".PRODUCTID as PRODUCTID, "businesslistingtable_1".MARKET as MARKET, "businesslistingtable_1".EXCHANGEID as EXCHANGEID, "businesslistingtable_1".FROM_Z as FROM_Z, "businesslistingtable_1".THRU_Z as THRU_Z, \'2022-06-01\' as "k_businessDate" from BusinessListingTable as "businesslistingtable_1" where "businesslistingtable_1".FROM_Z <= DATE\'2022-06-01\' and "businesslistingtable_1".THRU_Z > DATE\'2022-06-01\') as "businesslistingtable_0" on ("businessproducttable_3".ID = "businesslistingtable_0".PRODUCTID) left outer join (select "exchangetable_1".ID as ID, "exchangetable_1".EXCHANGENAME as EXCHANGENAME, \'2022-06-01\' as "k_businessDate" from ExchangeTable as "exchangetable_1") as "exchangetable_0" on ("businesslistingtable_0".EXCHANGEID = "exchangetable_0".ID)) as "businessproducttable_2" on ("businessproducttable_0".FROM_Z is not distinct from "businessproducttable_2".relJoinKey_FROM_Z and "businessproducttable_0".ID is not distinct from "businessproducttable_2".relJoinKey_ID)',
    $result.rootExecutionNode.executionNodes->at(0)->cast(@meta::relational::mapping::SQLExecutionNode).sqlQuery
  );
}

