    'select "chainpersontable_2".COUNTRYNAME as "aboveOne", "chainpersontable_5".COUNTRYNAME as "aboveTwo" from (select "chainpersontable_1".ID as ID, "chainpersontable_1".FIRSTNAME as FIRSTNAME, "chainpersontable_1".FIRMID as FIRMID, "chainpersontable_1".COUNTRYID as COUNTRYID from ChainPersonTable as "chainpersontable_1") as "chainpersontable_0" left outer join (select "chainpersontable_3".ID as relJoinKey_ID, "countrytable_0".ID as "ID", "countrytable_0".COUNTRYNAME as "COUNTRYNAME" from (select "chainpersontable_4".ID as ID, "chainpersontable_4".FIRSTNAME as FIRSTNAME, "chainpersontable_4".FIRMID as FIRMID, "chainpersontable_4".COUNTRYID as COUNTRYID from ChainPersonTable as "chainpersontable_4") as "chainpersontable_3" left outer join (select "chainfirmtable_1".ID as ID, "chainfirmtable_1".LEGALNAME as LEGALNAME, "chainfirmtable_1".COUNTRYID as COUNTRYID from ChainFirmTable as "chainfirmtable_1" where "chainfirmtable_1".ID > 1) as "chainfirmtable_0" on ("chainpersontable_3".FIRMID = "chainfirmtable_0".ID) left outer join (select "countrytable_1".ID as ID, "countrytable_1".COUNTRYNAME as COUNTRYNAME from CountryTable as "countrytable_1") as "countrytable_0" on ("chainfirmtable_0".COUNTRYID = "countrytable_0".ID)) as "chainpersontable_2" on ("chainpersontable_0".ID is not distinct from "chainpersontable_2".relJoinKey_ID) left outer join (select "chainpersontable_3".ID as relJoinKey_ID, "countrytable_0".ID as "ID", "countrytable_0".COUNTRYNAME as "COUNTRYNAME" from (select "chainpersontable_4".ID as ID, "chainpersontable_4".FIRSTNAME as FIRSTNAME, "chainpersontable_4".FIRMID as FIRMID, "chainpersontable_4".COUNTRYID as COUNTRYID from ChainPersonTable as "chainpersontable_4") as "chainpersontable_3" left outer join (select "chainfirmtable_1".ID as ID, "chainfirmtable_1".LEGALNAME as LEGALNAME, "chainfirmtable_1".COUNTRYID as COUNTRYID from ChainFirmTable as "chainfirmtable_1" where "chainfirmtable_1".ID > 2) as "chainfirmtable_0" on ("chainpersontable_3".FIRMID = "chainfirmtable_0".ID) left outer join (select "countrytable_1".ID as ID, "countrytable_1".COUNTRYNAME as COUNTRYNAME from CountryTable as "countrytable_1") as "countrytable_0" on ("chainfirmtable_0".COUNTRYID = "countrytable_0".ID)) as "chainpersontable_5" on ("chainpersontable_0".ID is not distinct from "chainpersontable_5".relJoinKey_ID)',
    $result.rootExecutionNode.executionNodes->at(0)->cast(@meta::relational::mapping::SQLExecutionNode).sqlQuery
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::testModelJoinToMilestonedTargetReadAtTwoDatesIsNotDeduped():Boolean[1]
{
