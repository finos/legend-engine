function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::testModelJoinInheritedThroughExtendsOnAUnionOfLeavesJoinsFromEachBranch():Boolean[1]
{
  let result = executionPlan(
    {|Stock.all()->project([s | $s.id, s | $s.sharesOutstanding.amount], ['id', 'amount'])},
    ExtendsMapping,
    meta::external::store::relational::tests::testRuntime(JoinDB),
    meta::relational::extension::relationalExtensions()
  );
  assertSameSQL(
    'select "unionBase"."rf(product)ID_rf(product)ID" as "id", "sharestable_0"."AMOUNT" as "amount" from (select "producttable_0".ID as "rf(product)ID_rf(product)ID", "producttable_0".ID as "ID_0", null as "ID_1" from (select "producttable_1".ID as ID, "producttable_1".TYPE as TYPE, "producttable_1".NAME as NAME, "producttable_1".ISSUERID as ISSUERID from ProductTable as "producttable_1" where "producttable_1".TYPE = \'COMMON\') as "producttable_0" union all select "producttable_0".ID as "rf(product)ID_rf(product)ID", null as "ID_0", "producttable_0".ID as "ID_1" from (select "producttable_1".ID as ID, "producttable_1".TYPE as TYPE, "producttable_1".NAME as NAME, "producttable_1".ISSUERID as ISSUERID from ProductTable as "producttable_1" where "producttable_1".TYPE = \'PREFERRED\') as "producttable_0") as "unionBase" left outer join (select "sharestable_1".ID as "ID", "sharestable_1".PRODUCTID as "PRODUCTID", "sharestable_1".AMOUNT as "AMOUNT" from (select "sharestable_2".ID as ID, "sharestable_2".PRODUCTID as PRODUCTID, "sharestable_2".AMOUNT as AMOUNT from SharesTable as "sharestable_2") as "sharestable_1") as "sharestable_0" on ("unionBase"."ID_0" = "sharestable_0"."PRODUCTID" or "unionBase"."ID_1" = "sharestable_0"."PRODUCTID")',
    $result.rootExecutionNode.executionNodes->at(0)->cast(@meta::relational::mapping::SQLExecutionNode).sqlQuery
  );
}

