    'select "businesslistingtable_0"."MARKET" as "january", "businesslistingtable_3"."MARKET" as "june" from (select "exchangetable_1".ID as ID, "exchangetable_1".EXCHANGENAME as EXCHANGENAME from ExchangeTable as "exchangetable_1") as "exchangetable_0" left outer join (select "businesslistingtable_1".PRODUCTID as "PRODUCTID", "businesslistingtable_1".MARKET as "MARKET", "businesslistingtable_1".EXCHANGEID as "EXCHANGEID", "businesslistingtable_1".FROM_Z as "FROM_Z", "businesslistingtable_1".THRU_Z as "THRU_Z", "businesslistingtable_1"."k_businessDate" as "k_businessDate" from (select "businesslistingtable_2".PRODUCTID as PRODUCTID, "businesslistingtable_2".MARKET as MARKET, "businesslistingtable_2".EXCHANGEID as EXCHANGEID, "businesslistingtable_2".FROM_Z as FROM_Z, "businesslistingtable_2".THRU_Z as THRU_Z, \'2024-01-01\' as "k_businessDate" from BusinessListingTable as "businesslistingtable_2" where "businesslistingtable_2".FROM_Z <= DATE\'2024-01-01\' and "businesslistingtable_2".THRU_Z > DATE\'2024-01-01\') as "businesslistingtable_1") as "businesslistingtable_0" on ("exchangetable_0"."ID" = "businesslistingtable_0"."EXCHANGEID") left outer join (select "businesslistingtable_1".PRODUCTID as "PRODUCTID", "businesslistingtable_1".MARKET as "MARKET", "businesslistingtable_1".EXCHANGEID as "EXCHANGEID", "businesslistingtable_1".FROM_Z as "FROM_Z", "businesslistingtable_1".THRU_Z as "THRU_Z", "businesslistingtable_1"."k_businessDate" as "k_businessDate" from (select "businesslistingtable_2".PRODUCTID as PRODUCTID, "businesslistingtable_2".MARKET as MARKET, "businesslistingtable_2".EXCHANGEID as EXCHANGEID, "businesslistingtable_2".FROM_Z as FROM_Z, "businesslistingtable_2".THRU_Z as THRU_Z, \'2024-06-01\' as "k_businessDate" from BusinessListingTable as "businesslistingtable_2" where "businesslistingtable_2".FROM_Z <= DATE\'2024-06-01\' and "businesslistingtable_2".THRU_Z > DATE\'2024-06-01\') as "businesslistingtable_1") as "businesslistingtable_3" on ("exchangetable_0"."ID" = "businesslistingtable_3"."EXCHANGEID")',
    $result.rootExecutionNode.executionNodes->at(0)->cast(@meta::relational::mapping::SQLExecutionNode).sqlQuery
  );
}

