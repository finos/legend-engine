function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::testInlineEmbeddedSetsUnderAUnionOwnerReadEachBranchsColumns():Boolean[1]
{
  let result = executionPlan(
    {|Employee.all()->project([e | $e.id, e | $e.employment.firmId], ['id', 'firmId'])},
    UnionInlineEmbeddedModelJoinMapping,
    meta::external::store::relational::tests::testRuntime(JoinDB),
    meta::relational::extension::relationalExtensions()
  );
  assertSameSQL(
    'select "unionBase"."rf(lowEmployee)ID_rf(highEmployee)ID" as "id", "unionBase"."rf(lowEmployee)FIRMID_rf(highEmployee)FIRMID" as "firmId" from (select "persontable_0".ID as "rf(lowEmployee)ID_rf(highEmployee)ID", "persontable_0".FIRMID as "rf(lowEmployee)FIRMID_rf(highEmployee)FIRMID" from (select "persontable_1".ID as ID, "persontable_1".FIRSTNAME as FIRSTNAME, "persontable_1".FIRMID as FIRMID from PersonTable as "persontable_1" where "persontable_1".ID < 3) as "persontable_0" union all select "persontable_0".ID as "rf(lowEmployee)ID_rf(highEmployee)ID", "persontable_0".FIRMID as "rf(lowEmployee)FIRMID_rf(highEmployee)FIRMID" from (select "persontable_1".ID as ID, "persontable_1".FIRSTNAME as FIRSTNAME, "persontable_1".FIRMID as FIRMID from PersonTable as "persontable_1" where "persontable_1".ID >= 3) as "persontable_0") as "unionBase"',
    $result.rootExecutionNode.executionNodes->at(0)->cast(@meta::relational::mapping::SQLExecutionNode).sqlQuery
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::testModelJoinInsideInlineEmbeddedSetsUnderAUnionOwnerJoinsFromEachBranch():Boolean[1]
{
  let result = executionPlan(
    {|Employee.all()->project([e | $e.id, e | $e.employment.firm.legalName], ['id', 'firm'])},
    UnionInlineEmbeddedModelJoinMapping,
