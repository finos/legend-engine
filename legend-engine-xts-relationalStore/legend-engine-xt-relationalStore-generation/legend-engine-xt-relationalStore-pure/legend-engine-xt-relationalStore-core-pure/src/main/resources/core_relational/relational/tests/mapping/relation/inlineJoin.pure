  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::testChainedNavigationJoinFromDeeplyNestedSourceRelation():Boolean[1]
{
  let result = executionPlan(
    {|WideRow.all()->project([w | $w.id, w | $w.firmCountryName], ['id', 'countryName'])},
    DeeperSourceChainMapping,
    meta::external::store::relational::tests::testRuntime(JoinDB),
    meta::relational::extension::relationalExtensions()
  );
  let sql = $result.rootExecutionNode.executionNodes->at(0)->cast(@meta::relational::mapping::SQLExecutionNode).sqlQuery;
  let select = 'select "widetable_0"."ID" as "id", "widetable_22".COUNTRYNAME as "countryName" from (select distinct "widetable_1"."ID" as "ID"';
  let keyedJoin = ') as "widetable_0" left outer join (select "widetable_23".ID as relJoinKey_ID, "countrytable_0".ID as "ID", "countrytable_0".COUNTRYNAME as "COUNTRYNAME" from (select distinct "widetable_24"."ID" as "ID"';
  let hops = ') as "widetable_23" left outer join (select "chainfirmtable_1".ID as ID, "chainfirmtable_1".LEGALNAME as LEGALNAME, "chainfirmtable_1".COUNTRYID as COUNTRYID from ChainFirmTable as "chainfirmtable_1") as "chainfirmtable_0" on ("widetable_23"."C0" = "chainfirmtable_0".ID) left outer join (select "countrytable_1".ID as ID, "countrytable_1".COUNTRYNAME as COUNTRYNAME from CountryTable as "countrytable_1") as "countrytable_0" on ("chainfirmtable_0".COUNTRYID = "countrytable_0".ID)) as "widetable_22" on ("widetable_0".ID is not distinct from "widetable_22".relJoinKey_ID)';
  assertEquals($select, $sql->substring(0, $select->length()));
  assert($sql->contains($keyedJoin), | $sql);
  assertEquals($hops, $sql->substring($sql->length() - $hops->length()));
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::testCountOfToManyModelJoinFromDeeplyNestedSourceRelation():Boolean[1]
{
  let result = executionPlan(
    {|WideRow.all()->project([w | $w.id, w | $w.firmsOfC0->count()], ['id', 'firmCount'])},
    DeeperSourceToManyMapping,
    meta::external::store::relational::tests::testRuntime(JoinDB),
    meta::relational::extension::relationalExtensions()
  );
  let sql = $result.rootExecutionNode.executionNodes->at(0)->cast(@meta::relational::mapping::SQLExecutionNode).sqlQuery;
  let select = 'select "widetable_0"."ID" as "id", "widetable_22".aggCol as "firmCount" from (select distinct "widetable_1"."ID" as "ID"';
  let target = ') as "widetable_1" left outer join (select "firmtable_1".ID as "ID", "firmtable_1".LEGALNAME as "LEGALNAME" from (select "firmtable_2".ID as ID, "firmtable_2".LEGALNAME as LEGALNAME from FirmTable as "firmtable_2") as "firmtable_1") as "firmtable_0" on ("widetable_1"."C0" = "firmtable_0"."ID") group by "widetable_1"."ID") as "widetable_22" on ("widetable_0"."ID" = "widetable_22"."ID")';
  assertEquals($select, $sql->substring(0, $select->length()));
  assertEquals($target, $sql->substring($sql->length() - $target->length()));
}

