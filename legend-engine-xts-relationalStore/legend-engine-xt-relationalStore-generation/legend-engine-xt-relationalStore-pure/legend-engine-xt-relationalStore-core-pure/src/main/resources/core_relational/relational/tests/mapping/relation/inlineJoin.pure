function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::testModelJoinFromDeeplyNestedSourceRelation():Boolean[1]
{
  let result = executionPlan(
    {|WideRow.all()->project([w | $w.id, w | $w.firm.legalName], ['id', 'firmName'])},
    DeepSourceJoinMapping,
    meta::external::store::relational::tests::testRuntime(JoinDB),
    meta::relational::extension::relationalExtensions()
  );
  assertSameSQL(
    'select "widetable_0"."ID" as "id", "firmtable_0"."LEGALNAME" as "firmName" from (' + deepWideRelSql() + ') as "widetable_0" left outer join (select "firmtable_1".ID as "ID", "firmtable_1".LEGALNAME as "LEGALNAME" from (select "firmtable_2".ID as ID, "firmtable_2".LEGALNAME as LEGALNAME from FirmTable as "firmtable_2") as "firmtable_1") as "firmtable_0" on ("widetable_0"."C0" = "firmtable_0"."ID")',
    $result.rootExecutionNode.executionNodes->at(0)->cast(@meta::relational::mapping::SQLExecutionNode).sqlQuery
  );
}

