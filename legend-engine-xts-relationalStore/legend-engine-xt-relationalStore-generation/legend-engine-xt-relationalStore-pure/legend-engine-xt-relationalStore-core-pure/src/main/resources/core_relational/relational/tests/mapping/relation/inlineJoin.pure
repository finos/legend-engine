    ID INTEGER PRIMARY KEY,
    LEGALNAME VARCHAR(100) NOT NULL
  )
  Table ChainPersonTable
  (
    ID INTEGER PRIMARY KEY,
    FIRSTNAME VARCHAR(100) NOT NULL,
    FIRMID INTEGER NOT NULL,
    COUNTRYID INTEGER NOT NULL
  )
  Table ChainFirmTable
  (
    ID INTEGER PRIMARY KEY,
    LEGALNAME VARCHAR(100) NOT NULL,
    COUNTRYID INTEGER NOT NULL
  )
  Table CountryTable
  (
    ID INTEGER PRIMARY KEY,
    COUNTRYNAME VARCHAR(100) NOT NULL
  )
  Table ProcessingProductTable
  (
    milestoning
    (
      processing(PROCESSING_IN = IN_Z, PROCESSING_OUT = OUT_Z, INFINITY_DATE = %9999-12-31T00:00:00.0000)
    )
    ID INTEGER PRIMARY KEY,
    NAME VARCHAR(100) NOT NULL,
    IN_Z TIMESTAMP PRIMARY KEY,
    OUT_Z TIMESTAMP NOT NULL
  )
  Table ProcessingListingTable
  (
    milestoning
    (
      processing(PROCESSING_IN = IN_Z, PROCESSING_OUT = OUT_Z, INFINITY_DATE = %9999-12-31T00:00:00.0000)
    )
    PRODUCTID INTEGER PRIMARY KEY,
    MARKET VARCHAR(100) NOT NULL,
    EXCHANGEID INTEGER NOT NULL,
    IN_Z TIMESTAMP PRIMARY KEY,
    OUT_Z TIMESTAMP NOT NULL
  )
  Table BusinessProductTable
  (
    milestoning
    (
      business(BUS_FROM = FROM_Z, BUS_THRU = THRU_Z, INFINITY_DATE = %9999-12-31T00:00:00.0000)
    )
    ID INTEGER PRIMARY KEY,
    NAME VARCHAR(100) NOT NULL,
    FROM_Z DATE PRIMARY KEY,
    THRU_Z DATE NOT NULL
  )
  Table BusinessListingTable
  (
    milestoning
    (
      business(BUS_FROM = FROM_Z, BUS_THRU = THRU_Z, INFINITY_DATE = %9999-12-31T00:00:00.0000)
    )
    PRODUCTID INTEGER PRIMARY KEY,
    MARKET VARCHAR(100) NOT NULL,
    EXCHANGEID INTEGER NOT NULL,
    FROM_Z DATE PRIMARY KEY,
    THRU_Z DATE NOT NULL
  )
  Table ExchangeTable
  (
    ID INTEGER PRIMARY KEY,
    EXCHANGENAME VARCHAR(100) NOT NULL
  )
  Table WideTable
  (
    ID INTEGER PRIMARY KEY,
    C0 INTEGER, C1 INTEGER, C2 INTEGER, C3 INTEGER, C4 INTEGER, C5 INTEGER, C6 INTEGER, C7 INTEGER, C8 INTEGER, C9 INTEGER
  )
  Table KeyedPersonTable
  (
    ID INTEGER PRIMARY KEY,
    FIRMID INTEGER,
    OLDFIRMID INTEGER
  )
  Table ProductTable
  (
    ID INTEGER PRIMARY KEY,
    TYPE VARCHAR(10),
    NAME VARCHAR(100),
    ISSUERID INTEGER
  )
  Table SharesTable
  (
    ID INTEGER PRIMARY KEY,
    PRODUCTID INTEGER,
    AMOUNT INTEGER
  )
)

