  );
  assertSameSQL(
    'select "unionBase"."rf(lowEmployee)ID_rf(highEmployee)ID" as "id", "firmtable_0"."LEGALNAME" as "firm" from (select "persontable_0".ID as "rf(lowEmployee)ID_rf(highEmployee)ID", "persontable_0".FIRMID as "FIRMID_0", null as "FIRMID_1" from (select "persontable_1".ID as ID, "persontable_1".FIRSTNAME as FIRSTNAME, "persontable_1".FIRMID as FIRMID from PersonTable as "persontable_1" where "persontable_1".ID < 3) as "persontable_0" union all select "persontable_0".ID as "rf(lowEmployee)ID_rf(highEmployee)ID", null as "FIRMID_0", "persontable_0".FIRMID as "FIRMID_1" from (select "persontable_1".ID as ID, "persontable_1".FIRSTNAME as FIRSTNAME, "persontable_1".FIRMID as FIRMID from PersonTable as "persontable_1" where "persontable_1".ID >= 3) as "persontable_0") as "unionBase" left outer join (select "firmtable_1".ID as "ID", "firmtable_1".LEGALNAME as "LEGALNAME" from (select "firmtable_2".ID as ID, "firmtable_2".LEGALNAME as LEGALNAME from FirmTable as "firmtable_2") as "firmtable_1") as "firmtable_0" on ("unionBase"."FIRMID_0" = "firmtable_0"."ID" or "unionBase"."FIRMID_1" = "firmtable_0"."ID")',
    $result.rootExecutionNode.executionNodes->at(0)->cast(@meta::relational::mapping::SQLExecutionNode).sqlQuery
  );
}

function meta::relational::tests::mapping::relation::inlineJoin::keyedPersonRelSql(alias:String[1]):String[1]
{
  'select distinct "' + $alias + '".ID as ID, case when "' + $alias + '".FIRMID is null then "' + $alias + '".OLDFIRMID else "' + $alias + '".FIRMID end as "FIRMKEY" from KeyedPersonTable as "' + $alias + '"'
}

function meta::relational::tests::mapping::relation::inlineJoin::mixedCaseKeyedPersonRelSql(alias:String[1]):String[1]
{
  'select distinct "' + $alias + '".ID as ID, case when "' + $alias + '".FIRMID is null then "' + $alias + '".OLDFIRMID else "' + $alias + '".FIRMID end as "firmKey" from KeyedPersonTable as "' + $alias + '"'
}

