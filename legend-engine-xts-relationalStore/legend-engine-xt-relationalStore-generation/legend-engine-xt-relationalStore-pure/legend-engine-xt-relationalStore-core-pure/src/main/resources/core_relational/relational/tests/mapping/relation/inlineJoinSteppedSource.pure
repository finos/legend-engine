###Mapping
import meta::relational::tests::mapping::relation::inlineJoin::*;
import meta::relational::tests::mapping::relation::inlineJoin::stepped::*;

Mapping meta::relational::tests::mapping::relation::inlineJoin::stepped::SteppedSourceJoinMapping
(
  *SteppedPerson[steppedPerson]: Relation
  {
    ~func meta::relational::tests::mapping::relation::inlineJoin::personRel():Relation<Any>[1]
    firstName: FIRSTNAME,
    extendedKeyFirmName: $src->extend(~K: x | $x.FIRMID + 1)->navigationJoin(meta::relational::tests::mapping::relation::inlineJoin::firmRel(), {p, f | $p.K == $f.ID}).LEGALNAME,
    extendedKeyFirmNameDup: $src->extend(~K: x | $x.FIRMID + 1)->navigationJoin(meta::relational::tests::mapping::relation::inlineJoin::firmRel(), {p, f | $p.K == $f.ID}).LEGALNAME,
    otherExtendedKeyFirmName: $src->extend(~K: x | $x.FIRMID + 2)->navigationJoin(meta::relational::tests::mapping::relation::inlineJoin::firmRel(), {p, f | $p.K == $f.ID}).LEGALNAME,
    filteredFirmName: $src->filter(x | $x.FIRMID > 1)->navigationJoin(meta::relational::tests::mapping::relation::inlineJoin::firmRel(), {p, f | $p.FIRMID == $f.ID}).LEGALNAME,
    filteredFirmNameDup: $src->filter(x | $x.FIRMID > 1)->navigationJoin(meta::relational::tests::mapping::relation::inlineJoin::firmRel(), {p, f | $p.FIRMID == $f.ID}).LEGALNAME,
    selectedFirmName: $src->select(~[ID, FIRMID])->navigationJoin(meta::relational::tests::mapping::relation::inlineJoin::firmRel(), {p, f | $p.FIRMID == $f.ID}).LEGALNAME,
    renamedFirmName: $src->rename(~FIRMID, ~FID)->navigationJoin(meta::relational::tests::mapping::relation::inlineJoin::firmRel(), {p, f | $p.FID == $f.ID}).LEGALNAME,
    sortedFirmName: $src->sort(~FIRMID->ascending())->navigationJoin(meta::relational::tests::mapping::relation::inlineJoin::firmRel(), {p, f | $p.FIRMID == $f.ID}).LEGALNAME,
    allStepsFirmName: $src->extend(~K: x | $x.FIRMID + 1)->filter(x | $x.K > 1)->select(~[ID, K])->rename(~K, ~FIRMKEY)->sort(~FIRMKEY->ascending())->navigationJoin(meta::relational::tests::mapping::relation::inlineJoin::firmRel(), {p, f | $p.FIRMKEY == $f.ID}).LEGALNAME,
    firstOfFirmFirmName: $src->extend(meta::pure::functions::relation::over(~FIRMID, ~ID->meta::pure::functions::relation::ascending()), ~RN: {p, w, r | $p->meta::pure::functions::relation::rowNumber($r)})->filter(x | $x.RN == 1)->navigationJoin(meta::relational::tests::mapping::relation::inlineJoin::firmRel(), {p, f | $p.FIRMID == $f.ID}).LEGALNAME,
    gatedFirstName: $src->filter(x | $x.FIRMID > 1)->filterJoin(meta::relational::tests::mapping::relation::inlineJoin::firmRel(), {p, f | $p.FIRMID == $f.ID}).FIRSTNAME,
    +steppedFirmKey: Integer[0..1]: $src->extend(~K: x | $x.FIRMID + 1)->filter(x | $x.K > 1)->navigationJoin(meta::relational::tests::mapping::relation::inlineJoin::firmRel(), meta::pure::functions::relation::JoinKind.INNER, {p, f | $p.K == $f.ID}).ID,
    firmRef: modelJoin({p, f | $p.steppedFirmKey == $f.id})
  }
  *Firm[steppedFirm]: Relation
  {
    ~func meta::relational::tests::mapping::relation::inlineJoin::firmRel():Relation<Any>[1]
    id: ID,
    legalName: LEGALNAME
  }
)

Mapping meta::relational::tests::mapping::relation::inlineJoin::stepped::SteppedChainedJoinMapping
(
  *SteppedChainedPerson[steppedChainedPerson]: Relation
  {
    ~func meta::relational::tests::mapping::relation::inlineJoin::chainPersonRel():Relation<Any>[1]
    firstName: FIRSTNAME,
    filteredCountryName: $src->filter(x | $x.FIRMID > 1)->navigationJoin(meta::relational::tests::mapping::relation::inlineJoin::chainFirmRel(), {p, f | $p.FIRMID == $f.ID})->navigationJoin(meta::relational::tests::mapping::relation::inlineJoin::countryRel(), {f, c | $f.COUNTRYID == $c.ID}).COUNTRYNAME,
    gatedCountryName: $src->filter(x | $x.FIRMID > 1)->filterJoin(meta::relational::tests::mapping::relation::inlineJoin::chainFirmRel(), {p, f | $p.FIRMID == $f.ID})->navigationJoin(meta::relational::tests::mapping::relation::inlineJoin::countryRel(), {p, c | $p.COUNTRYID == $c.ID}).COUNTRYNAME
  }
)

Mapping meta::relational::tests::mapping::relation::inlineJoin::stepped::SteppedMilestonedJoinMapping
(
  *SteppedProcessingProduct[steppedProcessingProduct]: Relation
  {
    ~func meta::relational::tests::mapping::relation::inlineJoin::processingProductRel():Relation<Any>[1]
    name: NAME,
    market: $src->filter(x | $x.ID > 0)->navigationJoin(meta::relational::tests::mapping::relation::inlineJoin::processingListingRel(), {p, l | $p.ID == $l.PRODUCTID}).MARKET
  }
)

Mapping meta::relational::tests::mapping::relation::inlineJoin::stepped::SteppedSourceLosingPrimaryKeyMapping
(
  *SteppedPerson[steppedPerson]: Relation
  {
    ~func meta::relational::tests::mapping::relation::inlineJoin::personRel():Relation<Any>[1]
    firstName: FIRSTNAME,
    filteredFirmName: $src->select(~[FIRSTNAME, FIRMID])->navigationJoin(meta::relational::tests::mapping::relation::inlineJoin::firmRel(), {p, f | $p.FIRMID == $f.ID}).LEGALNAME,
    renamedKeyFirmName: $src->rename(~ID, ~PERSONID)->navigationJoin(meta::relational::tests::mapping::relation::inlineJoin::firmRel(), {p, f | $p.FIRMID == $f.ID}).LEGALNAME
  }
)

###Pure
import meta::relational::tests::mapping::relation::inlineJoin::*;
import meta::relational::tests::mapping::relation::inlineJoin::stepped::*;
import meta::pure::metamodel::relation::*;
import meta::pure::executionPlan::*;
import meta::pure::graphFetch::execution::*;
import meta::relational::metamodel::execute::*;
import meta::relational::functions::asserts::*;

function <<access.private>> meta::relational::tests::mapping::relation::inlineJoin::stepped::steppedSql(query:FunctionDefinition<Any>[1], mapping:meta::pure::mapping::Mapping[1]):String[1]
{
  executionPlan($query, $mapping, meta::external::store::relational::tests::testRuntime(JoinDB), meta::relational::extension::relationalExtensions())
    .rootExecutionNode.executionNodes->at(0)->cast(@meta::relational::mapping::SQLExecutionNode).sqlQuery;
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::stepped::testExtendedSourceColumnFeedsTheJoinCondition():Boolean[1]
{
  assertSameSQL(
    'select "persontable_2".LEGALNAME as "v" from (select "persontable_1".ID as ID, "persontable_1".FIRSTNAME as FIRSTNAME, "persontable_1".FIRMID as FIRMID from PersonTable as "persontable_1") as "persontable_0" left outer join (select "persontable_3".ID as relJoinKey_ID, "firmtable_0".ID as "ID", "firmtable_0".LEGALNAME as "LEGALNAME" from (select "persontable_4".ID as ID, "persontable_4".FIRSTNAME as FIRSTNAME, "persontable_4".FIRMID as FIRMID, "persontable_4".FIRMID + 1 as "K" from PersonTable as "persontable_4") as "persontable_3" left outer join (select "firmtable_1".ID as ID, "firmtable_1".LEGALNAME as LEGALNAME from FirmTable as "firmtable_1") as "firmtable_0" on ("persontable_3"."K" = "firmtable_0".ID)) as "persontable_2" on ("persontable_0".ID is not distinct from "persontable_2".relJoinKey_ID)',
    steppedSql({|SteppedPerson.all()->project([p | $p.extendedKeyFirmName], ['v'])}, SteppedSourceJoinMapping)
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::stepped::testFilteredSourceGatesTheJoinInsteadOfFilteringTheOwners():Boolean[1]
{
  assertSameSQL(
    'select "persontable_0".FIRSTNAME as "firstName", "persontable_2".LEGALNAME as "v" from (select "persontable_1".ID as ID, "persontable_1".FIRSTNAME as FIRSTNAME, "persontable_1".FIRMID as FIRMID from PersonTable as "persontable_1") as "persontable_0" left outer join (select "persontable_3".ID as relJoinKey_ID, "firmtable_0".ID as "ID", "firmtable_0".LEGALNAME as "LEGALNAME" from (select "persontable_4".ID as ID, "persontable_4".FIRSTNAME as FIRSTNAME, "persontable_4".FIRMID as FIRMID from PersonTable as "persontable_4" where "persontable_4".FIRMID > 1) as "persontable_3" left outer join (select "firmtable_1".ID as ID, "firmtable_1".LEGALNAME as LEGALNAME from FirmTable as "firmtable_1") as "firmtable_0" on ("persontable_3".FIRMID = "firmtable_0".ID)) as "persontable_2" on ("persontable_0".ID is not distinct from "persontable_2".relJoinKey_ID)',
    steppedSql({|SteppedPerson.all()->project([p | $p.firstName, p | $p.filteredFirmName], ['firstName', 'v'])}, SteppedSourceJoinMapping)
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::stepped::testSelectedSourceNarrowsTheColumnsTheJoinConditionSees():Boolean[1]
{
  assertSameSQL(
    'select "persontable_2".LEGALNAME as "v" from (select "persontable_1".ID as ID, "persontable_1".FIRSTNAME as FIRSTNAME, "persontable_1".FIRMID as FIRMID from PersonTable as "persontable_1") as "persontable_0" left outer join (select "persontable_3".ID as relJoinKey_ID, "firmtable_0".ID as "ID", "firmtable_0".LEGALNAME as "LEGALNAME" from (select "persontable_4".ID as ID, "persontable_4".FIRMID as FIRMID from PersonTable as "persontable_4") as "persontable_3" left outer join (select "firmtable_1".ID as ID, "firmtable_1".LEGALNAME as LEGALNAME from FirmTable as "firmtable_1") as "firmtable_0" on ("persontable_3".FIRMID = "firmtable_0".ID)) as "persontable_2" on ("persontable_0".ID is not distinct from "persontable_2".relJoinKey_ID)',
    steppedSql({|SteppedPerson.all()->project([p | $p.selectedFirmName], ['v'])}, SteppedSourceJoinMapping)
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::stepped::testRenamedSourceColumnIsTheNameTheJoinConditionSees():Boolean[1]
{
  assertSameSQL(
    'select "persontable_2".LEGALNAME as "v" from (select "persontable_1".ID as ID, "persontable_1".FIRSTNAME as FIRSTNAME, "persontable_1".FIRMID as FIRMID from PersonTable as "persontable_1") as "persontable_0" left outer join (select "persontable_3".ID as relJoinKey_ID, "firmtable_0".ID as "ID", "firmtable_0".LEGALNAME as "LEGALNAME" from (select "persontable_4"."ID" as "ID", "persontable_4"."FIRSTNAME" as "FIRSTNAME", "persontable_4"."FIRMID" as "FID" from (select "persontable_5"."ID" as "ID", "persontable_5"."FIRSTNAME" as "FIRSTNAME", "persontable_5"."FIRMID" as "FIRMID" from (select "persontable_6".ID as "ID", "persontable_6".FIRSTNAME as "FIRSTNAME", "persontable_6".FIRMID as "FIRMID" from PersonTable as "persontable_6") as "persontable_5") as "persontable_4") as "persontable_3" left outer join (select "firmtable_1".ID as ID, "firmtable_1".LEGALNAME as LEGALNAME from FirmTable as "firmtable_1") as "firmtable_0" on ("persontable_3"."FID" = "firmtable_0".ID)) as "persontable_2" on ("persontable_0".ID is not distinct from "persontable_2".relJoinKey_ID)',
    steppedSql({|SteppedPerson.all()->project([p | $p.renamedFirmName], ['v'])}, SteppedSourceJoinMapping)
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::stepped::testSortedSourceBeforeJoinGivesTheSamePlanAsTheUnsortedSource():Boolean[1]
{
  assertSameSQL(
    'select "firmtable_0".LEGALNAME as "v" from (select "persontable_1".ID as ID, "persontable_1".FIRSTNAME as FIRSTNAME, "persontable_1".FIRMID as FIRMID from PersonTable as "persontable_1") as "persontable_0" left outer join (select "firmtable_1".ID as ID, "firmtable_1".LEGALNAME as LEGALNAME from FirmTable as "firmtable_1") as "firmtable_0" on ("persontable_0".FIRMID = "firmtable_0".ID)',
    steppedSql({|SteppedPerson.all()->project([p | $p.sortedFirmName], ['v'])}, SteppedSourceJoinMapping)
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::stepped::testEveryStepBeforeJoinAppliesInTheOrderWritten():Boolean[1]
{
  assertSameSQL(
    'select "persontable_2".LEGALNAME as "v" from (select "persontable_1".ID as ID, "persontable_1".FIRSTNAME as FIRSTNAME, "persontable_1".FIRMID as FIRMID from PersonTable as "persontable_1") as "persontable_0" left outer join (select "persontable_3".ID as relJoinKey_ID, "firmtable_0".ID as "ID", "firmtable_0".LEGALNAME as "LEGALNAME" from (select "persontable_4"."ID" as "ID", "persontable_4"."K" as "FIRMKEY" from (select "persontable_5"."ID" as "ID", "persontable_5"."K" as "K" from (select "persontable_6".ID as "ID", "persontable_6".FIRMID + 1 as "K" from PersonTable as "persontable_6" where "persontable_6".FIRMID + 1 > 1) as "persontable_5") as "persontable_4") as "persontable_3" left outer join (select "firmtable_1".ID as ID, "firmtable_1".LEGALNAME as LEGALNAME from FirmTable as "firmtable_1") as "firmtable_0" on ("persontable_3"."FIRMKEY" = "firmtable_0".ID)) as "persontable_2" on ("persontable_0".ID is not distinct from "persontable_2".relJoinKey_ID)',
    steppedSql({|SteppedPerson.all()->project([p | $p.allStepsFirmName], ['v'])}, SteppedSourceJoinMapping)
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::stepped::testWindowExtendRunsBeforeALaterFilterAndGatesTheJoin():Boolean[1]
{
  assertSameSQL(
    'select "persontable_2".LEGALNAME as "v" from (select "persontable_1".ID as ID, "persontable_1".FIRSTNAME as FIRSTNAME, "persontable_1".FIRMID as FIRMID from PersonTable as "persontable_1") as "persontable_0" left outer join (select "persontable_3".ID as relJoinKey_ID, "firmtable_0".ID as "ID", "firmtable_0".LEGALNAME as "LEGALNAME" from (select "persontable_4"."ID" as "ID", "persontable_4"."FIRSTNAME" as "FIRSTNAME", "persontable_4"."FIRMID" as "FIRMID", "persontable_4"."RN" as "RN" from (select "persontable_5".ID as "ID", "persontable_5".FIRSTNAME as "FIRSTNAME", "persontable_5".FIRMID as "FIRMID", row_number() over (partition by "persontable_5".FIRMID order by "persontable_5".ID asc) as "RN" from PersonTable as "persontable_5") as "persontable_4" where "persontable_4"."RN" = 1) as "persontable_3" left outer join (select "firmtable_1".ID as ID, "firmtable_1".LEGALNAME as LEGALNAME from FirmTable as "firmtable_1") as "firmtable_0" on ("persontable_3"."FIRMID" = "firmtable_0".ID)) as "persontable_2" on ("persontable_0".ID is not distinct from "persontable_2".relJoinKey_ID)',
    steppedSql({|SteppedPerson.all()->project([p | $p.firstOfFirmFirmName], ['v'])}, SteppedSourceJoinMapping)
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::stepped::testFilterJoinAfterStepsKeepsTheSourceColumnsOfTheSteppedRows():Boolean[1]
{
  assertSameSQL(
    'select "persontable_2".FIRSTNAME as "v" from (select "persontable_1".ID as ID, "persontable_1".FIRSTNAME as FIRSTNAME, "persontable_1".FIRMID as FIRMID from PersonTable as "persontable_1") as "persontable_0" left outer join (select "persontable_3".ID as relJoinKey_ID, "persontable_3".ID as "ID", "persontable_3".FIRSTNAME as "FIRSTNAME", "persontable_3".FIRMID as "FIRMID" from (select "persontable_4".ID as ID, "persontable_4".FIRSTNAME as FIRSTNAME, "persontable_4".FIRMID as FIRMID from PersonTable as "persontable_4" where "persontable_4".FIRMID > 1) as "persontable_3" inner join (select "firmtable_1".ID as ID, "firmtable_1".LEGALNAME as LEGALNAME from FirmTable as "firmtable_1") as "firmtable_0" on ("persontable_3".FIRMID = "firmtable_0".ID)) as "persontable_2" on ("persontable_0".ID is not distinct from "persontable_2".relJoinKey_ID)',
    steppedSql({|SteppedPerson.all()->project([p | $p.gatedFirstName], ['v'])}, SteppedSourceJoinMapping)
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::stepped::testIdenticalStepsAndJoinOnTwoPropertiesShareOneJoin():Boolean[1]
{
  assertSameSQL(
    'select "persontable_2".LEGALNAME as "a", "persontable_2".LEGALNAME as "b" from (select "persontable_1".ID as ID, "persontable_1".FIRSTNAME as FIRSTNAME, "persontable_1".FIRMID as FIRMID from PersonTable as "persontable_1") as "persontable_0" left outer join (select "persontable_3".ID as relJoinKey_ID, "firmtable_0".ID as "ID", "firmtable_0".LEGALNAME as "LEGALNAME" from (select "persontable_4".ID as ID, "persontable_4".FIRSTNAME as FIRSTNAME, "persontable_4".FIRMID as FIRMID, "persontable_4".FIRMID + 1 as "K" from PersonTable as "persontable_4") as "persontable_3" left outer join (select "firmtable_1".ID as ID, "firmtable_1".LEGALNAME as LEGALNAME from FirmTable as "firmtable_1") as "firmtable_0" on ("persontable_3"."K" = "firmtable_0".ID)) as "persontable_2" on ("persontable_0".ID is not distinct from "persontable_2".relJoinKey_ID)',
    steppedSql({|SteppedPerson.all()->project([p | $p.extendedKeyFirmName, p | $p.extendedKeyFirmNameDup], ['a', 'b'])}, SteppedSourceJoinMapping)
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::stepped::testDifferentStepsWithTheSameJoinGetTwoJoins():Boolean[1]
{
  assertSameSQL(
    'select "persontable_2".LEGALNAME as "a", "persontable_5".LEGALNAME as "b" from (select "persontable_1".ID as ID, "persontable_1".FIRSTNAME as FIRSTNAME, "persontable_1".FIRMID as FIRMID from PersonTable as "persontable_1") as "persontable_0" left outer join (select "persontable_3".ID as relJoinKey_ID, "firmtable_0".ID as "ID", "firmtable_0".LEGALNAME as "LEGALNAME" from (select "persontable_4".ID as ID, "persontable_4".FIRSTNAME as FIRSTNAME, "persontable_4".FIRMID as FIRMID, "persontable_4".FIRMID + 1 as "K" from PersonTable as "persontable_4") as "persontable_3" left outer join (select "firmtable_1".ID as ID, "firmtable_1".LEGALNAME as LEGALNAME from FirmTable as "firmtable_1") as "firmtable_0" on ("persontable_3"."K" = "firmtable_0".ID)) as "persontable_2" on ("persontable_0".ID is not distinct from "persontable_2".relJoinKey_ID) left outer join (select "persontable_3".ID as relJoinKey_ID, "firmtable_0".ID as "ID", "firmtable_0".LEGALNAME as "LEGALNAME" from (select "persontable_4".ID as ID, "persontable_4".FIRSTNAME as FIRSTNAME, "persontable_4".FIRMID as FIRMID, "persontable_4".FIRMID + 2 as "K" from PersonTable as "persontable_4") as "persontable_3" left outer join (select "firmtable_1".ID as ID, "firmtable_1".LEGALNAME as LEGALNAME from FirmTable as "firmtable_1") as "firmtable_0" on ("persontable_3"."K" = "firmtable_0".ID)) as "persontable_5" on ("persontable_0".ID is not distinct from "persontable_5".relJoinKey_ID)',
    steppedSql({|SteppedPerson.all()->project([p | $p.extendedKeyFirmName, p | $p.otherExtendedKeyFirmName], ['a', 'b'])}, SteppedSourceJoinMapping)
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::stepped::testSameFilterOnTwoPropertiesSharesOneJoin():Boolean[1]
{
  assertSameSQL(
    'select "persontable_2".LEGALNAME as "a", "persontable_2".LEGALNAME as "b" from (select "persontable_1".ID as ID, "persontable_1".FIRSTNAME as FIRSTNAME, "persontable_1".FIRMID as FIRMID from PersonTable as "persontable_1") as "persontable_0" left outer join (select "persontable_3".ID as relJoinKey_ID, "firmtable_0".ID as "ID", "firmtable_0".LEGALNAME as "LEGALNAME" from (select "persontable_4".ID as ID, "persontable_4".FIRSTNAME as FIRSTNAME, "persontable_4".FIRMID as FIRMID from PersonTable as "persontable_4" where "persontable_4".FIRMID > 1) as "persontable_3" left outer join (select "firmtable_1".ID as ID, "firmtable_1".LEGALNAME as LEGALNAME from FirmTable as "firmtable_1") as "firmtable_0" on ("persontable_3".FIRMID = "firmtable_0".ID)) as "persontable_2" on ("persontable_0".ID is not distinct from "persontable_2".relJoinKey_ID)',
