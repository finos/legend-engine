function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::stepped::testSteppedSourceAndPlainSourceJoinsToTheSameTargetAreNotMerged():Boolean[1]
{
  assertSameSQL(
    'select "persontable_2".LEGALNAME as "a", "persontable_5".LEGALNAME as "b" from (select "persontable_1".ID as ID, "persontable_1".FIRSTNAME as FIRSTNAME, "persontable_1".FIRMID as FIRMID from PersonTable as "persontable_1") as "persontable_0" left outer join (select "persontable_3".ID as relJoinKey_ID, "firmtable_0".ID as "ID", "firmtable_0".LEGALNAME as "LEGALNAME" from (select "persontable_4".ID as ID, "persontable_4".FIRSTNAME as FIRSTNAME, "persontable_4".FIRMID as FIRMID from PersonTable as "persontable_4" where "persontable_4".FIRMID > 1) as "persontable_3" left outer join (select "firmtable_1".ID as ID, "firmtable_1".LEGALNAME as LEGALNAME from FirmTable as "firmtable_1") as "firmtable_0" on ("persontable_3".FIRMID = "firmtable_0".ID)) as "persontable_2" on ("persontable_0".ID is not distinct from "persontable_2".relJoinKey_ID) left outer join (select "persontable_3".ID as relJoinKey_ID, "firmtable_0".ID as "ID", "firmtable_0".LEGALNAME as "LEGALNAME" from (select "persontable_4".ID as ID, "persontable_4".FIRMID as FIRMID from PersonTable as "persontable_4") as "persontable_3" left outer join (select "firmtable_1".ID as ID, "firmtable_1".LEGALNAME as LEGALNAME from FirmTable as "firmtable_1") as "firmtable_0" on ("persontable_3".FIRMID = "firmtable_0".ID)) as "persontable_5" on ("persontable_0".ID is not distinct from "persontable_5".relJoinKey_ID)',
    steppedSql({|SteppedPerson.all()->project([p | $p.filteredFirmName, p | $p.selectedFirmName], ['a', 'b'])}, SteppedSourceJoinMapping)
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::stepped::testSteppedSourceFeedsASecondJoin():Boolean[1]
{
  assertSameSQL(
    'select "chainpersontable_2".COUNTRYNAME as "v" from (select "chainpersontable_1".ID as ID, "chainpersontable_1".FIRSTNAME as FIRSTNAME, "chainpersontable_1".FIRMID as FIRMID, "chainpersontable_1".COUNTRYID as COUNTRYID from ChainPersonTable as "chainpersontable_1") as "chainpersontable_0" left outer join (select "chainpersontable_3".ID as relJoinKey_ID, "countrytable_0".ID as "ID", "countrytable_0".COUNTRYNAME as "COUNTRYNAME" from (select "chainpersontable_4".ID as ID, "chainpersontable_4".FIRSTNAME as FIRSTNAME, "chainpersontable_4".FIRMID as FIRMID, "chainpersontable_4".COUNTRYID as COUNTRYID from ChainPersonTable as "chainpersontable_4" where "chainpersontable_4".FIRMID > 1) as "chainpersontable_3" left outer join (select "chainfirmtable_1".ID as ID, "chainfirmtable_1".LEGALNAME as LEGALNAME, "chainfirmtable_1".COUNTRYID as COUNTRYID from ChainFirmTable as "chainfirmtable_1") as "chainfirmtable_0" on ("chainpersontable_3".FIRMID = "chainfirmtable_0".ID) left outer join (select "countrytable_1".ID as ID, "countrytable_1".COUNTRYNAME as COUNTRYNAME from CountryTable as "countrytable_1") as "countrytable_0" on ("chainfirmtable_0".COUNTRYID = "countrytable_0".ID)) as "chainpersontable_2" on ("chainpersontable_0".ID is not distinct from "chainpersontable_2".relJoinKey_ID)',
    steppedSql({|SteppedChainedPerson.all()->project([p | $p.filteredCountryName], ['v'])}, SteppedChainedJoinMapping)
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::stepped::testFilterJoinAfterStepsFeedsANavigationJoin():Boolean[1]
{
  assertSameSQL(
    'select "chainpersontable_2".COUNTRYNAME as "v" from (select "chainpersontable_1".ID as ID, "chainpersontable_1".FIRSTNAME as FIRSTNAME, "chainpersontable_1".FIRMID as FIRMID, "chainpersontable_1".COUNTRYID as COUNTRYID from ChainPersonTable as "chainpersontable_1") as "chainpersontable_0" left outer join (select "chainpersontable_3".ID as relJoinKey_ID, "countrytable_0".ID as "ID", "countrytable_0".COUNTRYNAME as "COUNTRYNAME" from (select "chainpersontable_4".ID as ID, "chainpersontable_4".FIRSTNAME as FIRSTNAME, "chainpersontable_4".FIRMID as FIRMID, "chainpersontable_4".COUNTRYID as COUNTRYID from ChainPersonTable as "chainpersontable_4" where "chainpersontable_4".FIRMID > 1) as "chainpersontable_3" inner join (select "chainfirmtable_1".ID as ID, "chainfirmtable_1".LEGALNAME as LEGALNAME, "chainfirmtable_1".COUNTRYID as COUNTRYID from ChainFirmTable as "chainfirmtable_1") as "chainfirmtable_0" on ("chainpersontable_3".FIRMID = "chainfirmtable_0".ID) left outer join (select "countrytable_1".ID as ID, "countrytable_1".COUNTRYNAME as COUNTRYNAME from CountryTable as "countrytable_1") as "countrytable_0" on ("chainpersontable_3".COUNTRYID = "countrytable_0".ID)) as "chainpersontable_2" on ("chainpersontable_0".ID is not distinct from "chainpersontable_2".relJoinKey_ID)',
    steppedSql({|SteppedChainedPerson.all()->project([p | $p.gatedCountryName], ['v'])}, SteppedChainedJoinMapping)
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::stepped::testModelJoinKeyedOnASteppedNavigationJoinReadsTheTargetColumns():Boolean[1]
{
  assertSameSQL(
    'select "firmtable_2"."LEGALNAME" as "v" from (select "persontable_1".ID as ID, "persontable_1".FIRSTNAME as FIRSTNAME, "persontable_1".FIRMID as FIRMID from PersonTable as "persontable_1") as "persontable_0" left outer join (select "persontable_3".ID as relJoinKey_ID, "firmtable_0".ID as "ID", "firmtable_0".LEGALNAME as "LEGALNAME" from (select "persontable_4".ID as ID, "persontable_4".FIRSTNAME as FIRSTNAME, "persontable_4".FIRMID as FIRMID, "persontable_4".FIRMID + 1 as "K" from PersonTable as "persontable_4" where "persontable_4".FIRMID + 1 > 1) as "persontable_3" inner join (select "firmtable_1".ID as ID, "firmtable_1".LEGALNAME as LEGALNAME from FirmTable as "firmtable_1") as "firmtable_0" on ("persontable_3"."K" = "firmtable_0".ID)) as "persontable_2" on ("persontable_0".ID is not distinct from "persontable_2".relJoinKey_ID) left outer join (select "firmtable_3".ID as "ID", "firmtable_3".LEGALNAME as "LEGALNAME" from (select "firmtable_4".ID as ID, "firmtable_4".LEGALNAME as LEGALNAME from FirmTable as "firmtable_4") as "firmtable_3") as "firmtable_2" on ("persontable_2".ID = "firmtable_2"."ID")',
    steppedSql({|SteppedPerson.all()->project([p | $p.firmRef.legalName], ['v'])}, SteppedSourceJoinMapping)
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::stepped::testSteppedSourceOverAProcessingTemporalSourceAndTargetAtLatest():Boolean[1]
{
  assertSameSQL(
    'select "processingproducttable_2".MARKET as "v" from (select "processingproducttable_1".ID as ID, "processingproducttable_1".NAME as NAME, "processingproducttable_1".IN_Z as IN_Z, "processingproducttable_1".OUT_Z as OUT_Z, \'9999-12-31T00:00:00.0000+0000\' as "k_processingDate" from ProcessingProductTable as "processingproducttable_1" where "processingproducttable_1".OUT_Z = TIMESTAMP\'9999-12-31 00:00:00.0000\') as "processingproducttable_0" left outer join (select "processingproducttable_3".ID as relJoinKey_ID, "processingproducttable_3".IN_Z as relJoinKey_IN_Z, "processinglistingtable_0".PRODUCTID as "PRODUCTID", "processinglistingtable_0".MARKET as "MARKET", "processinglistingtable_0".EXCHANGEID as "EXCHANGEID", "processinglistingtable_0".IN_Z as "IN_Z", "processinglistingtable_0".OUT_Z as "OUT_Z" from (select "processingproducttable_4".ID as ID, "processingproducttable_4".NAME as NAME, "processingproducttable_4".IN_Z as IN_Z, "processingproducttable_4".OUT_Z as OUT_Z, \'9999-12-31T00:00:00.0000+0000\' as "k_processingDate" from ProcessingProductTable as "processingproducttable_4" where "processingproducttable_4".OUT_Z = TIMESTAMP\'9999-12-31 00:00:00.0000\' and "processingproducttable_4".ID > 0) as "processingproducttable_3" left outer join (select "processinglistingtable_1".PRODUCTID as PRODUCTID, "processinglistingtable_1".MARKET as MARKET, "processinglistingtable_1".EXCHANGEID as EXCHANGEID, "processinglistingtable_1".IN_Z as IN_Z, "processinglistingtable_1".OUT_Z as OUT_Z, \'9999-12-31T00:00:00.0000+0000\' as "k_processingDate" from ProcessingListingTable as "processinglistingtable_1" where "processinglistingtable_1".OUT_Z = TIMESTAMP\'9999-12-31 00:00:00.0000\') as "processinglistingtable_0" on ("processingproducttable_3".ID = "processinglistingtable_0".PRODUCTID)) as "processingproducttable_2" on ("processingproducttable_0".IN_Z is not distinct from "processingproducttable_2".relJoinKey_IN_Z and "processingproducttable_0".ID is not distinct from "processingproducttable_2".relJoinKey_ID)',
    steppedSql({|SteppedProcessingProduct.all(%latest)->project([p | $p.market], ['v'])}, SteppedMilestonedJoinMapping)
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::stepped::testGraphFetchThroughModelJoinKeyedOnASteppedNavigationJoin():Boolean[1]
{
  let tree = #{SteppedPerson {firstName, firmRef {id, legalName}}}#;
  let result = executionPlan(
    {|SteppedPerson.all()->graphFetch($tree)->serialize($tree)},
    SteppedSourceJoinMapping,
    meta::external::store::relational::tests::testRuntime(JoinDB),
    meta::relational::extension::relationalExtensions()
  );
  let firmNode = $result.rootExecutionNode.executionNodes->at(0)->cast(@meta::pure::graphFetch::executionPlan::StoreMappingGlobalGraphFetchExecutionNode)
                   .localGraphFetchExecutionNode->cast(@meta::relational::graphFetch::executionPlan::RelationalGraphFetchExecutionNode).children->toOne();
  assertSameSQL(
    'select distinct "temp_table_node_0_0".pk_0 as "parent_key_gen_0", "firmtable_2"."ID" as "pk_0", "firmtable_2"."ID" as "id", "firmtable_2"."LEGALNAME" as "legalName" from (select * from (${temp_table_node_0}) as "root") as "temp_table_node_0_0" inner join (select "persontable_1".ID as "ID", "persontable_1".FIRSTNAME as "FIRSTNAME", "persontable_1".FIRMID as "FIRMID" from (select "persontable_2".ID as ID, "persontable_2".FIRSTNAME as FIRSTNAME, "persontable_2".FIRMID as FIRMID from PersonTable as "persontable_2") as "persontable_1") as "root" on ("temp_table_node_0_0".pk_0 = "root"."ID") left outer join (select "persontable_4".ID as relJoinKey_ID, "firmtable_0".ID as "ID", "firmtable_0".LEGALNAME as "LEGALNAME" from (select "persontable_5".ID as ID, "persontable_5".FIRSTNAME as FIRSTNAME, "persontable_5".FIRMID as FIRMID, "persontable_5".FIRMID + 1 as "K" from PersonTable as "persontable_5" where "persontable_5".FIRMID + 1 > 1) as "persontable_4" inner join (select "firmtable_1".ID as ID, "firmtable_1".LEGALNAME as LEGALNAME from FirmTable as "firmtable_1") as "firmtable_0" on ("persontable_4"."K" = "firmtable_0".ID)) as "persontable_3" on ("root".ID is not distinct from "persontable_3".relJoinKey_ID) left outer join (select "firmtable_3".ID as "ID", "firmtable_3".LEGALNAME as "LEGALNAME" from (select "firmtable_4".ID as ID, "firmtable_4".LEGALNAME as LEGALNAME from FirmTable as "firmtable_4") as "firmtable_3") as "firmtable_2" on ("persontable_3".ID = "firmtable_2"."ID") where "firmtable_2"."ID" is not null',
    $firmNode.executionNodes->toOne()->cast(@meta::relational::mapping::SQLExecutionNode).sqlQuery
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::stepped::testSteppedSourceThatLosesAPrimaryKeyColumnFailsNamingIt():Boolean[1]
{
  assertError(
    | steppedSql({|SteppedPerson.all()->project([p | $p.filteredFirmName], ['v'])}, SteppedSourceLosingPrimaryKeyMapping),
    'Property \'filteredFirmName\' joins from $src transformed by extend, filter, select, rename or sort, whose result has no primary key column \'ID\' of class mapping \'steppedPerson\' (its columns: FIRSTNAME, FIRMID). The join result is matched back to the mapped row by the primary key, so these steps must keep every primary key column.'
  );
}

function <<meta::pure::profiles::test.Test>> meta::relational::tests::mapping::relation::inlineJoin::stepped::testRenamedPrimaryKeyColumnFailsNamingTheKeyAndTheRemainingColumns():Boolean[1]
{
  assertError(
    | steppedSql({|SteppedPerson.all()->project([p | $p.renamedKeyFirmName], ['v'])}, SteppedSourceLosingPrimaryKeyMapping),
    'Property \'renamedKeyFirmName\' joins from $src transformed by extend, filter, select, rename or sort, whose result has no primary key column \'ID\' of class mapping \'steppedPerson\' (its columns: FIRSTNAME, FIRMID, PERSONID). The join result is matched back to the mapped row by the primary key, so these steps must keep every primary key column.'
  );
}
