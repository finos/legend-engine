    $result.values
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::temporalUnion::testRelationFunctionGraphFetchUnionPropertyLevel():Boolean[1]
{
  let tree = #{
    Firm {
      legalName,
      employees {
        firstName
      }
    }
  }#;

  let result = execute(
    |Firm.all()->graphFetch($tree)->serialize($tree),
    RfgfMsPropertyUnionMapping,
    testDBRuntime(),
    meta::relational::extension::relationalExtensions()
  );

  assertJsonStringsEqual(
    '[{"legalName":"Firm X","employees":[{"firstName":"Peter"},{"firstName":"John"}]},' +
    '{"legalName":"Firm A","employees":[]},' +
    '{"legalName":"Firm B","employees":[]},' +
    '{"legalName":"Firm C","employees":[{"firstName":"Fabrice"},{"firstName":"Oliver"}]},' +
    '{"legalName":"Firm D","employees":[]}]',
    $result.values
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::temporalUnion::testRelationFunctionGraphFetchUnionRootLevelWithRelationalSet():Boolean[1]
{
  let tree = #{
    Person {
      firstName
    }
  }#;

  let result = execute(
    |Person.all()->graphFetch($tree)->serialize($tree),
    RfgfMsMixedRootUnionMapping,
    testDBRuntime(),
    meta::relational::extension::relationalExtensions()
  );

  assertJsonStringsEqual(
    '[{"firstName":"Peter"},{"firstName":"John"},{"firstName":"John"},{"firstName":"Oliver"},{"firstName":"David"},{"firstName":"Fabrice"}]',
    $result.values
  );
}
