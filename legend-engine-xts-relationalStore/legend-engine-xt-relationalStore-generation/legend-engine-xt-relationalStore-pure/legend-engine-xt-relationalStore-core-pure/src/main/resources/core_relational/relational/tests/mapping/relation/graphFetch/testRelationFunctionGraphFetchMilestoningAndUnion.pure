###Relational
Database meta::relational::tests::mapping::relation::graphFetch::temporalUnion::RfgfMsDB
(
  Table RFGF_MS_PERSON
  (
    ID INTEGER PRIMARY KEY,
    FIRSTNAME VARCHAR(100) NOT NULL,
    FIRMID INTEGER NOT NULL
  )

  Table RFGF_MS_FIRM_BT
  (
    milestoning
    (
      business(BUS_FROM = FROM_Z, BUS_THRU = THRU_Z)
    )
    ID INTEGER PRIMARY KEY,
    LEGALNAME VARCHAR(100) NOT NULL,
    FROM_Z DATE PRIMARY KEY,
    THRU_Z DATE NOT NULL
  )
)

