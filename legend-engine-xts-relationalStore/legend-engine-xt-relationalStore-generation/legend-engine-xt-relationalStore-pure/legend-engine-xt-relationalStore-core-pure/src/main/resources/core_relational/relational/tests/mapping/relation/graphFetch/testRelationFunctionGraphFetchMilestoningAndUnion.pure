###Pure
import meta::pure::graphFetch::execution::*;
import meta::relational::metamodel::execute::*;
import meta::relational::tests::mapping::relation::*;
import meta::relational::tests::mapping::relation::graphFetch::temporalUnion::*;

function <<test.BeforePackage>> meta::relational::tests::mapping::relation::graphFetch::temporalUnion::setUp():Boolean[1]
{
  meta::relational::tests::mapping::relation::createTablesAndFillDb();
  setUpTables();
}

function meta::relational::tests::mapping::relation::graphFetch::temporalUnion::setUpTables():Boolean[1]
{
  let connection = meta::external::store::relational::tests::testRuntime(RfgfMsDB).connectionByElement(RfgfMsDB)->cast(@meta::external::store::relational::runtime::TestDatabaseConnection);

  executeInDb('Drop table if exists RFGF_MS_PERSON;', $connection);
  executeInDb('Create Table RFGF_MS_PERSON(ID INT, FIRSTNAME VARCHAR(100), FIRMID INT);', $connection);
  executeInDb('insert into RFGF_MS_PERSON(ID, FIRSTNAME, FIRMID) values (1, \'Alice\', 1);', $connection);
  executeInDb('insert into RFGF_MS_PERSON(ID, FIRSTNAME, FIRMID) values (2, \'Bob\',   2);', $connection);
  executeInDb('insert into RFGF_MS_PERSON(ID, FIRSTNAME, FIRMID) values (3, \'Carol\', 3);', $connection);
  executeInDb('insert into RFGF_MS_PERSON(ID, FIRSTNAME, FIRMID) values (4, \'Dan\',   1);', $connection);

  executeInDb('Drop table if exists RFGF_MS_FIRM_BT;', $connection);
  executeInDb('Create Table RFGF_MS_FIRM_BT(ID INT, LEGALNAME VARCHAR(100), FROM_Z DATE, THRU_Z DATE);', $connection);
  executeInDb('insert into RFGF_MS_FIRM_BT(ID, LEGALNAME, FROM_Z, THRU_Z) values (1, \'Firm One v1\', \'2020-01-01\', \'2024-01-01\');', $connection);
  executeInDb('insert into RFGF_MS_FIRM_BT(ID, LEGALNAME, FROM_Z, THRU_Z) values (1, \'Firm One v2\', \'2024-01-01\', \'9999-12-31\');', $connection);
  executeInDb('insert into RFGF_MS_FIRM_BT(ID, LEGALNAME, FROM_Z, THRU_Z) values (2, \'Firm Two\',    \'2020-01-01\', \'2023-06-01\');', $connection);
  executeInDb('insert into RFGF_MS_FIRM_BT(ID, LEGALNAME, FROM_Z, THRU_Z) values (3, \'Firm Three\',  \'2023-01-01\', \'9999-12-31\');', $connection);
  true;
}

