function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::temporalUnion::testRelationFunctionGraphFetchMilestonedTableJoinedAfterNonMilestonedTable():Boolean[1]
{
  let tree = #{
    RfgfMsBtEmployment {
      firstName,
      legalName,
      businessDate
    }
  }#;

  let result = execute(
    |RfgfMsBtEmployment.all(%2023-08-01)->graphFetch($tree)->serialize($tree),
    RfgfMsOwnDBMapping,
