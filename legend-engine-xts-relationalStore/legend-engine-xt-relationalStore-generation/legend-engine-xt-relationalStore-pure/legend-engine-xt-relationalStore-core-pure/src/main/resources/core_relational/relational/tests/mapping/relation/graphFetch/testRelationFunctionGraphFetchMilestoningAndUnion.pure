function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::temporalUnion::testRelationFunctionGraphFetchBusinessTemporalRoot():Boolean[1]
{
  let tree = #{
    RfgfMsBtPerson {
      firstName,
      businessDate
    }
  }#;

  let result = execute(
    |RfgfMsBtPerson.all(%2025-01-01)->graphFetch($tree)->serialize($tree),
    RfgfMsMilestonedDBMapping,
    milestonedDBRuntime(),
    meta::relational::extension::relationalExtensions()
  );

  assertJsonStringsEqual(
    '[{"firstName":"Peter","businessDate":"2025-01-01"},{"firstName":"Jane","businessDate":"2025-01-01"},{"firstName":"Anthony","businessDate":"2025-01-01"}]',
    $result.values
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::temporalUnion::testRelationFunctionGraphFetchBiTemporalRoot():Boolean[1]
{
  let tree = #{
    RfgfMsBiPerson {
      firstName,
      processingDate,
      businessDate
    }
  }#;

  let result = execute(
    |RfgfMsBiPerson.all(%2025-01-01, %2024-12-30)->graphFetch($tree)->serialize($tree),
    RfgfMsMilestonedDBMapping,
    milestonedDBRuntime(),
    meta::relational::extension::relationalExtensions()
  );

  assertJsonStringsEqual(
    '[{"firstName":"Peter","processingDate":"2025-01-01","businessDate":"2024-12-30"},{"firstName":"Jane","processingDate":"2025-01-01","businessDate":"2024-12-30"}]',
    $result.values
  );
}

// Unfiltered, Firm X would also list John and Firm B Anthony; only the propagated 2024-12-30 business date excludes them.
// ToFix, not relation-function specific: Java serializer generation fails for a date-propagated no-arg milestoned property
// (serialize.pure); a Relational mapping of the same association fails the same way.
function <<test.Test, test.AlloyOnly, test.ToFix>> meta::relational::tests::mapping::relation::graphFetch::temporalUnion::testRelationFunctionGraphFetchMilestonedPropertyWithDatePropagatedFromRoot():Boolean[1]
{
  let queryString = 'function my::func():String[1]\n' +
                    '{\n' +
                    '  meta::relational::tests::mapping::relation::graphFetch::temporalUnion::RfgfMsBtFirm.all(%2024-12-30)\n' +
                    '    ->graphFetch(#{meta::relational::tests::mapping::relation::graphFetch::temporalUnion::RfgfMsBtFirm {legalName, btEmployees {firstName}}}#)\n' +
                    '    ->serialize(#{meta::relational::tests::mapping::relation::graphFetch::temporalUnion::RfgfMsBtFirm {legalName, btEmployees() {firstName}}}#)\n' +
                    '}';
  let query = meta::legend::compileLegendGrammar($queryString)->at(0)->cast(@FunctionDefinition<{->String[1]}>);

  let result = meta::pure::router::execute(
    $query,
    RfgfMsMilestonedDBMapping,
    milestonedDBRuntime(),
    meta::relational::extension::relationalExtensions()
  );

  assertJsonStringsEqual(
    '[{"legalName":"Firm X","btEmployees(2024-12-30)":[{"firstName":"Peter"}]},' +
    '{"legalName":"Firm B","btEmployees(2024-12-30)":[]},' +
    '{"legalName":"Firm C","btEmployees(2024-12-30)":[{"firstName":"Fabrice"},{"firstName":"Oliver"}]},' +
    '{"legalName":"Firm D","btEmployees(2024-12-30)":[]}]',
    $result.values
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::temporalUnion::testRelationFunctionGraphFetchMilestonedPropertyWithExplicitDate():Boolean[1]
{
  let tree = #{
    RfgfMsPerson {
      firstName,
      firm(%2023-08-01) {
        legalName
      }
    }
  }#;

  let result = execute(
    |RfgfMsPerson.all()->graphFetch($tree)->serialize($tree),
    RfgfMsOwnDBMapping,
    ownDBRuntime(),
    meta::relational::extension::relationalExtensions()
  );

  assertJsonStringsEqual(
    '[{"firstName":"Alice","firm(2023-08-01)":{"legalName":"Firm One v1"}},{"firstName":"Bob","firm(2023-08-01)":null},{"firstName":"Carol","firm(2023-08-01)":{"legalName":"Firm Three"}},{"firstName":"Dan","firm(2023-08-01)":{"legalName":"Firm One v1"}}]',
    $result.values
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::temporalUnion::testRelationFunctionGraphFetchAllVersionsRoot():Boolean[1]
{
