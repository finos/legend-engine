// Both join inputs are select()-ed: without that, milestoning this join fails with 'Duplicate column names between input TDS'.
function meta::relational::tests::mapping::relation::graphFetch::temporalUnion::rfgfEmploymentNonMilestonedFirstFn():meta::pure::metamodel::relation::Relation<Any>[1]
{
  #>{meta::relational::tests::mapping::relation::graphFetch::temporalUnion::RfgfMsDB.RFGF_MS_PERSON}#->select(~[ID, FIRSTNAME, FIRMID])
    ->join(
      #>{meta::relational::tests::mapping::relation::graphFetch::temporalUnion::RfgfMsDB.RFGF_MS_FIRM_BT}#->select(~[ID, LEGALNAME, FROM_Z])->rename(~ID, ~FIRM_ID),
      meta::pure::functions::relation::JoinKind.INNER,
      {p, f | $p.FIRMID == $f.FIRM_ID}
    )
}

