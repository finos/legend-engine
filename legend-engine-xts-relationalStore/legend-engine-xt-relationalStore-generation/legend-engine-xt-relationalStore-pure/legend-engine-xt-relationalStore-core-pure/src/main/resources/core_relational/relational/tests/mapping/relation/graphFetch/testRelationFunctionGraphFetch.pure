  let result = execute(
    |meta::relational::tests::mapping::relation::ProcessingTemporalPerson.all(%2025-06-01)->graphFetch($tree)->serialize($tree),
    meta::relational::tests::mapping::relation::TemporalMilestonedGraphFetchMapping,
