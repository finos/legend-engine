import meta::pure::graphFetch::*;
import meta::pure::graphFetch::execution::*;
import meta::relational::tests::mapping::relation::*;

function <<test.BeforePackage>> meta::relational::tests::mapping::relation::graphFetch::setUp():Boolean[1]
{
  meta::relational::tests::mapping::relation::createTablesAndFillDb();
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::testSimpleRelationFunctionGraphFetch():Boolean[1]
{
  let tree = #{
    meta::relational::tests::mapping::relation::Person {
      firstName,
      age
    }
  }#;

  let result = execute(
    |meta::relational::tests::mapping::relation::Person.all()->graphFetch($tree)->serialize($tree),
    meta::relational::tests::mapping::relation::SimpleMapping,
    meta::external::store::relational::tests::testRuntime(meta::relational::tests::mapping::relation::testDB),
    meta::relational::extension::relationalExtensions()
  );

  assertJsonStringsEqual(
    '[{"firstName":"John","age":30},{"firstName":"Fabrice","age":45},{"firstName":"Oliver","age":26},{"firstName":"David","age":52}]',
    $result.values
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::testRelationFunctionGraphFetchToOne():Boolean[1]
{
  let tree = #{
    meta::relational::tests::mapping::relation::Person {
      firstName,
      firm {
        legalName
      }
    }
  }#;

  let result = execute(
    |meta::relational::tests::mapping::relation::Person.all()->graphFetch($tree)->serialize($tree),
    meta::relational::tests::mapping::relation::SimpleMapping,
    meta::external::store::relational::tests::testRuntime(meta::relational::tests::mapping::relation::testDB),
    meta::relational::extension::relationalExtensions()
  );

  assertJsonStringsEqual(
    '[{"firstName":"John","firm":{"legalName":"Firm X"}},{"firstName":"Fabrice","firm":{"legalName":"Firm C"}},{"firstName":"Oliver","firm":{"legalName":"Firm C"}},{"firstName":"David","firm":{"legalName":"Firm D"}}]',
    $result.values
  );
}

function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::testRelationFunctionGraphFetchToMany():Boolean[1]
{
  let tree = #{
    meta::relational::tests::mapping::relation::Firm {
      legalName,
      employees {
        firstName
      }
    }
  }#;

  let result = execute(
    |meta::relational::tests::mapping::relation::Firm.all()->graphFetch($tree)->serialize($tree),
    meta::relational::tests::mapping::relation::SimpleMapping,
    meta::external::store::relational::tests::testRuntime(meta::relational::tests::mapping::relation::testDB),
    meta::relational::extension::relationalExtensions()
  );

  assertJsonStringsEqual(
    '[{"legalName":"Firm X","employees":[{"firstName":"John"}]},{"legalName":"Firm A","employees":[]},{"legalName":"Firm B","employees":[]},{"legalName":"Firm C","employees":[{"firstName":"Fabrice"},{"firstName":"Oliver"}]},{"legalName":"Firm D","employees":[{"firstName":"David"}]}]',
    $result.values
  );
}

