function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::testRelationFunctionGraphFetchEmbedded():Boolean[1]
{
  let tree = #{
    meta::relational::tests::mapping::relation::PersonWithAddress {
      firstName,
      age,
      address {
        street,
        city
      }
    }
  }#;

  let result = execute(
    |meta::relational::tests::mapping::relation::PersonWithAddress.all()->graphFetch($tree)->serialize($tree),
