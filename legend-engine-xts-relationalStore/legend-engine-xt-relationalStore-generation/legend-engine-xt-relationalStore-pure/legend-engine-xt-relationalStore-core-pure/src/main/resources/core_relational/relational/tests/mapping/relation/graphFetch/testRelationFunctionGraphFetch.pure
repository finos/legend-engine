function <<test.Test, test.AlloyOnly>> meta::relational::tests::mapping::relation::graphFetch::testRelationFunctionGraphFetchSubType():Boolean[1]
{
  let treeString = '#{\n' +
                   '  meta::relational::tests::mapping::relation::Person {\n' +
                   '    firstName,\n' +
                   '    age,\n' +
                   '    ->subType(@meta::relational::tests::mapping::relation::PersonWithFirmId) {\n' +
                   '      firmId\n' +
                   '    }\n' +
                   '  }\n' +
                   '}#';
  let tree = meta::legend::compileLegendValueSpecification($treeString)->cast(@RootGraphFetchTree<meta::relational::tests::mapping::relation::Person>);

  let result = execute(
    |meta::relational::tests::mapping::relation::Person.all()->graphFetch($tree)->serialize($tree),
    meta::relational::tests::mapping::relation::ExtendsRelationMapping,
    meta::external::store::relational::tests::testRuntime(meta::relational::tests::mapping::relation::testDB),
    meta::relational::extension::relationalExtensions()
  );

  assertJsonStringsEqual(
    '[{"firstName":"Peter","age":23,"firmId":1},{"firstName":"John","age":30,"firmId":1},{"firstName":"Jane","age":23,"firmId":2},{"firstName":"Anthony","age":19,"firmId":3},{"firstName":"Fabrice","age":45,"firmId":4},{"firstName":"Oliver","age":26,"firmId":4},{"firstName":"David","age":52,"firmId":5}]',
    $result.values
  );
}

