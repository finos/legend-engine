import meta::external::store::relational::sqlDialectTranslation::functionRegistry::postgresNativeFunctions::string::*;
import meta::external::store::relational::sqlDialectTranslation::tests::utils::*;
import meta::external::query::sql::metamodel::*;
import meta::external::store::relational::sqlDialectTranslation::*;
import meta::external::store::relational::sqlDialectTranslation::functionRegistry::*;
import meta::external::store::relational::sqlDialectTranslation::sqlTyping::sqlTypes::*;
import meta::external::store::relational::sqlDialectTranslation::utils::*;

Class {sqlFunctionInfo.initializer = 'string_to_array'} meta::external::store::relational::sqlDialectTranslation::functionRegistry::postgresNativeFunctions::string::StringToArray extends PostgresNativeSqlFunction
[
  $this.name == 'string_to_array'
]
{}

function meta::external::store::relational::sqlDialectTranslation::functionRegistry::postgresNativeFunctions::string::stringToArray(): SqlFunction[1]
{
  ^meta::external::store::relational::sqlDialectTranslation::functionRegistry::postgresNativeFunctions::string::StringToArray
  (
    name = 'string_to_array',
    documentation = 'Split string (1st arg) on delimiter (2nd arg) and return the array',
    variations = [
      ^SqlFunctionVariation
      (
        parameterTypes = [AbstractStringSqlType, AbstractStringSqlType],
        returnType = ArraySqlType
      )
    ],
    tests = [
      sqlFunctionTest(
        simpleFunctionCall('replace', [cast(simpleFunctionCall('string_to_array', [literal('abc|def|ghi'), literal('|')]), 'varchar'), literal(' '), literal('')]),
        '[abc,def,ghi]'
      ),
      sqlFunctionTest(
        cast(simpleFunctionCall('string_to_array', [literal('abc'), literal('|')]), 'varchar'),
        '[abc]'
      )
      //TODO investigate
      // sqlFunctionTest(
      //   cast(simpleFunctionCall('string_to_array', [literal('abc|'), literal('|')]), 'varchar'),
      //   '[abc, ]'
      // )
    ]
  )
}