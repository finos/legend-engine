###Pure
import test::umberbeacon5::domain::*;

Class <<meta::pure::profiles::typemodifiers.abstract, test::umberbeacon5::domain::CanopyStewardship.curatedRegistry>> {meta::pure::profiles::doc.doc = 'Shared shape of every entry in the urban canopy registry; annotations placed here stay visible through the hierarchy.', test::umberbeacon5::domain::CanopyStewardship.stewardTeam = 'canopy-registry', test::umberbeacon5::domain::CanopyStewardship.retentionBand = 'long'} test::umberbeacon5::domain::CanopyRegistryEntry
{
  entryCode: String[1];
  displayLabel: String[1];
  <<test::umberbeacon5::domain::CanopyStewardship.provisionalEntry>> {meta::pure::profiles::doc.doc = 'Free-text remark kept optional so an entry can be registered before it is described.'} commentary: String[0..1];
}

Class <<test::umberbeacon5::domain::CanopyStewardship.fieldSurveyed>> {meta::pure::profiles::doc.doc = 'A surveyed planting area, retrieved without a business date because its boundary is treated as fixed.', test::umberbeacon5::domain::CanopyStewardship.stewardTeam = 'plot-survey', test::umberbeacon5::domain::CanopyStewardship.surveyCadence = 'seasonal'} test::umberbeacon5::domain::InventoryPlot extends CanopyRegistryEntry
{
  <<test::umberbeacon5::domain::CanopyStewardship.fieldSurveyed>> stratum: CanopyStratum[1];
  <<test::umberbeacon5::domain::CanopyStewardship.fieldSurveyed>> {meta::pure::profiles::doc.doc = 'Surveyed area of the plot; absent while a boundary walk is outstanding.'} areaSquareMetres: Float[0..1];
  paverEdged: Boolean[1];
  establishedYear: Integer[1];
}

Class <<meta::pure::profiles::temporal.businesstemporal, test::umberbeacon5::domain::CanopyStewardship.fieldSurveyed>> {meta::pure::profiles::doc.doc = 'A planted specimen versioned along business time, so a re-identification supersedes the earlier version rather than replacing it.', test::umberbeacon5::domain::CanopyStewardship.stewardTeam = 'arboriculture', test::umberbeacon5::domain::CanopyStewardship.retentionBand = 'long'} test::umberbeacon5::domain::PlantedSpecimen
{
  specimenCode: String[1];
  <<test::umberbeacon5::domain::CanopyStewardship.curatedRegistry>> stratum: CanopyStratum[1];
  {meta::pure::profiles::doc.doc = 'The unversioned plot the specimen stands in, so one traversal crosses from a versioned grain into an unversioned one.'} plot: InventoryPlot[1];
  girthMillimetres: Integer[0..1];
  vernacularName: String[0..1];
}

Class <<meta::pure::profiles::temporal.businesstemporal, test::umberbeacon5::domain::CanopyStewardship.provisionalEntry>> {meta::pure::profiles::doc.doc = 'One condition assessment of a specimen, versioned along business time so a corrected grade supersedes the grade it replaces.', test::umberbeacon5::domain::CanopyStewardship.stewardTeam = 'condition-review', test::umberbeacon5::domain::CanopyStewardship.surveyCadence = 'annual'} test::umberbeacon5::domain::CanopyAssessment
{
  assessmentCode: String[1];
  <<test::umberbeacon5::domain::CanopyStewardship.provisionalEntry>> vigour: VigourGrade[1];
  crownSpreadMetres: Float[1];
  <<test::umberbeacon5::domain::CanopyStewardship.fieldSurveyed>> {meta::pure::profiles::doc.doc = 'Optional note from the assessor; left empty for a drive-by grade.'} assessorNote: String[0..1];
}
