Profile demo::meadowcove2::flat::RecordIdentity
{
  stereotypes: [equalityKey];
  tags: [keyRole];
}

Class {meta::pure::profiles::doc.doc = 'Flat kelp observation restating every enveloped and inherited attribute as a single-level record with closed validity bounds.'} demo::meadowcove2::flat::KelpObservation
{
  <<demo::meadowcove2::flat::RecordIdentity.equalityKey>> {demo::meadowcove2::flat::RecordIdentity.keyRole = 'identifier'} identifier: String[1];
  <<demo::meadowcove2::flat::RecordIdentity.equalityKey>> {demo::meadowcove2::flat::RecordIdentity.keyRole = 'version'} revision: Integer[1];
  collectionName: String[1];
  registeredBy: String[1];
  registrationSource: String[1];
  reviewStatus: String[1];
  validFrom: DateTime[1];
  validThru: DateTime[1];
  surveyDate: StrictDate[1];
  depthBand: String[1];
  waterTemperature: Float[1];
  canopyCoverPercent: Float[1];
  frondCount: Integer[1];
}
