Class {meta::pure::profiles::doc.doc = 'Generic registration base carrying the audit and validity attributes shared by every collected observation.'} demo::meadowcove2::hierarchy::ObservationRegistration
{
  registeredBy: String[1];
  registrationSource: String[1];
  revision: Integer[1];
  reviewStatus: String[1];
  validFrom: DateTime[1];
  validThru: DateTime[0..1];
  surveyDate: StrictDate[1];
  depthCode: String[0..1];
  waterTemperature: Float[1];
  canopyGrade: String[1];
}

Class {meta::pure::profiles::doc.doc = 'Kelp observation payload adding the two measured domain attributes to the shared registration base.'} demo::meadowcove2::hierarchy::KelpObservation extends demo::meadowcove2::hierarchy::ObservationRegistration
{
  canopyCoverPercent: Float[0..1];
  frondCount: Integer[0..1];
}
