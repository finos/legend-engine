import test::wistfulmarsh2::domain::*;

Class {meta::pure::profiles::doc.doc = 'A delineated stretch of wetland that survey work is attributed to.'} test::wistfulmarsh2::domain::MarshZone
{
  zoneCode: String[1];
  tidalRegime: TidalRegime[1];
  salinity: SalinityBand[1];
  hectares: Float[1];
}

Class {meta::pure::profiles::doc.doc = 'A wetland zone lying between the low and high tide marks.'} test::wistfulmarsh2::domain::IntertidalZone extends MarshZone
{
  substrate: SubstrateType[1];
  meanInundationHours: Integer[0..1];
}

Class {meta::pure::profiles::doc.doc = 'The transitional slope above the tidal wetland where terrestrial vegetation takes over.'} test::wistfulmarsh2::domain::UplandFringeZone extends MarshZone
{
  slopePercent: Integer[1];
  aspect: SlopeAspect[1];
}

Class {meta::pure::profiles::doc.doc = 'An intertidal zone whose channels are actively re-cut to restore drainage.'} test::wistfulmarsh2::domain::RestoredCreekZone extends IntertidalZone
{
  restorationYear: Integer[1];
}
