import test::wistfulmarsh2::domain::*;

Class {meta::pure::profiles::doc.doc = 'The shared contract every field observation satisfies, whatever was observed.'} test::wistfulmarsh2::domain::SurveyRecord
{
  recordId: String[1];
  observedOn: StrictDate[1];
  method: SurveyMethod[1];
  confidence: ObservationConfidence[1];
  surveyorInitials: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'An observation of vegetation within a stratum of a wetland zone.'} test::wistfulmarsh2::domain::PlantSurveyRecord extends SurveyRecord
{
  stratum: VegetationStratum[1];
  percentCover: Integer[1];
  taxonName: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A stem-count census of sedges, a plant observation refined with a countable measure.'} test::wistfulmarsh2::domain::SedgeCensusRecord extends PlantSurveyRecord
{
  stemCount: Integer[1];
  floweringStems: Integer[0..1];
}

Class {meta::pure::profiles::doc.doc = 'An observation of birds using a wetland zone during a visit.'} test::wistfulmarsh2::domain::BirdSurveyRecord extends SurveyRecord
{
  flockSize: Integer[1];
  weather: WeatherCondition[1];
  ringedIndividuals: Integer[0..1];
}
