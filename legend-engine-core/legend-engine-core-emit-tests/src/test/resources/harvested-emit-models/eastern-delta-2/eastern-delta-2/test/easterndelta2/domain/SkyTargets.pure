import test::easterndelta2::domain::*;

Class test::easterndelta2::domain::SkyTarget
{
  designation: String[1];
  commonName: String[0..1];
  kind: TargetKind[1];
  catalogue: CatalogueOrigin[1];
  rightAscensionHours: Float[1];
  declinationDegrees: Float[1];
  displayLabel() {if($this.commonName->isEmpty(), |'UNNAMED FIELD', |$this.commonName->toOne())}: String[1];
}

Class test::easterndelta2::domain::DeepSkyTarget extends SkyTarget
{
  apparentMagnitude: Float[1];
  angularSizeArcminutes: Float[0..1];
}

Class test::easterndelta2::domain::GalaxyTarget extends DeepSkyTarget
{
  morphologyCode: String[1];
  inclinationDegrees: Float[0..1];
}

Class test::easterndelta2::domain::NebulaTarget extends DeepSkyTarget
{
  emissionLines: String[*];
  ionised: Boolean[1];
}

Class test::easterndelta2::domain::MinorBodyTarget extends SkyTarget
{
  orbitalPeriodDays: Float[0..1];
  provisionalLabel: String[0..1];
}
