import test::easterndelta2::domain::*;

Class test::easterndelta2::domain::ObservatorySite
{
  siteCode: String[1];
  siteName: String[1];
  elevationMetres: Integer[1];
  typicalSeeing: SeeingGrade[1];
  darkSkyRating: Integer[0..1];
}

Class test::easterndelta2::domain::MountainSite extends ObservatorySite
{
  accessRoadOpenMonths: Integer[1];
  ridgeOrientation: String[0..1];
}

Class test::easterndelta2::domain::HighDesertSite extends ObservatorySite
{
  annualClearNights: Integer[1];
  dustSeasonMonths: String[*];
}

Class test::easterndelta2::domain::Instrument
{
  instrumentCode: String[1];
  mount: MountKind[1];
  detector: DetectorKind[1];
  apertureMillimetres: Integer[1];
  calibration: CalibrationState[1];
}

Class test::easterndelta2::domain::SurveyProgramme
{
  programmeCode: String[1];
  title: String[1];
  leadInitials: String[0..1];
  startedInYear: Integer[1];
}
