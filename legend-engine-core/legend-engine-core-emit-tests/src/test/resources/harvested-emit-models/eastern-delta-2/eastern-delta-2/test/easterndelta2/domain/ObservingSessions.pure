import test::easterndelta2::domain::*;

Class test::easterndelta2::domain::ObservingSession
{
  sessionCode: String[1];
  observedOn: StrictDate[1];
  seeing: SeeingGrade[1];
  moonPhase: MoonPhase[1];
  dome: DomeStatus[1];
  conditions: SkyCondition[*];
  logNotes: String[0..1];
  conditionSummary() {if($this.conditions->isEmpty(), |'CONDITIONS NOT LOGGED', |$this.seeing.name->toOne() + ' / ' + $this.conditions->map(c | $c.name->toOne())->joinStrings('+'))}: String[1];
  targetLabels() {if($this.targets->isEmpty(), |'NO TARGET ASSIGNED', |$this.targets->map(t | $t.displayLabel)->joinStrings(' | '))}: String[1];
}

Class test::easterndelta2::domain::ImagingSession extends ObservingSession
{
  band: FilterBand[1];
  frameCount: Integer[1];
  frameSeconds: Integer[1];
}

Class test::easterndelta2::domain::NarrowbandImagingSession extends ImagingSession
{
  lineWidthNanometres: Float[1];
  guideStarDesignation: String[0..1];
}

Class test::easterndelta2::domain::SpectroscopySession extends ObservingSession
{
  resolvingPower: Integer[1];
  slitWidthArcseconds: Float[0..1];
  reductionLabel() {if($this.logNotes->isEmpty(), |'REDUCTION PENDING', |$this.logNotes->toOne())}: String[1];
}
