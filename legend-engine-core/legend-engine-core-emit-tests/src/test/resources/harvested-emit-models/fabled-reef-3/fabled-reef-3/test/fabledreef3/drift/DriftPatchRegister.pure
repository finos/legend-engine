###Pure
import demo::fabledreef3::drift::*;
import demo::fabledreef3::annotation::*;
import meta::pure::profiles::*;

Class <<typemodifiers.abstract, temporal.businesstemporal, RegisterMeta.publishedField>> {RegisterMeta.custodian = 'drift-watch-desk', RegisterMeta.surveyProgramme = 'drift-patch-watch'} demo::fabledreef3::drift::DriftPatchObservation
{
  <<RegisterMeta.stationKey, Nullability.required>> {RegisterMeta.fieldWidth = '16'} patchCode: String[1];
  <<Nullability.required>> observedOn: StrictDate[1];
  <<Nullability.optional>> {Nullability.absentMeaning = 'patch was logged from shore without an areal fix'} patchAreaSquareMetres: Float[0..1];
}

Class <<temporal.businesstemporal, RegisterMeta.rolledUpField>> {RegisterMeta.custodian = 'drift-watch-desk'} demo::fabledreef3::drift::StrandedDriftPatch extends DriftPatchObservation
{
  <<Nullability.required>> {RegisterMeta.fieldWidth = '24'} strandLineLabel: String[1];
  <<Nullability.required>> wrackDepthCm: Float[1];
  <<Nullability.optional>> removalCrewCode: String[0..1];
}

Class <<temporal.businesstemporal>> demo::fabledreef3::drift::FloatingDriftPatch extends DriftPatchObservation
{
  <<Nullability.required>> driftSpeedMetresPerHour: Float[1];
  <<Nullability.optional>> {Nullability.absentMeaning = 'patch drifted out of the watch box before a heading was taken'} driftHeadingDegrees: Integer[0..1];
}
