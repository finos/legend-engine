import meta::pure::profiles::*;
import test::easterncavern::domain::*;

Profile test::easterncavern::domain::CavernMeta
{
  stereotypes: [provisional, superseded];
  tags: [steward, revision];
}

Enum {doc.doc = 'Cross-section shape recorded for a surveyed passage.'} test::easterncavern::domain::PassageShape
{
  {doc.doc = 'Rounded tube dissolved under full water pressure.'} PHREATIC_TUBE,
  {doc.doc = 'Tall narrow channel cut by a free-flowing stream.'} VADOSE_CANYON,
  {doc.doc = 'Narrow joint-guided fissure.'} FISSURE,
  {doc.doc = 'Collapse-widened chamber with a rubble floor.'} BREAKDOWN_CHAMBER
}

Enum {doc.doc = 'Mineral deposit families catalogued inside the cavern system.'} test::easterncavern::domain::FormationKind
{
  {doc.doc = 'Deposit growing downward from the ceiling.'} STALACTITE,
  {doc.doc = 'Deposit growing upward from the floor.'} STALAGMITE,
  {doc.doc = 'Thin sheet deposit hanging from an inclined ceiling.'} DRAPERY,
  {doc.doc = 'Radiating crystal cluster.'} HELICTITE
}

Enum {doc.doc = 'Precision grade attached to a survey leg.'} test::easterncavern::domain::SurveyGrade
{
  {doc.doc = 'Sketch from memory, no instruments.'} SKETCH,
  {doc.doc = 'Compass and tape with estimated stations.'} COMPASS_TAPE,
  {doc.doc = 'Instrument survey with fixed stations.'} INSTRUMENT
}
