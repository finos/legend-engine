###Pure
import test::borealridge::domain::*;
import test::borealridge::payload::*;
import test::borealridge::profile::*;

Class test::borealridge::payload::PatrolPayload
{
  sectionCode: String[1];
  patrolledOn: StrictDate[1];
  record: PatrolPayloadRecord[1];
}

Class test::borealridge::payload::PatrolPayloadRecord
{
  surfaceCode: String[0..1];
  gradeCode: String[0..1];
  markersMissing: Integer[0..1];
  stewardCode: String[1];
  plannedOn: StrictDate[0..1];
}

Class <<RidgeVocabulary.publishedSurface>> test::borealridge::payload::PatrolDigest
{
  {RidgeVocabulary.displayName = 'Section Code', RidgeVocabulary.targetName = 'section_code'} sectionCode: String[1];
  {RidgeVocabulary.displayName = 'Marker Band'} markerBand: String[1];
  {RidgeVocabulary.displayName = 'Steward Label'} stewardLabel: String[1];
  registrationState: String[1];
  effectiveOn: StrictDate[1];
  surface: SurfaceType[1];
  grade: RouteGrade[1];
}
