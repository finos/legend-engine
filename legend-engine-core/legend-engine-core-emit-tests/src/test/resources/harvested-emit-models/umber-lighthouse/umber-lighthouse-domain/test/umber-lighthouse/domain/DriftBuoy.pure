Class {meta::pure::profiles::doc.doc = 'A free-floating buoy that drifts on coastal currents while reporting telemetry.'} test::umberlighthouse::domain::DriftBuoy
{
  {meta::pure::profiles::doc.doc = 'Opaque hull identifier stamped on the buoy.'} hullCode: String[1];
  {meta::pure::profiles::doc.doc = 'Remaining battery charge as a fraction between zero and one.'} batteryFraction: Decimal[1];
  {meta::pure::profiles::doc.doc = 'Count of satellite fixes acquired in the last hour.'} fixCount: Integer[1];
  {meta::pure::profiles::doc.doc = 'Firmware revision byte currently installed on the buoy.'} firmwareByte: Byte[1];
  {meta::pure::profiles::doc.doc = 'Whether the buoy has drifted outside its permitted watch circle.'} adrift: Boolean[1];
  {meta::pure::profiles::doc.doc = 'Day of the buoy last confirmed position.'} lastFixOn: StrictDate[1];
}
