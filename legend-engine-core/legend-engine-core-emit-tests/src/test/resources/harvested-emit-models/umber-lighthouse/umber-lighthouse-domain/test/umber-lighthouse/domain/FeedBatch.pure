Class {meta::pure::profiles::doc.doc = 'A batch envelope grouping a run of readings before they are published to the downstream feed.'} test::umberlighthouse::domain::FeedBatch
{
  {meta::pure::profiles::doc.doc = 'Opaque identifier of the batch envelope.'} batchCode: String[1];
  {meta::pure::profiles::doc.doc = 'Day the batch was assembled.'} assembledOn: StrictDate[1];
  {meta::pure::profiles::doc.doc = 'Number of readings carried in the batch.'} readingCount: Integer[1];
  {meta::pure::profiles::doc.doc = 'Rolling three-hour mean water level, in metres.'} '3hourMeanMetres': Decimal[1];
  {meta::pure::profiles::doc.doc = 'Signed change against the reading from two intervals earlier, in metres.'} 'delta-2metres': Decimal[1];
  {meta::pure::profiles::doc.doc = 'Combined quality-and-completeness flag byte.'} 'quality+flag': Byte[1];
  {meta::pure::profiles::doc.doc = 'Whether the batch was sealed without manual override.'} sealed: Boolean[1];
}
