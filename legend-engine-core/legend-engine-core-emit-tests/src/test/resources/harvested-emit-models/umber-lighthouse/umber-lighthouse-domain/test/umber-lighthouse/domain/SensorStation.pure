Class {meta::pure::profiles::doc.doc = 'A fixed shore installation that hosts one or more tide and wave sensors.'} test::umberlighthouse::domain::SensorStation
{
  {meta::pure::profiles::doc.doc = 'Human-readable name of the shore station.'} stationName: String[1];
  {meta::pure::profiles::doc.doc = 'Elevation of the station platform above chart datum, in metres.'} platformElevationMetres: Decimal[1];
  {meta::pure::profiles::doc.doc = 'Number of independent sensor channels wired to the station.'} channelCount: Integer[1];
  {meta::pure::profiles::doc.doc = 'Whether the station is currently reporting to the feed.'} online: Boolean[1];
  {meta::pure::profiles::doc.doc = 'Date the station was commissioned into the network.'} commissionedOn: StrictDate[1];
}
