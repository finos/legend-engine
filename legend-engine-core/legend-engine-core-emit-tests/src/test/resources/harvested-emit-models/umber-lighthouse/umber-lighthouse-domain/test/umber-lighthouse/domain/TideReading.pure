Class {meta::pure::profiles::doc.doc = 'A single water-level sample captured by a coastal tide gauge at a moment in time.'} test::umberlighthouse::domain::TideReading
{
  {meta::pure::profiles::doc.doc = 'Opaque identifier of the gauge that produced this reading.'} gaugeCode: String[1];
  {meta::pure::profiles::doc.doc = 'Observed water height above chart datum, in metres.'} waterLevelMetres: Decimal[1];
  {meta::pure::profiles::doc.doc = 'Calendar day on which the sample was recorded.'} observedOn: StrictDate[1];
  {meta::pure::profiles::doc.doc = 'Sequential sample index within the gauge day.'} sampleIndex: Integer[1];
  {meta::pure::profiles::doc.doc = 'Whether the sample passed the gauge self-check.'} validated: Boolean[1];
  {meta::pure::profiles::doc.doc = 'Optional free-text note attached by a field technician.'} technicianNote: String[0..1];
}
