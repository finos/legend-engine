###Pure
import test::opalorchard::domain::*;
import meta::pure::profiles::*;

Enum {doc.doc = 'The heat source a kiln in the community studio fires with.'} test::opalorchard::domain::KilnType
{
  ELECTRIC,
  GAS,
  WOOD,
  RAKU
}

Enum {doc.doc = 'The atmosphere a firing is run under, which decides how a glaze develops.'} test::opalorchard::domain::FiringAtmosphere
{
  OXIDATION,
  REDUCTION,
  NEUTRAL,
  SALT
}

Enum {doc.doc = 'How far a piece has travelled through the making and firing sequence.'} test::opalorchard::domain::PieceStage
{
  GREENWARE,
  BISQUE,
  GLAZED,
  FIRED
}

Enum {doc.doc = 'The surface a glaze leaves once it has cooled.'} test::opalorchard::domain::GlazeFinish
{
  MATTE,
  SATIN,
  GLOSS,
  CRYSTALLINE
}
