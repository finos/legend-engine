###Pure
import meta::pure::profiles::*;
import test::tealotter5::domain::*;

Association {doc.doc = 'A street tree owns its canopy inspections, crossing from a business-temporal planting into a bi-temporal inspection record.'} test::tealotter5::domain::StreetTree_InspectionEntry
{
  inspectedTree: StreetTree[1];
  inspectionEntries: InspectionEntry[*];
}

Association {doc.doc = 'A street tree accumulates maintenance visits, crossing from a business-temporal planting into a processing-temporal visit log.'} test::tealotter5::domain::StreetTree_MaintenanceVisit
{
  maintainedTree: StreetTree[0..1];
  maintenanceVisits: MaintenanceVisit[*];
}

Association {doc.doc = 'An arborist crew carries out maintenance visits, with both ends recorded on the processing timeline.'} test::tealotter5::domain::ArboristCrew_MaintenanceVisit
{
  assignedCrew: ArboristCrew[1];
  performedVisits: MaintenanceVisit[*];
}

Association {doc.doc = 'A ward canopy zone groups planter beds, joining an unversioned zone to business-temporal beds.'} test::tealotter5::domain::CanopyZone_PlanterBed
{
  canopyZone: CanopyZone[1];
  planterBeds: PlanterBed[*];
}

Association {doc.doc = 'A ward canopy zone also groups heritage trees so the heritage register can be reported per ward.'} test::tealotter5::domain::CanopyZone_HeritageTree
{
  heritageZone: CanopyZone[0..1];
  heritageTrees: HeritageTree[*];
}
