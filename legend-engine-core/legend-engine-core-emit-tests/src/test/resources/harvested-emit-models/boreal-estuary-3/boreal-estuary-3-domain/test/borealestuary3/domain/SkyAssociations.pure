###Pure
import test::borealestuary3::domain::*;

Association <<NightSkyProfile.instrumentTracked>> {meta::pure::profiles::doc.doc = 'Bidirectional link between an observatory site and the telescopes it hosts; navigable as one site from a telescope and as a collection of telescopes from a site.'} test::borealestuary3::domain::SiteTelescopes
{
  site: ObservatorySite[1];
  telescopes: Telescope[*];
}

Association <<NightSkyProfile.seasonalProgramme>> {meta::pure::profiles::doc.doc = 'Bidirectional link between a telescope and the observation sessions run on it.'} test::borealestuary3::domain::TelescopeSessions
{
  telescope: Telescope[1];
  sessions: ObservationSession[*];
}

Association {meta::pure::profiles::doc.doc = 'Bidirectional many-to-many link between observation sessions and the sky targets they logged.'} test::borealestuary3::domain::SessionTargets
{
  sessions: ObservationSession[*];
  targets: SkyTarget[*];
}
