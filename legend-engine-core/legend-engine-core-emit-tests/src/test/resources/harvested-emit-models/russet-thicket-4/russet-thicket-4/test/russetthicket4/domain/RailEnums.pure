###Pure
Enum test::russetthicket4::domain::TrackGauge
{
  TWO_FOOT,
  METRE,
  STANDARD,
  BROAD
}

Enum test::russetthicket4::domain::LiveryScheme
{
  LINED_GREEN,
  CRIMSON_LAKE,
  VARNISHED_TEAK,
  WORKS_GREY
}

