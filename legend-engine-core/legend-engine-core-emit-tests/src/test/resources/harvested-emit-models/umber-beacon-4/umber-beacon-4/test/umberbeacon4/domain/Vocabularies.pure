###Pure
Enum {meta::pure::profiles::doc.doc = 'Coastal habitat band a survey element sits in.'} test::umberbeacon4::domain::HabitatZone
{
  Intertidal,
  Sublittoral,
  Estuarine,
  Bathyal
}

Enum {meta::pure::profiles::doc.doc = 'How a telemetry tag is fixed to a tracked organism.'} test::umberbeacon4::domain::TagAttachmentMethod
{
  DorsalClip,
  AcousticImplant,
  ExternalHarness
}

Enum {meta::pure::profiles::doc.doc = 'Life stage recorded for a tracked organism.'} test::umberbeacon4::domain::SpecimenLifeStage
{
  Larval,
  Juvenile,
  Adult,
  Senescent
}

Enum {meta::pure::profiles::doc.doc = 'How firmly an observation identifies its subject.'} test::umberbeacon4::domain::ObservationConfidence
{
  Confirmed,
  Probable,
  Tentative
}

Enum {meta::pure::profiles::doc.doc = 'Reported condition of a deployed sensor.'} test::umberbeacon4::domain::SensorHealth
{
  Nominal,
  Degraded,
  Offline
}

Enum {meta::pure::profiles::doc.doc = 'Degenerate single-value scope marker carried by a custodian team.'} test::umberbeacon4::domain::StewardshipScope
{
  CoastalNetwork
}
