###Pure
import demo::duskythicket3::domain::*;
import demo::duskythicket3::profile::*;
import meta::pure::profiles::*;

Class <<typemodifiers.abstract, ThicketStewardship.regulatedRecord>> {doc.doc = 'Paperwork filed against the woodland register. Abstract, and deliberately unversioned, so the register carries one inheritance family that is not on the processing timeline alongside the family that is.', ThicketStewardship.steward = 'Reserve Records'} demo::duskythicket3::domain::RegisterNotice
{
  {doc.doc = 'Reference the notice is filed under.'} noticeRef: String[1];
  {doc.doc = 'Date the notice was filed.'} filedOn: StrictDate[1];
  {doc.doc = 'Layer the notice concerns, absent for notices that concern the whole reserve.'} concernedLayer: ThicketLayer[0..1];
}

Class {doc.doc = 'A notice that closes a stretch of trail to walkers for a stated reason.'} demo::duskythicket3::domain::ClosureNotice extends RegisterNotice
{
  {doc.doc = 'Reason the stretch was closed.'} closureReason: String[1];
  {doc.doc = 'Days the closure is expected to run for.'} expectedDays: Integer[1];
}

Class {doc.doc = 'A notice that schedules coppicing work, the second notice leaf, adding a decimal measure where its sibling adds an integral one.'} demo::duskythicket3::domain::CoppicingNotice extends RegisterNotice
{
  {doc.doc = 'Area of thicket the work covers in hectares.'} coveredHectares: Float[1];
  {doc.doc = 'Contractor the work is booked with.'} contractorName: String[1];
}
