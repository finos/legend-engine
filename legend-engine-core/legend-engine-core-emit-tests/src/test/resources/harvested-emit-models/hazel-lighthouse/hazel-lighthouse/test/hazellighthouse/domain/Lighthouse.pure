Class <<test::hazellighthouse::profile::LighthouseMeta.heritageListed>> {meta::pure::profiles::doc.doc = 'A coastal lighthouse structure, its identifying beacon colour and nominal light range.', test::hazellighthouse::profile::LighthouseMeta.owningAuthority = 'Coastal Navigation Board'} test::hazellighthouse::domain::Lighthouse
[
  rangeIsPositive: $this.nominalRangeNm > 0
]
{
  name: String[1];
  beaconColor: test::hazellighthouse::domain::BeaconColor[1];
  nominalRangeNm: Integer[1];
  focalHeightM: Integer[0..1];
  isActive() {$this.nominalRangeNm > 0}: Boolean[1];
}
