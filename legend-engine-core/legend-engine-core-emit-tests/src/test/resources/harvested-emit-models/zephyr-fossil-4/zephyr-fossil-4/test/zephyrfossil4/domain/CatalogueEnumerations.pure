###Pure
import meta::pure::profiles::*;

Enum {doc.doc = 'Territory a specimen repository was established in. A closed set that carries an explicit unknown member, so a repository whose founding territory was never recorded is still typed rather than left as a free string.'} demo::zephyrfossil4::domain::EstablishmentTerritory
{
  ARGENTINA,
  AUSTRALIA,
  BOTSWANA,
  BRAZIL,
  CANADA,
  CHILE,
  DENMARK,
  EGYPT,
  ETHIOPIA,
  FINLAND,
  GREENLAND,
  ICELAND,
  INDONESIA,
  KENYA,
  MADAGASCAR,
  MONGOLIA,
  MOROCCO,
  NAMIBIA,
  NEPAL,
  NEW_ZEALAND,
  NORWAY,
  PERU,
  PORTUGAL,
  SPAIN,
  TANZANIA,
  UNKNOWN_TERRITORY
}

Enum {doc.doc = 'Whether a specimen repository is still accessioning material or has been wound down. Exactly two members, so the lifecycle of a repository cannot drift into an undeclared state.'} demo::zephyrfossil4::domain::RepositoryLifecycle
{
  ACCESSIONING,
  WOUND_DOWN
}
