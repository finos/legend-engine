###Pure
import test::quietthicket4::domain::*;

Class <<test::quietthicket4::domain::AllotmentProfile.committeePublished>> {test::quietthicket4::domain::AllotmentProfile.custodianTeam = 'parish-allotment-committee', test::quietthicket4::domain::AllotmentProfile.reviewCadence = 'annual'} test::quietthicket4::domain::AllotmentSite
{
  siteCode: String[1];
  siteName: String[1];
  parishName: String[1];
  hectares: Float[0..1];
}

Class <<test::quietthicket4::domain::AllotmentProfile.committeePublished>> {test::quietthicket4::domain::AllotmentProfile.registerSection = 'plots'} test::quietthicket4::domain::Plot
{
  plotCode: String[1];
  squareMetres: Float[1];
  shedPresent: Boolean[1];
  soilNote: String[0..1];
}

Class <<test::quietthicket4::domain::AllotmentProfile.internalOnly>> test::quietthicket4::domain::Tenant
{
  membershipNumber: String[1];
  displayName: String[1];
  joinedOn: StrictDate[1];
}

Class test::quietthicket4::domain::CultivationNote
{
  noteReference: String[1];
  writtenOn: StrictDate[1];
  cultivatedFraction: Float[0..1];
  observation: String[0..1];
}

Class test::quietthicket4::domain::WaterPoint
{
  waterPointCode: String[1];
  troughCount: Integer[1];
  metered: Boolean[1];
}

Class <<test::quietthicket4::domain::AllotmentProfile.tenancyControlled, temporal.businesstemporal>> {test::quietthicket4::domain::AllotmentProfile.registerSection = 'tenancies'} test::quietthicket4::domain::Tenancy
{
  tenancyReference: String[1];
  peppercornAgreement: Boolean[1];
  cultivationClause: String[0..1];
}

