###Pure
import meta::pure::profiles::*;
import test::gildedthistle4::domain::*;

Class {doc.doc = 'A glasshouse bay that propagation work is carried out in; bays are physical structures and carry no temporal semantics.'} test::gildedthistle4::domain::GlasshouseBay
{
  {doc.doc = 'Bay code painted on the end wall.'} bayCode: String[1];
  {doc.doc = 'Label of every bench installed in the bay.'} benchLabels: String[*];
  {doc.doc = 'Usable bench area in square metres.'} benchAreaSqm: Float[0..1];
  {doc.doc = 'Date the bay glazing was last replaced.'} glazingReplacedOn: StrictDate[0..1];
}

Class <<typemodifiers.abstract>> {doc.doc = 'Abstract root of every propagation raised by the nursery; subtypes inherit the registry code, the technique and the bay reference.'} test::gildedthistle4::domain::Propagation
{
  {doc.doc = 'Registry code carried by every propagation.'} propagationCode: String[1];
  {doc.doc = 'Technique the propagation was raised by.'} method: PropagationMethod[0..1];
  {doc.doc = 'Grower who set the propagation up.'} raisedBy: String[0..1];
  {doc.doc = 'Bay the propagation is standing in, absent while it is still in the potting shed.'} bay: GlasshouseBay[0..1];
}

Class {doc.doc = 'A tray of cuttings struck together and handled as one unit.'} test::gildedthistle4::domain::CuttingPropagation extends Propagation
{
  {doc.doc = 'Number of cuttings inserted into the tray.'} cuttingCount: Integer[1];
  {doc.doc = 'Growing medium the cuttings were struck into.'} medium: GrowingMediumBlend[0..1];
  {doc.doc = 'Date the cuttings were inserted.'} struckOn: StrictDate[0..1];
}

Class <<PropagationMeta.trialOnly>> {doc.doc = 'A cutting tray held on a mist bench; a second-level subtype whose registry code and technique come from the root two levels above it.', PropagationMeta.protocolRevision = 'third edition'} test::gildedthistle4::domain::MistBenchCuttingPropagation extends CuttingPropagation
{
  {doc.doc = 'Bottom-heat set point in degrees Celsius.'} bottomHeatCelsius: Float[0..1];
  {doc.doc = 'Interval between mist bursts in minutes.'} mistIntervalMinutes: Integer[0..1];
  {doc.doc = 'Whether rooting hormone was applied to the cut ends.'} hormoneApplied: Boolean[0..1];
}

Class <<PropagationMeta.retired>> {doc.doc = 'A tray of seed sown into cells and grown on before pricking out.', PropagationMeta.steward = 'nursery propagation registry'} test::gildedthistle4::domain::SeedlingPropagation extends Propagation
{
  {doc.doc = 'Number of cells in the sown tray.'} cellCount: Integer[1];
  {doc.doc = 'Share of sown cells that emerged, as a percentage.'} emergencePercent: Float[0..1];
  {doc.doc = 'Vigour grade assigned at the last inspection.'} vigour: VigourGrade[0..1];
}

Class <<temporal.processingtemporal, ObservationMeta.manuallyFiled>> {doc.doc = 'A written inspection observation about a propagation, milestoned on when the nursery filed it rather than on when the growth it describes happened.', ObservationMeta.confidence = 'grower judgement'} test::gildedthistle4::domain::PropagationObservation
{
  {doc.doc = 'Free text observation written by the inspecting grower.'} observationText: String[0..1];
  {doc.doc = 'Count of cells or cuttings judged to have rooted or emerged.'} establishedCount: Integer[0..1];
  {doc.doc = 'Grower who filed the observation.'} filedBy: String[0..1];
  {doc.doc = 'Vigour grade recorded on the observation.'} vigour: VigourGrade[0..1];
}

Class <<temporal.processingtemporal>> {doc.doc = 'A delivered growing-medium consignment certificate, known to the nursery from the moment the paperwork is filed.'} test::gildedthistle4::domain::GrowingMediumCertificate
{
  {doc.doc = 'Blend named on the consignment paperwork.'} blend: GrowingMediumBlend[1];
  {doc.doc = 'Acidity reading taken on arrival.'} phReading: Float[0..1];
  {doc.doc = 'Bags accepted into the medium bay.'} bagsAccepted: Integer[0..1];
}
