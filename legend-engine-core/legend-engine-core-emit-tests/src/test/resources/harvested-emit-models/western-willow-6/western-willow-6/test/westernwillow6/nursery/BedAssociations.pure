###Pure
Association <<test::westernwillow6::nursery::NurseryStewardship.curated>> {meta::pure::profiles::doc.doc = 'Connects a versioned nursery bed to the versioned cutting batches rooted in it.'} test::westernwillow6::nursery::WithyBed_CuttingBatch
{
  {meta::pure::profiles::doc.doc = 'Bed containing the cutting batches.'} bed: test::westernwillow6::nursery::WithyBed[1];
  {meta::pure::profiles::doc.doc = 'Batches rooted in the bed.'} batches: test::westernwillow6::nursery::CuttingBatch[*];
}

Association <<test::westernwillow6::nursery::NurseryStewardship.provisional>> {meta::pure::profiles::doc.doc = 'Connects a cutting batch to the processing-temporal crew that tends it.'} test::westernwillow6::nursery::CuttingBatch_WeaverCrew
{
  {meta::pure::profiles::doc.doc = 'Batch tended by the crew.'} batch: test::westernwillow6::nursery::CuttingBatch[1];
  {meta::pure::profiles::doc.doc = 'Crew tending the batch.'} crew: test::westernwillow6::nursery::WeaverCrew[0..1];
}

Association <<test::westernwillow6::nursery::NurseryStewardship.curated>> {meta::pure::profiles::doc.doc = 'Links a versioned bed to the ordinary harvest season in which it is gathered.'} test::westernwillow6::nursery::WithyBed_HarvestSeason
{
  {meta::pure::profiles::doc.doc = 'Bed gathered during the season.'} bed: test::westernwillow6::nursery::WithyBed[1];
  {meta::pure::profiles::doc.doc = 'Season for the harvest.'} season: test::westernwillow6::nursery::HarvestSeason[1];
}
