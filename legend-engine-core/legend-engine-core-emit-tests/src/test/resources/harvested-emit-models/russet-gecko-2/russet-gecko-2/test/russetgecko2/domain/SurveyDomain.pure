Association {doc.doc = 'Mangrove observations rolled up to their flattened stratum node.'} demo::russetgecko2::domain::Mangrove_Node
{
  {doc.doc = 'The mangrove observations rolled into the node.'} mangroveObservations: MangroveObservation[1..*];
  {doc.doc = 'The nodes the observations roll into.'} nodes: StratumNode[*];
}

