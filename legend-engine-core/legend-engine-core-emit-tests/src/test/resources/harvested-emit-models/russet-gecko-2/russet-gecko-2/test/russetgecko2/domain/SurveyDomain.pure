  {doc.doc = 'The roll-up row answering the observations.'} analytics: StratumAnalytics[1];
}

Association {doc.doc = 'The tasks a roster standing is answerable for, both ends open so a standing can cover several tasks and a task be covered by several standings.'} demo::russetgecko2::domain::Role_Function
{
  {doc.doc = 'The standings covering the task.'} roles: ObserverRole[*];
  {doc.doc = 'The tasks the standing covers.'} functions: FunctionalRole[*];
}

Association demo::russetgecko2::domain::Observer_Role
{
  observers: FieldObserver[*];
  heldRoles: ObserverRole[*];
}

Association {doc.doc = 'The colony censuses walked out of a tract: the traversal that bridges the two-instant colony extent and the one-instant tract extent.'} demo::russetgecko2::domain::Tract_Census
{
  {doc.doc = 'The tract the colony was counted on.'} tract: ReserveTract[0..1];
  {doc.doc = 'The censuses counted on the tract.'} censuses: ColonyCensus[*];
}

Association {doc.doc = 'The enclosure edges bounding a tract, and the gate markers signed on them.'} demo::russetgecko2::domain::Tract_Barrier
{
  {doc.doc = 'The tracts the edge bounds.'} boundedTracts: ReserveTract[*];
  {doc.doc = 'The edges bounding the tract.'} edges: EdgeBarrier[*];
}

Association {doc.doc = 'The signed crossing points on an enclosure edge.'} demo::russetgecko2::domain::Barrier_Gate
{
  {doc.doc = 'The edge the crossing is cut through.'} edge: EdgeBarrier[0..1];
  {doc.doc = 'The crossings cut through the edge.'} gates: GateMarker[*];
}

Association {doc.doc = 'The reaches a permit carries over the strata an observer may work in.'} demo::russetgecko2::domain::Observer_Reach
{
  {doc.doc = 'The observers holding the reach.'} holders: FieldObserver[*];
  {doc.doc = 'The reaches the observer holds.'} reaches: PermitReach[*];
}
