{
  {doc.doc = 'The grassland observations the roll-up answers.'} grasslandObservations: GrasslandObservation[1..*];
  {doc.doc = 'The roll-up row answering the observations.'} analytics: StratumAnalytics[1];
}

Association {doc.doc = 'Cave-mouth observations rolled up to their flattened stratum node.'} demo::russetgecko2::domain::CaveMouth_Node
{
  {doc.doc = 'The cave-mouth observations rolled into the node.'} caveMouthObservations: CaveMouthObservation[1..*];
  {doc.doc = 'The nodes the observations roll into.'} nodes: StratumNode[*];
}

