Class {meta::pure::profiles::doc.doc = 'A single field observation of a tagged animal recorded by a wildlife survey.'} test::tealotter::domain::TaggedSighting
[
  observationWindowValid: or(or($this.taggedOn->isEmpty(), $this.observedOn->isEmpty()), $this.taggedOn->toOne() <= today())
]
{
  tagCode: String[1];
  habitat: test::tealotter::domain::Habitat[1];
  observerName: String[1];
  taggedOn: StrictDate[0..1];
  observedOn: StrictDate[0..1];
  individualsCounted: Integer[1];
}
