import test::meadowquokka3::domain::*;

Association {meta::pure::profiles::doc.doc = 'Relates a seed lot to the germination trials run on it, navigable from either end and valid for every lot subtype.'} test::meadowquokka3::domain::SeedLot_GerminationTrial
{
  lot: SeedLot[1];
  trials: GerminationTrial[*];
}

Association {meta::pure::profiles::doc.doc = 'Relates a nursery bed to the seed lots sown into it, navigable from either end and valid for every lot subtype.'} test::meadowquokka3::domain::NurseryBed_SeedLot
{
  sownInto: NurseryBed[0..1];
  sownLots: SeedLot[*];
}
