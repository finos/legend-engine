import test::meadowquokka3::domain::*;

Class {meta::pure::profiles::doc.doc = 'The accepted name and placement of a plant, referenced by every seed lot of that plant.'} test::meadowquokka3::domain::TaxonRecord
{
  taxonCode: String[1];
  scientificName: String[1];
  familyName: String[1];
  nativeRange: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A member of nursery staff who collects seed, sows it or reads a trial.'} test::meadowquokka3::domain::Propagator
{
  staffCode: String[1];
  displayName: String[1];
  basedAt: PropagationSite[1];
  qualifiedSince: Integer[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A run of a stated germination treatment on one seed lot, read on a schedule.'} test::meadowquokka3::domain::GerminationTrial
{
  trialCode: String[1];
  startedOn: StrictDate[1];
  sownSeeds: Integer[1];
  pretreatment: String[1];
  incubationTemperature: Float[1];
  supervisedBy: Propagator[1];
}

Class {meta::pure::profiles::doc.doc = 'One dated reading taken during a germination trial.'} test::meadowquokka3::domain::TrialObservation
{
  observationCode: String[1];
  trial: GerminationTrial[1];
  readOn: StrictDate[1];
  germinatedSeeds: Integer[1];
  mouldedSeeds: Integer[0..1];
  readBy: Propagator[0..1];
}
