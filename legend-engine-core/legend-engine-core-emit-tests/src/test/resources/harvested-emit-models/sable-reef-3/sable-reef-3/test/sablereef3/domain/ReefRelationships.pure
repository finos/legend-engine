###Pure
Association {meta::pure::profiles::doc.doc = 'Runs of a reef pipeline against a deployment. The same link is also stored on the run as datasetDeploymentRef, so navigation and stored reference can disagree.'} test::sablereef3::domain::Run_Deployment
{
  runs: test::sablereef3::domain::SurveyPipelineRun[*];
  deployment: test::sablereef3::domain::DatasetDeployment[0..1];
}

