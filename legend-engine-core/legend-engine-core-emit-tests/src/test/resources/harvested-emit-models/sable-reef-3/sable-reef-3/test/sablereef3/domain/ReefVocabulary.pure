###Pure
Enum {meta::pure::profiles::doc.doc = 'Operation a reef survey pipeline run performed over a monitored dataset.'} test::sablereef3::domain::SurveyOperation
{
  INGEST,
  REPLAY,
  BACKFILL,
  RETIRE
}

Enum {meta::pure::profiles::doc.doc = 'Lifecycle state of a single pipeline operation.'} test::sablereef3::domain::OperationStatus
{
  PENDING,
  RUNNING,
  SUCCEEDED,
  FAILED,
  CANCELLED
}

Enum {meta::pure::profiles::doc.doc = 'Whether a deployed reef dataset is currently being fed.'} test::sablereef3::domain::ActivityStatus
{
  IDLE,
  ACTIVE,
  DRAINING,
  RETIRED
}

Enum {meta::pure::profiles::doc.doc = 'Environment a reef dataset deployment targets.'} test::sablereef3::domain::DeploymentEnvironment
{
  DEV,
  QA,
  PROD,
  PROD_PARALLEL
}

Enum {meta::pure::profiles::doc.doc = 'General exception vocabulary shared by every operational record.'} test::sablereef3::domain::ExceptionCode
{
  NONE,
  SCHEMA_DRIFT,
  LATE_ARRIVAL,
  SENSOR_OFFLINE,
  DUPLICATE_BATCH
}

Enum {meta::pure::profiles::doc.doc = 'Deployment-specific exception vocabulary, overlapping the general one on NONE.'} test::sablereef3::domain::DeploymentExceptionCode
{
  NONE,
  MANIFEST_REJECTED,
  LOCATION_LOCKED,
  SCHEME_UNSUPPORTED
}

Enum {meta::pure::profiles::doc.doc = 'Severity scale paired with either exception vocabulary.'} test::sablereef3::domain::ExceptionSeverity
{
  INFO,
  WARNING,
  SEVERE,
  FATAL
}

Enum {meta::pure::profiles::doc.doc = 'Storage technology discriminator used where a subtype is not required.'} test::sablereef3::domain::StorageTechnology
{
  OBJECT_STORE,
  COLUMNAR,
  ROW_STORE
}

Enum {meta::pure::profiles::doc.doc = 'Serialization format a reef observation feed is published in.'} test::sablereef3::domain::SerializationFormat
{
  CSV,
  TSV,
  PARQUET,
  AVRO,
  JSON
}

Enum {meta::pure::profiles::doc.doc = 'Kind of edge recorded between two reef dataset deployments.'} test::sablereef3::domain::DependencyKind
{
  FEEDS,
  DERIVES,
  VALIDATES
}
