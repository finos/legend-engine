{
}

Class <<ReefPlatform.markerVariant>> {meta::pure::profiles::doc.doc = 'Marker-only strategy: the reef feed is public and no credential is presented.', ReefPlatform.copiedFrom = 'reef-anonymous-strategy'} test::sablereef3::domain::AnonymousStrategy extends test::sablereef3::domain::AuthenticationStrategy
{
}

Class <<ReefPlatform.markerVariant>> {meta::pure::profiles::doc.doc = 'Marker-only strategy: the surveying user identity is delegated through the platform.', ReefPlatform.copiedFrom = 'reef-delegated-identity-strategy'} test::sablereef3::domain::DelegatedIdentityStrategy extends test::sablereef3::domain::AuthenticationStrategy
{
}

