}

Class <<meta::pure::profiles::typemodifiers.abstract, ReefPlatform.copiedSpecification>> {meta::pure::profiles::doc.doc = 'Object-store connections. Empty intermediate level between the base and the per-strategy leaves.', ReefPlatform.copiedFrom = 'reef-object-store-connection'} test::sablereef3::domain::ObjectStoreConnection extends test::sablereef3::domain::ConnectionSpecification
{
}

Class {meta::pure::profiles::doc.doc = 'An object-store connection that names the strategy it authenticates with.'} test::sablereef3::domain::ObjectStoreTokenConnection extends test::sablereef3::domain::ObjectStoreConnection
