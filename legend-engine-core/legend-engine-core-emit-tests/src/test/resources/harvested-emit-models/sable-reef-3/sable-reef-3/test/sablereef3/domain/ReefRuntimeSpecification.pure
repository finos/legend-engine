  tokenLifetimeMinutes: Integer[1];
}

Class <<ReefPlatform.markerVariant>> {meta::pure::profiles::doc.doc = 'Marker-only connection: the caller identity is delegated by the platform, so nothing is configured here.', ReefPlatform.copiedFrom = 'reef-object-store-delegated-connection'} test::sablereef3::domain::ObjectStoreDelegatedConnection extends test::sablereef3::domain::ObjectStoreConnection
{
}

Class <<meta::pure::profiles::typemodifiers.abstract, ReefPlatform.copiedSpecification>> {meta::pure::profiles::doc.doc = 'Columnar-warehouse connections. Empty intermediate level.', ReefPlatform.copiedFrom = 'reef-columnar-connection'} test::sablereef3::domain::ColumnarConnection extends test::sablereef3::domain::ConnectionSpecification
{
}

Class <<ReefPlatform.markerVariant>> {meta::pure::profiles::doc.doc = 'Marker-only connection: credentials are brokered, so the connection carries none.', ReefPlatform.copiedFrom = 'reef-columnar-brokered-connection'} test::sablereef3::domain::ColumnarBrokeredConnection extends test::sablereef3::domain::ColumnarConnection
{
}

Class <<ReefPlatform.markerVariant>> {meta::pure::profiles::doc.doc = 'Marker-only connection: a key pair registered out of band with the warehouse.', ReefPlatform.copiedFrom = 'reef-columnar-key-pair-connection'} test::sablereef3::domain::ColumnarKeyPairConnection extends test::sablereef3::domain::ColumnarConnection
{
}

