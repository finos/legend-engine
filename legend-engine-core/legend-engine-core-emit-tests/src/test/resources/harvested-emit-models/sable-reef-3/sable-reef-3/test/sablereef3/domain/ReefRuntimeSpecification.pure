###Pure
import test::sablereef3::domain::*;
import test::sablereef3::profile::*;

Class <<meta::pure::profiles::typemodifiers.abstract>> {meta::pure::profiles::doc.doc = 'Root of the reef runtime layer: a store a reef pipeline reads from or writes to.'} test::sablereef3::domain::StoreSpecification
{
  storeName: String[1];
}

Class <<meta::pure::profiles::typemodifiers.abstract, ReefPlatform.copiedSpecification>> {meta::pure::profiles::doc.doc = 'A store backed by exactly one physical system. Empty intermediate level.', ReefPlatform.copiedFrom = 'reef-simple-store-specification'} test::sablereef3::domain::SimpleStoreSpecification extends test::sablereef3::domain::StoreSpecification
{
}

Class {meta::pure::profiles::doc.doc = 'Reef observation files held in an object store under a bucket prefix.'} test::sablereef3::domain::ObjectStoreSpecification extends test::sablereef3::domain::SimpleStoreSpecification
{
  bucketPrefix: String[1];
  region: String[0..1];
}

Class <<ReefPlatform.markerVariant>> {meta::pure::profiles::doc.doc = 'Marker-only store: a columnar warehouse resolved by the platform from the store name alone.', ReefPlatform.copiedFrom = 'reef-columnar-store-specification'} test::sablereef3::domain::ColumnarStoreSpecification extends test::sablereef3::domain::SimpleStoreSpecification
{
}

Class <<ReefPlatform.markerVariant>> {meta::pure::profiles::doc.doc = 'Marker-only store: a row-oriented operational database, distinguished from its sibling only by type.', ReefPlatform.copiedFrom = 'reef-row-store-specification'} test::sablereef3::domain::RowStoreSpecification extends test::sablereef3::domain::SimpleStoreSpecification
{
}

Class {meta::pure::profiles::doc.doc = 'A store whose specification holds other store specifications, so the hierarchy is recursive: a composite may nest simple stores and further composites.'} test::sablereef3::domain::CompositeStoreSpecification extends test::sablereef3::domain::StoreSpecification
{
  members: test::sablereef3::domain::StoreSpecification[*];
  primaryMember: test::sablereef3::domain::StoreSpecification[0..1];
}

Class <<meta::pure::profiles::typemodifiers.abstract>> {meta::pure::profiles::doc.doc = 'How a reef pipeline reaches a store. Splits by technology and then again by authentication strategy.'} test::sablereef3::domain::ConnectionSpecification
{
  connectionName: String[1];
