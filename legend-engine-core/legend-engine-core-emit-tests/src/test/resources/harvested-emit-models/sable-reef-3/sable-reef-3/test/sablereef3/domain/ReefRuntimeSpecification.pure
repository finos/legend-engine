{
}

Class <<ReefPlatform.markerVariant>> {meta::pure::profiles::doc.doc = 'Marker-only strategy: the broker is the survey vault.', ReefPlatform.copiedFrom = 'reef-vault-brokered-strategy'} test::sablereef3::domain::VaultBrokeredStrategy extends test::sablereef3::domain::BrokeredStrategy
{
}

Class <<ReefPlatform.markerVariant>> {meta::pure::profiles::doc.doc = 'Marker-only strategy: the broker is the reef monitoring platform itself.', ReefPlatform.copiedFrom = 'reef-platform-brokered-strategy'} test::sablereef3::domain::PlatformBrokeredStrategy extends test::sablereef3::domain::BrokeredStrategy
{
}

Class {meta::pure::profiles::doc.doc = 'A key-pair strategy, the one strategy in the tree that carries a credential reference.'} test::sablereef3::domain::KeyPairStrategy extends test::sablereef3::domain::AuthenticationStrategy
{
