###Pure
import meta::pure::profiles::*;
import test::nobleglacier3::domain::*;
import test::nobleglacier3::profile::*;

Class <<temporal.businesstemporal, GlacierProfile.logged>> {GlacierProfile.surveyProgramme = 'ice-core-logging', GlacierProfile.custodian = 'cold-store-desk', doc.doc = 'An ice-core segment as the cold store held it in business time, so a regraded segment supersedes its earlier record while the period it was graded for stays put.'} test::nobleglacier3::domain::IceCoreSegment
{
  segmentCode: String[1];
  boreholeCode: String[1];
  topDepthMetres: Float[1];
  baseDepthMetres: Float[1];
  segmentCondition: CoreCondition[1];
  meltBand: MeltBand[0..1];
  sleeveNotes: String[0..1];
}

Class <<GlacierProfile.recalibrated>> {GlacierProfile.surveyProgramme = 'ice-core-logging', GlacierProfile.custodian = 'field-camp-desk', doc.doc = 'A drilling campaign at one borehole, holding the segments it retrieved and the grading defaults it worked to.'} test::nobleglacier3::domain::DrillCampaign
{
  campaignCode: String[1];
  boreholeCode: String[1];
  seasonYear: Integer[1];
  defaultCondition: CoreCondition[1];
  observedMeltBands: MeltBand[*];
  campNotes: String[0..1];
}
