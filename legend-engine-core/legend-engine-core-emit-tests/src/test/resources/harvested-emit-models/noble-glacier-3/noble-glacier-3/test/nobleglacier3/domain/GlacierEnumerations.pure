###Pure
import meta::pure::profiles::*;

Enum {doc.doc = 'Condition of a retrieved ice-core segment as graded at the cold store.'} test::nobleglacier3::domain::CoreCondition
{
  {doc.doc = 'Segment intact along its full length.'} INTACT,
  {doc.doc = 'Segment fractured but stratigraphy still readable.'} FRACTURED,
  {doc.doc = 'Segment partly melted at the sleeve.'} SLEEVE_MELT,
  {doc.doc = 'Segment logged but not yet graded.'} UNGRADED
}

Enum {doc.doc = 'Melt-layer band assigned to a segment during logging.'} test::nobleglacier3::domain::MeltBand
{
  NONE,
  THIN,
  BANDED,
  PERVASIVE
}
