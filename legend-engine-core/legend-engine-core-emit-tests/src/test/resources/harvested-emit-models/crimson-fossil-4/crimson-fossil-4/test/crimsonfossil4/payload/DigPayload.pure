###Pure
import test::crimsonfossil4::domain::*;
import test::crimsonfossil4::payload::*;
import test::crimsonfossil4::profile::*;

Class test::crimsonfossil4::payload::SpecimenPayload
{
  catalogCode: String[1];
  recordedOn: StrictDate[1];
  record: SpecimenPayloadRecord[1];
}

Class test::crimsonfossil4::payload::SpecimenPayloadRecord
{
  preservationCode: String[1];
  matrixCode: String[0..1];
  gradeCode: String[0..1];
  fragmentCount: Integer[0..1];
  plateCount: Integer[0..1];
  preparatorCode: String[1];
}

Class <<DigVocabulary.publishedSurface>> test::crimsonfossil4::payload::SpecimenDigest
{
  {DigVocabulary.displayName = 'Catalog Code', DigVocabulary.targetName = 'catalog_code'} catalogCode: String[1];
  {DigVocabulary.displayName = 'Density Band'} densityBand: String[1];
  {DigVocabulary.displayName = 'Preparator Label'} preparatorLabel: String[1];
  windowState: String[1];
  preservation: PreservationMode[1];
  matrix: MatrixType[1];
  grade: SpecimenGrade[1];
}
