###Pure
import test::cobaltharbor::domain::*;

Class test::cobaltharbor::domain::FieldRecord
{
  recordCode: String[1];
  collectedOn: StrictDate[1];
  conditionCode: String[1];
}

Class test::cobaltharbor::domain::SpecimenFieldRecord extends FieldRecord
{
  specimenName: String[1];
  cabinetCode: String[1];
  heightCm: Float[1];
  labelNotes: String[*];
}

Class test::cobaltharbor::domain::CuratedSpecimen
{
  specimenCode: String[1];
  displayName: String[1];
  cabinetCode: String[1];
  conditionBand: String[1];
  labelSummary: String[1];
  freshnessBand: String[1];
  heightCm: Float[1];
}
