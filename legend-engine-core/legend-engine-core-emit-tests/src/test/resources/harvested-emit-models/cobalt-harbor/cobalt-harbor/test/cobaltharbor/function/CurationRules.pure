###Pure
import meta::pure::functions::date::*;
import test::cobaltharbor::function::*;

function test::cobaltharbor::function::labelTag(note: String[1], kind: String[1], allowed: String[*]): String[1]
{
  if($allowed->contains($note->toUpper()->trim()), |$kind + ':' + $note->toUpper()->trim(), |$kind + ':OTHER')
}

function test::cobaltharbor::function::conditionBand(conditionCode: String[1], cabinetCode: String[1]): String[1]
{
  if(($conditionCode->toUpper() == 'FRAGILE') && ($cabinetCode->trim()->toUpper() == 'CAB-DARK'),
    |'SEALED-CASE',
    |$conditionCode->toUpper()->trim())
}

function test::cobaltharbor::function::labelSummary(notes: String[*]): String[1]
{
  if($notes->isNotEmpty(),
    |$notes->map(n|labelTag($n, 'LABEL', ['DRAFT', 'FINAL']))->joinStrings('; '),
    |'NO-LABEL')
}

function test::cobaltharbor::function::freshnessBand(collectedOn: StrictDate[1], recentLabel: String[1]): String[1]
{
  if(dateDiff($collectedOn, %2026-06-30, DurationUnit.DAYS) <= 120, |$recentLabel, |'ARCHIVE-INTAKE')
}
