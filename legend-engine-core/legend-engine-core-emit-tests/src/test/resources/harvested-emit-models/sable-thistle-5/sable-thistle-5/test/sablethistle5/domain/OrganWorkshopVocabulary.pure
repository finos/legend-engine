###Pure
import meta::pure::profiles::*;

Enum {doc.doc = 'The alloy or timber a pipe or chest part is made from.'} test::sablethistle5::domain::PartMaterial
{
  {doc.doc = 'Pipe metal with a high tin content.'} TIN_ALLOY,
  {doc.doc = 'Mottled pipe metal with a mid tin content.'} SPOTTED_METAL,
  {doc.doc = 'Quarter-sawn hardwood.'} OAK,
  {doc.doc = 'Clear softwood.'} PINE
}

Enum {doc.doc = 'The tonal family a pipe speaks in.'} test::sablethistle5::domain::StopFamily
{
  {doc.doc = 'Open cylindrical pipes forming the backbone of the chorus.'} PRINCIPAL,
  {doc.doc = 'Wide-scaled or stopped pipes with a soft tone.'} FLUTE,
  {doc.doc = 'Pipes sounded by a vibrating tongue.'} REED,
  {doc.doc = 'Narrow-scaled pipes with a keen tone.'} STRING
}

Enum {doc.doc = 'How a key press reaches the pallet under the pipes.'} test::sablethistle5::domain::KeyAction
{
  {doc.doc = 'Direct mechanical linkage.'} TRACKER,
  {doc.doc = 'Electromagnetic pallet magnets.'} ELECTRIC,
  {doc.doc = 'Air-driven tubular linkage.'} PNEUMATIC
}

Enum {doc.doc = 'The step a restoration has reached on the workshop floor.'} test::sablethistle5::domain::WorkStage
{
  {doc.doc = 'Condition recorded before any work.'} SURVEYED,
  {doc.doc = 'Taken apart and labelled.'} DISMANTLED,
  {doc.doc = 'Pipes regulated for tone and loudness.'} VOICED,
  {doc.doc = 'Returned and tuned in place.'} REINSTALLED
}
