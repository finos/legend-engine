###Pure
import test::lunarcanyon2::profile::*;

Enum <<CavernStewardship.protectedZone>> {CavernStewardship.steward = 'cavern-registrar'} test::lunarcanyon2::domain::PassageGrade
{
  WALKING,
  STOOPING,
  CRAWLING,
  SQUEEZE,
  CHIMNEY,
  TRAVERSE,
  SUMP,
  BOULDER_CHOKE,
  UNGRADED
}

Enum <<SurveyQuality.verified>> {SurveyQuality.confidence = 'high'} test::lunarcanyon2::domain::MoistureRegime
{
  DRY,
  DAMP,
  DRIPPING,
  FLOWING,
  FLOODED
}

Enum <<SurveyQuality.unverified>> {SurveyQuality.method = 'tape-and-compass'} test::lunarcanyon2::domain::SurveyMethod
{
  TAPE_COMPASS,
  LASER_SCAN,
  PHOTOGRAMMETRY,
  SKETCH_ONLY
}
