###Pure
import meta::pure::profiles::*;

Enum {doc.doc = 'Closed set of ways an otter raft came to occupy the surveyed reach.'} test::tealotter2::domain::RaftOrigin
{
  COASTAL_RAFT,
  RIVERINE_RAFT,
  TRANSLOCATED_RAFT
}

Enum {doc.doc = 'Closed set of outcomes a sighting record can be given once the survey coordinator has screened it.'} test::tealotter2::domain::ScreeningOutcome
{
  ACCEPTED,
  DEFERRED,
  REJECTED
}
