###Pure
import demo::opalmeadow3::profile::*;
import meta::pure::profiles::*;

Enum {doc.doc = 'The broad habitat a restoration plot sits in.'} demo::opalmeadow3::domain::PlotHabitat
{
  HAY_MEADOW,
  CHALK_GRASSLAND,
  WET_FEN,
  ROADSIDE_VERGE,
  WOODLAND_EDGE
}

Enum {doc.doc = 'How far through its flowering cycle a recorded plant was when it was seen.'} demo::opalmeadow3::domain::BloomStage
{
  BUD,
  OPEN,
  SEEDING,
  WITHERED
}

Enum <<MeadowCuration.fieldVerified>> {doc.doc = 'How a survey visit gathered its records.', MeadowCuration.surveyLead = 'botany volunteers'} demo::opalmeadow3::domain::SurveyMethod
{
  QUADRAT_COUNT,
  TRANSECT_WALK,
  TIMED_SEARCH,
  PHOTO_PLOT
}

Enum {doc.doc = 'Local rarity band assigned to a recorded plant.'} demo::opalmeadow3::domain::RarityBand
{
  COMMON,
  LOCAL,
  SCARCE,
  RARE
}
