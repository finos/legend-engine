###Pure
import meta::pure::profiles::*;
import test::borealvineyard::domain::*;

Association {doc.doc = 'The night logs filed against an observatory site; only the log end is versioned, so a site newly added to the network legitimately has an empty log end.'} test::borealvineyard::domain::Site_SkyLog
{
  loggedSite: ObservatorySite[0..1];
  nightLogs: SkyLog[*];
}

Association {doc.doc = 'The aurora watches an observing crew raised; the watch end is versioned, so the crew end is read as at the business date the watch is resolved for.'} test::borealvineyard::domain::Watch_Crew
{
  raisedWatches: AuroraWatch[*];
  raisingCrew: ObserverCrew[0..1];
}
