###Pure
import test::verdantcavern2::domain::*;

Class {meta::pure::profiles::doc.doc = 'Flat intake shape of a cavern gauge reading as it arrives from the field logger. Every property is a mandatory to-one scalar or enumerated value and there is no supertype, constraint or derived property, so it carries no logic of its own.'} test::verdantcavern2::domain::GaugeReadingIntake
{
  readingRef: String[1];
  stationName: String[1];
  chamberCode: String[1];
  observerName: String[1];
  recordedOn: StrictDate[1];
  depthMetres: Float[1];
  flowRate: Float[1];
  sampleCount: Integer[1];
  sealedChamber: Boolean[1];
  condition: ChamberCondition[1];
  quality: ReadingQuality[1];
}
