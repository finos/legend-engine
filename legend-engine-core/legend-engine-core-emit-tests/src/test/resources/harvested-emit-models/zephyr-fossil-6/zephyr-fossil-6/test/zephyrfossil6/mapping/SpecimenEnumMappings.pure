###Mapping
Mapping test::zephyrfossil6::mapping::SpecimenEnumMappings
(
  test::zephyrfossil6::domain::SpecimenGrade: EnumerationMapping SpecimenGradeMapping
  {
    Articulated: ['G/A'],
    Associated: ['G/B'],
    Shattered: ['G/F'],
    NearComplete: ['G/C'],
    PartlyComplete: ['G/D'],
    Fragmentary: ['G/E'],
    MatrixBound: ['G/G'],
    Indeterminate: ['G/H'],
    Unassessed: ['G/Z']
  }

  test::zephyrfossil6::domain::PreparationState: EnumerationMapping SpecimenPrepMapping
  {
    AcidPrepped: ['P/ACID'],
    AirScribed: ['P/SCRIBE'],
    Consolidated: ['P/CONSOL'],
    Unprepared: ['P/NONE']
  }

  test::zephyrfossil6::domain::MatrixKind: EnumerationMapping SpecimenMatrixMapping
  {
    Shale: ['M/SHALE'],
    Mudstone: ['M/MUD'],
    Limestone: ['M/LIME'],
    Sandstone: ['M/SAND'],
    UnknownMatrix: ['M/UNKNOWN']
  }
)
