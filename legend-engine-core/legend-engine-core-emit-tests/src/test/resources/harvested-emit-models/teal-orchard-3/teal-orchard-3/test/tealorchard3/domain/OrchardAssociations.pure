###Pure
import test::tealorchard3::domain::*;

Association {meta::pure::profiles::doc.doc = 'A block holds the specimens planted in it; the specimen end is milestoned so navigation must be given a processing date.'} test::tealorchard3::domain::OrchardBlock_TreeSpecimen
{
  block: OrchardBlock[1];
  specimens: TreeSpecimen[*];
}

Association {meta::pure::profiles::doc.doc = 'A specimen carries the grafts worked onto it; both ends are processing-temporal so traversal propagates the processing context.'} test::tealorchard3::domain::TreeSpecimen_GraftRecord
{
  specimen: TreeSpecimen[0..1];
  grafts: GraftRecord[*];
}

Association {meta::pure::profiles::doc.doc = 'A specimen is assessed over the picking timeline; the assessment end is bi-temporal so navigation must be given both dates.'} test::tealorchard3::domain::TreeSpecimen_SpecimenAssessment
{
  assessedSpecimen: TreeSpecimen[0..1];
  assessments: SpecimenAssessment[*];
}

Association {meta::pure::profiles::doc.doc = 'An assessment owns its narrative notes; both ends are bi-temporal so the traversal continues without reopening the temporal context.'} test::tealorchard3::domain::SpecimenAssessment_AssessmentNote
{
  assessment: SpecimenAssessment[0..1];
  notes: AssessmentNote[*];
}
