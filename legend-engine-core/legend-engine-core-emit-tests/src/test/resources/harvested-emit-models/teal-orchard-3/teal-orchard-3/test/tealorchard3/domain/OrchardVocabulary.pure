###Pure
Enum {meta::pure::profiles::doc.doc = 'State a graft has reached on the specimen it was worked onto.'} test::tealorchard3::domain::GraftStatus
{
  Worked,
  Established,
  Failed
}

Enum {meta::pure::profiles::doc.doc = 'Vigour band of the rootstock a specimen stands on.'} test::tealorchard3::domain::RootstockVigour
{
  Dwarfing,
  SemiVigorous,
  Vigorous
}

Enum {meta::pure::profiles::doc.doc = 'Grade recorded for the fruit an assessment picked.'} test::tealorchard3::domain::HarvestGrade
{
  Dessert,
  Culinary,
  Cider,
  Unsound
}

Enum {meta::pure::profiles::doc.doc = 'Where an assessment note came from.'} test::tealorchard3::domain::NoteSource
{
  OrchardWalk,
  PackhouseCheck,
  VolunteerReport
}
