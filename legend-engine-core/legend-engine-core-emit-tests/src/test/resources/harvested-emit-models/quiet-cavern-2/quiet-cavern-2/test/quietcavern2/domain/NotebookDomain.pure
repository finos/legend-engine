###Pure
import test::quietcavern2::domain::*;
import test::quietcavern2::function::*;

Enum test::quietcavern2::domain::WeatherBand
{
  CLEAR,
  DRIZZLE,
  WINDY
}

Enum test::quietcavern2::domain::TrailCondition
{
  OPEN,
  MUDDY,
  ROCKY
}

Class test::quietcavern2::domain::SurveyEntryInput
[
  entryCodeValid
  (
    ~function: test::quietcavern2::function::entryCodeValid($this.entryCode)
    ~enforcementLevel: Error
    ~message: 'A survey entry must carry a field entry code'
  ),
  markerMinimum
  (
    ~function: greaterThan(size($this.markerCodes), 1)
    ~enforcementLevel: Error
  )
]
{
  entryCode: String[1];
  trailName: String[1];
  recorderName: String[1];
  conditionCode: String[1];
  markerCodes: String[*];
  surveyedOn: StrictDate[1];
}

Class test::quietcavern2::domain::SurveyEntryCard
{
  entryCode: String[1];
  trailName: String[1];
  recorderName: String[1];
  condition: TrailCondition[1];
  firstMarker: String[1];
  surveyedOn: StrictDate[1];
}

Class test::quietcavern2::domain::RoostLogInput
[
  logCodeValid
  (
    ~function: test::quietcavern2::function::logCodeValid($this.logCode)
    ~enforcementLevel: Error
    ~message: 'A roost log must carry a roster code'
  )
]
{
  logCode: String[1];
  roostName: String[1];
  keeperName: String[1];
  weatherCode: String[1];
  batCount: Integer[1];
  loggedOn: StrictDate[1];
}

Class test::quietcavern2::domain::RoostLogCard
{
  logCode: String[1];
  roostName: String[1];
  keeperName: String[1];
  weather: WeatherBand[1];
  batCount: Integer[1];
  loggedOn: StrictDate[1];
}

Class test::quietcavern2::domain::CanopyPassInput
{
  passCode: String[1];
  canopyName: String[1];
  rangerName: String[1];
  conditionCode: TrailCondition[1];
  heightMetres: Float[1];
  passedOn: StrictDate[1];
}

Class test::quietcavern2::domain::CanopyPassCard
{
  passCode: String[1];
  canopyName: String[1];
  rangerName: String[1];
  condition: TrailCondition[1];
  heightMetres: Float[1];
  passedOn: StrictDate[1];
}

Class test::quietcavern2::domain::SurveyRoute
{
  routeCode: String[1];
  routeName: String[1];
}

Class test::quietcavern2::domain::MarkerRecord
{
  markerCode: String[1];
  markerKind: String[1];
}

Class test::quietcavern2::domain::RoostKeeper
{
  keeperCode: String[1];
  displayName: String[1];
}

Class test::quietcavern2::domain::CanopyWard
{
  wardCode: String[1];
  wardName: String[1];
}

Class test::quietcavern2::domain::NotebookBatch
{
  batchCode: String[1];
  openedOn: StrictDate[1];
}

Class test::quietcavern2::domain::WeatherNote
{
  noteCode: String[1];
  noteText: String[1];
}

Class test::quietcavern2::domain::TrailPermit
{
  permitCode: String[1];
  holderName: String[1];
}
