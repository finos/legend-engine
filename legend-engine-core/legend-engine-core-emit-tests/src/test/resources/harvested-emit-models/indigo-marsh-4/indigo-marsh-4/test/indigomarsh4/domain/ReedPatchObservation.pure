###Pure
import test::indigomarsh4::domain::*;

Class {meta::pure::profiles::doc.doc = 'A flat observation shape: one required identifier and a tail of optional scalars over text, decimal, date, date-time and boolean, so a null-bearing observation is still a valid instance.'} test::indigomarsh4::domain::ReedPatchObservation
{
  observationCode: String[1];
  patchName: String[0..1];
  stemDensity: Decimal[0..1];
  observedOn: StrictDate[0..1];
  recordedAt: DateTime[0..1];
  waterlogged: Boolean[0..1];
  patchLabel() {if($this.patchName->isEmpty(), | 'UNNAMED PATCH', | $this.patchName->toOne()->trim()->toUpper())}: String[1];
}
