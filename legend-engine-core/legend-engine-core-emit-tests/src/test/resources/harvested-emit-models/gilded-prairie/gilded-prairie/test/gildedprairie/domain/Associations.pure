import test::gildedprairie::domain::*;

Association {meta::pure::profiles::doc.doc = 'A restoration plot is sown from many seed lots; both ends are milestoned, so a lot is attached to the plot only where the two validity windows overlap.'} test::gildedprairie::domain::RestorationPlot_SeedLot
{
  sownPlot: RestorationPlot[0..1];
  sownLots: SeedLot[*];
}

Association {meta::pure::profiles::doc.doc = 'An increase plot yields the lots harvested from it; navigation propagates the temporal context of the plot onto the lots.'} test::gildedprairie::domain::SeedIncreasePlot_SeedLot
{
  increasePlot: SeedIncreasePlot[0..1];
  increaseLots: SeedLot[*];
}

Association {meta::pure::profiles::doc.doc = 'A restoration plot accumulates the species observations recorded against it; the reverse end resolves to the single plot walked.'} test::gildedprairie::domain::RestorationPlot_SpeciesObservation
{
  observedPlot: RestorationPlot[1];
  observations: SpeciesObservation[*];
}
