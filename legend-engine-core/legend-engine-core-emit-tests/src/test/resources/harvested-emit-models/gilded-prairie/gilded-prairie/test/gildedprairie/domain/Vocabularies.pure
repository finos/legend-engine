Enum {meta::pure::profiles::doc.doc = 'Provenance of the seed used to establish or reinforce a prairie plot.'} test::gildedprairie::domain::SeedSourceKind
{
  LocalRemnant,
  RegionalIncrease,
  NurseryContract,
  VolunteerCollection
}

Enum {meta::pure::profiles::doc.doc = 'Texture class recorded for the topsoil horizon of a plot.'} test::gildedprairie::domain::SoilTexture
{
  SandyLoam,
  SiltLoam,
  ClayLoam,
  Gravelly
}

Enum {meta::pure::profiles::doc.doc = 'Prescribed-burn rotation followed on a restoration plot.'} test::gildedprairie::domain::BurnRegime
{
  Annual,
  Biennial,
  ThreeYearRotation,
  Unburned
}

Enum {meta::pure::profiles::doc.doc = 'Lifecycle state of a plot within the restoration programme.'} test::gildedprairie::domain::PlotStatus
{
  Prepared,
  Seeded,
  Establishing,
  Established,
  Retired
}
