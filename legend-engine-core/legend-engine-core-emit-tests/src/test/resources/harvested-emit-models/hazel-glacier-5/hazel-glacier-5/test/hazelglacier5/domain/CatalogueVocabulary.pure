}

Enum {meta::pure::profiles::doc.doc = 'The interval at which a catalogue item is re-examined.', test::hazelglacier5::domain::CurationGovernance.examinationCadence = 'scheduled'} test::hazelglacier5::domain::ExaminationCadence
{
  Monthly,
  Quarterly,
  Annual,
  Biennial
}
