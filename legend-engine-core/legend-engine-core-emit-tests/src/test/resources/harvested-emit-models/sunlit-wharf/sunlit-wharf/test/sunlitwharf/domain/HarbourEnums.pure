###Pure
import meta::pure::profiles::*;

Enum {doc.doc = 'The stage of the tide a shoreline survey was walked on.'} demo::sunlitwharf::domain::TideStage
{
  {doc.doc = 'Water falling away from the quay wall.'} EBB,
  {doc.doc = 'Water neither rising nor falling.'} SLACK,
  {doc.doc = 'Water rising against the quay wall.'} FLOOD
}

Enum {doc.doc = 'What the hull of a survey boat is built from.'} demo::sunlitwharf::domain::HullMaterial
{
  {doc.doc = 'Planked timber hull kept by the harbour workshop.'} TIMBER,
  {doc.doc = 'Welded steel hull.'} STEEL,
  {doc.doc = 'Moulded glassfibre hull.'} GLASSFIBRE
}

Enum {doc.doc = 'Whether a mooring space along the wharf may be taken up.'} demo::sunlitwharf::domain::MooringState
{
  {doc.doc = 'A boat is made fast alongside.'} OCCUPIED,
  {doc.doc = 'Nothing alongside and open to any boat.'} VACANT,
  {doc.doc = 'Kept clear while the wall is repaired.'} KEPT_CLEAR
}

Enum {doc.doc = 'How firmly a sighting was identified in the field.'} demo::sunlitwharf::domain::SightingConfidence
{
  {doc.doc = 'Identified in the hand or photographed.'} CONFIRMED,
  {doc.doc = 'Identified at distance by a trained observer.'} PROBABLE,
  {doc.doc = 'Logged but not identified to the recorded group.'} UNVERIFIED
}

Enum {doc.doc = 'The broad group a sighted animal belongs to.'} demo::sunlitwharf::domain::SpeciesGroup
{
  {doc.doc = 'Gulls, terns and waders working the tideline.'} SEABIRD,
  {doc.doc = 'Seals hauled out on the shingle.'} PINNIPED,
  {doc.doc = 'Porpoises and dolphins in the outer channel.'} CETACEAN,
  {doc.doc = 'Shoaling fish seen from the wharf edge.'} FISH
}
