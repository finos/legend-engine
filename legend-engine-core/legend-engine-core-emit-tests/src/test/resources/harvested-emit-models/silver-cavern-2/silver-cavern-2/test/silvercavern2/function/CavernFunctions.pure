###Pure
function test::silvercavern2::function::isLegReference(reference: String[1]): Boolean[1]
{
  ($reference->length() == 8) && $reference->toUpper()->startsWith('CV-')
}

function test::silvercavern2::function::isNamedFiler(filer: String[1]): Boolean[1]
{
  $filer->trim()->length() > 2
}

function test::silvercavern2::function::isChamberLabel(label: String[1]): Boolean[1]
{
  ($label->trim()->length() >= 3) && !$label->trim()->toUpper()->startsWith('X')
}

function test::silvercavern2::function::isSurveyGradeTag(tag: String[1]): Boolean[1]
{
  $tag->toUpper()->in(['GRADE-1', 'GRADE-3', 'GRADE-5', 'GRADE-6'])
}
