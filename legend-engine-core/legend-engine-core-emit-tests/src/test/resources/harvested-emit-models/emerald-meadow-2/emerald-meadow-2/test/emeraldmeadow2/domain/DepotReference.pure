import test::emeraldmeadow2::domain::*;

Enum {meta::pure::profiles::doc.doc = 'Closed set of ways a tram draws traction power.'} test::emeraldmeadow2::domain::TractionMode
{
  OVERHEAD_WIRE,
  BATTERY,
  DUAL_MODE
}

Enum {meta::pure::profiles::doc.doc = 'Closed set of operating states a depot item can be held in.'} test::emeraldmeadow2::domain::ServiceState
{
  IN_SERVICE,
  STABLED,
  IN_WORKSHOP,
  WITHDRAWN
}

Enum {meta::pure::profiles::doc.doc = 'Closed set of outcomes an inspection entry can record.'} test::emeraldmeadow2::domain::InspectionOutcome
{
  PASS,
  ADVISORY,
  DEFECT
}

Enum {meta::pure::profiles::doc.doc = 'Closed set of severity bands a finding is graded into.'} test::emeraldmeadow2::domain::SeverityBand
{
  MINOR,
  MODERATE,
  SEVERE
}

Class {meta::pure::profiles::doc.doc = 'A tram depot, as the item register names it.'} test::emeraldmeadow2::domain::DepotRef
{
  depotCode: String[1];
  depotName: String[1];
  stablingRoads: Integer[1];
}

Class {meta::pure::profiles::doc.doc = 'A maintenance team a task can be assigned to.'} test::emeraldmeadow2::domain::TeamRef
{
  teamCode: String[1];
  teamName: String[1];
  shiftPattern: String[1];
}
