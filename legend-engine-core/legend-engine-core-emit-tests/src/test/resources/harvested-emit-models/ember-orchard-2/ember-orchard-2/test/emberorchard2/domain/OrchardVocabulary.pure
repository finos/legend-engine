###Pure
Enum {meta::pure::profiles::doc.doc = 'Closed canopy-vigour vocabulary a grafting inspector picks from. It is carried as a typed property rather than as a stored string, so a reader receives a constant of this vocabulary and never an unconstrained value.'} test::emberorchard2::domain::CanopyVigour
{
  STRONG,
  STEADY,
  SLOW,
  DORMANT
}

Enum {meta::pure::profiles::doc.doc = 'How a scion was joined to its rootstock, recorded once at grafting and corrected in place when a later inspection finds the union was described wrongly.'} test::emberorchard2::domain::GraftUnion
{
  WHIP_AND_TONGUE,
  CLEFT,
  BUD_SHIELD,
  BARK_INLAY
}
