###Pure
Enum test::mapleestuary::domain::SapGrade
{
  GOLDEN,
  AMBER,
  DARK,
  UNGRADED
}

Enum test::mapleestuary::domain::TapCondition
{
  OPEN,
  PARTIAL,
  BLOCKED
}

Enum test::mapleestuary::domain::LineKind
{
  GRAVITY,
  VACUUM,
  BUCKET
}

Class {meta::pure::profiles::doc.doc = 'The refined view of one sap-run submission from a maple stand.'} test::mapleestuary::domain::RunSummary
{
  runRef: String[1];
  tapperLabel: String[1];
  yieldBand: String[1];
  standHint: String[1];
  dayOfMonth: Integer[1];
  grade: test::mapleestuary::domain::SapGrade[1];
  condition: test::mapleestuary::domain::TapCondition[1];
  dominantLine: test::mapleestuary::domain::LineKind[1];
  stand: test::mapleestuary::domain::StandView[0..1];
  lines: test::mapleestuary::domain::LineDraw[*];
}

Class test::mapleestuary::domain::StandView
{
  standCode: String[1];
  districtLabel: String[0..1];
}

Class test::mapleestuary::domain::LineDraw
{
  lineKind: test::mapleestuary::domain::LineKind[1];
  volumeL: Float[1];
}
