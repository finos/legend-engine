###Pure
import test::fabledthicket2::domain::*;

Class <<ThicketMeta.curated>> {ThicketMeta.steward = 'thicket-archive'} test::fabledthicket2::domain::TrailStop
{
  stopKey: String[1];
  stopLabel: String[1];
}

Class <<TaleMeta.retold>> {ThicketMeta.revision = '4'} test::fabledthicket2::domain::TaleStop extends TrailStop
{
  tellerLabel: String[1];
  audienceBand: String[0..1];
  keeperNote: String[1];
  hopSpread: String[1];
  hopTally: Integer[1];
  retold: Boolean[1];
  lantern: LanternStop[0..1];
  hops: TrailHop[*];
}

Class <<TrailMeta.waymarked>> {TrailMeta.district = 'north thicket'} test::fabledthicket2::domain::LanternStop extends TrailStop
{
  districtLabel: String[1];
}

Class <<ThicketMeta.provisional>> {TaleMeta.origin = 'trail feed'} test::fabledthicket2::domain::TrailHop
{
  hopRef: String[1];
  paces: Integer[1];
}
