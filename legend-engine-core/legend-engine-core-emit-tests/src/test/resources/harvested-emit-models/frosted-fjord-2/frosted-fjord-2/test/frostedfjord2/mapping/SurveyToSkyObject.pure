###Mapping
Mapping test::frostedfjord2::mapping::SurveyToSkyObject
(
  *test::frostedfjord2::domain::SkyObject: Pure
  {
    ~src test::frostedfjord2::source::SurveyRow
    objectId: $src.rowRef,
    displayLabel: 'UNCHARTED FIELD'
  }

  testSuites:
  [
    surveyPassthroughSuite:
    {
      function: |test::frostedfjord2::domain::SkyObject.all()->graphFetch(
        #{
          test::frostedfjord2::domain::SkyObject{
            objectId,
            displayLabel
          }
        }#
      )->serialize(
        #{
          test::frostedfjord2::domain::SkyObject{
            objectId,
            displayLabel
          }
        }#
      );
      tests:
      [
        plateRowPassthrough:
        {
          doc: 'A survey plate row passes its reference through unchanged while the label falls back to the mapping literal.';
          data:
          [
            ModelStore:
              ModelStore
              #{
                test::frostedfjord2::source::SurveyRow:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"rowRef":"SR-0001","constellation":"lyra","sector":"NW-04"}';
                  }#
              }#
          ];
          asserts:
          [
            literalLabel:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"objectId":"SR-0001","displayLabel":"UNCHARTED FIELD"}';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
