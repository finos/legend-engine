###Pure
import meta::pure::profiles::*;

Enum {doc.doc = 'How a stored sample is expected to be conserved by the seed vault.'} demo::opalgecko::domain::ConservationTier
{
  CORE,
  DUPLICATE,
  RESERVE
}

Enum {doc.doc = 'The storage medium a vessel of the vault keeps its samples in.'} demo::opalgecko::domain::StorageMedium
{
  DRY_CABINET,
  CRYO_TANK,
  HUMID_CHAMBER
}

Enum {doc.doc = 'The verdict the last germination trial left a sample in.'} demo::opalgecko::domain::ViabilityGrade
{
  VIABLE,
  MARGINAL,
  UNTESTED
}

Enum {doc.doc = 'The part of a plant a sample was collected from.'} demo::opalgecko::domain::PropaguleForm
{
  SEED,
  SPORE,
  CUTTING
}
