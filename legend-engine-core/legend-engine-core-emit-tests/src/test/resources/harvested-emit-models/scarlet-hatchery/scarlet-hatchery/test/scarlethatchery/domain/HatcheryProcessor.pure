import test::scarlethatchery::domain::*;

Class {HatcheryPresentation.displayLabel = 'hatchery.pipeline / Processor'} test::scarlethatchery::domain::HatcheryProcessor
{
  {HatcheryPresentation.displayLabel = 'Processor Key'} processorKey: String[1];
  enabled: Boolean[0..1];
  {HatcheryPresentation.unitOfMeasure = 'attempts'} retryLimit: Integer[0..1];
}

Class {HatcheryPresentation.displayLabel = 'hatchery.pipeline / Clutch-Aware Processor'} test::scarlethatchery::domain::ClutchAwareProcessor extends HatcheryProcessor
{
  {HatcheryPresentation.displayLabel = 'Clutch Scope'} clutchScope: String[0..1];
  speciesFilter: String[0..1];
}

Class {HatcheryPresentation.displayLabel = 'hatchery.pipeline / Observation Loader'} test::scarlethatchery::domain::ObservationLoader extends ClutchAwareProcessor
{
  {HatcheryPresentation.displayLabel = 'Source Feed'} sourceFeed: String[0..1];
  {HatcheryPresentation.unitOfMeasure = 'rows'} batchSize: Integer[0..1];
}

Class {HatcheryPresentation.displayLabel = 'hatchery.pipeline / Nocturnal Observation Loader'} test::scarlethatchery::domain::NocturnalObservationLoader extends ObservationLoader
{
  {HatcheryPresentation.unitOfMeasure = 'watts'} lampWattage: Integer[0..1];
  quietMode: Boolean[0..1];
}

Class {HatcheryPresentation.displayLabel = 'hatchery.pipeline / Tag Scan Loader'} test::scarlethatchery::domain::TagScanLoader extends ClutchAwareProcessor
{
  {HatcheryPresentation.displayLabel = 'Scanner Model'} scannerModel: String[0..1];
  scanIntervalSeconds: Integer[0..1];
}
