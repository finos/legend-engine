import test::scarlethatchery::domain::*;

Class {HatcheryPresentation.displayLabel = 'hatchery.registry / Registry Item'} test::scarlethatchery::domain::RegistryItem
{
  {HatcheryPresentation.displayLabel = 'Item Key'} itemKey: String[1];
  {HatcheryPresentation.displayLabel = 'Printed Label'} label: String[0..1];
  active: Boolean[0..1];
}

Class {HatcheryPresentation.displayLabel = 'hatchery.registry / Catalogue Item'} test::scarlethatchery::domain::CatalogueItem extends RegistryItem
{
  {HatcheryPresentation.displayLabel = 'Catalogue Category'} itemCategory: String[0..1];
  revision: Integer[0..1];
}

Class {HatcheryPresentation.displayLabel = 'hatchery.tray / Incubation Tray'} test::scarlethatchery::domain::IncubationTrayItem extends CatalogueItem
{
  {HatcheryPresentation.displayLabel = 'Tray Code'} trayCode: String[0..1];
  {HatcheryPresentation.unitOfMeasure = 'slots'} slotCount: Integer[0..1];
  substrate: String[0..1];
}

Class {HatcheryPresentation.displayLabel = 'hatchery.tray / Heated Incubation Tray'} test::scarlethatchery::domain::HeatedTrayItem extends IncubationTrayItem
{
  {HatcheryPresentation.unitOfMeasure = 'celsius'} setPointCelsius: Integer[0..1];
  insulated: Boolean[0..1];
}

Class {HatcheryPresentation.displayLabel = 'hatchery.registry / Tabular Registry Item'} test::scarlethatchery::domain::TableRegistryItem extends RegistryItem
{
  {HatcheryPresentation.displayLabel = 'Physical Sheet Name'} sheetName: String[0..1];
  columnCount: Integer[0..1];
}

Class {HatcheryPresentation.displayLabel = 'hatchery.schedule / Schedule Registry Item'} test::scarlethatchery::domain::ScheduleRegistryItem extends RegistryItem
{
  {HatcheryPresentation.displayLabel = 'Recurrence Text'} recurrenceText: String[0..1];
  {HatcheryPresentation.unitOfMeasure = 'minutes'} windowMinutes: Integer[0..1];
}

Class {HatcheryPresentation.displayLabel = 'hatchery.recon / Reconciliation Registry Item'} test::scarlethatchery::domain::ReconciliationRegistryItem extends RegistryItem
{
  {HatcheryPresentation.unitOfMeasure = 'eggs'} toleranceCount: Integer[0..1];
  lastRunNote: String[0..1];
}
