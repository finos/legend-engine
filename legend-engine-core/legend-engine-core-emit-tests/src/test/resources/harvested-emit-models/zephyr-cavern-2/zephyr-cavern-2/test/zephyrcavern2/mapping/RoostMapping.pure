###Mapping
Mapping test::zephyrcavern2::mapping::RoostMapping
(
  *test::zephyrcavern2::domain::RoostRecord[record]: Pure
  {
    ~src test::zephyrcavern2::domain::RoostPayload
    recordCode: $src.recordCode,
    caveCode: $src.caveCode,
    roostCode: $src.roostCode
  }
  *test::zephyrcavern2::domain::RoostVisit[visit]: Pure
  {
    ~src test::zephyrcavern2::domain::RoostPayload
    visitCode: $src.recordCode,
    caveCode: $src.caveCode,
    roostCode: $src.roostCode,
    visitedOn: %2026-06-01
  }
  testSuites:
  [
    roostSuite:
    {
      function: |test::zephyrcavern2::domain::RoostRecord.all()->graphFetch(
        #{
          test::zephyrcavern2::domain::RoostRecord
          {
            recordCode,
            caveCode,
            roostCode
          }
        }#
      )->serialize(
        #{
          test::zephyrcavern2::domain::RoostRecord
          {
            recordCode,
            caveCode,
            roostCode
          }
        }#
      );
      tests:
      [
        jsonRoostRows:
        {
          doc: 'Maps the store-less JSON fixture through the M2M source row.';
          data:
          [
            ModelStore:
              ModelStore
              #{
                test::zephyrcavern2::domain::RoostPayload:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"recordCode":"RV-01","caveCode":"CAVE-A","roostCode":"CAVE-A-R1"},{"recordCode":"RV-02","caveCode":"CAVE-B","roostCode":"CAVE-B-R1"}]';
                  }#
              }#
          ];
          asserts:
          [
            roostRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"recordCode":"RV-01","caveCode":"CAVE-A","roostCode":"CAVE-A-R1"},{"recordCode":"RV-02","caveCode":"CAVE-B","roostCode":"CAVE-B-R1"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
