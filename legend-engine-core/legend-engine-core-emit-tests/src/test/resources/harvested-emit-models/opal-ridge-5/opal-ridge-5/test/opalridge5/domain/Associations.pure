###Pure
import test::opalridge5::domain::*;

Association {meta::pure::profiles::doc.doc = 'Both ends are business-temporal, so the association itself is milestoned and one business date has to be agreed across both ends before either can be navigated; only counterparts valid at that instant come back.'} test::opalridge5::domain::SignPost_LegibilitySurvey
{
  surveyedSignPost: SignPost[1];
  legibilitySurveys: LegibilitySurvey[*];
}

Association {meta::pure::profiles::doc.doc = 'Bidirectional pair between two unversioned classes, each end carrying its own multiplicity, so the traversal walks either way with no validity qualification and a zone may hold no panel at all.'} test::opalridge5::domain::TrailheadZone_InterpretivePanel
{
  hostingZone: TrailheadZone[0..1];
  mountedPanels: InterpretivePanel[*];
}
