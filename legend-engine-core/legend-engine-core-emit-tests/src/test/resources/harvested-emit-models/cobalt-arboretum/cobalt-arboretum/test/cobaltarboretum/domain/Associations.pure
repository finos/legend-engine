  attributions: ZoneAttribution[*];
}

Association {meta::pure::profiles::doc.doc = 'A canopy hierarchy snapshot is the extent that resolver profiles evaluate against.'} test::cobaltarboretum::domain::CanopyHierarchySnapshot_ResolverProfile
{
