Association {meta::pure::profiles::doc.doc = 'A site revision head owns the measures asserted by that revision; both ends are milestoned so navigation propagates temporal arguments.'} test::cobaltarboretum::domain::SiteRevisionHead_SiteMeasure
{
  revisionHead: SiteRevisionHead[1];
  measures: SiteMeasure[*];
}

Association {meta::pure::profiles::doc.doc = 'A site revision head owns its append-only history rows.'} test::cobaltarboretum::domain::SiteRevisionHead_RevisionLogEntry
{
  loggedRevision: SiteRevisionHead[1];
  logEntries: RevisionLogEntry[*];
}

Association {meta::pure::profiles::doc.doc = 'A measure resolves its unit and precision through the measure-kind vocabulary.'} test::cobaltarboretum::domain::SiteMeasure_MeasureKindDescriptor
{
  measures: SiteMeasure[*];
  kindDescriptor: MeasureKindDescriptor[1];
}

Association {meta::pure::profiles::doc.doc = 'A park zone groups the attribution rows recorded against it.'} test::cobaltarboretum::domain::ParkZone_ZoneAttribution
{
