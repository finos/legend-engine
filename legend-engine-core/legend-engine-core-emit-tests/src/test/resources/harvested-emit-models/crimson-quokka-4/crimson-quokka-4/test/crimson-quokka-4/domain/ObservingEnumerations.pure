###Pure
import test::crimsonquokka4::profile::*;

Enum {PlanDoc.purpose = 'How steady the air above the dome was judged to be while a block was observed.'} test::crimsonquokka4::domain::SeeingBand
{
  PRISTINE,
  STEADY,
  UNSETTLED,
  TURBULENT
}

Enum test::crimsonquokka4::domain::TrackingMode
{
  SIDEREAL,
  LUNAR,
  NON_SIDEREAL,
  PARKED
}

Enum test::crimsonquokka4::domain::CadenceUnit
{
  MINUTE,
  HOUR,
  NIGHT,
  LUNATION
}

Enum test::crimsonquokka4::domain::MoonWindow
{
  DARK,
  GREY,
  BRIGHT
}

Enum test::crimsonquokka4::domain::SpectralResolution
{
  LOW,
  MEDIUM,
  HIGH
}

Enum test::crimsonquokka4::domain::ArchiveCompression
{
  NONE,
  RICE,
  GZIP,
  BZIP,
  PLIO,
  HCOMPRESS,
  DEFLATE,
  LZW,
  ZSTANDARD,
  PACKBITS
}
