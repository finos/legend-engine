###Pure
Class demo::m2m::subtypeCastChildSet::Detail { code: String[1]; }
Class demo::m2m::subtypeCastChildSet::Extra { value: String[1]; detail: demo::m2m::subtypeCastChildSet::Detail[1]; }
Class demo::m2m::subtypeCastChildSet::Base { id: String[1]; }
Class demo::m2m::subtypeCastChildSet::Sub extends demo::m2m::subtypeCastChildSet::Base { extra: demo::m2m::subtypeCastChildSet::Extra[1]; }
Class demo::m2m::subtypeCastChildSet::Root { items: demo::m2m::subtypeCastChildSet::Base[*]; }
Class demo::m2m::subtypeCastChildSet::TDetail { code: String[1]; }
Class demo::m2m::subtypeCastChildSet::TExtra { value: String[1]; detail: demo::m2m::subtypeCastChildSet::TDetail[0..1]; }
Class demo::m2m::subtypeCastChildSet::Row { id: String[1]; extra: demo::m2m::subtypeCastChildSet::TExtra[0..1]; }
Class demo::m2m::subtypeCastChildSet::Holder { rows: demo::m2m::subtypeCastChildSet::Row[*]; }

###Mapping
Mapping demo::m2m::subtypeCastChildSet::ChildSetTransform
(
  *demo::m2m::subtypeCastChildSet::Holder: Pure
  {
    ~src demo::m2m::subtypeCastChildSet::Root
    rows[ROW]: $src.items
  }
  demo::m2m::subtypeCastChildSet::Row[ROW]: Pure
  {
    ~src demo::m2m::subtypeCastChildSet::Base
    id: $src.id,
    extra[EXTRA]: if($src->instanceOf(demo::m2m::subtypeCastChildSet::Sub), |$src->cast(@demo::m2m::subtypeCastChildSet::Sub).extra, |[])
  }
  demo::m2m::subtypeCastChildSet::TExtra[EXTRA]: Pure
  {
    ~src demo::m2m::subtypeCastChildSet::Extra
    value: $src.value,
    detail[DETAIL]: $src.detail
  }
  demo::m2m::subtypeCastChildSet::TDetail[DETAIL]: Pure
  {
    ~src demo::m2m::subtypeCastChildSet::Detail
    code: $src.code
  }
)

###Runtime
Runtime demo::m2m::subtypeCastChildSet::ChildSetRuntime
{
  mappings:
  [
    demo::m2m::subtypeCastChildSet::ChildSetTransform
  ];
  connections:
  [
    ModelStore:
    [
      json:
      #{
        JsonModelConnection
        {
          class: demo::m2m::subtypeCastChildSet::Root;
          url: 'executor:default';
        }
      }#
    ]
  ];
}

###Service
Service demo::m2m::subtypeCastChildSet::ChildSetService
{
  pattern: '/m2m-subtype-cast-child-set';
  documentation: 'M2M child set reached through a subtype cast maps a property to a further child set';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |demo::m2m::subtypeCastChildSet::Holder.all()->graphFetch(#{demo::m2m::subtypeCastChildSet::Holder{rows{id,extra{value,detail{code}}}}}#)->serialize(#{demo::m2m::subtypeCastChildSet::Holder{rows{id,extra{value,detail{code}}}}}#);
    mapping: demo::m2m::subtypeCastChildSet::ChildSetTransform;
    runtime: demo::m2m::subtypeCastChildSet::ChildSetRuntime;
  }
  testSuites:
  [
    suite:
    {
      data:
      [
        connections:
        [
          json:
            ExternalFormat
            #{
              contentType: 'application/json';
              data: '{"items":[{"@type":"Sub","id":"S1","extra":{"value":"x1","detail":{"code":"c1"}}},{"@type":"Sub","id":"S2","extra":{"value":"x2","detail":{"code":"c2"}}}]}';
            }#
        ]
      ]
      tests:
      [
        test:
        {
          serializationFormat: PURE;
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"rows":[{"id":"S1","extra":{"value":"x1","detail":{"code":"c1"}}},{"id":"S2","extra":{"value":"x2","detail":{"code":"c2"}}}]}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
