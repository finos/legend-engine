// Each suite serializes the same date-times with the dateTimeFormat of its own
// AlloySerializationConfig. The mapping copies the date-time across unchanged, so
// what a test asserts is only how that format wrote it.

###Mapping
Mapping demo::m2m::dateFormats::ReadingMapping
(
  *demo::m2m::dateFormats::target::Reading: Pure
  {
    ~src demo::m2m::dateFormats::source::S_Reading
    id: $src.id,
    takenAt: $src.takenAt
  }

  testSuites:
  [
    // The long-standing syntax. A run of S is a fixed width, written with zeros where there is no fraction.
    oldSyntaxMilliseconds:
    {
      function: |demo::m2m::dateFormats::target::Reading.all()->graphFetch(#{demo::m2m::dateFormats::target::Reading{id, takenAt}}#)->serialize(#{demo::m2m::dateFormats::target::Reading{id, takenAt}}#, ^meta::pure::graphFetch::execution::AlloySerializationConfig(dateTimeFormat='yyyy-MM-dd"T"HH:mm:ss.SSSZ'));
      tests:
      [
        withFraction:
        {
          data:
          [
            ModelStore: ModelStore
              #{
                demo::m2m::dateFormats::source::S_Reading:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"id":1,"takenAt":"2012-05-20T13:10:52.501"}';
                  }#
              }#
          ];
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{\"id\":1,\"takenAt\":\"2012-05-20T13:10:52.501+0000\"}';
                  }#;
              }#
          ];
        },
        withoutFraction:
        {
          data:
          [
            ModelStore: ModelStore
              #{
                demo::m2m::dateFormats::source::S_Reading:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"id":2,"takenAt":"2012-05-20T13:10:52"}';
                  }#
              }#
          ];
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{\"id\":2,\"takenAt\":\"2012-05-20T13:10:52.000+0000\"}';
                  }#;
              }#
          ];
        }
      ];
    },
    // A run longer than the fraction a date-time carries is still that fixed width, padded with zeros.
    oldSyntaxNanoseconds:
    {
      function: |demo::m2m::dateFormats::target::Reading.all()->graphFetch(#{demo::m2m::dateFormats::target::Reading{id, takenAt}}#)->serialize(#{demo::m2m::dateFormats::target::Reading{id, takenAt}}#, ^meta::pure::graphFetch::execution::AlloySerializationConfig(dateTimeFormat='yyyy-MM-dd"T"HH:mm:ss.SSSSSSSSSZ'));
      tests:
      [
        withFraction:
        {
          data:
          [
            ModelStore: ModelStore
              #{
                demo::m2m::dateFormats::source::S_Reading:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"id":1,"takenAt":"2012-05-20T13:10:52.501"}';
                  }#
              }#
          ];
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{\"id\":1,\"takenAt\":\"2012-05-20T13:10:52.501000000+0000\"}';
                  }#;
              }#
          ];
        },
        withoutFraction:
        {
          data:
          [
            ModelStore: ModelStore
              #{
                demo::m2m::dateFormats::source::S_Reading:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"id":2,"takenAt":"2012-05-20T13:10:52"}';
                  }#
              }#
          ];
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{\"id\":2,\"takenAt\":\"2012-05-20T13:10:52.000000000+0000\"}';
                  }#;
              }#
          ];
        }
      ];
    },
    // An optional section writes the fraction only where there is one, and S* writes every digit there is.
    newSyntaxOptionalSection:
    {
      function: |demo::m2m::dateFormats::target::Reading.all()->graphFetch(#{demo::m2m::dateFormats::target::Reading{id, takenAt}}#)->serialize(#{demo::m2m::dateFormats::target::Reading{id, takenAt}}#, ^meta::pure::graphFetch::execution::AlloySerializationConfig(dateTimeFormat='yyyy-MM-dd"T"HH:mm:ss?[.S*]Z'));
      tests:
      [
        withFraction:
        {
          data:
          [
            ModelStore: ModelStore
              #{
                demo::m2m::dateFormats::source::S_Reading:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"id":1,"takenAt":"2012-05-20T13:10:52.501"}';
                  }#
              }#
          ];
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{\"id\":1,\"takenAt\":\"2012-05-20T13:10:52.501+0000\"}';
                  }#;
              }#
          ];
        },
        withoutFraction:
        {
          data:
          [
            ModelStore: ModelStore
              #{
                demo::m2m::dateFormats::source::S_Reading:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"id":2,"takenAt":"2012-05-20T13:10:52"}';
                  }#
              }#
          ];
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{\"id\":2,\"takenAt\":\"2012-05-20T13:10:52+0000\"}';
                  }#;
              }#
          ];
        }
      ];
    },
    // The fixed width of SSS spelled out, which has to write exactly what oldSyntaxMilliseconds writes.
    newSyntaxAlternative:
    {
      function: |demo::m2m::dateFormats::target::Reading.all()->graphFetch(#{demo::m2m::dateFormats::target::Reading{id, takenAt}}#)->serialize(#{demo::m2m::dateFormats::target::Reading{id, takenAt}}#, ^meta::pure::graphFetch::execution::AlloySerializationConfig(dateTimeFormat='yyyy-MM-dd"T"HH:mm:ss?[.S3|".000"]Z'));
      tests:
      [
        withFraction:
        {
          data:
          [
            ModelStore: ModelStore
              #{
                demo::m2m::dateFormats::source::S_Reading:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"id":1,"takenAt":"2012-05-20T13:10:52.501"}';
                  }#
              }#
          ];
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{\"id\":1,\"takenAt\":\"2012-05-20T13:10:52.501+0000\"}';
                  }#;
              }#
          ];
        },
        withoutFraction:
        {
          data:
          [
            ModelStore: ModelStore
              #{
                demo::m2m::dateFormats::source::S_Reading:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"id":2,"takenAt":"2012-05-20T13:10:52"}';
                  }#
              }#
          ];
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{\"id\":2,\"takenAt\":\"2012-05-20T13:10:52.000+0000\"}';
                  }#;
              }#
          ];
        }
      ];
    },
    // A sub-second width. Unlike a run of S it refuses a date-time with no fraction, so only one with a fraction is given.
    newSyntaxSubSecondWidth:
    {
      function: |demo::m2m::dateFormats::target::Reading.all()->graphFetch(#{demo::m2m::dateFormats::target::Reading{id, takenAt}}#)->serialize(#{demo::m2m::dateFormats::target::Reading{id, takenAt}}#, ^meta::pure::graphFetch::execution::AlloySerializationConfig(dateTimeFormat='yyyy-MM-dd"T"HH:mm:ss.S6Z'));
      tests:
      [
        withFraction:
        {
          data:
          [
            ModelStore: ModelStore
              #{
                demo::m2m::dateFormats::source::S_Reading:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"id":1,"takenAt":"2012-05-20T13:10:52.501"}';
                  }#
              }#
          ];
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{\"id\":1,\"takenAt\":\"2012-05-20T13:10:52.501000+0000\"}';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
