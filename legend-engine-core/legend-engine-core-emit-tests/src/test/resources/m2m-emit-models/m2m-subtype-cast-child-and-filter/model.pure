###Pure
Class demo::m2m::subtypeCast::Extra { value: String[1]; }
Class demo::m2m::subtypeCast::Base { id: String[1]; }
Class demo::m2m::subtypeCast::Sub extends demo::m2m::subtypeCast::Base { extra: demo::m2m::subtypeCast::Extra[1]; tag: String[1]; }
Class demo::m2m::subtypeCast::Root { items: demo::m2m::subtypeCast::Base[*]; }
Class demo::m2m::subtypeCast::Row { id: String[1]; extraValue: String[1]; }
Class demo::m2m::subtypeCast::Holder { rows: demo::m2m::subtypeCast::Row[*]; }
Class demo::m2m::subtypeCast::Picked { id: String[1]; }

###Mapping
Mapping demo::m2m::subtypeCast::ChildTransform
(
  *demo::m2m::subtypeCast::Holder: Pure
  {
    ~src demo::m2m::subtypeCast::Root
    rows: $src.items
  }
  *demo::m2m::subtypeCast::Row: Pure
  {
    ~src demo::m2m::subtypeCast::Base
    id: $src.id,
    extraValue: $src->cast(@demo::m2m::subtypeCast::Sub).extra.value
  }
)

Mapping demo::m2m::subtypeCast::FilterTransform
(
  *demo::m2m::subtypeCast::Picked: Pure
  {
    ~src demo::m2m::subtypeCast::Base
    ~filter $src->instanceOf(demo::m2m::subtypeCast::Sub) && ($src->cast(@demo::m2m::subtypeCast::Sub).tag == 'keep')
    id: $src.id
  }
)

###Runtime
Runtime demo::m2m::subtypeCast::ChildRuntime
{
  mappings:
  [
    demo::m2m::subtypeCast::ChildTransform
  ];
  connections:
  [
    ModelStore:
    [
      json:
      #{
        JsonModelConnection
        {
          class: demo::m2m::subtypeCast::Root;
          url: 'executor:default';
        }
      }#
    ]
  ];
}

Runtime demo::m2m::subtypeCast::FilterRuntime
{
  mappings:
  [
    demo::m2m::subtypeCast::FilterTransform
  ];
  connections:
  [
    ModelStore:
    [
      json:
      #{
        JsonModelConnection
        {
          class: demo::m2m::subtypeCast::Base;
          url: 'executor:default';
        }
      }#
    ]
  ];
}

###Service
Service demo::m2m::subtypeCast::ChildService
{
  pattern: '/m2m-subtype-cast-child';
  documentation: 'M2M child set reads a subtype property through an explicit cast of its source';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |demo::m2m::subtypeCast::Holder.all()->graphFetch(#{demo::m2m::subtypeCast::Holder{rows{id,extraValue}}}#)->serialize(#{demo::m2m::subtypeCast::Holder{rows{id,extraValue}}}#);
    mapping: demo::m2m::subtypeCast::ChildTransform;
    runtime: demo::m2m::subtypeCast::ChildRuntime;
  }
  testSuites:
  [
    suite:
    {
      data:
      [
        connections:
        [
          json:
            ExternalFormat
            #{
              contentType: 'application/json';
              data: '{"items":[{"@type":"Sub","id":"S1","extra":{"value":"x1"},"tag":"t1"},{"@type":"Sub","id":"S2","extra":{"value":"x2"},"tag":"t2"}]}';
            }#
        ]
      ]
      tests:
      [
        test:
        {
          serializationFormat: PURE;
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"rows":[{"id":"S1","extraValue":"x1"},{"id":"S2","extraValue":"x2"}]}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service demo::m2m::subtypeCast::FilterService
{
  pattern: '/m2m-subtype-cast-filter';
  documentation: 'M2M root filter narrows through an explicit cast to a property only the subtype declares';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |demo::m2m::subtypeCast::Picked.all()->graphFetch(#{demo::m2m::subtypeCast::Picked{id}}#)->serialize(#{demo::m2m::subtypeCast::Picked{id}}#);
    mapping: demo::m2m::subtypeCast::FilterTransform;
    runtime: demo::m2m::subtypeCast::FilterRuntime;
  }
  testSuites:
  [
    suite:
    {
      data:
      [
        connections:
        [
          json:
            ExternalFormat
            #{
              contentType: 'application/json';
              data: '[{"@type":"Sub","id":"S1","extra":{"value":"x1"},"tag":"keep"},{"@type":"Sub","id":"S2","extra":{"value":"x2"},"tag":"drop"},{"@type":"Base","id":"B1"},{"@type":"Sub","id":"S3","extra":{"value":"x3"},"tag":"keep"}]';
            }#
        ]
      ]
      tests:
      [
        test:
        {
          serializationFormat: PURE;
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":"S1"},{"id":"S3"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
