###Pure
Class demo::m2m::newInstance::readInTransform::Leaf { id: String[1]; }
Class demo::m2m::newInstance::readInTransform::Source { aDecoy: demo::m2m::newInstance::readInTransform::Leaf[1]; primary: demo::m2m::newInstance::readInTransform::Leaf[1]; }
Class demo::m2m::newInstance::readInTransform::Box { ft: demo::m2m::newInstance::readInTransform::Leaf[1]; }
Class demo::m2m::newInstance::readInTransform::Target { value: String[1]; }

###Mapping
Mapping demo::m2m::newInstance::readInTransform::Transform
(
  *demo::m2m::newInstance::readInTransform::Target: Pure
  {
    ~src demo::m2m::newInstance::readInTransform::Source
    value: ^demo::m2m::newInstance::readInTransform::Box(ft=$src.primary).ft.id
  }
)

###Runtime
Runtime demo::m2m::newInstance::readInTransform::TransformRuntime
{
  mappings:
  [
    demo::m2m::newInstance::readInTransform::Transform
  ];
  connections:
  [
    ModelStore:
    [
      json:
      #{
        JsonModelConnection
        {
          class: demo::m2m::newInstance::readInTransform::Source;
          url: 'executor:default';
        }
      }#
    ]
  ];
}

###Service
Service demo::m2m::newInstance::readInTransform::TransformService
{
  pattern: '/m2m-new-read-in-transform';
  documentation: 'M2M reads a property of an instance constructed in the same transform';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |demo::m2m::newInstance::readInTransform::Target.all()->graphFetch(#{demo::m2m::newInstance::readInTransform::Target{value}}#)->serialize(#{demo::m2m::newInstance::readInTransform::Target{value}}#);
    mapping: demo::m2m::newInstance::readInTransform::Transform;
    runtime: demo::m2m::newInstance::readInTransform::TransformRuntime;
  }
  testSuites:
  [
    suite:
    {
      data:
      [
        connections:
        [
          json:
            ExternalFormat
            #{
              contentType: 'application/json';
              data: '{"aDecoy":{"id":"DECOY"},"primary":{"id":"PRIMARY"}}';
            }#
        ]
      ]
      tests:
      [
        test:
        {
          serializationFormat: PURE;
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"value":"PRIMARY"}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
