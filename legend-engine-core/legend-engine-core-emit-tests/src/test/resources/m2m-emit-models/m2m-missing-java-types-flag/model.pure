###Pure
Class demo::m2m::missingJavaTypes::src::Wrapper { paymentAction: demo::m2m::missingJavaTypes::src::PaymentAction[1]; }
Class demo::m2m::missingJavaTypes::src::PaymentAction { id: String[1]; actionData: demo::m2m::missingJavaTypes::src::AbstractActionData[1]; }
Class <<typemodifiers.abstract>> demo::m2m::missingJavaTypes::src::AbstractActionData { requestId: String[0..1]; }
Class demo::m2m::missingJavaTypes::src::PaymentActionData extends demo::m2m::missingJavaTypes::src::AbstractActionData { paymentCreationTimeStamp: String[0..1]; }
Class demo::m2m::missingJavaTypes::src::AdjustPaymentActionData extends demo::m2m::missingJavaTypes::src::PaymentActionData { adjustmentAmount: Float[1]; }
Class demo::m2m::missingJavaTypes::src::InstructPaymentActionData extends demo::m2m::missingJavaTypes::src::PaymentActionData { defaultInstruction: demo::m2m::missingJavaTypes::src::SettlementInstructionIdentifier[0..1]; assignedInstruction: demo::m2m::missingJavaTypes::src::SettlementInstructionIdentifier[0..1]; }
Class demo::m2m::missingJavaTypes::src::SettlementInstructionIdentifier { instructionId: String[1]; instructionSource: String[1]; }

Class demo::m2m::missingJavaTypes::Out { action: demo::m2m::missingJavaTypes::Action[0..1]; }
Class demo::m2m::missingJavaTypes::Action { actionId: String[0..1]; actionData: demo::m2m::missingJavaTypes::HubbleActionData[0..1]; }
Class <<typemodifiers.abstract>> demo::m2m::missingJavaTypes::HubbleActionData { }
Class demo::m2m::missingJavaTypes::PaymentActionData extends demo::m2m::missingJavaTypes::HubbleActionData { paymentCreationTimeStamp: String[0..1]; }
Class demo::m2m::missingJavaTypes::AdjustPaymentActionData extends demo::m2m::missingJavaTypes::PaymentActionData { adjustmentAmount: Float[1]; }
Class demo::m2m::missingJavaTypes::InstructPaymentActionData extends demo::m2m::missingJavaTypes::PaymentActionData { defaultInstruction: demo::m2m::missingJavaTypes::SettlementInstructionIdentifier[0..1]; assignedInstruction: demo::m2m::missingJavaTypes::SettlementInstructionIdentifier[0..1]; }
Class demo::m2m::missingJavaTypes::SettlementInstructionIdentifier { instructionId: String[1]; instructionSource: String[1]; }

###Mapping
Mapping demo::m2m::missingJavaTypes::PaymentActionMapping
(
  *demo::m2m::missingJavaTypes::Out: Pure
  {
    ~src demo::m2m::missingJavaTypes::src::Wrapper
    action[ACTION]: $src
  }
  demo::m2m::missingJavaTypes::Action[ACTION]: Pure
  {
    ~src demo::m2m::missingJavaTypes::src::Wrapper
    actionId: $src.paymentAction.id,
    actionData[ADJUST]: if($src.paymentAction.actionData->instanceOf(demo::m2m::missingJavaTypes::src::AdjustPaymentActionData), |$src.paymentAction.actionData->cast(@demo::m2m::missingJavaTypes::src::AdjustPaymentActionData), |[]),
    actionData[INSTRUCT]: if($src.paymentAction.actionData->instanceOf(demo::m2m::missingJavaTypes::src::InstructPaymentActionData), |$src.paymentAction.actionData->cast(@demo::m2m::missingJavaTypes::src::InstructPaymentActionData), |[]),
    actionData[PAYMENT]: if($src.paymentAction.actionData->instanceOf(demo::m2m::missingJavaTypes::src::PaymentActionData) && !$src.paymentAction.actionData->instanceOf(demo::m2m::missingJavaTypes::src::AdjustPaymentActionData) && !$src.paymentAction.actionData->instanceOf(demo::m2m::missingJavaTypes::src::InstructPaymentActionData), |$src.paymentAction.actionData->cast(@demo::m2m::missingJavaTypes::src::PaymentActionData), |[])
  }
  demo::m2m::missingJavaTypes::PaymentActionData[PAYMENT]: Pure
  {
    ~src demo::m2m::missingJavaTypes::src::PaymentActionData
    paymentCreationTimeStamp: $src.paymentCreationTimeStamp
  }
  demo::m2m::missingJavaTypes::AdjustPaymentActionData[ADJUST]: Pure
  {
    ~src demo::m2m::missingJavaTypes::src::AdjustPaymentActionData
    paymentCreationTimeStamp: $src.paymentCreationTimeStamp,
    adjustmentAmount: $src.adjustmentAmount
  }
  demo::m2m::missingJavaTypes::InstructPaymentActionData[INSTRUCT]: Pure
  {
    ~src demo::m2m::missingJavaTypes::src::InstructPaymentActionData
    paymentCreationTimeStamp: $src.paymentCreationTimeStamp,
    defaultInstruction[INSTRUCTION]: $src.defaultInstruction,
    assignedInstruction[INSTRUCTION]: $src.assignedInstruction
  }
  demo::m2m::missingJavaTypes::SettlementInstructionIdentifier[INSTRUCTION]: Pure
  {
    ~src demo::m2m::missingJavaTypes::src::SettlementInstructionIdentifier
    instructionId: $src.instructionId,
    instructionSource: $src.instructionSource
  }
)

###Runtime
Runtime demo::m2m::missingJavaTypes::PaymentActionRuntime
{
  mappings:
  [
    demo::m2m::missingJavaTypes::PaymentActionMapping
  ];
  connections:
  [
    ModelStore:
    [
      json:
      #{
        JsonModelConnection
        {
          class: demo::m2m::missingJavaTypes::src::Wrapper;
          url: 'executor:default';
        }
      }#
    ]
  ];
}

###Service
Service demo::m2m::missingJavaTypes::PaymentActionService
{
  pattern: '/m2m-missing-java-types-flag';
  documentation: 'M2M graph fetch that only compiles with M2M_MIGRATION_MISSING_JAVA_TYPES';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |demo::m2m::missingJavaTypes::Out.all()->graphFetch(#{demo::m2m::missingJavaTypes::Out{action{actionId, actionData, actionData->subType(@demo::m2m::missingJavaTypes::AdjustPaymentActionData){paymentCreationTimeStamp, adjustmentAmount}, actionData->subType(@demo::m2m::missingJavaTypes::InstructPaymentActionData){paymentCreationTimeStamp, defaultInstruction{instructionId, instructionSource}, assignedInstruction{instructionId, instructionSource}}, actionData->subType(@demo::m2m::missingJavaTypes::PaymentActionData){paymentCreationTimeStamp}}}}#)->serialize(#{demo::m2m::missingJavaTypes::Out{action{actionId, actionData, actionData->subType(@demo::m2m::missingJavaTypes::AdjustPaymentActionData){paymentCreationTimeStamp, adjustmentAmount}, actionData->subType(@demo::m2m::missingJavaTypes::InstructPaymentActionData){paymentCreationTimeStamp, defaultInstruction{instructionId, instructionSource}, assignedInstruction{instructionId, instructionSource}}, actionData->subType(@demo::m2m::missingJavaTypes::PaymentActionData){paymentCreationTimeStamp}}}}#)->meta::pure::executionPlan::featureFlag::withFeatureFlags(meta::pure::executionPlan::features::Feature.M2M_MIGRATION_MISSING_JAVA_TYPES);
    mapping: demo::m2m::missingJavaTypes::PaymentActionMapping;
    runtime: demo::m2m::missingJavaTypes::PaymentActionRuntime;
  }
  testSuites:
  [
    instruct:
    {
      data:
      [
        connections:
        [
          json:
            ExternalFormat
            #{
              contentType: 'application/json';
              data: '{"paymentAction":{"id":"A1","actionData":{"@type":"InstructPaymentActionData","paymentCreationTimeStamp":"t1","defaultInstruction":{"instructionId":"D1","instructionSource":"SSI"}}}}';
            }#
        ]
      ]
      tests:
      [
        test:
        {
          serializationFormat: PURE;
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"action":{"actionId":"A1","actionData":{"paymentCreationTimeStamp":"t1","defaultInstruction":{"instructionId":"D1","instructionSource":"SSI"},"assignedInstruction":null}}}';
                  }#;
              }#
          ]
        }
      ]
    },
    plainPayment:
    {
      data:
      [
        connections:
        [
          json:
            ExternalFormat
            #{
              contentType: 'application/json';
              data: '{"paymentAction":{"id":"A2","actionData":{"@type":"PaymentActionData","paymentCreationTimeStamp":"t2"}}}';
            }#
        ]
      ]
      tests:
      [
        test:
        {
          serializationFormat: PURE;
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"action":{"actionId":"A2","actionData":{"paymentCreationTimeStamp":"t2"}}}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
