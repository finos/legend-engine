// The mapping copies the dates across rather than transforming them, so that what
// the test asserts is what internalizing produced and nothing else.

###Mapping
Mapping demo::m2m::dates::ShiftMapping
(
  *demo::m2m::dates::target::Shift: Pure
  {
    ~src demo::m2m::dates::source::S_Shift
    id: $src.id,
    startedOn: $src.startedOn,
    startedAt: $src.startedAt,
    endedAt: $src.endedAt
  }

  testSuites:
  [
    dateSuite:
    {
      function: |demo::m2m::dates::target::Shift.all()->graphFetch(#{demo::m2m::dates::target::Shift{id, startedOn, startedAt, endedAt}}#)->serialize(#{demo::m2m::dates::target::Shift{id, startedOn, startedAt, endedAt}}#);
      tests:
      [
        // A date, a date and time carrying subsecond digits, and an absent one.
        shift:
        {
          data:
          [
            ModelStore: ModelStore
              #{
                demo::m2m::dates::source::S_Shift:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"id":1,"startedOn":"2012-05-20","startedAt":"2012-05-20T13:10:52.501"}';
                  }#
              }#
          ];
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{\"id\":1,\"startedOn\":\"2012-05-20\",\"startedAt\":\"2012-05-20T13:10:52.501\",\"endedAt\":null}';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
