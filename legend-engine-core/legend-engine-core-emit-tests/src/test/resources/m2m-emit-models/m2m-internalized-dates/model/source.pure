// The source of an M2M test is given as external format text, which the test
// harness internalizes into instances of this class. The dates below are what
// that reading has to carry across intact.

###Pure
Class demo::m2m::dates::source::S_Shift
{
  id: Integer[1];
  startedOn: StrictDate[1];
  startedAt: DateTime[1];
  endedAt: DateTime[0..1];
}
