{
    assertEquals(1.25, $f->eval(|fromJson('1.25')->to(@Float)));
}

function <<PCT.test, PCTCoreQualifier.variant>> meta::pure::functions::variant::convert::tests::to::testToFloatFromInteger<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals(1.0, $f->eval(|fromJson('1')->to(@Float)));
