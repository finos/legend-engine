function <<PCT.test, PCTCoreQualifier.variant>> meta::pure::functions::variant::convert::tests::to::testToListOfVariants<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    let result = $f->eval(|fromJson('[1, 2, 3]')->to(@List<Variant>));
    assertEquals(1, $result.values->at(0)->to(@Integer));
    assertEquals(2, $result.values->at(1)->to(@Integer));
    assertEquals(3, $result.values->at(2)->to(@Integer));
}

function <<PCT.test, PCTCoreQualifier.variant>> meta::pure::functions::variant::convert::tests::to::testToListOfIntegers<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    let result = $f->eval(|fromJson('[1, 2, 3]')->to(@List<Integer>));
    assertEquals(1, $result.values->at(0));
    assertEquals(2, $result.values->at(1));
    assertEquals(3, $result.values->at(2));
}

function <<PCT.test, PCTCoreQualifier.variant>> meta::pure::functions::variant::convert::tests::to::testToListFromNonArrayVariant<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertError(|$f->eval(|fromJson('"not an array"')->to(@List<Variant>)), 'List<Variant> is not managed yet!');
}

function <<PCT.test, PCTCoreQualifier.variant>> meta::pure::functions::variant::convert::tests::to::testToEnum<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertError(|$f->eval(|fromJson('"January"')->to(@meta::pure::functions::date::Month)), 'Month is not managed yet!');
}

function <<PCT.test, PCTCoreQualifier.variant>> meta::pure::functions::variant::convert::tests::to::testToAny<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
  assertError(|$f->eval(|fromJson('"hello"')->to(@Any)), 'Any is not managed yet!');
}

function <<PCT.test, PCTCoreQualifier.variant>> meta::pure::functions::variant::convert::tests::to::testToClass<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    let result = $f->eval(|fromJson('{"firstName": "John", "lastName": "Smith"}')->to(@Person));
    assertEquals(^Person(firstName = 'John', lastName = 'Smith'), $result);
}

function <<PCT.test, PCTCoreQualifier.variant>> meta::pure::functions::variant::convert::tests::to::testToClassWithInheritance<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    let dogResult = $f->eval(|fromJson('{"_type": "Dog", "name": "Doggo", "isPuppy": true}')->to(@Pet));
    assertEquals(^Dog(name = 'Doggo', isPuppy = true), $dogResult);

    let catResult = $f->eval(|fromJson('{"_type": "Cat", "name": "Gato", "isKitten": false}')->to(@Pet));
    assertEquals(^Cat(name = 'Gato', isKitten = false), $catResult);    
}


//written as standard test as we are testing special handling of @type only triggered via reactivate
function <<test.Test>> meta::pure::functions::variant::convert::tests::to::testReactivate():Boolean[1]
{
    let value = {|fromJson('1')->to(@Integer)}.expressionSequence->at(0)->reactivate();
    assertEquals(1, $value);
}

Class <<access.private>> meta::pure::functions::variant::convert::tests::to::Person
{
  <<equality.Key>> firstName: String[1];
  <<equality.Key>> lastName: String[1];
}

Class <<access.private>> meta::pure::functions::variant::convert::tests::to::Pet
{
  <<equality.Key>> name: String[1];  
  <<equality.Key>> owner: Person[0..1]; 
}

Class <<access.private>> meta::pure::functions::variant::convert::tests::to::Dog extends meta::pure::functions::variant::convert::tests::to::Pet
{
  <<equality.Key>> isPuppy: Boolean[1];
}

Class <<access.private>> meta::pure::functions::variant::convert::tests::to::Cat extends meta::pure::functions::variant::convert::tests::to::Pet
{
  <<equality.Key>> isKitten: Boolean[1];  
}