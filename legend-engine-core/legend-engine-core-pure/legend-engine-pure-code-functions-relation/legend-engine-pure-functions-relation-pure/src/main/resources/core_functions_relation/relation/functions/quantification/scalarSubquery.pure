import meta::pure::metamodel::relation::*;
import meta::pure::functions::relation::*;

// A scalar subquery: a single-column, at-most-one-row relation used as a value expression.
// In SQL this corresponds to a parenthesized SELECT that appears in comparison, arithmetic,
// CASE, or projection positions. The relational plan generator translates this into a SQL
// scalar subquery (SELECT ... ) in the appropriate position.
//
// The return type U is the type of the single column; the multiplicity is [0..1] because
// the subquery may return zero rows (in which case the value is null).
function meta::pure::functions::relation::scalarSubquery<U,Z>(rel:Relation<Z=(?:U)>[1]):U[0..1]
{
   // Default implementation: extract the single column value from the first (and only) row.
   // On relational stores this is overridden by the plan generator to emit a SQL scalar subquery.
   let col = $rel->genericType().typeArguments->at(0).rawType->toOne()->cast(@RelationType<Any>).columns->toOne()->cast(@Column<Nil,U|0..1>);
   let rows = $rel->meta::pure::functions::relation::limit(1);
   if($rows->meta::pure::functions::relation::size() == 0, | [], | $col->eval($rows->cast(@Z)));
}

