import meta::pure::test::pct::*;
import meta::pure::metamodel::relation::*;

'''
Set difference of two relations: distinct rows of `rel1` that do not appear in `rel2`.

Both relations must have the same type, which the signature enforces. Row matching is on the full
tuple — a partial match on some columns is not a match. Duplicates in `rel1` collapse to a single
row in the result; use `exceptAll(Relation<T>[1], Relation<T>[1]):Relation<T>[1]` to keep
multiplicities (bag semantics).

The result carries no guaranteed row order, so sort afterwards if the order matters.

**Parameters**
- `rel1` — the relation to subtract from.
- `rel2` — the relation whose rows are removed.

**Returns** the distinct rows of `rel1` not present in `rel2`.

**Examples**
```pure
$allCustomers->except($churnedCustomers)
```

**See also** `exceptAll(Relation<T>[1], Relation<T>[1]):Relation<T>[1]`,
`intersect(Relation<T>[1], Relation<T>[1]):Relation<T>[1]`,
`union(Relation<T>[1], Relation<T>[1]):Relation<T>[1]`
'''
native function <<PCT.function>> meta::pure::functions::relation::except<T>(rel1:Relation<T>[1], rel2:Relation<T>[1]):Relation<T>[1];

function <<PCT.test>> meta::pure::functions::relation::tests::except::testExceptRemovesDuplicates<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {
               | #TDS
                  val, str
                  1, a
                  1, a
                  2, b
                  2, b
                  3, c
                #
                ->except
                (
                  #TDS
                    val, str
                    1, a
                    3, c
                  #);
              };

    let res =  $f->eval($expr);

    assertEquals( '#TDS\n'+
                  '   val,str\n'+
                  '   2,b\n'+
                  '#', $res->sort([~val->ascending(), ~str->ascending()])->toString());
}

function <<PCT.test>> meta::pure::functions::relation::tests::except::testExcept_MultipleExpressions<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {
               |
                let a = #TDS
                  val, str
                  1, a
                  2, b
                  3, c
                  4, d
                #;
                let b = #TDS
                    val, str
                    1, a
                #;
                let c = #TDS
                    val, str
                    2, b
                #;
                $a->except($b)->except($c);
              };

    let res =  $f->eval($expr);

    assertEquals( '#TDS\n'+
                  '   val,str\n'+
                  '   3,c\n'+
                  '   4,d\n'+
                  '#', $res->sort([~val->ascending(), ~str->ascending()])->toString());
}

function <<PCT.test>> meta::pure::functions::relation::tests::except::testExceptPartialRowMatchIsNotAMatch<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {
               | #TDS
                  val, str
                  1, a
                  2, b
                  3, c
                #
                ->except
                (
                  #TDS
                    val, str
                    1, x
                    2, b
                    3, y
                  #);
              };

    let res =  $f->eval($expr);

    assertEquals( '#TDS\n'+
                  '   val,str\n'+
                  '   1,a\n'+
                  '   3,c\n'+
                  '#', $res->sort([~val->ascending(), ~str->ascending()])->toString());
}
