import meta::pure::test::pct::*;
import meta::pure::metamodel::relation::*;

'''
Union of two relations keeping every row, duplicates included.

Both relations must have the same type, which the signature enforces. A row that appears `n` times
on the left and `m` times on the right appears `n + m` times in the result. Use
`union(Relation<T>[1], Relation<T>[1]):Relation<T>[1]` for set semantics.

Behaviourally equivalent to `concatenate(Relation<T>[1], Relation<T>[1]):Relation<T>[1]`; prefer
`unionAll`

The result carries no guaranteed row order, so sort afterwards if the order matters.

**Parameters**
- `rel1` — the first relation.
- `rel2` — the second, of the same type.

**Returns** the rows of both, with multiplicities summed.

**Examples**
```pure
$thisYear->unionAll($lastYear)
```

**See also** `union(Relation<T>[1], Relation<T>[1]):Relation<T>[1]`,
`intersectAll(Relation<T>[1], Relation<T>[1]):Relation<T>[1]`,
`exceptAll(Relation<T>[1], Relation<T>[1]):Relation<T>[1]`
'''
native function <<PCT.function>> meta::pure::functions::relation::unionAll<T>(rel1:Relation<T>[1], rel2:Relation<T>[1]):Relation<T>[1];

function <<PCT.test>> meta::pure::functions::relation::tests::unionAll::testSimpleUnionAllShared<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {
               | #TDS
                  val, str
                  1, a
                  3, ewe
                  4, qw
                #
                ->unionAll
                (
                  #TDS
                    val, str
                    5, qwea
                    6, eeewe
                    7, qqwew
                  #);
              };

    let res =  $f->eval($expr);

    assertEquals( '#TDS\n'+
                  '   val,str\n'+
                  '   1,a\n'+
                  '   3,ewe\n'+
                  '   4,qw\n'+
                  '   5,qwea\n'+
                  '   6,eeewe\n'+
                  '   7,qqwew\n'+
                  '#', $res->sort(~val->ascending())->toString());
}

function <<PCT.test>> meta::pure::functions::relation::tests::unionAll::testSimpleUnionAll_MultipleExpressions<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {
               | 
                let a = #TDS
                  val, str
                  1, a
                  3, ewe
                  4, qw
                #;
                let b = #TDS
                    val, str
                    5, qwea
                    6, eeewe
                    7, qqwew
                #;
                let c = $a->unionAll($b);
                $c->unionAll($b);
              };

    let res =  $f->eval($expr);

    assertEquals( '#TDS\n'+
                  '   val,str\n'+
                  '   1,a\n'+
                  '   3,ewe\n'+
                  '   4,qw\n'+
                  '   5,qwea\n'+
                  '   5,qwea\n'+
                  '   6,eeewe\n'+
                  '   6,eeewe\n'+
                  '   7,qqwew\n'+
                  '   7,qqwew\n'+
                  '#', $res->sort([~val->ascending(), ~str->ascending()])->toString());
}

function <<PCT.test>> meta::pure::functions::relation::tests::unionAll::testUnionAllOfSortedRelations<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expected = '#TDS\n'+
                   '   val,str\n'+
                   '   1,a\n'+
                   '   3,ewe\n'+
                   '   5,qwea\n'+
                   '   6,eeewe\n'+
                   '#';

    let expr = {
               | #TDS
                  val, str
                  1, a
                  3, ewe
                #->sort([~val->descending()])
                ->unionAll
                (
                  #TDS
                    val, str
                    5, qwea
                    6, eeewe
                  #->sort([~val->ascending()]));
              };

    let res =  $f->eval($expr);
    assertEquals($expected, $res->sort(~val->ascending())->toString());

    let expr2 = {
                | #TDS
                   val, str
                   1, a
                   3, ewe
                 #->sort([~val->descending()])
                 ->unionAll
                 (
                   #TDS
                     val, str
                     5, qwea
                     6, eeewe
                   #);
               };

    let res2 =  $f->eval($expr2);
    assertEquals($expected, $res2->sort(~val->ascending())->toString());

    let expr3 = {
                | #TDS
                   val, str
                   1, a
                   3, ewe
                 #
                 ->unionAll
                 (
                   #TDS
                     val, str
                     5, qwea
                     6, eeewe
                   #->sort([~val->descending()]));
               };

    let res3 =  $f->eval($expr3);
    assertEquals($expected, $res3->sort(~val->ascending())->toString());

    let expr4 = {
                | #TDS
                   val, str
                   1, a
                   3, ewe
                 #->sort([~val->descending()])
                 ->unionAll
                 (
                   #TDS
                     val, str
                     5, qwea
                     6, eeewe
                   #->sort([~val->ascending()]))
                 ->unionAll
                 (
                   #TDS
                     val, str
                     7, zz
                   #->sort([~str->ascending()]));
               };

    let res4 =  $f->eval($expr4);

    assertEquals( '#TDS\n'+
                  '   val,str\n'+
                  '   1,a\n'+
                  '   3,ewe\n'+
                  '   5,qwea\n'+
                  '   6,eeewe\n'+
                  '   7,zz\n'+
                  '#', $res4->sort(~val->ascending())->toString());
}

function <<PCT.test>> meta::pure::functions::relation::tests::unionAll::testSortOfUnionAllOfSortedRelations<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {
               | #TDS
                  val, str
                  3, c
                  1, a
                #->sort([~val->descending()])
                ->unionAll
                (
                  #TDS
                    val, str
                    4, d
                    2, b
                  #->sort([~val->ascending()]))
                ->sort([~val->ascending()]);
              };

    let res =  $f->eval($expr);

    assertEquals( '#TDS\n'+
                  '   val,str\n'+
                  '   1,a\n'+
                  '   2,b\n'+
                  '   3,c\n'+
                  '   4,d\n'+
                  '#', $res->toString());
}

function <<PCT.test>> meta::pure::functions::relation::tests::unionAll::testUnionAllOfSortedLimitedRelations<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {
               | #TDS
                  val, str
                  1, a
                  3, ewe
                  4, qw
                #->sort([~val->ascending()])->limit(2)
                ->unionAll
                (
                  #TDS
                    val, str
                    5, qwea
                    6, eeewe
                  #->sort([~val->descending()])->limit(1));
              };

    let res =  $f->eval($expr);

    assertEquals( '#TDS\n'+
                  '   val,str\n'+
                  '   1,a\n'+
                  '   3,ewe\n'+
                  '   6,eeewe\n'+
                  '#', $res->sort(~val->ascending())->toString());
}

function <<PCT.test>> meta::pure::functions::relation::tests::unionAll::testUnionAllOfDistinctRelation<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {
               | #TDS
                  val, str
                  1, a
                  1, a
                  2, b
                #->distinct()
                ->unionAll
                (
                  #TDS
                    val, str
                    1, a
                    3, c
                  #);
              };

    let res =  $f->eval($expr);

    assertEquals( '#TDS\n'+
                  '   val,str\n'+
                  '   1,a\n'+
                  '   1,a\n'+
                  '   2,b\n'+
                  '   3,c\n'+
                  '#', $res->sort([~val->ascending(), ~str->ascending()])->toString());
}