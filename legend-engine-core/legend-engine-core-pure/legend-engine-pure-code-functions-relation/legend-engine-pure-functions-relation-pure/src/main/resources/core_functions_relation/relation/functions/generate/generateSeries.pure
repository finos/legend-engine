import meta::pure::test::pct::*;
import meta::pure::metamodel::relation::*;
import meta::pure::functions::relation::*;
import meta::pure::functions::relation::variant::*;

'''
Generates a one-column relation holding the integers from `start` to `stop`, both included, counting
by `step`.

The stop is **inclusive**, as in SQL's `generate_series`: `generateSeries(1, 3, 1, ~val)` has the
rows 1, 2 and 3. A negative step counts down, and a step of zero is an error. When the series is
empty — `start > stop` counting up, `start < stop` counting down — the result has no rows.

**Parameters**
- `start` — the first value of the series.
- `stop` — the last value the series may reach.
- `step` — the distance between consecutive values; must not be zero.
- `col` — the name for the single, Integer-typed output column.

**Returns** a relation with that one column and one row per value of the series.

**Examples**
```pure
generateSeries(0, 10, 5, ~val)     // 0, 5, 10
generateSeries(5, 0, -2, ~val)     // 5, 3, 1
generateSeries(3, 2, 1, ~val)      // no rows
```

**See also** `meta::pure::functions::relation::generateSeries(Integer[1], Integer[1], ColSpec[1]):Relation[1]`,
`meta::pure::functions::math::range(Integer[1], Integer[1], Integer[1]):Integer[*]`
'''
function <<PCT.function>> meta::pure::functions::relation::generateSeries<Z>(start:Integer[1], stop:Integer[1], step:Integer[1], col:ColSpec<Z=(?:Integer)>[1]):Relation<Z>[1]
{
  assert($step != 0, | 'generateSeries step must not be 0');
  range($start, $stop + sign($step), $step)->cast(@Integer)->flatten($col);
}

'''
Generates a one-column relation holding the integers from `start` to `stop`, both included.

The same as `generateSeries(start, stop, 1, col)`: the stop is **inclusive**, and the result has no
rows when `start > stop`.

**Parameters**
- `start` — the first value of the series.
- `stop` — the last value of the series.
- `col` — the name for the single, Integer-typed output column.

**Returns** a relation with that one column and one row per value of the series.

**Examples**
```pure
generateSeries(1, 3, ~val)     // 1, 2, 3
```

**See also** `meta::pure::functions::relation::generateSeries(Integer[1], Integer[1], Integer[1], ColSpec[1]):Relation[1]`
'''
function <<PCT.function>> meta::pure::functions::relation::generateSeries<Z>(start:Integer[1], stop:Integer[1], col:ColSpec<Z=(?:Integer)>[1]):Relation<Z>[1]
{
  generateSeries($start, $stop, 1, $col)
}

function <<PCT.test, PCTRelationQualifier.relation>> meta::pure::functions::relation::tests::generateSeries::testGenerateSeries<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
  let res = $f->eval(|generateSeries(1, 3, ~val));
  assertEquals(
    '#TDS\n'+
    '   val\n'+
    '   1\n'+
    '   2\n'+
    '   3\n'+
    '#',
    $res->sort(~val->ascending())->toString()
  );
}

function <<PCT.test, PCTRelationQualifier.relation>> meta::pure::functions::relation::tests::generateSeries::testGenerateSeries_Step<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
  let res = $f->eval(|generateSeries(0, 20, 5, ~val));
  assertEquals(
    '#TDS\n'+
    '   val\n'+
    '   0\n'+
    '   5\n'+
    '   10\n'+
    '   15\n'+
    '   20\n'+
    '#',
    $res->sort(~val->ascending())->toString()
  );
}

function <<PCT.test, PCTRelationQualifier.relation>> meta::pure::functions::relation::tests::generateSeries::testGenerateSeries_NegativeStep<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
  let res = $f->eval(|generateSeries(5, 1, -2, ~val));
  assertEquals(
    '#TDS\n'+
    '   val\n'+
    '   5\n'+
    '   3\n'+
    '   1\n'+
    '#',
    $res->sort(~val->descending())->toString()
  );
}

function <<PCT.test, PCTRelationQualifier.relation>> meta::pure::functions::relation::tests::generateSeries::testGenerateSeries_Empty<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
  let res = $f->eval(|generateSeries(3, 2, ~val)->size());
  assertEquals(0, $res);
}

function <<PCT.test, PCTRelationQualifier.relation>> meta::pure::functions::relation::tests::generateSeries::testGenerateSeries_SingleValue<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
  let res = $f->eval(|generateSeries(3, 3, ~val));
  assertEquals(
    '#TDS\n'+
    '   val\n'+
    '   3\n'+
    '#',
    $res->toString()
  );
}

function <<PCT.test, PCTRelationQualifier.relation>> meta::pure::functions::relation::tests::generateSeries::testGenerateSeries_FilterExtend<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
  let res = $f->eval(|generateSeries(1, 6, ~val)->filter(x | $x.val->toOne()->rem(2) == 0)->extend(~squared: x | $x.val->toOne() * $x.val->toOne()));
  assertEquals(
    '#TDS\n'+
    '   val,squared\n'+
    '   2,4\n'+
    '   4,16\n'+
    '   6,36\n'+
    '#',
    $res->sort(~val->ascending())->toString()
  );
}

function <<PCT.test, PCTRelationQualifier.relation>> meta::pure::functions::relation::tests::generateSeries::testGenerateSeries_ZeroStep<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
  assertError(|$f->eval(|generateSeries(1, 4, 0, ~val)), 'generateSeries step must not be 0');
}
