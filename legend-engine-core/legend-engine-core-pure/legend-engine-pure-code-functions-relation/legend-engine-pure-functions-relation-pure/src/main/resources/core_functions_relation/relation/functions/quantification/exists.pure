import meta::pure::test::pct::*;
import meta::pure::metamodel::relation::*;

function <<PCT.function>>
{
    doc.doc='Returns true if at least one row of the given relation satisfies the given predicate. On relational stores this generates an EXISTS subquery, correlated when the predicate closes over a row of an enclosing relation.'
}
meta::pure::functions::relation::exists<T>(rel:Relation<T>[1], f:Function<{T[1]->Boolean[1]}>[1]):Boolean[1]
{
   $rel->meta::pure::functions::relation::filter($f)->meta::pure::functions::relation::size() > 0
}

function <<PCT.test>> meta::pure::functions::relation::tests::exists::testSimpleExists<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {
                  |#TDS
                     val
                     1
                     3
                     4
                   #->exists(x | $x.val > 3)
               };

    assert($f->eval($expr)->toOne());
}

function <<PCT.test>> meta::pure::functions::relation::tests::exists::testSimpleExists_NoMatch<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {
                  |#TDS
                     val
                     1
                     3
                     4
                   #->exists(x | $x.val > 100)
               };

    assertFalse($f->eval($expr)->toOne());
}

function <<PCT.test>> meta::pure::functions::relation::tests::exists::testExistsCorrelated<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {|
                  let departments = #TDS
                                      departmentId, departmentName
                                      1, Engineering
                                      2, Support
                                      3, Sales
                                    #;
                  let employees = #TDS
                                    employeeId, department
                                    101, 1
                                    102, 1
                                    103, 3
                                  #;
                  $departments->filter(d | $employees->exists(e | $e.department == $d.departmentId));
               };

    let res = $f->eval($expr);

    assertEquals('#TDS\n'+
                 '   departmentId,departmentName\n'+
                 '   1,Engineering\n'+
                 '   3,Sales\n'+
                 '#', $res->sort(~departmentId->ascending())->toString());
}

function <<PCT.test>> meta::pure::functions::relation::tests::exists::testExistsCorrelated_Negated<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {|
                  let departments = #TDS
                                      departmentId, departmentName
                                      1, Engineering
                                      2, Support
                                      3, Sales
                                    #;
                  let employees = #TDS
                                    employeeId, department
                                    101, 1
                                    102, 1
                                    103, 3
                                  #;
                  $departments->filter(d | !$employees->exists(e | $e.department == $d.departmentId));
               };

    let res = $f->eval($expr);

    assertEquals('#TDS\n'+
                 '   departmentId,departmentName\n'+
                 '   2,Support\n'+
                 '#', $res->sort(~departmentId->ascending())->toString());
}

function <<PCT.test>> meta::pure::functions::relation::tests::exists::testExistsCorrelated_ExtraInnerPredicate<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {|
                  let departments = #TDS
                                      departmentId, departmentName
                                      1, Engineering
                                      2, Support
                                      3, Sales
                                    #;
                  let employees = #TDS
                                    employeeId, department, salary
                                    101, 1, 100
                                    102, 1, 900
                                    103, 3, 100
                                  #;
                  $departments->filter(d | $employees->exists(e | ($e.department == $d.departmentId) && ($e.salary > 500)));
               };

    let res = $f->eval($expr);

    assertEquals('#TDS\n'+
                 '   departmentId,departmentName\n'+
                 '   1,Engineering\n'+
                 '#', $res->sort(~departmentId->ascending())->toString());
}

function <<PCT.test>> meta::pure::functions::relation::tests::exists::testExistsOnEmptyRelation<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {|
                  let departments = #TDS
                                      departmentId, departmentName
                                      1, Engineering
                                      2, Support
                                    #;
                  let employees = #TDS
                                    employeeId, department
                                    101, 1
                                  #->filter(e | $e.employeeId > 1000);
                  $departments->filter(d | !$employees->exists(e | $e.department == $d.departmentId));
               };

    let res = $f->eval($expr);

    assertEquals('#TDS\n'+
                 '   departmentId,departmentName\n'+
                 '   1,Engineering\n'+
                 '   2,Support\n'+
                 '#', $res->sort(~departmentId->ascending())->toString());
}

function <<PCT.test>> meta::pure::functions::relation::tests::exists::testExistsUncorrelated<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {|
                  let departments = #TDS
                                      departmentId, departmentName
                                      1, Engineering
                                      2, Support
                                    #;
                  let employees = #TDS
                                    employeeId, department
                                    101, 1
                                  #;
                  $departments->filter(d | $employees->exists(e | $e.employeeId == 101));
               };

    let res = $f->eval($expr);

    assertEquals('#TDS\n'+
                 '   departmentId,departmentName\n'+
                 '   1,Engineering\n'+
                 '   2,Support\n'+
                 '#', $res->sort(~departmentId->ascending())->toString());
}

function <<PCT.test>> meta::pure::functions::relation::tests::exists::testExistsSelfReferencing<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {|
                  let nodes = #TDS
                                id, parentId
                                1, 0
                                2, 1
                                3, 1
                                4, 9
                                5, 5
                              #;
                  $nodes->filter(n | $nodes->exists(p | $p.id == $n.parentId));
               };

    let res = $f->eval($expr);

    // Row 5 is its own parent, so a subquery that lost its correlation degenerates to
    // `p.id == p.parentId` -- true for every outer row, returning all five. That is what
    // distinguishes a lost correlation from a correct self-join here.
    assertEquals('#TDS\n'+
                 '   id,parentId\n'+
                 '   2,1\n'+
                 '   3,1\n'+
                 '   5,5\n'+
                 '#', $res->sort(~id->ascending())->toString());
}

// Three relations nested two subqueries deep, all sharing the column name `id`, so each reference has to
// resolve to its own level: $d.id is two scopes out from where it is written, $e.id one.
function <<PCT.test>> meta::pure::functions::relation::tests::exists::testExistsWithNestedIn<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {|
                  let departments = #TDS
                                      id, name
                                      1, Engineering
                                      2, Support
                                      3, Sales
                                    #;
                  let employees = #TDS
                                    id, deptId
                                    101, 1
                                    102, 2
                                    103, 3
                                  #;
                  let badges = #TDS
                                 id
                                 101
                                 103
                               #;
                  $departments->filter(d | $employees->exists(e | $e.deptId == $d.id && $e.id->in($badges->select(~id))));
               };

    let res = $f->eval($expr);

    assertEquals('#TDS\n'+
                 '   id,name\n'+
                 '   1,Engineering\n'+
                 '   3,Sales\n'+
                 '#', $res->sort(~id->ascending())->toString());
}

// Projected rather than filtered, so the subquery lands in `columns` instead of `filteringOperation`.
function <<PCT.test>> meta::pure::functions::relation::tests::exists::testExistsInExtend<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {|
                  let departments = #TDS
                                      departmentId, departmentName
                                      1, Engineering
                                      2, Support
                                      3, Sales
                                    #;
                  let employees = #TDS
                                    employeeId, department
                                    101, 1
                                    102, 1
                                    103, 3
                                  #;
                  $departments->extend(~hasEmployees : d | $employees->exists(e | $e.department == $d.departmentId));
               };

    let res = $f->eval($expr);

    assertEquals('#TDS\n'+
                 '   departmentId,departmentName,hasEmployees\n'+
                 '   1,Engineering,true\n'+
                 '   2,Support,false\n'+
                 '   3,Sales,true\n'+
                 '#', $res->sort(~departmentId->ascending())->toString());
}

function <<PCT.test>> meta::pure::functions::relation::tests::exists::testExistsOnGroupedRelation<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {|
                  let departments = #TDS
                                      departmentId, departmentName
                                      1, Engineering
                                      2, Support
                                      3, Sales
                                    #;
                  let payroll = #TDS
                                  employeeId, department, salary
                                  101, 1, 900
                                  102, 1, 900
                                  103, 2, 100
                                  104, 3, 100
                                #->groupBy(~department, ~total : x | $x.salary : y | $y->plus());
                  $departments->filter(d | $payroll->exists(p | ($p.department == $d.departmentId) && ($p.total > 500)));
               };

    let res = $f->eval($expr);

    assertEquals('#TDS\n'+
                 '   departmentId,departmentName\n'+
                 '   1,Engineering\n'+
                 '#', $res->sort(~departmentId->ascending())->toString());
}
