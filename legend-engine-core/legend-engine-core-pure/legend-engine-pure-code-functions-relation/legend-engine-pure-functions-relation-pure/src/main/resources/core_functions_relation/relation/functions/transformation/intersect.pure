import meta::pure::test::pct::*;
import meta::pure::metamodel::relation::*;

native function <<PCT.function>> meta::pure::functions::relation::intersect<T>(rel1:Relation<T>[1], rel2:Relation<T>[1]):Relation<T>[1];

function <<PCT.test>> meta::pure::functions::relation::tests::intersect::testSimpleIntersect<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {
               | #TDS
                  val, str
                  1, a
                  2, b
                  3, c
                #
                ->intersect
                (
                  #TDS
                    val, str
                    1, a
                    3, c
                    4, d
                  #);
              };

    let res =  $f->eval($expr);

    assertEquals( '#TDS\n'+
                  '   val,str\n'+
                  '   1,a\n'+
                  '   3,c\n'+
                  '#', $res->sort(~val->ascending())->toString());
}

function <<PCT.test>> meta::pure::functions::relation::tests::intersect::testIntersectRemovesDuplicates<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {
               | #TDS
                  val, str
                  1, a
                  1, a
                  2, b
                  3, c
                #
                ->intersect
                (
                  #TDS
                    val, str
                    1, a
                    1, a
                    1, a
                    3, c
                  #);
              };

    let res =  $f->eval($expr);

    assertEquals( '#TDS\n'+
                  '   val,str\n'+
                  '   1,a\n'+
                  '   3,c\n'+
                  '#', $res->sort([~val->ascending(), ~str->ascending()])->toString());
}

function <<PCT.test>> meta::pure::functions::relation::tests::intersect::testIntersect_MultipleExpressions<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {
               |
                let a = #TDS
                  val, str
                  1, a
                  2, b
                  3, c
                  4, d
                #;
                let b = #TDS
                    val, str
                    1, a
                    2, b
                    3, c
                #;
                let c = #TDS
                    val, str
                    2, b
                    3, c
                #;
                $a->intersect($b)->intersect($c);
              };

    let res =  $f->eval($expr);

    assertEquals( '#TDS\n'+
                  '   val,str\n'+
                  '   2,b\n'+
                  '   3,c\n'+
                  '#', $res->sort([~val->ascending(), ~str->ascending()])->toString());
}
