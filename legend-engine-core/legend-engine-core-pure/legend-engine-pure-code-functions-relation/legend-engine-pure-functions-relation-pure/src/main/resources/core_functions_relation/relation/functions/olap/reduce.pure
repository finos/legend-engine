import meta::pure::test::pct::*;
import meta::pure::metamodel::relation::*;
import meta::pure::functions::relation::*;

'''
Aggregates the rows of a window in two steps: `map` pulls a value out of each row, then `agg`
reduces the values it collected.

This is the general window aggregate — `sum`, `average` and the rest are this function with a
particular `agg`. It is called from inside a window column, where the three arguments `p`, `w` and
`r` handed to the column function are passed straight through:

```pure
$rel->extend(over(~p, ~o->ascending()), ~running:{p,w,r| $p->reduce($w, $r, {r|$r.i}, {y|$y->plus()})})
```

**Which rows take part is decided by the window, not by this function.** With no frame the window
runs from the start of the partition to the current row, making the result a running aggregate;
`rows(UnboundedFrameValue[1], UnboundedFrameValue[1]):Rows[1]` makes it a partition total instead.

`map` may return several values per row, or none — it is `V[*]`, and everything it yields across the
frame is concatenated before `agg` sees it. **The result carries `agg`'s multiplicity**, `U[m]`, so a
reducer returning a collection gives a collection.

**Parameters**
- `rel` — the partition, the first argument of the column function.
- `w` — the window, its second argument.
- `row` — the current row, its third.
- `map` — pulls the value to aggregate out of one row.
- `agg` — reduces the collected values.

**Returns** whatever `agg` returns, with `agg`'s multiplicity.

**Examples**
```pure
// sum of the two rows before this one
$rel->extend(over(~p, ~o->ascending(), rows(-2, -1)), ~prev:{p,w,r| $p->reduce($w, $r, {r|$r.i}, {y|$y->plus()})})
```

**See also** `extend(Relation<T>[1], _Window<T>[1], FuncColSpec<{Relation<T>[1], _Window<T>[1], T[1]->Any[0..1]}, R>[1]):Relation<T+R>[1]`,
`over(ColSpec<(?:NULL)⊆T>[1], SortInfo<(?:NULL)⊆T>[*], Rows[1]):_Window<T>[1]`,
`rows(Integer[1], Integer[1]):Rows[1]`
'''
native function <<PCT.function>>
meta::pure::functions::relation::reduce<T, V, U|m>(
    rel:Relation<T>[1], 
    w:_Window<T>[1], 
    row:T[1],
    map:Function<{T[1]->V[*]}>[1], 
    agg:Function<{V[*]->U[m]}>[1]
):U[m];

function <<PCT.test, PCTRelationQualifier.relation, PCTRelationQualifier.olap>> meta::pure::functions::relation::tests::reduce::testRows_NPreceding_NFollowing<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {
                | #TDS
                  p, o, i
                  0, 1, 10
                  0, 2, 20
                  0, 3, 30
                  100, 1, 10
                  100, 2, 30
                  100, 2, 5
                  100, 3, 11
                  100, 3, 120
                  200, 1, 10000
                  200, 1, 200
                  200, 1, 808080
                  200, 2, 33333
                  200, 3, 0
                  200, 3, 4
                  300, 1, 0
                  300, 2, 0
                #->extend(over(~p, [~o->ascending(), ~i->ascending()], rows(-1, 1)), ~sum_i_Rows:{p,w,r|reduce($p, $w, $r, {r|$r.i}, {y|$y->plus()})})
               };


    let res =  $f->eval($expr);

    assertTdsEquivalent(
        #TDS
            p,o,i,sum_i_Rows
            0,1,10,30
            0,2,20,60
            0,3,30,50
            100,1,10,15
            100,2,5,45
            100,2,30,46
            100,3,11,161
            100,3,120,131
            200,1,200,10200
            200,1,10000,818280
            200,1,808080,851413
            200,2,33333,841413
            200,3,0,33337
            200,3,4,4
            300,1,0,0
            300,2,0,0
        #,
        $res->sort([~p->ascending(), ~o->ascending(), ~i->ascending()]),
        0.00001
    );
}

function <<PCT.test, PCTRelationQualifier.relation, PCTRelationQualifier.olap>> meta::pure::functions::relation::tests::reduce::testRows_UnboundedPreceding_UnboundedFollowing_WithMultiplePartitions_WithoutOrderBy<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {
                | #TDS
                  p, o, i
                  0, 1, 10
                  0, 2, 20
                  0, 3, 30
                  100, 1, 10
                  100, 2, 30
                  100, 2, 5
                  100, 3, 11
                  100, 3, 120
                  200, 1, 10000
                  200, 1, 200
                  200, 1, 808080
                  200, 2, 33333
                  200, 3, 0
                  200, 3, 4
                  300, 1, 0
                  300, 2, 0
                #->extend(over(~[p, o], rows(meta::pure::functions::relation::unbounded(), meta::pure::functions::relation::unbounded())), ~sum_i_Rows:{p,w,r|reduce($p, $w, $r, {r|$r.i}, {y|$y->plus()})})
               };


    let res =  $f->eval($expr);

    assertTdsEquivalent(
        #TDS
            p,o,i,sum_i_Rows
            0,1,10,10
            0,2,20,20
            0,3,30,30
            100,1,10,10
            100,2,5,35
            100,2,30,35
            100,3,11,131
            100,3,120,131
            200,1,200,818280
            200,1,10000,818280
            200,1,808080,818280
            200,2,33333,33333
            200,3,0,4
            200,3,4,4
            300,1,0,0
            300,2,0,0
        #,
        $res->sort([~p->ascending(), ~o->ascending(), ~i->ascending()]),
        0.00001
    );
}

function <<PCT.test, PCTRelationQualifier.relation, PCTRelationQualifier.olap>> meta::pure::functions::relation::tests::reduce::testRows_UnboundedPreceding_CurrentRow_WithMultiplePartitions_WithSingleOrderBy<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {
                | #TDS
                  p, o, i
                  0, 1, 10
                  0, 2, 20
                  0, 3, 30
                  100, 1, 10
                  100, 2, 30
                  100, 2, 5
                  100, 3, 11
                  100, 3, 120
                  200, 1, 10000
                  200, 1, 200
                  200, 1, 808080
                  200, 2, 33333
                  200, 3, 0
                  200, 3, 4
                  300, 1, 0
                  300, 2, 0
                #->extend(over(~[p, o], ~i->ascending(), rows(meta::pure::functions::relation::unbounded(), 0)), ~sum_i_Rows:{p,w,r|reduce($p, $w, $r, {r|$r.i}, {y|$y->plus()})})
               };


    let res =  $f->eval($expr);

    assertTdsEquivalent(
        #TDS
            p,o,i,sum_i_Rows
            0,1,10,10
            0,2,20,20
            0,3,30,30
            100,1,10,10
            100,2,5,5
            100,2,30,35
            100,3,11,11
            100,3,120,131
            200,1,200,200
            200,1,10000,10200
            200,1,808080,818280
            200,2,33333,33333
            200,3,0,0
            200,3,4,4
            300,1,0,0
            300,2,0,0
        #,
        $res->sort([~p->ascending(), ~o->ascending(), ~i->ascending()]),
        0.00001
    );
}

function <<PCT.test, PCTRelationQualifier.relation, PCTRelationQualifier.olap>> meta::pure::functions::relation::tests::reduce::testRange_NPreceding_NFollowing_WithSinglePartition_WithOrderByASC<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {
                | #TDS
                  p, o, i
                  0, 1, 10
                  0, 1, 10
                  0, 3, 30
                  100, 1, 10
                  100, 2, 20
                  100, 2, 20
                  100, 3, 30
                  100, 3, 30
                  200, 1, 10
                  200, 1, 10
                  200, 1, 10
                  200, 2, 20
                  200, 3, 30
                  200, 3, 30
                  300, 1, 10
                  300, 2, 20
                #->extend(over(~p, ~o->ascending(), _range(-1, 1)), ~newCol:{p,w,r|reduce($p, $w, $r, {r|$r.i}, {y|$y->plus()})})
               };


    let res =  $f->eval($expr);

    assertTdsEquivalent(
        #TDS
            p,o,i,newCol
            0,1,10,20
            0,1,10,20
            0,3,30,30
            100,1,10,50
            100,2,20,110
            100,2,20,110
            100,3,30,100
            100,3,30,100
            200,1,10,50
            200,1,10,50
            200,1,10,50
            200,2,20,110
            200,3,30,80
            200,3,30,80
            300,1,10,30
            300,2,20,30
        #,
        $res->sort([~p->ascending(), ~o->ascending(), ~i->ascending()]),
        0.00001
    );
}

function <<PCT.test, PCTRelationQualifier.relation, PCTRelationQualifier.olap>> meta::pure::functions::relation::tests::reduce::testRange_NPreceding_NFollowing_WithSinglePartition_WithOrderByDESC<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {
                | #TDS
                  p, o, i
                  0, 1, 10
                  0, 1, 10
                  0, 3, 30
                  100, 1, 10
                  100, 2, 20
                  100, 2, 20
                  100, 3, 30
                  100, 3, 30
                  200, 1, 10
                  200, 1, 10
                  200, 1, 10
                  200, 2, 20
                  200, 3, 30
                  200, 3, 30
                  300, 1, 10
                  300, 2, 20
                #->extend(over(~p, ~o->descending(), _range(-1, 1)), ~newCol:{p,w,r|reduce($p, $w, $r, {r|$r.i}, {y|$y->plus()})})
               };


    let res =  $f->eval($expr);

    assertTdsEquivalent(
        #TDS
            p,o,i,newCol
            300,2,20,30
            300,1,10,30
            200,3,30,80
            200,3,30,80
            200,2,20,110
            200,1,10,50
            200,1,10,50
            200,1,10,50
            100,3,30,100
            100,3,30,100
            100,2,20,110
            100,2,20,110
            100,1,10,50
            0,3,30,30
            0,1,10,20
            0,1,10,20
        #,
        $res->sort([~p->descending(), ~o->descending(), ~i->descending()]),
        0.00001
    );
}

function <<PCT.test, PCTRelationQualifier.relation, PCTRelationQualifier.olap>> meta::pure::functions::relation::tests::reduce::testRange_ExplicitOffsets_WithNullValues_WithSinglePartition_WithOrderByASC<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {
                | #TDS
                  p, o, i
                  0, 1, 10
                  0, 1, 10
                  0, null, 30
                  100, 1, 10
                  100, 2, 20
                  100, null, 20
                  100, 3, 30
                  100, null, 30
                  200, 1, 10
                  200, 1, 10
                  200, null, 10
                  200, null, 20
                  200, 3, 30
                  200, 3, 30
                  300, 1, 10
                  300, 2, 20
                #->extend(over(~p, ~o->ascending(), _range(-1, 1)), ~newCol:{p,w,r|reduce($p, $w, $r, {r|$r.i}, {y|$y->plus()})})
               };


    let res =  $f->eval($expr);

    assertTdsEquivalent(
        #TDS
            p,o,i,newCol
            0,1,10,20
            0,1,10,20
            0,null,30,30
            100,1,10,30
            100,2,20,60
            100,3,30,50
            100,null,20,50
            100,null,30,50
            200,1,10,20
            200,1,10,20
            200,3,30,60
            200,3,30,60
            200,null,10,30
            200,null,20,30
            300,1,10,30
            300,2,20,30
        #,
        $res->sort([~p->ascending(), ~o->ascending(), ~i->ascending()]),
        0.00001
    );
}

function <<PCT.test, PCTRelationQualifier.relation, PCTRelationQualifier.olap>> meta::pure::functions::relation::tests::reduce::testRangeInterval_NFollowing_NFollowing_WithDifferentDurationUnits_WithSinglePartition_WithOrderByASC<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {
                | #TDS
                  p, o, i
                  0, 2024-01-29T00:32:34.000000000+0000, 10
                  0, 2024-01-29T00:32:34.000000000+0000, 10
                  0, 2024-01-31T00:32:34.000000000+0000, 30
                  100, 2024-01-29T00:32:34.000000000+0000, 10
                  100, 2024-01-30T00:32:34.000000000+0000, 20
                  100, 2024-01-30T00:32:34.000000000+0000, 20
                  100, 2024-01-31T00:32:34.000000000+0000, 30
                  100, 2024-01-31T00:32:34.000000000+0000, 30
                  200, 2024-01-29T00:32:34.000000000+0000, 10
                  200, 2024-01-29T00:32:34.000000000+0000, 10
                  200, 2024-01-29T00:32:34.000000000+0000, 10
                  200, 2024-01-30T00:32:34.000000000+0000, 20
                  200, 2024-01-31T00:32:34.000000000+0000, 30
                  200, 2024-01-31T00:32:34.000000000+0000, 30
                  300, 2024-01-29T00:32:34.000000000+0000, 10
                  300, 2024-01-30T00:32:34.000000000+0000, 20
                #->extend(over(~p, ~o->ascending(), _range(1, DurationUnit.SECONDS, 1, DurationUnit.DAYS)), ~newCol:{p,w,r|reduce($p, $w, $r, {r|$r.i}, {y|$y->plus()})})
               };


    let res =  $f->eval($expr);

    assertTdsEquivalent(
        #TDS
            p,o,i,newCol
            0,2024-01-29T00:32:34.000+0000,10,null
            0,2024-01-29T00:32:34.000+0000,10,null
            0,2024-01-31T00:32:34.000+0000,30,null
            100,2024-01-29T00:32:34.000+0000,10,40
            100,2024-01-30T00:32:34.000+0000,20,60
            100,2024-01-30T00:32:34.000+0000,20,60
            100,2024-01-31T00:32:34.000+0000,30,null
            100,2024-01-31T00:32:34.000+0000,30,null
            200,2024-01-29T00:32:34.000+0000,10,20
            200,2024-01-29T00:32:34.000+0000,10,20
            200,2024-01-29T00:32:34.000+0000,10,20
            200,2024-01-30T00:32:34.000+0000,20,60
            200,2024-01-31T00:32:34.000+0000,30,null
            200,2024-01-31T00:32:34.000+0000,30,null
            300,2024-01-29T00:32:34.000+0000,10,20
            300,2024-01-30T00:32:34.000+0000,20,null
        #,
        $res->sort([~p->ascending(), ~o->ascending(), ~i->ascending()]),
        0.00001
    );
}

