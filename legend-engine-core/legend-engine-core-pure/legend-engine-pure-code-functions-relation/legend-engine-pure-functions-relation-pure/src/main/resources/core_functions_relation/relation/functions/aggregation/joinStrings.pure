import meta::pure::test::pct::*;
import meta::pure::metamodel::relation::*;
import meta::pure::functions::relation::*;

// Nulls in the joined column are skipped rather than rendered, matching LISTAGG/STRING_AGG.
'''
Concatenates a column's values across the rows of a relation.

The relational string aggregate — `LISTAGG` / `STRING_AGG` — reached through `groupBy` or
`aggregate`, where the lambda receives the group as a relation:

```pure
$rel->groupBy(~grp, ~names : g | $g->joinStrings(~name, ','))
```

**The order of the values is not defined.** Rows arrive in whatever order the store produces them, so
a test over this form has to sort the result before comparing. Use
`joinStrings(Relation<T>[1], ColSpec<(?:String)⊆T>[1], String[1], SortInfo<X⊆T>[*]):String[1]` when
the order matters; it emits `WITHIN GROUP (ORDER BY ...)`.

**Absent values are skipped rather than rendered**, matching `LISTAGG` and `STRING_AGG` — a null row
contributes neither text nor a separator.

**Parameters**
- `rel` — the group of rows, supplied by `groupBy` or `aggregate`.
- `col` — the string column to concatenate.
- `separator` — placed between consecutive values.

**Returns** the joined string.

**Examples**
```pure
$rel->groupBy(~grp, ~names : g | $g->joinStrings(~name, ','))
```

**See also** `joinStrings(Relation<T>[1], ColSpec<(?:String)⊆T>[1], String[1], SortInfo<X⊆T>[*]):String[1]`,
`joinStrings(Relation<T>[1], Function<{T[1]->String[1]}>[1], String[1]):String[1]`
'''
function <<PCT.function>>
meta::pure::functions::relation::joinStrings<T>(rel:Relation<T>[1], col:ColSpec<(?:String)⊆T>[1], separator:String[1]):String[1]
{
    $rel->meta::pure::functions::relation::reduce(x|eval($col, $x), y|$y->meta::pure::functions::string::joinStrings($separator));
}

'''
As `joinStrings(Relation<T>[1], ColSpec<(?:String)⊆T>[1], String[1]):String[1]`, but the values are
taken in the order the sort spec gives, which is emitted as `WITHIN GROUP (ORDER BY ...)`.

This is the form to reach for whenever the output is compared or displayed:
`$g->joinStrings(~name, ',', ~id->ascending())` over a group holding `C,A,B` at ids `3,1,2` gives
`A,B,C`. **The sort column need not be the column being joined** — ordering by an id while
concatenating names is the common case.
'''
function <<PCT.function>>
meta::pure::functions::relation::joinStrings<T,X>(rel:Relation<T>[1], col:ColSpec<(?:String)⊆T>[1], separator:String[1], sortInfo:SortInfo<X⊆T>[*]):String[1]
{
    $rel->meta::pure::functions::relation::reduce(x|eval($col, $x), y|$y->meta::pure::functions::string::joinStrings($separator), $sortInfo);
}

'''
As `joinStrings(Relation<T>[1], ColSpec<(?:String)⊆T>[1], String[1]):String[1]`, but each row is
turned into a string by a function rather than read from a single column — so the joined text can
combine columns or be computed, `{r| $r.first + ' ' + $r.last}`. The order is likewise undefined.
'''
function <<PCT.function>>
meta::pure::functions::relation::joinStrings<T>(rel:Relation<T>[1], f:Function<{T[1]->String[1]}>[1], separator:String[1]):String[1]
{
    $rel->meta::pure::functions::relation::reduce($f, y|$y->meta::pure::functions::string::joinStrings($separator));
}

'''
As `joinStrings(Relation<T>[1], Function<{T[1]->String[1]}>[1], String[1]):String[1]`, taking the rows
in the order the sort spec gives, emitted as `WITHIN GROUP (ORDER BY ...)`.
'''
function <<PCT.function>>
meta::pure::functions::relation::joinStrings<T,X>(rel:Relation<T>[1], f:Function<{T[1]->String[1]}>[1], separator:String[1], sortInfo:SortInfo<X⊆T>[*]):String[1]
{
    $rel->meta::pure::functions::relation::reduce($f, y|$y->meta::pure::functions::string::joinStrings($separator), $sortInfo);
}

function <<test.Test>> meta::pure::functions::relation::tests::joinStrings::testJoinStrings_DirectOnRelation():Boolean[1]
{
    let r = #TDS
              id, name
              3, C
              1, A
              2, B
            #;

    assertEquals('A,B,C', $r->joinStrings(~name, ',', ~id->ascending()));
    assertEquals('C,B,A', $r->joinStrings(~name, ',', ~id->descending()));
    assertEquals('A-B-C', $r->joinStrings(~name, '-', ~name->ascending()));
}

function <<test.Test>> meta::pure::functions::relation::tests::joinStrings::testJoinStrings_MultipleSortColumns_DirectOnRelation():Boolean[1]
{
    let r = #TDS
              grp, id, name
              2, 1, D
              1, 1, B
              1, 2, A
              2, 2, C
            #;

    assertEquals('A,B,C,D', $r->joinStrings(~name, ',', [~grp->ascending(), ~id->descending()]));
    assertEquals('C,D,A,B', $r->joinStrings(~name, ',', [~grp->descending(), ~id->descending()]));
}

function <<test.Test>> meta::pure::functions::relation::tests::joinStrings::testJoinStrings_RowFunction():Boolean[1]
{
    let r = #TDS
              id, first, last
              3, Ada, Zed
              1, Bo, Yan
              2, Cy, Xu
            #;

    assertEquals('Bo Yan,Cy Xu,Ada Zed',
                 $r->joinStrings(x|$x.first->toOne() + ' ' + $x.last->toOne(), ',', ~id->ascending()));
    assertEquals('Ada Zed,Cy Xu,Bo Yan',
                 $r->joinStrings(x|$x.first->toOne() + ' ' + $x.last->toOne(), ',', ~id->descending()));
}

function <<PCT.test, PCTRelationQualifier.relation, PCTRelationQualifier.aggregation>> meta::pure::functions::relation::tests::joinStrings::testJoinStrings_GroupBy_Ascending<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {
                |#TDS
                  grp, id, name
                  1, 3, C
                  1, 1, A
                  1, 2, B
                  2, 2, Y
                  2, 1, X
                #->groupBy(~grp, ~names : g | $g->joinStrings(~name, ',', ~id->ascending()))
               };

    let res = $f->eval($expr);

    assertEquals( '#TDS\n'+
                  '   grp,names\n'+
                  '   1,A,B,C\n'+
                  '   2,X,Y\n'+
                  '#', $res->sort(~grp->ascending())->toString());
}

// Filtering on the aggregated column forces the groupBy into a sub-select, where column references get
// rewritten -- this catches the ordering and the aggregate being rewritten inconsistently.
function <<PCT.test, PCTRelationQualifier.relation, PCTRelationQualifier.aggregation>> meta::pure::functions::relation::tests::joinStrings::testJoinStrings_GroupBy_ForcingSubSelect<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {
                |#TDS
                  grp, id, name
                  1, 3, C
                  1, 1, A
                  1, 2, B
                  2, 2, Y
                  2, 1, X
                #->groupBy(~grp, ~names : g | $g->joinStrings(~name, ',', ~id->ascending()))
                 ->filter(r | $r.names == 'A,B,C')
               };

    let res = $f->eval($expr);

    assertEquals( '#TDS\n'+
                  '   grp,names\n'+
                  '   1,A,B,C\n'+
                  '#', $res->toString());
}

function <<PCT.test, PCTRelationQualifier.relation, PCTRelationQualifier.aggregation>> meta::pure::functions::relation::tests::joinStrings::testJoinStrings_GroupBy_Descending<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {
                |#TDS
                  grp, id, name
                  1, 3, C
                  1, 1, A
                  1, 2, B
                  2, 2, Y
                  2, 1, X
                #->groupBy(~grp, ~names : g | $g->joinStrings(~name, ',', ~id->descending()))
               };

    let res = $f->eval($expr);

    assertEquals( '#TDS\n'+
                  '   grp,names\n'+
                  '   1,C,B,A\n'+
                  '   2,Y,X\n'+
                  '#', $res->sort(~grp->ascending())->toString());
}

function <<PCT.test, PCTRelationQualifier.relation, PCTRelationQualifier.aggregation>> meta::pure::functions::relation::tests::joinStrings::testJoinStrings_GroupBy_MultipleSortColumns<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {
                |#TDS
                  grp, major, minor, name
                  1, 1, 2, B
                  1, 2, 1, C
                  1, 1, 1, A
                  1, 2, 2, D
                #->groupBy(~grp, ~names : g | $g->joinStrings(~name, ',', [~major->ascending(), ~minor->descending()]))
               };

    let res = $f->eval($expr);

    assertEquals( '#TDS\n'+
                  '   grp,names\n'+
                  '   1,B,A,D,C\n'+
                  '#', $res->toString());
}

function <<PCT.test, PCTRelationQualifier.relation, PCTRelationQualifier.aggregation>> meta::pure::functions::relation::tests::joinStrings::testJoinStrings_GroupBy_SortColumnNotAggregated<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {
                |#TDS
                  grp, rank, name
                  1, 30, C
                  1, 10, A
                  1, 20, B
                #->groupBy(~grp, ~names : g | $g->joinStrings(~name, '|', ~rank->descending()))
               };

    let res = $f->eval($expr);

    assertEquals( '#TDS\n'+
                  '   grp,names\n'+
                  '   1,C|B|A\n'+
                  '#', $res->toString());
}

function <<PCT.test, PCTRelationQualifier.relation, PCTRelationQualifier.aggregation>> meta::pure::functions::relation::tests::joinStrings::testJoinStrings_GroupBy_Unordered<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {
                |#TDS
                  grp, name
                  1, C
                  1, A
                  1, B
                  2, Y
                  2, X
                #->groupBy(~grp, ~names : g | $g->joinStrings(~name, ''))
               };

    let res = $f->eval($expr);
    let resSorted = $res->extend(~namesSorted : c | $c.names->toOne()->chunk(1)->sort()->meta::pure::functions::string::joinStrings(''));

    assertEquals( '#TDS\n'+
                  '   grp,namesSorted\n'+
                  '   1,ABC\n'+
                  '   2,XY\n'+
                  '#', $resSorted->sort(~grp->ascending())->select(~[grp, namesSorted])->toString());
}

function <<PCT.test, PCTRelationQualifier.relation, PCTRelationQualifier.aggregation>> meta::pure::functions::relation::tests::joinStrings::testJoinStrings_Aggregate_Ascending<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {
                |#TDS
                  id, name
                  3, C
                  1, A
                  2, B
                #->aggregate(~names : g | $g->joinStrings(~name, ',', ~id->ascending()))
               };

    let res = $f->eval($expr);

    assertEquals( '#TDS\n'+
                  '   names\n'+
                  '   A,B,C\n'+
                  '#', $res->toString());
}

function <<PCT.test, PCTRelationQualifier.relation, PCTRelationQualifier.aggregation>> meta::pure::functions::relation::tests::joinStrings::testJoinStrings_Aggregate_EmptyLast<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {
                |#TDS
                  id, name
                  2, B
                  null, N
                  1, A
                  3, C
                #->aggregate(~names : g | $g->joinStrings(~name, ',', ~id->ascending()->emptyLast()))
               };

    let res = $f->eval($expr);

    assertEquals('#TDS\n'+
                 '   names\n'+
                 '   A,B,C,N\n'+
                 '#', $res->toString());
}

function <<PCT.test, PCTRelationQualifier.relation, PCTRelationQualifier.aggregation>> meta::pure::functions::relation::tests::joinStrings::testJoinStrings_GroupBy_EmptyFirst<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {
                |#TDS
                  grp, id, name
                  1, 2, B
                  1, null, N
                  1, 1, A
                  2, 3, C
                #->groupBy(~grp, ~names : g | $g->joinStrings(~name, ',', ~id->ascending()->emptyFirst()))
               };

    let res = $f->eval($expr);

    assertEquals('#TDS\n'+
                 '   grp,names\n'+
                 '   1,N,A,B\n'+
                 '   2,C\n'+
                 '#', $res->sort(~grp->ascending())->toString());
}

function <<PCT.test, PCTRelationQualifier.relation, PCTRelationQualifier.aggregation>> meta::pure::functions::relation::tests::joinStrings::testJoinStrings_GroupBy_RowFunction<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {
                |#TDS
                  grp, id, first, last
                  1, 2, Bo, Yan
                  1, 1, Ada, Zed
                  2, 1, Cy, Xu
                #->groupBy(~grp, ~names : g | $g->joinStrings(x|$x.first->toOne() + ' ' + $x.last->toOne(), ',', ~id->ascending()))
               };

    let res = $f->eval($expr);

    assertEquals( '#TDS\n'+
                  '   grp,names\n'+
                  '   1,Ada Zed,Bo Yan\n'+
                  '   2,Cy Xu\n'+
                  '#', $res->sort(~grp->ascending())->toString());
}
