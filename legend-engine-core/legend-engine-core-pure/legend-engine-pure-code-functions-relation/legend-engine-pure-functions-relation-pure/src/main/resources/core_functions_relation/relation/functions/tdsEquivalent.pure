import meta::pure::functions::variant::convert::*;
import meta::pure::metamodel::variant::*;
import meta::pure::metamodel::relation::*;
import meta::pure::test::pct::*;
import meta::pure::functions::relation::tests::tdsEquivalent::*;

'''
Asserts two relations match, comparing numbers within a tolerance.

For tests whose expected values are computed rather than exact — anything involving division, roots
or accumulated floating point, where a bit-for-bit comparison would fail differently on each target
database. Column count, column names and row count must all agree exactly; only numeric values are
allowed to differ, and only by at most `delta`.

Prefer this to comparing `toString` output whenever the result contains a computed number.

**Parameters**
- `one` — the expected relation.
- `two` — the actual relation.
- `delta` — the tolerance allowed on numeric values.

**Returns** `true` when the relations match; fails otherwise.

**Examples**
```pure
assertTdsEquivalent(#TDS symbol,vwap AAPL,192.71 #, $res, 0.00001)
```

**See also** `assertTdsEquivalent(Relation<Any>[1], Relation<Any>[1], Number[1], Number[1]):Boolean[1]`,
`toString(Relation<T>[1]):String[1]`
'''
function <<PCT.function, PCT.platformOnly>> meta::pure::functions::relation::assertTdsEquivalent(one:Relation<Any>[1], two:Relation<Any>[1], delta:Number[1]):Boolean[1]
{
   meta::pure::functions::relation::assertTdsEquivalent($one, $two, $delta, 0);
}

'''
As `assertTdsEquivalent(Relation<Any>[1], Relation<Any>[1], Number[1]):Boolean[1]`, with a separate
tolerance for date and time values, in seconds. The three-argument form passes 0, requiring
timestamps to match exactly.
'''
function <<PCT.function, PCT.platformOnly>> meta::pure::functions::relation::assertTdsEquivalent(one:Relation<Any>[1], two:Relation<Any>[1], delta:Number[1], timeDeltaInSeconds:Number[1]):Boolean[1]
{
   let oneCol = $one->meta::pure::functions::relation::columns();
   let twoCol = $two->meta::pure::functions::relation::columns();
   $oneCol->size() == $twoCol->size() && $oneCol.name == $twoCol.name && $one->size() == $two->size() &&
   if($oneCol->zip($twoCol)->fold({cols, acc|
          let oneVals = $one->map(x|list($cols.first->eval($x)));
          let twoVals = $two->map(x|list($cols.second->eval($x)));
          $acc && 
          if ([
                pair(|$cols.first.classifierGenericType.typeArguments->at(1).rawType->toOne()->subTypeOf(Number) && $cols.second.classifierGenericType.typeArguments->at(1).rawType->toOne()->subTypeOf(Number),
                    |$oneVals->zip($twoVals)->forAll(a| ($a.first.values->isEmpty() && $a.second.values->isEmpty()) || ((!$a.first.values->isEmpty() && !$a.second.values->isEmpty()) && (abs($a.first.values->toOne()->cast(@Number) - $a.second.values->toOne()->cast(@Number)) <= abs($delta))))),
                pair(|$cols.first.classifierGenericType.typeArguments->at(1).rawType->toOne()->subTypeOf(Date) && $cols.second.classifierGenericType.typeArguments->at(1).rawType->toOne()->subTypeOf(Date),
                    |$oneVals->zip($twoVals)->forAll(a| ($a.first.values->isEmpty() && $a.second.values->isEmpty()) || ((!$a.first.values->isEmpty() && !$a.second.values->isEmpty()) && (abs(dateDiff($a.first.values->toOne()->cast(@Date), $a.second.values->toOne()->cast(@Date), DurationUnit.SECONDS)) <= abs($timeDeltaInSeconds))))),
                pair(|$cols.first.classifierGenericType.typeArguments->at(1).rawType->toOne()->subTypeOf(Variant) && $cols.second.classifierGenericType.typeArguments->at(1).rawType->toOne()->subTypeOf(Variant),
                    |$oneVals->zip($twoVals)->forAll(a| ($a.first.values->isEmpty() && $a.second.values->isEmpty()) || ((!$a.first.values->isEmpty() && !$a.second.values->isEmpty()) && $a.first.values->toOne()->toString() == $a.second.values->toOne()->toString())))
              ],
              |$oneVals->zip($twoVals)->forAll(a| $a.first.values == $a.second.values)
          );
        },
        true
      ),
      | true,
      | fail($one->toString(true)+'\n is not equivalent to:\n'+$two->toString(true))
   );
}

function <<test.Test>> meta::pure::functions::relation::tests::tdsEquivalent::testDifferentNumTypes():Boolean[1]
{
  assertTdsEquivalent(
      #TDS
        val:Number[1]
        1
      #,
      #TDS
        val:Integer[1]
        1
      #,
      0.001
  )
}

function <<test.Test>> meta::pure::functions::relation::tests::tdsEquivalent::testMultiCols():Boolean[1]
{
  assertTdsEquivalent(
      #TDS
        val:Number[1], name:String[1]
        1, ok
        2.0, bla
        #,
      #TDS
        val:Integer[1], name:String[1]
        1, ok
        2, bla
      #,
      0.001
  )
}

function <<test.Test>> meta::pure::functions::relation::tests::tdsEquivalent::testAssertTdsEquivalentWithTimeDelta():Boolean[1]
{
  assertTdsEquivalent(
      #TDS
        name:String[1], ts:Date[1]
        a, 2026-01-07T00:00:00.000+0000
        b, 2026-01-07T00:01:00.000+0000
      #,
      #TDS
        name:String[1], ts:Date[1]
        a, 2026-01-07T00:00:00.001+0000
        b, 2026-01-07T00:01:00.000+0000
      #,
      1,
      0
  )
}

function <<test.Test>> meta::pure::functions::relation::tests::tdsEquivalent::testAssertTdsEquivalentMixedCols():Boolean[1]
{
  assertTdsEquivalent(
      #TDS
        val:Integer[1], name:String[1], ts:Date[1]
        1, a, 2026-01-07T00:00:00.000+0000
        2, b, 2026-01-07T00:01:00.000+0000
      #,
      #TDS
        val:Integer[1], name:String[1], ts:Date[1]
        0, a, 2026-01-07T00:00:00.002+0000
        3, b, 2026-01-07T00:00:59.998+0000
      #,
      2,
      1
  )
}

function meta::pure::functions::relation::tests::tdsEquivalent::assertNotEquivalent(one:Relation<Any>[1], two:Relation<Any>[1], delta:Number[1], timeDeltaInSeconds:Number[1]):Boolean[1]
{
  assertError(|assertTdsEquivalent($one, $two, $delta, $timeDeltaInSeconds), {msg, si | assert($msg->contains(' is not equivalent to:'))})
}

function <<test.Test>> meta::pure::functions::relation::tests::tdsEquivalent::testNumberMismatchBeforeLastRow():Boolean[1]
{
  let expected = #TDS
      id:Integer[1], val:Float[1]
      1, 1.0
      2, 2.0
      3, 3.0
    #;
  assertNotEquivalent($expected, #TDS
      id:Integer[1], val:Float[1]
      1, 9.0
      2, 2.0
      3, 3.0
    #, 0.001, 0);
  assertNotEquivalent($expected, #TDS
      id:Integer[1], val:Float[1]
      1, 1.0
      2, 9.0
      3, 3.0
    #, 0.001, 0);
}

function <<test.Test>> meta::pure::functions::relation::tests::tdsEquivalent::testDateMismatchBeforeLastRow():Boolean[1]
{
  let expected = #TDS
      id:Integer[1], ts:DateTime[1]
      1, 2026-01-07T00:00:00.000+0000
      2, 2026-01-07T00:01:00.000+0000
      3, 2026-01-07T00:02:00.000+0000
    #;
  assertNotEquivalent($expected, #TDS
      id:Integer[1], ts:DateTime[1]
      1, 2026-01-07T01:00:00.000+0000
      2, 2026-01-07T00:01:00.000+0000
      3, 2026-01-07T00:02:00.000+0000
    #, 0, 1);
  assertNotEquivalent($expected, #TDS
      id:Integer[1], ts:DateTime[1]
      1, 2026-01-07T00:00:00.000+0000
      2, 2026-01-07T01:01:00.000+0000
      3, 2026-01-07T00:02:00.000+0000
    #, 0, 1);
}

function <<test.Test>> meta::pure::functions::relation::tests::tdsEquivalent::testVariantMismatchBeforeLastRow():Boolean[1]
{
  let expected = #TDS
      id:Integer[1], s:String[1]
      1, a
      2, b
      3, c
    #->extend(~v:x|$x.s->toVariant())->select(~[id, v]);
  assertNotEquivalent($expected, #TDS
      id:Integer[1], s:String[1]
      1, x
      2, b
      3, c
    #->extend(~v:x|$x.s->toVariant())->select(~[id, v]), 0, 0);
  assertNotEquivalent($expected, #TDS
      id:Integer[1], s:String[1]
      1, a
      2, x
      3, c
    #->extend(~v:x|$x.s->toVariant())->select(~[id, v]), 0, 0);
}

function <<test.Test>> meta::pure::functions::relation::tests::tdsEquivalent::testNullAgainstValue():Boolean[1]
{
  let expected = #TDS
      id:Integer[1], val:Integer[0..1], name:String[0..1]
      1, 1, a
      2, null, null
      3, 3, c
    #;
  assertNotEquivalent($expected, #TDS
      id:Integer[1], val:Integer[0..1], name:String[0..1]
      1, 1, a
      2, 2, null
      3, 3, c
    #, 0, 0);
  assertNotEquivalent($expected, #TDS
      id:Integer[1], val:Integer[0..1], name:String[0..1]
      1, 1, a
      2, null, null
      3, null, c
    #, 0, 0);
  assertNotEquivalent($expected, #TDS
      id:Integer[1], val:Integer[0..1], name:String[0..1]
      1, null, a
      2, 1, null
      3, 3, c
    #, 0, 0);
  assertNotEquivalent($expected, #TDS
      id:Integer[1], val:Integer[0..1], name:String[0..1]
      1, 1, a
      2, null, c
      3, 3, null
    #, 0, 0);
}

function <<test.Test>> meta::pure::functions::relation::tests::tdsEquivalent::testNullsInSameRows():Boolean[1]
{
  assertTdsEquivalent(
      #TDS
        id:Integer[1], val:Integer[0..1], name:String[0..1], ts:DateTime[0..1]
        1, 1, a, 2026-01-07T00:00:00.000+0000
        2, null, null, null
        3, 3, c, 2026-01-07T00:02:00.000+0000
      #,
      #TDS
        id:Integer[1], val:Integer[0..1], name:String[0..1], ts:DateTime[0..1]
        1, 1, a, 2026-01-07T00:00:00.000+0000
        2, null, null, null
        3, 3, c, 2026-01-07T00:02:00.000+0000
      #,
      0,
      0
  )
}
