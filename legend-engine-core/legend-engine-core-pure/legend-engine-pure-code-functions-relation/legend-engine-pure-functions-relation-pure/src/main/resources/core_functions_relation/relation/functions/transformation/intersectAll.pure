import meta::pure::test::pct::*;
import meta::pure::metamodel::relation::*;

'''
Bag intersection of two relations: the rows common to both, preserving multiplicities.

Both relations must have the same type, which the signature enforces. If a row appears `n` times in
`rel1` and `m` times in `rel2`, it appears `min(n, m)` times in the result. Row matching is on the
full tuple. Use `intersect(Relation<T>[1], Relation<T>[1]):Relation<T>[1]` for set semantics.

The result carries no guaranteed row order, so sort afterwards if the order matters.

**Parameters**
- `rel1` — the first relation.
- `rel2` — the second, of the same type.

**Returns** the rows common to both, with multiplicities taken as the minimum of the two sides.

**Examples**
```pure
$leftOrders->intersectAll($rightOrders)
```

**See also** `intersect(Relation<T>[1], Relation<T>[1]):Relation<T>[1]`,
`exceptAll(Relation<T>[1], Relation<T>[1]):Relation<T>[1]`,
`unionAll(Relation<T>[1], Relation<T>[1]):Relation<T>[1]`
'''
native function <<PCT.function>> meta::pure::functions::relation::intersectAll<T>(rel1:Relation<T>[1], rel2:Relation<T>[1]):Relation<T>[1];

function <<PCT.test>> meta::pure::functions::relation::tests::intersectAll::testSimpleIntersectAll<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {
               | #TDS
                  val, str
                  1, a
                  1, a
                  2, b
                  3, c
                #
                ->intersectAll
                (
                  #TDS
                    val, str
                    1, a
                    1, a
                    1, a
                    3, c
                  #);
              };

    let res =  $f->eval($expr);

    assertEquals( '#TDS\n'+
                  '   val,str\n'+
                  '   1,a\n'+
                  '   1,a\n'+
                  '   3,c\n'+
                  '#', $res->sort([~val->ascending(), ~str->ascending()])->toString());
}
