// select outer_customer.id, outer_customer.name from customers as outer_customer
// where outer_customer.countryId in (select inner_regions.countryId from regions as inner_regions
//                                    where inner_regions.managerId = outer_customer.salesRepId)
function <<PCT.test>> meta::pure::functions::relation::tests::in::testIn_CorrelatedSubQuery<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {|
                  let customers = #TDS
                                    id, name, countryId, salesRepId
                                    1, Alice, 10, 100
                                    2, Bob, 20, 200
                                    3, Carol, 30, 100
                                  #;
                  let regions = #TDS
                                  countryId, managerId
                                  10, 100
                                  20, 999
                                  40, 100
                                #;
                  $customers->filter(c | $c.countryId->in($regions->filter(r | $r.managerId == $c.salesRepId)->select(~countryId)))
                            ->select(~[id, name]);
               };

    let res = $f->eval($expr);

    assertEquals('#TDS\n'+
                 '   id,name\n'+
                 '   1,Alice\n'+
                 '#', $res->sort(~id->ascending())->toString());
}

function <<PCT.test>> meta::pure::functions::relation::tests::in::testIn_InExtend_NullValueAndNullInRelation<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {|
                  let departments = #TDS
                                      departmentId, departmentName
                                      1, Engineering
                                      null, Support
                                    #;
                  let employees = #TDS
                                    employeeId, department
                                    101, 1
                                    102, null
                                  #;
                  $departments->extend(~isStaffed : d | $d.departmentId->in($employees->select(~department)))
                              ->select(~[departmentName, isStaffed]);
               };

    let res = $f->eval($expr);

    assertEquals('#TDS\n'+
                 '   departmentName,isStaffed\n'+
                 '   Engineering,true\n'+
                 '   Support,false\n'+
                 '#', $res->sort(~departmentName->ascending())->toString());
}

function <<PCT.test>> meta::pure::functions::relation::tests::in::testIn_InExtend<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {|
                  let departments = #TDS
                                      departmentId, departmentName
                                      1, Engineering
                                      2, Support
                                      3, Sales
                                    #;
                  let employees = #TDS
                                    employeeId, department
                                    101, 1
                                    102, 1
                                    103, 3
                                  #;
                  $departments->extend(~isStaffed : d | $d.departmentId->in($employees->select(~department)));
               };

    let res = $f->eval($expr);

    assertEquals('#TDS\n'+
                 '   departmentId,departmentName,isStaffed\n'+
                 '   1,Engineering,true\n'+
                 '   2,Support,false\n'+
                 '   3,Sales,true\n'+
                 '#', $res->sort(~departmentId->ascending())->toString());
}

// The searched column is a grouping key, so the null has to be excluded through HAVING rather than WHERE.
function <<PCT.test>> meta::pure::functions::relation::tests::in::testIn_GroupedRelationWithNull<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {|
                  let departments = #TDS
                                      departmentId, departmentName
                                      1, Engineering
                                      2, Support
                                      3, Sales
                                    #;
                  let payroll = #TDS
                                  employeeId, department, salary
                                  101, 1, 900
                                  102, 1, 900
                                  103, 2, 100
                                  104, 3, 100
                                  105, null, 900
                                #->groupBy(~department, ~total : x | $x.salary : y | $y->plus())
                                 ->filter(g | $g.total > 500)
                                 ->select(~department);
                  $departments->filter(d | $d.departmentId->in($payroll));
               };

    let res = $f->eval($expr);

    assertEquals('#TDS\n'+
                 '   departmentId,departmentName\n'+
                 '   1,Engineering\n'+
                 '#', $res->sort(~departmentId->ascending())->toString());
}

function <<PCT.test>> meta::pure::functions::relation::tests::in::testIn_DerivedRelation<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {|
                  let departments = #TDS
                                      departmentId, departmentName
                                      1, Engineering
                                      2, Support
                                      3, Sales
                                    #;
                  let payroll = #TDS
                                  employeeId, department, salary
                                  101, 1, 900
                                  102, 2, 100
                                  103, 3, 900
                                #->filter(p | $p.salary > 500)->select(~department);
                  $departments->filter(d | $d.departmentId->in($payroll));
               };

    let res = $f->eval($expr);

    assertEquals('#TDS\n'+
                 '   departmentId,departmentName\n'+
                 '   1,Engineering\n'+
                 '   3,Sales\n'+
                 '#', $res->sort(~departmentId->ascending())->toString());
}
