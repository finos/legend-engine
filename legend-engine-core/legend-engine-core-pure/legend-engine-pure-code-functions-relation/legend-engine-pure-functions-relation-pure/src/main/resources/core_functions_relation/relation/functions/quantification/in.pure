import meta::pure::test::pct::*;
import meta::pure::metamodel::relation::*;
import meta::pure::functions::relation::*;

// An empty value is never in the relation, matching meta::pure::functions::collection::in(Any[0..1], Any[*]).
// This is also SQL's `null in (...)` -> UNKNOWN -> row dropped.
//
// A null *inside* the relation is where this body and SQL part company, and Boolean[1] cannot carry
// the difference: SQL leaves an unmatched row UNKNOWN, so both `in` and `not in` drop it, while this
// returns false and `not in` therefore keeps it. Relational stores emit a real IN and get SQL's
// answer; the in-memory bindings get this one. testIn_Negated_NullInRelation pins the split and is
// excluded on core-compiled and core-interpreted for that reason. Same two-valued logic as
// collection::in -- see the pre-existing where_not_in_list parity failure.
function <<PCT.function, functionType.NormalizeRequiredFunction>>
{
    doc.doc='Returns true if the given value appears in the single column of the given relation. On relational stores this generates an IN (subquery) predicate.'
}
meta::pure::functions::relation::in<U,Z>(value:U[0..1], rel:Relation<Z=(?:U)>[1]):Boolean[1]
{
   let col = $rel->genericType().typeArguments->at(0).rawType->toOne()->cast(@RelationType<Any>).columns->toOne()->cast(@Column<Nil,U|0..1>);
   $value->isNotEmpty() && $rel->meta::pure::functions::relation::exists({row:Z[1] | $col->eval($row) == $value});
}

function <<PCT.test>> meta::pure::functions::relation::tests::in::testSimpleIn<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {|
                  let departments = #TDS
                                      departmentId, departmentName
                                      1, Engineering
                                      2, Support
                                      3, Sales
                                    #;
                  let employees = #TDS
                                    employeeId, department
                                    101, 1
                                    102, 1
                                    103, 3
                                  #;
                  $departments->filter(d | $d.departmentId->in($employees->select(~department)));
               };

    let res = $f->eval($expr);

    assertEquals('#TDS\n'+
                 '   departmentId,departmentName\n'+
                 '   1,Engineering\n'+
                 '   3,Sales\n'+
                 '#', $res->sort(~departmentId->ascending())->toString());
}

function <<PCT.test>> meta::pure::functions::relation::tests::in::testSimpleIn_Negated<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {|
                  let departments = #TDS
                                      departmentId, departmentName
                                      1, Engineering
                                      2, Support
                                      3, Sales
                                    #;
                  let employees = #TDS
                                    employeeId, department
                                    101, 1
                                    102, 1
                                    103, 3
                                  #;
                  $departments->filter(d | !$d.departmentId->in($employees->select(~department)));
               };

    let res = $f->eval($expr);

    assertEquals('#TDS\n'+
                 '   departmentId,departmentName\n'+
                 '   2,Support\n'+
                 '#', $res->sort(~departmentId->ascending())->toString());
}

function <<PCT.test>> meta::pure::functions::relation::tests::in::testIn_String<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {|
                  let departments = #TDS
                                      departmentId, departmentName
                                      1, Engineering
                                      2, Support
                                      3, Sales
                                    #;
                  let active = #TDS
                                 name
                                 Engineering
                                 Sales
                               #;
                  $departments->filter(d | $d.departmentName->in($active->select(~name)));
               };

    let res = $f->eval($expr);

    assertEquals('#TDS\n'+
                 '   departmentId,departmentName\n'+
                 '   1,Engineering\n'+
                 '   3,Sales\n'+
                 '#', $res->sort(~departmentId->ascending())->toString());
}

function <<PCT.test>> meta::pure::functions::relation::tests::in::testIn_EmptyRelation<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {|
                  let departments = #TDS
                                      departmentId, departmentName
                                      1, Engineering
                                      2, Support
                                    #;
                  let employees = #TDS
                                    employeeId, department
                                    101, 1
                                  #->filter(e | $e.employeeId > 1000);
                  $departments->filter(d | $d.departmentId->in($employees->select(~department)));
               };

    let res = $f->eval($expr);

    assertEquals('#TDS\n'+
                 '   departmentId,departmentName\n'+
                 '\n'+
                 '#', $res->sort(~departmentId->ascending())->toString());
}

// A null in the searched column is UNKNOWN in SQL, so the relational stores drop row 3 while the
// Pure body returns false for it. The divergence is recorded per adapter rather than reconciled --
// `in` returns Boolean[1] and cannot carry UNKNOWN.
function <<PCT.test>> meta::pure::functions::relation::tests::in::testIn_NullInRelation<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {|
                  let departments = #TDS
                                      departmentId, departmentName
                                      1, Engineering
                                      2, Support
                                      3, Sales
                                    #;
                  let employees = #TDS
                                    employeeId, department
                                    101, 1
                                    102, null
                                  #;
                  $departments->filter(d | $d.departmentId->in($employees->select(~department)));
               };

    let res = $f->eval($expr);

    assertEquals('#TDS\n'+
                 '   departmentId,departmentName\n'+
                 '   1,Engineering\n'+
                 '#', $res->sort(~departmentId->ascending())->toString());
}

// The negated form is where two-valued and three-valued logic part company: SQL leaves every
// unmatched row UNKNOWN once the searched column holds a null, so `not in` keeps nothing.
function <<PCT.test>> meta::pure::functions::relation::tests::in::testIn_Negated_NullInRelation<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {|
                  let departments = #TDS
                                      departmentId, departmentName
                                      1, Engineering
                                      2, Support
                                    #;
                  let employees = #TDS
                                    employeeId, department
                                    101, 1
                                    102, null
                                  #;
                  $departments->filter(d | !$d.departmentId->in($employees->select(~department)));
               };

    let res = $f->eval($expr);

    assertEquals('#TDS\n'+
                 '   departmentId,departmentName\n'+
                 '\n'+
                 '#', $res->sort(~departmentId->ascending())->toString());
}

// A null on the left is UNKNOWN in SQL and empty in Pure; both drop the row, so this one agrees.
function <<PCT.test>> meta::pure::functions::relation::tests::in::testIn_NullValue<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {|
                  let departments = #TDS
                                      departmentId, departmentName
                                      1, Engineering
                                      null, Support
                                    #;
                  let employees = #TDS
                                    employeeId, department
                                    101, 1
                                  #;
                  $departments->filter(d | $d.departmentId->in($employees->select(~department)));
               };

    let res = $f->eval($expr);

    assertEquals('#TDS\n'+
                 '   departmentId,departmentName\n'+
                 '   1,Engineering\n'+
                 '#', $res->sort(~departmentId->ascending())->toString());
}

// select outer_customer.id, outer_customer.name from customers as outer_customer
// where outer_customer.countryId in (select inner_regions.countryId from regions as inner_regions
//                                    where inner_regions.managerId = outer_customer.salesRepId)
function <<PCT.test>> meta::pure::functions::relation::tests::in::testIn_CorrelatedSubQuery<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {|
                  let customers = #TDS
                                    id, name, countryId, salesRepId
                                    1, Alice, 10, 100
                                    2, Bob, 20, 200
                                    3, Carol, 30, 100
                                  #;
                  let regions = #TDS
                                  countryId, managerId
                                  10, 100
                                  20, 999
                                  40, 100
                                #;
                  $customers->filter(c | $c.countryId->in($regions->filter(r | $r.managerId == $c.salesRepId)->select(~countryId)))
                            ->select(~[id, name]);
               };

    let res = $f->eval($expr);

    assertEquals('#TDS\n'+
                 '   id,name\n'+
                 '   1,Alice\n'+
                 '#', $res->sort(~id->ascending())->toString());
}

// Projected rather than filtered, so the subquery lands in `columns` instead of `filteringOperation`.
function <<PCT.test>> meta::pure::functions::relation::tests::in::testIn_InExtend<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {|
                  let departments = #TDS
                                      departmentId, departmentName
                                      1, Engineering
                                      2, Support
                                      3, Sales
                                    #;
                  let employees = #TDS
                                    employeeId, department
                                    101, 1
                                    102, 1
                                    103, 3
                                  #;
                  $departments->extend(~isStaffed : d | $d.departmentId->in($employees->select(~department)));
               };

    let res = $f->eval($expr);

    assertEquals('#TDS\n'+
                 '   departmentId,departmentName,isStaffed\n'+
                 '   1,Engineering,true\n'+
                 '   2,Support,false\n'+
                 '   3,Sales,true\n'+
                 '#', $res->sort(~departmentId->ascending())->toString());
}

function <<PCT.test>> meta::pure::functions::relation::tests::in::testIn_DerivedRelation<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {|
                  let departments = #TDS
                                      departmentId, departmentName
                                      1, Engineering
                                      2, Support
                                      3, Sales
                                    #;
                  let payroll = #TDS
                                  employeeId, department, salary
                                  101, 1, 900
                                  102, 2, 100
                                  103, 3, 900
                                #->filter(p | $p.salary > 500)->select(~department);
                  $departments->filter(d | $d.departmentId->in($payroll));
               };

    let res = $f->eval($expr);

    assertEquals('#TDS\n'+
                 '   departmentId,departmentName\n'+
                 '   1,Engineering\n'+
                 '   3,Sales\n'+
                 '#', $res->sort(~departmentId->ascending())->toString());
}
