import meta::pure::metamodel::relation::*;
import meta::pure::functions::relation::*;

// Relational stores never execute these bodies; they intercept reduce by function id, so every aggregate
// written on top of it is pushed down without needing its own processor.
//
// Two arities rather than one with an empty sort list: with no sort spec there is nothing to infer the sort
// spec's own type parameter from.
function meta::pure::functions::relation::reduce<T, V, U|m>(
    rel:Relation<T>[1],
    map:Function<{T[1]->V[*]}>[1],
    agg:Function<{V[*]->U[m]}>[1]
):U[m]
{
    $agg->eval($rel->meta::pure::functions::relation::map($map));
}

function meta::pure::functions::relation::reduce<T, V, U, X|m>(
    rel:Relation<T>[1],
    map:Function<{T[1]->V[*]}>[1],
    agg:Function<{V[*]->U[m]}>[1],
    sortInfo:SortInfo<X⊆T>[*]
):U[m]
{
    // sort rejects an empty spec.
    $agg->eval(if($sortInfo->isEmpty(), | $rel, | $rel->sort($sortInfo))->meta::pure::functions::relation::map($map));
}
