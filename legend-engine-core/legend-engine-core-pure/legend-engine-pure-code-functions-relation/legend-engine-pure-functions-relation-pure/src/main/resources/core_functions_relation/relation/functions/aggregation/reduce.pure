import meta::pure::metamodel::relation::*;
import meta::pure::functions::relation::*;

// The aggregation primitive the relation-scoped aggregate functions are built on -- the groupBy sibling of
// the OLAP reduce in ../olap/reduce.pure, which the windowed forms of average/stdDevPopulation/zScore use the
// same way. Callers are expected to be those named aggregates rather than user code: they name their columns
// as ColSpecs and so get the subset check, where the raw map/reduce pair here does not.
//
// No enclosing window has pre-sorted the rows, so this sorts the relation itself. That ordering is what SQL
// spells WITHIN GROUP (ORDER BY ...); an empty sort spec leaves the row order unconstrained.
//
// Relational stores never execute this body -- they intercept the named aggregate by function id, the way
// percentile is already handled. It is reachable only on the in-memory bindings, which is also why it carries
// no PCT.function stereotype: relation::map below is platform-only.
function meta::pure::functions::relation::reduce<T, V, U, X|m>(
    rel:Relation<T>[1],
    map:Function<{T[1]->V[*]}>[1],
    agg:Function<{V[*]->U[m]}>[1],
    sortInfo:SortInfo<X⊆T>[*]
):U[m]
{
    $agg->eval($rel->sort($sortInfo)->meta::pure::functions::relation::map($map));
}
