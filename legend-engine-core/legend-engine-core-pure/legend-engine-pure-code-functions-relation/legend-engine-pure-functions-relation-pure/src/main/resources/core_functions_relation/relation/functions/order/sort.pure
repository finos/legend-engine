import meta::pure::test::pct::*;
import meta::pure::metamodel::relation::*;

native function <<PCT.function>> meta::pure::functions::relation::sort<X,T>(rel:Relation<T>[1], sortInfo:SortInfo<X⊆T>[*]):Relation<T>[1];


function <<PCT.test>> meta::pure::functions::relation::tests::sort::testSimpleSortShared<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
  let expr = {
              | #TDS
                  id, name
                  2, George
                  3, Pierre
                  1, Sachin
                  1, Neema
                  5, David
                  4, Alex
                  2, Thierry
                #->sort(ascending(~id));
            };

  let res =  $f->eval($expr);

  assertEquals([1,1,2,2,3,4,5], $res->map(x|$x.id));

  let expr2 = {
              | #TDS
                  id, name
                  2, George
                  3, Pierre
                  1, Sachin
                  1, Neema
                  5, David
                  4, Alex
                  2, Thierry
                #->sort([ascending(~id), ascending(~name)]);
            };

  let res2 =  $f->eval($expr2);

  assertEquals( '#TDS\n'+
                '   id,name\n'+
                '   1,Neema\n'+
                '   1,Sachin\n'+
                '   2,George\n'+
                '   2,Thierry\n'+
                '   3,Pierre\n'+
                '   4,Alex\n'+
                '   5,David\n'+
                '#', $res2->toString());

  let expr3 = {
              | #TDS
                  id, name
                  2, George
                  3, Pierre
                  1, Sachin
                  1, Neema
                  5, David
                  4, Alex
                  2, Thierry
                #->sort([descending(~id), ascending(~name)]);
            };

  let res3 =  $f->eval($expr3);

  assertEquals( '#TDS\n'+
                '   id,name\n'+
                '   5,David\n'+
                '   4,Alex\n'+
                '   3,Pierre\n'+
                '   2,George\n'+
                '   2,Thierry\n'+
                '   1,Neema\n'+
                '   1,Sachin\n'+
                '#', $res3->toString());
}

function <<PCT.test>> meta::pure::functions::relation::tests::sort::testSortNullsLast<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
  let res = $f->eval({|
              #TDS
                id, name
                2, George
                null, Pierre
                1, Sachin
                null, Neema
                3, David
              #->sort([~id->ascending()->nullsLast(), ~name->ascending()]);
            });

  assertEquals('#TDS\n'+
               '   id,name\n'+
               '   1,Sachin\n'+
               '   2,George\n'+
               '   3,David\n'+
               '   null,Neema\n'+
               '   null,Pierre\n'+
               '#', $res->toString());
}

function <<PCT.test>> meta::pure::functions::relation::tests::sort::testSortNullsFirst<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
  let res = $f->eval({|
              #TDS
                id, name
                2, George
                null, Pierre
                1, Sachin
                3, David
              #->sort([~id->ascending()->nullsFirst(), ~name->ascending()]);
            });

  assertEquals('#TDS\n'+
               '   id,name\n'+
               '   null,Pierre\n'+
               '   1,Sachin\n'+
               '   2,George\n'+
               '   3,David\n'+
               '#', $res->toString());
}

function <<PCT.test>> meta::pure::functions::relation::tests::sort::testSortNullsFirstTwoArg<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
  let res = $f->eval({|
              #TDS
                id, name
                2, George
                null, Pierre
                1, Sachin
              #->sort(~id->ascending(meta::pure::functions::relation::NullOrder.FIRST));
            });

  assertEquals('#TDS\n'+
               '   id,name\n'+
               '   null,Pierre\n'+
               '   1,Sachin\n'+
               '   2,George\n'+
               '#', $res->toString());
}

function <<PCT.test>> meta::pure::functions::relation::tests::sort::testSortNullsLastTwoArg<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
  let res = $f->eval({|
              #TDS
                id, name
                2, George
                null, Pierre
                1, Sachin
              #->sort(~id->ascending(meta::pure::functions::relation::NullOrder.LAST));
            });

  assertEquals('#TDS\n'+
               '   id,name\n'+
               '   1,Sachin\n'+
               '   2,George\n'+
               '   null,Pierre\n'+
               '#', $res->toString());
}

function <<PCT.test>> meta::pure::functions::relation::tests::sort::testSortCanonicalNullOrdering<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
  // unspecified => canonical (nulls sort high): NULLS LAST on ascending
  let res = $f->eval({|
              #TDS
                id, name
                2, George
                null, Pierre
                1, Sachin
              #->sort(~id->ascending());
            });

  assertEquals('#TDS\n'+
               '   id,name\n'+
               '   1,Sachin\n'+
               '   2,George\n'+
               '   null,Pierre\n'+
               '#', $res->toString());
}

function <<PCT.test>> meta::pure::functions::relation::tests::sort::testSortMultipleColumnsMixedNullOrder<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
  // Two sort keys with opposite null orderings:
  //   grp asc NULLS LAST   -> nulls in grp go to the bottom of the result
  //   id  desc NULLS FIRST -> within each grp partition, null id comes first, then descending non-null ids
  let res = $f->eval({|
              #TDS
                grp, id
                A,   2
                A,   null
                A,   1
                null, 5
                B,   null
                B,   3
                null, null
              #->sort([~grp->ascending()->nullsLast(), ~id->descending()->nullsFirst()]);
            });

  assertEquals('#TDS\n'+
               '   grp,id\n'+
               '   A,null\n'+
               '   A,2\n'+
               '   A,1\n'+
               '   B,null\n'+
               '   B,3\n'+
               '   null,null\n'+
               '   null,5\n'+
               '#', $res->toString());
}

function <<PCT.test>> meta::pure::functions::relation::tests::sort::testSimpleSort_MultipleExpressions<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
  let expr = {| 
                let t = #TDS
                  id, name
                  2, George
                  3, Pierre
                  1, Sachin
                  1, Neema
                  5, David
                  4, Alex
                  2, Thierry
                #;
                
                $t->sort(ascending(~id));
            };

  let res =  $f->eval($expr);

  assertEquals([1,1,2,2,3,4,5], $res->map(x|$x.id));

  let expr2 = {| 
                let t = #TDS
                  id, name
                  2, George
                  3, Pierre
                  1, Sachin
                  1, Neema
                  5, David
                  4, Alex
                  2, Thierry
                #;
                
                $t->sort([ascending(~id), ascending(~name)]);
            };

  let res2 =  $f->eval($expr2);

  assertEquals( '#TDS\n'+
                '   id,name\n'+
                '   1,Neema\n'+
                '   1,Sachin\n'+
                '   2,George\n'+
                '   2,Thierry\n'+
                '   3,Pierre\n'+
                '   4,Alex\n'+
                '   5,David\n'+
                '#', $res2->toString());

  let expr3 = {| 
                let t = #TDS
                  id, name
                  2, George
                  3, Pierre
                  1, Sachin
                  1, Neema
                  5, David
                  4, Alex
                  2, Thierry
                #;
                
                $t->sort([descending(~id), ascending(~name)]);
            };

  let res3 =  $f->eval($expr3);

  assertEquals( '#TDS\n'+
                '   id,name\n'+
                '   5,David\n'+
                '   4,Alex\n'+
                '   3,Pierre\n'+
                '   2,George\n'+
                '   2,Thierry\n'+
                '   1,Neema\n'+
                '   1,Sachin\n'+
                '#', $res3->toString());
}