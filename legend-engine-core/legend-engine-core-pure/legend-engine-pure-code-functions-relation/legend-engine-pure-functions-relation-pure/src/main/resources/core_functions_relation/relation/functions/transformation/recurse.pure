import meta::pure::test::pct::*;
import meta::pure::metamodel::relation::*;

'''
Evaluates a function against a relation over and over, collecting every row it produces, until it
produces none.

Each round evaluates `recurse` on the rows the round before it returned, starting from `initial`.
The result is `initial` concatenated with the rows of every round. **Nothing else bounds the recursion** — the
function has to narrow towards an empty result, as the depth test below does with `filter`, or it
never terminates.

**The step has to return the initial relation's columns, in the same order and with the same types**:
the schema is fixed by `initial`, exactly as a recursive CTE's anchor fixes its own. Returning other
columns is a compile error. Types include multiplicity, and that is the easy one to trip over — a
column computed from a literal is `[1]` where one read from a nullable column is `[0..1]`, so declare
the source's type (`title:String[1]`) when the two have to line up.

On a relational store this becomes a `WITH RECURSIVE` common table expression.

**Parameters**
- `initial` — the rows the recursion starts from.
- `recurse` — given the previous round's rows, the next round's; return no rows to stop.

**Returns** `initial` followed by the rows of every round, carrying `initial`'s columns.

**Examples**
```pure
// each round carries the pair forward one step, and stops at depth 10
$tds->recurse(x | $x->filter(r | ($r.depth->toOne() + 1) < 10)
                    ->project(~[depth: r | $r.depth->toOne() + 1,
                                number: r | $r.nextNumber,
                                nextNumber: r | $r.nextNumber->toOne() + $r.number->toOne()]))

// walking an org chart down from the president, one management level per round
$initial->recurse(x | $x->join($employees, JoinKind.INNER, {e, m | $e.employeeId == $m.managerId})
                        ->project(~[title: r | $r.eTitle, employeeId: r | $r.eId,
                                    managerId: r | $r.mId, managerTitle: r | $r.title]))
```

**See also** `concatenate(Relation<T>[1], Relation<T>[1]):Relation<T>[1]`,
`filter(Relation<T>[1], Function<{T[1]->Boolean[1]}>[1]):Relation<T>[1]`,
`join(Relation<T>[1], Relation<V>[1], JoinKind[1], Function<{T[1],V[1]->Boolean[1]}>[1]):Relation<T+V>[1]`
'''
function
    <<PCT.function>>
meta::pure::functions::relation::recurse<T>(
  initial:Relation<T>[1], 
  recurse:Function<{Relation<T>[1]->Relation<T>[1]}>[1]
):Relation<T>[1]
{
  let result = $recurse->eval($initial);
  if ($result->size() == 0,
    | $initial,
    | $initial->concatenate($result->recurse($recurse))
  );
}

function <<PCT.test>> meta::pure::functions::relation::tests::recurse::testFibonacci<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
  let tds = #TDS
              depth, number, nextNumber
              0, 0, 1
            #;

  let expr = {|$tds->recurse(x | 
                                  $x->filter(r | ($r.depth->toOne() + 1) < 10) // avoid infinite loop
                                    ->project(~[
                                        depth: r | $r.depth->toOne() + 1, 
                                        number: r | $r.nextNumber, 
                                        nextNumber: r | $r.nextNumber->toOne() + $r.number->toOne()
                                      ])
                             )};
  let res =  $f->eval($expr);

  assertEquals( '#TDS\n'+
                '   depth,number,nextNumber\n'+
                '   0,0,1\n'+
                '   1,1,1\n'+
                '   2,1,2\n'+
                '   3,2,3\n'+
                '   4,3,5\n'+
                '   5,5,8\n'+
                '   6,8,13\n' + 
                '   7,13,21\n'+
                '   8,21,34\n'+
                '   9,34,55\n'+
                '#', $res->sort([~depth->ascending(),~number->ascending()])->toString());
}

function <<PCT.test>> meta::pure::functions::relation::tests::recurse::testOrgHierarchy_multiStatement<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
  let tds = #TDS
              title:String[1], employeeId, managerId
              President, 1, null
              Vice President Engineering, 10, 1
              Programmer, 100, 10
              QA Engineer, 101, 10
              Vice President HR, 20, 1
              Recruitment Analyst, 200, 20
            #;

  let expr = {|
                let initial = $tds->filter(r | $r.title == 'President')
                                  ->extend(~managerTitle:x|'N/A');

                $initial->recurse(x |
                                    $x->join(
                                        $tds->project(~[
                                                eTitle: r | $r.title,
                                                eId: r | $r.employeeId,
                                                mId: r | $r.managerId
                                        ]),
                                        JoinKind.INNER,
                                        {x,y| $x.employeeId == $y.mId}
                                    )
                                    ->project(~[
                                        title: r | $r.eTitle,
                                        employeeId: r | $r.eId,
                                        managerId: r | $r.mId,
                                        managerTitle: r | $r.title
                                      ])
                             );
             };

  let res =  $f->eval($expr);

  assertEquals( '#TDS\n'+
                '   title,employeeId,managerId,managerTitle\n'+
                '   President,1,null,N/A\n'+
                '   Vice President Engineering,10,1,President\n'+
                '   Vice President HR,20,1,President\n'+
                '   Programmer,100,10,Vice President Engineering\n'+
                '   QA Engineer,101,10,Vice President Engineering\n'+
                '   Recruitment Analyst,200,20,Vice President HR\n'+
                '#', $res->sort([~employeeId->ascending()])->toString());
}