import meta::pure::test::pct::*;

'''
Replaces what a regular expression matches, either the first occurrence or all of them.

`replaceAll` chooses between the two, and there is no default — pass `false` to rewrite only the
first match. An empty `replacement` deletes the matched text rather than substituting for it.

Matching is case sensitive, and `.` does not cross a newline; pass
`regexpReplace(String[1], String[1], String[1], Boolean[1], RegexpParameter[1..*]):String[1]` to
change either. Unlike `meta::pure::functions::string::replace(String[1], String[1], String[1]):String[1]`,
which matches literally, the pattern here is full POSIX ERE (Extended Regular Expression) syntax.

**Parameters**
- `string` — the string to rewrite.
- `regexp` — the POSIX ERE pattern to match.
- `replacement` — the text to substitute, or `''` to delete.
- `replaceAll` — `true` to rewrite every occurrence, `false` for only the first.

**Returns** the rewritten string.

**Examples**
```pure
'abc'->regexpReplace('(b|c)', 'X', false)   // 'aXc', only the first match
'abc'->regexpReplace('(b|c)', 'X', true)    // 'aXX', every match
```

**See also** `regexpReplace(String[1], String[1], String[1], Boolean[1], RegexpParameter[1..*]):String[1]`,
`regexpExtract(String[1], String[1], Boolean[1]):String[*]`,
`meta::pure::functions::string::replace(String[1], String[1], String[1]):String[1]`
'''
function <<PCT.function>>
  meta::pure::functions::string::regexpReplace(string:String[1], regexp:String[1], replacement:String[1], replaceAll:Boolean[1]):String[1]
{
  $string->regexpReplace($regexp, $replacement, $replaceAll, [RegexpParameter.CASE_SENSITIVE]);
}

'''
As `regexpReplace(String[1], String[1], String[1], Boolean[1]):String[1]`, with the matching options
given explicitly rather than left at the `CASE_SENSITIVE` default. The options are those described on
`regexpLike(String[1], String[1], RegexpParameter[1..*]):Boolean[1]`.
'''
native function <<PCT.function>>
  meta::pure::functions::string::regexpReplace(string:String[1], regexp:String[1], replacement:String[1], replaceAll:Boolean[1], regexpParameters:RegexpParameter[1..*]):String[1];

function <<PCT.test>> meta::pure::functions::string::tests::regexpReplace::testregexpReplace<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
  assertEquals('aXc', $f->eval(|'abc'->regexpReplace('(b|c)', 'X', false)));
}

function <<PCT.test>> meta::pure::functions::string::tests::regexpReplace::testregexpReplaceAll<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
  assertEquals('aXX', $f->eval(|'abc'->regexpReplace('(b|c)', 'X', true)));
}
