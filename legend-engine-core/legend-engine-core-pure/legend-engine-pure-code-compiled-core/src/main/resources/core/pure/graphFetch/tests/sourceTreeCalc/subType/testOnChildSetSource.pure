import meta::pure::graphFetch::*;
import meta::pure::graphFetch::tests::sourceTreeCalc::withSubType::childSet::*;

// ==========================================================================
//  A child set's own source is cast to a subtype of the parent's property
// ==========================================================================

Class meta::pure::graphFetch::tests::sourceTreeCalc::withSubType::childSet::Extra
{
  value : Float[0..1];
}

Class meta::pure::graphFetch::tests::sourceTreeCalc::withSubType::childSet::Base
{
  id : String[1];
}

Class meta::pure::graphFetch::tests::sourceTreeCalc::withSubType::childSet::Sub extends Base
{
  extra : Extra[0..1];
}

Class meta::pure::graphFetch::tests::sourceTreeCalc::withSubType::childSet::Root
{
  items : Base[*];
}

Class meta::pure::graphFetch::tests::sourceTreeCalc::withSubType::childSet::Box
{
  item : Base[1];
}

Class meta::pure::graphFetch::tests::sourceTreeCalc::withSubType::childSet::Row
{
  id       : String[1];
  subValue : Float[0..1];
}

Class meta::pure::graphFetch::tests::sourceTreeCalc::withSubType::childSet::Detail
{
  rows : Row[*];
}

function meta::pure::graphFetch::tests::sourceTreeCalc::withSubType::childSet::boxes(e:Root[1]):Box[*]
{
  $e.items->map(item | ^Box(item = $item));
}

function meta::pure::graphFetch::tests::sourceTreeCalc::withSubType::childSet::expectedSourceTree():String[1]
{
  'Root\n' +
  '(\n' +
  '  items\n' +
  '  (\n' +
  '    id\n' +
  '  )\n' +
  '  items->subType(Sub)\n' +
  '  (\n' +
  '    extra\n' +
  '    (\n' +
  '      value\n' +
  '    )\n' +
  '    id\n' +
  '  )\n' +
  ')'
}

function <<meta::pure::profiles::test.Test>> meta::pure::graphFetch::tests::sourceTreeCalc::withSubType::childSet::testCastOnChildSetSource():Boolean[1]
{
  let tree       = #{Detail {rows {id, subValue}}}#;
  let sourceTree = calculateSourceTree($tree, meta::pure::graphFetch::tests::sourceTreeCalc::withSubType::childSet::DirectMapping, meta::pure::extension::defaultExtensions());
  assertEquals(expectedSourceTree(), $sourceTree->sortTree()->treeToString());
}

function <<meta::pure::profiles::test.Test>> meta::pure::graphFetch::tests::sourceTreeCalc::withSubType::childSet::testCastOnChildSetSourceThroughIntermediate():Boolean[1]
{
  let tree       = #{Detail {rows {id, subValue}}}#;
  let sourceTree = calculateSourceTree($tree, meta::pure::graphFetch::tests::sourceTreeCalc::withSubType::childSet::IntermediateMapping, meta::pure::extension::defaultExtensions());
  assertEquals(expectedSourceTree(), $sourceTree->sortTree()->treeToString());
}

###Mapping
import meta::pure::graphFetch::tests::sourceTreeCalc::withSubType::childSet::*;

Mapping meta::pure::graphFetch::tests::sourceTreeCalc::withSubType::childSet::DirectMapping
(
  *Row: Pure
  {
    ~src Base
    id       : $src.id,
    subValue : $src->cast(@Sub).extra.value
  }

  *Detail: Pure
  {
    ~src Root
    rows : $src.items
  }
)

Mapping meta::pure::graphFetch::tests::sourceTreeCalc::withSubType::childSet::IntermediateMapping
(
  *Row: Pure
  {
    ~src Box
    id       : $src.item.id,
    subValue : $src.item->cast(@Sub).extra.value
  }

  *Detail: Pure
  {
    ~src Root
    rows : $src->boxes()
  }
)
