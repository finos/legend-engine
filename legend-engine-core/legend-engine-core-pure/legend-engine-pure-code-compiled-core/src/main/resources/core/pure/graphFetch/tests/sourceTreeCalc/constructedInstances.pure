###Pure
import meta::pure::graphFetch::*;
import meta::pure::graphFetch::tests::sourceTreeCalc::constructed::*;

Class meta::pure::graphFetch::tests::sourceTreeCalc::constructed::SrcRoot
{
  x : String[1];
  next : SrcRoot[0..1];
}

Class meta::pure::graphFetch::tests::sourceTreeCalc::constructed::Foreign
{
  y : String[1];
}

Class meta::pure::graphFetch::tests::sourceTreeCalc::constructed::Wrap
{
  foreign : Foreign[1];
}

Class meta::pure::graphFetch::tests::sourceTreeCalc::constructed::Holder
{
  src : SrcRoot[1];
}

Class meta::pure::graphFetch::tests::sourceTreeCalc::constructed::Tgt
{
  z : String[1];
}

Class meta::pure::graphFetch::tests::sourceTreeCalc::constructed::TgtWithChild
{
  child : TgtChild[0..1];
}

Class meta::pure::graphFetch::tests::sourceTreeCalc::constructed::TgtChild
{
  name : String[1];
}

Class meta::pure::graphFetch::tests::sourceTreeCalc::constructed::MLeg
{
  value : String[1];
}

Class meta::pure::graphFetch::tests::sourceTreeCalc::constructed::MItem
{
  id : String[1];
}

Class meta::pure::graphFetch::tests::sourceTreeCalc::constructed::MA extends MItem
{
  aLegs : MLeg[*];
}

Class meta::pure::graphFetch::tests::sourceTreeCalc::constructed::MB extends MItem
{
  bLegs : MLeg[*];
}

Class meta::pure::graphFetch::tests::sourceTreeCalc::constructed::MSrc
{
  items : MItem[*];
}

Class meta::pure::graphFetch::tests::sourceTreeCalc::constructed::MBox
{
  common : MItem[1];
  aLeg : MLeg[0..1];
  bLeg : MLeg[0..1];
}

Class meta::pure::graphFetch::tests::sourceTreeCalc::constructed::MRow
{
  id : String[1];
  leg : String[0..1];
}

Class meta::pure::graphFetch::tests::sourceTreeCalc::constructed::MOut
{
  rows : MRow[*];
}

function meta::pure::lineage::scanProperties::test::constructedSourceTree::mBoxes(s:MSrc[1]):MBox[*]
{
  $s.items->map(i | $i->match([
     a:MA[1] | $a.aLegs->map(l | ^MBox(common=$a, aLeg=$l)),
     b:MB[1] | $b.bLegs->map(l | ^MBox(common=$b, bLeg=$l))
  ]))
}

function meta::pure::lineage::scanProperties::test::constructedSourceTree::wrap(s:SrcRoot[1]):Wrap[1]
{
  ^Wrap(foreign=^Foreign(y=$s.x))
}

function meta::pure::lineage::scanProperties::test::constructedSourceTree::hold(s:SrcRoot[1]):Holder[1]
{
  ^Holder(src=$s)
}

function <<test.Test>> meta::pure::graphFetch::tests::sourceTreeCalc::constructed::testReadThroughInstanceBuiltInCalledFunction():Boolean[1]
{
  let actual = calculateSourceTree(#{Tgt {z}}#, functionWrapMapping, meta::pure::extension::defaultExtensions());
  assertEquals(#{SrcRoot {x}}#->sortTree()->treeToString(), $actual->sortTree()->treeToString());
}

function <<test.Test>> meta::pure::graphFetch::tests::sourceTreeCalc::constructed::testReadThroughInstanceBuiltInTransform():Boolean[1]
{
  let actual = calculateSourceTree(#{Tgt {z}}#, inlineWrapMapping, meta::pure::extension::defaultExtensions());
  assertEquals(#{SrcRoot {x}}#->sortTree()->treeToString(), $actual->sortTree()->treeToString());
}

function <<test.Test>> meta::pure::graphFetch::tests::sourceTreeCalc::constructed::testReadThroughHeldSourceNavigatesFromOwner():Boolean[1]
{
  let actual = calculateSourceTree(#{Tgt {z}}#, holderMapping, meta::pure::extension::defaultExtensions());
  assertEquals(#{SrcRoot {next {x}}}#->sortTree()->treeToString(), $actual->sortTree()->treeToString());
}

function <<test.Test>> meta::pure::graphFetch::tests::sourceTreeCalc::constructed::testReadOfRebuiltSourceInstanceFetchesOnlyAssignedSource():Boolean[1]
{
  let actual = calculateSourceTree(#{Tgt {z}}#, rebuiltSourceMapping, meta::pure::extension::defaultExtensions());
  assertEquals(#{SrcRoot {next {x}}}#->sortTree()->treeToString(), $actual->sortTree()->treeToString());
}

function <<test.Test>> meta::pure::graphFetch::tests::sourceTreeCalc::constructed::testChildSourcedFromConditionalKeepsNavigatedBranch():Boolean[1]
{
  let actual = calculateSourceTree(#{TgtWithChild {child {name}}}#, conditionalChildMapping, meta::pure::extension::defaultExtensions());
  assertEquals(#{SrcRoot {x, next {x}}}#->sortTree()->treeToString(), $actual->sortTree()->treeToString());
}

function <<test.Test>> meta::pure::graphFetch::tests::sourceTreeCalc::constructed::testChildSourcedFromMatchSeesEveryArmsSlot():Boolean[1]
{
  let actual = calculateSourceTree(#{MOut {rows {id, leg}}}#, matchArmMapping, meta::pure::extension::defaultExtensions());
  // `id` repeats under each subType branch: mergePropertiesFromBaseSubTreeToSubTypedSubTree copies it there.
  let expected = #{
    MSrc {
      items {
        id
      },
      items->subType(@MA) {
        aLegs {
          value
        },
        id
      },
      items->subType(@MB) {
        bLegs {
          value
        },
        id
      }
    }
  }#;
  assertEquals($expected->sortTree()->treeToString(), $actual->sortTree()->treeToString());
}

###Mapping
import meta::pure::graphFetch::tests::sourceTreeCalc::constructed::*;
import meta::pure::lineage::scanProperties::test::constructedSourceTree::*;

Mapping meta::pure::graphFetch::tests::sourceTreeCalc::constructed::functionWrapMapping
(
  *Tgt: Pure
  {
    ~src SrcRoot
    z: $src->wrap().foreign.y
  }
)

Mapping meta::pure::graphFetch::tests::sourceTreeCalc::constructed::inlineWrapMapping
(
  *Tgt: Pure
  {
    ~src SrcRoot
    z: ^Wrap(foreign=^Foreign(y=$src.x)).foreign.y
  }
)

Mapping meta::pure::graphFetch::tests::sourceTreeCalc::constructed::holderMapping
(
  *Tgt: Pure
  {
    ~src SrcRoot
    z: $src->hold().src.next.x->toOne()
  }
)

Mapping meta::pure::graphFetch::tests::sourceTreeCalc::constructed::rebuiltSourceMapping
(
  *Tgt: Pure
  {
    ~src SrcRoot
    z: ^SrcRoot(x=$src.next.x->toOne()).x
  }
)

Mapping meta::pure::graphFetch::tests::sourceTreeCalc::constructed::conditionalChildMapping
(
  *TgtWithChild: Pure
  {
    ~src SrcRoot
    child[c]: if($src.x == 'k', |^SrcRoot(x='lit'), |$src.next)->toOne()
  }

  TgtChild[c]: Pure
  {
    ~src SrcRoot
    name: $src.x
  }
)

Mapping meta::pure::graphFetch::tests::sourceTreeCalc::constructed::matchArmMapping
(
  *MOut: Pure
  {
    ~src MSrc
    rows[mA]: $src->mBoxes(),
    rows[mB]: $src->mBoxes()
  }

  *MRow: Operation
  {
    meta::pure::router::operations::union_OperationSetImplementation_1__SetImplementation_MANY_(mA, mB)
  }

  MRow[mA]: Pure
  {
    ~src MBox
    id: $src.common.id,
    leg: $src.aLeg.value
  }

  MRow[mB]: Pure
  {
    ~src MBox
    id: $src.common.id,
    leg: $src.bLeg.value
  }
)
