import meta::pure::metamodel::serialization::grammar::*;
import meta::pure::metamodel::serialization::grammar::tests::*;

Enum meta::pure::metamodel::serialization::grammar::tests::testNew::MyEnum
{
  Val,
  Other
}

Class meta::pure::metamodel::serialization::grammar::tests::testNew::TestClass
{
  a : String[1];
  b : Boolean[1];
  c : Integer[1];
  d : Float[1];
  e : Date[1];
  f : meta::pure::metamodel::serialization::grammar::tests::testNew::MyEnum[1];
  g : Decimal[1];
}

function <<test.Test>> meta::pure::metamodel::serialization::grammar::tests::testNew::simple():Boolean[1]
{
  let val = ^meta::pure::metamodel::serialization::grammar::tests::testNew::TestClass(a = 'ok', b = true, c = 1, d = 1.0, e=%2015-04-15T17:09:21.398, f = meta::pure::metamodel::serialization::grammar::tests::testNew::MyEnum.Other, g = 10D);
  assertEquals('^meta::pure::metamodel::serialization::grammar::tests::testNew::TestClass(a=\'ok\',b=true,c=1,d=1.0,e=%2015-04-15T17:09:21.398+0000,f=meta::pure::metamodel::serialization::grammar::tests::testNew::MyEnum.Other,g=10D)', $val->printNew());
  true;
}

 
//these tests the correct fullPath serialization, In Legend Compiler it wrongly gets set so we handle this here until fixed.
function <<test.Test>> meta::pure::metamodel::serialization::grammar::tests::testFunctionDefinition():Boolean[1]
{
  let func = meta::pure::metamodel::serialization::grammar::tests::testFunction__String_1_;

  meta::pure::metamodel::serialization::grammar::tests::functionTest(meta::pure::metamodel::serialization::grammar::tests::testFunction__String_1_, 'meta::pure::metamodel::serialization::grammar::tests::testFunction(): String[1]\n{\n  \'abc\'\n}', true);
  meta::pure::metamodel::serialization::grammar::tests::functionTest(meta::pure::metamodel::serialization::grammar::tests::testFunction__String_1_, 'testFunction(): String[1]\n{\n  \'abc\'\n}', false);
}

function <<test.Test>> meta::pure::metamodel::serialization::grammar::tests::testAndVariations():Boolean[1]
{
  functionTest(testAnd__Boolean_1_, 'meta::pure::metamodel::serialization::grammar::tests::testAnd(): Boolean[1]\n{\n  let x = false && true;\n  let y = false && true;\n  $x && $y && false;\n  and([$x, $y, false]->meta::pure::functions::collection::map(x: Boolean[1]|$x->meta::pure::functions::boolean::not()));\n}', true);
}

function <<test.Test>> meta::pure::metamodel::serialization::grammar::tests::testFunctionNameReference():Boolean[1] 
{
  let lambda = {| meta::pure::metamodel::serialization::grammar::tests::testFunction()};
  let func = meta::pure::metamodel::serialization::grammar::tests::testFunction__String_1_;

  meta::pure::metamodel::serialization::grammar::tests::expressionTest(
    $lambda,
    $func,
    '|meta::pure::metamodel::serialization::grammar::tests::testFunction()',
    true
  );

  meta::pure::metamodel::serialization::grammar::tests::expressionTest(
    $lambda,
    $func,
    '|testFunction()',
    false
  );  
}

function <<test.Test>> meta::pure::metamodel::serialization::grammar::tests::testFunctionNameReferenceParameters():Boolean[1] 
{
  let lambda = {| meta::pure::metamodel::serialization::grammar::tests::testFunctionWithParams('a')};
  let func = meta::pure::metamodel::serialization::grammar::tests::testFunctionWithParams_String_1__String_1_;

  meta::pure::metamodel::serialization::grammar::tests::expressionTest(
    $lambda,
    $func,
    '|\'a\'->meta::pure::metamodel::serialization::grammar::tests::testFunctionWithParams()',
    true
  );

  meta::pure::metamodel::serialization::grammar::tests::expressionTest(
    $lambda,
    $func,
    '|\'a\'->testFunctionWithParams()',
    false
  );  
}

function meta::pure::metamodel::serialization::grammar::tests::functionTest(func:ConcreteFunctionDefinition<Any>[1], expected:String[1], fullPath:Boolean[1]):Boolean[1]
{
  let config = ^Configuration(fullPath = $fullPath);

  assertEquals('###Pure\nfunction ' + $expected, printPackageableElements($func, $config));
  assertEquals('###Pure\nfunction ' + $expected, printPackageableElements(^$func(functionName = $func.package->toOne()->elementToPath() + '::' + $func.functionName->toOne()), $config));

  assertEquals($expected, printFunctionDefinition($func, $config, ^GContext(space='')));
  assertEquals($expected, printFunctionDefinition(^$func(functionName = $func.package->toOne()->elementToPath() + '::' + $func.functionName->toOne()), $config, ^GContext(space='')));  
}

function meta::pure::metamodel::serialization::grammar::tests::expressionTest(lambda:LambdaFunction<Any>[1], func:ConcreteFunctionDefinition<Any>[1], expected:String[1], fullPath:Boolean[1]):Boolean[1]
{
  let config = ^Configuration(fullPath = $fullPath);

  let exp = $lambda.expressionSequence->at(0)->cast(@SimpleFunctionExpression);

  assertEquals($expected, printFunctionDefinition($lambda, $config, ^GContext(space='')));
  assertEquals($expected, printFunctionDefinition(^$lambda(expressionSequence = ^$exp(func = ^$func(functionName = $func.package->toOne()->elementToPath() + '::' + $func.functionName->toOne()))), $config, ^GContext(space='')));
}

function meta::pure::metamodel::serialization::grammar::tests::testFunction():String[1]
{
  'abc';
}

function meta::pure::metamodel::serialization::grammar::tests::testFunctionWithParams(a:String[1]):String[1]
{
  'abc';
}

function meta::pure::metamodel::serialization::grammar::tests::testAnd():Boolean[1]
{
  let x = false && true;
  let y = false->and(true);
  [$x, $y, false]->and();
  [$x, $y, false]->map(x|!$x)->and();
}

Class meta::pure::metamodel::serialization::grammar::tests::graphFetch::GFPerson
{
  firstName : String[1];
  lastName  : String[1];
}

Class meta::pure::metamodel::serialization::grammar::tests::graphFetch::GFEmployee extends meta::pure::metamodel::serialization::grammar::tests::graphFetch::GFPerson
{
  employeeId : String[1];
}

function <<access.private>> meta::pure::metamodel::serialization::grammar::tests::graphFetch::propertyByName(class:meta::pure::metamodel::type::Class<Any>[1], name:String[1]):AbstractProperty<Any>[1]
{
  $class.properties->filter(p | $p.name == $name)->toOne();
}

function <<test.Test>> meta::pure::metamodel::serialization::grammar::tests::graphFetch::testPrintRootGraphFetchTree_simple():Boolean[1]
{
  let tree = ^meta::pure::graphFetch::RootGraphFetchTree<Any>(
    class    = meta::pure::metamodel::serialization::grammar::tests::graphFetch::GFPerson,
    subTrees = [
      ^meta::pure::graphFetch::PropertyGraphFetchTree(property = meta::pure::metamodel::serialization::grammar::tests::graphFetch::propertyByName(meta::pure::metamodel::serialization::grammar::tests::graphFetch::GFPerson, 'firstName')),
      ^meta::pure::graphFetch::PropertyGraphFetchTree(property = meta::pure::metamodel::serialization::grammar::tests::graphFetch::propertyByName(meta::pure::metamodel::serialization::grammar::tests::graphFetch::GFPerson, 'lastName'))
    ]
  );
  assertEquals(
    '#{meta::pure::metamodel::serialization::grammar::tests::graphFetch::GFPerson{firstName,lastName}}#',
    printRootGraphFetchTree($tree, [], ^GContext(space=''))
  );
}

function <<test.Test>> meta::pure::metamodel::serialization::grammar::tests::graphFetch::testPrintRootGraphFetchTree_empty():Boolean[1]
{
  // An empty root tree still emits `{}` (matches Java Alloy composer behaviour).
  let tree = ^meta::pure::graphFetch::RootGraphFetchTree<Any>(
    class = meta::pure::metamodel::serialization::grammar::tests::graphFetch::GFPerson
  );
  assertEquals(
    '#{meta::pure::metamodel::serialization::grammar::tests::graphFetch::GFPerson{}}#',
    printRootGraphFetchTree($tree, [], ^GContext(space=''))
  );
}

function <<test.Test>> meta::pure::metamodel::serialization::grammar::tests::graphFetch::testPrintPropertyGraphFetchTree_withAlias():Boolean[1]
{
  let tree = ^meta::pure::graphFetch::PropertyGraphFetchTree(
    property = meta::pure::metamodel::serialization::grammar::tests::graphFetch::propertyByName(meta::pure::metamodel::serialization::grammar::tests::graphFetch::GFPerson, 'firstName'),
    alias    = 'given'
  );
  assertEquals(
    '\'given\':firstName',
    printPropertyGraphFetchTree($tree, [], ^GContext(space=''))
  );
}

function <<test.Test>> meta::pure::metamodel::serialization::grammar::tests::graphFetch::testPrintPropertyGraphFetchTree_withSubType():Boolean[1]
{
  let tree = ^meta::pure::graphFetch::PropertyGraphFetchTree(
    property = meta::pure::metamodel::serialization::grammar::tests::graphFetch::propertyByName(meta::pure::metamodel::serialization::grammar::tests::graphFetch::GFPerson, 'firstName'),
    subType  = meta::pure::metamodel::serialization::grammar::tests::graphFetch::GFEmployee
  );
  assertEquals(
    'firstName->subType(@meta::pure::metamodel::serialization::grammar::tests::graphFetch::GFEmployee)',
    printPropertyGraphFetchTree($tree, [], ^GContext(space=''))
  );
}

function <<test.Test>> meta::pure::metamodel::serialization::grammar::tests::graphFetch::testPrintSubTypeGraphFetchTree():Boolean[1]
{
  let tree = ^meta::pure::graphFetch::SubTypeGraphFetchTree(
    subTypeClass = meta::pure::metamodel::serialization::grammar::tests::graphFetch::GFEmployee,
    subTrees     = [
      ^meta::pure::graphFetch::PropertyGraphFetchTree(property = meta::pure::metamodel::serialization::grammar::tests::graphFetch::propertyByName(meta::pure::metamodel::serialization::grammar::tests::graphFetch::GFEmployee, 'employeeId'))
    ]
  );
  assertEquals(
    '->subType(@meta::pure::metamodel::serialization::grammar::tests::graphFetch::GFEmployee){employeeId}',
    printSubTypeGraphFetchTree($tree, [], ^GContext(space=''))
  );
}

function <<test.Test>> meta::pure::metamodel::serialization::grammar::tests::graphFetch::testPrintRootGraphFetchTree_withSubTypeTrees():Boolean[1]
{
  let tree = ^meta::pure::graphFetch::RootGraphFetchTree<Any>(
    class    = meta::pure::metamodel::serialization::grammar::tests::graphFetch::GFPerson,
    subTrees = [^meta::pure::graphFetch::PropertyGraphFetchTree(property = meta::pure::metamodel::serialization::grammar::tests::graphFetch::propertyByName(meta::pure::metamodel::serialization::grammar::tests::graphFetch::GFPerson, 'firstName'))],
    subTypeTrees = [^meta::pure::graphFetch::SubTypeGraphFetchTree(
      subTypeClass = meta::pure::metamodel::serialization::grammar::tests::graphFetch::GFEmployee,
      subTrees     = [^meta::pure::graphFetch::PropertyGraphFetchTree(property = meta::pure::metamodel::serialization::grammar::tests::graphFetch::propertyByName(meta::pure::metamodel::serialization::grammar::tests::graphFetch::GFEmployee, 'employeeId'))]
    )]
  );
  assertEquals(
    '#{meta::pure::metamodel::serialization::grammar::tests::graphFetch::GFPerson{firstName,->subType(@meta::pure::metamodel::serialization::grammar::tests::graphFetch::GFEmployee){employeeId}}}#',
    printRootGraphFetchTree($tree, [], ^GContext(space=''))
  );
}
