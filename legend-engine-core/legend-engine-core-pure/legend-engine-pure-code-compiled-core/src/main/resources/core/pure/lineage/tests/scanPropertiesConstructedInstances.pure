import meta::pure::lineage::scanProperties::*;
import meta::pure::lineage::scanProperties::test::constructed::*;

Class meta::pure::lineage::scanProperties::test::constructed::Data
{
  a : String[1];
  b : String[1];
  child : Data[0..1];
  tags : String[*];
}

Class meta::pure::lineage::scanProperties::test::constructed::Inner
{
  x : String[1];
}

Class meta::pure::lineage::scanProperties::test::constructed::Opt
{
  x : String[0..1];
}

Class meta::pure::lineage::scanProperties::test::constructed::Sub1 extends Data
{
  one : String[1];
}

Class meta::pure::lineage::scanProperties::test::constructed::Sub2 extends Data
{
  two : String[1];
}

Class meta::pure::lineage::scanProperties::test::constructed::Box
{
  a : String[1];
  b : String[0..1];
  c : String[0..1];
  inner : Inner[0..1];
  data : Data[0..1];
  aTwice() { $this.a + $this.a } : String[1];
  heldData() { $this.data } : Data[0..1];
}

Class meta::pure::lineage::scanProperties::test::constructed::OtherBox
{
  a : String[1];
}

function meta::pure::lineage::scanProperties::test::constructed::resolvingConfig():ScanConfig[1]
{
  ^ScanConfig(scanClasses=false, explodeMilestonedProperties=true, resolveConstructedInstances=true);
}

function meta::pure::lineage::scanProperties::test::constructed::scanResolving(f:FunctionDefinition<Any>[1]):ScanPropertiesState[1]
{
  $f.expressionSequence->at(0)->evaluateAndDeactivate()->scanProperties(resolvingConfig())->toOne();
}

function <<meta::pure::profiles::test.Test>> meta::pure::lineage::scanProperties::test::constructed::testKeyExpressionSourcesAreRecordedAndInstanceIsReturned():Boolean[1]
{
  let res = scanResolving({data:Data[*] | $data->map(d | ^Box(a=$d.a))});
  assertEquals('Data->a', $res.result->printPropertyNodeLists());
  assert($res.current.values->toOne()->instanceOf(ConstructedInstancePathNode));
}

function <<meta::pure::profiles::test.Test>> meta::pure::lineage::scanProperties::test::constructed::testReadingAssignedPropertyResolvesToItsSource():Boolean[1]
{
  let res = scanResolving({data:Data[*] | $data->map(d | ^Box(a=$d.a))->map(b | $b.a)});
  assertEquals('Data->a', $res.result->printPropertyNodeLists());
  assertEquals('Data->a', $res.current->printPropertyNodeLists());
}

function <<meta::pure::profiles::test.Test>> meta::pure::lineage::scanProperties::test::constructed::testNestedConstructionResolvesThroughEachLevel():Boolean[1]
{
  let res = scanResolving({d:Data[1] | ^Box(a='k', inner=^Inner(x=$d.b)).inner.x});
  assertEquals('Data->b', $res.result->printPropertyNodeLists());
  assertEquals('Data->b', $res.current->printPropertyNodeLists());
}

function <<meta::pure::profiles::test.Test>> meta::pure::lineage::scanProperties::test::constructed::testLetBoundInstanceResolves():Boolean[1]
{
  let res = scanResolving({data:Data[*] | $data->map(d | let box = ^Box(a=$d.a); $box.a;)});
  assertEquals('Data->a', $res.result->printPropertyNodeLists());
  assertEquals('Data->a', $res.current->printPropertyNodeLists());
}

function <<meta::pure::profiles::test.Test>> meta::pure::lineage::scanProperties::test::constructed::testAssignedObjectIsNavigatedFurther():Boolean[1]
{
  let res = scanResolving({d:Data[1] | ^Box(a='k', data=$d.child).data.a});
  assertEquals('Data->child\nData->child, Data->a', $res.result->printPropertyNodeLists());
  assertEquals('Data->child, Data->a', $res.current->printPropertyNodeLists());
}

function <<meta::pure::profiles::test.Test>> meta::pure::lineage::scanProperties::test::constructed::testUnassignedPropertyKeepsClassRootedPath():Boolean[1]
{
  let res = scanResolving({d:Data[1] | ^Box(a=$d.a).b});
  assertEquals('Box->b\nData->a', $res.result->printPropertyNodeLists());
  assertEquals('Box->b', $res.current->printPropertyNodeLists());
}

function <<meta::pure::profiles::test.Test>> meta::pure::lineage::scanProperties::test::constructed::testInstanceWithoutKeysKeepsClassRootedPath():Boolean[1]
{
  let res = scanResolving({| ^Opt().x});
  assertEquals('Opt->x', $res.result->printPropertyNodeLists());
  assertEquals('Opt->x', $res.current->printPropertyNodeLists());
}

function <<meta::pure::profiles::test.Test>> meta::pure::lineage::scanProperties::test::constructed::testCopyOverrideResolvesToNewValue():Boolean[1]
{
  let res = scanResolving({d:Data[1] | $d.child->map(c | ^$c(a=$d.b).a)});
  assertEquals('Data->b\nData->child', $res.result->printPropertyNodeLists());
  assertEquals('Data->b', $res.current->printPropertyNodeLists());
}

function <<meta::pure::profiles::test.Test>> meta::pure::lineage::scanProperties::test::constructed::testCopyUnassignedPropertyResolvesThroughCopiedObject():Boolean[1]
{
  let res = scanResolving({d:Data[1] | $d.child->map(c | ^$c(a='k').b)});
  assertEquals('Data->child\nData->child, Data->b', $res.result->printPropertyNodeLists());
  assertEquals('Data->child, Data->b', $res.current->printPropertyNodeLists());
}

function <<meta::pure::profiles::test.Test>> meta::pure::lineage::scanProperties::test::constructed::testReadAfterConditionalConstructionRecordsBothSources():Boolean[1]
{
  let res = scanResolving({d:Data[1] | if($d.a == 'x', |^Box(a=$d.a), |^Box(a=$d.b)).a});
  assertEquals('Data->a\nData->b', $res.result->printPropertyNodeLists());
}

function <<meta::pure::profiles::test.Test>> meta::pure::lineage::scanProperties::test::constructed::testReadAcrossCollectionOfConstructedInstancesRecordsBothSources():Boolean[1]
{
  let res = scanResolving({d:Data[1] | [^Box(a=$d.a), ^Box(a=$d.b)]->map(b | $b.a)});
  assertEquals('Data->a\nData->b', $res.result->printPropertyNodeLists());
}

function <<meta::pure::profiles::test.Test>> meta::pure::lineage::scanProperties::test::constructed::testConditionalTerminalsReturnConstructedInstances():Boolean[1]
{
  let config = ^ScanConfig(scanClasses=false, explodeMilestonedProperties=true, captureConditionalTerminals=true, resolveConstructedInstances=true);
  let res = {d:Data[1] | if($d.a == 'x', |^Box(a=$d.a), |^Box(a=$d.b))}.expressionSequence->at(0)->evaluateAndDeactivate()->scanProperties($config)->toOne();
  assert($res.conditionalTerminalPaths->isNotEmpty());
  assert($res.conditionalTerminalPaths.paths->forAll(p | $p.values->toOne()->instanceOf(ConstructedInstancePathNode)));
  assert($res.current.values->toOne()->instanceOf(ConstructedInstancePathNode));
}

function <<meta::pure::profiles::test.Test>> meta::pure::lineage::scanProperties::test::constructed::testDefaultConfigLeavesConstructedInstancesUnresolved():Boolean[1]
{
  let res = {data:Data[*] | $data->map(d | ^Box(a=$d.a))->map(b | $b.a)}.expressionSequence->at(0)->evaluateAndDeactivate()->scanProperties()->toOne();
  assertEquals('Box->a\nData->a', $res.result->printPropertyNodeLists());
  assertEquals('Box->a', $res.current->printPropertyNodeLists());
}

function meta::pure::lineage::scanProperties::test::constructed::wrapData(d:Data[1]):Box[1]
{
  ^Box(a=$d.a, data=$d)
}

function meta::pure::lineage::scanProperties::test::constructed::readA(b:Box[1]):String[1]
{
  $b.a
}

function <<meta::pure::profiles::test.Test>> meta::pure::lineage::scanProperties::test::constructed::testInstanceBuiltInCalledFunctionResolvesAgainstArgument():Boolean[1]
{
  let res = scanResolving({d:Data[1] | $d.child->toOne()->wrapData().data.b});
  assertEquals('Data->child\nData->child, Data->a\nData->child, Data->b', $res.result->printPropertyNodeLists());
  assertEquals('Data->child, Data->b', $res.current->printPropertyNodeLists());
}

function <<meta::pure::profiles::test.Test>> meta::pure::lineage::scanProperties::test::constructed::testCachedFunctionResolvesAgainstEachCallSite():Boolean[1]
{
  let res = scanResolving({data:Data[*] | $data->map(d | let first = $d->wrapData().a; $d.child->toOne()->wrapData().a;)});
  assertEquals('Data->a\nData->child\nData->child, Data->a', $res.result->printPropertyNodeLists());
  assertEquals('Data->child, Data->a', $res.current->printPropertyNodeLists());
}

function <<meta::pure::profiles::test.Test>> meta::pure::lineage::scanProperties::test::constructed::testPropertyReadInCalledFunctionResolvesThroughArgument():Boolean[1]
{
  let res = scanResolving({d:Data[1] | ^Box(a=$d.a)->readA()});
  assertEquals('Data->a', $res.result->printPropertyNodeLists());
  assertEquals('Data->a', $res.current->printPropertyNodeLists());
}

function meta::pure::lineage::scanProperties::test::constructed::aTwiceOf(b:Box[1]):String[1]
{
  $b.aTwice()
}

function <<meta::pure::profiles::test.Test>> meta::pure::lineage::scanProperties::test::constructed::testQualifierOnConstructedInstanceIsInlined():Boolean[1]
{
  let res = scanResolving({d:Data[1] | ^Box(a=$d.a).aTwice()});
  assertEquals('Data->a', $res.result->printPropertyNodeLists());
  assertEquals('', $res.current->printPropertyNodeLists());
}

function <<meta::pure::profiles::test.Test>> meta::pure::lineage::scanProperties::test::constructed::testQualifierReturningAssignedObjectResolves():Boolean[1]
{
  let res = scanResolving({d:Data[1] | ^Box(a='k', data=$d.child).heldData().b});
  assertEquals('Data->child\nData->child, Data->b', $res.result->printPropertyNodeLists());
  assertEquals('Data->child, Data->b', $res.current->printPropertyNodeLists());
}

function <<meta::pure::profiles::test.Test>> meta::pure::lineage::scanProperties::test::constructed::testQualifierInCalledFunctionOnConstructedArgumentFallsBackToClassRootedNode():Boolean[1]
{
  let res = scanResolving({d:Data[1] | ^Box(a=$d.a)->aTwiceOf()});
  assertEquals('Box->aTwice\nData->a', $res.result->printPropertyNodeLists());
}


function <<meta::pure::profiles::test.Test>> meta::pure::lineage::scanProperties::test::constructed::testConditionalPrefersSourcePathOverConstructedInstance():Boolean[1]
{
  let res = scanResolving({d:Data[1] | if($d.a == 'x', |^Data(a='k', b='k'), |$d.child->toOne())});
  assertEquals('Data->child', $res.current->printPropertyNodeLists());
}

function <<meta::pure::profiles::test.Test>> meta::pure::lineage::scanProperties::test::constructed::testCollectionPrefersSourcePathOverConstructedInstance():Boolean[1]
{
  let res = scanResolving({d:Data[1] | [^Data(a='k', b='k'), $d.child->toOne()]->toOne()});
  assertEquals('Data->child', $res.current->printPropertyNodeLists());
}

function <<meta::pure::profiles::test.Test>> meta::pure::lineage::scanProperties::test::constructed::testCopyAddRecordsCopiedObjectsExistingValues():Boolean[1]
{
  let res = scanResolving({d:Data[1] | $d.child->map(c | ^$c(tags += $d.a).tags)});
  assertEquals('Data->a\nData->child\nData->child, Data->tags', $res.result->printPropertyNodeLists());
  assertEquals('Data->a', $res.current->printPropertyNodeLists());
}

function <<meta::pure::profiles::test.Test>> meta::pure::lineage::scanProperties::test::constructed::testCopyAddOfLiteralResolvesThroughCopiedObject():Boolean[1]
{
  let res = scanResolving({d:Data[1] | $d.child->map(c | ^$c(tags += 'k').tags)});
  assertEquals('Data->child\nData->child, Data->tags', $res.result->printPropertyNodeLists());
  assertEquals('Data->child, Data->tags', $res.current->printPropertyNodeLists());
}

function <<meta::pure::profiles::test.Test>> meta::pure::lineage::scanProperties::test::constructed::testMatchArmsMergeTheirAssignments():Boolean[1]
{
  let res = scanResolving({data:Data[*] | $data->map(d | $d->match([
                                                            s1:Sub1[1] | ^Box(a=$d.a, b=$s1.one),
                                                            s2:Sub2[1] | ^Box(a=$d.a, c=$s2.two)
                                                         ]))->map(bx | $bx.c)});
  assertEquals('Data->a\nSub1->one\nSub2->two', $res.result->printPropertyNodeLists());
  assertEquals('Sub2->two', $res.current->printPropertyNodeLists());
}

function <<meta::pure::profiles::test.Test>> meta::pure::lineage::scanProperties::test::constructed::testMergingArmsKeepsTheFirstArmsAssignments():Boolean[1]
{
  let res = scanResolving({data:Data[*] | $data->map(d | $d->match([
                                                            s1:Sub1[1] | ^Box(a=$d.a, b=$s1.one),
                                                            s2:Sub2[1] | ^Box(a=$d.a, c=$s2.two)
                                                         ]))->map(bx | $bx.b)});
  assertEquals('Data->a\nSub1->one\nSub2->two', $res.result->printPropertyNodeLists());
  assertEquals('Sub1->one', $res.current->printPropertyNodeLists());
}

// The slot resolves to the first arm's path although readProperty takes ->last().
function <<meta::pure::profiles::test.Test>> meta::pure::lineage::scanProperties::test::constructed::testArmsFillingOneSlotFromDifferentPathsKeepTheFirst():Boolean[1]
{
  let res = scanResolving({data:Data[*] | $data->map(d | $d->match([
                                                            s1:Sub1[1] | ^Box(a=$s1.one),
                                                            s2:Sub2[1] | ^Box(a=$s2.two)
                                                         ]))->map(bx | $bx.a)});
  assertEquals('Sub1->one\nSub2->two', $res.result->printPropertyNodeLists());
  assertEquals('Sub1->one', $res.current->printPropertyNodeLists());
}

function <<meta::pure::profiles::test.Test>> meta::pure::lineage::scanProperties::test::constructed::testConditionalBranchesMergeTheirAssignments():Boolean[1]
{
  let res = scanResolving({d:Data[1] | if($d.a == 'k', |^Box(a=$d.a), |^Box(a=$d.a, b=$d.b)).b});
  assertEquals('Data->a\nData->b', $res.result->printPropertyNodeLists());
  assertEquals('Data->b', $res.current->printPropertyNodeLists());
}

function <<meta::pure::profiles::test.Test>> meta::pure::lineage::scanProperties::test::constructed::testArmsBuildingDifferentClassesKeepTheFirstArm():Boolean[1]
{
  let res = scanResolving({data:Data[*] | $data->map(d | $d->match([
                                                            s1:Sub1[1] | ^Box(a=$s1.one),
                                                            s2:Sub2[1] | ^OtherBox(a=$s2.two)
                                                         ]))});
  assertEquals('Box', $res.current.values->toOne()->cast(@ConstructedInstancePathNode).class.name->toOne());
}

