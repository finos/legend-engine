import meta::pure::graphFetch::*;
import meta::pure::graphFetch::tests::sourceTreeCalc::withSubType::castChildSet::*;

Class meta::pure::graphFetch::tests::sourceTreeCalc::withSubType::castChildSet::Detail
{
  code : String[1];
}

Class meta::pure::graphFetch::tests::sourceTreeCalc::withSubType::castChildSet::Extra
{
  value  : String[1];
  detail : Detail[1];
}

Class meta::pure::graphFetch::tests::sourceTreeCalc::withSubType::castChildSet::Base
{
  id : String[1];
}

Class meta::pure::graphFetch::tests::sourceTreeCalc::withSubType::castChildSet::Sub extends Base
{
  extra : Extra[1];
}

Class meta::pure::graphFetch::tests::sourceTreeCalc::withSubType::castChildSet::Root
{
  items : Base[*];
}

Class meta::pure::graphFetch::tests::sourceTreeCalc::withSubType::castChildSet::TDetail
{
  code : String[1];
}

Class meta::pure::graphFetch::tests::sourceTreeCalc::withSubType::castChildSet::TExtra
{
  value  : String[1];
  detail : TDetail[0..1];
}

Class meta::pure::graphFetch::tests::sourceTreeCalc::withSubType::castChildSet::Row
{
  id    : String[1];
  extra : TExtra[0..1];
}

Class meta::pure::graphFetch::tests::sourceTreeCalc::withSubType::castChildSet::Holder
{
  rows : Row[*];
}

function <<meta::pure::profiles::test.Test>> meta::pure::graphFetch::tests::sourceTreeCalc::withSubType::castChildSet::testChildSetBeneathCastOnChildSetSource():Boolean[1]
{
  let tree       = #{Holder {rows {id, extra {value, detail {code}}}}}#;
  let sourceTree = calculateSourceTree($tree, meta::pure::graphFetch::tests::sourceTreeCalc::withSubType::castChildSet::CastChildSetMapping, meta::pure::extension::defaultExtensions());
  assertEquals(
    'Root\n' +
    '(\n' +
    '  items\n' +
    '  (\n' +
    '    id\n' +
    '  )\n' +
    '  items->subType(Sub)\n' +
    '  (\n' +
    '    extra\n' +
    '    (\n' +
    '      detail\n' +
    '      (\n' +
    '        code\n' +
    '      )\n' +
    '      value\n' +
    '    )\n' +
    '    id\n' +
    '  )\n' +
    ')',
    $sourceTree->sortTree()->treeToString()
  );
}

###Mapping
import meta::pure::graphFetch::tests::sourceTreeCalc::withSubType::castChildSet::*;

Mapping meta::pure::graphFetch::tests::sourceTreeCalc::withSubType::castChildSet::CastChildSetMapping
(
  *Holder: Pure
  {
    ~src Root
    rows[ROW] : $src.items
  }

  Row[ROW]: Pure
  {
    ~src Base
    id           : $src.id,
    extra[EXTRA] : if($src->instanceOf(Sub), |$src->cast(@Sub).extra, |[])
  }

  TExtra[EXTRA]: Pure
  {
    ~src Extra
    value          : $src.value,
    detail[DETAIL] : $src.detail
  }

  TDetail[DETAIL]: Pure
  {
    ~src Detail
    code : $src.code
  }
)
