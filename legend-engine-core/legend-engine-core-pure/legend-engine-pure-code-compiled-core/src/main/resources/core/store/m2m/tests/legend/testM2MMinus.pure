import meta::json::*;
import meta::pure::executionPlan::profiles::*;

function <<meta::pure::profiles::test.Test, meta::pure::profiles::test.AlloyOnly, meta::pure::executionPlan::engine::java::roadmap::feature.M2MBasics>>
{  serverVersion.start='v1_20_0',
   doc.doc='minus used in a property mapping, both binary and n-ary'
}
meta::pure::mapping::modelToModel::test::alloy::simple::minusFunction::simpleM2MUsingMinus() : Boolean[1]
{
  let grammar = '###Pure\n'+
    'Class test::model::Source\n'+
    '{\n'+
    '  x: Integer[1];\n'+
    '  y: Integer[1];\n'+
    '  z: Integer[1];\n'+
    '}\n'+
    '\n'+
    'Class test::model::Target\n'+
    '{\n'+
    '  diff: Integer[1];\n'+
    '  diffOfThree: Integer[1];\n'+
    '}\n'+
    '\n'+
    'function test::query::getDiff(): String[1]\n'+
    '{\n'+
    '  test::model::Target.all()->graphFetch(\n'+
    '    #{\n'+
    '      test::model::Target {\n'+
    '        diff,\n'+
    '        diffOfThree\n'+
    '      }\n'+
    '    }#\n'+
    '  )->serialize(\n'+
    '    #{\n'+
    '      test::model::Target {\n'+
    '        diff,\n'+
    '        diffOfThree\n'+
    '      }\n'+
    '    }#\n'+
    '  )->from(test::mapping::M2MUseMinus, test::runtime::testRuntime)\n'+
    '}\n'+
    '\n'+
    '###Mapping\n'+
    'Mapping test::mapping::M2MUseMinus\n'+
    '(\n'+
    '  *test::model::Target: Pure\n'+
    '  {\n'+
    '    ~src test::model::Source\n'+
    '    diff: $src.x - $src.y,\n'+
    '    diffOfThree: [$src.x, $src.y, $src.z]->minus()\n'+
    '  }\n'+
    ')\n'+
    '\n'+
    '###Connection\n'+
    'JsonModelConnection test::connection::testConnection\n'+
    '{\n'+
    '  class: test::model::Source;\n'+
    '  url: \'data:application/json,{"x":7,"y":5,"z":4}\';\n'+
    '}\n'+
    '\n'+
    '###Runtime\n'+
    'Runtime test::runtime::testRuntime\n'+
    '{\n'+
    '  mappings:\n'+
    '  [\n'+
    '    test::mapping::M2MUseMinus\n'+
    '  ];\n'+
    '  connections:\n'+
    '  [\n'+
    '    ModelStore:\n'+
    '    [\n'+
    '      connection_1: test::connection::testConnection\n'+
    '    ]\n'+
    '  ];\n'+
    '}';

  let elements = meta::legend::compileLegendGrammar($grammar);
  let function = $elements->filter(e|$e->instanceOf(FunctionDefinition) && $e->cast(@PackageableElement)->elementToPath() == 'test::query::getDiff__String_1_')->at(0)->cast(@FunctionDefinition<{->String[1]}>);

  let result = meta::legend::executeLegendQuery($function, [], meta::pure::extension::defaultExtensions());

  assert(jsonEquivalent('{"builder":{"_type":"json"},"values":{"diff":2,"diffOfThree":-2}}'->parseJSON(), $result->toOne()->parseJSON()));
}
