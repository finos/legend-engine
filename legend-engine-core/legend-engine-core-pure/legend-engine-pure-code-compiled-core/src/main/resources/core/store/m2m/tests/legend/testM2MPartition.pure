import meta::json::*;
import meta::pure::executionPlan::profiles::*;

function <<meta::pure::profiles::test.Test, meta::pure::profiles::test.AlloyOnly, meta::pure::executionPlan::engine::java::roadmap::feature.M2MBasics>>
{  serverVersion.start='v1_20_0',
   doc.doc='partition used inline in a property mapping and through a let in a helper function'
}
meta::pure::mapping::modelToModel::test::alloy::simple::partitionFunction::simpleM2MUsingPartition() : Boolean[1]
{
  let grammar = '###Pure\n'+
    'Class test::model::Item\n'+
    '{\n'+
    '  name: String[1];\n'+
    '  v: Integer[1];\n'+
    '}\n'+
    '\n'+
    'Class test::model::Source\n'+
    '{\n'+
    '  items: test::model::Item[*];\n'+
    '}\n'+
    '\n'+
    'Class test::model::Target\n'+
    '{\n'+
    '  bigCount: Integer[1];\n'+
    '  smallCount: Integer[1];\n'+
    '}\n'+
    '\n'+
    'function test::model::countSmall(items: test::model::Item[*]): Integer[1]\n'+
    '{\n'+
    '  let split = $items->partition(i | $i.v > 2);\n'+
    '  $split.second.values->size();\n'+
    '}\n'+
    '\n'+
    'function test::query::getSplit(): String[1]\n'+
    '{\n'+
    '  test::model::Target.all()->graphFetch(\n'+
    '    #{\n'+
    '      test::model::Target {\n'+
    '        bigCount,\n'+
    '        smallCount\n'+
    '      }\n'+
    '    }#\n'+
    '  )->serialize(\n'+
    '    #{\n'+
    '      test::model::Target {\n'+
    '        bigCount,\n'+
    '        smallCount\n'+
    '      }\n'+
    '    }#\n'+
    '  )->from(test::mapping::M2MUsePartition, test::runtime::testRuntime)\n'+
    '}\n'+
    '\n'+
    '###Mapping\n'+
    'Mapping test::mapping::M2MUsePartition\n'+
    '(\n'+
    '  *test::model::Target: Pure\n'+
    '  {\n'+
    '    ~src test::model::Source\n'+
    '    bigCount: $src.items->partition(i | $i.v > 2).first.values->size(),\n'+
    '    smallCount: test::model::countSmall($src.items)\n'+
    '  }\n'+
    ')\n'+
    '\n'+
    '###Connection\n'+
    'JsonModelConnection test::connection::testConnection\n'+
    '{\n'+
    '  class: test::model::Source;\n'+
    '  url: \'data:application/json,{"items":[{"name":"a","v":1},{"name":"b","v":3},{"name":"c","v":2},{"name":"d","v":5},{"name":"e","v":6}]}\';\n'+
    '}\n'+
    '\n'+
    '###Runtime\n'+
    'Runtime test::runtime::testRuntime\n'+
    '{\n'+
    '  mappings:\n'+
    '  [\n'+
    '    test::mapping::M2MUsePartition\n'+
    '  ];\n'+
    '  connections:\n'+
    '  [\n'+
    '    ModelStore:\n'+
    '    [\n'+
    '      connection_1: test::connection::testConnection\n'+
    '    ]\n'+
    '  ];\n'+
    '}';

  let elements = meta::legend::compileLegendGrammar($grammar);
  let function = $elements->filter(e|$e->instanceOf(FunctionDefinition) && $e->cast(@PackageableElement)->elementToPath() == 'test::query::getSplit__String_1_')->at(0)->cast(@FunctionDefinition<{->String[1]}>);

  let result = meta::legend::executeLegendQuery($function, [], meta::pure::extension::defaultExtensions());

  assert(jsonEquivalent('{"builder":{"_type":"json"},"values":{"bigCount":3,"smallCount":2}}'->parseJSON(), $result->toOne()->parseJSON()));
}
