// Root milestoning date supplied as a (captured) variable rather than a literal, from a
// non-milestoned model-store source. Confirms the milestoning-ignore behavior does not depend
// on the date being an inlined literal at the root getAll.
function <<meta::pure::profiles::test.Test, meta::pure::profiles::test.AlloyOnly>> {serverVersion.start='v1_32_0'}meta::pure::mapping::modelToModel::test::alloy::milestoning::model::testM2MMappingWithMilestonedTargetAndNonMilestonedSourceWithVariableDate():Boolean[1]
{
  let tree =  #{ meta::pure::mapping::modelToModel::test::alloy::milestoning::model::T_VehicleOwner{
                   vehicleName,
                   personName
                 }
               }#;
  let businessDate = %2020-10-15;
  let query = {|meta::pure::mapping::modelToModel::test::alloy::milestoning::model::T_VehicleOwner.all($businessDate)->graphFetch($tree)->serialize($tree)};

  let mapping = meta::pure::mapping::modelToModel::test::alloy::milestoning::model::M2MMappingFromNonMilestonedSource;
  let runtime = ^Runtime(connectionStores = ^ConnectionStore(
                                        element=^ModelStore(),
                                        connection=^JsonModelConnection(
                                        class=meta::pure::mapping::modelToModel::test::alloy::milestoning::model::S_NonMilestonedVehicleOwner,
                                        url='data:application/json,{"name" : "Ram", "vehicleName": "B"}'
                                        ))
                        );
  let result = meta::pure::router::execute($query, $mapping, $runtime, meta::pure::extension::configuration::coreExtensions());

  let json = $result.values->toOne();
  let expected = '{"personName":"Ram","vehicleName":"B"}';
  assert(jsonEquivalent($expected->parseJSON(), $json->parseJSON()));
}

// Nested milestoned target from a non-milestoned source, with the root milestoning date supplied
// as a (captured) variable. Confirms variable-date root navigation still resolves the nested
// milestoned target property (which our in-memory getter fix rewrites to all-versions).
function <<meta::pure::profiles::test.Test, meta::pure::profiles::test.AlloyOnly>> {serverVersion.start='v1_32_0'}meta::pure::mapping::modelToModel::test::alloy::milestoning::model::testM2MMappingWithNestedMilestonedTargetAndNonMilestonedSourceWithVariableDate():Boolean[1]
{
  let tree =  #{ meta::pure::mapping::modelToModel::test::alloy::milestoning::model::T_Owner{
                   personName,
                   vehicle(%2020-10-15){
                     name
                   }
                 }
               }#;
  let businessDate = %2020-10-15;
  let query = {|meta::pure::mapping::modelToModel::test::alloy::milestoning::model::T_Owner.all($businessDate)->graphFetch($tree)->serialize($tree)};

  let mapping = meta::pure::mapping::modelToModel::test::alloy::milestoning::model::M2MMappingNestedMilestonedTargetFromNonMilestonedSource;
  let runtime = ^Runtime(connectionStores = ^ConnectionStore(
                                        element=^ModelStore(),
                                        connection=^JsonModelConnection(
                                        class=meta::pure::mapping::modelToModel::test::alloy::milestoning::model::S_NonMilestonedOwner,
                                        url='data:application/json,{"name" : "Ram", "vehicle": {"name": "B"}}'
                                        ))
                        );
  let result = meta::pure::router::execute($query, $mapping, $runtime, meta::pure::extension::configuration::coreExtensions());

  let json = $result.values->toOne();
  let expected = '{"personName":"Ram","vehicle(2020-10-15)":{"name":"B"}}';
  assert(jsonEquivalent($expected->parseJSON(), $json->parseJSON()));
}

