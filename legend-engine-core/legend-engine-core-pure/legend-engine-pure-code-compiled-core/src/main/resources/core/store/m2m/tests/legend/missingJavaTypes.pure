import meta::json::*;
import meta::pure::executionPlan::featureFlag::*;
import meta::pure::executionPlan::profiles::*;
import meta::pure::graphFetch::execution::*;
import meta::pure::mapping::modelToModel::test::alloy::missingJavaTypes::*;
import meta::pure::mapping::modelToModel::test::alloy::utils::*;

function <<meta::pure::profiles::test.Test, meta::pure::profiles::test.AlloyOnly>>
{
   serverVersion.start='v1_19_0'
}
meta::pure::mapping::modelToModel::test::alloy::missingJavaTypes::testPropertyMissingFromSourceTreeIsGenerated():Any[*]
{
   let tree = #{Out {terms {name, dates {d}}}}#;

   let result = execute(
      |Out.all()->graphFetch($tree)->serialize($tree)->withFeatureFlags(meta::pure::executionPlan::features::Feature.M2M_MIGRATION_MISSING_JAVA_TYPES),
      oneTargetedUnionMemberMapping,
      testJsonRuntime(Deal, '{"a":{"v":"x"}}'),
      meta::pure::extension::defaultExtensions()->concatenate(meta::pure::executionPlan::featureFlag::ExecutionPlanFeatureFlagExtension())
   );

   let expected = '{"terms":[{"name":"A","dates":[{"d":"x"}]}]}';
   assert(jsonEquivalent($expected->parseJSON(), $result.values->toOne()->parseJSON()));
}

function <<meta::pure::profiles::test.Test, meta::pure::profiles::test.AlloyOnly>>
{
   serverVersion.start='v1_19_0'
}
meta::pure::mapping::modelToModel::test::alloy::missingJavaTypes::testPropertyUsedOnlyInHelperFunctionIsGenerated():Any[*]
{
   let tree = #{Out {terms {name, dates {d}}}}#;

   let result = execute(
      |Out.all()->graphFetch($tree)->serialize($tree)->withFeatureFlags(meta::pure::executionPlan::features::Feature.M2M_MIGRATION_MISSING_JAVA_TYPES),
      helperFunctionMapping,
      testJsonRuntime(Deal, '{"a":{"v":"x"}}'),
      meta::pure::extension::defaultExtensions()->concatenate(meta::pure::executionPlan::featureFlag::ExecutionPlanFeatureFlagExtension())
   );

   let expected = '{"terms":[{"name":"A","dates":[{"d":"X"}]}]}';
   assert(jsonEquivalent($expected->parseJSON(), $result.values->toOne()->parseJSON()));
}

###Pure
import meta::pure::mapping::modelToModel::test::alloy::missingJavaTypes::*;

Class meta::pure::mapping::modelToModel::test::alloy::missingJavaTypes::Deal
{
   a : DateHolder[1];
}

Class meta::pure::mapping::modelToModel::test::alloy::missingJavaTypes::DateBase
{
   v : String[1];
}

Class meta::pure::mapping::modelToModel::test::alloy::missingJavaTypes::DateHolder extends DateBase
{
}

Class meta::pure::mapping::modelToModel::test::alloy::missingJavaTypes::AContainer
{
   h : DateHolder[1];
}

Class meta::pure::mapping::modelToModel::test::alloy::missingJavaTypes::BContainer
{
   h : DateHolder[1];
}

Class meta::pure::mapping::modelToModel::test::alloy::missingJavaTypes::Out
{
   terms : Term[*];
}

Class meta::pure::mapping::modelToModel::test::alloy::missingJavaTypes::Term
{
   name  : String[1];
   dates : TermDate[*];
}

Class meta::pure::mapping::modelToModel::test::alloy::missingJavaTypes::TermDate
{
   d : String[1];
}

function meta::pure::mapping::modelToModel::test::alloy::missingJavaTypes::readV(h: DateHolder[1]): String[1]
{
   $h.v->toUpper()
}

function meta::pure::mapping::modelToModel::test::alloy::missingJavaTypes::wrapA(d: Deal[1]): AContainer[1]
{
   ^AContainer(h = $d.a)
}

###Mapping
import meta::pure::mapping::modelToModel::test::alloy::missingJavaTypes::*;

Mapping meta::pure::mapping::modelToModel::test::alloy::missingJavaTypes::oneTargetedUnionMemberMapping
(
   Out : Pure {
      ~src Deal
      terms[a] : $src->wrapA()
   }

   *Term : Operation {
      meta::pure::router::operations::union_OperationSetImplementation_1__SetImplementation_MANY_(a, b)
   }

   Term[a] : Pure {
      ~src AContainer
      name  : 'A',
      dates : $src.h
   }

   Term[b] : Pure {
      ~src BContainer
      name  : 'B',
      dates : $src.h
   }

   TermDate : Pure {
      ~src DateHolder
      d : $src.v
   }
)

###Mapping
import meta::pure::mapping::modelToModel::test::alloy::missingJavaTypes::*;

Mapping meta::pure::mapping::modelToModel::test::alloy::missingJavaTypes::helperFunctionMapping
(
   Out : Pure {
      ~src Deal
      terms[a] : $src->wrapA()
   }

   *Term : Operation {
      meta::pure::router::operations::union_OperationSetImplementation_1__SetImplementation_MANY_(a, b)
   }

   Term[a] : Pure {
      ~src AContainer
      name  : 'A',
      dates : $src.h
   }

   Term[b] : Pure {
      ~src BContainer
      name  : 'B',
      dates : $src.h
   }

   TermDate : Pure {
      ~src DateHolder
      d : $src->readV()
   }
)
