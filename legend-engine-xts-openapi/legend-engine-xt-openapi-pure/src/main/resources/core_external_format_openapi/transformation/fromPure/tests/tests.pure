###Mapping
import meta::external::function::description::openapi::transformation::fromPure::tests::*;

Mapping meta::external::function::description::openapi::transformation::fromPure::tests::personMapping
(
  Person : Pure
  {
    ~src Person
    firstName : $src.firstName;
    lastName: $src.lastName;
  }
)

Mapping meta::external::function::description::openapi::transformation::fromPure::tests::tradeMapping
(
  Trade : Pure
  {
    ~src Trade
    tradeId : $src.tradeId;
    quantity : $src.quantity;
    price : $src.price;
  }
)

Mapping meta::external::function::description::openapi::transformation::fromPure::tests::cyclicMapping
(
  CyclicPerson : Pure
  {
    ~src CyclicPerson
    name : $src.name;
  }
)

Mapping meta::external::function::description::openapi::transformation::fromPure::tests::associationMapping
(
  AssociatedPerson : Pure
  {
    ~src AssociatedPerson
    name : $src.name;
  }
)