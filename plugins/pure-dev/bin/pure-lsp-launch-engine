# pure-lsp-launch-engine - launch the Pure LSP bridge scoped to legend-engine (plus legend-pure
# below it), with defaults baked in.
#
# A thin wrapper over `pure-lsp-launch legend-engine`; see that script for the full flow, flags and
# exit codes, and config/projects.json's legend-engine "launch" block for the port defaults
# (8991/9100 - 9100 being this shop's standing LegendLspServer convention, shared with
# pure-lsp-connect/pure-lsp-restart, so a daemon launched here is the one those reconnect to).
#
# Usage:
#   pure-lsp-launch-engine [--port N] [--socket-port N] [--java PATH]
#                          [--backend-server-host HOST] [--backend-server-port N] [--no-backend]
#                          [extra args passed through to pure-lsp-server, e.g. --jvm-arg=-D...]
set -euo pipefail
SELF="$(readlink -f "${BASH_SOURCE[0]}")"; DIR="$(cd "$(dirname "$SELF")" && pwd)"
exec "$DIR/pure-lsp-launch" legend-engine "$@"
