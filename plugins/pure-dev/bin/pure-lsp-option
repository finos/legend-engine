# pure-lsp-option - set or unset a Pure runtime option (the flags read by isOptionSet('...')) live in
# the running Legend Pure LSP bridge, with no restart, via its /set-option and /unset-option HTTP
# endpoints. See the pure-lsp-set-option SKILL.md for what each option means and when to use it - this
# script is only the HTTP mechanics.
#
# Usage:
#   pure-lsp-option <set|unset> <NAME> [--value true|false] [--port N]
#
# Port: --port if given, else $PURE_LSP_PORT, else a live bridge discovered from its
# /tmp/pure_lsp_server_<port>.json sidecar, else 8991. This used to default to a hardcoded 8992,
# which no launcher binds (pure-lsp-launch-engine uses 8991), so the default always
# failed with a connection error against a perfectly healthy session.
#
# Exit codes:
#   0 = HTTP call succeeded, response printed to stdout
#   1 = bad usage (missing/unknown arguments)
#   3 = HTTP/connection error talking to the bridge (see stderr for the diagnostic)
#
# On success, prints the bridge's JSON response line to stdout, e.g.:
#   {"success": true, "name": "ForceInterpreted", "effective": true}
set -euo pipefail
SELF="$(readlink -f "${BASH_SOURCE[0]}")"; DIR="$(cd "$(dirname "$SELF")/.." && pwd)"

log() { echo "[pure-lsp-option] $*" >&2; }

if [[ $# -lt 2 ]]; then
  log "usage: pure-lsp-option <set|unset> <NAME> [--value true|false] [--port N]"
  exit 1
fi

ACTION="$1"; shift
NAME="$1"; shift
PORT=""
VALUE=""

case "$ACTION" in
  set) ENDPOINT="/set-option" ;;
  unset) ENDPOINT="/unset-option" ;;
  *) log "unknown action: $ACTION (expected 'set' or 'unset')"; exit 1 ;;
esac

while [[ $# -gt 0 ]]; do
  case "$1" in
    --value)
      case "${2:-}" in
        true|false) VALUE="$2" ;;
        *) log "ERROR: --value must be 'true' or 'false', got: '${2:-<missing>}'"; exit 1 ;;
      esac
      shift 2 ;;
    --port) PORT="$2"; shift 2 ;;
    *) log "ERROR: unknown argument: $1"; exit 1 ;;
  esac
done

if [[ -z "$PORT" ]]; then
  PORT="$(PYTHONPATH="$DIR/src" python3 -c \
    'from pure_lsp_bridge.discovery import resolve_port; print(resolve_port())')"
  log "no --port given; resolved bridge port $PORT"
fi

RESPONSE="$(python3 -c "
import json, sys, urllib.error, urllib.request

name = sys.argv[1]
value = sys.argv[2]
port = sys.argv[3]
endpoint = sys.argv[4]

body = {'name': name}
if value:
    body['value'] = (value == 'true')

req = urllib.request.Request(
    'http://127.0.0.1:%s%s' % (port, endpoint),
    data=json.dumps(body).encode(),
    headers={'Content-Type': 'application/json'},
    method='POST',
)
try:
    with urllib.request.urlopen(req, timeout=20) as r:
        print(r.read().decode())
except urllib.error.HTTPError as e:
    print('HTTPError %s: %s' % (e.code, e.read().decode()), file=sys.stderr)
    sys.exit(1)
except Exception as e:
    print('%s: %s' % (type(e).__name__, e), file=sys.stderr)
    sys.exit(1)
" "$NAME" "$VALUE" "$PORT" "$ENDPOINT")" || {
  log "failed to $ACTION '$NAME' on bridge port $PORT - see error above"
  exit 3
}

echo "$RESPONSE"
