function <<test.Test>> meta::external::query::sql::transformation::queryToPure::tests::dynamic::testDynamicCSV():Boolean[1]
{
  assertEquals('|#TDS{\na:Integer[0..1],b:Integer[0..1]\n1,2\n2,3\n}#->meta::pure::functions::relation::select(~[a])',
                transform('select a from csv(\'a,b\n1,2\n2,3\')',[]));
}

function <<test.Test>> meta::external::query::sql::transformation::queryToPure::tests::dynamic::testDynamicWithNonDataTypeColumn():Boolean[1]
{
  let source = ^DynamicSQLSource(
    type = 'variant',
    func = x:String[1]|1,
    generationFunction = {x:TableFunction[1], s:SqlTransformContext[1]|
      #TDS
        id, payload:meta::pure::metamodel::variant::Variant
        1, '[1,2,3]'
        2, '[4,5,6]'
      #
    }
  );

  let lambda = meta::external::query::sql::transformation::queryToPure::sqlToPure('select id from variant(\'a\')', $source, [], ^Map<String, ValueSpecification>())->cast(@FunctionDefinition<Any>);

  assertEquals('|#TDS{\nid:Integer[0..1],payload:meta::pure::metamodel::variant::Variant[0..1]\n1,\'[1,2,3]\'\n2,\'[4,5,6]\'\n}#->meta::pure::functions::relation::select(~[id])',
              $lambda->printFunctionDefinition(meta::external::query::sql::transformation::queryToPure::dynamicGrammarConfiguration(), ^GContext(space=''))
  );
}

function <<test.Test>> meta::external::query::sql::transformation::queryToPure::tests::dynamic::testDynamicVar():Boolean[1]
{
  let rel = #TDS
              a,b
              1,2
              2,3
            #;

  let value = 2;

  assertEquals('|$rel->meta::pure::functions::relation::filter(x: (a:Integer[0..1], b:Integer[0..1])[1]|$x.b == $value)',
                transform('select * from var(\'rel\') where b = var(\'value\')',[], newMap([
                  pair('rel', $rel->deactivate()),
                  pair('value', $value->deactivate())
                ])));
}

function <<test.Test>> meta::external::query::sql::transformation::queryToPure::tests::dynamic::testDynamicTable():Boolean[1]
{
  assertEquals('|#>{meta::external::query::sql::transformation::queryToPure::tests::dynamic::db.tb}#->meta::pure::functions::relation::select(~[n])',
              transform('select n from tb(\'meta::external::query::sql::transformation::queryToPure::tests::dynamic::db.tb\')',[]));
}

function <<test.Test>> meta::external::query::sql::transformation::queryToPure::tests::dynamic::testDynamicTableUsingCTE():Boolean[1]
{
  assertEquals('|let tab = #>{meta::external::query::sql::transformation::queryToPure::tests::dynamic::db.tb}#->meta::pure::functions::relation::select(~[n]);\n'+
               ' $tab->meta::pure::functions::relation::filter(x: (n:meta::pure::precisePrimitives::Varchar(200)[0..1])[1]|$x.n == \'a\');\n',
              transform('with tab as (select n from tb(\'meta::external::query::sql::transformation::queryToPure::tests::dynamic::db.tb\')) select n from tab where n = \'a\'',[]));
}

function <<test.Test>> meta::external::query::sql::transformation::queryToPure::tests::dynamic::testDynamicTableInjectedSpec():Boolean[1]
{
