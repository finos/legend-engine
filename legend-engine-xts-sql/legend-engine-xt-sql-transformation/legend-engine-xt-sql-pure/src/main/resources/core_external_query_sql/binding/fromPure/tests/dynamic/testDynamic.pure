function <<test.Test>> meta::external::query::sql::transformation::queryToPure::tests::dynamic::testDynamicFunc():Boolean[1]
{
  assertEquals('|meta::external::query::sql::transformation::queryToPure::tests::dynamic::testFuncSource()',
              transform('select n from func(\'meta::external::query::sql::transformation::queryToPure::tests::dynamic::testFuncSource__Relation_1_\')',[]));

  assertEquals('|123->meta::external::query::sql::transformation::queryToPure::tests::dynamic::testFuncSourceWithParam([])',
              transform('select * from func(\'meta::external::query::sql::transformation::queryToPure::tests::dynamic::testFuncSourceWithParam_Integer_1__Integer_$0_1$__Relation_1_\', param => 123)',[]));
}

