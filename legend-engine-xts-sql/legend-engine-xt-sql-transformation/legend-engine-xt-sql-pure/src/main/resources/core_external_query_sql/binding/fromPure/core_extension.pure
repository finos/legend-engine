import meta::external::query::sql::metamodel::*;
import meta::external::query::sql::transformation::queryToPure::*;
import meta::external::query::sql::*;
import meta::external::query::sql::transformation::utils::*;
import meta::external::query::sql::transformation::compile::utils::*;

function <<sql.Extension>> meta::external::query::sql::coreExtension():SQLExtension[1]
{
  ^SQLExtension(
    name = 'core',
    udfs = ^UserDefinedFunctions(
      prefix = 'core',
      processors = [
        date('date_diff', Integer, {args, fc, expCtx, ctx |
            assertEquals(3, $args->size(), 'incorrect number of args for core_date_diff');

            let part = $args->at(0)->reactivate()->toOne()->cast(@String);

            let enum = mapDuration($part) ;

            nullOrSfe(dateDiff_Date_1__Date_1__DurationUnit_1__Integer_1_, [$args->at(1), $args->at(2), createExtractEnumValue($enum)])  ;
        }),
        date('most_recent_day_of_week', Date, {args, fc, expCtx, ctx |
            assertEquals(2, $args->size(), 'incorrect number of args for core_most_recent_day_of_week');

            let part = $args->at(0)->reactivate()->toOne()->cast(@String);

            let enum = mapDayOfWeek($part);

            nullOrSfe(mostRecentDayOfWeek_Date_1__DayOfWeek_1__Date_1_, [$args->at(1), createExtractEnumValue($enum)])  ;
        }),
        date('previous_day_of_week', Date, {args, fc, expCtx, ctx |
            assertEquals(2, $args->size(), 'incorrect number of args for core_previous_day_of_week');

            let part = $args->at(0)->reactivate()->toOne()->cast(@String);

            let enum = mapDayOfWeek($part);

            nullOrSfe(previousDayOfWeek_Date_1__DayOfWeek_1__Date_1_, [$args->at(1), createExtractEnumValue($enum)])  ;
        }),
        aggregate('unique_value_only', Any, {args, fc, expCtx, ctx |
            sfe(uniqueValueOnly_T_MANY__T_$0_1$_, $args->at(0).genericType, $args->at(0).genericType, $args->at(0))
        }),
        aggregate('max_by', Any, {args, fc, expCtx, ctx |
            let valueType = $args->at(0).genericType.typeArguments->at(0);

            let func = if ($args->size() == 1, | meta::pure::functions::math::maxBy_RowMapper_MANY__T_$0_1$_, | meta::pure::functions::math::maxBy_RowMapper_MANY__Integer_1__T_MANY_);

            let maxByExpr = sfe($func, $valueType, $valueType, $args);

            if ($args->size() == 1, | $maxByExpr, | sfe(meta::pure::functions::variant::convert::toVariant_Any_MANY__Variant_1_, [$maxByExpr]));
        }, minMaxByPreprocessor_Expression_1__FunctionCall_1__SqlTransformContext_1__AggregateFunctionPreProcessorWrapper_1_),
        aggregate('min_by', Any, {args, fc, expCtx, ctx |
            let valueType = $args->at(0).genericType.typeArguments->at(0);

            let func = if ($args->size() == 1, | meta::pure::functions::math::minBy_RowMapper_MANY__T_$0_1$_, | meta::pure::functions::math::minBy_RowMapper_MANY__Integer_1__T_MANY_);

            let minByExpr = sfe($func, $valueType, $valueType, $args);

            if ($args->size() == 1, | $minByExpr, | sfe(meta::pure::functions::variant::convert::toVariant_Any_MANY__Variant_1_, [$minByExpr]));
        }, minMaxByPreprocessor_Expression_1__FunctionCall_1__SqlTransformContext_1__AggregateFunctionPreProcessorWrapper_1_)
      ]
    )
  )
}

function meta::external::query::sql::transformation::queryToPure::minMaxByPreprocessor(column:meta::external::query::sql::metamodel::Expression[1], aggregate:FunctionCall[1], context:SqlTransformContext[1]):AggregateFunctionPreProcessorWrapper[1]
{
  assertRelation($context.relation, 'minBy/maxBy');
  assert($aggregate.arguments->size() == 2 || $aggregate.arguments->size() == 3, | 'min_by/max_by expects either 2 or 3 args');
  unsupported($aggregate.orderBy->isEmpty(), | 'aggregate order by not supported for min_by/max_by');
  unsupported($aggregate.filter->isEmpty(), | 'aggregate filter not supported for min_by/max_by');
  unsupported($aggregate.group->isEmpty(), | 'within group not supported for min_by/max_by');

  let valueVs = processMapFunctionArgument($aggregate.arguments->at(0), $context)->evaluateAndDeactivate();
  let orderVs = processMapFunctionArgument($aggregate.arguments->at(1), $context)->evaluateAndDeactivate();

  let rowMapperType = ^GenericType(
    rawType = meta::pure::functions::math::mathUtility::RowMapper,
    typeArguments = [$valueVs.genericType, $orderVs.genericType]
  );

  let rowMapperVs = sfe(
    meta::pure::functions::math::mathUtility::rowMapper_T_$0_1$__U_$0_1$__RowMapper_1_,
    $rowMapperType,
    [$valueVs.genericType, $orderVs.genericType],
    [$valueVs, $orderVs]
  );

  let singleArgAggregate = $column->walk([
    f:FunctionCall[1] | ^$f(arguments = $f.arguments->first()->concatenate(if ($f.arguments->size() == 3, | $f.arguments->last(), | [])))
  ])->toOne();

  ^AggregateFunctionPreProcessorWrapper(
    mapValueSpecification = $rowMapperVs,
    aggregate = $singleArgAggregate->replaceAggregateArguments($context)
  );
}

function meta::external::query::sql::mapDuration(durationUnit:String[1]):DurationUnit[1]
{
  [
    pair('year', DurationUnit.YEARS),
    pair('month', DurationUnit.MONTHS),
    pair('week', DurationUnit.WEEKS),
    pair('day', DurationUnit.DAYS),
    pair('hour', DurationUnit.HOURS),
    pair('minute', DurationUnit.MINUTES),
    pair('second', DurationUnit.SECONDS),
    pair('millisecond', DurationUnit.MILLISECONDS)
  ]->getValue($durationUnit->toLower());

}

function meta::external::query::sql::mapDayOfWeek(stringDate:String[1]):DayOfWeek[1]
{
   [
    pair('monday', DayOfWeek.Monday),
    pair('tuesday', DayOfWeek.Tuesday),
    pair('wednesday', DayOfWeek.Wednesday),
    pair('thursday', DayOfWeek.Thursday),
    pair('friday', DayOfWeek.Friday),
    pair('saturday', DayOfWeek.Saturday),
    pair('sunday', DayOfWeek.Sunday)
  ]->getValue($stringDate->toLower());

}
