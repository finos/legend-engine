function pack::jsonEqualsInWhere():Any[*]
{
  #SQL{select t.ID as "id" from tb('pack::DB.windowVariant') as t where t.PAYLOAD -> 'businessData' -> 'signalId' = 'abc'}#->from(test::test);
}
 
function pack::jsonIsNullInGroupByHaving():Any[*]
{
  #SQL{select t.ID as "id", count(*) as "cnt" from tb('pack::DB.windowVariant') as t where t.PAYLOAD -> 'businessData' -> 'signalId' is null group by t.ID}#->from(test::test);
}

###Runtime
Runtime test::test
{
    mappings : [];
    connections:
    [
        pack::DB : [connection: test::testConnection]
    ];
}


