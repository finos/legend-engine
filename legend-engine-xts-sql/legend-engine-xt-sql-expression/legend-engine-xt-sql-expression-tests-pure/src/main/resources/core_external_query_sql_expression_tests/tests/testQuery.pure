import meta::relational::mapping::*;

function <<test.Test>> meta::external::query::sql::expression::tests::testSimpleFilter():Boolean[1]
{
  let res = meta::legend::compile(readFile('/core_external_query_sql_expression_tests/tests/query.legend')->toOne());
  let plan = meta::pure::executionPlan::executionPlan(
    $res->filter(p|$p.name == 'simpleFilter__Any_MANY_')->toOne()->cast(@FunctionDefinition<Any>),
    meta::pure::extension::runtime::getExtensions(),
    noDebug()
  );
  assertEquals('select "mytab_0".name as "name" from myTab as "mytab_0" where "mytab_0".name = \'www\'', $plan.rootExecutionNode->cast(@RelationalTdsInstantiationExecutionNode).executionNodes->cast(@SQLExecutionNode).sqlQuery);
}

function <<test.Test>> meta::external::query::sql::expression::tests::testMixedFilter():Boolean[1]
{
  let res = meta::legend::compile(readFile('/core_external_query_sql_expression_tests/tests/query.legend')->toOne());
  let plan = meta::pure::executionPlan::executionPlan(
    $res->filter(p|$p.name == 'mixedExpression__Any_MANY_')->toOne()->cast(@FunctionDefinition<Any>),
    meta::pure::extension::runtime::getExtensions(),
    noDebug()
  );
  assertEquals('select "mytab_0".name as "name" from myTab as "mytab_0" where "mytab_0".name = \'www2\'', $plan.rootExecutionNode->cast(@RelationalTdsInstantiationExecutionNode).executionNodes->cast(@SQLExecutionNode).sqlQuery);
}

function <<test.Test>> meta::external::query::sql::expression::tests::testMultiLineExpression():Boolean[1]
{
   let res = meta::legend::compile(readFile('/core_external_query_sql_expression_tests/tests/query.legend')->toOne());
   let plan = meta::pure::executionPlan::executionPlan(
    $res->filter(p|$p.name == 'fmultiExpressions__Any_MANY_')->toOne()->cast(@FunctionDefinition<Any>),
    meta::pure::extension::runtime::getExtensions(),
    noDebug()
  );
  assertEquals('with q as (select "mytab_0".name as "name" from myTab as "mytab_0") select "q_0"."name" from q as "q_0" where "q_0"."name" = \'www\'', $plan.rootExecutionNode->cast(@RelationalTdsInstantiationExecutionNode).executionNodes->cast(@SQLExecutionNode).sqlQuery);

}

function <<access.private>> meta::external::query::sql::expression::tests::sqlForFunc(funcName:String[1]):String[1]
{
  let res = meta::legend::compile(readFile('/core_external_query_sql_expression_tests/tests/query.legend')->toOne());
  let plan = meta::pure::executionPlan::executionPlan(
    $res->filter(p | $p.name == $funcName)->toOne()->cast(@FunctionDefinition<Any>),
    meta::pure::extension::runtime::getExtensions(),
    noDebug()
  );
  $plan.rootExecutionNode->cast(@RelationalTdsInstantiationExecutionNode).executionNodes->cast(@SQLExecutionNode).sqlQuery->toOne();
}
 
function <<test.Test>> meta::external::query::sql::expression::tests::testJsonInSelectOnly():Boolean[1]
{
  let sql = meta::external::query::sql::expression::tests::sqlForFunc('jsonInSelectOnly__Any_MANY_');
  assertEquals('select "windowvariant_0".ID as "id", legend_h2_extension_json_navigate(legend_h2_extension_json_navigate("windowvariant_0".PAYLOAD, \'businessData\', null), \'signalId\', null) as "signalId" from windowVariant as "windowvariant_0"', $sql);
}
 
function <<test.Test>> meta::external::query::sql::expression::tests::testJsonIsNullInWhere():Boolean[1]
{
  let sql = meta::external::query::sql::expression::tests::sqlForFunc('jsonIsNullInWhere__Any_MANY_');
  assertEquals('select "windowvariant_0"."ID" as "id" from (select "windowvariant_1".ID as "ID" from windowVariant as "windowvariant_1" where legend_h2_extension_json_navigate(legend_h2_extension_json_navigate("windowvariant_1".PAYLOAD, \'businessData\', null), \'signalId\', null) is null) as "windowvariant_0"', $sql);
}
 
function <<test.Test>> meta::external::query::sql::expression::tests::testJsonIsNotNullInWhere():Boolean[1]
{
  let sql = meta::external::query::sql::expression::tests::sqlForFunc('jsonIsNotNullInWhere__Any_MANY_');
  assertEquals('select "windowvariant_0"."ID" as "id" from (select "windowvariant_1".ID as "ID" from windowVariant as "windowvariant_1" where legend_h2_extension_json_navigate(legend_h2_extension_json_navigate("windowvariant_1".PAYLOAD, \'businessData\', null), \'signalId\', null) is not null) as "windowvariant_0"', $sql);
}
 
function <<test.Test>> meta::external::query::sql::expression::tests::testJsonNotIsNullInWhere():Boolean[1]
{
  let sql = meta::external::query::sql::expression::tests::sqlForFunc('jsonNotIsNullInWhere__Any_MANY_');
  assertEquals('select "windowvariant_0"."ID" as "id" from (select "windowvariant_1".ID as "ID" from windowVariant as "windowvariant_1" where not legend_h2_extension_json_navigate(legend_h2_extension_json_navigate("windowvariant_1".PAYLOAD, \'businessData\', null), \'signalId\', null) is null) as "windowvariant_0"', $sql);
}
 
function <<test.Test>> meta::external::query::sql::expression::tests::testJsonEqualsInWhere():Boolean[1]
{
  let sql = meta::external::query::sql::expression::tests::sqlForFunc('jsonEqualsInWhere__Any_MANY_');
  assertEquals('select "windowvariant_0"."ID" as "id" from (select "windowvariant_1".ID as "ID" from windowVariant as "windowvariant_1" where legend_h2_extension_json_navigate(legend_h2_extension_json_navigate("windowvariant_1".PAYLOAD, \'businessData\', null), \'signalId\', null) = \'abc\') as "windowvariant_0"', $sql);
}
 
function <<test.Test>> meta::external::query::sql::expression::tests::testWildcardSubqueryJsonIsNullInWhereOnly():Boolean[1]
{
  let sql = meta::external::query::sql::expression::tests::sqlForFunc('wildcardSubqueryJsonIsNullInWhereOnly__Any_MANY_');
  assertEquals('select "windowvariant_0".ID as "ID", "windowvariant_0".PAYLOAD as "PAYLOAD" from windowVariant as "windowvariant_0" where legend_h2_extension_json_navigate(legend_h2_extension_json_navigate("windowvariant_0".PAYLOAD, \'businessData\', null), \'signalId\', null) is not null', $sql);
}
 
function <<test.Test>> meta::external::query::sql::expression::tests::testJsonInCaseWhenAsWhereFilter():Boolean[1]
{
  let sql = meta::external::query::sql::expression::tests::sqlForFunc('jsonInCaseWhenAsWhereFilter__Any_MANY_');
  assertEquals('select "windowvariant_0"."ID" as "id" from (select "windowvariant_1".ID as "ID" from windowVariant as "windowvariant_1" where case when legend_h2_extension_json_navigate(legend_h2_extension_json_navigate("windowvariant_1".PAYLOAD, \'businessData\', null), \'signalId\', null) is null then 1 else 0 end = 1) as "windowvariant_0"', $sql);
}
 
function <<test.Test>> meta::external::query::sql::expression::tests::testJsonIsNullInGroupBy():Boolean[1]
{
  let sql = meta::external::query::sql::expression::tests::sqlForFunc('jsonIsNullInGroupByHaving__Any_MANY_');
  assertEquals('select "windowvariant_0"."id" as "id", "windowvariant_0"."cnt" as "cnt" from (select "windowvariant_1".ID as "ID", "windowvariant_1".ID as "id", count(*) as "cnt" from windowVariant as "windowvariant_1" where legend_h2_extension_json_navigate(legend_h2_extension_json_navigate("windowvariant_1".PAYLOAD, \'businessData\', null), \'signalId\', null) is null group by "ID", "id") as "windowvariant_0"', $sql);
}