function meta::external::query::sql::e2e::diagCase(caseId:String[1]):String[1]
{
  let rep = meta::external::query::sql::e2e::run($caseId)->map(o | 'STATUS=' + meta::external::query::sql::e2e::statusLabel($o) + ' ' + $o.id + if($o.result.message->isNotEmpty(), | '\n' + $o.result.message->toOne(), | ''))->joinStrings('\n---\n');
  println($rep);
  $rep;
}

// Ad hoc SQL diagnostic - no corpus entry required. path is 'TDS', 'Relation', or 'Both'.
function meta::external::query::sql::e2e::diagAdhoc(sql:String[1], path:SqlE2EPath[1]):String[1]
{
  let results = meta::external::query::sql::e2e::executeAdhocSQL($sql, $path);
  let rep = $results->map(r | 'PATH=' + $r.path.name
      + if($r.matched->isNotEmpty(), | ' matched=' + $r.matched->toOne()->toString(), | '')
      + if($r.legendError->isNotEmpty(), | '\n  legendError: ' + $r.legendError->toOne(), | '\n  legend: ' + if($r.legendResultJson->isNotEmpty(), | $r.legendResultJson->toOne(), | '(none)'))
      + if($r.referenceError->isNotEmpty(), | '\n  referenceError: ' + $r.referenceError->toOne(), | '\n  reference:\n' + if($r.referenceRows->isNotEmpty(), | $r.referenceRows->toOne(), | '(none)'))
    )->joinStrings('\n---\n');
  println($rep);
  $rep;
}

