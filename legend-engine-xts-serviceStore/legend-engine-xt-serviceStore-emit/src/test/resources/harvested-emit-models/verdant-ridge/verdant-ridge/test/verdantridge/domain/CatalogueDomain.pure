###Pure
import test::verdantridge::domain::*;

Class test::verdantridge::domain::HoldingRecord
{
  holdingId: String[0..1];
  branchCode: String[0..1];
  shelfMark: String[0..1];
  seasonLabel: String[0..1];
  titleText: String[0..1];
  mediaFormat: String[0..1];
  copiesOnShelf: Integer[0..1];
  conditionNote: String[0..1];
}

Class test::verdantridge::domain::HoldingQuery
{
  branchCode: String[1];
  mediaFormat: String[1];
}

Class test::verdantridge::domain::ShelfSummary
{
  shelfMark: String[1];
  titleLabel: String[1];
  availabilityBand: String[1];
  noteLabel: String[1];
}
