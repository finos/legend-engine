###Service
Service test::verdantridge::service::HoldingLookupService
{
  pattern: '/catalogue/v1/holding/{region}/{branchCode}/{shelfMark}/{seasonLabel}';
  title: 'Reading Room - Single Shelf Holding';
  documentation: 'Selects one remote shelf holding by branch, shelf mark and season through the remote catalogue endpoint, then graph-fetches and serialises the descriptive properties. Multi-executed by region so each reading-room network resolves the same query against its own endpoint.';
  autoActivateUpdates: true;
  ownership: UserList { users: ['reading-room-catalogue', 'shelf-audit'] };
  execution: Multi
  {
    query: {branchCode: String[1], shelfMark: String[1], seasonLabel: String[1]|test::verdantridge::domain::HoldingRecord.all()->filter(
      h|(($h.branchCode->toOne() == $branchCode) && ($h.shelfMark->toOne() == $shelfMark)) && ($h.seasonLabel->toOne() == $seasonLabel)
    )->toOne()->graphFetch(
      #{
        test::verdantridge::domain::HoldingRecord
        {
          titleText,
          mediaFormat,
          copiesOnShelf,
          conditionNote
        }
      }#
    )->serialize(
      #{
        test::verdantridge::domain::HoldingRecord
        {
          titleText,
          mediaFormat,
          copiesOnShelf,
          conditionNote
        }
      }#
    )};
    key: 'region';
    executions['ridge']:
    {
      mapping: test::verdantridge::mapping::HoldingsMapping;
      runtime: test::verdantridge::runtime::RidgeCatalogueRuntime;
    }
    executions['copse']:
    {
      mapping: test::verdantridge::mapping::HoldingsMapping;
      runtime: test::verdantridge::runtime::CopseCatalogueRuntime;
    }
  }
}
