###ServiceStore
ServiceStore test::verdantridge::store::HoldingsApi
(
  description: 'Remote branch-library catalogue endpoints returning the shelf holdings of a single reading room.';

  ServiceGroup CatalogueServices
  (
    path: '/catalogue';

    Service HoldingLookup
    (
      path: '/holdings/{branchCode}/{shelfMark}/{seasonLabel}';
      method: GET;
      parameters:
      (
        branchCode: String ( location = path ),
        shelfMark: String ( location = path ),
        seasonLabel: String ( location = path )
      );
      security: [];
      response: [test::verdantridge::domain::HoldingRecord <- test::verdantridge::binding::HoldingRecordBinding];
    )

    Service HoldingSearch
    (
      path: '/holdings/search';
      method: POST;
      security: [];
      requestBody: test::verdantridge::domain::HoldingQuery <- test::verdantridge::binding::HoldingQueryBinding;
      response: [test::verdantridge::domain::HoldingRecord <- test::verdantridge::binding::HoldingRecordBinding];
    )
  )
)
