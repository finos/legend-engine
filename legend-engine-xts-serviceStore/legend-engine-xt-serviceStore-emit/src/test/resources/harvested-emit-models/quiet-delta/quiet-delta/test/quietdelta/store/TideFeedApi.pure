###ServiceStore
ServiceStore demo::quietdelta::store::TideFeedApi
(
  description: 'Remote coastal-observatory endpoint publishing high-water bulletins for the reef survey diary.';

  ServiceGroup TideServices
  (
    path: '/tides';

    Service bulletinByGauge
    (
      path: '/gauges/{gaugeCode}/bulletin';
      method: GET;
      parameters:
      (
        gaugeCode: String (location = path),
        season: String (location = query)
      );
      security: [];
      response: [demo::quietdelta::domain::TideBulletin <- demo::quietdelta::binding::TideBulletinBinding];
    )
  )
)
