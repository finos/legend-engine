###Relational
Database demo::quietdelta::store::KelpDB
(
  Schema kelp
  (
    Table survey_reef
    (
      reef_ref VARCHAR(20) PRIMARY KEY,
      reef_label VARCHAR(120) NOT NULL,
      coastal_zone VARCHAR(40) NOT NULL,
      mean_depth_metres DECIMAL(7,2) NOT NULL,
      warden_team VARCHAR(80)
    )
    Table canopy_transect
    (
      transect_ref VARCHAR(24) PRIMARY KEY,
      reef_ref VARCHAR(20) NOT NULL,
      swum_on DATE NOT NULL,
      stipe_count INTEGER NOT NULL,
      canopy_cover_pct DECIMAL(6,2) NOT NULL,
      visibility_metres DECIMAL(5,2)
    )
    Table holdfast_quadrat
    (
      quadrat_ref VARCHAR(24) PRIMARY KEY,
      transect_ref VARCHAR(24) NOT NULL,
      urchin_count INTEGER NOT NULL,
      sediment_grade VARCHAR(20) NOT NULL
    )
  )

  Join Transect_Reef(kelp.canopy_transect.reef_ref = kelp.survey_reef.reef_ref)
  Join Quadrat_Transect(kelp.holdfast_quadrat.transect_ref = kelp.canopy_transect.transect_ref)
)
