###ServiceStore
ServiceStore test::frostedglacier::store::GlacierFeedApi
(
  description : 'Remote read-only endpoint publishing seasonal glacier mass-balance readings per monitoring station.';

  ServiceGroup MassBalanceServices
  (
    path : '/mass-balance';

    Service readingsByStation
    (
      path : '/stations/{stationCode}/readings';
      method : GET;
      parameters :
      (
        stationCode : String ( location = path )
      );
      response : [test::frostedglacier::api::GlacierReadingFeed <- test::frostedglacier::external::GlacierFeedBinding];
      security : [];
    )
  )
)
