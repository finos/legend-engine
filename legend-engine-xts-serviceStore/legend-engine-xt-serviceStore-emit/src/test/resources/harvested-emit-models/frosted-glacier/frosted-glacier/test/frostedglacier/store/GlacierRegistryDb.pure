###Relational
Database test::frostedglacier::store::GlacierRegistryDb
(
  Schema registry
  (
    Table station
    (
      station_code VARCHAR(16) PRIMARY KEY,
      station_name VARCHAR(120) NOT NULL,
      glacier_class_code CHAR(1) NOT NULL,
      elevation_m INTEGER NOT NULL,
      basin_name VARCHAR(120),
      country_code CHAR(3) NOT NULL,
      commissioned_on DATE
    )
  )
)
