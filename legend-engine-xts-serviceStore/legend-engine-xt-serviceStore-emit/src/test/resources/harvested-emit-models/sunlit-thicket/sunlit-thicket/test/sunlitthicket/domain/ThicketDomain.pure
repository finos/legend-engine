###Pure
import test::sunlitthicket::domain::*;

Class {meta::pure::profiles::doc.doc = 'Root of the remote coppice-round document the reserve office publishes for one survey feed.'} test::sunlitthicket::domain::ThicketFeedDoc
{
  feedRef: String[0..1];
  reserveName: String[0..1];
  surveyRound: Integer[0..1];
  publishedOn: String[0..1];
  block: ThicketBlockNode[0..1];
}

Class {meta::pure::profiles::doc.doc = 'The coppice block node of the remote document, describing how the block stands at the surveyed round.'} test::sunlitthicket::domain::ThicketBlockNode
{
  blockCode: String[0..1];
  canopyPct: Integer[0..1];
  coppiceCycleYears: Integer[0..1];
  lastCutOn: String[0..1];
  scallopCount: Integer[0..1];
  deerBrowse: String[0..1];
  ride: ThicketRideNode[0..1];
}

Class {meta::pure::profiles::doc.doc = 'The ride cut through a coppice block, held as the innermost node of the remote document graph.'} test::sunlitthicket::domain::ThicketRideNode
{
  rideCode: String[0..1];
  rideWidthM: Integer[0..1];
  surfaceType: String[0..1];
  mownOn: String[0..1];
  sightlineMetres: Integer[0..1];
  vergeCondition: String[0..1];
}
