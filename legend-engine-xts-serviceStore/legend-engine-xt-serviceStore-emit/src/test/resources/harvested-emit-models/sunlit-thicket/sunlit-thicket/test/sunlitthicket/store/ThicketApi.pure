###ServiceStore
ServiceStore test::sunlitthicket::store::ThicketApi
(
  description: 'Remote reads of the coppice-round feed the reserve office publishes, returning documents bound through an explicit document schema.';

  ServiceGroup FeedServices
  (
    path: '/thicket';

    Service FeedLookupService
    (
      path: '/coppice-feed/{feedRef}';
      method: GET;
      parameters:
      (
        feedRef: String (location = path)
      );
      security: [];
      response: [test::sunlitthicket::domain::ThicketFeedDoc <- test::sunlitthicket::binding::ThicketFeedBinding];
    )
  )
)
