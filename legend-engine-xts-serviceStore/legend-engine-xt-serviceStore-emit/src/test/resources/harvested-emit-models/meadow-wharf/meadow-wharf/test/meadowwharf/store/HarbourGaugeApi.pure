###ServiceStore
ServiceStore test::meadowwharf::store::HarbourGaugeApi
(
  description: 'Remote tide-gauge endpoint of a harbour observation network, returning the reading documents recorded for one gauge station of a basin.';

  ServiceGroup GaugeServices
  (
    path: '/gauge';

    Service StationReadings
    (
      path: '/stations/{stationRef}/readings';
      method: GET;
      parameters:
      (
        stationRef: String ( location = path ),
        basin: String ( location = query ),
        gauge: String ( location = query )
      );
      security: [];
      response: [test::meadowwharf::domain::GaugeReading <- test::meadowwharf::binding::GaugeReadingBinding];
    )
  )
)
