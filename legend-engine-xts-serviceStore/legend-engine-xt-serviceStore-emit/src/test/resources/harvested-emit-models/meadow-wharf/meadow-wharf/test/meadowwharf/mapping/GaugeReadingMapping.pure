###Mapping
Mapping test::meadowwharf::mapping::GaugeReadingMapping
(
  *test::meadowwharf::domain::GaugeReading[readingSet]: ServiceStore
  {
    ~service [test::meadowwharf::store::HarbourGaugeApi] GaugeServices.StationReadings
    (
      ~request
      (
        parameters
        (
          stationRef = 'ST-' + $this.stationCode,
          basin = 'north-quay',
          gauge = if($this.gaugeLabel->isEmpty(), |'any-gauge', |$this.gaugeLabel->toOne())
        )
      )
    )
  }

  testSuites:
  [
    stationReadingSuite:
    {
      function: |test::meadowwharf::domain::GaugeReading.all()->filter(r|($r.stationCode == '4180') && ($r.gaugeLabel == 'EBB-2'))->graphFetch(#{test::meadowwharf::domain::GaugeReading{stationCode, gaugeLabel, tideStage, heightCentimetres, observedAt, inspectorNotes}}#)->serialize(#{test::meadowwharf::domain::GaugeReading{stationCode, gaugeLabel, tideStage, heightCentimetres, observedAt, inspectorNotes}}#);
      tests:
      [
        stubbedStationReadingsDeserialiseIntoTwoReadings:
        {
          doc: 'Resolves the remote station-readings operation, whose basin request parameter is supplied by the mapping as a constant, and deserialises the reply document into two readings.';
          data:
          [
            test::meadowwharf::store::HarbourGaugeApi:
              ServiceStore
              #{
                [
                  {
                    request:
                    {
                      method: GET;
                      url: '/gauge/stations/ST-4180/readings?basin=north-quay&gauge=EBB-2';
                    };
                    response:
                    {
                      body:
                        ExternalFormat
                        #{
                          contentType: 'application/json';
                          data: '[{"stationCode":"4180","gaugeLabel":"EBB-2","tideStage":"ebb","heightCentimetres":128.5,"observedAt":"2026-04-11T05:20:00","inspectorNotes":["float chamber flushed","staff gauge rechecked"]},{"stationCode":"4180","gaugeLabel":"EBB-2","inspectorNotes":[]}]';
                        }#;
                    };
                  }
                ]
              }#
          ];
          asserts:
          [
            bothReadingsRoundTripWithAbsentOptionals:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"stationCode":"4180","gaugeLabel":"EBB-2","tideStage":"ebb","heightCentimetres":128.5,"observedAt":"2026-04-11T05:20:00","inspectorNotes":["float chamber flushed","staff gauge rechecked"]},{"stationCode":"4180","gaugeLabel":"EBB-2","tideStage":null,"heightCentimetres":null,"observedAt":null,"inspectorNotes":[]}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
