###ServiceStore
ServiceStore test::verdantmarsh3::store::WaymarkerDetailApi
(
  description: 'Remote waymarker audit reads returning the full detail document tree for one zone of the footpath network.';

  ServiceGroup WaymarkerDetailServices
  (
    path: '/waymarkers';

    Service WaymarkerDetailFeed
    (
      path: '/detail';
      method: GET;
      parameters:
      (
        zoneFilter: String (location = query)
      );
      security: [];
      response: [test::verdantmarsh3::domain::WaymarkerDetailResponse <- test::verdantmarsh3::binding::WaymarkerDetailBinding];
    )
  )
)

ServiceStore test::verdantmarsh3::store::RamblerSurveyApi
(
  description: 'Remote survey reads returning the rambler population variant of the waymarker survey document.';

  ServiceGroup RamblerSurveyServices
  (
    path: '/rambler-surveys';

    Service RamblerSurveyFeed
    (
      path: '/entries';
      method: GET;
      parameters:
      (
        zoneFilter: String (location = query)
      );
      security: [];
      response: [test::verdantmarsh3::domain::RamblerSurveyResponse <- test::verdantmarsh3::binding::SurveyDataBinding];
    )
  )
)

