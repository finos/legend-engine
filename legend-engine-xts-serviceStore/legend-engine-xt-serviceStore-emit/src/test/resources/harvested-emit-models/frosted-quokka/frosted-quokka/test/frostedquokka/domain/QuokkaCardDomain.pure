###Pure
import test::frostedquokka::domain::*;

Class {meta::pure::profiles::doc.doc = 'Field card refined from one sighting document: composed identity, normalised zone, health flag and the observer roster.'} test::frostedquokka::domain::SightingCard
{
  cardTag: String[1];
  zoneLabel: String[1];
  healthFlag: String[1];
  observerCount: Integer[1];
  observers: String[*];
  place: CardPlace[0..1];
}

Class {meta::pure::profiles::doc.doc = 'Burrow-level placement of a sighting card, every property optional.'} test::frostedquokka::domain::CardPlace
{
  burrowCode: String[0..1];
  habitatZone: String[0..1];
  weatherNote: String[0..1];
}
