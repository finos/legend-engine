###Pure
import test::frostedquokka::domain::*;

Class {meta::pure::profiles::doc.doc = 'Wide sighting payload returned by the reserve tracking API, every scalar optional.'} test::frostedquokka::domain::SightingRecord
{
  sightingId: String[0..1];
  reserveCode: String[0..1];
  trackerTag: String[0..1];
  seasonLabel: String[0..1];
  burrowCode: String[0..1];
  habitatZone: String[0..1];
  weatherNote: String[0..1];
  forageNote: String[0..1];
  healthNote: String[0..1];
  observerCode: String[0..1];
  auditNote: String[0..1];
  observerTags: String[*];
}

Class {meta::pure::profiles::doc.doc = 'Narrow digest of a sighting round, every property mandatory.'} test::frostedquokka::domain::SightingDigest
{
  digestTag: String[1];
  habitatZone: String[1];
  observerCode: String[1];
  sightingCount: Integer[1];
}
