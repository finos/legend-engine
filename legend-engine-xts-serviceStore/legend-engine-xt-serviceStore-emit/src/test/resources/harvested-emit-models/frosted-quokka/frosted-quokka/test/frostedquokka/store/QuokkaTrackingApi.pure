###ServiceStore
ServiceStore test::frostedquokka::store::QuokkaTrackingApi
(
  description: 'Remote reserve tracking API exposing quokka sighting rounds.';

  ServiceGroup TrackingServices
  (
    path: '/reserve-tracking';

    Service AllSightings
    (
      path: '/sightings?scope=all';
      method: GET;
      security: [];
      response: [test::frostedquokka::domain::SightingRecord <- test::frostedquokka::binding::SightingRecordBinding];
    )

    Service SightingLookup
    (
      path: '/sightings/{reserveCode}/{trackerTag}/{seasonLabel}/{observerCode}';
      method: GET;
      parameters:
      (
        reserveCode: String ( location = path ),
        trackerTag: String ( location = path ),
        seasonLabel: String ( location = path ),
        observerCode: String ( location = path )
      );
      security: [];
      response: [test::frostedquokka::domain::SightingRecord <- test::frostedquokka::binding::SightingRecordBinding];
    )
  )
)
