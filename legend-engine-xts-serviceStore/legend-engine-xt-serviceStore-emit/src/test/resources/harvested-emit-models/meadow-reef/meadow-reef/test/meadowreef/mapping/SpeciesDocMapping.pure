###Mapping
Mapping test::meadowreef::mapping::SpeciesDocMapping
(
  test::meadowreef::domain::SpeciesDoc[docFeed]: ServiceStore
  {
    ~service [test::meadowreef::store::SpeciesApi] SpeciesServices.SpeciesFeedService

    ~service [test::meadowreef::store::SpeciesApi] SpeciesServices.SpeciesLookupService
    (
      ~request
      (
        parameters
        (
          speciesCode = $this.speciesCode->toOne()
        )
      )
    )
  }

  test::meadowreef::domain::SpeciesDoc[docArchive]: ServiceStore
  {
    ~service [test::meadowreef::store::SpeciesApi] SpeciesServices.ArchiveFeedService
  }

  *test::meadowreef::domain::SpeciesDoc: Operation
  {
    meta::pure::router::operations::union_OperationSetImplementation_1__SetImplementation_MANY_(docFeed, docArchive)
  }

  *test::meadowreef::domain::RegisterDoc[registerFeed]: ServiceStore
  {
    ~service [test::meadowreef::store::RegisterApi] RegisterServices.RegisterFeedService
  }
)
