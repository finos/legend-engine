###Connection
JsonModelConnection test::meadowreef::connection::SightingSubmissionConnection
{
  class: test::meadowreef::source::SightingSubmission;
  url: 'data:application/json,%7B%7D';
}

ServiceStoreConnection test::meadowreef::connection::SpeciesApiConnection
{
  store: test::meadowreef::store::SpeciesApi;
  baseUrl: 'https://species-register.meadow-reef.example';
}

ServiceStoreConnection test::meadowreef::connection::RegisterApiConnection
{
  store: test::meadowreef::store::RegisterApi;
  baseUrl: 'https://register-warden.meadow-reef.example';
}

RelationalDatabaseConnection test::meadowreef::connection::ReefH2Connection
{
  store: test::meadowreef::store::ReefDatabase;
  type: H2;
  specification: LocalH2 { testDataSetupSqls: []; };
  auth: DefaultH2;
}
