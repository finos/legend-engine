###Relational
Database test::meadowreef::store::ReefDatabase
(
  Schema reef
  (
    Table reef_species
    (
      species_code VARCHAR(16) PRIMARY KEY,
      family_name VARCHAR(48) NOT NULL,
      zone_code VARCHAR(16) NOT NULL
    )
    Table species_synonym
    (
      synonym_id INTEGER PRIMARY KEY,
      species_code VARCHAR(16) NOT NULL,
      synonym_text VARCHAR(64) NOT NULL,
      usage_id INTEGER NOT NULL
    )
    Table usage_ref
    (
      usage_id INTEGER PRIMARY KEY,
      usage_code VARCHAR(16) NOT NULL,
      register_label VARCHAR(48) NOT NULL
    )
  )

  Join Species_Synonym(reef.reef_species.species_code = reef.species_synonym.species_code)

  Join Synonym_Usage(reef.species_synonym.usage_id = reef.usage_ref.usage_id)
)
