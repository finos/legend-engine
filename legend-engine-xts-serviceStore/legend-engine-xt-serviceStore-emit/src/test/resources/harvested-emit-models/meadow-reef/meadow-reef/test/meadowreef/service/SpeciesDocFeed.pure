###Service
Service test::meadowreef::service::SpeciesDocFeed
{
  pattern: '/meadowreef/v1/species-doc-feed';
  title: 'Meadow Reef - Species Document Feed';
  owners:
  [
    'reef-trail-office'
  ];
  documentation: 'Graph-fetches the species documents of the endpoint-backed register, unioned across the live and archived listings, so both endpoint reads and their shared document contract are observable in one payload.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |test::meadowreef::domain::SpeciesDoc.all()->graphFetch(
      #{
        test::meadowreef::domain::SpeciesDoc
        {
          speciesCode,
          commonName,
          register
          {
            registerCode
          }
        }
      }#
    )->serialize(
      #{
        test::meadowreef::domain::SpeciesDoc
        {
          speciesCode,
          commonName,
          register
          {
            registerCode
          }
        }
      }#
    );
    mapping: test::meadowreef::mapping::SpeciesDocMapping;
    runtime: test::meadowreef::runtime::SpeciesDocRuntime;
  }
  testSuites:
  [
    docFeedSuite:
    {
      data:
      [
        connections:
        [
          speciesApiConnection:
            ServiceStore
            #{
              [
                {
                  request:
                  {
                    method: GET;
                    url: '/species/species-feed';
                  };
                  response:
                  {
                    body:
                      ExternalFormat
                      #{
                        contentType: 'application/json';
                        data: '[{"speciesCode":"SP-014","commonName":"banded parrotfish","register":{"registerCode":"RG-1"}}]';
                      }#;
                  };
                },
                {
                  request:
                  {
                    method: GET;
                    url: '/species/archive-feed';
                  };
                  response:
                  {
                    body:
                      ExternalFormat
                      #{
                        contentType: 'application/json';
                        data: '[{"speciesCode":"SP-090","commonName":"retired wrasse","register":{"registerCode":"RG-9"}}]';
                      }#;
                  };
                }
              ]
            }#,
          registerApiConnection:
            ServiceStore
            #{
              [
                {
                  request:
                  {
                    method: GET;
                    url: '/registers/register-feed';
                  };
                  response:
                  {
                    body:
                      ExternalFormat
                      #{
                        contentType: 'application/json';
                        data: '[{"registerCode":"RG-1","steward":"trail office"}]';
                      }#;
                  };
                }
              ]
            }#
        ]
      ]
      tests:
      [
        liveAndArchivedDocumentsUnion:
        {
          asserts:
          [
            bothListingsSurface:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"speciesCode":"SP-014","commonName":"banded parrotfish","register":{"registerCode":"RG-1"}},{"speciesCode":"SP-090","commonName":"retired wrasse","register":{"registerCode":"RG-9"}}]}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
