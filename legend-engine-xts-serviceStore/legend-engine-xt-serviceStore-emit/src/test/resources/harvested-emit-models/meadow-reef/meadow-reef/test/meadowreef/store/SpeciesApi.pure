###ServiceStore
ServiceStore test::meadowreef::store::SpeciesApi
(
  description: 'Endpoint-backed reads of the reef species register, one live listing, one archived listing and one parameterised lookup.';

  ServiceGroup SpeciesServices
  (
    path: '/species';

    Service SpeciesFeedService
    (
      path: '/species-feed';
      method: GET;
      security: [];
      response: [test::meadowreef::domain::SpeciesDoc <- test::meadowreef::binding::SpeciesDocBinding];
    )

    Service ArchiveFeedService
    (
      path: '/archive-feed';
      method: GET;
      security: [];
      response: [test::meadowreef::domain::SpeciesDoc <- test::meadowreef::binding::SpeciesDocBinding];
    )

    Service SpeciesLookupService
    (
      path: '/species-lookup/{speciesCode}';
      method: GET;
      parameters:
      (
        speciesCode: String (location = path)
      );
      security: [];
      response: [test::meadowreef::domain::SpeciesDoc <- test::meadowreef::binding::SpeciesDocBinding];
    )
  )
)

ServiceStore test::meadowreef::store::RegisterApi
(
  description: 'Endpoint-backed reads of the register stewardship listing bound through its own document contract.';

  ServiceGroup RegisterServices
  (
    path: '/registers';

    Service RegisterFeedService
    (
      path: '/register-feed';
      method: GET;
      security: [];
      response: [test::meadowreef::domain::RegisterDoc <- test::meadowreef::binding::RegisterDocBinding];
    )
  )
)
