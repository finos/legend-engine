###Mapping
Mapping test::meadowreef::mapping::SightingM2M
(
  *test::meadowreef::domain::SnorkelSighting[sightingSet]: Pure
  {
    ~src test::meadowreef::source::SightingSubmission
    ~filter $src.entryRef->isNotEmpty() && $src.speciesTag->isNotEmpty()
    sightingRef: $src.entryRef->toOne(),
    speciesCode: $src.speciesTag->toOne()->split('|')->at(0),
    observerLabel: if($src.observer->isEmpty(),
                      | 'UNATTRIBUTED',
                      | $src.observer.code->toOne()->toUpper() + ' / ' + $src.observer.trailName->toOne()),
    depthMetres: if($src.depthTags->isEmpty(),
                    | [],
                    | parseInteger($src.depthTags->toOne()->split(':')->at(1)->trim())),
    +zoneTag: String[1]: $src.speciesTag->toOne()->split('|')->at(1)->toUpper()
  }
)
