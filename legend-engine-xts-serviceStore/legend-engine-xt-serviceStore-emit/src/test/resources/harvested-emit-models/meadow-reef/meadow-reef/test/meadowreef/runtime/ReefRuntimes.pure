###Runtime
Runtime test::meadowreef::runtime::SpeciesRuntime
{
  mappings:
  [
    test::meadowreef::mapping::SpeciesMapping
  ];
  connections:
  [
    test::meadowreef::store::ReefDatabase:
    [
      reefConnection: test::meadowreef::connection::ReefH2Connection
    ]
  ];
}

Runtime test::meadowreef::runtime::ReefCrossRuntime
{
  mappings:
  [
    test::meadowreef::mapping::ReefCrossMapping
  ];
  connections:
  [
    ModelStore:
    [
      submissionConnection: test::meadowreef::connection::SightingSubmissionConnection
    ],
    test::meadowreef::store::ReefDatabase:
    [
      reefConnection: test::meadowreef::connection::ReefH2Connection
    ]
  ];
}

Runtime test::meadowreef::runtime::SpeciesDocRuntime
{
  mappings:
  [
    test::meadowreef::mapping::SpeciesDocMapping
  ];
  connections:
  [
    test::meadowreef::store::SpeciesApi:
    [
      speciesApiConnection: test::meadowreef::connection::SpeciesApiConnection
    ],
    test::meadowreef::store::RegisterApi:
    [
      registerApiConnection: test::meadowreef::connection::RegisterApiConnection
    ]
  ];
}
