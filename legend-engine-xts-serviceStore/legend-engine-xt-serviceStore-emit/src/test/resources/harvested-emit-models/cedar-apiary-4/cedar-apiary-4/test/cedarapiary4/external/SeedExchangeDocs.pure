###Pure
import test::cedarapiary4::external::*;

Class test::cedarapiary4::external::SeedLotDoc
{
  lotRef: String[1];
  species: String[1];
  keeper: String[1];
  harvestSeason: String[0..1];
  packets: SeedPacketDoc[*];
}

Class test::cedarapiary4::external::SeedPacketDoc
{
  packetCode: String[1];
  grams: Integer[1];
  germinationRate: Integer[0..1];
  labels: String[*];
}

Class test::cedarapiary4::external::KeeperDoc
{
  keeperCode: String[1];
  displayName: String[1];
  shedName: String[0..1];
}
