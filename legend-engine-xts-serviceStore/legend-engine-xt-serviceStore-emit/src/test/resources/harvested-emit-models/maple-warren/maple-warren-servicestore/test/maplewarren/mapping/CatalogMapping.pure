###Mapping
Mapping test::maplewarren::mapping::CatalogMapping
(
  *test::maplewarren::domain::CatalogPayload[payload_set]: ServiceStore
  {
    ~service [test::maplewarren::store::CatalogStore] CatalogServices.ExhibitService
  }

  *test::maplewarren::domain::ExhibitSummary[exhibit_set]: Pure
  {
    ~src test::maplewarren::domain::CatalogPayload
    recordId: $src.recordId->toOne(),
    exhibitTitle: $src.exhibit.title->toOne(),
    versionLabel: 'V' + $src.versionNumber->toOne()->toString() + '.' + $src.window.fromLabel->toOne()->substring(0, $src.window.fromLabel->toOne()->indexOf('-'))->toUpper(),
    provenanceOrigin: $src.exhibit.provenance.origin,
    donorLabel: $src.exhibit.provenance.donor.donorName,
    galleryLabel[gallery_set]: $src,
    custodian[custodian_set]: $src
  }

  *test::maplewarren::domain::GallerySummary[gallery_set]: Pure
  {
    ~src test::maplewarren::domain::CatalogPayload
    galleryName: $src.exhibit.gallery.galleryName->toOne(),
    wingCode: $src.exhibit.gallery.wing.wingCode->toOne()->toUpper(),
    curator[custodian_set]: $src
  }

  *test::maplewarren::domain::CustodianSummary[custodian_set]: Pure
  {
    ~src test::maplewarren::domain::CatalogPayload
    curatorName: $src.exhibit.gallery.wing.curator.curatorName
  }
)
