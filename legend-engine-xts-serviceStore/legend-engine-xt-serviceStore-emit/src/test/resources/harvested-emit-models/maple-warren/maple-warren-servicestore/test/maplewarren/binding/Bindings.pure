###ExternalFormat
Binding test::maplewarren::binding::CatalogRequestBinding
{
  contentType: 'application/json';
  modelIncludes:
  [
    test::maplewarren::domain::CatalogRequest
  ];
}

Binding test::maplewarren::binding::CatalogResponseBinding
{
  contentType: 'application/json';
  modelIncludes:
  [
    test::maplewarren::domain::CatalogPayload,
    test::maplewarren::domain::CuratorNode,
    test::maplewarren::domain::DonorNode,
    test::maplewarren::domain::ExhibitNode,
    test::maplewarren::domain::GalleryNode,
    test::maplewarren::domain::MediumNode,
    test::maplewarren::domain::ProcessingWindow,
    test::maplewarren::domain::ProvenanceNode,
    test::maplewarren::domain::WingNode
  ];
}
