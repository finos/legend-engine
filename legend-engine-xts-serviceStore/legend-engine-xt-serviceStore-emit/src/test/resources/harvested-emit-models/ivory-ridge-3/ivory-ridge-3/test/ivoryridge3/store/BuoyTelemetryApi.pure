###ServiceStore
ServiceStore test::ivoryridge3::store::BuoyTelemetryApi
(
  description: 'Remote moored-buoy telemetry endpoints publishing the drift sheets of a station window as a delimited document.';

  ServiceGroup TelemetryServices
  (
    path: '/telemetry';

    Service driftSheet
    (
      path: '/drift-sheet';
      method: GET;
      parameters:
      (
        dataset: String (location = query),
        window: String (location = query)
      );
      security: [];
      response: [test::ivoryridge3::api::DriftSheetRow <- test::ivoryridge3::external::DriftSheetBinding];
    )

    Service stationSheet
    (
      path: '/station-sheet/{stationCode}';
      method: GET;
      parameters:
      (
        stationCode: String (location = path)
      );
      security: [];
      response: [test::ivoryridge3::api::DriftSheetRow <- test::ivoryridge3::external::DriftSheetBinding];
    )
  )
)
