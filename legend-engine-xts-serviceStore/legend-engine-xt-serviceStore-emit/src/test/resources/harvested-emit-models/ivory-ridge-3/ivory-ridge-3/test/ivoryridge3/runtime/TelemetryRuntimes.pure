###Runtime
Runtime test::ivoryridge3::runtime::DriftPrimaryRuntime
{
  mappings:
  [
    test::ivoryridge3::mapping::DriftProfileMapping
  ];
  connections:
  [
    test::ivoryridge3::store::BuoyTelemetryApi:
    [
      telemetryApiConnection: test::ivoryridge3::connection::TelemetryPrimaryConnection
    ],
    ModelStore:
    [
      telemetryChainConnection: test::ivoryridge3::connection::TelemetryChainConnection
    ]
  ];
}

Runtime test::ivoryridge3::runtime::DriftStandbyRuntime
{
  mappings:
  [
    test::ivoryridge3::mapping::DriftProfileMapping
  ];
  connections:
  [
    test::ivoryridge3::store::BuoyTelemetryApi:
    [
      telemetryApiConnection: test::ivoryridge3::connection::TelemetryStandbyConnection
    ],
    ModelStore:
    [
      telemetryChainConnection: test::ivoryridge3::connection::TelemetryChainConnection
    ]
  ];
}

Runtime test::ivoryridge3::runtime::TelemetryPrimaryRuntime
{
  mappings:
  [
    test::ivoryridge3::mapping::TelemetryApiMapping
  ];
  connections:
  [
    test::ivoryridge3::store::BuoyTelemetryApi:
    [
      telemetryApiConnection: test::ivoryridge3::connection::TelemetryPrimaryConnection
    ]
  ];
}

Runtime test::ivoryridge3::runtime::StationRegistryRuntime
{
  mappings:
  [
    test::ivoryridge3::mapping::StationMooringMapping
  ];
  connections:
  [
    test::ivoryridge3::store::StationRegistryDB:
    [
      stationRegistryConnection: test::ivoryridge3::connection::StationRegistryConnection
    ]
  ];
}
