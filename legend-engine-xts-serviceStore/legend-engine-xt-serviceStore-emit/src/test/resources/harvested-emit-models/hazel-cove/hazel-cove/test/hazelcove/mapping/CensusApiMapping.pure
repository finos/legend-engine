###Mapping
Mapping test::hazelcove::mapping::CensusApiMapping
(
  *test::hazelcove::api::ColonyRecord[recordSet]: ServiceStore
  {
    ~service [test::hazelcove::store::CensusApi] CensusServices.colonyRecords
  }

  *test::hazelcove::api::ColonySheetRow[sheetSet]: ServiceStore
  {
    ~service [test::hazelcove::store::CensusApi] CensusServices.colonySheet
    (
      ~request
      (
        parameters
        (
          dataset = 'roster-sheet',
          season = 'autumn'
        )
      )
    )
  }

  *test::hazelcove::domain::ColonyProfile[profileSet]: Pure
  {
    ~src test::hazelcove::api::ColonyRecord
    colonyRef: $src.colonyRef,
    siteLabel: $src.siteLabel,
    leadWarden: if($src.wardens->isEmpty(), | $src.note, | $src.wardens->at(0)),
    occupancyIndex: if($src.nestTally->isEmpty(), | $src.reportedIndex, | round($src.nestTally->toOne() / $src.plotHectares->toOne(), 2)),
    densityBand: if($src.nestTally->isEmpty(),
                    | $src.note,
                    | if($src.nestTally->toOne() < 5,
                         | 'BAND-1-SPARSE',
                         | if($src.nestTally->toOne() < 15,
                              | 'BAND-2-THIN',
                              | if($src.nestTally->toOne() < 40,
                                   | 'BAND-3-MODEST',
                                   | if($src.nestTally->toOne() < 90,
                                        | 'BAND-4-STEADY',
                                        | if($src.nestTally->toOne() < 180,
                                             | 'BAND-5-BUSY',
                                             | if($src.nestTally->toOne() < 360,
                                                  | 'BAND-6-CROWDED',
                                                  | if($src.nestTally->toOne() < 700,
                                                       | 'BAND-7-DENSE',
                                                       | 'BAND-8-SATURATED'))))))))
  }
)
