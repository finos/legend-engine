###Runtime
Runtime test::hazelcove::runtime::CensusPrimaryRuntime
{
  mappings:
  [
    test::hazelcove::mapping::CensusApiMapping
  ];
  connections:
  [
    test::hazelcove::store::CensusApi:
    [
      censusApiConnection: test::hazelcove::connection::CensusPrimaryConnection
    ],
    ModelStore:
    [
      censusChainConnection: test::hazelcove::connection::CensusChainConnection
    ]
  ];
}

