###ExternalFormat
Binding test::hazelcove::external::ColonyRecordBinding
{
  contentType: 'application/json';
  modelIncludes:
  [
    test::hazelcove::api::ColonyRecord
  ];
}

Binding test::hazelcove::external::RosterSheetBinding
{
  schemaSet: test::hazelcove::external::RosterSheetSchemas;
  schemaId: rosterSheet;
  contentType: 'application/x.flatdata';
  modelIncludes:
  [
    test::hazelcove::api::ColonySheetRow
  ];
}
