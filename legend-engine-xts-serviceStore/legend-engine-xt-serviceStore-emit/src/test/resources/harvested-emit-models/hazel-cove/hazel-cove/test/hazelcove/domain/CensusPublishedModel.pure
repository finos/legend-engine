###Pure
import test::hazelcove::api::*;
import test::hazelcove::domain::*;

Class <<CensusAnnotations.publishedShape>> {CensusAnnotations.precision = '2'} test::hazelcove::domain::ColonyProfile
{
  colonyRef: String[1];
  siteLabel: String[0..1];
  leadWarden: String[0..1];
  occupancyIndex: Float[0..1];
  densityBand: String[0..1];
}

Class <<CensusAnnotations.publishedShape>> {CensusAnnotations.precision = '2'} test::hazelcove::domain::ColonyRoster
{
  colonyRef: String[1];
  wardenLabel: String[1];
  sheetBand: String[1];
  tallyPerHectare: Float[1];
}
