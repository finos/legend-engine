###ServiceStore
ServiceStore test::hazelcove::store::CensusApi
(
  description: 'Remote seabird-colony census endpoints publishing nest tallies per colony, one endpoint per published dataset.';

  ServiceGroup CensusServices
  (
    path: '/census';

    Service colonyRecords
    (
      path: '/colonies/records';
      method: GET;
      security: [];
      response: [test::hazelcove::api::ColonyRecord <- test::hazelcove::external::ColonyRecordBinding];
    )

    Service colonySheet
    (
      path: '/colonies/sheet';
      method: GET;
      parameters:
      (
        dataset: String (location = query),
        season: String (location = query)
      );
      security: [];
      response: [test::hazelcove::api::ColonySheetRow <- test::hazelcove::external::RosterSheetBinding];
    )
  )
)
