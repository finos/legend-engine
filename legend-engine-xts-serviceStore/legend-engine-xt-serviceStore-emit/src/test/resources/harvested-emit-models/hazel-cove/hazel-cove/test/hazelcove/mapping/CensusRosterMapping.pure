###Mapping
Mapping test::hazelcove::mapping::CensusRosterMapping
(
  *test::hazelcove::domain::ColonyRoster[rosterSet]: Pure
  {
    ~src test::hazelcove::api::ColonySheetRow
    colonyRef: $src.colonyRef,
    wardenLabel: $src.warden->toUpper(),
    sheetBand: $src.bandCode,
    tallyPerHectare: round($src.nestTally / $src.plotHectares, 2)
  }

  testSuites:
  [
    rosterTransformSuite:
    {
      function: |test::hazelcove::domain::ColonyRoster.all()->graphFetch(
  #{
    test::hazelcove::domain::ColonyRoster
    {
      colonyRef,
      wardenLabel,
      sheetBand,
      tallyPerHectare
    }
  }#
)->serialize(
  #{
    test::hazelcove::domain::ColonyRoster
    {
      colonyRef,
      wardenLabel,
      sheetBand,
      tallyPerHectare
    }
  }#
);
      tests:
      [
        rosterRowsUppercasedAndRated:
        {
          doc: 'Three sheet rows are reshaped into roster entries, upper-casing the warden label and rounding the nests-per-hectare rate to the published precision.';
          data:
          [
            ModelStore:
              ModelStore
              #{
                test::hazelcove::api::ColonySheetRow:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"colonyRef":"CL-101","bandCode":"B1","nestTally":24,"plotHectares":4.0,"warden":"rook keeper"},{"colonyRef":"CL-102","bandCode":"B3","nestTally":135,"plotHectares":9.0,"warden":"dune warden"},{"colonyRef":"CL-103","bandCode":"B5","nestTally":410,"plotHectares":8.0,"warden":"cliff warden"}]';
                  }#
              }#
          ];
          asserts:
          [
            rosterRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"colonyRef":"CL-101","wardenLabel":"ROOK KEEPER","sheetBand":"B1","tallyPerHectare":6.0},{"colonyRef":"CL-102","wardenLabel":"DUNE WARDEN","sheetBand":"B3","tallyPerHectare":15.0},{"colonyRef":"CL-103","wardenLabel":"CLIFF WARDEN","sheetBand":"B5","tallyPerHectare":51.25}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
