###ServiceStore
ServiceStore test::cedarsummit::store::NurseryApi
(
  description: 'Remote plant-nursery lookup endpoints returning seedling, tray and propagation-lot records for one greenhouse network.';

  ServiceGroup NurseryServices
  (
    path: '/nursery';

    Service SeedlingLookup
    (
      path: '/seedlings/{trayCode}/{greenhouseZone}/{batchLabel}';
      method: GET;
      parameters:
      (
        trayCode: String ( location = path ),
        greenhouseZone: String ( location = path ),
        batchLabel: String ( location = path ),
        lot: String ( location = query )
      );
      security: [];
      response: [test::cedarsummit::domain::SeedlingRecord <- test::cedarsummit::binding::NurseryBinding];
    )

    Service TrayLookup
    (
      path: '/trays/{trayCode}';
      method: GET;
      parameters:
      (
        trayCode: String ( location = path ),
        shelf: String ( location = query )
      );
      security: [];
      response: [test::cedarsummit::domain::TrayRecord <- test::cedarsummit::binding::NurseryBinding];
    )

    Service LotLookup
    (
      path: '/lots/{lotReference}';
      method: GET;
      parameters:
      (
        lotReference: String ( location = path ),
        sownOn: String ( location = query )
      );
      security: [];
      response: [test::cedarsummit::domain::LotRecord <- test::cedarsummit::binding::NurseryBinding];
    )
  )
)
