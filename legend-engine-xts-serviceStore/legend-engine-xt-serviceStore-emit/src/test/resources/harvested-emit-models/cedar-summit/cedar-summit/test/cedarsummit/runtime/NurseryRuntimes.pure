###Runtime
Runtime test::cedarsummit::runtime::NorthNurseryRuntime
{
  mappings:
  [
    test::cedarsummit::mapping::SeedlingLookupMapping
  ];
  connections:
  [
    test::cedarsummit::store::NurseryApi:
    [
      northNurseryConnection: test::cedarsummit::connection::NorthNurseryConnection
    ]
  ];
}

