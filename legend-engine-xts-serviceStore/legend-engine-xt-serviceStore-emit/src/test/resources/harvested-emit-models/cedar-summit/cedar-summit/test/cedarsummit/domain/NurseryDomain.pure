###Pure
import test::cedarsummit::domain::*;

Class test::cedarsummit::domain::SeedlingRecord
{
  trayCode: String[1];
  greenhouseZone: String[1];
  batchLabel: String[1];
  cultivarName: String[1];
  sowingDate: StrictDate[0..1];
  lotReference: String[0..1];
}

Class test::cedarsummit::domain::TrayRecord
{
  trayCode: String[1];
  shelfLabel: String[1];
  seedCount: Integer[0..1];
}

Class test::cedarsummit::domain::LotRecord
{
  lotReference: String[1];
  sownOnText: String[1];
  sownOn: StrictDate[0..1];
  custodianNote: String[0..1];
  identity: LotIdentity[0..1];
}

Class test::cedarsummit::domain::LotIdentity
{
  lotKey: String[1];
  lotKeyAlternate: String[0..1];
}

Class test::cedarsummit::domain::SeedlingEnvelope
{
  payload: SeedlingRecord[*];
}

Class test::cedarsummit::domain::TrayEnvelope
{
  payload: TrayRecord[*];
}

Class test::cedarsummit::domain::LotEnvelope
{
  payload: LotRecord[*];
}

Class test::cedarsummit::domain::LookupPair
{
  fieldName: String[1];
  fieldValue: String[1];
}

Class test::cedarsummit::domain::LookupCriteria
{
  sowingDate: StrictDate[0..1];
  lotReference: String[0..1];
}

Class test::cedarsummit::domain::LookupRequest
{
  criteria: LookupCriteria[1];
}
