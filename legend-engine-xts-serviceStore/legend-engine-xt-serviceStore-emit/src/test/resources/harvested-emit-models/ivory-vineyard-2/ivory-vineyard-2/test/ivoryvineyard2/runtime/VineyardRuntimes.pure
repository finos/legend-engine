###Runtime
Runtime test::ivoryvineyard2::runtime::VineyardH2Runtime
{
  mappings:
  [
    test::ivoryvineyard2::mapping::VineyardMapping
  ];
  connections:
  [
    test::ivoryvineyard2::store::VineyardDB:
    [
      h2Connection: test::ivoryvineyard2::connection::VineyardH2Connection
    ]
  ];
}

###Runtime
Runtime test::ivoryvineyard2::runtime::PressDigestRuntime
{
  mappings:
  [
    test::ivoryvineyard2::mapping::PressDigestM2M
  ];
  connections:
  [
    test::ivoryvineyard2::store::PressExchangeApi:
    [
      pressExchangeApiConnection: test::ivoryvineyard2::connection::PressExchangeApiConnection
    ],
    ModelStore:
    [
      pressDocConnection: test::ivoryvineyard2::connection::PressDocConnection,
      panelDocConnection: test::ivoryvineyard2::connection::PanelDocConnection
    ]
  ];
}
