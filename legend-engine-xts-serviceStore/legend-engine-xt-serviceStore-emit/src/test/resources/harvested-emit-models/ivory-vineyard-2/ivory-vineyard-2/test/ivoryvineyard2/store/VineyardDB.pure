###Relational
Database test::ivoryvineyard2::store::VineyardDB
(
  Schema vine
  (
    Table parcel
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      parcel_id INTEGER PRIMARY KEY,
      parcel_code VARCHAR(20) NOT NULL,
      trellis_code VARCHAR(20) NOT NULL,
      slope_pct DOUBLE NOT NULL,
      grade_id INTEGER NOT NULL,
      block_code VARCHAR(20),
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
    Table grade
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z),
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      grade_id INTEGER PRIMARY KEY,
      grade_code VARCHAR(20) NOT NULL,
      panel_id INTEGER NOT NULL,
      in_z DATE NOT NULL,
      out_z DATE NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
    Table panel
    (
      panel_id INTEGER PRIMARY KEY,
      panel_name VARCHAR(60) NOT NULL,
      warden_name VARCHAR(60) NOT NULL
    )
    Table press_run
    (
      run_id INTEGER PRIMARY KEY,
      run_code VARCHAR(20) NOT NULL,
      parcel_code VARCHAR(20),
      run_kind VARCHAR(20) NOT NULL,
      juice_litres DOUBLE,
      must_kg INTEGER,
      region_code VARCHAR(20)
    )
    Table harvest_lot
    (
      lot_id INTEGER PRIMARY KEY,
      lot_code VARCHAR(20) NOT NULL,
      region_code VARCHAR(20),
      tonnes INTEGER
    )
  )

  Filter BasketRuns(vine.press_run.run_kind = 'BASKET')
  Filter BladderRuns(vine.press_run.run_kind = 'BLADDER')
  Filter NorthLots(vine.harvest_lot.region_code = 'REG-N')
  Filter SouthLots(vine.harvest_lot.region_code = 'REG-S')

  Join Parcel_Grade(vine.parcel.grade_id = vine.grade.grade_id)

  Join Grade_Panel(vine.grade.panel_id = vine.panel.panel_id)
)
