###Service
Service test::ivoryvineyard2::service::BasketPressRegister
{
  pattern: '/ivoryvineyard/v1/basket-press-register';
  title: 'Ivory Vineyard - Basket Press Register';
  ownership: UserList { users: ['vineyard-press-desk'] };
  documentation: 'Register of the basket-press runs only, reached by casting the polymorphic press-run extent down to the basket subtype so the subtype-only label is projected, with a caller-named region and a standing region struck out by a negated membership test.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: {excludeRegion: String[1]|test::ivoryvineyard2::domain::PressRun.all()->subType(@test::ivoryvineyard2::domain::BasketPress)->filter(
      r|($r.basketLabel->isNotEmpty()) && !($r.regionCode->toOne()->in([$excludeRegion, 'REG-X']))
    )->project(
      [
        r|$r.runCode,
        r|$r.parcelCode,
        r|$r.basketLabel,
        r|$r.mustKg
      ],
      [
        'Run',
        'Parcel',
        'Label',
        'MustKg'
      ]
    )->sort([asc('Run')])};
    mapping: test::ivoryvineyard2::mapping::VineyardMapping;
    runtime: test::ivoryvineyard2::runtime::VineyardH2Runtime;
  }
  testSuites:
  [
    basketPressRegisterSuite:
    {
      data:
      [
        connections:
        [
          h2Connection:
            Relational
            #{
              vine.press_run:
                'run_id,run_code,parcel_code,run_kind,juice_litres,must_kg,region_code\n'+
                '1,PR-01,PC-01,BASKET,120.5,300,REG-N\n'+
                '2,PR-02,PC-01,BLADDER,80.25,220,REG-N\n'+
                '3,PR-03,PC-03,BASKET,40.5,110,REG-S\n'+
                '4,PR-04,PC-03,BLADDER,15.75,60,REG-S\n'+
                '5,PR-05,PC-04,BASKET,55.5,150,REG-X\n';
            }#
        ]
      ]
      tests:
      [
        oneRegionStruckFromTheRegister:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            excludeRegion = 'REG-S'
          ]
          asserts:
          [
            onlyTheNorthernBasketRun:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Run":"PR-01","Parcel":"PC-01","Label":"BASKET-PR-01","MustKg":300}]';
                  }#;
              }#
          ]
        },
        aStruckRegionThatMatchesNothing:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            excludeRegion = 'REG-Q'
          ]
          asserts:
          [
            bothClaimedBasketRuns:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Run":"PR-01","Parcel":"PC-01","Label":"BASKET-PR-01","MustKg":300},{"Run":"PR-03","Parcel":"PC-03","Label":"BASKET-PR-03","MustKg":110}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
