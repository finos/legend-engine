###Service
Service test::ivoryvineyard2::service::PressYieldRollup
{
  pattern: '/ivoryvineyard/v1/press-yield-rollup';
  title: 'Ivory Vineyard - Press Yield Rollup By Region';
  ownership: UserList { users: ['vineyard-press-desk'] };
  documentation: 'Pressed litres and run counts per region over the polymorphic press-run extent, so both press sets are read through the inheritance operation before a membership test and a caller-supplied floor narrow the rows that reach the grouping.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: {minLitres: Float[1]|test::ivoryvineyard2::domain::PressRun.all()->filter(
      r|($r.regionCode->toOne()->in(['REG-N', 'REG-S'])) && ($r.juiceLitres->toOne() > $minLitres)
    )->groupBy(
      [
        r|$r.regionCode->toOne()
      ],
      [
        agg(r|$r.juiceLitres->toOne(), y|$y->sum()),
        agg(r|$r.runCode, y|$y->count())
      ],
      [
        'Region',
        'TotalLitres',
        'Runs'
      ]
    )->sort([asc('Region')])};
    mapping: test::ivoryvineyard2::mapping::VineyardMapping;
    runtime: test::ivoryvineyard2::runtime::VineyardH2Runtime;
  }
  testSuites:
  [
    pressYieldRollupSuite:
    {
      data:
      [
        connections:
        [
          h2Connection:
            Relational
            #{
              vine.press_run:
                'run_id,run_code,parcel_code,run_kind,juice_litres,must_kg,region_code\n'+
                '1,PR-01,PC-01,BASKET,120.5,300,REG-N\n'+
                '2,PR-02,PC-01,BLADDER,80.25,220,REG-N\n'+
                '3,PR-03,PC-03,BASKET,40.5,110,REG-S\n'+
                '4,PR-04,PC-03,BLADDER,15.75,60,REG-S\n'+
                '5,PR-05,PC-04,BASKET,55.5,150,REG-X\n';
            }#
        ]
      ]
      tests:
      [
        regionTotalsAboveTheFloor:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            minLitres = 30.0
          ]
          asserts:
          [
            twoRegionsOneOfThemSingleRun:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Region":"REG-N","TotalLitres":200.75,"Runs":2},{"Region":"REG-S","TotalLitres":40.5,"Runs":1}]';
                  }#;
              }#
          ]
        },
        aFloorNoRunClears:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            minLitres = 500.0
          ]
          asserts:
          [
            nothingIsGrouped:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
