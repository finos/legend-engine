###ServiceStore
ServiceStore test::ivoryvineyard2::store::PressExchangeApi
(
  description: 'Remote read-only endpoint set publishing press-run and tasting-panel documents for the vineyard exchange.';

  ServiceGroup PressServices
  (
    path: '/vineyard/press-runs';

    Service PressFeedService
    (
      path: '/feed';
      method: GET;
      security: [];
      response: [test::ivoryvineyard2::external::PressDoc <- test::ivoryvineyard2::binding::PressExchangeBinding];
    )

    Service PressLookupService
    (
      path: '/{runRef}/detail';
      method: GET;
      parameters:
      (
        runRef: String ( location = path )
      );
      security: [];
      response: [test::ivoryvineyard2::external::PressDoc <- test::ivoryvineyard2::binding::PressExchangeBinding];
    )

    Service PressSearchService
    (
      path: '/search';
      method: GET;
      parameters:
      (
        kind: String ( location = query ),
        regionFilter: String ( location = query )
      );
      security: [];
      response: [test::ivoryvineyard2::external::PressDoc <- test::ivoryvineyard2::binding::PressExchangeBinding];
    )
  )

  ServiceGroup PanelServices
  (
    path: '/vineyard/panels';

    Service PanelFeedService
    (
      path: '/feed';
      method: GET;
      security: [];
      response: [test::ivoryvineyard2::external::PanelDoc <- test::ivoryvineyard2::binding::PanelExchangeBinding];
    )

    Service PanelLookupService
    (
      path: '/{panelRef}';
      method: GET;
      parameters:
      (
        panelRef: String ( location = path )
      );
      security: [];
      response: [test::ivoryvineyard2::external::PanelDoc <- test::ivoryvineyard2::binding::PanelExchangeBinding];
    )
  )
)
