###Mapping
Mapping test::ivoryvineyard2::mapping::VineyardMapping
(
  *test::ivoryvineyard2::domain::Parcel[parcel]: Relational
  {
    ~primaryKey
    (
      [test::ivoryvineyard2::store::VineyardDB]vine.parcel.parcel_id
    )
    ~mainTable [test::ivoryvineyard2::store::VineyardDB]vine.parcel
    parcelCode: [test::ivoryvineyard2::store::VineyardDB]vine.parcel.parcel_code,
    trellisCode: [test::ivoryvineyard2::store::VineyardDB]vine.parcel.trellis_code,
    slopePct: [test::ivoryvineyard2::store::VineyardDB]vine.parcel.slope_pct,
    blockCode: [test::ivoryvineyard2::store::VineyardDB]vine.parcel.block_code
  }

  *test::ivoryvineyard2::domain::ParcelGrade[grade]: Relational
  {
    ~primaryKey
    (
      [test::ivoryvineyard2::store::VineyardDB]vine.grade.grade_id
    )
    ~mainTable [test::ivoryvineyard2::store::VineyardDB]vine.grade
    gradeCode: [test::ivoryvineyard2::store::VineyardDB]vine.grade.grade_code
  }

  *test::ivoryvineyard2::domain::TastingPanel[panel]: Relational
  {
    ~primaryKey
    (
      [test::ivoryvineyard2::store::VineyardDB]vine.panel.panel_id
    )
    ~mainTable [test::ivoryvineyard2::store::VineyardDB]vine.panel
    panelName: [test::ivoryvineyard2::store::VineyardDB]vine.panel.panel_name,
    wardenName: [test::ivoryvineyard2::store::VineyardDB]vine.panel.warden_name
  }

  *test::ivoryvineyard2::domain::PressRun: Operation
  {
    meta::pure::router::operations::inheritance_OperationSetImplementation_1__SetImplementation_MANY_(basketSet, bladderSet)
  }

  *test::ivoryvineyard2::domain::BasketPress[basketSet]: Relational
  {
    ~filter [test::ivoryvineyard2::store::VineyardDB]BasketRuns
    ~primaryKey
    (
      [test::ivoryvineyard2::store::VineyardDB]vine.press_run.run_id
    )
    ~mainTable [test::ivoryvineyard2::store::VineyardDB]vine.press_run
    runCode: [test::ivoryvineyard2::store::VineyardDB]vine.press_run.run_code,
    parcelCode: [test::ivoryvineyard2::store::VineyardDB]vine.press_run.parcel_code,
    juiceLitres: [test::ivoryvineyard2::store::VineyardDB]vine.press_run.juice_litres,
    mustKg: [test::ivoryvineyard2::store::VineyardDB]vine.press_run.must_kg,
    regionCode: [test::ivoryvineyard2::store::VineyardDB]vine.press_run.region_code,
    basketLabel: concat('BASKET-', [test::ivoryvineyard2::store::VineyardDB]vine.press_run.run_code)
  }

  *test::ivoryvineyard2::domain::BladderPress[bladderSet]: Relational
  {
    ~filter [test::ivoryvineyard2::store::VineyardDB]BladderRuns
    ~primaryKey
    (
      [test::ivoryvineyard2::store::VineyardDB]vine.press_run.run_id
    )
    ~mainTable [test::ivoryvineyard2::store::VineyardDB]vine.press_run
    runCode: [test::ivoryvineyard2::store::VineyardDB]vine.press_run.run_code,
    parcelCode: [test::ivoryvineyard2::store::VineyardDB]vine.press_run.parcel_code,
    juiceLitres: [test::ivoryvineyard2::store::VineyardDB]vine.press_run.juice_litres,
    mustKg: [test::ivoryvineyard2::store::VineyardDB]vine.press_run.must_kg,
    regionCode: [test::ivoryvineyard2::store::VineyardDB]vine.press_run.region_code,
    bladderLabel: concat('BLADDER-', [test::ivoryvineyard2::store::VineyardDB]vine.press_run.run_code)
  }

  *test::ivoryvineyard2::domain::HarvestLot[lot]: Operation
  {
    meta::pure::router::operations::union_OperationSetImplementation_1__SetImplementation_MANY_(lotNorth, lotSouth)
  }

  test::ivoryvineyard2::domain::HarvestLot[lotNorth]: Relational
  {
    ~filter [test::ivoryvineyard2::store::VineyardDB]NorthLots
    ~primaryKey
    (
      [test::ivoryvineyard2::store::VineyardDB]vine.harvest_lot.lot_id
    )
    ~mainTable [test::ivoryvineyard2::store::VineyardDB]vine.harvest_lot
    lotCode: concat('N-', [test::ivoryvineyard2::store::VineyardDB]vine.harvest_lot.lot_code),
    regionCode: [test::ivoryvineyard2::store::VineyardDB]vine.harvest_lot.region_code,
    tonnes: [test::ivoryvineyard2::store::VineyardDB]vine.harvest_lot.tonnes
  }

  test::ivoryvineyard2::domain::HarvestLot[lotSouth]: Relational
  {
    ~filter [test::ivoryvineyard2::store::VineyardDB]SouthLots
    ~primaryKey
    (
      [test::ivoryvineyard2::store::VineyardDB]vine.harvest_lot.lot_id
    )
    ~mainTable [test::ivoryvineyard2::store::VineyardDB]vine.harvest_lot
    lotCode: concat('S-', [test::ivoryvineyard2::store::VineyardDB]vine.harvest_lot.lot_code),
    regionCode: [test::ivoryvineyard2::store::VineyardDB]vine.harvest_lot.region_code,
    tonnes: [test::ivoryvineyard2::store::VineyardDB]vine.harvest_lot.tonnes
  }

  test::ivoryvineyard2::domain::Parcel_Grade: Relational
  {
    AssociationMapping
    (
      grade[parcel, grade]: [test::ivoryvineyard2::store::VineyardDB]@Parcel_Grade,
      parcels[grade, parcel]: [test::ivoryvineyard2::store::VineyardDB]@Parcel_Grade
    )
  }

  test::ivoryvineyard2::domain::Grade_Panel: Relational
  {
    AssociationMapping
    (
      panel[grade, panel]: [test::ivoryvineyard2::store::VineyardDB]@Grade_Panel,
      grades[panel, grade]: [test::ivoryvineyard2::store::VineyardDB]@Grade_Panel
    )
  }

  testSuites:
  [
    harvestLotUnionSuite:
    {
      function: |test::ivoryvineyard2::domain::HarvestLot.all()->project(
        [
          l|$l.lotCode,
          l|$l.regionCode,
          l|$l.tonnes
        ],
        [
          'Lot',
          'Region',
          'Tonnes'
        ]
      )->sort([asc('Lot')]);
      tests:
      [
        unionRoutesBothRegionsAndDropsTheUnclaimedLot:
        {
          doc: 'Reads the harvest-lot extent through the union of the two region-filtered sets, each stamping its own prefix on the lot code, and leaves the lot whose region matches neither branch out of the result.';
          data:
          [
            test::ivoryvineyard2::store::VineyardDB:
              Relational
              #{
                vine.harvest_lot:
                  'lot_id,lot_code,region_code,tonnes\n'+
                  '1,HL-1,REG-N,12\n'+
                  '2,HL-2,REG-S,8\n'+
                  '3,HL-3,REG-X,5\n';
              }#
          ];
          asserts:
          [
            lotRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Lot":"N-HL-1","Region":"REG-N","Tonnes":12},{"Lot":"S-HL-2","Region":"REG-S","Tonnes":8}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
