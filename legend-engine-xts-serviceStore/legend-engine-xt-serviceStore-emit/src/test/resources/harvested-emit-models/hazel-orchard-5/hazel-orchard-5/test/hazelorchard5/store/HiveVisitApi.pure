###ServiceStore
ServiceStore test::hazelorchard5::store::HiveVisitApi
(
  description: 'Remote orchard pollination endpoints: a hive-visit feed whose documents are bound through the shared document binding, and a typed search endpoint declaring its query parameters and request body.';

  ServiceGroup PollinationServices
  (
    path: '/pollination';

    Service HiveVisitFeedService
    (
      path: '/hive-visits';
      method: GET;
      security: [];
      response: [test::hazelorchard5::domain::HiveVisitEntry <- test::hazelorchard5::external::OrchardDocumentBinding];
    )

    Service HiveVisitSearchService
    (
      path: '/hive-visits/search';
      method: POST;
      parameters:
      (
        orchardCode: String ( location = query ),
        seasonLabel: String ( location = query ),
        includeRetired: Boolean ( location = query )
      );
      security: [];
      requestBody: test::hazelorchard5::domain::HiveVisitQuery <- test::hazelorchard5::external::OrchardDocumentBinding;
      response: [test::hazelorchard5::domain::HiveVisitEnvelope <- test::hazelorchard5::external::OrchardDocumentBinding];
    )
  )
)
