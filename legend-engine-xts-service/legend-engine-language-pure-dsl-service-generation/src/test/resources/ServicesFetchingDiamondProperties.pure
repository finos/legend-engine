###Pure
Class test::diamond::BaseFeature
{
  id: String[1];
  processingDate: StrictDate[0..1];
}

Class test::diamond::BaseSelection
{
  selectionMethod: String[0..1];
  processingDate: StrictDate[0..1];
}

Class test::diamond::Feature extends test::diamond::BaseFeature, test::diamond::BaseSelection
{
  name: String[1];
}

Class test::diamond::Source
{
  id: String[1];
  name: String[1];
  selectionMethod: String[0..1];
  processingDate: StrictDate[0..1];
}


###Mapping
Mapping test::diamond::Map
(
  *test::diamond::Feature: Pure
  {
    ~src test::diamond::Source
    id: $src.id,
    name: $src.name,
    selectionMethod: $src.selectionMethod,
    processingDate: $src.processingDate
  }
)


###Runtime
Runtime test::diamond::Runtime
{
  mappings:
  [
    test::diamond::Map
  ];
  connections:
  [
    ModelStore:
    [
      connection_1:
      #{
        JsonModelConnection
        {
          class: test::diamond::Source;
          url: 'data:application/json,{"id":"F1","name":"n"}';
        }
      }#
    ]
  ];
}


###Service
Service test::diamond::FetchesProcessingDate
{
  pattern: '/test/diamond/processingDate';
  documentation: '';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |test::diamond::Feature.all()->graphFetch(#{test::diamond::Feature{id,processingDate}}#)->serialize(#{test::diamond::Feature{id,processingDate}}#);
    mapping: test::diamond::Map;
    runtime: test::diamond::Runtime;
  }
}

Service test::diamond::FetchesName
{
  pattern: '/test/diamond/name';
  documentation: '';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |test::diamond::Feature.all()->graphFetch(#{test::diamond::Feature{id,name}}#)->serialize(#{test::diamond::Feature{id,name}}#);
    mapping: test::diamond::Map;
    runtime: test::diamond::Runtime;
  }
}
