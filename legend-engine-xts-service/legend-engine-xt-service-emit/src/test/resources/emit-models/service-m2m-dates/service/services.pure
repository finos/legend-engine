// Dates in the queries of services over a model-to-model mapping, written into
// the query and given as parameters. No time zone is named anywhere, so every
// date-time is read, compared, and written in UTC.

###Service
// A calendar date compared with a StrictDate property.
Service demo::m2m::dates::service::TradesOnDateLiteral
{
  pattern: '/api/m2m/dates/trades/on';
  documentation: 'Trades made on a date, written into the query.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |demo::m2m::dates::Trade.all()->filter(t|$t.tradeDate == %2025-07-02)->graphFetch(#{demo::m2m::dates::Trade{id, tradeDate}}#)->serialize(#{demo::m2m::dates::Trade{id, tradeDate}}#);
    mapping: demo::m2m::dates::TradeMapping;
    runtime: demo::m2m::dates::runtime::TradeRuntime;
  }
  testSuites:
  [
    tradeSuite:
    {
      data:
      [
        connections:
        [
          connection_1:
            Reference
            #{
              demo::m2m::dates::data::Trades
            }#
        ]
      ]
      tests:
      [
        secondOfJuly:
        {
          serializationFormat: PURE;
          asserts:
          [
            shouldReturnThatDaysTrades:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":3,"tradeDate":"2025-07-02"},{"id":4,"tradeDate":"2025-07-02"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service demo::m2m::dates::service::TradesOnDateParameter
{
  pattern: '/api/m2m/dates/trades/on/{tradeDate}';
  documentation: 'Trades made on a date, given as a parameter.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {tradeDate: StrictDate[1]|demo::m2m::dates::Trade.all()->filter(t|$t.tradeDate == $tradeDate)->graphFetch(#{demo::m2m::dates::Trade{id, tradeDate}}#)->serialize(#{demo::m2m::dates::Trade{id, tradeDate}}#)};
    mapping: demo::m2m::dates::TradeMapping;
    runtime: demo::m2m::dates::runtime::TradeRuntime;
  }
  testSuites:
  [
    tradeSuite:
    {
      data:
      [
        connections:
        [
          connection_1:
            Reference
            #{
              demo::m2m::dates::data::Trades
            }#
        ]
      ]
      tests:
      [
        secondOfJuly:
        {
          serializationFormat: PURE;
          parameters:
          [
            tradeDate = %2025-07-02
          ]
          asserts:
          [
            shouldReturnThatDaysTrades:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":3,"tradeDate":"2025-07-02"},{"id":4,"tradeDate":"2025-07-02"}]';
                  }#;
              }#
          ]
        },
        firstOfJuly:
        {
          serializationFormat: PURE;
          parameters:
          [
            tradeDate = %2025-07-01
          ]
          asserts:
          [
            shouldReturnThatDaysTrades:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":1,"tradeDate":"2025-07-01"},{"id":2,"tradeDate":"2025-07-01"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

// A date-time compared with a DateTime property. Trade 2 was executed at
// 01:30 UTC on 2025-07-02, though its feed gives the time with a New York
// offset; a cutoff of 01:00 UTC leaves it out only if that offset was
// honored when the feed was read.
Service demo::m2m::dates::service::TradesExecutedBeforeLiteral
{
  pattern: '/api/m2m/dates/trades/before';
  documentation: 'Trades executed before a moment, written into the query.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |demo::m2m::dates::Trade.all()->filter(t|$t.executedAt < %2025-07-02T15:00:00+0000)->graphFetch(#{demo::m2m::dates::Trade{id, executedAt}}#)->serialize(#{demo::m2m::dates::Trade{id, executedAt}}#);
    mapping: demo::m2m::dates::TradeMapping;
    runtime: demo::m2m::dates::runtime::TradeRuntime;
  }
  testSuites:
  [
    tradeSuite:
    {
      data:
      [
        connections:
        [
          connection_1:
            Reference
            #{
              demo::m2m::dates::data::Trades
            }#
        ]
      ]
      tests:
      [
        afternoonUtc:
        {
          serializationFormat: PURE;
          asserts:
          [
            shouldReturnTradesExecutedEarlier:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":1,"executedAt":"2025-07-01T16:00:00.000"},{"id":2,"executedAt":"2025-07-02T01:30:00.000"},{"id":3,"executedAt":"2025-07-02T13:00:00.000"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service demo::m2m::dates::service::TradesExecutedBeforeParameter
{
  pattern: '/api/m2m/dates/trades/before/{cutoff}';
  documentation: 'Trades executed before a moment, given as a parameter.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {cutoff: DateTime[1]|demo::m2m::dates::Trade.all()->filter(t|$t.executedAt < $cutoff)->graphFetch(#{demo::m2m::dates::Trade{id, executedAt}}#)->serialize(#{demo::m2m::dates::Trade{id, executedAt}}#)};
    mapping: demo::m2m::dates::TradeMapping;
    runtime: demo::m2m::dates::runtime::TradeRuntime;
  }
  testSuites:
  [
    tradeSuite:
    {
      data:
      [
        connections:
        [
          connection_1:
            Reference
            #{
              demo::m2m::dates::data::Trades
            }#
        ]
      ]
      tests:
      [
        afternoonUtc:
        {
          serializationFormat: PURE;
          parameters:
          [
            cutoff = %2025-07-02T15:00:00+0000
          ]
          asserts:
          [
            shouldReturnTradesExecutedEarlier:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":1,"executedAt":"2025-07-01T16:00:00.000"},{"id":2,"executedAt":"2025-07-02T01:30:00.000"},{"id":3,"executedAt":"2025-07-02T13:00:00.000"}]';
                  }#;
              }#
          ]
        },
        justAfterMidnightUtc:
        {
          serializationFormat: PURE;
          parameters:
          [
            cutoff = %2025-07-02T01:00:00+0000
          ]
          asserts:
          [
            shouldReturnTradesExecutedEarlier:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"id":1,"executedAt":"2025-07-01T16:00:00.000"}';
                  }#;
              }#
          ]
        },
        afternoonUtcWrittenWithAnOffset:
        {
          serializationFormat: PURE;
          parameters:
          [
            cutoff = %2025-07-02T11:00:00-0400
          ]
          asserts:
          [
            shouldReturnTradesExecutedEarlier:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":1,"executedAt":"2025-07-01T16:00:00.000"},{"id":2,"executedAt":"2025-07-02T01:30:00.000"},{"id":3,"executedAt":"2025-07-02T13:00:00.000"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

// The cutoff of the TradesExecutedBefore services, written as 11:00 at an
// offset of -0400. An offset is resolved when the literal is compiled, so
// this is the same instant as 15:00 UTC and must select the same trades. It
// is a second spelling of one moment, not a time zone.
Service demo::m2m::dates::service::TradesExecutedBeforeWrittenWithAnOffset
{
  pattern: '/api/m2m/dates/trades/before/offset';
  documentation: 'Trades executed before a moment written with an offset.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |demo::m2m::dates::Trade.all()->filter(t|$t.executedAt < %2025-07-02T11:00:00-0400)->graphFetch(#{demo::m2m::dates::Trade{id, executedAt}}#)->serialize(#{demo::m2m::dates::Trade{id, executedAt}}#);
    mapping: demo::m2m::dates::TradeMapping;
    runtime: demo::m2m::dates::runtime::TradeRuntime;
  }
  testSuites:
  [
    tradeSuite:
    {
      data:
      [
        connections:
        [
          connection_1:
            Reference
            #{
              demo::m2m::dates::data::Trades
            }#
        ]
      ]
      tests:
      [
        afternoonUtc:
        {
          serializationFormat: PURE;
          asserts:
          [
            shouldReturnTradesExecutedEarlier:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":1,"executedAt":"2025-07-01T16:00:00.000"},{"id":2,"executedAt":"2025-07-02T01:30:00.000"},{"id":3,"executedAt":"2025-07-02T13:00:00.000"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

// Trade is not milestoned, so the date reaches Product only through the
// milestoned property the graph fetch names. The feed carries every version
// of each product, and the date selects the one recorded for it: on
// 2025-07-02, Widget Mk2 for the Widget trades and none for the Gadget
// trades, whose product has no version that day.
//
// A graph fetch names each field when the plan is generated, from the text of
// the query, so a date written in names the field for that date, and a date
// given as a parameter names it product($businessDate) whatever the date is.
Service demo::m2m::dates::service::TradeProductsAsOfLiteral
{
  pattern: '/api/m2m/dates/trades/products';
  documentation: 'Trades with their product as of a business date, written into the query.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |demo::m2m::dates::Trade.all()->graphFetch(#{demo::m2m::dates::Trade{id, product(%2025-07-02){name, businessDate}}}#)->serialize(#{demo::m2m::dates::Trade{id, product(%2025-07-02){name, businessDate}}}#);
    mapping: demo::m2m::dates::TradeMapping;
    runtime: demo::m2m::dates::runtime::TradeRuntime;
  }
  testSuites:
  [
    tradeSuite:
    {
      data:
      [
        connections:
        [
          connection_1:
            Reference
            #{
              demo::m2m::dates::data::Trades
            }#
        ]
      ]
      tests:
      [
        secondOfJuly:
        {
          serializationFormat: PURE;
          asserts:
          [
            shouldReadTheVersionOnThatDate:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":1,"product(2025-07-02)":{"name":"Widget Mk2","businessDate":"2025-07-02"}},{"id":2,"product(2025-07-02)":null},{"id":3,"product(2025-07-02)":{"name":"Widget Mk2","businessDate":"2025-07-02"}},{"id":4,"product(2025-07-02)":null},{"id":5,"product(2025-07-02)":{"name":"Widget Mk2","businessDate":"2025-07-02"}}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service demo::m2m::dates::service::TradeProductsAsOfParameter
{
  pattern: '/api/m2m/dates/trades/products/{businessDate}';
  documentation: 'Trades with their product as of a business date, given as a parameter.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {businessDate: StrictDate[1]|demo::m2m::dates::Trade.all()->graphFetch(#{demo::m2m::dates::Trade{id, product($businessDate){name, businessDate}}}#)->serialize(#{demo::m2m::dates::Trade{id, product($businessDate){name, businessDate}}}#)};
    mapping: demo::m2m::dates::TradeMapping;
    runtime: demo::m2m::dates::runtime::TradeRuntime;
  }
  testSuites:
  [
    tradeSuite:
    {
      data:
      [
        connections:
        [
          connection_1:
            Reference
            #{
              demo::m2m::dates::data::Trades
            }#
        ]
      ]
      tests:
      [
        secondOfJuly:
        {
          serializationFormat: PURE;
          parameters:
          [
            businessDate = %2025-07-02
          ]
          asserts:
          [
            shouldReadTheVersionOnThatDate:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":1,"product($businessDate)":{"name":"Widget Mk2","businessDate":"2025-07-02"}},{"id":2,"product($businessDate)":null},{"id":3,"product($businessDate)":{"name":"Widget Mk2","businessDate":"2025-07-02"}},{"id":4,"product($businessDate)":null},{"id":5,"product($businessDate)":{"name":"Widget Mk2","businessDate":"2025-07-02"}}]';
                  }#;
              }#
          ]
        },
        firstOfJuly:
        {
          serializationFormat: PURE;
          parameters:
          [
            businessDate = %2025-07-01
          ]
          asserts:
          [
            shouldReadTheVersionOnThatDate:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":1,"product($businessDate)":{"name":"Widget","businessDate":"2025-07-01"}},{"id":2,"product($businessDate)":{"name":"Gadget","businessDate":"2025-07-01"}},{"id":3,"product($businessDate)":{"name":"Widget","businessDate":"2025-07-01"}},{"id":4,"product($businessDate)":{"name":"Gadget","businessDate":"2025-07-01"}},{"id":5,"product($businessDate)":{"name":"Widget","businessDate":"2025-07-01"}}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

// The date given as a parameter, with the field given a name of its own in
// the graph fetch, so that its name does not depend on how the query spells
// the date.
Service demo::m2m::dates::service::TradeProductsAsOfParameterAliased
{
  pattern: '/api/m2m/dates/trades/products/aliased/{businessDate}';
  documentation: 'Trades with their product as of a business date given as a parameter, under a field name of its own.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {businessDate: StrictDate[1]|demo::m2m::dates::Trade.all()->graphFetch(#{demo::m2m::dates::Trade{id, 'productOnDate':product($businessDate){name, businessDate}}}#)->serialize(#{demo::m2m::dates::Trade{id, 'productOnDate':product($businessDate){name, businessDate}}}#)};
    mapping: demo::m2m::dates::TradeMapping;
    runtime: demo::m2m::dates::runtime::TradeRuntime;
  }
  testSuites:
  [
    tradeSuite:
    {
      data:
      [
        connections:
        [
          connection_1:
            Reference
            #{
              demo::m2m::dates::data::Trades
            }#
        ]
      ]
      tests:
      [
        secondOfJuly:
        {
          serializationFormat: PURE;
          parameters:
          [
            businessDate = %2025-07-02
          ]
          asserts:
          [
            shouldReadTheVersionOnThatDate:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":1,"productOnDate":{"name":"Widget Mk2","businessDate":"2025-07-02"}},{"id":2,"productOnDate":null},{"id":3,"productOnDate":{"name":"Widget Mk2","businessDate":"2025-07-02"}},{"id":4,"productOnDate":null},{"id":5,"productOnDate":{"name":"Widget Mk2","businessDate":"2025-07-02"}}]';
                  }#;
              }#
          ]
        },
        firstOfJuly:
        {
          serializationFormat: PURE;
          parameters:
          [
            businessDate = %2025-07-01
          ]
          asserts:
          [
            shouldReadTheVersionOnThatDate:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":1,"productOnDate":{"name":"Widget","businessDate":"2025-07-01"}},{"id":2,"productOnDate":{"name":"Gadget","businessDate":"2025-07-01"}},{"id":3,"productOnDate":{"name":"Widget","businessDate":"2025-07-01"}},{"id":4,"productOnDate":{"name":"Gadget","businessDate":"2025-07-01"}},{"id":5,"productOnDate":{"name":"Widget","businessDate":"2025-07-01"}}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
