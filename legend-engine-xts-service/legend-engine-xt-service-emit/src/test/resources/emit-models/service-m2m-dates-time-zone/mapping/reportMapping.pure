// A report of each trade that gives its execution time as the clocks in two
// cities read it, written as the mapping builds the report.

###Pure
Class demo::m2m::dates::TradeReport
{
  id: Integer[1];
  executedAt: DateTime[1];
  newYorkTime: String[1];
  kolkataTime: String[1];
}

###Mapping
Mapping demo::m2m::dates::TradeReportMapping
(
  *demo::m2m::dates::TradeReport: Pure
  {
    ~src demo::m2m::dates::source::S_Trade
    id: $src.id,
    executedAt: $src.executedAt,
    newYorkTime: $src.executedAt->convertTimeZone('America/New_York', 'yyyy-MM-dd HH:mm:ss z'),
    kolkataTime: format('%t{[Asia/Kolkata]yyyy-MM-dd HH:mm:ss z}', [$src.executedAt])
  }
)

###Runtime
Runtime demo::m2m::dates::runtime::TradeReportRuntime
{
  mappings:
  [
    demo::m2m::dates::TradeReportMapping
  ];
  connections:
  [
    ModelStore:
    [
      connection_1:
      #{
        JsonModelConnection
        {
          class: demo::m2m::dates::source::S_Trade;
          url: 'executor:default';
        }
      }#
    ]
  ];
}
