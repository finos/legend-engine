// Both the execution times and the moment are converted to New York dates
// before they are compared. 02:00 UTC on 2025-07-02 is still 2025-07-01 in
// New York, and so is the execution of trade 2 at 01:30 UTC, which comparing
// UTC dates would put on the wrong day.
Service demo::m2m::dates::zoned::service::TradesOnNewYorkDayLiteral
{
  pattern: '/api/m2m/dates/zoned/trades/new-york-day';
  documentation: 'Trades executed on the New York calendar day of a moment, written into the query.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |demo::m2m::dates::Trade.all()->filter(t|$t.executedAt->convertTimeZone('America/New_York', 'yyyy-MM-dd') == %2025-07-02T02:00:00+0000->convertTimeZone('America/New_York', 'yyyy-MM-dd'))->graphFetch(#{demo::m2m::dates::Trade{id, executedAt}}#)->serialize(#{demo::m2m::dates::Trade{id, executedAt}}#);
    mapping: demo::m2m::dates::TradeMapping;
    runtime: demo::m2m::dates::runtime::TradeRuntime;
  }
  testSuites:
  [
    tradeSuite:
    {
      data:
      [
        connections:
        [
          connection_1:
            Reference
            #{
              demo::m2m::dates::data::Trades
            }#
        ]
      ]
      tests:
      [
        lateEveningInNewYork:
        {
          serializationFormat: PURE;
          asserts:
          [
            shouldReturnThatNewYorkDaysTrades:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":1,"executedAt":"2025-07-01T16:00:00.000"},{"id":2,"executedAt":"2025-07-02T01:30:00.000"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service demo::m2m::dates::zoned::service::TradesOnNewYorkDayParameter
{
  pattern: '/api/m2m/dates/zoned/trades/new-york-day/{asOf}';
  documentation: 'Trades executed on the New York calendar day of a moment, given as a parameter.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {asOf: DateTime[1]|demo::m2m::dates::Trade.all()->filter(t|$t.executedAt->convertTimeZone('America/New_York', 'yyyy-MM-dd') == $asOf->convertTimeZone('America/New_York', 'yyyy-MM-dd'))->graphFetch(#{demo::m2m::dates::Trade{id, executedAt}}#)->serialize(#{demo::m2m::dates::Trade{id, executedAt}}#)};
    mapping: demo::m2m::dates::TradeMapping;
    runtime: demo::m2m::dates::runtime::TradeRuntime;
  }
  testSuites:
  [
    tradeSuite:
    {
      data:
      [
        connections:
        [
          connection_1:
            Reference
            #{
              demo::m2m::dates::data::Trades
            }#
        ]
      ]
      tests:
      [
        lateEveningInNewYork:
        {
          serializationFormat: PURE;
          parameters:
          [
            asOf = %2025-07-02T02:00:00+0000
          ]
          asserts:
          [
            shouldReturnThatNewYorkDaysTrades:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":1,"executedAt":"2025-07-01T16:00:00.000"},{"id":2,"executedAt":"2025-07-02T01:30:00.000"}]';
                  }#;
              }#
          ]
        },
        middayUtc:
        {
          serializationFormat: PURE;
          parameters:
          [
            asOf = %2025-07-02T12:00:00+0000
          ]
          asserts:
          [
            shouldReturnThatNewYorkDaysTrades:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":3,"executedAt":"2025-07-02T13:00:00.000"},{"id":4,"executedAt":"2025-07-02T18:45:00.000"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
