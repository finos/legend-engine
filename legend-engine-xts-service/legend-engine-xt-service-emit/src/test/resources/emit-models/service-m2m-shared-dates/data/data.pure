// The trade feed every service reads, given to each test suite as test data.
// Each trade carries every version of its product, since a model-to-model test
// can read from one source only. Trade 2 gives its execution time with a New
// York offset, which reading the feed resolves to UTC.

###Data
Data demo::m2m::dates::data::Trades
{
  ExternalFormat
  #{
    contentType: 'application/json';
    data: '[{"id":1,"tradeDate":"2025-07-01","executedAt":"2025-07-01T16:00:00.000+0000","quantity":100,"productAllVersions":[{"id":1,"name":"Widget","businessDate":"2025-07-01"},{"id":1,"name":"Widget Mk2","businessDate":"2025-07-02"}]},{"id":2,"tradeDate":"2025-07-01","executedAt":"2025-07-01T21:30:00.000-0400","quantity":200,"productAllVersions":[{"id":2,"name":"Gadget","businessDate":"2025-07-01"}]},{"id":3,"tradeDate":"2025-07-02","executedAt":"2025-07-02T13:00:00.000+0000","quantity":300,"productAllVersions":[{"id":1,"name":"Widget","businessDate":"2025-07-01"},{"id":1,"name":"Widget Mk2","businessDate":"2025-07-02"}]},{"id":4,"tradeDate":"2025-07-02","executedAt":"2025-07-02T18:45:00.000+0000","quantity":400,"productAllVersions":[{"id":2,"name":"Gadget","businessDate":"2025-07-01"}]},{"id":5,"tradeDate":"2025-07-03","executedAt":"2025-07-03T13:30:00.000+0000","quantity":500,"productAllVersions":[{"id":1,"name":"Widget","businessDate":"2025-07-01"},{"id":1,"name":"Widget Mk2","businessDate":"2025-07-02"}]}]';
  }#
}
