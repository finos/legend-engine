// A trade feed, and the trades read from it. A product is business temporal
// on both sides, so a trade reaches it through a milestoned property, and each
// version of a product in the feed carries the business date it was recorded
// for.

###Pure
Class <<temporal.businesstemporal>> demo::m2m::dates::source::S_Product
{
  id: Integer[1];
  name: String[1];
}

Class demo::m2m::dates::source::S_Trade
{
  id: Integer[1];
  tradeDate: StrictDate[1];
  executedAt: DateTime[1];
  quantity: Integer[1];
  product: demo::m2m::dates::source::S_Product[0..1];
}

Class <<temporal.businesstemporal>> demo::m2m::dates::Product
{
  id: Integer[1];
  name: String[1];
}

Class demo::m2m::dates::Trade
{
  id: Integer[1];
  tradeDate: StrictDate[1];
  executedAt: DateTime[1];
  quantity: Integer[1];
  product: demo::m2m::dates::Product[0..1];
}
