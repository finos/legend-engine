Class {meta::pure::profiles::doc.doc = 'A flat published summary of one night-survey plate: the plate it was exposed on and the leading variable-star sighting recorded on it, with typed defaults where the survey document leaves the answer absent.'} test::emberfjord::domain::PlateSummary
{
  runCode: String[1];
  plateCode: String[0..1];
  stationLabel: String[1];
  leadSighting: String[1];
  faintestMagnitudeMilli: Integer[1];
  sightingCount: Integer[1];
}
