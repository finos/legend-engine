import test::emberfjord::source::*;

Class {meta::pure::profiles::doc.doc = 'An inbound night-survey document as it arrives from an observatory, nesting the station block that carries the plate block.'} test::emberfjord::source::SurveyRunFeed
{
  runCode: String[1];
  station: StationBlock[0..1];
}

Class {meta::pure::profiles::doc.doc = 'The observing station level of the survey document, itself optionally carrying the exposed plate.'} test::emberfjord::source::StationBlock
{
  stationName: String[1];
  plate: PlateBlock[0..1];
}

Class {meta::pure::profiles::doc.doc = 'The plate level of the survey document, with an optional plate identifier and the sightings logged on it.'} test::emberfjord::source::PlateBlock
{
  plateCode: String[0..1];
  sightings: SightingEntry[*];
}

Class {meta::pure::profiles::doc.doc = 'One logged sighting on an exposed plate, whose variability class may be absent from the document.'} test::emberfjord::source::SightingEntry
{
  sightingCode: String[1];
  category: String[0..1];
  magnitudeMilli: Integer[0..1];
}
