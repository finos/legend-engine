import test::ivorybeacon::function::*;

function {meta::pure::profiles::doc.doc = 'Returns one side of a slash-separated survey window token.'} test::ivorybeacon::function::windowPart(window: String[1], index: Integer[1]): String[1]
{
  $window->split('/')->at($index)
}

function {meta::pure::profiles::doc.doc = 'Parses the trailing day-of-month digits of an ISO-like day token into an integral surrogate.'} test::ivorybeacon::function::daySurrogate(dayToken: String[1]): Integer[1]
{
  $dayToken->substring($dayToken->length() - 2, $dayToken->length())->parseInteger()
}

function {meta::pure::profiles::doc.doc = 'Parses a text melt rate into a decimal index, scaled to whole-percent units.'} test::ivorybeacon::function::rateIndex(rateText: String[1]): Float[1]
{
  $rateText->parseFloat() * 100.0
}

function {meta::pure::profiles::doc.doc = 'Bands a melt-rate index for reporting, including the defaulted-negative case.'} test::ivorybeacon::function::gradeBand(index: Float[1]): String[1]
{
  if($index < 0.0,
    | 'UNGRADED',
    | if($index >= 40.0,
      | 'RAPID',
      | if($index >= 15.0,
        | 'STEADY',
        | 'SLOW'
      )
    )
  )
}
