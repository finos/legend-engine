function {meta::pure::profiles::doc.doc = 'Whole executable pipeline as a function: resolves the dossier tree, graph-fetches it, serialises the same tree and binds mapping and runtime explicitly, so a function rather than a service is the entry point for this flow.'} test::ivorybeacon::function::dossierDocument(): String[1]
{
  test::ivorybeacon::domain::SurveyDossier.all()->graphFetch(
      #{
        test::ivorybeacon::domain::SurveyDossier
        {
          dossierId,
          windowLabel,
          readings
          {
            readingCode,
            depthLabel,
            meltRateLabel
          }
        }
      }#
  )->serialize(
      #{
        test::ivorybeacon::domain::SurveyDossier
        {
          dossierId,
          windowLabel,
          readings
          {
            readingCode,
            depthLabel,
            meltRateLabel
          }
        }
      }#
  )->from(
    test::ivorybeacon::mapping::DossierM2M,
    test::ivorybeacon::runtime::DossierRuntime
  )
}
