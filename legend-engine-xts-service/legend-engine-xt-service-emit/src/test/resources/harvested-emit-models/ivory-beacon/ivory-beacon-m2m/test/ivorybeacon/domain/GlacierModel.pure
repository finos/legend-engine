{
  dossierId: String[1];
  windowLabel: String[1];
  readings: DossierReading[*];
}

Class {meta::pure::profiles::doc.doc = 'One reading inside a survey dossier, with its text measurements normalised or defaulted.'} test::ivorybeacon::domain::DossierReading
{
  readingCode: String[1];
