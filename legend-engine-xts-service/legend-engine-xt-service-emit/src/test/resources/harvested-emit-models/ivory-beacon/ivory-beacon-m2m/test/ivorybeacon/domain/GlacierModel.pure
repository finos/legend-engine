Class <<test::ivorybeacon::profile::TopicMetadata.publishedFeed>> {test::ivorybeacon::profile::TopicMetadata.streamTopic = 'glacier.station.snapshot', test::ivorybeacon::profile::TopicMetadata.streamTopic = 'glacier.station.snapshot.replay', test::ivorybeacon::profile::TopicMetadata.retentionWindow = 'P30D', test::ivorybeacon::profile::TopicMetadata.retentionWindow = 'P7D', test::ivorybeacon::profile::TopicMetadata.uniqueIndexPath = 'stationId', test::ivorybeacon::profile::TopicMetadata.uniqueIndexPath = 'stationId,windowStartDay', test::ivorybeacon::profile::TopicMetadata.defaultingRule = 'absent day surrogates default to zero', test::ivorybeacon::profile::TopicMetadata.defaultingRule = 'absent melt rates default to minus one'} test::ivorybeacon::domain::StationSnapshot
{
  stationId: String[1];
  windowStartDay: Integer[1];
  windowEndDay: Integer[1];
  meltRateIndex: Float[1];
  readingTally: Integer[1];
  siteLabel: String[1];
  terminusAltitude: Integer[1];
  grade: String[1];
  note: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'Flattened descriptor of the site a station report was attached to.'} test::ivorybeacon::domain::SiteDescriptor
{
  descriptorId: String[1];
  label: String[1];
  kind: String[1];
}

