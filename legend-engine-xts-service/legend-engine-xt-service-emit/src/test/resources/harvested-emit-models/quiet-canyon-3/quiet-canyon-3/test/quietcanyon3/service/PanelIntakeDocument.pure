###Service
Service test::quietcanyon3::service::PanelIntakeDocument
{
  pattern: '/quietcanyon3/v1/panel-intake';
  title: 'Quiet Canyon 3 - Checked Panel Intake Document';
  owners:
  [
    'rock-art-survey'
  ];
  documentation: 'Accepts one inbound panel submission and returns a narrower published graph in checked form, so parse and transform defects ride alongside the produced values instead of failing the whole call. Its runtime is declared inline and binds the model store to the same document connection kind as the digest feed, but locally rather than through a shared runtime element.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |test::quietcanyon3::domain::PanelReport.all()->graphFetchChecked(
      #{
        test::quietcanyon3::domain::PanelReport
        {
          surveyRef,
          conditionBand,
          fractureIndex,
          station
          {
            stationCode
          }
        }
      }#
    )->serialize(
      #{
        test::quietcanyon3::domain::PanelReport
        {
          surveyRef,
          conditionBand,
          fractureIndex,
          station
          {
            stationCode
          }
        }
      }#
    );
    mapping: test::quietcanyon3::mapping::CanyonM2M;
    runtime:
    #{
      mappings:
      [
        test::quietcanyon3::mapping::CanyonM2M
      ];
      connections:
      [
        ModelStore:
        [
          panelIntakeConnection:
          #{
            JsonModelConnection
            {
              class: test::quietcanyon3::source::PanelSubmission;
              url: 'data:application/json,%7B%7D';
            }
          }#
        ]
      ];
    }#;
  }
  testSuites:
  [
    panelIntakeSuite:
    {
      data:
      [
        connections:
        [
          panelIntakeConnection:
            ExternalFormat
            #{
              contentType: 'application/json';
              data: '{"surveyRef":"SV-2001","panelCode":"PN-31","integrity":0.55,"phase":"wet season","fractureCount":3,"lichenPct":18.0,"visitedOn":"2026-04-05","station":{"code":"qc-4","sector":{"code":"SEC-D","region":"narrow slot"}}}';
            }#
        ]
      ]
      tests:
      [
        checkedPanelGraph:
        {
          asserts:
          [
            checkedPanelGraphRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":{"defects":[],"source":{"defects":[],"source":{"number":1,"record":"{\\"surveyRef\\":\\"SV-2001\\",\\"panelCode\\":\\"PN-31\\",\\"integrity\\":0.55,\\"phase\\":\\"wet season\\",\\"fractureCount\\":3,\\"lichenPct\\":18.0,\\"visitedOn\\":\\"2026-04-05\\",\\"station\\":{\\"code\\":\\"qc-4\\",\\"sector\\":{\\"code\\":\\"SEC-D\\",\\"region\\":\\"narrow slot\\"}}}"},"value":{"clearanceNotes":[],"fractureCount":3,"integrity":0.55,"panelCode":"PN-31","station":{"code":"qc-4"},"surveyRef":"SV-2001"}},"value":{"surveyRef":"SV-2001","conditionBand":"WEATHERED","fractureIndex":10,"station":{"stationCode":"ST-QC-4"}}}}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
