###Pure
import test::quietcanyon3::source::*;

Class {meta::pure::profiles::doc.doc = 'The sector block nested inside a submitted station block.'} test::quietcanyon3::source::SectorBlock
{
  code: String[0..1];
  region: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'The station block nested inside a submitted panel document.'} test::quietcanyon3::source::StationBlock
{
  code: String[0..1];
  sector: SectorBlock[0..1];
}

Class {meta::pure::profiles::doc.doc = 'An inbound rock-art panel condition submission, delivered to the executor as a serialised document rather than read from a database.'} test::quietcanyon3::source::PanelSubmission
{
  surveyRef: String[1];
  panelCode: String[1];
  integrity: Float[0..1];
  phase: String[0..1];
  fractureCount: Integer[0..1];
  lichenPct: Float[0..1];
  clearanceNotes: String[*];
  visitedOn: StrictDate[0..1];
  station: StationBlock[0..1];
}
