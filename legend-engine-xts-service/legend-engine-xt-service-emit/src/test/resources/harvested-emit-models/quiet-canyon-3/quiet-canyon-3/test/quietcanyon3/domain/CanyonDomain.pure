###Pure
import test::quietcanyon3::domain::*;

Enum {meta::pure::profiles::doc.doc = 'Condition band a panel is published under, banded off the submitted integrity fraction.'} test::quietcanyon3::domain::ConditionBand
{
  PRISTINE,
  STABLE,
  WEATHERED,
  ERODED,
  UNASSESSED
}

Class {meta::pure::profiles::doc.doc = 'The sector a published station sits in.'} test::quietcanyon3::domain::ReportSector
{
  sectorCode: String[1];
  regionLabel: String[1];
}

Class {meta::pure::profiles::doc.doc = 'The station a published panel is registered against.'} test::quietcanyon3::domain::ReportStation
{
  stationCode: String[1];
  sector: ReportSector[0..1];
}

Class {meta::pure::profiles::doc.doc = 'One published rock-art panel condition report, assembled entirely out of transforms over a submitted document.'} test::quietcanyon3::domain::PanelReport
{
  surveyRef: String[1];
  panelCode: String[1];
  conditionBand: ConditionBand[0..1];
  phaseLabel: String[0..1];
  fractureIndex: Integer[0..1];
  lichenLabel: String[0..1];
  clearanceDigest: String[0..1];
  visitedOn: StrictDate[0..1];
  station: ReportStation[0..1];
}
