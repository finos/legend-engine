###Service
Service test::noblehatchery3::service::PropagationAsOf
{
  pattern: '/noblehatchery3/propagationAsOf';
  title: 'Hatchery Propagation Records As Of';
  owners:
  [
    'hatchery-curation'
  ];
  documentation: 'Returns the curated propagation records whose propagation window contains the supplied instant, whose stage is in the requested set and whose batch reference has not been voided, serialised from a property subset of the batch-reference-ordered and size-capped extent. The wing parameter selects which hatchery wing feed the query is executed against, so the same query body is bound to one runtime per wing.';
  autoActivateUpdates: true;
  execution: Multi
  {
    key: 'wing';
    query: {wing: String[1], asOf: DateTime[1], stages: String[*]|test::noblehatchery3::domain::CuratedPropagationRecord.all()->sortBy(r|$r.batchRef)->take(5)->filter(r|((($r.validFrom <= $asOf) && ($r.validThru > $asOf)) && ($r.stageLabel->in($stages))) && ((!($r.batchRef->endsWith('-void')) && $r.notes->isNotEmpty()) && (($r.wingCode == $wing) || ($r.stageLabel->contains('graft')))))->graphFetch(
      #{
        test::noblehatchery3::domain::CuratedPropagationRecord
        {
          batchRef,
          wingCode,
          stageLabel,
          tallyLabel,
          validFrom,
          validThru
        }
      }#
    )->serialize(
      #{
        test::noblehatchery3::domain::CuratedPropagationRecord
        {
          batchRef,
          wingCode,
          stageLabel,
          tallyLabel,
          validFrom,
          validThru
        }
      }#
    )};
    executions['north']:
    {
      mapping: test::noblehatchery3::mapping::PropagationCuration;
      runtime: test::noblehatchery3::runtime::NorthWingRuntime;
    }
    executions['south']:
    {
      mapping: test::noblehatchery3::mapping::PropagationCuration;
      runtime: test::noblehatchery3::runtime::SouthWingRuntime;
    }
  }
  testSuites:
  [
    propagationAsOfSuite:
    {
      data:
      [
        connections:
        [
          northWingFeedConnection:
            ExternalFormat
            #{
              contentType: 'application/json';
              data: '[{"batchRef":"NH-north-a","wingCode":"north","stageToken":"hardening","notes":"bench three","observedFrom":"2025-03-01T00:00:00","observedThru":"2025-09-01T00:00:00"},{"batchRef":"NH-north-b","wingCode":"north","stageToken":"hardening","notes":"bench four","observedFrom":"2024-01-01T00:00:00","observedThru":"2025-01-01T00:00:00"}]';
            }#
        ]
      ]
      tests:
      [
        northWingAsOfMidYear:
        {
          keys: ['north'];
          parameters:
          [
            wing = 'north',
            asOf = %2025-06-01T00:00:00,
            stages = ['hardening', 'graft union check']
          ]
          asserts:
          [
            openWindowRowOnly:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":{"batchRef":"NH-north-a","wingCode":"north","stageLabel":"hardening","tallyLabel":"tallied at potting on","validFrom":"2025-03-01T00:00:00","validThru":"2025-09-01T00:00:00"}}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
