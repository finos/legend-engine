###Pure
import test::kindlyprairie3::domain::*;

function test::kindlyprairie3::function::withinBand(reading: Float[1], lowest: Integer[1], highest: Integer[1], tolerance: Integer[1]): Boolean[1]
{
  ($reading >= ($lowest - $tolerance)) && ($reading <= ($highest + $tolerance))
}
