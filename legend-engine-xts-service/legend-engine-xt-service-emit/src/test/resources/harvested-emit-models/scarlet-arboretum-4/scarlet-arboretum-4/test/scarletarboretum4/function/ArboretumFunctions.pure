###Pure
function test::scarletarboretum4::function::ringsWithinRange(rings: Integer[0..1]): Boolean[1]
{
  if($rings->isEmpty(),
     | true,
     | ($rings->toOne() >= 0) && ($rings->toOne() <= 4000))
}

function test::scarletarboretum4::function::careDigest(notes: String[*]): String[1]
{
  if($notes->isEmpty(),
     | 'NO CARE NOTES',
     | $notes->map(n | $n->trim()->toUpper())->joinStrings(' | '))
}

function test::scarletarboretum4::function::canopyBand(coverPct: Float[0..1]): String[1]
{
  if($coverPct->isEmpty(),
     | 'UNMEASURED',
     | if($coverPct->toOne() >= 80.0,
          | 'FULL CANOPY',
          | if($coverPct->toOne() >= 45.0,
               | 'PARTIAL CANOPY',
               | if($coverPct->toOne() >= 10.0,
                    | 'THIN CANOPY',
                    | 'BARE CROWN'))))
}

function test::scarletarboretum4::function::vigourInput(code: String[1]): String[1]
{
  if($code->in(['R', 'ROB', 'ROBUST']),
     | $code,
     | if($code->in(['F', 'FAIR', 'MID']),
          | $code,
          | if($code->in(['P', 'POOR']),
               | $code,
               | 'P')))
}

function test::scarletarboretum4::function::withinReviewWindow(measuredOn: StrictDate[0..1], asOfDate: StrictDate[1]): Boolean[1]
{
  if($measuredOn->isEmpty(),
     | false,
     | $measuredOn->toOne() >= $asOfDate->adjust(-540, meta::pure::functions::date::DurationUnit.DAYS))
}
