###Pure
Class {meta::pure::profiles::doc.doc = 'A planting bed a submitted specimen was measured in.'} test::scarletarboretum4::source::BedNode
{
  bedCode: String[0..1];
  section: test::scarletarboretum4::source::SectionNode[0..1];
}

Class {meta::pure::profiles::doc.doc = 'The arboretum section a planting bed sits in.'} test::scarletarboretum4::source::SectionNode
{
  sectionCode: String[0..1];
  regionLabel: String[0..1];
}

Class <<test::scarletarboretum4::profile::ArboretumTags.provisional>> {meta::pure::profiles::doc.doc = 'The envelope every inbound document carries: its own reference and the routing attribute the disjoint slices of the published extent select on.'} test::scarletarboretum4::source::SubmissionEnvelope
{
  {test::scarletarboretum4::profile::ArboretumTags.externalName = 'submission_ref'} submissionRef: String[1];
  channel: String[0..1];
  measuredOn: StrictDate[0..1];
  routingKey() {if($this.channel->isEmpty(),
                   | 'UNROUTED',
                   | $this.channel->toOne()->trim()->toUpper())}: String[1];
}

Class <<test::scarletarboretum4::profile::ArboretumTags.published>> {meta::pure::profiles::doc.doc = 'An inbound specimen measurement document, extending the envelope with the measured values, the two accountable identities and three derivations the published transforms read instead of the stored values.'} test::scarletarboretum4::source::SpecimenSubmission extends test::scarletarboretum4::source::SubmissionEnvelope
{
  {test::scarletarboretum4::profile::ArboretumTags.externalName = 'specimen_code'} specimenCode: String[0..1];
  vigourCode: String[0..1];
  canopyPct: Float[0..1];
  ringCount: Integer[0..1];
  careNotes: String[*];
  bed: test::scarletarboretum4::source::BedNode[0..1];
  {test::scarletarboretum4::profile::ArboretumTags.displayName = 'Surveyor'} surveyorCode: String[0..1];
  plotTag: String[0..1];
  auditRef: String[0..1];
  reviewedOn: StrictDate[0..1];
  vigourKey() {if($this.vigourCode->isEmpty(),
                  | 'UNSET',
                  | $this.vigourCode->toOne()->trim()->toUpper())}: String[1];
  bedLabel() {if($this.bed->isEmpty(),
                 | 'UNBEDDED',
                 | if($this.bed.bedCode->isEmpty(),
                      | 'UNCODED BED',
                      | $this.bed.bedCode->toOne()->trim()->toUpper()))}: String[1];
  noteCount() {$this.careNotes->size()}: Integer[1];
  surveyorTier() {if($this.surveyorCode->isEmpty(),
                     | 'MID',
                     | if($this.surveyorCode->toOne()->trim()->toUpper()->startsWith('SR-'),
                          | 'ROBUST',
                          | 'FAIR'))}: String[1];
  auditTier() {if($this.auditRef->isEmpty(),
                  | 'POOR',
                  | if($this.auditRef->toOne()->trim()->toUpper()->startsWith('AU-'),
                       | 'FAIR',
                       | 'POOR'))}: String[1];
}
