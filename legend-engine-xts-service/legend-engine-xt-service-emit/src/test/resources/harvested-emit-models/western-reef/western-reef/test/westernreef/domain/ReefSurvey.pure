import test::westernreef::domain::*;

Class {meta::pure::profiles::doc.doc = 'A completed reef survey transect, carrying the bleaching band derived for it, the text rendering of its reef zone and the site and observer graphs it belongs to.'} test::westernreef::domain::ReefSurvey
{
  surveyRef: String[1];
  healthBand: String[1];
  zoneLabel: String[0..1];
  site: ReefSite[1];
  observer: SurveyObserver[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A monitored reef site, reached from a survey and itself reaching the region it sits in.'} test::westernreef::domain::ReefSite
{
  siteCode: String[1];
  region: ReefRegion[1];
}

Class {meta::pure::profiles::doc.doc = 'A reef region and the ocean basin it belongs to, forming the deepest level of the survey graph.'} test::westernreef::domain::ReefRegion
{
  regionCode: String[1];
  oceanBasin: String[1];
}

Class {meta::pure::profiles::doc.doc = 'The diver who recorded a survey transect, reaching the team they belong to.'} test::westernreef::domain::SurveyObserver
{
  observerCode: String[1];
  team: ObserverTeam[1];
}

Class {meta::pure::profiles::doc.doc = 'A monitoring team that fields reef survey divers.'} test::westernreef::domain::ObserverTeam
{
  teamCode: String[1];
}
