import test::westernreef::domain::*;
import test::westernreef::source::*;

Class {meta::pure::profiles::doc.doc = 'An inbound reef monitoring record as submitted by a survey vessel, with an optional bleached fraction and an optional enumerated reef zone.'} test::westernreef::source::SurveyFeed
{
  feedRef: String[1];
  bleachedFraction: Float[0..1];
  zone: ReefZone[0..1];
  site: SiteFeed[1];
  observer: ObserverFeed[0..1];
}

Class {meta::pure::profiles::doc.doc = 'The site block of an inbound reef monitoring record.'} test::westernreef::source::SiteFeed
{
  code: String[1];
  region: RegionFeed[1];
}

Class {meta::pure::profiles::doc.doc = 'The region block of an inbound reef monitoring record, carrying a free-text ocean basin.'} test::westernreef::source::RegionFeed
{
  code: String[1];
  basin: String[1];
}

Class {meta::pure::profiles::doc.doc = 'The observer block of an inbound reef monitoring record.'} test::westernreef::source::ObserverFeed
{
  code: String[1];
  team: TeamFeed[1];
}

Class {meta::pure::profiles::doc.doc = 'The team block of an inbound reef monitoring record.'} test::westernreef::source::TeamFeed
{
  code: String[1];
}
