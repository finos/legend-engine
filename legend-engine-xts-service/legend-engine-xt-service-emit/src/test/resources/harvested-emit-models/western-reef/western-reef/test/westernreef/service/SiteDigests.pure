###Service
Service test::westernreef::service::SiteDigests
{
  pattern: '/westernreef/v1/site/digests';
  title: 'Western Reef - Site Digests';
  owners:
  [
    'reef-monitoring'
  ];
  documentation: 'Accepts an inbound reef site record as a JSON document and returns its flattened digest as a nested document, over an inline runtime that embeds a document-parsing model-store connection bound to the site record class.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |test::westernreef::domain::SiteDigest.all()->graphFetch(
      #{
        test::westernreef::domain::SiteDigest{
          siteCode,
          regionCode,
          basinLabel
        }
      }#
    )->serialize(
      #{
        test::westernreef::domain::SiteDigest{
          siteCode,
          regionCode,
          basinLabel
        }
      }#
    );
    mapping: test::westernreef::mapping::SiteDigestMapping;
    runtime:
    #{
      mappings:
      [
        test::westernreef::mapping::SiteDigestMapping
      ];
      connections:
      [
        ModelStore:
        [
          siteFeedConnection:
          #{
            JsonModelConnection
            {
              class: test::westernreef::source::SiteFeed;
              url: 'data:application/json,%7B%7D';
            }
          }#
        ]
      ];
    }#;
  }
  testSuites:
  [
    siteDigestsSuite:
    {
      data:
      [
        connections:
        [
          siteFeedConnection:
            ExternalFormat
            #{
              contentType: 'application/json';
              data: '{"code":"ST-D","region":{"code":"RG-04","basin":"arafura sea"}}';
            }#
        ]
      ]
      tests:
      [
        digestedSiteGraph:
        {
          asserts:
          [
            servedSiteDigest:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{\n  "builder" : {\n    "_type" : "json"\n  },\n  "values" : {\n    "siteCode" : "ST-D",\n    "regionCode" : "RG-04",\n    "basinLabel" : "ARAFURA SEA"\n  }\n}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
