###Service
Service test::westernreef::service::SurveyHealthBands
{
  pattern: '/westernreef/v1/survey/healthBands';
  title: 'Western Reef - Survey Health Bands';
  owners:
  [
    'reef-monitoring'
  ];
  documentation: 'Accepts an inbound reef monitoring record as a JSON document and returns the banded survey with its site and observer graphs, serialised as a nested document. The execution embeds its runtime inline, so the model declares no packageable runtime or connection element.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |test::westernreef::domain::ReefSurvey.all()->graphFetch(
      #{
        test::westernreef::domain::ReefSurvey{
          surveyRef,
          healthBand,
          zoneLabel,
          site{
            siteCode,
            region{
              regionCode,
              oceanBasin
            }
          },
          observer{
            observerCode,
            team{
              teamCode
            }
          }
        }
      }#
    )->serialize(
      #{
        test::westernreef::domain::ReefSurvey{
          surveyRef,
          healthBand,
          zoneLabel,
          site{
            siteCode,
            region{
              regionCode,
              oceanBasin
            }
          },
          observer{
            observerCode,
            team{
              teamCode
            }
          }
        }
      }#
    );
    mapping: test::westernreef::mapping::ReefSurveyMapping;
    runtime:
    #{
      mappings:
      [
        test::westernreef::mapping::ReefSurveyMapping
      ];
      connections:
      [
        ModelStore:
        [
          surveyFeedConnection:
          #{
            JsonModelConnection
            {
              class: test::westernreef::source::SurveyFeed;
              url: 'data:application/json,%7B%7D';
            }
          }#
        ]
      ];
    }#;
  }
  testSuites:
  [
    surveyHealthBandsSuite:
    {
      data:
      [
        connections:
        [
          surveyFeedConnection:
            ExternalFormat
            #{
              contentType: 'application/json';
              data: '{"feedRef":"SV-1001","bleachedFraction":0.65,"zone":"BACK_REEF","site":{"code":"ST-C","region":{"code":"RG-03","basin":"timor sea"}},"observer":{"code":"OB-11","team":{"code":"TM-02"}}}';
            }#
        ]
      ]
      tests:
      [
        bandedSurveyGraph:
        {
          asserts:
          [
            servedSurveyGraph:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{\n  "builder" : {\n    "_type" : "json"\n  },\n  "values" : {\n    "surveyRef" : "SV-1001",\n    "healthBand" : "HIGH",\n    "zoneLabel" : "BACK_REEF",\n    "site" : {\n      "siteCode" : "ST-C",\n      "region" : {\n        "regionCode" : "RG-03",\n        "oceanBasin" : "TIMOR SEA"\n      }\n    },\n    "observer" : {\n      "observerCode" : "OB-11",\n      "team" : {\n        "teamCode" : "TM-02"\n      }\n    }\n  }\n}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
