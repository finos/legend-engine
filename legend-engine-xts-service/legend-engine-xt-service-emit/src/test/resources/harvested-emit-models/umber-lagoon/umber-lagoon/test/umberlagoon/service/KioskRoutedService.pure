###Service
Service test::umberlagoon::service::KioskRoutedService
{
  pattern: '/umberlagoon/v1/kiosk-cards-by-tier';
  title: 'Umber Lagoon - Kiosk Cards By Tier';
  ownership: DID { identifier: 'trail-patrol-platform' };
  documentation: 'Multi-execution service keyed by kiosk tier, routing one graph-fetched kiosk card query to alternative model-to-model runtimes so the keyed execution environments are parsed, compiled and planned.';
  autoActivateUpdates: false;
  execution: Multi
  {
    query: |test::umberlagoon::domain::KioskCard.all()->graphFetch(
      #{
        test::umberlagoon::domain::KioskCard{
          cardRef,
          headline,
          surfaceNote,
          ratingText,
          tallyValue,
          tallyRank
        }
      }#
    )->serialize(
      #{
        test::umberlagoon::domain::KioskCard{
          cardRef,
          headline,
          surfaceNote,
          ratingText,
          tallyValue,
          tallyRank
        }
      }#
    );
    key: 'tier';
    executions['ridge']:
    {
      mapping: test::umberlagoon::mapping::PatrolCardMapping;
      runtime: test::umberlagoon::runtime::KioskCardRuntime;
    }
    executions['vale']:
    {
      mapping: test::umberlagoon::mapping::PatrolCardMapping;
      runtime: test::umberlagoon::runtime::KioskCardRuntime;
    }
  }
}
