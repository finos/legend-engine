###Pure
function {meta::pure::profiles::doc.doc = 'Tabular projection of the published patrol summaries: the sweep reference, the segment and warden labels and the divided rate, ordered by reference.'} test::umberlagoon::query::sweepRegisterTable(): meta::pure::tds::TabularDataSet[1]
{
  test::umberlagoon::domain::PatrolSummary.all()->project(
    [
      s|$s.sweepRef,
      s|$s.segmentLabel,
      s|$s.wardenLabel,
      s|$s.sweepRate,
      s|$s.sweepTally
    ],
    [
      'Sweep',
      'Segment',
      'Warden',
      'Rate',
      'Tally'
    ]
  )->sort([asc('Sweep')])
}

function {meta::pure::profiles::doc.doc = 'Tabular projection of the kiosk cards narrowed to the caller-named surface notes, restricted to the reference and the arithmetic tally.'} test::umberlagoon::query::kioskCardTable(surfaceNotes: String[*]): meta::pure::tds::TabularDataSet[1]
{
  test::umberlagoon::domain::KioskCard.all()->filter(
    c|$c.surfaceNote->in($surfaceNotes)
  )->project(
    [
      c|$c.cardRef,
      c|$c.headline,
      c|$c.tallyValue,
      c|$c.tallyRank
    ],
    [
      'Card',
      'Headline',
      'Tally',
      'Rank'
    ]
  )->restrict(['Card', 'Tally'])
}
