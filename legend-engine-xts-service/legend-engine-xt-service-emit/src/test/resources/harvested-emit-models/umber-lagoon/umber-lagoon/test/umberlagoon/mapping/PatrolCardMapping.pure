###Mapping
Mapping test::umberlagoon::mapping::PatrolCardMapping
(
  *test::umberlagoon::domain::KioskCard[kioskCardFromLine]: Pure
  {
    ~src test::umberlagoon::domain::PatrolLine
    cardRef: 'KC-' + $src.lineRef->trim()->toUpper()->replace(' ', ''),
    headline: [$src.segmentCode->toUpper(), $src.wardenText->trim()]->joinStrings(' | '),
    surfaceNote: 'sealed-surface:' + $src.surfaceCode->toUpper()->in(['GRAVEL', 'BOARDWALK'])->toString(),
    ratingText: 'sweeps-' + $src.sweepCount->toString(),
    tallyValue: $src.sweepMinutes * 1.5 + [2.0, 3.5]->sum(),
    tallyRank: round($src.sweepMinutes / 12)
  }

  testSuites:
  [
    patrolCardSuite:
    {
      function: |test::umberlagoon::domain::KioskCard.all()->graphFetch(
        #{
          test::umberlagoon::domain::KioskCard{
            cardRef,
            headline,
            surfaceNote,
            ratingText,
            tallyValue,
            tallyRank
          }
        }#
      )->serialize(
        #{
          test::umberlagoon::domain::KioskCard{
            cardRef,
            headline,
            surfaceNote,
            ratingText,
            tallyValue,
            tallyRank
          }
        }#
      );
      tests:
      [
        cardsFromPatrolLines:
        {
          doc: 'Maps inbound patrol lines straight onto the kiosk card, proving the cased card reference, the joined headline, the literal-set surface flag, the multiplied tally and the rounded rank.';
          data:
          [
            ModelStore:
              ModelStore
              #{
                test::umberlagoon::domain::PatrolLine:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"lineRef":"pl 303","segmentCode":"fen_east","wardenText":" cy fen ","surfaceCode":"gravel","noticeText":"clear","sweepCount":4,"sweepMinutes":36.0},{"lineRef":"pl 404","segmentCode":"heath_west","wardenText":"di heath","surfaceCode":"grass","noticeText":"wet","sweepCount":2,"sweepMinutes":24.0}]';
                  }#
              }#
          ];
          asserts:
          [
            mappedCards:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"cardRef":"KC-PL303","headline":"FEN_EAST | cy fen","surfaceNote":"sealed-surface:true","ratingText":"sweeps-4","tallyValue":59.5,"tallyRank":3},{"cardRef":"KC-PL404","headline":"HEATH_WEST | di heath","surfaceNote":"sealed-surface:false","ratingText":"sweeps-2","tallyValue":41.5,"tallyRank":2}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
