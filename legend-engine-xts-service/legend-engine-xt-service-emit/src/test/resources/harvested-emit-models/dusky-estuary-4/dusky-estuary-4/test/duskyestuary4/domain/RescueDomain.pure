###Pure
Class {meta::pure::profiles::doc.doc = 'A wildlife rescue intake record carrying the source facts used to build the public-facing animal profile, including one source note intentionally left outside the ten mapped target properties.'} test::duskyestuary4::domain::IntakeRecord
{
  intakeCode: String[1];
  animalName: String[1];
  species: String[1];
  rescueCenter: String[1];
  arrivalDate: StrictDate[1];
  originRegion: String[1];
  intakeWeightKg: Float[1];
  healthStatus: String[1];
  microchipCode: String[1];
  intakeNote: String[1];
}

Class {meta::pure::profiles::doc.doc = 'The public profile derived from one rescue intake: nine values pass through from the source while weightPounds intentionally expands one source weight against a two-value conversion set.'} test::duskyestuary4::domain::AnimalProfile
{
  profileCode: String[1];
  displayName: String[1];
  speciesLabel: String[1];
  rescueCenterName: String[1];
  arrivedOn: StrictDate[1];
  originRegion: String[1];
  weightKg: Float[1];
  weightPounds: Float[1];
  healthStatus: String[1];
  microchipCode: String[1];
}
