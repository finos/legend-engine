###Service
Service test::ivoryprairie::service::CatalogueArtifact
{
  pattern: '/ivoryprairie/v1/artifact/catalogue';
  title: 'Ivory Prairie - Catalogue Incoming Artifact (M2M)';
  owners:
  [
    'curation-platform',
    'collections-eng'
  ];
  documentation: 'Accepts an inbound partner-museum artifact record as JSON (refCode / label / originCulture / estimatedYear) and returns the catalogued current-model Artifact (catalogId / name / culture / creationYear). Backed by the IncomingToArtifactM2M model-to-model mapping over a JsonModelConnection.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |test::ivoryprairie::domain::Artifact.all()->graphFetch(
      #{
        test::ivoryprairie::domain::Artifact{
          catalogId,
          name,
          culture,
          creationYear
        }
      }#
    )->serialize(
      #{
        test::ivoryprairie::domain::Artifact{
          catalogId,
          name,
          culture,
          creationYear
        }
      }#
    );
    mapping: test::ivoryprairie::mapping::IncomingToArtifactM2M;
    runtime: test::ivoryprairie::runtime::ArtifactM2MRuntime;
  }
  testSuites:
  [
    catalogueArtifactSuite:
    {
      data:
      [
        connections:
        [
          incomingArtifactConnection:
            ExternalFormat
            #{
              contentType: 'application/json';
              data: '{"refCode":"ART-0001","label":"Carved Antler Comb","originCulture":"Sami","estimatedYear":1780}';
            }#
        ]
      ]
      tests:
      [
        artifactAlpha:
        {
          asserts:
          [
            cataloguedArtifact:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{\n  "builder" : {\n    "_type" : "json"\n  },\n  "values" : {\n    "catalogId" : "ART-0001",\n    "name" : "Carved Antler Comb",\n    "culture" : "Sami",\n    "creationYear" : 1780\n  }\n}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
