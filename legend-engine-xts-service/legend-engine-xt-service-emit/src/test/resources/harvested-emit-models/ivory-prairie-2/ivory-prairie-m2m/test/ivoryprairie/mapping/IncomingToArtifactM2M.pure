###Mapping
Mapping test::ivoryprairie::mapping::IncomingToArtifactM2M
(
  *test::ivoryprairie::domain::Artifact: Pure
  {
    ~src test::ivoryprairie::source::IncomingArtifact
    catalogId: $src.refCode,
    name: $src.label,
    culture: $src.originCulture,
    creationYear: $src.estimatedYear
  }

  testSuites:
  [
    artifactSuite:
    {
      function: |test::ivoryprairie::domain::Artifact.all()->graphFetch(
  #{
    test::ivoryprairie::domain::Artifact{
      catalogId,
      name,
      culture,
      creationYear
    }
  }#
)->serialize(
  #{
    test::ivoryprairie::domain::Artifact{
      catalogId,
      name,
      culture,
      creationYear
    }
  }#
);
      tests:
      [
        artifactAlpha:
        {
          doc: 'Round-trips a single inbound artifact record through the model-to-model transform.';
          data:
          [
            ModelStore:
              ModelStore
              #{
                test::ivoryprairie::source::IncomingArtifact:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"refCode":"ART-0001","label":"Carved Antler Comb","originCulture":"Sami","estimatedYear":1780}';
                  }#
              }#
          ];
          asserts:
          [
            mappedArtifact:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"catalogId":"ART-0001","name":"Carved Antler Comb","culture":"Sami","creationYear":1780}';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
