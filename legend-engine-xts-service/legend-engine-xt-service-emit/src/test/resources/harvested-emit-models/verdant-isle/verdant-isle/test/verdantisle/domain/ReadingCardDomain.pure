###Pure
import test::verdantisle::domain::*;

Class {meta::pure::profiles::doc.doc = 'A reading-room reservation card with clean property names and a mandatory edition block.'} test::verdantisle::domain::ReadingCard
{
  cardId: String[1];
  shelfMark: String[1];
  givenName: String[1];
  familyName: String[1];
  note: String[0..1];
  edition: CardEdition[1];
}

Class {meta::pure::profiles::doc.doc = 'The edition a reading-room card is issued against.'} test::verdantisle::domain::CardEdition
{
  code: String[1];
  language: String[1];
}
