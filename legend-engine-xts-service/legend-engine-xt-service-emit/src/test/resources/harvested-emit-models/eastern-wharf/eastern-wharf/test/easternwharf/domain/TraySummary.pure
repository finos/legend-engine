Class {meta::pure::profiles::doc.doc = 'A flat published summary of one propagation tray: where it stands in the glasshouse, the stage it has reached and the leading vigorous seedling in it, with typed defaults wherever the inbound document leaves the answer absent.'} test::easternwharf::domain::TraySummary
{
  runCode: String[1];
  trayCode: String[0..1];
  benchLabel: String[1];
  trayLabel: String[1];
  stageLabel: String[1];
  leadSeedling: String[1];
  vigorousCount: Integer[1];
  tallestHeightMicron: Integer[1];
}
