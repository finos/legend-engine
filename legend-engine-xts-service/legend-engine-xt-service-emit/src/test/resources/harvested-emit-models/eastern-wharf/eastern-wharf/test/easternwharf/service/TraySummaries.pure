###Service
Service test::easternwharf::service::TraySummaries
{
  pattern: '/easternwharf/v1/traySummaries/{propagationDocument}';
  title: 'Eastern Wharf - Propagation Tray Summaries';
  owners:
  [
    'nursery-propagation'
  ];
  documentation: 'Serves the published tray summary graph for an inbound propagation document, delegating the whole query body to the publishing function so the defaulted transforms are exercised in-memory over a model-store runtime with no relational store behind it.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {propagationDocument: String[1]|test::easternwharf::function::publishTraySummaries($propagationDocument)};
    mapping: test::easternwharf::mapping::TraySummaryMapping;
    runtime: test::easternwharf::runtime::TraySummaryRuntime;
  }
  testSuites:
  [
    traySummariesSuite:
    {
      data:
      [
        connections:
        [
          propagationRunConnection:
            ExternalFormat
            #{
              contentType: 'application/json';
              data: '{"runCode":"RUN-21","bench":{"benchName":"Beacon Aisle Bench","tray":{"trayCode":"TR-21","stage":"HARDENING","seedlings":[{"seedlingCode":"SD-21","vigourClass":"WEAK","heightMicron":6200},{"seedlingCode":"SD-22","vigourClass":"STRONG","heightMicron":12400}]}}}';
            }#
        ]
      ]
      tests:
      [
        servedTraySummary:
        {
          parameters:
          [
            propagationDocument = 'inbound-propagation-batch'
          ]
          asserts:
          [
            vigorousSeedlingSurfaced:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":{"runCode":"RUN-21","trayCode":"TR-21","benchLabel":"Beacon Aisle Bench","trayLabel":"TR-21","stageLabel":"HARDENING","leadSeedling":"SD-22","vigorousCount":1,"tallestHeightMicron":12400}}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
