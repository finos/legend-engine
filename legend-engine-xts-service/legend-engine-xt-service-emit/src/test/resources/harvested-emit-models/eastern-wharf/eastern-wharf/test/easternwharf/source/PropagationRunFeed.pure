import test::easternwharf::source::*;

Class {meta::pure::profiles::doc.doc = 'An inbound propagation run document as it arrives from a plant nursery, nesting the bench block that carries the seed tray block.'} test::easternwharf::source::PropagationRunFeed
{
  runCode: String[1];
  bench: BenchBlock[0..1];
}

Class {meta::pure::profiles::doc.doc = 'The glasshouse bench level of the propagation document, itself optionally carrying the tray that was made up on it.'} test::easternwharf::source::BenchBlock
{
  benchName: String[1];
  tray: TrayBlock[0..1];
}

Class {meta::pure::profiles::doc.doc = 'The seed tray level of the propagation document, with an optional tray identifier, an optional growing stage and the seedlings pricked out into it.'} test::easternwharf::source::TrayBlock
{
  trayCode: String[0..1];
  stage: String[0..1];
  seedlings: SeedlingEntry[*];
}

Class {meta::pure::profiles::doc.doc = 'One seedling pricked out into a tray, whose vigour class and measured height may both be absent from the document.'} test::easternwharf::source::SeedlingEntry
{
  seedlingCode: String[1];
  vigourClass: String[0..1];
  heightMicron: Integer[0..1];
}
