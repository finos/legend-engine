import test::quietestuary::function::*;

Class {meta::pure::profiles::doc.doc = 'A tide-gauge reading published by the estuary monitoring model, valid over an explicit observation window.'} test::quietestuary::domain::GaugeReading
{
  stationCode: String[1];
  reach: String[1];
  waterLevelCm: Integer[1];
  validFrom: DateTime[1];
  validThru: DateTime[1];
  tideBand() {tideBand($this.waterLevelCm)}: String[1];
  stationLabel() {if($this.tideBand == 'SPRING',
    | ($this.reach->toUpper()->substring(0, 3) + '/' + $this.stationCode->trim()->toLower() + '/' + $this.waterLevelCm->toString() + '!'),
    | ($this.reach->toUpper()->substring(0, 3) + '/' + $this.stationCode->trim()->toLower() + '/' + $this.waterLevelCm->toString())
  )}: String[1];
}
