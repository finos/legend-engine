###Mapping
Mapping test::quietestuary::mapping::EstuaryReadings
(
  *test::quietestuary::domain::GaugeReading: Operation
  {
    meta::pure::router::operations::union_OperationSetImplementation_1__SetImplementation_MANY_(shore, channel)
  }

  test::quietestuary::domain::GaugeReading[shore]: Pure
  {
    ~src test::quietestuary::source::IncomingGaugeReading
    ~filter $src.feedKind == 'SHORE'
    stationCode: $src.stationRef,
    reach: 'shoreline',
    waterLevelCm: $src.waterLevelCm,
    validFrom: $src.observedFrom,
    validThru: $src.observedThru
  }

  test::quietestuary::domain::GaugeReading[channel]: Pure
  {
    ~src test::quietestuary::source::IncomingGaugeReading
    ~filter $src.feedKind == 'CHANNEL'
    stationCode: $src.stationRef,
    reach: 'channel',
    waterLevelCm: $src.waterLevelCm,
    validFrom: $src.observedFrom,
    validThru: $src.observedThru
  }
)
