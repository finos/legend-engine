###Service
Service test::easternaviary2::service::RunGraphChecked
{
  pattern: '/easternaviary2/v1/run-graph-checked';
  title: 'Eastern Aviary 2 - Checked Flattened Inspection Run';
  owners:
  [
    'permanent-way-records',
    'track-survey-desk'
  ];
  documentation: 'Publishes the same flattening over the same mapping as the unchecked document service and differs in exactly one respect: the graph is retrieved in checked form, so parse and transform defects travel beside the produced values instead of disappearing into malformed output. No test suite is attached, so the defect-reporting path is exercised only through the mapping suite.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |test::easternaviary2::domain::FlatInspectionRun.all()->graphFetchChecked(
      #{
        test::easternaviary2::domain::FlatInspectionRun
        {
          runRef,
          header
          {
            notebookRef,
            gangName
          },
          defectRows
          {
            sectionCode,
            defectTally
          },
          defectCodeRows
          {
            upperDefectCodes,
            longDefectDigest
          }
        }
      }#
    )->serialize(
      #{
        test::easternaviary2::domain::FlatInspectionRun
        {
          runRef,
          header
          {
            notebookRef,
            gangName
          },
          defectRows
          {
            sectionCode,
            defectTally
          },
          defectCodeRows
          {
            upperDefectCodes,
            longDefectDigest
          }
        }
      }#
    );
    mapping: test::easternaviary2::mapping::RunFlattenMapping;
    runtime:
    #{
      mappings:
      [
        test::easternaviary2::mapping::RunFlattenMapping
      ];
      connections:
      [
        ModelStore:
        [
          checkedRunSubmissionConnection:
          #{
            JsonModelConnection
            {
              class: test::easternaviary2::source::RunSubmission;
              url: 'data:application/json,%7B%7D';
            }
          }#
        ]
      ];
    }#;
  }
}
