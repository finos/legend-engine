###Mapping
Mapping test::indigocanyon2::mapping::IncidentKeyM2M
(
  *test::indigocanyon2::domain::TrailIncidentKey[incident_key]: Pure
  {
    ~src test::indigocanyon2::domain::InboundTrailEvent
    incidentRef: $src.header.detail.incidentRef
  }

  testSuites:
  [
    incidentKeySuite:
    {
      function: |test::indigocanyon2::domain::TrailIncidentKey.all()->graphFetch(
      #{
        test::indigocanyon2::domain::TrailIncidentKey{
          incidentRef
        }
      }#
      )->serialize(
      #{
        test::indigocanyon2::domain::TrailIncidentKey{
          incidentRef
        }
      }#
      );
      tests:
      [
        deepNavigationReachesRef:
        {
          data:
          [
            ModelStore:
              ModelStore
              #{
                test::indigocanyon2::domain::InboundTrailEvent:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"eventCode":"EV-4410","header":{"reportedBy":"ranger station 3","detail":{"incidentRef":"IR-88231","gradeHint":"SLOT_TRAVERSE"}},"observations":[{"observationCode":"OB-1","reading":14},{"observationCode":"OB-2"},{"observationCode":"OB-3","reading":0}]}';
                  }#
              }#
          ];
          asserts:
          [
            nestedRefExtracted:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"incidentRef":"IR-88231"}';
                  }#;
              }#
          ];
        },
        absentHeaderYieldsNoRef:
        {
          data:
          [
            ModelStore:
              ModelStore
              #{
                test::indigocanyon2::domain::InboundTrailEvent:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"eventCode":"EV-4411","observations":[]}';
                  }#
              }#
          ];
          asserts:
          [
            missingRefIsNull:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"incidentRef":null}';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
