###Pure
import test::indigocanyon2::domain::*;

Enum test::indigocanyon2::domain::TrailGrade
{
  RIM_WALK,
  BENCH_PATH,
  SWITCHBACK,
  TALUS_SCRAMBLE,
  SLOT_TRAVERSE,
  LEDGE_TRAVERSE,
  CHIMNEY_CLIMB,
  RIVER_FORD,
  SNOW_COULOIR,
  UNRATED
}

Class test::indigocanyon2::domain::TrailPrompt
{
  promptText: String[1];
}

Class test::indigocanyon2::domain::TrailGradeRoster
{
  gradeNames: String[*];
}

Class test::indigocanyon2::domain::TrailIncidentKey
{
  incidentRef: String[0..1];
}

Class test::indigocanyon2::domain::InboundTrailEvent
{
  eventCode: String[1];
  header: InboundTrailHeader[0..1];
  observations: InboundObservation[*];
}

Class test::indigocanyon2::domain::InboundTrailHeader
{
  reportedBy: String[0..1];
  detail: InboundTrailDetail[0..1];
}

Class test::indigocanyon2::domain::InboundTrailDetail
{
  incidentRef: String[0..1];
  gradeHint: String[0..1];
}

Class test::indigocanyon2::domain::InboundObservation
{
  observationCode: String[1];
  reading: Integer[0..1];
}
