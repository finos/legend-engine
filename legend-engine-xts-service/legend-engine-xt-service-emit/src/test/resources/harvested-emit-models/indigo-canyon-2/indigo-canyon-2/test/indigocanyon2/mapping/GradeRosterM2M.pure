###Mapping
Mapping test::indigocanyon2::mapping::GradeRosterM2M
(
  *test::indigocanyon2::domain::TrailGradeRoster[roster]: Pure
  {
    ~src test::indigocanyon2::domain::TrailPrompt
    gradeNames: test::indigocanyon2::domain::TrailGrade->enumValues()->map(g|$g->toString()->toUpper()->trim())
  }

  testSuites:
  [
    gradeRosterSuite:
    {
      function: |test::indigocanyon2::domain::TrailGradeRoster.all()->graphFetch(
      #{
        test::indigocanyon2::domain::TrailGradeRoster{
          gradeNames
        }
      }#
      )->serialize(
      #{
        test::indigocanyon2::domain::TrailGradeRoster{
          gradeNames
        }
      }#
      );
      tests:
      [
        everyGradeNameExpanded:
        {
          data:
          [
            ModelStore:
              ModelStore
              #{
                test::indigocanyon2::domain::TrailPrompt:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"promptText":"list every trail grade"}';
                  }#
              }#
          ];
          asserts:
          [
            orderedGradeNames:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"gradeNames":["RIM_WALK","BENCH_PATH","SWITCHBACK","TALUS_SCRAMBLE","SLOT_TRAVERSE","LEDGE_TRAVERSE","CHIMNEY_CLIMB","RIVER_FORD","SNOW_COULOIR","UNRATED"]}';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
