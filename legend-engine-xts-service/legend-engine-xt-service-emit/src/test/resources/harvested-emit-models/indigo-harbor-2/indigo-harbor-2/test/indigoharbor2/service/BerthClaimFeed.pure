###Service
Service test::indigoharbor2::service::BerthClaimFeed
{
  pattern: '/indigoharbor/v1/berth-claims';
  title: 'Indigo Harbor - Berth Claim Feed';
  owners:
  [
    'harbor-mooring-register'
  ];
  documentation: 'Single-execution feed serializing the mooring claims raised for the three docks the register publishes, naming the hull class each claim was bound to and defaulting the craft name when the warden left it blank.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |test::indigoharbor2::domain::BerthClaim.all()->graphFetch(
      #{
        test::indigoharbor2::domain::BerthClaim{
          claimRef,
          vesselName,
          hull,
          dockLabel
        }
      }#
    )->serialize(
      #{
        test::indigoharbor2::domain::BerthClaim{
          claimRef,
          vesselName,
          hull,
          dockLabel
        }
      }#
    );
    mapping: test::indigoharbor2::mapping::BerthClaimMapping;
    runtime: test::indigoharbor2::runtime::BerthClaimRuntime;
  }
  testSuites:
  [
    berthClaimSuite:
    {
      data:
      [
        connections:
        [
          dockEntryConnection:
            Reference
            #{
              test::indigoharbor2::data::WardenRoundData
            }#
        ]
      ]
      tests:
      [
        publishedDocksOnly:
        {
          asserts:
          [
            claimGraph:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":[{"claimRef":"DE-01","vesselName":"TERN","hull":"CUTTER","dockLabel":"dock dk-north"},{"claimRef":"DE-02","vesselName":"unnamed craft","hull":"LAUNCH","dockLabel":"dock dk-tidal"}]}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
