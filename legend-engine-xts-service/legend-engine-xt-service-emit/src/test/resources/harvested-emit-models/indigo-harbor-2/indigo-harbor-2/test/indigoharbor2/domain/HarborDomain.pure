###Pure
import test::indigoharbor2::domain::*;

Enum {meta::pure::profiles::doc.doc = 'The hull class a moored craft is registered under.'} test::indigoharbor2::domain::HullClass
{
  DINGHY,
  LAUNCH,
  CUTTER
}

Class {meta::pure::profiles::doc.doc = 'A raw arrival entry written by a dock warden.'} test::indigoharbor2::domain::DockEntry
{
  entryRef: String[1];
  vesselLabel: String[0..1];
  hullToken: String[0..1];
  dockCode: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A mooring claim published for one craft at one dock.'} test::indigoharbor2::domain::BerthClaim
{
  claimRef: String[1];
  vesselName: String[1];
  hull: HullClass[0..1];
  dockLabel: String[1];
}
