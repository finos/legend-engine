###Mapping
Mapping test::indigoharbor2::mapping::BerthClaimMapping
(
  test::indigoharbor2::domain::HullClass: EnumerationMapping HullMapping
  {
    DINGHY: ['dinghy'],
    LAUNCH: ['launch'],
    CUTTER: ['cutter']
  }

  test::indigoharbor2::domain::BerthClaim: Pure
  {
    ~src test::indigoharbor2::domain::DockEntry
    ~filter $src.dockCode->in(['DK-NORTH', 'DK-SOUTH', 'DK-TIDAL'])
    claimRef: $src.entryRef->toUpper(),
    vesselName: if($src.vesselLabel->isEmpty(),
                   | 'unnamed craft',
                   | $src.vesselLabel->toOne()->toUpper()),
    hull: EnumerationMapping HullMapping: $src.hullToken,
    dockLabel: 'dock ' + $src.dockCode->toLower()
  }
)
