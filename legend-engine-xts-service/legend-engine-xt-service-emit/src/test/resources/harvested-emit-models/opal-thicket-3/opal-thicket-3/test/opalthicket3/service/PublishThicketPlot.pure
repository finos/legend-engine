###Service
Service test::opalthicket3::service::PublishThicketPlot
{
  pattern: '/thicket/v1/plot/publish';
  title: 'Thicket - Publish Surveyed Plot (M2M)';
  owners:
  [
    'thicket-survey-platform',
    'woodland-ecology-eng'
  ];
  documentation: 'Single-execution model-to-model service that accepts an inbound plot intake envelope as JSON and returns the graph-fetched thicket plot, including the inherited habitat-survey identity.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |test::opalthicket3::domain::ThicketPlot.all()->graphFetch(
      #{
        test::opalthicket3::domain::ThicketPlot{
          plotId,
          plotName,
          surveyedOn,
          batchLabel,
          canopyHeightM,
          stemCount,
          understoryClass,
          regenerationClass,
          disturbanceNote,
          gridReference,
          isProtected,
          lastBurnYear,
          bandTags
        }
      }#
    )->serialize(
      #{
        test::opalthicket3::domain::ThicketPlot{
          plotId,
          plotName,
          surveyedOn,
          batchLabel,
          canopyHeightM,
          stemCount,
          understoryClass,
          regenerationClass,
          disturbanceNote,
          gridReference,
          isProtected,
          lastBurnYear,
          bandTags
        }
      }#
    );
    mapping: test::opalthicket3::mapping::ThicketPlotMapping;
    runtime: test::opalthicket3::runtime::ThicketRuntime;
  }
  testSuites:
  [
    publishThicketPlotSuite:
    {
      data:
      [
        connections:
        [
          plotIntakeConnection:
            ExternalFormat
            #{
              contentType: 'application/json';
              data: '{"batchLabel":"spring-transect","plot":{"plotRef":41,"plotLabel":"north ledge thicket","capturedOn":"2026-03-14","canopyHeightM":12.4,"canopyCoverPct":68.5,"stemTally":214,"saplingTally":38,"shrubTally":97,"deadwoodTally":12,"soilMoisturePct":41.2,"soilPh":6.4,"leafLitterDepthCm":3.8,"slopeDegrees":11.5,"aspectDegrees":215.0,"elevationM":384.0,"plotAreaSqM":400.0,"dominantSpecies":"hazel","secondarySpecies":"blackthorn","regenerationClass":"advancing","disturbanceNote":"  browsing pressure  ","surveyorAlias":"transect-lead-a","transectCode":"T-19","gridBlock":"NR","gridCell":"0417","protectedFlag":true,"lastBurnYear":2019,"windowDays":21},"bandTags":["understorey","edge"]}';
            }#
        ]
      ]
      tests:
      [
        northLedgeThicket:
        {
          asserts:
          [
            published:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":{"plotId":41,"plotName":"NORTH LEDGE THICKET","surveyedOn":"2026-03-14","batchLabel":"spring-transect","canopyHeightM":12.4,"stemCount":214,"understoryClass":"unclassified","regenerationClass":"advancing","disturbanceNote":"browsing pressure","gridReference":"NR-0417","isProtected":true,"lastBurnYear":2019,"bandTags":["understorey","edge"]}}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
