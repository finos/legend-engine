Data {meta::pure::profiles::doc.doc = 'Nine logbook nights that walk the seeing bands from the steadiest step through to the worst, and close with a night whose sky was never read.'} test::fabledridge7::data::SeeingArmFeedData
{
  ExternalFormat
  #{
    contentType: 'application/json';
    data: '[{"logRef":"nl-01","revision":1,"observerCode":"av-1","seeingArcsec":0.5,"cloudPct":5,"instrumentCode":"dome-1","apertureMm":700,"filterCodes":["L","R","G"],"targetCodes":["M31","M33"]},{"logRef":"nl-02","revision":2,"observerCode":"av-1","seeingArcsec":0.85,"cloudPct":5,"instrumentCode":"dome-1","apertureMm":700,"filterCodes":["L","R","G"],"targetCodes":["M31","M33"]},{"logRef":"nl-03","revision":3,"observerCode":"av-1","seeingArcsec":1.15,"cloudPct":5,"instrumentCode":"dome-1","apertureMm":700,"filterCodes":["L","R","G"],"targetCodes":["M31","M33"]},{"logRef":"nl-04","revision":4,"observerCode":"av-1","seeingArcsec":1.5,"cloudPct":5,"instrumentCode":"dome-1","apertureMm":700,"filterCodes":["L","R","G"],"targetCodes":["M31","M33"]},{"logRef":"nl-05","revision":5,"observerCode":"av-1","seeingArcsec":1.9,"cloudPct":5,"instrumentCode":"dome-1","apertureMm":700,"filterCodes":["L","R","G"],"targetCodes":["M31","M33"]},{"logRef":"nl-06","revision":6,"observerCode":"av-1","seeingArcsec":2.4,"cloudPct":5,"instrumentCode":"dome-1","apertureMm":700,"filterCodes":["L","R","G"],"targetCodes":["M31","M33"]},{"logRef":"nl-07","revision":7,"observerCode":"av-1","seeingArcsec":3.2,"cloudPct":5,"instrumentCode":"dome-1","apertureMm":700,"filterCodes":["L","R","G"],"targetCodes":["M31","M33"]},{"logRef":"nl-08","revision":8,"observerCode":"av-1","seeingArcsec":4.5,"cloudPct":5,"instrumentCode":"dome-1","apertureMm":700,"filterCodes":["L","R","G"],"targetCodes":["M31","M33"]},{"logRef":"nl-09","revision":9,"observerCode":"av-1","cloudPct":5,"instrumentCode":"dome-1","apertureMm":700,"filterCodes":["L","R","G"],"targetCodes":["M31","M33"]}]';
