Data {meta::pure::profiles::doc.doc = 'Four logbook nights left with the gaps a hand-written page leaves behind - an unsigned page, an unnamed instrument, an unrecorded aperture and an unfiltered, idle night - alongside the filter and target summary arms.'} test::fabledridge7::data::LogbookGapFeedData
{
  ExternalFormat
  #{
    contentType: 'application/json';
    data: '[{"logRef":"gp-01","revision":2,"seeingArcsec":0.9,"cloudPct":8,"instrumentCode":"rc-8","apertureMm":203,"filterCodes":[],"targetCodes":[]},{"logRef":"gp-02","revision":2,"observerCode":" av-3 ","seeingArcsec":0.9,"cloudPct":8,"apertureMm":420,"filterCodes":[" ha "],"targetCodes":["m13"]},{"logRef":"gp-03","revision":2,"observerCode":"av-3","seeingArcsec":0.9,"cloudPct":8,"instrumentCode":"dome-3","filterCodes":["HA","OIII"],"targetCodes":["M13","M92","M5"]},{"logRef":"gp-04","revision":2,"observerCode":"av-3","seeingArcsec":0.9,"cloudPct":8,"instrumentCode":"rc-8","apertureMm":120,"filterCodes":["L","R","G","B"],"targetCodes":["M13","M92"]}]';
  }#
}
