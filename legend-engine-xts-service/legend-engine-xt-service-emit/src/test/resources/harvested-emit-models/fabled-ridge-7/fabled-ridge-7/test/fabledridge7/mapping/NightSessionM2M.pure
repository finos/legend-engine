###Mapping
Mapping test::fabledridge7::mapping::NightSessionM2M
(
  *test::fabledridge7::domain::NightSessionReport[reportSet]: Pure
  {
    ~src test::fabledridge7::domain::NightLogPayload
    logStamp: test::fabledridge7::function::logStamp($src.logRef, $src.revision),
    observerLabel: test::fabledridge7::function::observerLabel($src.observerCode),
    seeingBand: test::fabledridge7::function::seeingBand($src.seeingArcsec),
    cloudBand: test::fabledridge7::function::cloudBand($src.cloudPct),
    filterSummary: test::fabledridge7::function::filterSummary($src.filterCodes),
    targetSummary: test::fabledridge7::function::targetSummary($src.targetCodes),
    instrumentLabel: test::fabledridge7::function::instrumentLabel($src.instrumentCode),
    apertureBand: test::fabledridge7::function::apertureBand($src.apertureMm),
    gradeLabel: test::fabledridge7::function::gradeLabel($src.seeingArcsec, $src.cloudPct),
    usabilityLabel: test::fabledridge7::function::usabilityLabel(
      test::fabledridge7::function::gradeLabel($src.seeingArcsec, $src.cloudPct),
      test::fabledridge7::function::filterCount($src.filterCodes)
    )
  }
)
