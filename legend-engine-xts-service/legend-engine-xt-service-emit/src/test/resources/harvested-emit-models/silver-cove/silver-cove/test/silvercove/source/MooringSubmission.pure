###Pure
Class {meta::pure::profiles::doc.doc = 'One inbound mooring-register submission for the cove, delivered to the executor as a serialised document rather than read from a database. Every field is optional on the wire, so the mapping decides which of them the published register insists on.'} demo::silvercove::source::MooringSubmission
{
  mooringRef: String[0..1];
  berthCode: String[0..1];
  registerCode: String[0..1];
  harbourCode: String[0..1];
  vesselName: String[0..1];
  mooringKind: String[0..1];
  lengthMetres: Integer[0..1];
  bollardCount: Integer[0..1];
  arrivedOn: StrictDate[0..1];
  departedOn: StrictDate[0..1];
  recordedAt: DateTime[0..1];
}
