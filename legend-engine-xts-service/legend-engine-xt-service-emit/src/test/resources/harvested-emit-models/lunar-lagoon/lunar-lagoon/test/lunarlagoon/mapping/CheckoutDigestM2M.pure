###Mapping
Mapping test::lunarlagoon::mapping::CheckoutDigestM2M
(
  *test::lunarlagoon::domain::BranchDigest: Pure
  {
    ~src test::lunarlagoon::source::BranchLog
    branch: $src.branchName,
    checkoutCount: $src.checkouts->size(),
    distinctTitleCount: $src.checkouts.title->removeDuplicates()->size(),
    longestCheckoutDays: $src.checkouts->map(e|$e.checkoutDays())->max()->toOne(),
    totalCheckoutDays: $src.checkouts->map(e|$e.checkoutDays())->fold({a, b|$a + $b}, 0),
    cataloguedCount: $src.checkouts.category->removeDuplicates()->filter(c|$c->in(['FICTION', 'REFERENCE', 'CHILDREN']))->size(),
    hasReference: $src.checkouts.category->exists(c|$c == 'REFERENCE'),
    firstTitle: $src.checkouts.title->sort()->first()->toOne()
  }
)
