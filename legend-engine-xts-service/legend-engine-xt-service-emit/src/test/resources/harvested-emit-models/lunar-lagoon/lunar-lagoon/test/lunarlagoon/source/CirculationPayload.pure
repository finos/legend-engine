import test::lunarlagoon::source::*;

Class test::lunarlagoon::source::CheckoutEntry
{
  title: String[1];
  category: String[1];
  borrowedOn: StrictDate[1];
  returnBy: StrictDate[1];

  checkoutDays() { dateDiff($this.borrowedOn, $this.returnBy, meta::pure::functions::date::DurationUnit.DAYS) }: Integer[1];
}

Class test::lunarlagoon::source::BranchLog
{
  branchName: String[1];
  checkouts: CheckoutEntry[*];
}
