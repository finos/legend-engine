###Pure
import test::olivequarry2::source::*;

Class {meta::pure::profiles::doc.doc = 'An inbound dispatch document for one cut stone block leaving the heritage quarry.'} test::olivequarry2::source::BlockDispatch
{
  dispatchRef: String[1];
  blockCode: String[0..1];
  gradeText: String[0..1];
  finishText: String[0..1];
  massKg: Integer[0..1];
  faceCount: Integer[1];
  legacyCode: String[0..1];
  site: SiteRecord[0..1];
  tags: TagRecord[*];
}

Class {meta::pure::profiles::doc.doc = 'The nested quarry-site element of a dispatch document.'} test::olivequarry2::source::SiteRecord
{
  quarryName: String[1];
  benchLabel: String[0..1];
  elevationM: Integer[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A marking tag painted on the block, possibly retired.'} test::olivequarry2::source::TagRecord
{
  scheme: String[1];
  tagValue: String[1];
  retired: Boolean[0..1];
}
