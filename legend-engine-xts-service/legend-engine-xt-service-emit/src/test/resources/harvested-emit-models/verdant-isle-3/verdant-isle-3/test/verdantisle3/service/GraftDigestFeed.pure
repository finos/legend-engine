###Service
Service test::verdantisle3::service::GraftDigestFeed
{
  pattern: '/verdantisle3/graftDigestFeed';
  title: 'Verdant Isle - Graft Digest Feed';
  owners:
  [
    'orchard-propagation-guild'
  ];
  documentation: 'Publishes whole refined grafting records - key, defaulted labels and every nested wrapper - through a single execution over the graft digest transformation. No physical store takes part: the runtime is declared inline on the service and binds the inbound sheet row through a model store JSON connection.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |test::verdantisle3::domain::GraftDigest.all()->graphFetch(
      #{
        test::verdantisle3::domain::GraftDigest{
          graftKey,
          registerLabel,
          inspectorLabel,
          takeRateLabel,
          noteDigest,
          takeCount,
          failCount,
          rootstock{
            code
          },
          scion{
            code
          },
          plot{
            plotCode
          },
          grafter{
            initials
          },
          tool{
            toolCode
          },
          health{
            band
          },
          window{
            opensOn,
            closesOn
          }
        }
      }#
    )->serialize(
      #{
        test::verdantisle3::domain::GraftDigest{
          graftKey,
          registerLabel,
          inspectorLabel,
          takeRateLabel,
          noteDigest,
          takeCount,
          failCount,
          rootstock{
            code
          },
          scion{
            code
          },
          plot{
            plotCode
          },
          grafter{
            initials
          },
          tool{
            toolCode
          },
          health{
            band
          },
          window{
            opensOn,
            closesOn
          }
        }
      }#
    );
    mapping: test::verdantisle3::mapping::GraftDigestM2M;
    runtime:
    #{
      mappings:
      [
        test::verdantisle3::mapping::GraftDigestM2M
      ];
      connections:
      [
        ModelStore:
        [
          inboundGraftRows:
          #{
            JsonModelConnection
            {
              class: test::verdantisle3::domain::GraftSheetRow;
              url: 'data:application/json,%7B%7D';
            }
          }#
        ]
      ];
    }#;
  }
  testSuites:
  [
    populatedSheetRowSuite:
    {
      data:
      [
        connections:
        [
          inboundGraftRows:
            ExternalFormat
            #{
              contentType: 'application/json';
              data: '[{"sheetRef":" gs-2201 ","rawRootstock":" m26 ","rawScion":" ashmead ","rawPlot":" north-2 ","rawGrafter":"nina hart","rawTool":" knife-4 ","rawHealthScore":" 9 ","rawWindowOpen":"2026-02-20","rawWindowClose":"2026-03-15","notes":[{"noteKind":"union","noteText":" bud swelling "}],"payload":{"@type":"test::verdantisle3::domain::DetailedGraftPayload","payloadVersion":"v2","takeCount":19,"failCount":1,"inspectorTag":" ni h "}}]';
            }#
        ]
      ]
      tests:
      [
        wholeDigestIsPublished:
        {
          asserts:
          [
            oneDigest:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":{"graftKey":"GS-2201/M26","registerLabel":"community orchard graft register","inspectorLabel":"NI H","takeRateLabel":"STRONG TAKE","noteDigest":"UNION:BUD SWELLING","takeCount":19,"failCount":1,"rootstock":{"code":"M26"},"scion":{"code":"ASHMEAD"},"plot":{"plotCode":"PLOT-NORTH-2"},"grafter":{"initials":"NI"},"tool":{"toolCode":"KNIFE-4"},"health":{"band":"VIGOROUS"},"window":{"opensOn":"2026-02-20","closesOn":"2026-03-15"}}}';
                  }#;
              }#
          ]
        }
      ]
    },
    bareSheetRowSuite:
    {
      data:
      [
        connections:
        [
          inboundGraftRows:
            ExternalFormat
            #{
              contentType: 'application/json';
              data: '[{"sheetRef":"gs-2202"}]';
            }#
        ]
      ]
      tests:
      [
        everyWrapperFallsBackToItsDefault:
        {
          asserts:
          [
            defaultedDigest:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":{"graftKey":"GS-2202/UNK","registerLabel":"community orchard graft register","inspectorLabel":"UNINSPECTED","takeRateLabel":"NO PAYLOAD","noteDigest":null,"takeCount":null,"failCount":null,"rootstock":{"code":"UNKNOWN ROOTSTOCK"},"scion":{"code":"UNKNOWN SCION"},"plot":{"plotCode":"UNPLOTTED"},"grafter":{"initials":"NN"},"tool":{"toolCode":"UNASSIGNED"},"health":{"band":"UNSCORED"},"window":{"opensOn":"UNDATED","closesOn":"UNDATED"}}}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
