###Pure
import test::cedardelta::domain::*;

Class {meta::pure::profiles::doc.doc = 'A published street-tree inventory row whose size class, canopy remark, note digest and health grade are derived by the shared census function library.'} test::cedardelta::domain::TreeRow
{
  recordId: String[1];
  ward: String[1];
  speciesCode: String[1];
  heightM: Integer[1];
  sizeClass: String[1];
  canopyRemark: String[1];
  noteDigest: String[1];
  healthGrade: String[1];
  rowSummary: String[1];
  {meta::pure::profiles::doc.doc = 'Whether the row was graded as a veteran heritage tree in prime canopy condition.'} isVeteran()
  {
    ($this.sizeClass == 'HERITAGE') && ($this.healthGrade == 'PRIME')
  }: Boolean[1];
}
