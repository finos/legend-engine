###Mapping
Mapping test::cedardelta::mapping::TreeRowFromSurvey
(
  *test::cedardelta::domain::TreeRow[tree_row]: Pure
  {
    ~src test::cedardelta::source::SurveyRecord
    recordId: $src.recordId,
    ward: $src.ward,
    speciesCode: $src.speciesCode,
    heightM: $src.heightM,
    sizeClass: test::cedardelta::function::sizeClass($src.trunkCm),
    canopyRemark: test::cedardelta::function::canopyRemark($src.canopyState),
    noteDigest: test::cedardelta::function::noteDigest($src.crewNote),
    healthGrade: test::cedardelta::function::healthGrade($src.trunkCm, $src.canopyState),
    rowSummary: test::cedardelta::function::rowSummary($src.trunkCm, $src.canopyState, $src.crewNote)
  }
)
