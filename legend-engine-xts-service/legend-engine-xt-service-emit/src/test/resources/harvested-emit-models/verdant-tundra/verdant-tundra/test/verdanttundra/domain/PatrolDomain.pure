import test::verdanttundra::domain::*;

Enum test::verdanttundra::domain::TrailKind
{
  RIDGE,
  VALLEY,
  LAKESHORE,
  MEADOW,
  OTHER
}

Enum test::verdanttundra::domain::EventKind
{
  ARRIVAL,
  DEPARTURE,
  SIGHTING,
  REPAIR,
  OTHER
}

Class test::verdanttundra::domain::PatrolRecord
{
  recordRef: String[1];
  rangerName: String[1];
  trailCode: String[1];
  eventCode: String[1];
  loggedOn: String[1];
  distanceText: String[1];
  sightingText: String[1];
}

Class test::verdanttundra::domain::PatrolEvent
{
  patrolTag: String[1];
  rangerName: String[1];
  trailCode: String[1];
  trailKind: TrailKind[1];
  eventKind: EventKind[1];
  loggedOn: String[1];
  logYear: Integer[1];
  distanceKm: Integer[1];
  effortBand: String[0..1];
  sightingCount: Integer[1];
}

Class test::verdanttundra::domain::PatrolDigest
{
  digestTag: String[1];
  rangerLabel: String[1];
  trailKind: TrailKind[1];
  effortBand: String[0..1];
  distanceKm: Integer[1];
  sightingRate: Integer[1];
  digestNote: String[1];
}

Class test::verdanttundra::domain::PatrolBulletin
{
  bulletinTag: String[1];
  headline: String[1];
  trailKind: TrailKind[1];
  distanceKm: Integer[1];
}
