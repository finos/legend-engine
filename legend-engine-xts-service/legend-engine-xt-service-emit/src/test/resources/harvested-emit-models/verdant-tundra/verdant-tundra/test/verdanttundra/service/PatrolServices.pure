###Service
Service test::verdanttundra::service::PatrolEventFeed
{
  pattern: '/verdanttundra/v1/patrol/events';
  title: 'Verdant Tundra - Normalised Patrol Events';
  owners:
  [
    'trail-operations',
    'ranger-platform'
  ];
  documentation: 'Normalises a raw ranger patrol intake record into a patrol event, banding the walked distance and folding both trail and event codes through enumeration mappings over computed source values.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |test::verdanttundra::domain::PatrolEvent.all()->graphFetch(
      #{
        test::verdanttundra::domain::PatrolEvent{
          patrolTag,
          rangerName,
          trailCode,
          trailKind,
          eventKind,
          logYear,
          distanceKm,
          effortBand,
          sightingCount
        }
      }#
    )->serialize(
      #{
        test::verdanttundra::domain::PatrolEvent{
          patrolTag,
          rangerName,
          trailCode,
          trailKind,
          eventKind,
          logYear,
          distanceKm,
          effortBand,
          sightingCount
        }
      }#
    );
    mapping: test::verdanttundra::mapping::PatrolBaseMapping;
    runtime: test::verdanttundra::runtime::PatrolBaseRuntime;
  }
  testSuites:
  [
    patrolEventFeedSuite:
    {
      data:
      [
        connections:
        [
          patrolFeedConnection:
            ExternalFormat
            #{
              contentType: 'application/json';
              data: '{"recordRef":"r-301","rangerName":"Iris Fenwick","trailCode":"vly","eventCode":"dep","loggedOn":"2025-03-11","distanceText":"30","sightingText":"6"}';
            }#
        ]
      ]
      tests:
      [
        normalisedEvent:
        {
          asserts:
          [
            eventPayload:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":{"patrolTag":"PT-R-301","rangerName":"Iris Fenwick","trailCode":"VLY","trailKind":"VALLEY","eventKind":"DEPARTURE","logYear":2025,"distanceKm":30,"effortBand":"ridge-run","sightingCount":6}}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

###Service
Service test::verdanttundra::service::PatrolDigestFeed
{
  pattern: '/verdanttundra/v1/patrol/digests';
  title: 'Verdant Tundra - Patrol Digests';
  owners:
  [
    'trail-operations',
    'ranger-platform'
  ];
  documentation: 'Chains the normalised patrol event stage into a digest stage, so the intake record is transformed twice before the sighting rate and the band note are surfaced.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |test::verdanttundra::domain::PatrolDigest.all()->graphFetch(
      #{
        test::verdanttundra::domain::PatrolDigest{
          digestTag,
          rangerLabel,
          trailKind,
          effortBand,
          distanceKm,
          sightingRate,
          digestNote
        }
      }#
    )->serialize(
      #{
        test::verdanttundra::domain::PatrolDigest{
          digestTag,
          rangerLabel,
          trailKind,
          effortBand,
          distanceKm,
          sightingRate,
          digestNote
        }
      }#
    );
    mapping: test::verdanttundra::mapping::PatrolDigestMapping;
    runtime: test::verdanttundra::runtime::PatrolDigestRuntime;
  }
  testSuites:
  [
    patrolDigestFeedSuite:
    {
      data:
      [
        connections:
        [
          patrolFeedConnection:
            ExternalFormat
            #{
              contentType: 'application/json';
              data: '{"recordRef":"r-301","rangerName":"Iris Fenwick","trailCode":"vly","eventCode":"dep","loggedOn":"2025-03-11","distanceText":"30","sightingText":"6"}';
            }#
        ]
      ]
      tests:
      [
        chainedDigest:
        {
          asserts:
          [
            digestPayload:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":{"digestTag":"DG-PT-R-301","rangerLabel":"IRIS FENWICK / VLY","trailKind":"VALLEY","effortBand":"ridge-run","distanceKm":30,"sightingRate":20,"digestNote":"banded as ridge-run"}}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

###Service
Service test::verdanttundra::service::PatrolUnionFeed
{
  pattern: '/verdanttundra/v1/patrol/union';
  title: 'Verdant Tundra - Split Patrol Digests';
  owners:
  [
    'trail-operations',
    'ranger-platform'
  ];
  documentation: 'Serves the digest whose implementation is chosen by a router union over two filtered transforms, one for long patrols and one for short patrols.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |test::verdanttundra::domain::PatrolDigest.all()->graphFetch(
      #{
        test::verdanttundra::domain::PatrolDigest{
          digestTag,
          distanceKm,
          digestNote
        }
      }#
    )->serialize(
      #{
        test::verdanttundra::domain::PatrolDigest{
          digestTag,
          distanceKm,
          digestNote
        }
      }#
    );
    mapping: test::verdanttundra::mapping::PatrolUnionMapping;
    runtime: test::verdanttundra::runtime::PatrolUnionRuntime;
  }
  testSuites:
  [
    patrolUnionFeedSuite:
    {
      data:
      [
        connections:
        [
          patrolFeedConnection:
            ExternalFormat
            #{
              contentType: 'application/json';
              data: '{"recordRef":"r-301","rangerName":"Iris Fenwick","trailCode":"vly","eventCode":"dep","loggedOn":"2025-03-11","distanceText":"30","sightingText":"6"}';
            }#
        ]
      ]
      tests:
      [
        longArmSelected:
        {
          asserts:
          [
            unionPayload:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":{"digestTag":"LONG-PT-R-301","distanceKm":30,"digestNote":"long patrol: banded as ridge-run"}}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
