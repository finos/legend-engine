//TODO: these functions need the NormalizeRequiredFunction stereotype as without this the generic type of the colspec is being evaluated as GenericTypeOperation instead of GenericType which isn't being preevaled correctly - once we fix/handle this we can remove this stereotype from these functions
function <<functionType.NormalizeRequiredFunction>> meta::external::dataquality::rowsWithEmptyColumn<T,Z>(rel:Relation<T>[1], col:ColSpec<(?:Z)⊆T>[1]):Relation<T>[1]
{
  $rel->filter(row | eval($col,$row)->isEmpty());
}

function <<functionType.NormalizeRequiredFunction>> meta::external::dataquality::rowsWithNonEmptyColumn<T,Z>(rel:Relation<T>[1], col:ColSpec<(?:Z)⊆T>[1]):Relation<T>[1]
{
  $rel->filter(row | eval($col,$row)->isNotEmpty());
}

function <<functionType.NormalizeRequiredFunction>> meta::external::dataquality::rowsWithValueOutsideRange<T>(rel:Relation<T>[1], col:ColSpec<(?:Number)⊆T>[1], min:Number[1], max:Number[1]):Relation<T>[1]
{
  $rel->filter(row | (eval($col,$row)->toOne() < $min) || (eval($col,$row)->toOne() > $max));
}

function <<functionType.NormalizeRequiredFunction>> meta::external::dataquality::rowsWithNegativeValue<T>(rel:Relation<T>[1], col:ColSpec<(?:Number)⊆T>[1]):Relation<T>[1]
{
  $rel->filter(row | eval($col,$row)->toOne() <= 0);
}

function <<functionType.NormalizeRequiredFunction>> meta::external::dataquality::rowsWithColumnLongerThan<T>(rel:Relation<T>[1], col:ColSpec<(?:String)⊆T>[1], length: Integer[1]):Relation<T>[1]
{
  $rel->filter(row | eval($col,$row)->toOne()->length() > $length);
}

function <<functionType.NormalizeRequiredFunction>> meta::external::dataquality::rowsWithColumnDiffersFromPattern<T>(rel:Relation<T>[1], col:ColSpec<(?:String)⊆T>[1], pattern: String[1]):Relation<T>[1]
{
  $rel->filter(row | !eval($col,$row)->toOne()->matches($pattern));
}

function meta::external::dataquality::normalizeDateTime(value:DateTime[0..1]):String[0..1]
{
  if ($value->isEmpty(),
    | [],
    | $value->toOne()->formatDate(DateTimeFormat.ISO8601_NanoSecondPrecision)
  );
}

function meta::external::dataquality::normalizeDate(value:StrictDate[0..1]):String[0..1]
{
  if ($value->isEmpty(),
    | [],
    | $value->toOne()->formatDate(StrictDateFormat.ISO8601)
  );
}

function meta::external::dataquality::normalizeFloat(value:Float[0..1]):String[0..1]
{
  //TODO - this is NOT EFFICIENT and we should change to use some sort of format function in future - this is converting to IEEE 754 Scientific Notation
  if ($value->isEmpty(),
    | [],
    | if($value->toOne() == 0, | '0.000000000000000E+000', | if($value->toOne() < 0, |'-', |'') + ((($value->toOne()->abs() / pow(10, $value->toOne()->abs()->log10()->floor())) * pow(10, 15))->round() / pow(10, 15))->floor()->toString() + '.' + (((($value->toOne()->abs() / pow(10, $value->toOne()->abs()->log10()->floor())) * pow(10, 15))->round() / pow(10, 14))->floor()->mod(10))->toString() + (((($value->toOne()->abs() / pow(10, $value->toOne()->abs()->log10()->floor())) * pow(10, 15))->round() / pow(10, 13))->floor()->mod(10))->toString() + (((($value->toOne()->abs() / pow(10, $value->toOne()->abs()->log10()->floor())) * pow(10, 15))->round() / pow(10, 12))->floor()->mod(10))->toString() + (((($value->toOne()->abs() / pow(10, $value->toOne()->abs()->log10()->floor())) * pow(10, 15))->round() / pow(10, 11))->floor()->mod(10))->toString() + (((($value->toOne()->abs() / pow(10, $value->toOne()->abs()->log10()->floor())) * pow(10, 15))->round() / pow(10, 10))->floor()->mod(10))->toString() + (((($value->toOne()->abs() / pow(10, $value->toOne()->abs()->log10()->floor())) * pow(10, 15))->round() / pow(10, 9))->floor()->mod(10))->toString() + (((($value->toOne()->abs() / pow(10, $value->toOne()->abs()->log10()->floor())) * pow(10, 15))->round() / pow(10, 8))->floor()->mod(10))->toString() + (((($value->toOne()->abs() / pow(10, $value->toOne()->abs()->log10()->floor())) * pow(10, 15))->round() / pow(10, 7))->floor()->mod(10))->toString() + (((($value->toOne()->abs() / pow(10, $value->toOne()->abs()->log10()->floor())) * pow(10, 15))->round()->mod(10000000) / pow(10, 6))->floor())->toString() + (((($value->toOne()->abs() / pow(10, $value->toOne()->abs()->log10()->floor())) * pow(10, 15))->round()->mod(1000000) / pow(10, 5))->floor())->toString() + (((($value->toOne()->abs() / pow(10, $value->toOne()->abs()->log10()->floor())) * pow(10, 15))->round()->mod(100000) / pow(10, 4))->floor())->toString() + (((($value->toOne()->abs() / pow(10, $value->toOne()->abs()->log10()->floor())) * pow(10, 15))->round()->mod(10000) / pow(10, 3))->floor())->toString() + (((($value->toOne()->abs() / pow(10, $value->toOne()->abs()->log10()->floor())) * pow(10, 15))->round()->mod(1000) / pow(10, 2))->floor())->toString() + (((($value->toOne()->abs() / pow(10, $value->toOne()->abs()->log10()->floor())) * pow(10, 15))->round()->mod(100) / pow(10, 1))->floor())->toString() + ((($value->toOne()->abs() / pow(10, $value->toOne()->abs()->log10()->floor())) * pow(10, 15))->round()->mod(10))->toString() + 'E' + if ($value->toOne()->abs()->log10()->floor() >= 0, | '+', | '-') + ('000' + $value->toOne()->abs()->log10()->floor()->abs()->toString())->substring($value->toOne()->abs()->log10()->floor()->abs()->toString()->length() + 1, $value->toOne()->abs()->log10()->floor()->abs()->toString()->length() + 3))
  );
}

function meta::external::dataquality::normalizeBinary(value:Binary[0..1]):String[0..1]
{
  if ($value->isEmpty(),
    | [],
    | $value->toOne()->toString()->encodeBase64()
  );
}

function <<PCT.test>> meta::external::dataquality::testRelationNotEmpty<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {
               | #TDS
                   val, str
                   1, a
                   3, ewe
                   4, qw
                 #->select(~val)->meta::external::dataquality::relationNotEmpty();
              };

    let res =  $f->eval($expr)->toOne();

    assertEquals(true, $res);
}

function <<PCT.test>> meta::external::dataquality::testRelationEmpty<T|m>(f:Function<{Function<{->T[m]}>[1]->T[m]}>[1]):Boolean[1]
{
    let expr = {
               | #TDS
                   val, str
                   1, a
                   3, ewe
                   4, qw
                 #->select(~val)->meta::external::dataquality::relationEmpty();
              };

    let res =  $f->eval($expr)->toOne();

    assertEquals(false, $res);
}

