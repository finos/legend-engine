###Runtime
Runtime demo::embercanyon3::runtime::VaultRuntime
{
  mappings:
  [
    demo::embercanyon3::mapping::VaultMapping
  ];
  connections:
  [
    demo::embercanyon3::store::VaultDatabase:
    [
      vaultConnection: demo::embercanyon3::connection::VaultConnection
    ]
  ];
}

Runtime demo::embercanyon3::runtime::TrialDigestRuntime
{
  mappings:
  [
    demo::embercanyon3::mapping::TrialDigestMapping
  ];
  connections:
  [
    demo::embercanyon3::store::VaultDatabase:
    [
      vaultConnection: demo::embercanyon3::connection::VaultConnection
    ],
    ModelStore:
    [
      chainConnection: demo::embercanyon3::connection::VaultChainConnection
    ]
  ];
}

Runtime demo::embercanyon3::runtime::TrialDigestChainRuntime
{
  mappings:
  [
    demo::embercanyon3::mapping::TrialDigestMapping
  ];
  connections:
  [
    demo::embercanyon3::store::VaultDatabase:
    [
      vaultConnection: demo::embercanyon3::connection::VaultConnection
    ],
    ModelStore:
    [
      chainConnection: demo::embercanyon3::connection::VaultChainConnection
    ]
  ];
}
