Class {meta::pure::profiles::doc.doc = 'A named mountain peak catalogued by an alpine survey.'} test::emeraldsummit::domain::Peak
{
  name: String[1];
  heightMeters: Integer[1];
  firstAscentYear: Integer[0..1];
  isEightThousander() {$this.heightMeters >= 8000}: Boolean[1];
}

Class {meta::pure::profiles::doc.doc = 'A mountaineering expedition that attempted to summit a peak in a given season.'} test::emeraldsummit::domain::Expedition
{
  teamName: String[1];
  season: String[1];
  summited: Boolean[1];
}
