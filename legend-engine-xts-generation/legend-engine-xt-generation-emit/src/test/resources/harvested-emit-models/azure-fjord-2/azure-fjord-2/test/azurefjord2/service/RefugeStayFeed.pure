###Service
Service test::azurefjord2::service::RefugeStayFeed
{
  pattern: '/azurefjord2/refugeStayFeed';
  title: 'Mountain Refuge Stay Feed';
  owners:
  [
    'refuge-warden-desk'
  ];
  documentation: 'Turns a warden sheet row that arrives as a document into the published stay record with no database involved, so the generated plan is materialised from the model binding alone and the transformed tree — including the tag normalised off the sheet reference and the night count summed from the two occupancy columns — is serialised for the caller.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |test::azurefjord2::domain::RefugeStay.all()->graphFetch(
      #{
        test::azurefjord2::domain::RefugeStay{
          stayRef,
          refugeName,
          partyLeader,
          partySize,
          totalNights,
          arrivedOn
        }
      }#
    )->serialize(
      #{
        test::azurefjord2::domain::RefugeStay{
          stayRef,
          refugeName,
          partyLeader,
          partySize,
          totalNights,
          arrivedOn
        }
      }#
    );
    mapping: test::azurefjord2::mapping::RefugeStayM2M;
    runtime: test::azurefjord2::runtime::WardenSheetRuntime;
  }
  testSuites:
  [
    refugeStayFeedSuite:
    {
      data:
      [
        connections:
        [
          wardenSheetConnection:
            ExternalFormat
            #{
              contentType: 'application/json';
              data: '{"sheetRef":" rf-0412 ","refugeLabel":"Larch Saddle Refuge","leaderName":"Ida Barrowman","partySize":4,"bunkNights":3,"terraceNights":2,"arrivedOn":"2024-07-18"}';
            }#
        ]
      ]
      tests:
      [
        transformedStay:
        {
          asserts:
          [
            publishedRow:
              EqualToJson
              #{
                expected: ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"builder":{"_type":"json"},"values":{"stayRef":"RF-0412","refugeName":"Larch Saddle Refuge","partyLeader":"Ida Barrowman","partySize":4,"totalNights":5,"arrivedOn":"2024-07-18"}}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
