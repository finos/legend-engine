###Pure
function test::azurefjord2::function::stayRoster(stays: test::azurefjord2::domain::RefugeStay[*], minimumNights: Integer[1]): meta::pure::tds::TabularDataSet[1]
{
  $stays->filter(s | $s.totalNights >= $minimumNights)->project(
    [
      col(s | $s.stayRef, 'Stay/Ref'),
      col(s | $s.refugeName, 'Stay/Refuge'),
      col(s | $s.partyLeader, 'Stay/Leader'),
      col(s | $s.totalNights, 'Stay/TotalNights'),
      col(s | $s.totalNights * $s.partySize, 'Stay/PersonNights')
    ]
  )->sort([asc('Stay/Ref')]);
}
