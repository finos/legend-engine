###Pure
import test::goldenthicket2::domain::*;

Enum {meta::pure::profiles::doc.doc = 'Outcome of matching an intake record against the register.'} test::goldenthicket2::domain::MatchOutcome
{
  EXACT,
  PARTIAL,
  AMBIGUOUS,
  NONE
}

Enum {meta::pure::profiles::doc.doc = 'State of the field-form validation sweep.'} test::goldenthicket2::domain::ValidationState
{
  ACCEPTED,
  QUERIED,
  REJECTED
}

Enum {meta::pure::profiles::doc.doc = 'State of the reference enrichment pass.'} test::goldenthicket2::domain::EnrichmentState
{
  ENRICHED,
  PARTIAL,
  SKIPPED,
  FAILED
}

Enum {meta::pure::profiles::doc.doc = 'State of the warden resolution step.'} test::goldenthicket2::domain::ResolutionState
{
  RESOLVED,
  PENDING,
  ESCALATED
}
