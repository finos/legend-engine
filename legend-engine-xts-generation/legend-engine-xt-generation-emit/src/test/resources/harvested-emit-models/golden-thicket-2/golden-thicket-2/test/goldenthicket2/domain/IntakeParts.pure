###Pure
import test::goldenthicket2::domain::*;

Class {meta::pure::profiles::doc.doc = 'Person or team that reported the animal.'} test::goldenthicket2::domain::IntakeReporter
{
  reporterRef: String[1];
  displayName: String[0..1];
  contactPhone: String[0..1];
  contactEmail: String[0..1];
  reporterKind: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'Where the animal was found.'} test::goldenthicket2::domain::IntakeSite
{
  siteRef: String[1];
  siteName: String[0..1];
  district: String[0..1];
  gridReference: String[0..1];
  habitatNote: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'The animal itself as described on intake.'} test::goldenthicket2::domain::IntakeSpecimen
{
  specimenRef: String[1];
  commonName: String[0..1];
  lifeStage: String[0..1];
  sexNote: String[0..1];
  bandCode: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'One recorded measurement of the specimen.'} test::goldenthicket2::domain::IntakeMeasurement
{
  measurementRef: String[1];
  measureName: String[0..1];
  recordedValue: String[0..1];
  unitLabel: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'Container or vehicle the animal arrived in.'} test::goldenthicket2::domain::IntakeCarrier
{
  carrierRef: String[1];
  carrierKind: String[0..1];
  ventilationNote: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'Handoff window agreed with the receiving centre.'} test::goldenthicket2::domain::IntakeHandoff
{
  handoffRef: String[1];
  windowLabel: String[0..1];
  receivingCentre: String[0..1];
  transportNote: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A photograph or scanned field form.'} test::goldenthicket2::domain::IntakeAttachment
{
  attachmentRef: String[1];
  attachmentKind: String[0..1];
  captionText: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A free-text note left by a warden.'} test::goldenthicket2::domain::IntakeNote
{
  noteRef: String[1];
  noteText: String[0..1];
  authorRef: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'Warden who reviewed the record.'} test::goldenthicket2::domain::IntakeReviewer
{
  reviewerRef: String[1];
  reviewerName: String[0..1];
  reviewNote: String[0..1];
}
