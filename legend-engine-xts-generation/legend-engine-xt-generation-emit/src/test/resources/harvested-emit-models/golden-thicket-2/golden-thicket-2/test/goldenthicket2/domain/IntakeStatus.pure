###Pure
import test::goldenthicket2::domain::*;

Class {meta::pure::profiles::doc.doc = 'Lifecycle states reached by the intake record. Every member is optional, so an absent state and an unknown state are indistinguishable at the model level.'} test::goldenthicket2::domain::IntakeStatusBlock
{
  matchOutcome: MatchOutcome[0..1];
  validationState: ValidationState[0..1];
  enrichmentState: EnrichmentState[0..1];
  resolutionState: ResolutionState[0..1];
}
