###Pure
import test::goldenthicket2::domain::*;

Class {meta::pure::profiles::doc.doc = 'Aggregate root of a wildlife intake request. Ten nested classes hang off it at mandatory-one, optional, one-or-more and zero-or-more cardinalities, so a valid instance is characterised by which optional branches are populated rather than by the type structure.'} test::goldenthicket2::domain::WildlifeIntakeRequest
{
  requestRef: String[1];
  requestKind: String[1];
  raisedOn: String[1];
  raisedByRef: String[1];
  channelName: String[0..1];
  priorityLabel: String[0..1];
  summaryText: String[0..1];
  callbackNote: String[0..1];
  registerRef: String[0..1];
  licenceRef: String[0..1];
  permitNote: String[0..1];
  consentNote: String[0..1];
  triageLabel: String[0..1];
  triageNote: String[0..1];
  weatherNote: String[0..1];
  hazardNote: String[0..1];
  releasePlanNote: String[0..1];
  followUpNote: String[0..1];
  closedOn: String[0..1];
  closureNote: String[0..1];
  archiveRef: String[0..1];
  reporter: IntakeReporter[1];
  site: IntakeSite[1];
  specimen: IntakeSpecimen[1];
  measurements: IntakeMeasurement[*];
  carrier: IntakeCarrier[0..1];
  handoff: IntakeHandoff[0..1];
  attachments: IntakeAttachment[1..*];
  notes: IntakeNote[*];
  reviewers: IntakeReviewer[1..*];
  status: IntakeStatusBlock[0..1];
}
