###Relational
Database test::cedarquarry2::store::CeramicsRegisterDatabase
(
  Schema ceramics
  (
    Table vessel_entry
    (
      vessel_id INTEGER PRIMARY KEY,
      accession_code VARCHAR(16),
      height_mm INTEGER,
      clay_body VARCHAR(16),
      condition_code VARCHAR(16),
      rim_diameter_mm INTEGER,
      base_diameter_mm INTEGER,
      room_code VARCHAR(16)
    )

    Table tile_entry
    (
      tile_id INTEGER PRIMARY KEY,
      accession_code VARCHAR(16),
      height_mm INTEGER,
      clay_body VARCHAR(16),
      condition_code VARCHAR(16),
      glazed_face_count INTEGER,
      tile_edge_mm INTEGER
    )

    Table collection_room
    (
      room_code VARCHAR(16) PRIMARY KEY,
      room_name VARCHAR(64)
    )

    Table kiln_firing_record
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )

      firing_id INTEGER PRIMARY KEY,
      firing_code VARCHAR(16),
      kiln_code VARCHAR(16),
      atmosphere_code VARCHAR(16),
      peak_temperature_c INTEGER,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )

    Table catalogue_revision
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )

      revision_id INTEGER PRIMARY KEY,
      revision_code VARCHAR(16),
      accession_code VARCHAR(16),
      revision_note VARCHAR(128),
      in_z DATE NOT NULL,
      out_z DATE NOT NULL
    )

    Table display_placement
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z),
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )

      placement_id INTEGER PRIMARY KEY,
      placement_code VARCHAR(16),
      accession_code VARCHAR(16),
      venue_name VARCHAR(64),
      crate_count INTEGER,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL,
      in_z DATE NOT NULL,
      out_z DATE NOT NULL
    )
  )
)
