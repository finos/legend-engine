###Runtime
Runtime test::meadowridge2::runtime::RidgewayRuntime
{
  mappings:
  [
    test::meadowridge2::mapping::RidgewayMapping
  ];
  connections:
  [
    test::meadowridge2::store::RidgewayDatabase:
    [
      embeddedRidgewayConnection:
      #{
        RelationalDatabaseConnection
        {
          store: test::meadowridge2::store::RidgewayDatabase;
          type: H2;
          specification: LocalH2
          {
            testDataSetupSqls: [
              'drop schema if exists RIDGEWAY cascade;',
              'create schema RIDGEWAY;',
              'create table RIDGEWAY.MEADOW_PATH(NODE_ID DOUBLE PRIMARY KEY, PATH_NAME VARCHAR(16777216), SURFACE_TYPE VARCHAR(16777216));',
              'create table RIDGEWAY.WAYMARK_POST(NODE_ID DOUBLE PRIMARY KEY, POST_CODE VARCHAR(24), POST_FINISH VARCHAR(24), PATH_NODE_ID DOUBLE);',
              'delete from RIDGEWAY.WAYMARK_POST;',
              'delete from RIDGEWAY.MEADOW_PATH;',
              'insert into RIDGEWAY.MEADOW_PATH (NODE_ID, PATH_NAME, SURFACE_TYPE) values (1.0, \'North Hay Ridge\', \'mown sward\');',
              'insert into RIDGEWAY.MEADOW_PATH (NODE_ID, PATH_NAME, SURFACE_TYPE) values (2.0, \'East Cowslip Ridge\', \'stone flag\');',
              'insert into RIDGEWAY.WAYMARK_POST (NODE_ID, POST_CODE, POST_FINISH, PATH_NODE_ID) values (10.0, \'WP-10\', \'oiled larch\', 1.0);',
              'insert into RIDGEWAY.WAYMARK_POST (NODE_ID, POST_CODE, POST_FINISH, PATH_NODE_ID) values (11.5, \'WP-11\', \'weathered oak\', 2.0);',
              'insert into RIDGEWAY.WAYMARK_POST (NODE_ID, POST_CODE, POST_FINISH, PATH_NODE_ID) values (12.0, \'WP-12\', \'galvanised steel\', 2.0);'
            ];
          };
          auth: DefaultH2;
        }
      }#
    ]
  ];
}
