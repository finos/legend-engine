###Pure
import meta::pure::profiles::*;
import test::meadowridge2::domain::*;

Class {doc.doc = 'One waymark post along a meadow ridgeway path. The leaf of the two-class model: two mandatory text properties plus a mandatory floating-point identifier that is mapped to the key column, so an approximate number is both the identity and a published output field.'} test::meadowridge2::domain::WaymarkPost
{
  postCode: String[1];
  postFinish: String[1];
  postNumber: Float[1];
}

Class {doc.doc = 'A meadow ridgeway path, holding two mandatory text properties and a zero-or-more collection of the waymark posts along it. The collection is the only complex-typed property and resolves through the store join rather than through an association element, and the path key column is deliberately not surfaced as a property.'} test::meadowridge2::domain::MeadowPath
{
  pathName: String[1];
  surfaceType: String[1];
  posts: WaymarkPost[*];
}
