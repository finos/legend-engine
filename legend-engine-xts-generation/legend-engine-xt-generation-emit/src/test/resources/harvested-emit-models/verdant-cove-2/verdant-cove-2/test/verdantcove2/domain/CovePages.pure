###Pure
import test::verdantcove2::domain::*;

Class {meta::pure::profiles::doc.doc = 'Page envelope over survey records: an unbounded collection of one detail kind plus an optional page marker, so one instance describes a page rather than a record.'} test::verdantcove2::domain::SurveyRecordPage
{
  records: SurveyRecord[*];
  marker: PageMarker[0..1];
}

Class {meta::pure::profiles::doc.doc = 'Page envelope over species counts, repeating the same collection-plus-marker shape for a second detail kind.'} test::verdantcove2::domain::SpeciesCountPage
{
  counts: SpeciesCount[*];
  marker: PageMarker[0..1];
}

Class {meta::pure::profiles::doc.doc = 'Page envelope over quadrat readings, repeating the collection-plus-marker shape for a third detail kind.'} test::verdantcove2::domain::QuadratReadingPage
{
  readings: QuadratReading[*];
  marker: PageMarker[0..1];
}
