###Pure
import demo::amberisle2::domain::*;
import demo::amberisle2::profile::*;

Class <<ColonyMeta.provenanceBlock>> {ColonyMeta.steward = 'colony-survey-team'} demo::amberisle2::domain::AmendmentProvenance
{
  <<ColonyMeta.colonyKey, Serialisation.notNull>> {ColonyMeta.maxLength = '18'} amendmentCode: String[1];
  <<Serialisation.notNull>> {ColonyMeta.maxLength = '48'} amendingObserver: String[1];
  <<Serialisation.nullable>> {ColonyMeta.maxLength = '48'} approvingObserver: String[0..1];
  <<Serialisation.nullable>> {ColonyMeta.maxLength = '48'} retiringObserver: String[0..1];
  <<Serialisation.nullable>> {ColonyMeta.maxLength = '1024'} amendmentNote: String[0..1];
  <<Serialisation.nullable>> {ColonyMeta.maxLength = '1024'} retirementNote: String[0..1];
  <<Serialisation.notNull>> {ColonyMeta.maxLength = '8'} reasonCode: String[1];
  <<Serialisation.nullable>> revisedOn: StrictDate[0..1];
  <<ColonyMeta.colonyKey, Serialisation.notNull>> observedOn: StrictDate[1];
  <<Serialisation.nullable>> intakeAt: DateTime[0..1];
  <<Serialisation.nullable>> releaseAt: DateTime[0..1];
}

Class demo::amberisle2::domain::NestCountAmendment extends AmendmentProvenance
{
  <<Serialisation.notNull>> {ColonyMeta.maxLength = '12'} colonyCode: String[1];
  <<Serialisation.notNull>> {ColonyMeta.maxLength = '1'} plotBand: String[1];
  <<Serialisation.notNull>> occupiedNests: Integer[1];
  <<Serialisation.nullable>> apparentlyOccupiedSites: Integer[0..1];
}

Class demo::amberisle2::domain::RingRecoveryAmendment extends AmendmentProvenance
{
  <<Serialisation.notNull>> {ColonyMeta.maxLength = '12'} ringCode: String[1];
  <<Serialisation.notNull>> {ColonyMeta.maxLength = '32'} speciesCode: String[1];
  <<Serialisation.nullable>> recoveryDistanceKm: Float[0..1];
  <<Serialisation.notNull>> {ColonyMeta.maxLength = '4'} conditionBand: String[1];
}

Class demo::amberisle2::domain::ForageSampleAmendment extends AmendmentProvenance
{
  <<Serialisation.notNull>> {ColonyMeta.maxLength = '16'} sampleCode: String[1];
  <<Serialisation.notNull>> {ColonyMeta.maxLength = '64'} preyGroup: String[1];
  <<Serialisation.notNull>> sampleMassGrams: Float[1];
  <<Serialisation.nullable>> sampleDepthMetres: Float[0..1];
}

Class demo::amberisle2::domain::BurrowSurveyAmendment extends AmendmentProvenance
{
  <<Serialisation.notNull>> {ColonyMeta.maxLength = '12'} burrowPlotCode: String[1];
  <<Serialisation.notNull>> burrowsProbed: Integer[1];
  <<Serialisation.nullable>> burrowsResponding: Integer[0..1];
  <<Serialisation.nullable>> {ColonyMeta.maxLength = '256'} substrateNote: String[0..1];
}
