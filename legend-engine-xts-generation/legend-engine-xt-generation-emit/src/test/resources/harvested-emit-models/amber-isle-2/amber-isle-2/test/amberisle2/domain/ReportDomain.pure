###Pure
import demo::amberisle2::domain::*;
import demo::amberisle2::profile::*;

Class <<ColonyMeta.publishedField>> {ColonyMeta.steward = 'colony-register'} demo::amberisle2::domain::ColonyReportRecord
{
  <<ColonyMeta.colonyKey, Serialisation.notNull>> {ColonyMeta.maxLength = '18'} reportCode: String[1];
  <<Serialisation.notNull>> publishedOn: StrictDate[1];
  <<Serialisation.notNull>> {ColonyMeta.maxLength = '12'} colonyCode: String[1];
}

Class demo::amberisle2::domain::SeasonTotalsReport extends ColonyReportRecord
{
  <<Serialisation.notNull>> {ColonyMeta.maxLength = '120'} seasonCaption: String[1];
  <<Serialisation.notNull>> totalOccupiedNests: Integer[1];
}

Class demo::amberisle2::domain::SpeciesMixReport extends ColonyReportRecord
{
  <<Serialisation.notNull>> {ColonyMeta.maxLength = '1'} dominantSpeciesBand: String[1];
}

Class demo::amberisle2::domain::ForageMixReport extends ColonyReportRecord
{
  <<Serialisation.notNull>> {ColonyMeta.maxLength = '1024'} forageCommentary: String[1];
}

Class demo::amberisle2::domain::BurrowOccupancyReport extends ColonyReportRecord
{
  <<Serialisation.notNull>> occupancyPercent: Float[1];
}

Class <<ColonyMeta.provenanceBlock>> {ColonyMeta.steward = 'colony-survey-team'} demo::amberisle2::domain::AmendedReportTrait
{
  <<Serialisation.notNull>> {ColonyMeta.maxLength = '18'} supersededReportCode: String[1];
  <<Serialisation.notNull>> {ColonyMeta.maxLength = '8'} amendmentReasonCode: String[1];
}

Class demo::amberisle2::domain::AmendedSeasonTotalsReport extends SeasonTotalsReport, AmendedReportTrait
{
}

Class demo::amberisle2::domain::AmendedBurrowOccupancyReport extends BurrowOccupancyReport, AmendedReportTrait
{
}
