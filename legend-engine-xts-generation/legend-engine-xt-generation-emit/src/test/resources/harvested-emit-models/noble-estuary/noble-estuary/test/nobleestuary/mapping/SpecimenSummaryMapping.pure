###Mapping
Mapping test::nobleestuary::mapping::SpecimenSummaryMapping
(
  *test::nobleestuary::domain::SpecimenSummary: Pure
  {
    ~src test::nobleestuary::domain::SpecimenRecord
    recordId: $src.recordId,
    taxonName: $src.taxonName,
    taxonNameAlt: $src.taxonName,
    site: $src
  }

  *test::nobleestuary::domain::Address: Pure
  {
    ~src test::nobleestuary::domain::SpecimenRecord
    streetLine: $src.siteStreet,
    cityName: $src.siteCity,
    postalCode: $src.sitePostalCode
  }

  testSuites:
  [
    specimenSummarySuite:
    {
      function: |test::nobleestuary::domain::SpecimenSummary.all()->graphFetch(
        #{
          test::nobleestuary::domain::SpecimenSummary{
            site{
              streetLine,
              cityName,
              postalCode
            },
            recordId,
            taxonName,
            taxonNameAlt
          }
        }#
      )->serialize(
        #{
          test::nobleestuary::domain::SpecimenSummary{
            site{
              streetLine,
              cityName,
              postalCode
            },
            recordId,
            taxonName,
            taxonNameAlt
          }
        }#
      );
      tests:
      [
        fullyPopulatedSpecimen:
        {
          doc: 'Reshapes a specimen record into a summary whose taxon label appears twice and whose site address is nested through the self-assigning class mapping.';
          data:
          [
            ModelStore:
              ModelStore
              #{
                test::nobleestuary::domain::SpecimenRecord:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"recordId":"SPC-4102","taxonName":"Zostera marina","siteStreet":"18 Estuary Walk","siteCity":"Northmarsh","sitePostalCode":"NM4 2QT"}';
                  }#
              }#
          ];
          asserts:
          [
            summaryDocument:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"site":{"streetLine":"18 Estuary Walk","cityName":"Northmarsh","postalCode":"NM4 2QT"},"recordId":"SPC-4102","taxonName":"Zostera marina","taxonNameAlt":"Zostera marina"}';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
