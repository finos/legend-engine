###Mapping
Mapping test::nobleestuary::mapping::IntakeFanOutMapping
(
  *test::nobleestuary::domain::Exhibit: Pure
  {
    ~src test::nobleestuary::domain::IntakeFeed
    exhibitId: $src.feedId,
    exhibitTitle: $src.title,
    galleryName: $src.gallery,
    openingYear: $src.openedYear,
    location: $src,
    steward: $src,
    audience: $src
  }

  *test::nobleestuary::domain::ExhibitLocation: Pure
  {
    ~src test::nobleestuary::domain::IntakeFeed
    buildingName: $src.buildingName,
    floorLabel: $src.floorLabel,
    roomCode: $src.roomCode
  }

  *test::nobleestuary::domain::ExhibitSteward: Pure
  {
    ~src test::nobleestuary::domain::IntakeFeed
    stewardName: $src.stewardName,
    stewardAlias: $src.stewardAlias,
    stewardTeam: $src.stewardTeam,
    stewardPhoneExt: $src.stewardPhoneExt,
    stewardRoomCode: $src.stewardRoomCode,
    stewardNote: $src.stewardNote
  }

  *test::nobleestuary::domain::ExhibitAudience: Pure
  {
    ~src test::nobleestuary::domain::IntakeFeed
    tier: $src.accessTier,
    audienceNote: $src.audienceNote
  }
)
