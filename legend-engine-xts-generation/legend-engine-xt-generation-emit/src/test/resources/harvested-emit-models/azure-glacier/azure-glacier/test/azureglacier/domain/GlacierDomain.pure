Enum {meta::pure::profiles::doc.doc = 'Closed classification of glacier flow behaviour.'} test::azureglacier::domain::GlacierType
{
  VALLEY,
  CIRQUE,
  PIEDMONT,
  TIDEWATER
}

Class {meta::pure::profiles::doc.doc = 'A monitored glacier with an annual mass-balance reading.'} test::azureglacier::domain::Glacier
{
  name: String[1];
  glacierType: test::azureglacier::domain::GlacierType[1];
  lengthKm: Float[1];
  massBalanceMm: Integer[1];
  isRetreating() {$this.massBalanceMm < 0}: Boolean[1];
}
