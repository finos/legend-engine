import test::amberhatchery4::domain::*;

Class {meta::pure::profiles::doc.doc = 'Identifier of a propagation house, held as its own type.'} test::amberhatchery4::domain::HouseTag
{
  tag: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A propagation house, identified solely by its tag.'} test::amberhatchery4::domain::PropagationHouse
{
  houseTag: HouseTag[1];
}

Class {meta::pure::profiles::doc.doc = 'A single cutting logged inside a propagation house.'} test::amberhatchery4::domain::CuttingRecord
{
  cuttingRef: String[1];
  cultivar: String[1];
  rootstock: String[1];
  bench: String[1];
  tray: String[1];
  mediumBlend: String[1];
  mistCycle: String[1];
  grader: String[1];
  vigourNote: String[1];
}

Class {meta::pure::profiles::doc.doc = 'Composite digest restating the house tag by value together with every cutting of the house; the only declared generation scope.'} test::amberhatchery4::domain::PropagationDigest
{
  houseTag: HouseTag[1];
  cuttings: CuttingRecord[1..*];
}

Association test::amberhatchery4::domain::HouseCuttings
{
  house: PropagationHouse[1];
  loggedCuttings: CuttingRecord[1..*];
}
