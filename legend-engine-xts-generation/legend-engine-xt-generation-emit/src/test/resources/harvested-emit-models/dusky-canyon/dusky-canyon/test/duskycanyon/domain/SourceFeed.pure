import test::duskycanyon::domain::*;

Class test::duskycanyon::domain::TextWrap
{
  value: String[1];
  scheme: String[0..1];
}

Class test::duskycanyon::domain::NumberWrap
{
  value: Float[1];
  unit: String[0..1];
}

Class test::duskycanyon::domain::FeedHeader
{
  sampleRef: TextWrap[1];
}

Class test::duskycanyon::domain::FeedCore
{
  designation: TextWrap[1];
  thickness: NumberWrap[1];
  rockCode: TextWrap[1];
  bandCode: TextWrap[1];
  markers: TextWrap[*];
}

Class test::duskycanyon::domain::SampleFeed
{
  header: FeedHeader[1];
  core: FeedCore[1];
}
