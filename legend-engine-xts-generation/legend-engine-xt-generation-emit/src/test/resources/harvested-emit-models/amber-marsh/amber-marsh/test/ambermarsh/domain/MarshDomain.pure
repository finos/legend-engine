###Pure
import test::ambermarsh::domain::*;

Class {meta::pure::profiles::doc.doc = 'Base identity shared by every catalogued record of the marsh reserve.'} test::ambermarsh::domain::ReserveRecord
{
  recordCode: String[1];
  recordedOn: StrictDate[1];
  compartmentCode: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A ringed marsh bird whose plumage, age, habitat and handling codes are constrained to closed vocabularies, with a deeper habitat-prefix rule and a to-many rule over the handler roles present on the record.'} test::ambermarsh::domain::RingedBird extends ReserveRecord
[
  ringPrefixKnown: $this.recordCode->toUpper()->substring(0, 3)->in(['REE', 'SED', 'MUD', 'FEN']),
  plumageKnown: $this.plumageCode->in(['BREEDING', 'ECLIPSE', 'JUVENILE', 'MOULTING', 'WORN', 'FRESH']),
  ageClassKnown: $this.ageClassCode->in(['PULLUS', 'FIRST_YEAR', 'ADULT', 'UNKNOWN']),
  habitatKnown: $this.habitatCode->in(['REEDBED', 'SEDGE_FEN', 'MUDFLAT', 'OPEN_WATER', 'WET_GRASSLAND']),
  ringSizeKnown: $this.ringSizeCode->in(['A', 'B', 'C', 'D', 'E']),
  captureMethodKnown: $this.captureMethodCode->in(['MIST_NET', 'WALK_IN_TRAP', 'NEST_VISIT', 'HAND_CAPTURE', 'CANNON_NET']),
  conditionKnown: $this.conditionCode->in(['GOOD', 'FAIR', 'POOR']),
  handlerRolesKnown: $this.handlerRoleCodes->forAll(role | $role->in(['RINGER', 'SCRIBE', 'TRAINEE'])),
  wingSpanPlausible: ($this.wingLengthMm > 20) && (($this.wingLengthMm + $this.tailLengthMm) < 900)
]
{
  plumageCode: String[1];
  ageClassCode: String[1];
  habitatCode: String[1];
  ringSizeCode: String[1];
  captureMethodCode: String[1];
  conditionCode: String[1];
  handlerRoleCodes: String[*];
  wingLengthMm: Integer[1];
  tailLengthMm: Integer[1];
  massGrams: Float[1];
}

Class {meta::pure::profiles::doc.doc = 'A vegetation quadrat walked in a reserve compartment, carrying the cover fraction of the dominant stand.'} test::ambermarsh::domain::VegetationQuadrat extends ReserveRecord
[
  standKnown: $this.dominantStandCode->in(['PHRAGMITES', 'CAREX', 'TYPHA', 'JUNCUS']),
  coverInRange: ($this.coverFraction >= 0.0) && ($this.coverFraction <= 1.0)
]
{
  dominantStandCode: String[1];
  coverFraction: Float[1];
  waterDepthCm: Integer[1];
}

Class {meta::pure::profiles::doc.doc = 'A digest of one ringing session, emitted as an external JSON schema artifact by the generation pipeline.'} test::ambermarsh::domain::RingingSessionDigest
[
  weatherKnown: $this.weatherCode->in(['CLEAR', 'OVERCAST', 'DRIZZLE', 'FOG', 'WINDY']),
  observerCodesKnown: $this.observerCodes->forAll(code | $code->toUpper()->substring(0, 2)->in(['OB', 'TR', 'RG'])),
  effortRecorded: ($this.birdsRinged >= 0) && (($this.birdsRinged + $this.quadratsWalked) > 0)
]
{
  sessionCode: String[1];
  openedOn: StrictDate[1];
  compartmentCode: String[1];
  birdsRinged: Integer[1];
  quadratsWalked: Integer[1];
  weatherCode: String[1];
  observerCodes: String[*];
}

Class {meta::pure::profiles::doc.doc = 'A reserve compartment: the spatial unit every catalogued record is filed under.'} test::ambermarsh::domain::Compartment
[
  compartmentPrefixKnown: $this.compartmentCode->toUpper()->substring(0, 1)->in(['N', 'S', 'E', 'W']),
  areaPlausible: ($this.areaHectares > 0.0) && ($this.areaHectares < 5000.0)
]
{
  compartmentCode: String[1];
  compartmentName: String[1];
  areaHectares: Float[1];
  managedSince: StrictDate[1];
}
