###Pure
import test::opalorchard3::domain::*;
import test::opalorchard3::profile::*;

Class <<HerbariumProfile.catalogued>> {HerbariumProfile.gardenSection = 'glasshouse'} test::opalorchard3::domain::Specimen
{
  <<HerbariumProfile.livingSample>> {HerbariumProfile.curator = 'garden-archive'} specimenCode: String[1];
  scientificName: String[1];
  collectedOn: StrictDate[1];
  displayLabel: String[1];
}

Class test::opalorchard3::domain::FernSpecimen extends Specimen
{
  frondCount: Integer[1];
  habitatNote: String[0..1];
}

Class test::opalorchard3::domain::OrchidSpecimen extends Specimen
{
  petalCount: Integer[1];
  bloomColor: String[1];
}

Class test::opalorchard3::domain::HerbariumLocation
{
  locationCode: String[1];
  glasshouseName: String[1];
  shelfNumber: Integer[1];
}

Class test::opalorchard3::domain::CollectionNote
{
  noteCode: String[1];
  specimenCode: String[1];
  noteText: String[1];
}
