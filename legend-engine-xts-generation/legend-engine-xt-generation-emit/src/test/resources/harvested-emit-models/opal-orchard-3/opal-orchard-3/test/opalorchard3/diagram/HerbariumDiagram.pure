###Diagram
Diagram test::opalorchard3::diagram::HerbariumDiagram
{
  classView specimenView
  {
    class: test::opalorchard3::domain::Specimen;
    position: (420.0,120.0);
    rectangle: (300.0,180.0);
  }
  classView fernView
  {
    class: test::opalorchard3::domain::FernSpecimen;
    position: (120.0,420.0);
    rectangle: (300.0,160.0);
  }
  classView orchidView
  {
    class: test::opalorchard3::domain::OrchidSpecimen;
    position: (720.0,420.0);
    rectangle: (300.0,160.0);
  }
  generalizationView
  {
    source: fernView;
    target: specimenView;
    points: [(270.0,420.0),(520.0,300.0)];
  }
  generalizationView
  {
    source: orchidView;
    target: specimenView;
    points: [(870.0,420.0),(620.0,300.0)];
  }
}
