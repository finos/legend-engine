###Mapping
Mapping test::sablecanyon4::mapping::CanyonMapping
(
  *test::sablecanyon4::domain::TrailSegment[trailSegment]: Relational
  {
    ~primaryKey
    (
      [test::sablecanyon4::store::CanyonDB]canyon.trail_segment.segment_id
    )
    ~mainTable [test::sablecanyon4::store::CanyonDB]canyon.trail_segment
    segmentCode: [test::sablecanyon4::store::CanyonDB]canyon.trail_segment.segment_code,
    trailName: [test::sablecanyon4::store::CanyonDB]canyon.trail_segment.trail_name,
    surface: EnumerationMapping SurfaceGradeMapping: [test::sablecanyon4::store::CanyonDB]canyon.trail_segment.surface,
    washoutIndex: [test::sablecanyon4::store::CanyonDB]canyon.trail_segment.washout_index,
    surfaceNote: [test::sablecanyon4::store::CanyonDB]canyon.trail_segment.surface_note,
    patrolCount: [test::sablecanyon4::store::CanyonDB]canyon.trail_segment.patrol_count
  }

  test::sablecanyon4::domain::SurfaceGrade: EnumerationMapping SurfaceGradeMapping
  {
    SLICKROCK: ['SLICKROCK'],
    GRAVEL: ['GRAVEL'],
    SAND: ['SAND'],
    TALUS: ['TALUS']
  }
)
