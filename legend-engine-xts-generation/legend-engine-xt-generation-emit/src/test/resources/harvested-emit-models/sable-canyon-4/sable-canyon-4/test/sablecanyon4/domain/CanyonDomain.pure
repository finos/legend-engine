###Pure
import test::sablecanyon4::domain::*;

Profile test::sablecanyon4::domain::CanyonProfile
{
  stereotypes: [surveyed, provisional];
  tags: [steward, cadence];
}

Enum {meta::pure::profiles::doc.doc = 'Closed set of walking surfaces a canyon trail segment can be built on.'} test::sablecanyon4::domain::SurfaceGrade
{
  SLICKROCK,
  GRAVEL,
  SAND,
  TALUS
}

Class <<CanyonProfile.surveyed>> {CanyonProfile.steward = 'canyon-trail-crew', CanyonProfile.cadence = 'weekly'} test::sablecanyon4::domain::TrailSegment
{
  segmentCode: String[1];
  trailName: String[1];
  surface: SurfaceGrade[1];
  washoutIndex: Integer[0..1];
  surfaceNote: String[0..1];
  patrolCount: Integer[1];
}

Class <<CanyonProfile.provisional>> {CanyonProfile.steward = 'canyon-publication'} test::sablecanyon4::domain::SegmentDigest
{
  segmentCode: String[1];
  trailName: String[1];
  surface: SurfaceGrade[1];
  conditionBand: String[0..1];
  patrolCount: Integer[1];
}
