###Service
Service test::sablecanyon4::service::SegmentConditionService
{
  pattern: '/canyon/v1/segment-condition/{tier}';
  title: 'Canyon - Segment Condition Board by Tier';
  owners:
  [
    'canyon-trail-crew',
    'canyon-publication'
  ];
  documentation: 'Multi-execution board keyed by publication tier that bands every surveyed canyon trail segment by its washout reading, falling back to no band when the reading is absent.';
  autoActivateUpdates: true;
  execution: Multi
  {
    query: |test::sablecanyon4::domain::TrailSegment.all()->filter(
      s|$s.segmentCode->startsWith('SC')
    )->project(
      [
        s|$s.segmentCode,
        s|$s.trailName->toUpper(),
        s| if(
          $s.washoutIndex->isEmpty(),
          |[]->cast(@String),
          | if(
            $s.washoutIndex->toOne() >= 80,
            |'impassable',
            | if(
              ($s.washoutIndex->toOne() >= 55) && $s.surfaceNote->isNotEmpty(),
              |'restricted-' + $s.surfaceNote->toOne()->toLower()->substring(0, 4),
              | if(
                $s.washoutIndex->toOne() >= 30,
                |'caution',
                |'clear'
              )
            )
          )
        ),
        s|$s.patrolCount + 1
      ],
      [
        'SegmentCode',
        'TrailName',
        'ConditionBand',
        'PatrolTarget'
      ]
    )->sort(
      [
        asc('SegmentCode')
      ]
    );
    key: 'tier';
    executions['field']:
    {
      mapping: test::sablecanyon4::mapping::CanyonMapping;
      runtime: test::sablecanyon4::runtime::FieldRuntime;
    }
    executions['archive']:
    {
      mapping: test::sablecanyon4::mapping::CanyonMapping;
      runtime: test::sablecanyon4::runtime::ArchiveRuntime;
    }
  }
  testSuites:
  [
    segmentConditionSuite:
    {
      data:
      [
        connections:
        [
          fieldH2:
            Relational
            #{
              canyon.trail_segment:
                'segment_id,segment_code,trail_name,surface,washout_index,surface_note,patrol_count\n'+
                '1,SC-101,Sable Rim Traverse,SLICKROCK,90,SLAB DEBRIS,4\n'+
                '2,SC-102,Ribbon Wash Loop,GRAVEL,60,RUTTED CLAY,2\n'+
                '3,SC-103,Dry Fork Bench,SAND,,,5\n'+
                '4,XX-900,Closed Spur,TALUS,45,LOOSE SCREE,1\n';
            }#,
          archiveH2:
            Relational
            #{
              canyon.trail_segment:
                'segment_id,segment_code,trail_name,surface,washout_index,surface_note,patrol_count\n'+
                '1,SC-201,Cottonwood Narrows,TALUS,84,BOULDER FALL,3\n'+
                '2,SC-202,Juniper Bench Cutoff,GRAVEL,57,SILTED OVER,6\n'+
                '3,SC-203,Upper Pothole Route,SLICKROCK,,,2\n';
            }#
        ]
      ]
      tests:
      [
        fieldTier:
        {
          serializationFormat: PURE_TDSOBJECT;
          keys: ['field'];
          asserts:
          [
            fieldBands:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"SegmentCode":"SC-101","TrailName":"SABLE RIM TRAVERSE","ConditionBand":"impassable","PatrolTarget":5},{"SegmentCode":"SC-102","TrailName":"RIBBON WASH LOOP","ConditionBand":"restricted-rutt","PatrolTarget":3},{"SegmentCode":"SC-103","TrailName":"DRY FORK BENCH","ConditionBand":null,"PatrolTarget":6}]';
                  }#;
              }#
          ]
        },
        archiveTier:
        {
          serializationFormat: PURE_TDSOBJECT;
          keys: ['archive'];
          asserts:
          [
            archiveBands:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"SegmentCode":"SC-201","TrailName":"COTTONWOOD NARROWS","ConditionBand":"impassable","PatrolTarget":4},{"SegmentCode":"SC-202","TrailName":"JUNIPER BENCH CUTOFF","ConditionBand":"restricted-silt","PatrolTarget":7},{"SegmentCode":"SC-203","TrailName":"UPPER POTHOLE ROUTE","ConditionBand":null,"PatrolTarget":3}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
