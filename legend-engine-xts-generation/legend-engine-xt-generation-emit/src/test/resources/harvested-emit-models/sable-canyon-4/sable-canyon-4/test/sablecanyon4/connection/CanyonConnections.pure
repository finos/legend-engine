###Connection
RelationalDatabaseConnection test::sablecanyon4::connection::FieldConnection
{
  store: test::sablecanyon4::store::CanyonDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists canyon;',
      'create schema canyon;',
      'create table canyon.trail_segment (segment_id integer primary key, segment_code varchar(20) not null, trail_name varchar(120) not null, surface varchar(20) not null, washout_index integer, surface_note varchar(60), patrol_count integer not null);'
      ];
  };
  auth: DefaultH2;
}

