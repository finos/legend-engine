###Pure
import test::umberglacier4::domain::*;

Class {meta::pure::profiles::doc.doc = 'A single ablation stake read on a survey round. Shares its five identifying columns with the probe detail record but carries its own emergence, threshold and marker vocabulary.'} test::umberglacier4::domain::StakeReadingDetail
{
  detailId: String[1];
  markerLabelText: String[1];
  elevationBandText: String[1];
  observerInitialsText: String[1];
  qualityFlagText: String[1];
  heightChangeCentimetresText: String[1];
  alertThresholdCentimetresText: String[1];
  stakeTagCodes: String[1..*];
}

Class {meta::pure::profiles::doc.doc = 'A single ice-thickness probe read on a survey round. Shares its five identifying columns with the stake detail record but carries its own depth, offset and sensor vocabulary.'} test::umberglacier4::domain::ProbeReadingDetail
{
  detailId: String[1];
  markerLabelText: String[1];
  elevationBandText: String[1];
  observerInitialsText: String[1];
  qualityFlagText: String[1];
  probeDepthMetresText: String[1];
  temperatureOffsetCelsiusText: String[1];
  sensorSerialCodes: String[1..*];
}
