###Pure
import test::umberglacier4::domain::*;

Class {meta::pure::profiles::doc.doc = 'One walked survey round, nesting both the stake readings and the probe readings collected on that round. Ablation share is carried as text rather than a number so the published contract stays string-only.'} test::umberglacier4::domain::SurveyRoundPayload
{
  payloadId: String[1];
  routeLabel: String[1];
  ablationSharePercentText: String[1];
  stakeReadings: StakeReadingDetail[1..*];
  probeReadings: ProbeReadingDetail[1..*];
}

Class {meta::pure::profiles::doc.doc = 'One meltwater gauge run at the snout, held flat with no nested detail records.'} test::umberglacier4::domain::MeltwaterRunPayload
{
  payloadId: String[1];
  gaugeCode: String[1];
  dischargeLitresPerSecondText: String[1];
  turbidityIndexText: String[1];
}

Class {meta::pure::profiles::doc.doc = 'One crevasse scan sweep over the icefall, held flat with no nested detail records.'} test::umberglacier4::domain::CrevasseSweepPayload
{
  payloadId: String[1];
  sweepLineCode: String[1];
  maxWidthMetresText: String[1];
  bridgeConfidenceText: String[1];
}
