Enum {meta::pure::profiles::doc.doc = 'Dominant soil texture recorded for an orchard block.'} test::quietorchard::domain::SoilTexture
{
  LOAM,
  CLAY,
  SAND,
  SILT,
  UNCLASSIFIED
}

Enum {meta::pure::profiles::doc.doc = 'Watering method used across an orchard block.'} test::quietorchard::domain::IrrigationMethod
{
  DRIP,
  SPRINKLER,
  FURROW,
  RAINFED
}

Enum {meta::pure::profiles::doc.doc = 'Compass facing of the slope an orchard block sits on.'} test::quietorchard::domain::SlopeAspect
{
  NORTH,
  SOUTH,
  EAST,
  WEST,
  LEVEL
}

Class {meta::pure::profiles::doc.doc = 'Inbound block survey record describing one planted block of an orchard.'} test::quietorchard::domain::BlockSurveyFeed
{
  blockCode: String[1];
  rowCount: Integer[0..1];
  canopyPct: Integer[0..1];
  soilCode: String[0..1];
  irrigationCode: String[0..1];
  aspectCode: String[0..1];
  bloomNote: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'Curated block profile with a canopy vigour band and classified site attributes.'} test::quietorchard::domain::OrchardBlockProfile
{
  blockCode: String[1];
  label: String[1];
  vigourBand: String[0..1];
  earlyBloom: Boolean[1];
  soil: test::quietorchard::domain::SoilTexture[1];
  irrigation: test::quietorchard::domain::IrrigationMethod[1];
  aspect: test::quietorchard::domain::SlopeAspect[1];
}
