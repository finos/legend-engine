###Mapping
Mapping test::quietorchard::mapping::OrchardMapping
(
  *test::quietorchard::domain::Orchard[orchard]: Pure
  {
    ~src test::quietorchard::domain::OrchardFeed
    id: $src.orchardId,
    name: $src.orchardName,
    region: $src.region,
    cultivars: $src.trees.cultivar
  }

  testSuites:
  [
    orchardTransformSuite:
    {
      function: |test::quietorchard::domain::Orchard.all()->graphFetch(
        #{
          test::quietorchard::domain::Orchard{
            id,
            name,
            region,
            cultivars
          }
        }#
      )->serialize(
        #{
          test::quietorchard::domain::Orchard{
            id,
            name,
            region,
            cultivars
          }
        }#
      );
      tests:
      [
        populatedOrchard:
        {
          data:
          [
            ModelStore:
              ModelStore
              #{
                test::quietorchard::domain::OrchardFeed:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"orchardId":4,"orchardName":"Hillside Rows","region":"North Ridge","trees":[{"cultivar":"Braeburn","ageYears":6},{"cultivar":"Gala","ageYears":9}]}';
                  }#
              }#
          ];
          asserts:
          [
            transformed:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"id":4,"name":"Hillside Rows","region":"North Ridge","cultivars":["Braeburn","Gala"]}';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
