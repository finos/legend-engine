{
  orchardId: Integer[1];
  orchardName: String[1];
  region: String[1];
  trees: test::quietorchard::domain::TreeFeed[*];
}

Class {meta::pure::profiles::doc.doc = 'A single tree entry inside the inbound orchard feed record.'} test::quietorchard::domain::TreeFeed
{
  cultivar: String[1];
  ageYears: Integer[1];
}

Class {meta::pure::profiles::doc.doc = 'Curated orchard with the flattened collection of cultivar names planted within it.'} test::quietorchard::domain::Orchard
{
  id: Integer[1];
  name: String[1];
  region: String[1];
  cultivars: String[*];
}
