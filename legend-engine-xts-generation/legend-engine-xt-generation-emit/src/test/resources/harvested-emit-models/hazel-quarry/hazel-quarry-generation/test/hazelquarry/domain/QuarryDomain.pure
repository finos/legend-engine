import test::hazelquarry::domain::*;

Profile test::hazelquarry::domain::QuarryProfile
{
  stereotypes: [surveyed, provisional];
  tags: [steward, cadence];
}

Enum {meta::pure::profiles::doc.doc = 'Broad rock family recorded for an extracted block.'} test::hazelquarry::domain::RockFamily
{
  Granite,
  Limestone,
  Slate,
  Basalt
}

Class <<QuarryProfile.surveyed>> {QuarryProfile.steward = 'quarry-survey-desk', meta::pure::profiles::doc.doc = 'A working face of a stone quarry from which blocks are extracted.'} test::hazelquarry::domain::ExtractionSite
{
  siteCode: String[1];
  name: String[1];
  benchHeightMeters: Integer[1];
  activeSince: StrictDate[1];
}

Class <<QuarryProfile.surveyed>> {QuarryProfile.cadence = 'per-extraction', meta::pure::profiles::doc.doc = 'A single quarried stone block with its measured mass and rock family.'} test::hazelquarry::domain::StoneBlock
{
  blockRef: String[1];
  family: RockFamily[1];
  massKilograms: Integer[1];
  site: ExtractionSite[1];
}

Class <<QuarryProfile.provisional>> {QuarryProfile.cadence = 'weekly', meta::pure::profiles::doc.doc = 'A provisional geological reading captured at an extraction site.'} test::hazelquarry::domain::SurveyReading
{
  readingRef: String[1];
  moisturePercent: Integer[1];
  inspector: String[1];
  takenOn: StrictDate[1];
  site: ExtractionSite[1];
}
