Enum {meta::pure::profiles::doc.doc = 'Stage of the tide at the moment a rock-pool observation was taken.'} test::gildedcove2::domain::TideStage
{
  Low,
  Rising,
  High,
  Falling
}

Enum {meta::pure::profiles::doc.doc = 'How a survey team collected the observations of a cove visit.'} test::gildedcove2::domain::SurveyMethod
{
  {meta::json::schema::JSONSchemaGeneration.name = 'quadrat'} Quadrat,
  {meta::json::schema::JSONSchemaGeneration.name = 'transect'} Transect,
  {meta::json::schema::JSONSchemaGeneration.name = 'photoGrid'} PhotoGrid
}

Class {meta::pure::profiles::doc.doc = 'A monitored cove where rock-pool surveys are carried out.'} test::gildedcove2::domain::CoveSite
{
  siteCode: String[1];
  siteName: String[1];
  shoreline: String[1];
  protectedArea: Boolean[1];
}

Class {meta::pure::profiles::doc.doc = 'A single rock-pool observation recorded during a cove visit.'} test::gildedcove2::domain::PoolReading
[
  nonNegativeSalinity: $this.salinityPpt >= 0.0,
  quadratSized: $this.quadratCm2 > 0
]
{
  readingRef: String[1];
  site: test::gildedcove2::domain::CoveSite[1];
  observedOn: StrictDate[1];
  tideStage: test::gildedcove2::domain::TideStage[1];
  method: test::gildedcove2::domain::SurveyMethod[1];
  salinityPpt: Float[1];
  <<meta::json::schema::JSONSchemaTypeExtension.int32>> quadratCm2: Integer[1];
  <<meta::json::schema::JSONSchemaTypeExtension.int64>> {meta::pure::profiles::doc.doc = 'Individuals counted in the quadrat; the emitted schema widens the count so downstream consumers may aggregate whole shorelines.'} individualsCounted: Integer[1];
}

Class {meta::pure::profiles::doc.doc = 'A species observed in a cove, with the survey-wide tally of sightings.'} test::gildedcove2::domain::SpeciesRecord
{
  speciesCode: String[1];
  commonName: String[1];
  habitatZone: String[1];
  <<meta::json::schema::JSONSchemaTypeExtension.int64>> {meta::pure::profiles::doc.doc = 'Sightings across every surveyed cove; widened in the emitted schema because the model integer is narrower than the published contract.'} sightingTally: Integer[1];
  <<meta::json::schema::JSONSchemaTypeExtension.int32>> distinctSites: Integer[1];
}

Class {meta::pure::profiles::doc.doc = 'Continuation bookkeeping shared by every paged survey response.'} test::gildedcove2::domain::PageMarker
[
  positivePageSize: $this.pageSize > 0
]
{
  continuationMarker: String[0..1];
  pageSize: Integer[1];
  lastPage: Boolean[1];
}

Class {meta::pure::profiles::doc.doc = 'One page of rock-pool observations: an unbounded collection of readings plus optional continuation bookkeeping.'} test::gildedcove2::domain::PoolReadingPage
{
  readings: test::gildedcove2::domain::PoolReading[*];
  marker: test::gildedcove2::domain::PageMarker[0..1];
  generatedAt: DateTime[1];
}

Class {meta::pure::profiles::doc.doc = 'One page of species records: an unbounded collection of records plus optional continuation bookkeeping.'} test::gildedcove2::domain::SpeciesRecordPage
{
  records: test::gildedcove2::domain::SpeciesRecord[*];
  marker: test::gildedcove2::domain::PageMarker[0..1];
  surveyMethod: test::gildedcove2::domain::SurveyMethod[1];
}
