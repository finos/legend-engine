import test::quietsummit3::domain::*;

Enum test::quietsummit3::domain::ReadingQuality
{
  VALID,
  SUSPECT
}

Class test::quietsummit3::domain::StationRegistry
{
  networkName: String[1];
  stations: StationRecord[1..*];
}

Class test::quietsummit3::domain::StationRecord
{
  stationCode: String[1];
  reading: StationReading[1];
}

Class test::quietsummit3::domain::StationReading
{
  observedOn: StrictDate[1];
  temperatureC: Float[1];
  humidityPct: Float[1];
  windSpeedKmh: Float[1];
  pressureHpa: Integer[1];
  sampleCount: Integer[1];
  sensorLabel: String[1];
  quality: ReadingQuality[1];
  operator: Operator[1];
  remark: String[0..1];
}

Class test::quietsummit3::domain::Operator
{
  operatorName: String[1];
  badgeId: String[1];
}
