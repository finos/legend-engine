###Diagram
Diagram test::quietsummit3::diagram::WeatherDiagram
{
  classView stationRegistryView
  {
    class: test::quietsummit3::domain::StationRegistry;
    position: (120.0,60.0);
    rectangle: (200.0,60.0);
  }
  classView stationRecordView
  {
    class: test::quietsummit3::domain::StationRecord;
    position: (120.0,240.0);
    rectangle: (200.0,60.0);
  }
  classView stationReadingView
  {
    class: test::quietsummit3::domain::StationReading;
    position: (120.0,420.0);
    rectangle: (240.0,200.0);
  }
  propertyView
  {
    property: test::quietsummit3::domain::StationRegistry.stations;
    source: stationRegistryView;
    target: stationRecordView;
    points: [(220.0,120.0),(220.0,240.0)];
  }
  propertyView
  {
    property: test::quietsummit3::domain::StationRecord.reading;
    source: stationRecordView;
    target: stationReadingView;
    points: [(220.0,300.0),(240.0,420.0)];
  }
}
