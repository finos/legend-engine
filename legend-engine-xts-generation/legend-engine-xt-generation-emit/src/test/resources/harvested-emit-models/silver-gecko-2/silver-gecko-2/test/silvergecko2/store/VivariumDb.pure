###Relational
Database test::silvergecko2::store::VivariumDb
(
  Schema vivarium
  (
    Table habitat_zone
    (
      zone_id INTEGER PRIMARY KEY,
      zone_code VARCHAR(20) NOT NULL,
      zone_name VARCHAR(60) NOT NULL
    )

    Table zone_note
    (
      note_id INTEGER PRIMARY KEY,
      zone_id INTEGER NOT NULL,
      note_code VARCHAR(20) NOT NULL,
      note_text VARCHAR(200) NOT NULL
    )

    Table enclosure
    (
      enclosure_id INTEGER PRIMARY KEY,
      zone_id INTEGER NOT NULL,
      enclosure_code VARCHAR(20) NOT NULL,
      enclosure_name VARCHAR(60) NOT NULL,
      humidity_pct INTEGER NOT NULL
    )

    Table substrate
    (
      substrate_id INTEGER PRIMARY KEY,
      enclosure_id INTEGER NOT NULL,
      substrate_code VARCHAR(20) NOT NULL,
      substrate_name VARCHAR(60) NOT NULL
    )

    Table heat_lamp
    (
      lamp_id INTEGER PRIMARY KEY,
      enclosure_id INTEGER NOT NULL,
      lamp_code VARCHAR(20) NOT NULL,
      watts INTEGER NOT NULL
    )

    Table species
    (
      species_id INTEGER PRIMARY KEY,
      species_code VARCHAR(20) NOT NULL,
      species_name VARCHAR(60) NOT NULL,
      diet_code VARCHAR(10) NOT NULL
    )

    Table shift_team
    (
      team_id INTEGER PRIMARY KEY,
      team_code VARCHAR(20) NOT NULL,
      team_name VARCHAR(60) NOT NULL
    )

    Table keeper
    (
      keeper_id INTEGER PRIMARY KEY,
      team_id INTEGER NOT NULL,
      keeper_code VARCHAR(20) NOT NULL,
      keeper_name VARCHAR(60) NOT NULL
    )

    Table resident
    (
      resident_id INTEGER PRIMARY KEY,
      enclosure_id INTEGER NOT NULL,
      species_id INTEGER NOT NULL,
      resident_code VARCHAR(20) NOT NULL,
      resident_name VARCHAR(60) NOT NULL,
      hatched_on DATE NOT NULL,
      length_mm INTEGER NOT NULL
    )

    Table feed_log
    (
      log_id INTEGER PRIMARY KEY,
      resident_id INTEGER NOT NULL,
      keeper_id INTEGER NOT NULL,
      log_code VARCHAR(20) NOT NULL,
      feed_code VARCHAR(20) NOT NULL,
      feed_grams INTEGER NOT NULL,
      fed_on DATE NOT NULL
    )

    Table health_check
    (
      check_id INTEGER PRIMARY KEY,
      resident_id INTEGER NOT NULL,
      keeper_id INTEGER NOT NULL,
      check_code VARCHAR(20) NOT NULL,
      outcome_code VARCHAR(20) NOT NULL,
      checked_on DATE NOT NULL
    )

    Table moult_record
    (
      moult_id INTEGER PRIMARY KEY,
      resident_id INTEGER NOT NULL,
      moult_code VARCHAR(20) NOT NULL,
      stage_code VARCHAR(20) NOT NULL,
      recorded_on DATE NOT NULL
    )

    Table weight_reading
    (
      reading_id INTEGER PRIMARY KEY,
      resident_id INTEGER NOT NULL,
      reading_code VARCHAR(20) NOT NULL,
      grams INTEGER NOT NULL,
      read_on DATE NOT NULL
    )

    Table feed_stock
    (
      stock_id INTEGER PRIMARY KEY,
      feed_code VARCHAR(20) NOT NULL,
      stock_name VARCHAR(60) NOT NULL,
      supplier_code VARCHAR(20) NOT NULL
    )

    Table supplier
    (
      supplier_id INTEGER PRIMARY KEY,
      supplier_code VARCHAR(20) NOT NULL,
      supplier_name VARCHAR(60) NOT NULL
    )
  )

  Join Note_Zone(vivarium.zone_note.zone_id = vivarium.habitat_zone.zone_id)
  Join Enclosure_Zone(vivarium.enclosure.zone_id = vivarium.habitat_zone.zone_id)
  Join Substrate_Enclosure(vivarium.substrate.enclosure_id = vivarium.enclosure.enclosure_id)
  Join Lamp_Enclosure(vivarium.heat_lamp.enclosure_id = vivarium.enclosure.enclosure_id)
  Join Keeper_Team(vivarium.keeper.team_id = vivarium.shift_team.team_id)
  Join Resident_Enclosure(vivarium.resident.enclosure_id = vivarium.enclosure.enclosure_id)
  Join Resident_Species(vivarium.resident.species_id = vivarium.species.species_id)
  Join Feed_Resident(vivarium.feed_log.resident_id = vivarium.resident.resident_id)
  Join Feed_Keeper(vivarium.feed_log.keeper_id = vivarium.keeper.keeper_id)
  Join Check_Resident(vivarium.health_check.resident_id = vivarium.resident.resident_id)
  Join Check_Keeper(vivarium.health_check.keeper_id = vivarium.keeper.keeper_id)
  Join Moult_Resident(vivarium.moult_record.resident_id = vivarium.resident.resident_id)
  Join Weight_Resident(vivarium.weight_reading.resident_id = vivarium.resident.resident_id)
  Join Stock_Supplier(vivarium.feed_stock.supplier_code = vivarium.supplier.supplier_code)
)
