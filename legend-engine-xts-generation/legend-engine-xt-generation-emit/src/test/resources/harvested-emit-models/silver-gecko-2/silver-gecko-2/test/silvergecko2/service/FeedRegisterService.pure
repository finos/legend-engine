###Service
Service test::silvergecko2::service::FeedRegisterService
{
  pattern: '/silvergecko2/v1/feed-register';
  title: 'Silver Gecko 2 - Feed Register';
  ownership: UserList { users: ['vivarium-keeper-desk'] };
  documentation: 'Feed entries written against one named feed code, published with the inherited record properties of the shared register supertype and the keeper and resident reached through the declared equality joins, including an entry whose keeper row is absent.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: {feedCode: String[1]|test::silvergecko2::domain::FeedLog.all()->filter(
      f|$f.feedCode == $feedCode
    )->project(
      [
        f|$f.recordCode,
        f|$f.recordKind,
        f|$f.residentName,
        f|$f.keeperName,
        f|$f.feedGrams
      ],
      [
        'RecordCode',
        'RecordKind',
        'ResidentName',
        'KeeperName',
        'FeedGrams'
      ]
    )->sort([asc('RecordCode')])};
    mapping: test::silvergecko2::mapping::VivariumRegisterMapping;
    runtime: test::silvergecko2::runtime::VivariumStationRuntime;
  }
  testSuites:
  [
    feedRegisterSuite:
    {
      data:
      [
        connections:
        [
          vivariumStation:
            Reference
            #{
              test::silvergecko2::data::VivariumTestData
            }#
        ]
      ]
      tests:
      [
        theInsectFeedCodeHasTwoJoinedEntries:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            feedCode = 'CR-1'
          ]
          asserts:
          [
            bothInsectFeedEntriesAreRegistered:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"RecordCode":"FL-1","RecordKind":"FEED LOG","ResidentName":"Pebble","KeeperName":"Example Keeper Alpha","FeedGrams":12},{"RecordCode":"FL-3","RecordKind":"FEED LOG","ResidentName":"Willow","KeeperName":"Example Keeper Alpha","FeedGrams":7}]';
                  }#;
              }#
          ]
        },
        theGreensFeedCodeIncludesAnEntryWhoseKeeperRowIsAbsent:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            feedCode = 'CR-2'
          ]
          asserts:
          [
            theEntryWithNoKeeperCounterpartPublishesNoKeeperName:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"RecordCode":"FL-2","RecordKind":"FEED LOG","ResidentName":"Ochre","KeeperName":"Example Keeper Beta","FeedGrams":20},{"RecordCode":"FL-4","RecordKind":"FEED LOG","ResidentName":"Pebble","KeeperName":null,"FeedGrams":9}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
