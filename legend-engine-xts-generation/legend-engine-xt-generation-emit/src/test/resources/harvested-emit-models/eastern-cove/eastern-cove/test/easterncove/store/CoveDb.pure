###Relational
Database test::easterncove::store::CoveDb
(
  Schema harbour
  (
    Table berth
    (
      berth_code VARCHAR(8) PRIMARY KEY,
      berth_name VARCHAR(60),
      quay_name VARCHAR(60),
      max_length_m INTEGER
    )
    Table mooring
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z),
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )

      mooring_code VARCHAR(12) PRIMARY KEY,
      berth_code VARCHAR(8),
      vessel_name VARCHAR(60),
      tariff_band VARCHAR(8),
      crew_count INTEGER,
      from_z DATE,
      thru_z DATE,
      in_z DATE,
      out_z DATE
    )
    Table sailing
    (
      sailing_code VARCHAR(12) PRIMARY KEY,
      berth_code VARCHAR(8),
      route_name VARCHAR(60),
      passengers INTEGER,
      sailed_on DATE
    )
  )

  Join Sailing_Berth(harbour.sailing.berth_code = harbour.berth.berth_code)
)
