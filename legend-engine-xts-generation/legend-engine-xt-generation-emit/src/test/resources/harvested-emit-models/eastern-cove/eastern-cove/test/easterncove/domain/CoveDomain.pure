import test::easterncove::domain::*;

Class {meta::pure::profiles::doc.doc = 'A quay berth where coastal ferries tie up.'} test::easterncove::domain::Berth
{
  berthCode: String[1];
  berthName: String[1];
  quayName: String[1];
  maxLengthM: Integer[1];
  busySailings(minPassengers: Integer[1])
  {
    $this.sailings->filter(s|$s.passengers >= $minPassengers)
  }: Sailing[*];
  quayLabel()
  {
    $this.quayName + ' / ' + $this.berthName
  }: String[1];
}

Class <<temporal.bitemporal>> {meta::pure::profiles::doc.doc = 'A mooring allocation, corrected over processing time and effective over business time.'} test::easterncove::domain::Mooring
{
  mooringCode: String[1];
  vesselName: String[1];
  tariffBand: String[1];
  crewCount: Integer[1];
}

Class {meta::pure::profiles::doc.doc = 'A scheduled coastal sailing departing from a berth.'} test::easterncove::domain::Sailing
{
  sailingCode: String[1];
  routeName: String[1];
  passengers: Integer[1];
  sailedOn: StrictDate[1];
}

Class {meta::pure::profiles::doc.doc = 'A vessel record catalogued from an inbound harbour document.'} test::easterncove::domain::CatalogueVessel
{
  hullCode: String[1];
  vesselName: String[1];
  operatorName: String[0..1];
  berthCode: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'An inbound harbour document describing one arriving vessel.'} test::easterncove::source::InboundVesselDocument
{
  hull: String[1];
  label: String[1];
  berth: String[0..1];
  operator: test::easterncove::source::OperatorBlock[0..1];
}

Class test::easterncove::source::OperatorBlock
{
  operatorName: String[1];
  contactName: String[0..1];
}

Association {meta::pure::profiles::doc.doc = 'Relates a berth to the sailings that depart from it.'} test::easterncove::domain::BerthSailings
{
  berth: Berth[1];
  sailings: Sailing[*];
}

Association {meta::pure::profiles::doc.doc = 'Relates a catalogued vessel to the berth it is assigned to, across two stores.'} test::easterncove::domain::VesselBerth
{
  vessel: CatalogueVessel[0..1];
  assignedBerth: Berth[0..1];
}
