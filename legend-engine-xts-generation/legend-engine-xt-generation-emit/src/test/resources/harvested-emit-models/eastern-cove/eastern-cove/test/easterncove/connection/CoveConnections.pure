###Connection
RelationalDatabaseConnection test::easterncove::connection::CoveConnection
{
  store: test::easterncove::store::CoveDb;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'EXAMPLE_COVE_DB';
    account: 'example_cove_account';
    warehouse: 'EXAMPLE_COVE_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    role: 'EXAMPLE_COVE_ROLE';
  };
  auth: OAuth
  {
    oauthKey: 'COVE_OAUTH';
    scopeName: 'SESSION:ROLE:COVE_READER';
  };
  postProcessors:
  [
    mapper
    {
      mappers:
      [
        table {from: 'sailing'; to: 'sailing_current'; schemaFrom: 'harbour'; schemaTo: 'harbour';}
      ];
    }
  ];
}

RelationalDatabaseConnection test::easterncove::connection::CoveTideConnection
{
  store: test::easterncove::store::CoveDb;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'EXAMPLE_COVE_TIDE_DB';
    account: 'example_cove_account';
    warehouse: 'EXAMPLE_COVE_TIDE_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    role: 'EXAMPLE_COVE_TIDE_ROLE';
  };
  auth: OAuth
  {
    oauthKey: 'COVE_TIDE_OAUTH';
    scopeName: 'SESSION:ROLE:COVE_TIDE_READER';
  };
}

JsonModelConnection test::easterncove::connection::InboundVesselConnection
{
  class: test::easterncove::source::InboundVesselDocument;
  url: 'data:application/json,%7B%7D';
}
