###Pure
import test::ivoryprairie4::domain::*;

Profile test::ivoryprairie4::domain::SurveyProfile
{
  stereotypes: [curated, provisional];
  tags: [steward, reviewCadence];
}

Class <<SurveyProfile.curated>> {SurveyProfile.steward = 'wetland-survey-desk'} test::ivoryprairie4::domain::SurveyObservation
{
  observationCode: String[1];
  observedOn: StrictDate[1];
  transectLabel: String[1];
  observerName: String[1];
  habitatNote: String[0..1];
}

Class <<SurveyProfile.provisional>> {SurveyProfile.reviewCadence = 'seasonal'} test::ivoryprairie4::domain::WaderCountObservation extends SurveyObservation
{
  speciesName: String[1];
  individualCount: Integer[1];
  waterDepthCm: Float[1];
  nestingConfirmed: Boolean[1];
  ringedIndividuals: Integer[0..1];
  weather: WeatherSnapshot[1];
}

Class <<SurveyProfile.curated>> test::ivoryprairie4::domain::WeatherSnapshot
{
  airTemperatureC: Float[1];
  windSpeedKmh: Float[1];
  visibilityMetres: Integer[1];
  precipitationNote: String[0..1];
}
