###Pure
import test::borealprairie2::domain::*;

Class test::borealprairie2::domain::StorageBin
{
  binCode: String[1];
  binName: String[1];
  capacityTonnes: Float[1];
  aerated: Boolean[1];
}

Class test::borealprairie2::domain::MoistureSample
{
  sampleCode: String[1];
  drawnOn: StrictDate[1];
  moisturePercent: Float[1];
  screeningsPercent: Float[0..1];
}

Class test::borealprairie2::domain::HandlingMovement
{
  movementCode: String[1];
  recordedOn: StrictDate[1];
  netTonnes: Float[1];
  cropName: String[1];
  operatorInitials: String[0..1];
}

Class test::borealprairie2::domain::IntakeMovement extends HandlingMovement
{
  intoBin: StorageBin[1];
  haulerName: String[1];
  gradeAssigned: String[1];
  intakeSample: MoistureSample[0..1];
}

Class test::borealprairie2::domain::OutloadMovement extends HandlingMovement
{
  fromBin: StorageBin[1];
  railcarCount: Integer[1];
  destinationTerminal: String[1];
}

Class test::borealprairie2::domain::TransferMovement extends HandlingMovement
{
  sourceBin: StorageBin[1];
  targetBin: StorageBin[1];
  blendedWith: String[0..1];
}

Class test::borealprairie2::domain::AeratedTransferMovement extends TransferMovement
{
  fanRunHours: Float[1];
  targetMoisturePercent: Float[1];
}
