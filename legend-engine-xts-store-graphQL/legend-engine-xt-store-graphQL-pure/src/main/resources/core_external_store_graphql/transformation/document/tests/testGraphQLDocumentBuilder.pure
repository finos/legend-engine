import meta::external::store::graphQL::transformation::document::*;
import meta::external::query::graphQL::metamodel::sdl::executable::*;
import meta::external::query::graphQL::metamodel::sdl::value::*;
import meta::external::query::graphQL::metamodel::sdl::typeSystem::*;

function <<test.Test>> meta::external::store::graphQL::transformation::document::tests::testRenderSimpleQuery(): Boolean[1]
{
  let arguments = [^Argument(name = 'department', value = ^StringValue(value = 'Sales'))];
  let field = ^Field(name = 'employees', arguments = $arguments, selectionSet = [^Field(name = 'firstName'), ^Field(name = 'lastName')]);
  let document = buildQueryDocument([$field], []);

  assertEquals(
    'query {\n' +
    '  employees(department: "Sales") {\n' +
    '    firstName\n' +
    '    lastName\n' +
    '  }\n' +
    '}',
    renderQueryDocument($document)
  );
}

function <<test.Test>> meta::external::store::graphQL::transformation::document::tests::testRenderNestedSelection(): Boolean[1]
{
  let managerSelection = [^Field(name = 'firstName')];
  let selectionSet = [^Field(name = 'firstName'), ^Field(name = 'lastName'), ^Field(name = 'manager', selectionSet = $managerSelection)];
  let field = ^Field(name = 'employees', arguments = [^Argument(name = 'department', value = ^StringValue(value = 'Sales'))], selectionSet = $selectionSet);
  let document = buildQueryDocument([$field], []);

  assertEquals(
    'query {\n' +
    '  employees(department: "Sales") {\n' +
    '    firstName\n' +
    '    lastName\n' +
    '    manager {\n' +
    '      firstName\n' +
    '    }\n' +
    '  }\n' +
    '}',
    renderQueryDocument($document)
  );
}

function <<test.Test>> meta::external::store::graphQL::transformation::document::tests::testRenderFieldAlias(): Boolean[1]
{
  let field = ^Field(name = 'employees', alias = 'salesTeam', selectionSet = [^Field(name = 'firstName')]);
  let document = buildQueryDocument([$field], []);

  assertEquals(
    'query {\n' +
    '  salesTeam: employees {\n' +
    '    firstName\n' +
    '  }\n' +
    '}',
    renderQueryDocument($document)
  );
}

function <<test.Test>> meta::external::store::graphQL::transformation::document::tests::testRenderVariableBoundArgument(): Boolean[1]
{
  let arguments = [^Argument(name = 'department', value = ^Variable(name = 'department'))];
  let variableDefinitions = [^VariableDefinition(name = 'department', type = ^NamedTypeReference(name = 'String'))];
  let field = ^Field(name = 'employees', arguments = $arguments, selectionSet = [^Field(name = 'firstName')]);
  let document = buildQueryDocument([$field], $variableDefinitions);

  assertEquals(
    'query($department: String!) {\n' +
    '  employees(department: $department) {\n' +
    '    firstName\n' +
    '  }\n' +
    '}',
    renderQueryDocument($document)
  );
}

function <<test.Test>> meta::external::store::graphQL::transformation::document::tests::testRenderListTypeVariable(): Boolean[1]
{
  let arguments = [^Argument(name = 'department', value = ^Variable(name = 'department'))];
  let variableDefinitions = [^VariableDefinition(name = 'department', type = ^ListTypeReference(itemType = ^NamedTypeReference(name = 'String')))];
  let field = ^Field(name = 'employees', arguments = $arguments, selectionSet = [^Field(name = 'firstName')]);
  let document = buildQueryDocument([$field], $variableDefinitions);

  assertEquals(
    'query($department: [String!]!) {\n' +
    '  employees(department: $department) {\n' +
    '    firstName\n' +
    '  }\n' +
    '}',
    renderQueryDocument($document)
  );
}
