import meta::pure::extension::*;
import meta::external::store::graphQL::contract::*;

function meta::external::store::graphQL::extension::graphQLStoreExtension(): meta::pure::extension::Extension[1]
{
   ^Extension
   (
      type = 'graphQLStore',
      availableStores = [meta::external::store::graphQL::contract::graphQLStoreContract()],
      serializerExtension = meta::external::store::graphQL::extension::graphQLStoreSerializerExtension_String_1__String_1_
   )
}

function meta::external::store::graphQL::extension::graphQLStoreSerializerExtension(version: String[1]): String[1]
{
   'meta::protocols::pure::' + $version + '::extension::store::graphQL::getGraphQLStoreExtension_String_1__SerializerExtension_1_';
}
