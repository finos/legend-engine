import meta::pure::store::*;
import meta::pure::router::clustering::*;
import meta::pure::executionPlan::*;
import meta::pure::graphFetch::execution::*;
import meta::pure::graphFetch::executionPlan::*;
import meta::pure::mapping::*;
import meta::pure::extension::*;
import meta::core::runtime::*;
import meta::external::store::graphQL::metamodel::pure::*;
import meta::external::store::graphQL::executionPlan::nodes::*;
import meta::external::store::graphQL::executionPlan::generation::*;

function meta::external::store::graphQL::contract::graphQLStoreContract(): StoreContract[1]
{
   ^StoreContract
   (
      id = 'graphQLStore',
      supports = meta::external::store::graphQL::contract::supports_FunctionExpression_1__Boolean_1_,
      planExecution = meta::external::store::graphQL::contract::planExecution_StoreQuery_1__RoutedValueSpecification_$0_1$__Mapping_$0_1$__Runtime_$0_1$__ExecutionContext_1__Extension_MANY__DebugContext_1__ExecutionNode_1_,
      planGraphFetchExecution = meta::external::store::graphQL::contract::planGraphFetchExecution_StoreMappingLocalGraphFetchExecutionNodeGenerationInput_1__LocalGraphFetchExecutionNode_1_,
      planCrossGraphFetchExecution = meta::external::store::graphQL::executionPlan::generation::planCrossStoreGraphFetchExecutionGraphQL_StoreMappingCrossLocalGraphFetchExecutionNodeGenerationInput_1__LocalGraphFetchExecutionNode_1_,

      supportsSetImplementation = s: SetImplementation[1] | $s->instanceOf(RootGraphQLInstanceSetImplementation) || $s->instanceOf(EmbeddedGraphQLSetImplementation),
      supportsStore = s: Store[1] | $s->instanceOf(meta::external::store::graphQL::metamodel::pure::GraphQLStore),
      resolveStoreFromSetImplementation = s: InstanceSetImplementation[1] | $s->match(
                                                                              [
                                                                                r: RootGraphQLInstanceSetImplementation[1] | $r.store,
                                                                                e: EmbeddedGraphQLSetImplementation[1] | $e->meta::pure::router::clustering::resolveRootFromEmbedded()->cast(@RootGraphQLInstanceSetImplementation).store
                                                                              ]),
      supportsNativeJoinAmongElements = false,

      printConnectionToString = {extensions: meta::pure::extension::Extension[*] |
                                       [
                                          c: GraphQLConnection[1] | 'GraphQLConnection(' + $c.url + ')';
                                       ]},
      printPlanNodeToString = {space: String[1], extensions: meta::pure::extension::Extension[*] |
                                       [
                                          n: GraphQLExecutionNode[1] | $space + 'GraphQLExecutionNode(' + $n.url + ')';
                                       ]},
      extractSourceClassFromSetImplementation =
              [
                r: RootGraphQLInstanceSetImplementation[1] | $r.class,
                e: EmbeddedGraphQLSetImplementation[1] | $e.class
              ]
   )
}

function meta::external::store::graphQL::contract::supports(f: FunctionExpression[1]): Boolean[1]
{
   $f.func->in(
      [
         meta::pure::functions::collection::getAll_Class_1__T_MANY_,
         meta::pure::functions::collection::filter_T_MANY__Function_1__T_MANY_,
         meta::pure::functions::boolean::equal_Any_MANY__Any_MANY__Boolean_1_,
         meta::pure::functions::collection::in_Any_1__Any_MANY__Boolean_1_,
         meta::pure::functions::lang::eval_Function_1__T_n__V_m_,
         meta::pure::functions::multiplicity::toOne_T_MANY__T_1_,
         // The router wraps every scalar property access in a synthetic map() - without it recognized
         // here, no scalar property clusters, and graph-fetch falls back to Platform for every leaf.
         meta::pure::functions::collection::map_T_MANY__Function_1__V_MANY_,
         meta::pure::functions::collection::map_T_m__Function_1__V_m_,
         meta::pure::functions::collection::map_T_$0_1$__Function_1__V_$0_1$_,
         meta::pure::functions::lang::whenSubType_Any_MANY__T_1__T_MANY_
      ]->concatenate(meta::pure::graphFetch::execution::graphFetchFunctions())
   )
}

// Thin dispatcher mirroring ServiceStore's exactly - GraphQL Store supports graphFetch queries only.
function meta::external::store::graphQL::contract::planExecution(sq: StoreQuery[1], ext: RoutedValueSpecification[0..1], mapping: Mapping[0..1], runtime: Runtime[0..1], exeCtx: meta::pure::runtime::ExecutionContext[1], extensions: Extension[*], debug: DebugContext[1]): ExecutionNode[1]
{
   let fe = $sq.vs->evaluateAndDeactivate()->cast(@FunctionExpression);
   assert($fe.func->in(graphFetchFunctions()), | 'GraphQL Store supports graphFetch queries only');
   planGraphFetchExecution($sq, $ext, $mapping->toOne(), $runtime->toOne(), $exeCtx, $extensions, $debug);
}

function meta::external::store::graphQL::contract::planGraphFetchExecution(input: StoreMappingLocalGraphFetchExecutionNodeGenerationInput[1]): LocalGraphFetchExecutionNode[1]
{
   meta::external::store::graphQL::executionPlan::generation::planRootGraphFetchExecutionGraphQL($input.storeQuery, $input.ext, $input.clusteredTree, $input.orderedPaths, $input.mapping, $input.runtime, $input.exeCtx, $input.enableConstraints, $input.checked, $input.extensions, $input.debug)
}
