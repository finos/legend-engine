// A non-single-expression QP body falls back to no alias instead of failing plan generation - whether
// it round-trips at execution time then depends on the binding's schema describing a matching property.
function <<test.Test>> meta::external::store::graphQL::executionPlan::generation::tests::testQualifiedPropertyWithoutProxyDelegationStillBuildsAnUnaliasedField(): Boolean[1]
{
  let connection = ^GraphQLConnection(url = 'https://api.example.com/graphql');
  let employeeByName = Employee.qualifiedProperties->filter(p | $p.name == 'employeeByName')->toOne();
  let nameParameter = ^VariableExpression(name = 'name', genericType = ^GenericType(rawType = String), multiplicity = PureOne);
  let employeeByNameTree = ^RoutedPropertyGraphFetchTree(
    property = $employeeByName,
    parameters = $nameParameter,
    subTrees = ^RoutedPropertyGraphFetchTree(property = Employee.properties->filter(p | $p.name == 'firstName')->toOne())
  );

  let node = buildGraphQLExecutionNode($connection, [$employeeByNameTree], false);

  assertEquals('query($name: String!) {\n  employeeByName(name: $name) {\n    firstName\n  }\n}', $node.query);
}

// A polymorphic property's subtype branches arrive as separate sibling subtrees for the same base property
// (manager, manager->subType(@Worker){...}, manager->subType(@Candidate){...}) sharing manager's own wire
// field name - this asserts they get grouped back into one field with a plain selection, auto-requested
// __typename, and one inline fragment per subtype.
function <<test.Test>> meta::external::store::graphQL::executionPlan::generation::tests::testPolymorphicPropertyGroupsSubtypeBranchesIntoInlineFragmentsWithTypename(): Boolean[1]
{
  let connection = ^GraphQLConnection(url = 'https://api.example.com/graphql');
  let managerProperty = Employee.properties->filter(p | $p.name == 'manager')->toOne();

  let plainManagerTree = ^RoutedPropertyGraphFetchTree(
    property = $managerProperty,
    subTrees = ^RoutedPropertyGraphFetchTree(property = TestParentObject.properties->filter(p | $p.name == 'id')->toOne())
  );
  let workerManagerTree = ^RoutedPropertyGraphFetchTree(
    property = $managerProperty,
    subType = meta::external::store::graphQL::executionPlan::tests::Worker,
    subTrees = ^RoutedPropertyGraphFetchTree(property = Worker.properties->filter(p | $p.name == 'employeeId')->toOne())
  );
  let candidateManagerTree = ^RoutedPropertyGraphFetchTree(
    property = $managerProperty,
    subType = meta::external::store::graphQL::executionPlan::tests::Candidate,
    subTrees = ^RoutedPropertyGraphFetchTree(property = Candidate.properties->filter(p | $p.name == 'applicationId')->toOne())
  );

  let node = buildGraphQLExecutionNode($connection, [$plainManagerTree, $workerManagerTree, $candidateManagerTree], false);

  assertEquals('query {\n  manager {\n    id\n    __typename\n    ... on Worker {\n      employeeId\n    }\n    ... on Candidate {\n      applicationId\n    }\n  }\n}', $node.query);
}

function <<test.Test>> meta::external::store::graphQL::executionPlan::generation::tests::testPolymorphicPropertyWithNoPlainSiblingStillUsesBasePropertyAsFieldName(): Boolean[1]
{
  let connection = ^GraphQLConnection(url = 'https://api.example.com/graphql');
  let managerProperty = Employee.properties->filter(p | $p.name == 'manager')->toOne();

  let workerManagerTree = ^RoutedPropertyGraphFetchTree(
    property = $managerProperty,
    subType = meta::external::store::graphQL::executionPlan::tests::Worker,
    subTrees = ^RoutedPropertyGraphFetchTree(property = Worker.properties->filter(p | $p.name == 'employeeId')->toOne())
  );

  let node = buildGraphQLExecutionNode($connection, [$workerManagerTree], false);

  assertEquals('query {\n  manager {\n    __typename\n    ... on Worker {\n      employeeId\n    }\n  }\n}', $node.query);
}

function <<test.Test>> meta::external::store::graphQL::executionPlan::generation::tests::testScalarListArgumentWithAllVariableElementsBindsEachAsItsOwnVariable(): Boolean[1]
{
  let connection = ^GraphQLConnection(url = 'https://api.example.com/graphql');
  let employeesByIds = Employee.qualifiedProperties->filter(p | $p.name == 'employeesByIds')->toOne();
  let idsParameter = ^InstanceValue(
    values = [
      ^VariableExpression(name = 'x', genericType = ^GenericType(rawType = Integer), multiplicity = PureOne),
      ^VariableExpression(name = 'y', genericType = ^GenericType(rawType = Integer), multiplicity = PureOne)
    ],
    genericType = ^GenericType(rawType = Integer),
    multiplicity = ZeroMany
  );
  let employeesByIdsTree = ^RoutedPropertyGraphFetchTree(
    property = $employeesByIds,
    parameters = $idsParameter,
    subTrees = ^RoutedPropertyGraphFetchTree(property = Employee.properties->filter(p | $p.name == 'firstName')->toOne())
  );

  let node = buildGraphQLExecutionNode($connection, [$employeesByIdsTree], false);

  assertEquals('query($x: Int!, $y: Int!) {\n  employeesByIdsProxy: employeesByIds(ids: [$x, $y]) {\n    firstName\n  }\n}', $node.query);
  assert($node.variables->isEmpty(), | 'expected no static variable binding - every list element is variable-bound');
  assertEquals(2, $node.requiredVariableInputs->size());
}

function <<test.Test>> meta::external::store::graphQL::executionPlan::generation::tests::testScalarListArgumentMixingLiteralAndVariableElementBindsOnlyTheVariableElement(): Boolean[1]
{
  let connection = ^GraphQLConnection(url = 'https://api.example.com/graphql');
  let employeesByIds = Employee.qualifiedProperties->filter(p | $p.name == 'employeesByIds')->toOne();
  let idsParameter = ^InstanceValue(
    values = [5, ^VariableExpression(name = 'x', genericType = ^GenericType(rawType = Integer), multiplicity = PureOne)],
    genericType = ^GenericType(rawType = Integer),
    multiplicity = ZeroMany
  );
  let employeesByIdsTree = ^RoutedPropertyGraphFetchTree(
    property = $employeesByIds,
    parameters = $idsParameter,
    subTrees = ^RoutedPropertyGraphFetchTree(property = Employee.properties->filter(p | $p.name == 'firstName')->toOne())
  );

  let node = buildGraphQLExecutionNode($connection, [$employeesByIdsTree], false);

  assertEquals('query($x: Int!) {\n  employeesByIdsProxy: employeesByIds(ids: [5, $x]) {\n    firstName\n  }\n}', $node.query);
  assert($node.variables->isEmpty(), | 'expected no static variable binding - the list mixes a plain literal with a $variable element');
  assertEquals(1, $node.requiredVariableInputs->size());
  assertEquals('x', $node.requiredVariableInputs->toOne().name);
}

function <<test.Test>> meta::external::store::graphQL::executionPlan::generation::tests::testInputObjectTypedListArgumentMixesInlineInstanceCreationAndBareVariableElements(): Boolean[1]
{
  let connection = ^GraphQLConnection(url = 'https://api.example.com/graphql');
  let employeesByFilter = Employee.qualifiedProperties->filter(p | $p.name == 'employeesByFilter')->toOne();

  let instanceCreationEntry = ^SimpleFunctionExpression(
    func = meta::pure::functions::lang::new_Class_1__String_1__KeyExpression_MANY__T_1_,
    genericType = ^GenericType(rawType = meta::external::store::graphQL::executionPlan::tests::FilterKey),
    importGroup = system::imports.children->at(0)->cast(@ImportGroup),
    multiplicity = PureOne,
    parametersValues = [
      ^InstanceValue(genericType = ^GenericType(rawType = String), multiplicity = PureOne, values = meta::external::store::graphQL::executionPlan::tests::FilterKey),
      ^InstanceValue(genericType = ^GenericType(rawType = String), multiplicity = PureOne, values = ''),
      ^InstanceValue(genericType = ^GenericType(rawType = KeyExpression), multiplicity = ZeroMany, values = [
        ^KeyExpression(key = ^InstanceValue(genericType = ^GenericType(rawType = String), multiplicity = PureOne, values = 'key'), expression = ^InstanceValue(genericType = ^GenericType(rawType = String), multiplicity = PureOne, values = 'k1')),
        ^KeyExpression(key = ^InstanceValue(genericType = ^GenericType(rawType = String), multiplicity = PureOne, values = 'value'), expression = ^VariableExpression(genericType = ^GenericType(rawType = String), multiplicity = PureOne, name = 'v'))
      ])
    ]
  );
  let filterVariable = ^VariableExpression(name = 'filterVar', genericType = ^GenericType(rawType = meta::external::store::graphQL::executionPlan::tests::FilterKey), multiplicity = PureOne);
  let filtersParameter = ^InstanceValue(
    values = [$instanceCreationEntry, $filterVariable],
    genericType = ^GenericType(rawType = meta::external::store::graphQL::executionPlan::tests::FilterKey),
    multiplicity = ZeroMany
  );
  let employeesByFilterTree = ^RoutedPropertyGraphFetchTree(
    property = $employeesByFilter,
    parameters = $filtersParameter,
    subTrees = ^RoutedPropertyGraphFetchTree(property = Employee.properties->filter(p | $p.name == 'firstName')->toOne())
  );

  let node = buildGraphQLExecutionNode($connection, [$employeesByFilterTree], false);

  assertEquals('query($v: String!, $filterVar: FilterKey!) {\n  employeesByFilterProxy: employeesByFilter(filters: [{key: "k1", value: $v}, $filterVar]) {\n    firstName\n  }\n}', $node.query);
  assert($node.variables->isEmpty(), | 'expected no static variable binding - the instance-creation entry embeds a variable and the other entry is itself a bare variable');
  assertEquals(2, $node.requiredVariableInputs->size());
}

function <<test.Test>> meta::external::store::graphQL::executionPlan::generation::tests::testMixedShapeListArgumentFailsLoudlyInsteadOfMisserializing(): Boolean[1]
{
  let connection = ^GraphQLConnection(url = 'https://api.example.com/graphql');
  let employeesByFilter = Employee.qualifiedProperties->filter(p | $p.name == 'employeesByFilter')->toOne();

  let literalEntry = ^meta::external::store::graphQL::executionPlan::tests::FilterKey(key = 'k1', value = 'v1');
  let instanceCreationEntry = ^SimpleFunctionExpression(
    func = meta::pure::functions::lang::new_Class_1__String_1__KeyExpression_MANY__T_1_,
    genericType = ^GenericType(rawType = meta::external::store::graphQL::executionPlan::tests::FilterKey),
    importGroup = system::imports.children->at(0)->cast(@ImportGroup),
    multiplicity = PureOne,
    parametersValues = [
      ^InstanceValue(genericType = ^GenericType(rawType = String), multiplicity = PureOne, values = meta::external::store::graphQL::executionPlan::tests::FilterKey),
      ^InstanceValue(genericType = ^GenericType(rawType = String), multiplicity = PureOne, values = ''),
      ^InstanceValue(genericType = ^GenericType(rawType = KeyExpression), multiplicity = ZeroMany, values = [
        ^KeyExpression(key = ^InstanceValue(genericType = ^GenericType(rawType = String), multiplicity = PureOne, values = 'key'), expression = ^InstanceValue(genericType = ^GenericType(rawType = String), multiplicity = PureOne, values = 'k2')),
        ^KeyExpression(key = ^InstanceValue(genericType = ^GenericType(rawType = String), multiplicity = PureOne, values = 'value'), expression = ^VariableExpression(genericType = ^GenericType(rawType = String), multiplicity = PureOne, name = 'x'))
      ])
    ]
  );
  let filtersParameter = ^InstanceValue(
    values = [$literalEntry, $instanceCreationEntry],
    genericType = ^GenericType(rawType = meta::external::store::graphQL::executionPlan::tests::FilterKey),
    multiplicity = ZeroMany
  );
  let employeesByFilterTree = ^RoutedPropertyGraphFetchTree(
    property = $employeesByFilter,
    parameters = $filtersParameter,
    subTrees = ^RoutedPropertyGraphFetchTree(property = Employee.properties->filter(p | $p.name == 'firstName')->toOne())
  );

  assertError(
    | buildGraphQLExecutionNode($connection, [$employeesByFilterTree], false),
    'GraphQL store does not support an inline literal value of type meta::external::store::graphQL::executionPlan::tests::FilterKey'
  );
}

function <<test.Test>> meta::external::store::graphQL::executionPlan::generation::tests::testUnwrapSingleFieldToleratesEmptySelection(): Boolean[1]
{
  let connection = ^GraphQLConnection(url = 'https://api.example.com/graphql');

  let node = buildGraphQLExecutionNode($connection, [], true);

  assert($node.unwrapAlias->isEmpty(), | 'expected no unwrapAlias to be computed when there is nothing to unwrap');
}

function <<test.Test>> meta::external::store::graphQL::executionPlan::generation::tests::testFoldAncestorFieldsIntoSubTypePullsInEveryAncestorInATransitiveHierarchy(): Boolean[1]
{
  let managerProperty = Employee.properties->filter(p | $p.name == 'manager')->toOne();

  let plainTree = ^RoutedPropertyGraphFetchTree(
    property = $managerProperty,
    subTrees = ^RoutedPropertyGraphFetchTree(property = TestParentObject.properties->filter(p | $p.name == 'id')->toOne())
  );
  let workerTree = ^RoutedPropertyGraphFetchTree(
    property = $managerProperty,
    subType = meta::external::store::graphQL::executionPlan::tests::Worker,
    subTrees = ^RoutedPropertyGraphFetchTree(property = Worker.properties->filter(p | $p.name == 'employeeId')->toOne())
  );
  let candidateTree = ^RoutedPropertyGraphFetchTree(
    property = $managerProperty,
    subType = meta::external::store::graphQL::executionPlan::tests::Candidate,
    subTrees = ^RoutedPropertyGraphFetchTree(property = Candidate.properties->filter(p | $p.name == 'applicationId')->toOne())
  );
  let seniorWorkerTree = ^RoutedPropertyGraphFetchTree(
    property = $managerProperty,
    subType = meta::external::store::graphQL::executionPlan::tests::SeniorWorker,
    subTrees = ^RoutedPropertyGraphFetchTree(property = meta::external::store::graphQL::executionPlan::tests::SeniorWorker.properties->filter(p | $p.name == 'bonus')->toOne())
  );

  let group = [$plainTree, $workerTree, $candidateTree, $seniorWorkerTree];

  let foldedSeniorWorker = meta::external::store::graphQL::executionPlan::generation::foldAncestorFieldsIntoSubType($group, $seniorWorkerTree);
  assertEquals(['bonus', 'employeeId', 'id'], $foldedSeniorWorker.subTrees->cast(@RoutedPropertyGraphFetchTree).property.name->toOneMany()->sort());

  // Worker itself must still only pick up the base field, not SeniorWorker's or the unrelated Candidate's.
  let foldedWorker = meta::external::store::graphQL::executionPlan::generation::foldAncestorFieldsIntoSubType($group, $workerTree);
  assertEquals(['employeeId', 'id'], $foldedWorker.subTrees->cast(@RoutedPropertyGraphFetchTree).property.name->toOneMany()->sort());
}
