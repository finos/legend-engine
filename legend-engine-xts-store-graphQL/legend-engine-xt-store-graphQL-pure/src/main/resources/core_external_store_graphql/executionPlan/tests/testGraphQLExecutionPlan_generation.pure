Class meta::external::store::graphQL::executionPlan::tests::Employee
{
  firstName: String[1];
  department: String[1];
  employeeByStatusProxy: meta::external::store::graphQL::executionPlan::tests::Employee[0..1];
  employeeByStatus(status: meta::external::store::graphQL::executionPlan::tests::Status[1]) { $this.employeeByStatusProxy }: meta::external::store::graphQL::executionPlan::tests::Employee[0..1];
  employeesByIdsProxy: meta::external::store::graphQL::executionPlan::tests::Employee[*];
  employeesByIds(ids: Integer[*]) { $this.employeesByIdsProxy }: meta::external::store::graphQL::executionPlan::tests::Employee[*];
  employeeByName(name: String[1]) { $this.firstName->toOne(); $this; }: meta::external::store::graphQL::executionPlan::tests::Employee[1];
  manager: meta::external::store::graphQL::executionPlan::tests::TestParentObject[0..1];
  employeesByFilterProxy: meta::external::store::graphQL::executionPlan::tests::Employee[*];
  employeesByFilter(filters: meta::external::store::graphQL::executionPlan::tests::FilterKey[*]) { $this.employeesByFilterProxy }: meta::external::store::graphQL::executionPlan::tests::Employee[*];
  employeesByRequiredIdsProxy: meta::external::store::graphQL::executionPlan::tests::Employee[*];
  {meta::external::store::graphQL::generation::RequiredArgumentsProfile.requiredArguments = 'ids'} employeesByRequiredIds(ids: Integer[*]) { $this.employeesByRequiredIdsProxy }: meta::external::store::graphQL::executionPlan::tests::Employee[*];
}

Class meta::external::store::graphQL::executionPlan::tests::TestParentObject
{
  id: String[1];
}

Class meta::external::store::graphQL::executionPlan::tests::Worker extends meta::external::store::graphQL::executionPlan::tests::TestParentObject
{
  employeeId: String[1];
}

Class meta::external::store::graphQL::executionPlan::tests::Candidate extends meta::external::store::graphQL::executionPlan::tests::TestParentObject
{
  applicationId: String[1];
}

Class meta::external::store::graphQL::executionPlan::tests::SeniorWorker extends meta::external::store::graphQL::executionPlan::tests::Worker
{
  bonus: String[1];
}

Enum meta::external::store::graphQL::executionPlan::tests::Status
{
  ACTIVE, INACTIVE
}

Class meta::external::store::graphQL::executionPlan::tests::FilterKey
{
  key: String[1];
  value: String[1];
}

function <<test.Test>> meta::external::store::graphQL::executionPlan::generation::tests::testInputObjectShapedInstanceSerializesToJsonCorrectly(): Boolean[1]
{
  let single = ^meta::external::store::graphQL::executionPlan::tests::FilterKey(key = 'ids', value = '123');
  assertEquals('{"key":"ids","value":"123"}', $single->meta::json::toJSON());

  let list = [^meta::external::store::graphQL::executionPlan::tests::FilterKey(key = 'ids', value = '123'), ^meta::external::store::graphQL::executionPlan::tests::FilterKey(key = 'status', value = 'ACTIVE')];
  assertEquals('[{"key":"ids","value":"123"},{"key":"status","value":"ACTIVE"}]', $list->meta::json::toJSON());
}

function meta::external::store::graphQL::executionPlan::tests::buildTestSetImpl(typeName: String[1]): RootGraphQLInstanceSetImplementation[1]
{
  ^RootGraphQLInstanceSetImplementation(
    id = 'test',
    root = true,
    class = Employee,
    parent = ^Mapping(),
    store = ^GraphQLStore(name = 'TestStore', package = meta::external::store::graphQL::executionPlan::tests),
    typeName = $typeName,
    binding = ^meta::external::format::shared::binding::Binding(name = 'testBinding', package = meta::external::store::graphQL::executionPlan::tests, contentType = 'application/json', modelUnit = ^meta::pure::model::unit::ModelUnit())
  );
}

function <<test.Test>> meta::external::store::graphQL::executionPlan::generation::tests::testBuildsUrlAndQuery(): Boolean[1]
{
  let connection = ^GraphQLConnection(url = 'https://api.example.com/graphql');
  let firstNameTree = ^RoutedPropertyGraphFetchTree(property = Employee.properties->filter(p | $p.name == 'firstName')->toOne());

  let node = buildGraphQLExecutionNode($connection, [$firstNameTree], false);

  assertEquals('https://api.example.com/graphql', $node.url);
  assertEquals('query {\n  firstName\n}', $node.query);
}

function <<test.Test>> meta::external::store::graphQL::executionPlan::generation::tests::testEnumTypedVariableArgumentDeclaresRealEnumTypeAndSendsBareName(): Boolean[1]
{
  let connection = ^GraphQLConnection(url = 'https://api.example.com/graphql');
  let employeeByStatus = Employee.qualifiedProperties->filter(p | $p.name == 'employeeByStatus')->toOne();
  let statusParameter = ^VariableExpression(name = 'status', genericType = ^GenericType(rawType = meta::external::store::graphQL::executionPlan::tests::Status), multiplicity = PureOne);
  let employeeByStatusTree = ^RoutedPropertyGraphFetchTree(
    property = $employeeByStatus,
    parameters = $statusParameter,
    subTrees = ^RoutedPropertyGraphFetchTree(property = Employee.properties->filter(p | $p.name == 'firstName')->toOne())
  );

  let node = buildGraphQLExecutionNode($connection, [$employeeByStatusTree], false);

  assertEquals('query($status: Status!) {\n  employeeByStatusProxy: employeeByStatus(status: $status) {\n    firstName\n  }\n}', $node.query);
  assert($node.variables->isEmpty(), | 'expected no static variable binding - the status argument is variable-bound, not literal');
  assertEquals(1, $node.requiredVariableInputs->size());
  assertEquals('status', $node.requiredVariableInputs->toOne().name);
}

