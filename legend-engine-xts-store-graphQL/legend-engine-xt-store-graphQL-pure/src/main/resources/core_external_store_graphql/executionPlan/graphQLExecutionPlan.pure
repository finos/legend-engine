import meta::pure::executionPlan::*;
import meta::pure::runtime::connection::authentication::*;

Class meta::external::store::graphQL::executionPlan::nodes::GraphQLVariableBinding
{
  name: String[1];
  value: String[1];
}

Class meta::external::store::graphQL::executionPlan::nodes::GraphQLExecutionNode extends ExecutionNode
{
  url: String[1];
  query: String[1];
  authenticationSpecification: AuthenticationSpecification[0..1];
  variables: meta::external::store::graphQL::executionPlan::nodes::GraphQLVariableBinding[*];
  unwrapAlias: String[0..1];
}
