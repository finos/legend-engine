// GraphQLStoreModelGenerator stamps one tagged value on each synthetic property it adds purely to stand in
// for a Proxy QP (eg. `employeeProxy` for `employee(id) { $this.employeeProxy }`), naming the QP it was
// generated for - graphQLSelectionSetBuilder.pure reads this back to tell apart a generated proxy sibling
// from a genuinely schema-named property that happens to match the "<qpName>Proxy<digits>" naming pattern,
// which a name-based heuristic alone cannot distinguish.
Profile meta::external::store::graphQL::generation::GeneratedProxyProfile
{
  tags: [generatedProxyForQualifiedProperty];
}
