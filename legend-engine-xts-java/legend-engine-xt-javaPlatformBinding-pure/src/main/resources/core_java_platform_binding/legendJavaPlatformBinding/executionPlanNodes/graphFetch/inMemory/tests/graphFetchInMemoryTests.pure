function <<test.Test>> meta::pure::mapping::modelToModel::executionPlan::platformBinding::legendJava::graphFetch::testNarrowingFallsBackToSubtypeAwareMatchOnlyWhenNoExactMatchExists(): Boolean[1]
{
   let derivedSet = ^meta::pure::mapping::modelToModel::executionPlan::platformBinding::legendJava::graphFetch::TestMatchedInstanceSetImplementation(id = 'derivedSet', root = true, class = meta::pure::mapping::modelToModel::executionPlan::platformBinding::legendJava::graphFetch::TestNarrowingDerivedClass, parent = ^Mapping());
   let mapping = ^Mapping(classMappings = [$derivedSet]);

   let property = meta::pure::mapping::modelToModel::executionPlan::platformBinding::legendJava::graphFetch::TestNarrowingBaseClass.properties->toOne()->cast(@Property<Nil,Any|*>);
   let tree = ^RoutedPropertyGraphFetchTree(property = $property);

   // No candidate targets TestNarrowingBaseClass (the declaredType) exactly - the only candidate targets its
   // subtype, TestNarrowingDerivedClass - so the subtype-aware fallback must be what matches it.
   let onlyCandidate = ^meta::pure::mapping::modelToModel::executionPlan::platformBinding::legendJava::graphFetch::TestPropertyMapping(property = $property, sourceSetImplementationId = 'src', targetSetImplementationId = 'derivedSet');

   let narrowed = $tree->meta::pure::mapping::modelToModel::executionPlan::platformBinding::legendJava::graphFetch::narrowRoutedPropertyGraphFetchTreeToSingleTarget([$onlyCandidate], meta::pure::mapping::modelToModel::executionPlan::platformBinding::legendJava::graphFetch::TestNarrowingBaseClass, $mapping);

   assertEquals(1, $narrowed.propertyMapping->size());
   assertEquals('derivedSet', $narrowed.propertyMapping->toOne()->cast(@PropertyMapping).targetSetImplementationId);
}

function <<test.Test>> meta::pure::mapping::modelToModel::executionPlan::platformBinding::legendJava::graphFetch::testNarrowingFailsLoudlyOnGenuineAmbiguity(): Boolean[1]
{
   let derivedSet = ^meta::pure::mapping::modelToModel::executionPlan::platformBinding::legendJava::graphFetch::TestMatchedInstanceSetImplementation(id = 'derivedSet', root = true, class = meta::pure::mapping::modelToModel::executionPlan::platformBinding::legendJava::graphFetch::TestNarrowingDerivedClass, parent = ^Mapping());
   let unrelatedSet = ^meta::pure::mapping::modelToModel::executionPlan::platformBinding::legendJava::graphFetch::TestUnrelatedInstanceSetImplementation(id = 'unrelatedSet', root = true, class = meta::pure::mapping::modelToModel::executionPlan::platformBinding::legendJava::graphFetch::TestUnrelatedClass, parent = ^Mapping());
   let mapping = ^Mapping(classMappings = [$derivedSet, $unrelatedSet]);

   let property = meta::pure::mapping::modelToModel::executionPlan::platformBinding::legendJava::graphFetch::TestNarrowingBaseClass.properties->toOne()->cast(@Property<Nil,Any|*>);
   let tree = ^RoutedPropertyGraphFetchTree(property = $property);

   // Two candidates, neither targeting TestNarrowingQueryClass (the declaredType being routed) nor one of its
   // subtypes/supertypes (it's unrelated to both TestNarrowingDerivedClass and TestUnrelatedClass) - this is
   // genuinely ambiguous and must fail loudly, not silently fall back to routing through both.
   let derivedCandidate = ^meta::pure::mapping::modelToModel::executionPlan::platformBinding::legendJava::graphFetch::TestPropertyMapping(property = $property, sourceSetImplementationId = 'src', targetSetImplementationId = 'derivedSet');
   let unrelatedCandidate = ^meta::pure::mapping::modelToModel::executionPlan::platformBinding::legendJava::graphFetch::TestPropertyMapping(property = $property, sourceSetImplementationId = 'src', targetSetImplementationId = 'unrelatedSet');

   assertError(
      | $tree->meta::pure::mapping::modelToModel::executionPlan::platformBinding::legendJava::graphFetch::narrowRoutedPropertyGraphFetchTreeToSingleTarget([$derivedCandidate, $unrelatedCandidate], meta::pure::mapping::modelToModel::executionPlan::platformBinding::legendJava::graphFetch::TestNarrowingQueryClass, $mapping);,
      'Could not unambiguously route a graph fetch to a single target for type \'meta::pure::mapping::modelToModel::executionPlan::platformBinding::legendJava::graphFetch::TestNarrowingQueryClass\' - 2 candidate property mappings exist, none of which target that type or one of its subtypes/supertypes'
   );
}
