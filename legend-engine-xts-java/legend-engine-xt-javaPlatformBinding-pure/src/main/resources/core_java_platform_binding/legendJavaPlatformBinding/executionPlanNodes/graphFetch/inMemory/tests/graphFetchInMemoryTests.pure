function <<test.Test>> meta::pure::mapping::modelToModel::executionPlan::platformBinding::legendJava::graphFetch::testOwnerSupportsThisThreadedQpOnlyAppliesToMatchedOwner(): Boolean[1]
{
   let matched = ^meta::pure::mapping::modelToModel::executionPlan::platformBinding::legendJava::graphFetch::TestMatchedInstanceSetImplementation(id = 'matched', root = true, class = meta::pure::metamodel::type::Any, parent = ^Mapping());
   let unrelated = ^meta::pure::mapping::modelToModel::executionPlan::platformBinding::legendJava::graphFetch::TestUnrelatedInstanceSetImplementation(id = 'unrelated', root = true, class = meta::pure::metamodel::type::Any, parent = ^Mapping());

   let extensionSupportingOnlyMatchedType = ^LegendJavaInMemoryGraphFetchExtension(
      supportsThisThreadedQualifiedPropertyRouting = [
         m: meta::pure::mapping::modelToModel::executionPlan::platformBinding::legendJava::graphFetch::TestMatchedInstanceSetImplementation[1] | true
      ]
   );

   assertEquals(true, [$matched]->meta::pure::mapping::modelToModel::executionPlan::platformBinding::legendJava::graphFetch::ownerSupportsThisThreadedQualifiedPropertyRouting([$extensionSupportingOnlyMatchedType]));
   assertEquals(false, [$unrelated]->meta::pure::mapping::modelToModel::executionPlan::platformBinding::legendJava::graphFetch::ownerSupportsThisThreadedQualifiedPropertyRouting([$extensionSupportingOnlyMatchedType]));
}

