import meta::pure::mapping::modelToModel::executionPlan::platformBinding::legendJava::graphFetch::storeStreamReading::json::*;

function <<access.private>> meta::pure::mapping::modelToModel::executionPlan::platformBinding::legendJava::graphFetch::storeStreamReading::json::groupsAsStrings(groups:List<Integer>[*]):String[*]
{
   $groups->map(g | $g.values->map(i | $i->toString())->joinStrings(','));
}

function <<test.Test>> meta::pure::mapping::modelToModel::executionPlan::platformBinding::legendJava::graphFetch::storeStreamReading::json::testReaderWithinBudgetStaysInOneClass():Boolean[1]
{
   assertEquals('0,1,2', jsonReadMethodGroups([20000, 20000, 10000], [])->groupsAsStrings());
   assertEquals('', jsonReadMethodGroups([], [])->groupsAsStrings());
}

function <<test.Test>> meta::pure::mapping::modelToModel::executionPlan::platformBinding::legendJava::graphFetch::storeStreamReading::json::testReaderOverBudgetIsGroupedGreedilyWithinBudget():Boolean[1]
{
   assertEquals(['0,1', '2,3', '4'], jsonReadMethodGroups([30000, 20000, 25000, 25000, 1], [])->groupsAsStrings());
   assertEquals(['0', '1', '2'], jsonReadMethodGroups([60000, 49000, 2000], [])->groupsAsStrings());
}

function <<test.Test>> meta::pure::mapping::modelToModel::executionPlan::platformBinding::legendJava::graphFetch::storeStreamReading::json::testMaxReadMethodsPerClassOverridesBudget():Boolean[1]
{
   assertEquals(['0,1', '2,3', '4'], jsonReadMethodGroups([30, 30, 30, 30, 30], 2)->groupsAsStrings());
   assertEquals(['0,1,2,3,4'], jsonReadMethodGroups([30, 30, 30, 30, 30], 5)->groupsAsStrings());
   assertEquals(['0,1,2'], jsonReadMethodGroups([60000, 60000, 60000], 0)->groupsAsStrings());
   assertEquals(['0,1,2'], jsonReadMethodGroups([60000, 60000, 60000], -1)->groupsAsStrings());
}
