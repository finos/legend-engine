import meta::external::language::java::metamodel::*;
import meta::external::language::java::factory::*;
import meta::external::language::java::serialization::*;
import meta::external::language::java::transform::*;
import meta::pure::executionPlan::platformBinding::legendJava::library::meta::*;
import meta::pure::executionPlan::platformBinding::legendJava::shared::*;

function meta::pure::executionPlan::platformBinding::legendJava::library::meta::registerMetaLibrary(conventions: Conventions[1]): Conventions[1]
{
    let lib = newConventionsLibrary()
      ->addFunctionCoders([
         // ----------------- Move to Grammar when possible ------------------------
         fc(extractEnumValue_Enumeration_1__String_1__T_1_,            extractEnumValue_FunctionExpression_1__Conventions_1__DebugContext_1__Code_1_),
         fc(extractEnumValue_Enumeration_1__String_$0_1$__T_$0_1$_,    extractEnumValue_FunctionExpression_1__Conventions_1__DebugContext_1__Code_1_),

         // ----------------- Move to Grammar when possible ------------------------
         // ----------------- Move to Essential when possible ------------------------
         fc(enumValues_Enumeration_1__T_MANY_,                         enumValues_FunctionExpression_1__Conventions_1__DebugContext_1__Code_1_),
         // ----------------- Move to Essential when possible ------------------------

         fc(meta::pure::mapping::getSourceEnumValues_Mapping_1__Enumeration_1__Enum_MANY_,
            getSourceEnumValues_FunctionExpression_1__Conventions_1__DebugContext_1__Code_1_),
         fc(meta::pure::mapping::getSourceEnumValuesByName_Mapping_1__Enumeration_1__String_1__Enum_MANY_,
            getSourceEnumValuesByName_FunctionExpression_1__Conventions_1__DebugContext_1__Code_1_),
         fc(meta::pure::mapping::getEnumerationMappingValueByName_Mapping_1__Enumeration_1__String_1__Any_1__Enum_$0_1$_,
            getEnumerationMappingValueByName_FunctionExpression_1__Conventions_1__DebugContext_1__Code_1_),
         fc(meta::pure::mapping::mapToEnumValue_Enum_1__Enumeration_1__Mapping_1__Enum_1_,
            mapToEnumValue_FunctionExpression_1__Conventions_1__DebugContext_1__Code_1_),
         fc(meta::pure::mapping::mapToEnumValueOptional_Enum_$0_1$__Enumeration_1__Mapping_1__Enum_$0_1$_,
            mapToEnumValueOptional_FunctionExpression_1__Conventions_1__DebugContext_1__Code_1_),

         fc1(typeName_Any_1__String_1_,                                { ctx,obj | if($ctx.params->at(0).genericType.rawType->toOne()->instanceOf(meta::pure::metamodel::type::Class),
                                                                                      | $obj->j_invoke(typeNameMethod(), [], javaString()),
                                                                                      | j_string($ctx.params->at(0).genericType.rawType.name->toOne()))}),
         fc1(typePath_Any_1__String_1_,                                { ctx,obj | if($ctx.params->at(0).genericType.rawType->toOne()->instanceOf(meta::pure::metamodel::type::Class),
                                                                                      | $obj->j_invoke(typePathMethod(), [], javaString()),
                                                                                      | j_string($ctx.params->at(0).genericType.rawType->toOne()->elementToPath()))})
      ]);

    $conventions->registerClassCoder(
         ClassPurpose.ENUMERATION,
         generateEnumeration_Type_1__Conventions_1__DebugContext_1__Class_1_
      )->registerLibrary($lib);
}

function meta::pure::executionPlan::platformBinding::legendJava::library::meta::extractEnumValue(fe:FunctionExpression[1], conventions:Conventions[1], debug:DebugContext[1]): Code[1]
{
   let params    = $fe.parametersValues->evaluateAndDeactivate();
   let type      = $params->at(0).genericType.typeArguments->at(0).rawType->toOne();
   let enumType  = $conventions->className($type);

   $params->at(1)->match([
        iv:InstanceValue[1] | if($iv.values->isEmpty(), 
                                | j_null(), 
                                | let enumName = j_string($params->at(1)->cast(@InstanceValue).values->cast(@String)->toOne());
                                  let nonNullBranch = $enumType->j_invoke('getEnumFromPureName', $enumName, $enumType); 
                                  j_conditional($enumName->j_eq(j_null()), j_null(), $nonNullBranch)->dependsOn(enumTypeDependency($type, $conventions, $debug));
                              ),
        sfe:SimpleFunctionExpression[1] | let srcPropValue = $sfe->generateJava($conventions, $debug->indent());
                                          let nonNullBranch = ^StaticMethodCall(class=$enumType, methodName='getEnumFromPureName', arguments=$srcPropValue, type=$enumType);
                                          j_conditional($srcPropValue->j_eq(j_null()), j_null(), $nonNullBranch);
	 ]);
}

function meta::pure::executionPlan::platformBinding::legendJava::library::meta::enumValues(fe:FunctionExpression[1], conventions:Conventions[1], debug:DebugContext[1]): Code[1]
{
   let params    = $fe.parametersValues->evaluateAndDeactivate();
   let type      = $params->at(0).genericType.typeArguments->at(0).rawType->toOne();
   let enumType  = $conventions->className($type);
   
   javaArrays()->j_invoke('asList', $enumType->j_invoke('values', [], javaArray($enumType)), javaList($enumType))->dependsOn(enumTypeDependency($type, $conventions, $debug));
}

function <<access.private>> meta::pure::executionPlan::platformBinding::legendJava::library::meta::enumTypeDependency(type:meta::pure::metamodel::type::Type[1], conventions:Conventions[1], debug:DebugContext[1]) : CodeDependency[1]
{
   let name = $type->elementToPath();
   let dep = newDependency(
      $name,
        {state |    let typeInfo = meta::pure::executionPlan::platformBinding::typeInfo::newTypeInfoSet()->meta::pure::executionPlan::platformBinding::typeInfo::addForType($type);
                    let project = generateInterfacesAndEnums($conventions, $typeInfo, $debug);
                    $state->addDependencyProject($name, $project);
        });  
}

function meta::pure::executionPlan::platformBinding::legendJava::library::meta::generateEnumeration(type:meta::pure::metamodel::type::Type[1], conventions: Conventions[1], debug: DebugContext[1]): meta::external::language::java::metamodel::Class[1]
{
   print(if($debug.debug,|$debug.space+'generateEnumeration: \''+$type.name->toOne()+'\'\n', |''));

   let enums = $type->cast(@meta::pure::metamodel::type::Enumeration<Any>)->enumValues();
   if($enums->forAll(e | $e->cast(@Enum).name->isValidJavaIdentifier()),
     | generateEnumerationIfValidJavaIdentifier($type, $conventions, $enums, $debug),
     | generateEnumerationIfInValidJavaIdentifier($type, $conventions, $enums, $debug));
}

function meta::pure::executionPlan::platformBinding::legendJava::library::meta::generateEnumerationIfValidJavaIdentifier(type:meta::pure::metamodel::type::Type[1], conventions: Conventions[1], enums: Any[*], debug: DebugContext[1]): meta::external::language::java::metamodel::Class[1]
{
   print(if($debug.debug,|$debug.space+'generateEnumerationIfValidJavaIdentifier : \''+$type.name->toOne()+'\'\n', |''));
   let enumPkgAndName   = $conventions->className($type);
  
   ^meta::external::language::java::metamodel::Enumeration(
      simpleName  = $enumPkgAndName.simpleName,
      package     = $enumPkgAndName.package,
      modifiers   = meta::external::language::java::metamodel::Modifier.Public,
      enumeration = $enums->map(e| ^meta::external::language::java::metamodel::EnumerationEntry(name=$conventions->identifier($e->cast(@Enum).name))),
      methods     = [
         javaMethod('public', meta::external::language::java::factory::javaString(), 'getName', [], 'return this.name();'),
         javaMethod(['public', 'static'], $enumPkgAndName, 'getEnumFromPureName', javaParam(javaString(), 'pureName'), $enumPkgAndName->j_invoke('valueOf', j_parameter(javaString(), 'pureName'), $enumPkgAndName)->j_return())
      ]
   );
}

function meta::pure::executionPlan::platformBinding::legendJava::library::meta::generateEnumerationIfInValidJavaIdentifier(type:meta::pure::metamodel::type::Type[1], conventions: Conventions[1], enums: Any[*], debug: DebugContext[1]): meta::external::language::java::metamodel::Class[1]
{
   print(if($debug.debug,|$debug.space+'generateEnumerationIfInvalidJavaIdentifier : \''+$type.name->toOne()+'\'\n', |''));
   let enumPkgAndName      = $conventions->className($type);
   let mapType             = javaMap(javaString(), $enumPkgAndName);
   let pureName            = j_parameter(javaString(), 'pureName');
   let pureNameToEnumMap   = javaField(['private', 'static', 'final'], $mapType, 'pureNameToEnumMap', 'initValues()');
   let values              = j_variable($mapType, 'values');
   
   let addValues           = $enums->size()->range()->map(index | $values->j_invoke('put',  [j_string($enums->at($index)->cast(@Enum).name), $enumPkgAndName->j_field('ENUM' + $index->toString())]));
   let initCode            = j_block($values->j_declare(javaHashMap(javaString(), $enumPkgAndName)->j_new([]))->concatenate($addValues)->concatenate($values->j_return()));
   let getEnumFromPureNameCode    = j_if($pureName->j_eq(j_null()),
                                          javaNullPointerException()->j_new([j_string('pureName of Enum is null.')])->j_throw(),
                                          j_if(
                                                $enumPkgAndName->j_field($pureNameToEnumMap)->j_invoke('containsKey', $pureName),
                                                $enumPkgAndName->j_field($pureNameToEnumMap)->j_invoke('get', $pureName)->j_return(),
                                                javaIllegalArgumentException()->j_new([j_string('No Enum constant : ')->j_plus($pureName)])->j_throw()
                                              )
                                        );

   ^meta::external::language::java::metamodel::Enumeration(
      simpleName  = $enumPkgAndName.simpleName,
      package     = $enumPkgAndName.package,
      modifiers   = meta::external::language::java::metamodel::Modifier.Public,
      enumeration = $enums->size()->range()->map(index | ^meta::external::language::java::metamodel::EnumerationEntry(name = $conventions->identifier('ENUM' + $index->toString()), value = $enums->at($index)->cast(@Enum).name)),
      methods     = [
         javaMethod('public', meta::external::language::java::factory::javaString(), 'getName', [], 'return this.pureName;'),
         javaMethod(['public', 'static'], $enumPkgAndName, 'getEnumFromPureName', $pureName, $getEnumFromPureNameCode),
         javaMethod(['private', 'static'], $mapType, 'initValues', [], $initCode)
      ],
      fields      = [javaField('private', javaString(), 'pureName'), $pureNameToEnumMap]
   )
   ->addConstructor(
      javaConstructor([], [j_parameter(javaString(), 'pureName')], 'this.pureName = pureName;')
   );
}

function <<access.private>>meta::pure::executionPlan::platformBinding::legendJava::library::meta::isValidJavaIdentifier(name:String[1]):Boolean[1]
{
  if($name->size() == 0,
  | false,
  | range(0, $name->length())->forAll(i | let c = $name->substring($i, $i + 1);
                                          if($i == 0,
                                            | $c->isLetter() || ['$','_']->contains($c),
                                            | $c->isDigit() || $c->isLetter() || ['$','_']->contains($c)
                                            );
                                       );
  );
}

// ============================================================================================================
// Enumeration-mapping helpers -- inline coders for meta::pure::mapping::getSourceEnumValues /
// getSourceEnumValuesByName / getEnumerationMappingValueByName.
//
// These functions take a Mapping[1] argument that the default processInstanceValue path cannot
// materialise ("Unhandled value type: meta::pure::mapping::Mapping"). Instead of asking Java-gen
// to serialise the Mapping, we resolve everything at code-gen time: the Mapping and the target
// Enumeration are compile-time knowns (a mapping literal reference and an Enumeration<T>
// generic argument), so the include-DAG walk and the enum-name lookups can all happen in Pure
// during code generation. What is emitted at each callsite is a plain literal expression
// (Arrays.asList(...) or a chained conditional lookup) that never mentions a Mapping.
//
// Constraints on callers:
//  * The Mapping arg must be a literal reference to a Mapping element (an InstanceValue whose
//    values[0] is the Mapping). Passing a computed Mapping expression is unsupported.
//  * For getSourceEnumValuesByName / getEnumerationMappingValueByName, the enumerationMappingName
//    arg must be a String literal.
//  * getEnumerationMappingValueByName additionally supports either a String literal or a
//    runtime String/primitive expression as the source value.
// ============================================================================================================

function <<access.private>> meta::pure::executionPlan::platformBinding::legendJava::library::meta::collectEnumerationMappingsTransitively(mapping: meta::pure::mapping::Mapping[1]): meta::pure::mapping::EnumerationMapping<Any>[*]
{
   $mapping.enumerationMappings
      ->concatenate($mapping.includes.included->map(m | $m->collectEnumerationMappingsTransitively()));
}

function <<access.private>> meta::pure::executionPlan::platformBinding::legendJava::library::meta::extractLiteralMapping(iv: ValueSpecification[1]): meta::pure::mapping::Mapping[1]
{
   assert($iv->instanceOf(InstanceValue), | 'getSourceEnumValues/getSourceEnumValuesByName/getEnumerationMappingValueByName require a literal Mapping reference as the first argument');
   $iv->cast(@InstanceValue).values->toOne()->cast(@meta::pure::mapping::Mapping);
}

function <<access.private>> meta::pure::executionPlan::platformBinding::legendJava::library::meta::extractLiteralString(iv: ValueSpecification[1], argDescription: String[1]): String[1]
{
   assert($iv->instanceOf(InstanceValue), | $argDescription + ' must be a String literal');
   $iv->cast(@InstanceValue).values->toOne()->cast(@String);
}

// Builds Arrays.asList(EnumType.getEnumFromPureName("A"), EnumType.getEnumFromPureName("B"), ...)
// for the given enum-name list. Returns an empty Arrays.asList() when the list is empty.
function <<access.private>> meta::pure::executionPlan::platformBinding::legendJava::library::meta::emitEnumListLiteral(enumNames: String[*], enumType: meta::pure::metamodel::type::Type[1], conventions: Conventions[1], debug: DebugContext[1]): Code[1]
{
   let javaEnumType = $conventions->className($enumType);
   let items = $enumNames->distinct()->map(n | $javaEnumType->j_invoke('getEnumFromPureName', j_string($n), $javaEnumType));
   javaArrays()->j_invoke('asList', $items, javaList($javaEnumType))
      ->dependsOn(enumTypeDependency($enumType, $conventions, $debug));
}

function meta::pure::executionPlan::platformBinding::legendJava::library::meta::getSourceEnumValues(fe:FunctionExpression[1], conventions:Conventions[1], debug:DebugContext[1]): Code[1]
{
   let params      = $fe.parametersValues->evaluateAndDeactivate();
   let mapping     = extractLiteralMapping($params->at(0));
   let enumType    = $params->at(1).genericType.typeArguments->at(0).rawType->toOne();
   let allEnumMaps = collectEnumerationMappingsTransitively($mapping);
   let matching    = $allEnumMaps->filter(em | $em.enumeration->toOne() == $enumType);
   let enumNames   = $matching->map(em | $em.enumValueMappings.enum)->cast(@Enum)->map(e | $e.name->toOne());
   emitEnumListLiteral($enumNames, $enumType, $conventions, $debug);
}

function meta::pure::executionPlan::platformBinding::legendJava::library::meta::getSourceEnumValuesByName(fe:FunctionExpression[1], conventions:Conventions[1], debug:DebugContext[1]): Code[1]
{
   let params      = $fe.parametersValues->evaluateAndDeactivate();
   let mapping     = extractLiteralMapping($params->at(0));
   let enumType    = $params->at(1).genericType.typeArguments->at(0).rawType->toOne();
   let emName      = extractLiteralString($params->at(2), 'enumerationMappingName');
   let allEnumMaps = collectEnumerationMappingsTransitively($mapping);
   let matching    = $allEnumMaps->filter(em | ($em.enumeration->toOne() == $enumType) && ($em.name == $emName));
   let enumNames   = $matching->map(em | $em.enumValueMappings.enum)->cast(@Enum)->map(e | $e.name->toOne());
   emitEnumListLiteral($enumNames, $enumType, $conventions, $debug);
}

function meta::pure::executionPlan::platformBinding::legendJava::library::meta::getEnumerationMappingValueByName(fe:FunctionExpression[1], conventions:Conventions[1], debug:DebugContext[1]): Code[1]
{
   let params        = $fe.parametersValues->evaluateAndDeactivate();
   let mapping       = extractLiteralMapping($params->at(0));
   let enumType      = $params->at(1).genericType.typeArguments->at(0).rawType->toOne();
   let emName        = extractLiteralString($params->at(2), 'enumerationMappingName');
   let javaEnumType  = $conventions->className($enumType);
   let sourceCode    = $params->at(3)->generateJava($conventions, $debug->indent());

   let allEnumMaps = collectEnumerationMappingsTransitively($mapping);
   let matching    = $allEnumMaps->filter(em | ($em.enumeration->toOne() == $enumType) && ($em.name == $emName));
   let pairs = $matching->map(em | $em.enumValueMappings)
                        ->map(evm | $evm.sourceValues->filter(sv | $sv->instanceOf(String))
                                                     ->map(sv | pair($sv->cast(@String), $evm.enum->cast(@Enum).name->toOne())));

   let elseBranch = j_null($javaEnumType);
   let chained = $pairs->fold(
      {p, acc |
         let hit = $javaEnumType->j_invoke('getEnumFromPureName', j_string($p.second), $javaEnumType);
         j_conditional($sourceCode->j_invoke('equals', j_string($p.first), javaBoolean()), $hit, $acc, $javaEnumType);
      },
      $elseBranch
   );
   $chained->dependsOn(enumTypeDependency($enumType, $conventions, $debug));
}

// ============================================================================================================
// mapToEnumValue / mapToEnumValueOptional -- inline coders.
//
// Surface functions (meta::pure::mapping::enumerationHelpers.pure):
//   mapToEnumValue(sourceEnum: Enum[1], targetEnum: Enumeration<T>[1], mapping: Mapping[1]): T[1]
//   mapToEnumValueOptional(sourceEnum: Enum[0..1], ...): T[0..1]
//
// Semantics: at code-gen time, walk the Mapping include-DAG for the first
// EnumerationMapping whose .enumeration matches the target Enumeration. Emit
// a chained conditional over each String source-value in that EnumerationMapping,
// falling back to targetEnum.getEnumFromPureName(sourceEnum.getName()) when
// no branch matches (and unconditionally when no EnumerationMapping exists for
// the target enum -- the extractEnumValue path).
//
// The Optional variant additionally guards the whole expression on
// sourceEnumCode != null, returning null when the source is empty.
// ============================================================================================================

function <<access.private>> meta::pure::executionPlan::platformBinding::legendJava::library::meta::mapToEnumValueBody(sourceEnumCode: Code[1], targetEnumType: meta::pure::metamodel::type::Type[1], mapping: meta::pure::mapping::Mapping[1], conventions: Conventions[1], debug: DebugContext[1]): Code[1]
{
   let javaEnumType = $conventions->className($targetEnumType);
   let sourceNameCode = $sourceEnumCode->j_invoke('getName', [], javaString());
   let fallback = $javaEnumType->j_invoke('getEnumFromPureName', $sourceNameCode, $javaEnumType);

   let firstMapping = collectEnumerationMappingsTransitively($mapping)
      ->filter(em | $em.enumeration->toOne() == $targetEnumType)
      ->first();

   let result = if($firstMapping->isEmpty(),
      | $fallback,
      | let pairs = $firstMapping->toOne().enumValueMappings
                       ->map(evm | $evm.sourceValues->filter(sv | $sv->instanceOf(String))
                                                    ->map(sv | pair($sv->cast(@String), $evm.enum->cast(@Enum).name->toOne())));
        $pairs->fold(
           {p, acc |
              let hit = $javaEnumType->j_invoke('getEnumFromPureName', j_string($p.second), $javaEnumType);
              j_conditional($sourceNameCode->j_invoke('equals', j_string($p.first), javaBoolean()), $hit, $acc, $javaEnumType);
           },
           $fallback
        );
   );
   $result->dependsOn(enumTypeDependency($targetEnumType, $conventions, $debug));
}

function meta::pure::executionPlan::platformBinding::legendJava::library::meta::mapToEnumValue(fe:FunctionExpression[1], conventions:Conventions[1], debug:DebugContext[1]): Code[1]
{
   let params         = $fe.parametersValues->evaluateAndDeactivate();
   let sourceEnumCode = $params->at(0)->generateJava($conventions, $debug->indent());
   let targetEnumType = $params->at(1).genericType.typeArguments->at(0).rawType->toOne();
   let mapping        = extractLiteralMapping($params->at(2));
   mapToEnumValueBody($sourceEnumCode, $targetEnumType, $mapping, $conventions, $debug);
}

function meta::pure::executionPlan::platformBinding::legendJava::library::meta::mapToEnumValueOptional(fe:FunctionExpression[1], conventions:Conventions[1], debug:DebugContext[1]): Code[1]
{
   let params         = $fe.parametersValues->evaluateAndDeactivate();
   let sourceEnumCode = $params->at(0)->generateJava($conventions, $debug->indent());
   let targetEnumType = $params->at(1).genericType.typeArguments->at(0).rawType->toOne();
   let mapping        = extractLiteralMapping($params->at(2));
   let javaEnumType   = $conventions->className($targetEnumType);
   let nonNull        = mapToEnumValueBody($sourceEnumCode, $targetEnumType, $mapping, $conventions, $debug);
   j_conditional($sourceEnumCode->j_eq(j_null()), j_null($javaEnumType), $nonNull, $javaEnumType);
}
