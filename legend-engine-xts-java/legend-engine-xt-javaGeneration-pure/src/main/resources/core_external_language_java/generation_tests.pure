import meta::external::language::java::factory::*;
import meta::external::language::java::serialization::*;
import meta::external::language::java::transform::*;

function <<access.private>> meta::external::language::java::transform::generatedMethodBody(methodParameterNames: String[*]): String[1]
{
   let body = {| {t:String[1] | $t}}->cast(@LambdaFunction<Any>).expressionSequence->evaluateAndDeactivate();
   $body->generateJavaMethodBody(newConventions([], []), javaObject(), $methodParameterNames, noDebug())->codeToString();
}

function <<test.Test>> meta::external::language::java::transform::lambdaParameterSharingNameWithMethodParameterIsRenamed():Boolean[1]
{
   assert(generatedMethodBody(['t'])->contains('t_1'));
}

function <<test.Test>> meta::external::language::java::transform::lambdaParameterNotSharingNameWithMethodParameterIsKept():Boolean[1]
{
   assertFalse(generatedMethodBody(['u'])->contains('t_1'));
}
