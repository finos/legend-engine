    )
    View meteor_season_vw
    (
      shower_code: almanac.meteor_season_raw.shower_code PRIMARY KEY,
      season_year: almanac.meteor_season_raw.season_year PRIMARY KEY,
      peak_rate: almanac.meteor_season_raw.peak_rate,
