    )
    View meteor_rate_vw
    (
      shower_code: almanac.meteor_rate_raw.shower_code PRIMARY KEY,
      observed_on: almanac.meteor_rate_raw.observed_on PRIMARY KEY,
      station_code: almanac.meteor_rate_raw.station_code PRIMARY KEY,
      hourly_rate: almanac.meteor_rate_raw.hourly_rate,
      limiting_magnitude: almanac.meteor_rate_raw.limiting_magnitude,
