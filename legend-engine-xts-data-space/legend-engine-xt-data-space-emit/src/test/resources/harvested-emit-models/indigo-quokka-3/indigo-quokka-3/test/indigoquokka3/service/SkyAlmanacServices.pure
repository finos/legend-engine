          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            observedOn = %2026-01-18
          ]
          asserts:
          [
            projectedRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Asteroid":"AS-0004","Observed On":"2026-01-18","Reduced Magnitude":3.21,"Phase Angle":12.5,"Rotation Hours":5.34},{"Asteroid":"AS-0433","Observed On":"2026-01-18","Reduced Magnitude":10.83,"Phase Angle":null,"Rotation Hours":5.27}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service test::indigoquokka3::service::MeteorRatesOnNight
{
  pattern: '/indigoquokka3/v1/meteor-rates/{observedOn}';
  title: 'Indigo Quokka 3 - Meteor rates on one night';
  documentation: 'Every hourly meteor rate counted by any station on one requested observing night.';
  autoActivateUpdates: true;
  ownership: DID { identifier: '000000' };
  execution: Single
  {
    query: {observedOn: StrictDate[1]|test::indigoquokka3::domain::MeteorShowerRate.all()->filter(
      m|($m.observedOn == $observedOn)
    )->project(
      [
        m|$m.showerCode,
        m|$m.observedOn,
        m|$m.stationCode,
        m|$m.hourlyRate,
        m|$m.limitingMagnitude,
        m|$m.cloudCoverPct
      ],
      [
        'Shower',
        'Observed On',
        'Station',
        'Hourly Rate',
        'Limiting Magnitude',
        'Cloud Cover Pct'
      ]
    )->sort(
      [
        asc('Shower'),
        asc('Observed On')
      ]
    )};
    mapping: test::indigoquokka3::mapping::SkyAlmanacMapping;
    runtime: test::indigoquokka3::runtime::SkyAlmanacRuntime;
  }
  testSuites:
  [
    meteorRatesOnNightSuite:
    {
      data:
      [
        connections:
        [
          skyAlmanacWarehouse:
            Relational
            #{
              almanac.meteor_rate_raw:
                'shower_code,observed_on,station_code,hourly_rate,limiting_magnitude,cloud_cover_pct\n'+
                'QUA,2026-01-03,ST-HILL,84,6.25,10\n'+
                'QUA,2026-01-04,ST-HILL,37,5.75,40\n'+
                'QUA,2026-01-03,ST-LAKE,,,95\n';
            }#
        ]
      ]
      tests:
      [
        filteredRows:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            observedOn = %2026-01-03
          ]
          asserts:
          [
            projectedRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Shower":"QUA","Observed On":"2026-01-03","Station":"ST-HILL","Hourly Rate":84,"Limiting Magnitude":6.25,"Cloud Cover Pct":10},{"Shower":"QUA","Observed On":"2026-01-03","Station":"ST-LAKE","Hourly Rate":null,"Limiting Magnitude":null,"Cloud Cover Pct":95}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
