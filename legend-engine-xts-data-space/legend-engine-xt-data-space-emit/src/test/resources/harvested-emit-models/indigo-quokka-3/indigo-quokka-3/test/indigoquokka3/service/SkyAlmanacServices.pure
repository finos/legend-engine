Service test::indigoquokka3::service::StarMagnitudesOnNightForStar
{
  pattern: '/indigoquokka3/v1/star-magnitudes/{observedOn}/{starCode}';
  title: 'Indigo Quokka 3 - Star magnitudes of one star on one night';
  documentation: 'The magnitude estimates of one requested star on one requested observing night; other stars and other nights are excluded before projection.';
  autoActivateUpdates: true;
  ownership: DID { identifier: '000000' };
  execution: Single
  {
    query: {observedOn: StrictDate[1], starCode: String[1]|test::indigoquokka3::domain::StarMagnitude.all()->filter(
      s|($s.observedOn == $observedOn) && ($s.starCode == $starCode)
    )->project(
      [
        s|$s.starCode,
        s|$s.observedOn,
        s|$s.bandCode,
        s|$s.magnitude,
        s|$s.magnitudeError,
        s|$s.airmass,
        s|$s.observerCode
      ],
      [
        'Star',
        'Observed On',
        'Band',
        'Magnitude',
        'Magnitude Error',
        'Airmass',
        'Observer'
      ]
    )->sort(
      [
        asc('Star'),
        asc('Observed On')
      ]
    )};
    mapping: test::indigoquokka3::mapping::SkyAlmanacMapping;
    runtime: test::indigoquokka3::runtime::SkyAlmanacRuntime;
  }
  testSuites:
  [
    starMagnitudesOnNightForStarSuite:
    {
      data:
      [
        connections:
        [
          skyAlmanacWarehouse:
            Relational
            #{
              almanac.star_magnitude_raw:
                'star_code,observed_on,band_code,magnitude,magnitude_error,airmass,observer_code\n'+
                'VS-ALG,2026-03-02,V,2.12,0.03,1.21,OBS-07\n'+
                'VS-ALG,2026-03-05,V,3.39,0.04,1.34,OBS-07\n'+
                'VS-MIR,2026-03-02,R,6.47,,1.58,OBS-11\n'+
                'VS-DEL,2026-03-02,B,4.21,0.02,,\n';
            }#
        ]
      ]
      tests:
      [
        filteredRows:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            observedOn = %2026-03-02,
            starCode = 'VS-ALG'
          ]
          asserts:
          [
            projectedRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Star":"VS-ALG","Observed On":"2026-03-02","Band":"V","Magnitude":2.12,"Magnitude Error":0.03,"Airmass":1.21,"Observer":"OBS-07"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

