###Service
Service test::indigoquokka3::service::StarMagnitudeAlmanac
{
  pattern: '/indigoquokka3/v1/star-magnitudes';
  title: 'Indigo Quokka 3 - Star magnitude almanac';
  documentation: 'Every variable-star magnitude estimate projected into titled columns, ordered by star and night.';
  autoActivateUpdates: true;
  ownership: DID { identifier: '000000' };
  execution: Single
  {
    query: |test::indigoquokka3::domain::StarMagnitude.all()->project(
      [
        s|$s.starCode,
        s|$s.observedOn,
        s|$s.bandCode,
        s|$s.magnitude,
        s|$s.magnitudeError,
        s|$s.airmass,
        s|$s.observerCode
      ],
      [
        'Star',
        'Observed On',
        'Band',
        'Magnitude',
        'Magnitude Error',
        'Airmass',
        'Observer'
      ]
    )->sort(
      [
        asc('Star'),
        asc('Observed On')
      ]
    );
    mapping: test::indigoquokka3::mapping::SkyAlmanacMapping;
    runtime: test::indigoquokka3::runtime::SkyAlmanacRuntime;
  }
  testSuites:
  [
    starMagnitudeAlmanacSuite:
    {
      data:
      [
        connections:
        [
          skyAlmanacWarehouse:
            Relational
            #{
              almanac.star_magnitude_raw:
                'star_code,observed_on,band_code,magnitude,magnitude_error,airmass,observer_code\n'+
                'VS-ALG,2026-03-02,V,2.12,0.03,1.21,OBS-07\n'+
                'VS-ALG,2026-03-05,V,3.39,0.04,1.34,OBS-07\n'+
                'VS-MIR,2026-03-02,R,6.47,,1.58,OBS-11\n'+
                'VS-DEL,2026-03-02,B,4.21,0.02,,\n';
            }#
        ]
      ]
      tests:
      [
        everyRowProjected:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            projectedRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Star":"VS-ALG","Observed On":"2026-03-02","Band":"V","Magnitude":2.12,"Magnitude Error":0.03,"Airmass":1.21,"Observer":"OBS-07"},{"Star":"VS-ALG","Observed On":"2026-03-05","Band":"V","Magnitude":3.39,"Magnitude Error":0.04,"Airmass":1.34,"Observer":"OBS-07"},{"Star":"VS-DEL","Observed On":"2026-03-02","Band":"B","Magnitude":4.21,"Magnitude Error":0.02,"Airmass":null,"Observer":null},{"Star":"VS-MIR","Observed On":"2026-03-02","Band":"R","Magnitude":6.47,"Magnitude Error":null,"Airmass":1.58,"Observer":"OBS-11"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service test::indigoquokka3::service::StarSeasonAlmanac
{
  pattern: '/indigoquokka3/v1/star-seasons';
  title: 'Indigo Quokka 3 - Star season almanac';
  documentation: 'Seasonal brightness statistics of every variable star, ordered by star and season.';
  autoActivateUpdates: true;
  ownership: DID { identifier: '000000' };
  execution: Single
  {
    query: |test::indigoquokka3::domain::StarStatistics.all()->project(
      [
        s|$s.starCode,
        s|$s.seasonYear,
        s|$s.meanMagnitude,
        s|$s.minMagnitude,
        s|$s.maxMagnitude,
        s|$s.observationCount,
        s|$s.lastObservedOn
      ],
      [
        'Star',
        'Season',
        'Mean Magnitude',
        'Brightest',
        'Faintest',
        'Observations',
        'Last Observed'
      ]
    )->sort(
      [
        asc('Star'),
        asc('Season')
      ]
    );
    mapping: test::indigoquokka3::mapping::SkyAlmanacMapping;
    runtime: test::indigoquokka3::runtime::SkyAlmanacRuntime;
  }
  testSuites:
  [
    starSeasonAlmanacSuite:
    {
      data:
      [
        connections:
        [
          skyAlmanacWarehouse:
            Relational
            #{
              almanac.star_season_raw:
                'star_code,season_year,mean_magnitude,min_magnitude,max_magnitude,observation_count,last_observed_on\n'+
                'VS-ALG,2025,2.87,2.09,3.41,118,2025-12-30\n'+
                'VS-ALG,2026,2.76,2.12,3.39,24,2026-03-05\n'+
                'VS-MIR,2025,,3.46,9.27,61,\n';
            }#
        ]
      ]
      tests:
      [
        everyRowProjected:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            projectedRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Star":"VS-ALG","Season":2025,"Mean Magnitude":2.87,"Brightest":2.09,"Faintest":3.41,"Observations":118,"Last Observed":"2025-12-30"},{"Star":"VS-ALG","Season":2026,"Mean Magnitude":2.76,"Brightest":2.12,"Faintest":3.39,"Observations":24,"Last Observed":"2026-03-05"},{"Star":"VS-MIR","Season":2025,"Mean Magnitude":null,"Brightest":3.46,"Faintest":9.27,"Observations":61,"Last Observed":null}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

