###DataSpace
DataSpace test::quietwillow::dataspace::NetworkDataSpace
{
  executionContexts:
  [
    {
      name: 'network';
      description: 'Network tier - the station and sensor registers of the two network schemas, resolved through the station mapping and its H2 runtime.';
      mapping: test::quietwillow::mapping::StationMapping;
      defaultRuntime: test::quietwillow::runtime::StationRuntime;
    }
  ];
  defaultExecutionContext: 'network';
  title: 'Quiet Willow Station Network';
  description: 'Catalogue surface over the field weather network: the stations that root the register, the sensor units commissioned on them and the classification metadata the station profile attaches. Consumers resolve the same mapping, primary keys and main-table aliases the mapping tests pin, so the catalogue path and the execution path both compile.';
  elements:
  [
    test::quietwillow::domain,
    test::quietwillow::profile
  ];
  supportInfo: Email
  {
    address: 'station-network-desk@example.invalid';
  };
}
