###Mapping
Mapping test::quietwillow::mapping::StationMapping
(
  *test::quietwillow::domain::WeatherStation[station]: Relational
  {
    ~primaryKey
    (
      [test::quietwillow::store::StationDB]network.weather_station.station_code
    )
    ~mainTable [test::quietwillow::store::StationDB]network.weather_station
    stationCode: [test::quietwillow::store::StationDB]network.weather_station.station_code,
    stationName: [test::quietwillow::store::StationDB]network.weather_station.station_name,
    elevationM: [test::quietwillow::store::StationDB]network.weather_station.elevation_m,
    commissionedOn: [test::quietwillow::store::StationDB]network.weather_station.commissioned_on
  }

  *test::quietwillow::domain::SensorUnit[sensor]: Relational
  {
    ~primaryKey
    (
      [test::quietwillow::store::StationDB]network.sensor_unit.sensor_code
    )
    ~mainTable [test::quietwillow::store::StationDB]network.sensor_unit
    sensorCode: [test::quietwillow::store::StationDB]network.sensor_unit.sensor_code,
    stationCode: [test::quietwillow::store::StationDB]network.sensor_unit.station_code,
    sensorKind: [test::quietwillow::store::StationDB]network.sensor_unit.sensor_kind,
    calibrationFactor: [test::quietwillow::store::StationDB]network.sensor_unit.calibration_factor
  }

  *test::quietwillow::domain::SensorReading[reading]: Relational
  {
    ~primaryKey
    (
      [test::quietwillow::store::StationDB]telemetry.sensor_reading.reading_code
    )
    ~mainTable [test::quietwillow::store::StationDB]telemetry.sensor_reading
    readingCode: [test::quietwillow::store::StationDB]telemetry.sensor_reading.reading_code,
    sensorCode: [test::quietwillow::store::StationDB]telemetry.sensor_reading.sensor_code,
    recordedOn: [test::quietwillow::store::StationDB]telemetry.sensor_reading.recorded_on,
    valueCelsius: [test::quietwillow::store::StationDB]telemetry.sensor_reading.value_celsius,
    sensorKind: [test::quietwillow::store::StationDB]@Sensor_Reading | [test::quietwillow::store::StationDB]network.sensor_unit.sensor_kind,
    stationName: [test::quietwillow::store::StationDB]@Sensor_Reading > @Station_Sensor | [test::quietwillow::store::StationDB]network.weather_station.station_name,
    stationElevationM: [test::quietwillow::store::StationDB]@Sensor_Reading > @Station_Sensor | [test::quietwillow::store::StationDB]network.weather_station.elevation_m
  }

  testSuites:
  [
    readingNavigationSuite:
    {
      function: |test::quietwillow::domain::SensorReading.all()->project([r|$r.readingCode, r|$r.sensorKind->toOne(), r|$r.stationName->toOne(), r|$r.stationElevationM->toOne(), r|$r.valueCelsius->toOne()], ['ReadingCode', 'SensorKind', 'StationName', 'ElevationM', 'ValueCelsius'])->sort([asc('ReadingCode')]);
      tests:
      [
        readingsReachTheStation:
        {
          doc: 'Walks the two-hop join path from the telemetry reading table through the sensor register in the other schema and onto the station row, carrying both a matched and an unmatched sensor on the first hop.';
          data:
          [
            test::quietwillow::store::StationDB:
              Relational
              #{
                network.weather_station:
                  'station_code,station_name,elevation_m,commissioned_on\n'+
                  'WS-01,Ridge Meadow,412,2019-04-11\n'+
                  'WS-02,Hollow Bend,158,2021-09-02\n';
                network.sensor_unit:
                  'sensor_code,station_code,sensor_kind,calibration_factor\n'+
                  'SU-01,WS-01,THERMISTOR,1.02\n'+
                  'SU-02,WS-02,THERMOCOUPLE,0.97\n';
                telemetry.sensor_reading:
                  'reading_code,sensor_code,recorded_on,value_celsius\n'+
                  'SR-01,SU-01,2024-03-01,11.5\n'+
                  'SR-02,SU-02,2024-03-01,14.25\n'+
                  'SR-03,SU-01,2024-03-02,9.75\n'+
                  'SR-04,SU-09,2024-03-02,7.5\n';
              }#
          ];
          asserts:
          [
            matchedReadingsResolveUnmatchedStaysNull:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"ReadingCode":"SR-01","SensorKind":"THERMISTOR","StationName":"Ridge Meadow","ElevationM":412,"ValueCelsius":11.5},{"ReadingCode":"SR-02","SensorKind":"THERMOCOUPLE","StationName":"Hollow Bend","ElevationM":158,"ValueCelsius":14.25},{"ReadingCode":"SR-03","SensorKind":"THERMISTOR","StationName":"Ridge Meadow","ElevationM":412,"ValueCelsius":9.75},{"ReadingCode":"SR-04","SensorKind":null,"StationName":null,"ElevationM":null,"ValueCelsius":7.5}]';
                  }#;
              }#
          ];
        }
      ];
    },
    warmReadingSuite:
    {
      function: |test::quietwillow::domain::SensorReading.all()->filter(r|$r.valueCelsius->toOne() >= 12.0)->project([r|$r.readingCode, r|$r.stationName->toOne()], ['ReadingCode', 'StationName'])->sort([asc('ReadingCode')]);
      tests:
      [
        onlyWarmReadingsKeepTheirStation:
        {
          doc: 'Filters the readings above a temperature bound before the join path is walked, so only the warm reading resolves its station name.';
          data:
          [
            test::quietwillow::store::StationDB:
              Relational
              #{
                network.weather_station:
                  'station_code,station_name,elevation_m,commissioned_on\n'+
                  'WS-01,Ridge Meadow,412,2019-04-11\n'+
                  'WS-02,Hollow Bend,158,2021-09-02\n';
                network.sensor_unit:
                  'sensor_code,station_code,sensor_kind,calibration_factor\n'+
                  'SU-01,WS-01,THERMISTOR,1.02\n'+
                  'SU-02,WS-02,THERMOCOUPLE,0.97\n';
                telemetry.sensor_reading:
                  'reading_code,sensor_code,recorded_on,value_celsius\n'+
                  'SR-01,SU-01,2024-03-01,11.5\n'+
                  'SR-02,SU-02,2024-03-01,14.25\n';
              }#
          ];
          asserts:
          [
            oneWarmReading:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"ReadingCode":"SR-02","StationName":"Hollow Bend"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
