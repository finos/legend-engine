###Connection
RelationalDatabaseConnection test::quietwillow::connection::StationConnection
{
  store: test::quietwillow::store::StationDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists network;',
      'create schema network;',
      'drop schema if exists telemetry;',
      'create schema telemetry;',
      'create table network.weather_station (station_code varchar(24) primary key, station_name varchar(120) not null, elevation_m integer not null, commissioned_on date);',
      'create table network.sensor_unit (sensor_code varchar(24) primary key, station_code varchar(24) not null, sensor_kind varchar(48) not null, calibration_factor double);',
      'create table telemetry.sensor_reading (reading_code varchar(24) primary key, sensor_code varchar(24) not null, recorded_on date, value_celsius double);'
      ];
  };
  auth: DefaultH2;
}
