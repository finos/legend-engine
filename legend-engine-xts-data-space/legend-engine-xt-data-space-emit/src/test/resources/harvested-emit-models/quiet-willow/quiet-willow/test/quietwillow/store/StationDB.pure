###Relational
Database test::quietwillow::store::StationDB
(
  Schema network
  (
    Table weather_station
    (
      station_code VARCHAR(24) PRIMARY KEY,
      station_name VARCHAR(120) NOT NULL,
      elevation_m INTEGER NOT NULL,
      commissioned_on DATE
    )
    Table sensor_unit
    (
      sensor_code VARCHAR(24) PRIMARY KEY,
      station_code VARCHAR(24) NOT NULL,
      sensor_kind VARCHAR(48) NOT NULL,
      calibration_factor DOUBLE
    )
  )

  Schema telemetry
  (
    Table sensor_reading
    (
      reading_code VARCHAR(24) PRIMARY KEY,
      sensor_code VARCHAR(24) NOT NULL,
      recorded_on DATE,
      value_celsius DOUBLE
    )
  )

  Join Station_Sensor(network.weather_station.station_code = network.sensor_unit.station_code)
  Join Sensor_Reading(network.sensor_unit.sensor_code = telemetry.sensor_reading.sensor_code)
)
