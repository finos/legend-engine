###DataSpace
DataSpace test::quietwillow::dataspace::TelemetryDataSpace
{
  executionContexts:
  [
    {
      name: 'telemetry';
      description: 'Telemetry tier - the reading surface of the telemetry schema, whose station and sensor columns are reached through the two-hop join path of the station mapping.';
      mapping: test::quietwillow::mapping::StationMapping;
      defaultRuntime: test::quietwillow::runtime::StationRuntime;
    }
  ];
  defaultExecutionContext: 'telemetry';
  title: 'Quiet Willow Telemetry Readings';
  description: 'Catalogue surface over the daily readings of the field weather network. Every reading carries the sensor kind reached over one hop and the station name and elevation reached over two hops across the schema boundary, so a consumer of this context resolves the cross-schema navigation rather than assembling it.';
  elements:
  [
    test::quietwillow::domain
  ];
  supportInfo: Email
  {
    address: 'telemetry-desk@example.invalid';
  };
}
