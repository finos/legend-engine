###Pure
import test::tealcanyon::domain::*;

Class {meta::pure::profiles::doc.doc = 'A telemetry gauge installed on a canyon river reach.'} test::tealcanyon::domain::GaugeStation
{
  stationCode: String[1];
  installedOn: StrictDate[1];
  stationName: String[1];
  elevationM: Integer[1];
  telemetryLive: Boolean[1];
  reachName: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A named reach of the canyon river that gauges are installed along.'} test::tealcanyon::domain::RiverReach
{
  reachCode: String[1];
  reachName: String[1];
  reachLengthKm: Float[1];
}

Class {meta::pure::profiles::doc.doc = 'A field visit recording discharge and turbidity readings at a gauge.'} test::tealcanyon::domain::FieldSurvey
{
  surveyId: String[1];
  surveyedAt: DateTime[1];
  dischargeCms: Float[1];
  turbidityNtu: Integer[1];
}

Class {meta::pure::profiles::doc.doc = 'A field crew accountable for the surveys it carries out.'} test::tealcanyon::domain::SurveyTeam
{
  teamCode: String[1];
  teamName: String[1];
}

Association test::tealcanyon::domain::ReachStations
{
  reach: RiverReach[0..1];
  stations: GaugeStation[*];
}

Association test::tealcanyon::domain::StationSurveys
{
  station: GaugeStation[0..1];
  surveys: FieldSurvey[*];
}

Association test::tealcanyon::domain::TeamSurveys
{
  team: SurveyTeam[0..1];
  teamSurveys: FieldSurvey[*];
}
