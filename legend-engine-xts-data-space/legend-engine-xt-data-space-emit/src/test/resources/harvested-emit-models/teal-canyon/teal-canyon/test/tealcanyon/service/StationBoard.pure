###Service
Service test::tealcanyon::service::StationBoard
{
  pattern: '/tealcanyon/v1/station-board';
  title: 'Canyon Gauge Station Board';
  owners:
  [
    'example-teal-canyon-hydrology'
  ];
  documentation: 'Installed gauge stations with their elevation, telemetry state and the river reach reached through the store join.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |test::tealcanyon::domain::GaugeStation.all()->project(
      [
        s|$s.stationCode,
        s|$s.stationName,
        s|$s.installedOn,
        s|$s.elevationM,
        s|$s.telemetryLive,
        s|$s.reachName,
        s|$s.stationCode + ' / ' + $s.stationName,
        s|$s.elevationM * 3
      ],
      [
        'Station',
        'Name',
        'Installed',
        'Elevation M',
        'Telemetry',
        'Reach',
        'Label',
        'Elevation Score'
      ]
    )->sort([asc('Station'), asc('Installed')]);
    mapping: test::tealcanyon::mapping::CanyonMapping;
    runtime: test::tealcanyon::runtime::CanyonRuntime;
  }
  testSuites:
  [
    testSuite_1:
    {
      data:
      [
        connections:
        [
          connection_1:
            Relational
            #{
              canyon.gauge_station:
                'station_code,installed_on,reach_code,station_name,elevation_m,telemetry_live\n'+
                'GS-1,2021-04-01,RC-1,Cliffside Gauge,845,true\n'+
                'GS-2,2022-06-15,RC-2,Willow Bend Gauge,612,false\n'+
                'GS-3,2023-08-20,RC-9,Orphan Ridge Gauge,701,true\n';
              canyon.river_reach:
                'reach_code,reach_name,reach_length_km\n'+
                'RC-1,Upper Teal Narrows,12.40\n'+
                'RC-2,Lower Teal Flats,8.75\n'+
                'RC-3,Dry Side Channel,3.50\n';
            }#
        ]
      ]
      tests:
      [
        test_station_board:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            assertion_board: EqualToJson
              #{
                expected: ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Station":"GS-1","Name":"Cliffside Gauge","Installed":"2021-04-01","Elevation M":845,"Telemetry":true,"Reach":"Upper Teal Narrows","Label":"GS-1 / Cliffside Gauge","Elevation Score":2535},{"Station":"GS-2","Name":"Willow Bend Gauge","Installed":"2022-06-15","Elevation M":612,"Telemetry":false,"Reach":"Lower Teal Flats","Label":"GS-2 / Willow Bend Gauge","Elevation Score":1836},{"Station":"GS-3","Name":"Orphan Ridge Gauge","Installed":"2023-08-20","Elevation M":701,"Telemetry":true,"Reach":null,"Label":"GS-3 / Orphan Ridge Gauge","Elevation Score":2103}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
