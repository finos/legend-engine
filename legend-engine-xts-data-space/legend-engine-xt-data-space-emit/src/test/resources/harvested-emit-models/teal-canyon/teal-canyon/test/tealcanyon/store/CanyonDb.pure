###Relational
Database test::tealcanyon::store::CanyonDb
(
  Schema canyon
  (
    Table river_reach
    (
      reach_code VARCHAR(12) PRIMARY KEY,
      reach_name VARCHAR(80),
      reach_length_km DECIMAL(9,2)
    )
    Table gauge_station
    (
      station_code VARCHAR(12) PRIMARY KEY,
      installed_on DATE PRIMARY KEY,
      reach_code VARCHAR(12),
      station_name VARCHAR(80),
      elevation_m INTEGER,
      telemetry_live BIT
    )
    Table survey_team
    (
      team_code VARCHAR(8) PRIMARY KEY,
      team_name VARCHAR(80)
    )
    Table field_survey
    (
      survey_id VARCHAR(12) PRIMARY KEY,
      surveyed_at TIMESTAMP PRIMARY KEY,
      station_code VARCHAR(12),
      team_code VARCHAR(8),
      discharge_cms DECIMAL(9,2),
      turbidity_ntu INTEGER
    )
  )

  Join Station_Reach(canyon.gauge_station.reach_code = canyon.river_reach.reach_code)
  Join Survey_Station(canyon.field_survey.station_code = canyon.gauge_station.station_code)
  Join Survey_Team(canyon.field_survey.team_code = canyon.survey_team.team_code)
)
