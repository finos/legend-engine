###DataSpace
DataSpace test::tealcanyon::dataspace::CanyonDataSpace
{
  executionContexts:
  [
    {
      name: 'canyon';
      description: 'Canyon environment - the gauge and survey model served through the canyon hydrology warehouse.';
      mapping: test::tealcanyon::mapping::CanyonMapping;
      defaultRuntime: test::tealcanyon::runtime::CanyonRuntime;
    }
  ];
  defaultExecutionContext: 'canyon';
  title: 'Teal Canyon River Monitoring';
  description: 'Discovery surface over the canyon river monitoring network: gauge stations along the reaches, and the crew-attributed field surveys taken at them.';
  elements:
  [
    test::tealcanyon::domain::FieldSurvey,
    test::tealcanyon::domain::GaugeStation,
    test::tealcanyon::domain::RiverReach,
    test::tealcanyon::domain::SurveyTeam
  ];
  executables:
  [
    {
      id: 1;
      title: 'Gauge Station Board';
      description: 'The installed gauge stations with their reach reached through the store join.';
      executable: test::tealcanyon::service::StationBoard;
    },
    {
      id: 2;
      title: 'Field Survey Log';
      description: 'The crew-attributed survey readings taken at the gauges.';
      executable: test::tealcanyon::service::SurveyLog;
    }
  ];
  supportInfo: Email
  {
    address: 'canyon-hydrology-desk@tealcanyon.invalid';
  };
}
