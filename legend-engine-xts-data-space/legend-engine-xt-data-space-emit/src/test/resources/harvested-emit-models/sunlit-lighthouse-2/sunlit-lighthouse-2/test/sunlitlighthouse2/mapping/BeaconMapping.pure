###Mapping
Mapping test::sunlitlighthouse2::mapping::LampStationMapping
(
  *test::sunlitlighthouse2::domain::LampStation[station]: Relational
  {
    ~primaryKey
    (
      [test::sunlitlighthouse2::store::BeaconDB]coastal.lamp_station.station_code
    )
    ~mainTable [test::sunlitlighthouse2::store::BeaconDB]coastal.lamp_station
    stationCode: [test::sunlitlighthouse2::store::BeaconDB]coastal.lamp_station.station_code,
    stationName: [test::sunlitlighthouse2::store::BeaconDB]coastal.lamp_station.station_name,
    reachName: [test::sunlitlighthouse2::store::BeaconDB]@station_reach | [test::sunlitlighthouse2::store::BeaconDB]coastal.shoreline_reach.reach_name,
    districtName: [test::sunlitlighthouse2::store::BeaconDB]@station_reach | [test::sunlitlighthouse2::store::BeaconDB]coastal.shoreline_reach.district_name,
    lampRangeNm: [test::sunlitlighthouse2::store::BeaconDB]coastal.lamp_station.lamp_range_nm,
    focalHeightM: [test::sunlitlighthouse2::store::BeaconDB]coastal.lamp_station.focal_height_m,
    commissionedOn: [test::sunlitlighthouse2::store::BeaconDB]coastal.lamp_station.commissioned_on,
    rangeBand: case(
                 greaterThan([test::sunlitlighthouse2::store::BeaconDB]coastal.lamp_station.lamp_range_nm, 20),
                 'Landfall',
                 case(
                   greaterThan([test::sunlitlighthouse2::store::BeaconDB]coastal.lamp_station.lamp_range_nm, 10),
                   'Coastal',
                   'Harbour'
                 )
               )
  }
)
