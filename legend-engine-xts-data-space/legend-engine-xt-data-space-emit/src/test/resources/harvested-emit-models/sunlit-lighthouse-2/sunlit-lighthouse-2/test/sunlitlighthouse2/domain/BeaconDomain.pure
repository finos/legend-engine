###Pure
import test::sunlitlighthouse2::domain::*;

Class {meta::pure::profiles::doc.doc = 'A coastal lamp station whose beacon is serviced on a keeper rota.'} test::sunlitlighthouse2::domain::LampStation
{
  stationCode: String[1];
  stationName: String[1];
  reachName: String[1];
  districtName: String[1];
  lampRangeNm: Integer[1];
  focalHeightM: Integer[1];
  commissionedOn: StrictDate[1];
  rangeBand: String[1];
}
