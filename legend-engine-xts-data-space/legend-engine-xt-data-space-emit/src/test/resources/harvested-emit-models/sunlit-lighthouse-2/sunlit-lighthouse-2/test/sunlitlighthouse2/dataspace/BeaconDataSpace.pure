###DataSpace
DataSpace <<test::sunlitlighthouse2::profile::BeaconProfile.publishedView>> {meta::pure::profiles::doc.doc = 'Governed entry point over the coastal lamp station register.', test::sunlitlighthouse2::profile::BeaconProfile.taxonomyNode = 'coastal/beacons/stations', test::sunlitlighthouse2::profile::BeaconProfile.stewardTeam = 'Shoreline Keeping'} test::sunlitlighthouse2::dataspace::BeaconDataSpace
{
  executionContexts:
  [
    {
      name: 'reference';
      description: 'Reference tier - the schema-qualified beacon register used for keeper reporting and test execution.';
      mapping: test::sunlitlighthouse2::mapping::LampStationMapping;
      defaultRuntime: test::sunlitlighthouse2::runtime::LampStationRuntime;
    }
  ];
  defaultExecutionContext: 'reference';
  title: 'Coastal Lamp Stations And Shoreline Reaches';
  description: 'A governed publication of the lamp station register, the shoreline reach each station sits on and the band its lamp range falls into.';
}
