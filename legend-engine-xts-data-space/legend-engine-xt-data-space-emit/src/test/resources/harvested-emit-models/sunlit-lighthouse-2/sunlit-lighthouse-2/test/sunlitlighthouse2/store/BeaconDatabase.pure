###Relational
Database test::sunlitlighthouse2::store::BeaconDB
(
  Schema coastal
  (
    Table lamp_station
    (
      station_code VARCHAR(20) PRIMARY KEY,
      station_name VARCHAR(80) NOT NULL,
      shoreline_code VARCHAR(8) NOT NULL,
      lamp_range_nm INTEGER NOT NULL,
      focal_height_m INTEGER NOT NULL,
      commissioned_on DATE NOT NULL
    )
    Table shoreline_reach
    (
      shoreline_code VARCHAR(8) PRIMARY KEY,
      reach_name VARCHAR(80) NOT NULL,
      district_name VARCHAR(80) NOT NULL
    )
  )

  Join station_reach
  (
    coastal.lamp_station.shoreline_code = coastal.shoreline_reach.shoreline_code
  )
)
