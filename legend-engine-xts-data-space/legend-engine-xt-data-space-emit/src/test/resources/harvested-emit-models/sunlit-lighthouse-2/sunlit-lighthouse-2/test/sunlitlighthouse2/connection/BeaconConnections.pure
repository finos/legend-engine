###Connection
RelationalDatabaseConnection test::sunlitlighthouse2::connection::BeaconH2Connection
{
  store: test::sunlitlighthouse2::store::BeaconDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists coastal cascade;',
      'create schema coastal;',
      'create table coastal.shoreline_reach(shoreline_code varchar(8) primary key, reach_name varchar(80) not null, district_name varchar(80) not null);',
      'create table coastal.lamp_station(station_code varchar(20) primary key, station_name varchar(80) not null, shoreline_code varchar(8) not null, lamp_range_nm integer not null, focal_height_m integer not null, commissioned_on date not null);',
      'insert into coastal.shoreline_reach(shoreline_code, reach_name, district_name) values (\'SR-N\', \'Northern Sands\', \'Upper Shore\');',
      'insert into coastal.lamp_station(station_code, station_name, shoreline_code, lamp_range_nm, focal_height_m, commissioned_on) values (\'LS-01\', \'Alder Point Light\', \'SR-N\', 24, 38, \'1901-04-11\');'
    ];
  };
  auth: DefaultH2;
}
