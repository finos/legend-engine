###Runtime
Runtime test::solarapiary3::runtime::MeadowH2Runtime
{
  mappings:
  [
    test::solarapiary3::mapping::MeadowMapping
  ];
  connections:
  [
    test::solarapiary3::store::MeadowDb:
    [
      meadowConnection: test::solarapiary3::connection::MeadowH2Connection
    ]
  ];
}

Runtime test::solarapiary3::runtime::MeadowWarehouseRuntime
{
  mappings:
  [
    test::solarapiary3::mapping::MeadowMapping
  ];
  connections:
  [
    test::solarapiary3::store::MeadowDb:
    [
      warehouseConnection: test::solarapiary3::connection::MeadowWarehouseConnection
    ]
  ];
}
