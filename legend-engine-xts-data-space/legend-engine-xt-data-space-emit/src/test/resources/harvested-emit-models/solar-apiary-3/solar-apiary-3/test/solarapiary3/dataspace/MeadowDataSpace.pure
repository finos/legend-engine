###DataSpace
DataSpace test::solarapiary3::dataspace::MeadowDataSpace
{
  executionContexts:
  [
    {
      name: 'survey';
      description: 'Survey tier - the transect counts served through the in-process survey store.';
      mapping: test::solarapiary3::mapping::MeadowMapping;
      defaultRuntime: test::solarapiary3::runtime::MeadowH2Runtime;
    },
    {
      name: 'warehouse';
      description: 'Warehouse tier - the same curated binding planned against the vault-authenticated warehouse connection.';
      mapping: test::solarapiary3::mapping::MeadowMapping;
      defaultRuntime: test::solarapiary3::runtime::MeadowWarehouseRuntime;
    }
  ];
  defaultExecutionContext: 'survey';
  title: 'Solar Apiary Pollinator Meadow Survey';
  description: 'Discovery surface over the pollinator meadow transect counts: the banded station records and the two execution tiers they are served through.';
  elements:
  [
    test::solarapiary3::domain::PollinatorCount
  ];
  executables:
  [
    {
      id: 1;
      title: 'Counts above a visit floor';
      description: 'Featured endpoint returning the banded transect counts that reach the supplied visit floor.';
      executable: test::solarapiary3::service::PollinatorCountsByVisitFloor;
    }
  ];
  supportInfo: Email
  {
    address: 'pollinator-meadow-desk@meadowsurvey.invalid';
  };
}
