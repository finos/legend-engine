###Connection
RelationalDatabaseConnection test::solarapiary3::connection::MeadowH2Connection
{
  store: test::solarapiary3::store::MeadowDb;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists meadow;',
      'create schema meadow;',
      'create table meadow.pollinator_count (count_id integer primary key, station_code varchar(20) not null, habitat_band varchar(20) not null, visits_per_hour double not null, bloom_cover_pct double not null, observed_on date not null);'
      ];
  };
  auth: DefaultH2;
}


###Connection
RelationalDatabaseConnection test::solarapiary3::connection::MeadowWarehouseConnection
{
  store: test::solarapiary3::store::MeadowDb;
  type: Snowflake;
  quoteIdentifiers: false;
  specification: Snowflake
  {
    name: 'MEADOW_SURVEY_DB';
    account: 'meadow_survey_account';
    warehouse: 'MEADOW_SURVEY_WH';
    region: 'eu-west-2';
    cloudType: 'aws';
    role: 'MEADOW_SURVEY_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'MEADOW_SURVEY_USER';
    privateKeyVaultReference: 'meadow-survey-private-key';
    passPhraseVaultReference: 'meadow-survey-pass-phrase';
  };
}
