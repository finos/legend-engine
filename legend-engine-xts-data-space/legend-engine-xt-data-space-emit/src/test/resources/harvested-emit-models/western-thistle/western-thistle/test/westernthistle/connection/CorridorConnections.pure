###Connection
RelationalDatabaseConnection test::westernthistle::connection::CorridorWarehouseConnection
{
  store: test::westernthistle::store::CorridorDB;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'EXAMPLE_CYCLE_NETWORK_DB';
    account: 'example-city-account';
    warehouse: 'EXAMPLE_CYCLE_NETWORK_WH';
    region: 'us-east-1.aws';
  };
  auth: OAuth
  {
    oauthKey: 'examplecyclenetworkkey';
    scopeName: 'SESSION:ROLE:PUBLIC';
  };
}

###Connection
RelationalDatabaseConnection test::westernthistle::connection::CorridorH2Connection
{
  store: test::westernthistle::store::CorridorDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists network;',
      'create schema network;',
      'create table network.cycle_corridor (corridor_code varchar(24) primary key, corridor_name varchar(120) not null, surface_grade varchar(24) not null, length_km double not null, lit_flag boolean not null, opened_on date not null, last_audited_at timestamp);',
      'create table network.stop_shelter (shelter_code varchar(24) primary key, corridor_code varchar(24) not null, seat_count integer not null, sheltered_flag boolean not null, installed_on date not null);',
      'create table network.count_station (station_code varchar(24) primary key, corridor_code varchar(24) not null, daily_average integer not null, last_reading_at timestamp);'
      ];
  };
  auth: DefaultH2;
}
