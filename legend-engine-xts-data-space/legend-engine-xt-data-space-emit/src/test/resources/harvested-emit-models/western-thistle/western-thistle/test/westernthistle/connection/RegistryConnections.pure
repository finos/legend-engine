###Connection
RelationalDatabaseConnection test::westernthistle::connection::RegistryWarehouseConnection
{
  store: test::westernthistle::store::RegistryDB;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'EXAMPLE_CYCLE_REGISTRY_DB';
    account: 'example-city-account';
    warehouse: 'EXAMPLE_CYCLE_REGISTRY_WH';
    region: 'us-east-1.aws';
  };
  auth: OAuth
  {
    oauthKey: 'examplecycleregistrykey';
    scopeName: 'SESSION:ROLE:PUBLIC';
  };
}

###Connection
RelationalDatabaseConnection test::westernthistle::connection::RegistryH2Connection
{
  store: test::westernthistle::store::RegistryDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists registry;',
      'create schema registry;',
      'create table registry.maintenance_crew (crew_code varchar(24) primary key, crew_name varchar(120) not null, depot_name varchar(120) not null, headcount integer not null, on_call_flag boolean not null, commissioned_on date not null);',
      'create table registry.surface_type (grade_code varchar(24) primary key, grade_description varchar(200) not null, resurface_interval_years integer not null, reviewed_on date not null);'
      ];
  };
  auth: DefaultH2;
}
