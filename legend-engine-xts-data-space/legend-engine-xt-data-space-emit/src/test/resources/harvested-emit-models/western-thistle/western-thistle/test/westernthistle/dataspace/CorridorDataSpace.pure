###DataSpace
DataSpace test::westernthistle::dataspace::CorridorDataSpace
{
  executionContexts:
  [
    {
      name: 'reference';
      description: 'Reference tier reading the corridor, shelter and count station tables through the local test connection.';
      mapping: test::westernthistle::mapping::CorridorMapping;
      defaultRuntime: test::westernthistle::runtime::CorridorRuntime;
    },
    {
      name: 'warehouse';
      description: 'Warehouse tier reading the same corridor tables through the governed analytics warehouse.';
      mapping: test::westernthistle::mapping::CorridorMapping;
      defaultRuntime: test::westernthistle::runtime::CorridorWarehouseRuntime;
    }
  ];
  defaultExecutionContext: 'reference';
  title: 'City Cycle Corridor Network';
  description: 'A governed entry point over the signed cycling corridors, their waiting shelters and their automatic count stations.';
  elements:
  [
    test::westernthistle::domain
  ];
  executables:
  [
    {
      id: 1;
      title: 'Corridor inventory';
      description: 'Featured endpoint listing corridors at or above a requested length.';
      executable: test::westernthistle::service::CorridorInventory;
    },
    {
      id: 2;
      title: 'Shelter audit';
      description: 'Featured endpoint auditing the shelters of one corridor.';
      executable: test::westernthistle::service::ShelterAudit;
    }
  ];
  supportInfo: Email
  {
    address: 'cycle-network-planning@example.invalid';
  };
}
