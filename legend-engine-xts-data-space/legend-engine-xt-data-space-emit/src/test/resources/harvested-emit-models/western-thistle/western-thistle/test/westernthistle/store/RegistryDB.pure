###Relational
Database test::westernthistle::store::RegistryDB
(
  Schema registry
  (
    Table maintenance_crew
    (
      crew_code VARCHAR(24) PRIMARY KEY,
      crew_name VARCHAR(120) NOT NULL,
      depot_name VARCHAR(120) NOT NULL,
      headcount INTEGER NOT NULL,
      on_call_flag BIT NOT NULL,
      commissioned_on DATE NOT NULL
    )
    Table surface_type
    (
      grade_code VARCHAR(24) PRIMARY KEY,
      grade_description VARCHAR(200) NOT NULL,
      resurface_interval_years INTEGER NOT NULL,
      reviewed_on DATE NOT NULL
    )
  )
)
