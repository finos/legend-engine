###Service
Service test::westernthistle::service::ShelterAudit
{
  pattern: '/westernthistle/shelter/{corridorCode}';
  title: 'Corridor Shelter Audit';
  owners:
  [
    'cycle-network-planning'
  ];
  documentation: 'Audits the waiting shelters recorded against one corridor, reporting seat capacity and whether each stop is roofed.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {corridorCode: String[1]|test::westernthistle::domain::StopShelter.all()->filter(
      s|($s.corridorCode == $corridorCode) && ($s.seatCount > 0)
    )->project(
      [
        s|$s.shelterCode,
        s|$s.seatCount,
        s|if($s.sheltered, |'ROOFED', |'OPEN'),
        s|$s.installedOn
      ],
      [
        'ShelterCode',
        'SeatCount',
        'Cover',
        'InstalledOn'
      ]
    )->sort([asc('ShelterCode')])};
    mapping: test::westernthistle::mapping::CorridorMapping;
    runtime: test::westernthistle::runtime::CorridorRuntime;
  }
  testSuites:
  [
    shelterAuditSuite:
    {
      data:
      [
        connections:
        [
          corridorH2Connection:
            Relational
            #{
                network.stop_shelter:
                  'shelter_code,corridor_code,seat_count,sheltered_flag,installed_on\n'+
                  'SH-01,CC-01,4,true,2022-06-01\n'+
                  'SH-02,CC-01,0,false,2023-01-20\n'+
                  'SH-03,CC-02,2,false,2020-09-12\n';
            }#
        ]
      ]
      tests:
      [
        roofedShelterOnly:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            corridorCode = 'CC-01'
          ]
          asserts:
          [
            seatedShelter:
              EqualToJson
              #{
                expected: ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"ShelterCode":"SH-01","SeatCount":4,"Cover":"ROOFED","InstalledOn":"2022-06-01"}]';
                  }#;
              }#
          ]
        },
        openShelter:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            corridorCode = 'CC-02'
          ]
          asserts:
          [
            uncoveredShelter:
              EqualToJson
              #{
                expected: ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"ShelterCode":"SH-03","SeatCount":2,"Cover":"OPEN","InstalledOn":"2020-09-12"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
