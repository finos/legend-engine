###DataSpace
DataSpace {meta::pure::profiles::doc.doc = 'A curated entry point over the hardy-plant propagation model.'} demo::jadewillow::dataspace::NurseryDataSpace
{
  executionContexts:
  [
    {
      name: 'dev';
      description: 'Development tier over the propagation store.';
      mapping: demo::jadewillow::mapping::NurseryMapping;
      defaultRuntime: demo::jadewillow::runtime::NurseryRuntime;
    }
  ];
  defaultExecutionContext: 'dev';
  title: 'Hardy Plant Propagation';
  description: 'Publishes the propagation record of a hardy-plant nursery: bed labels, substrates, establishment dates and bed areas alongside the cutting batches struck in them, with batch references, cultivars, cutting counts, rooted fractions and potting timestamps. Every non-key attribute is optional, so consumers must tolerate missing values in each projected column. The substrate endpoint is the featured executable and the layout element is the consumer-facing overview.';
  diagrams:
  [
    {
      title: 'Propagation Bed Overview';
      diagram: demo::jadewillow::diagram::NurseryDiagram;
    }
  ];
  elements:
  [
    demo::jadewillow::domain
  ];
  executables:
  [
    {
      id: 1;
      title: 'Batches by substrate';
      description: 'The substrate-parameterised batch projection published as an executable of this entry point.';
      executable: demo::jadewillow::service::BatchesBySubstrateService;
      executionContextKey: 'dev';
    }
  ];
  supportInfo: Email
  {
    address: 'nursery-propagation@example.com';
  };
}
