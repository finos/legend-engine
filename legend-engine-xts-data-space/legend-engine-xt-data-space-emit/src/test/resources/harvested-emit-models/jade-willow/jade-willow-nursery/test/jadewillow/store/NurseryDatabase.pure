###Relational
Database demo::jadewillow::store::NurseryDB
(
  Schema nursery
  (
    Table nursery_bed
    (
      bed_id INTEGER PRIMARY KEY,
      bed_label VARCHAR(120),
      substrate VARCHAR(60),
      established_on DATE,
      bed_area_m2 DOUBLE
    )
    Table cutting_batch
    (
      batch_id INTEGER PRIMARY KEY,
      batch_ref VARCHAR(40),
      cultivar VARCHAR(120),
      cutting_count INTEGER,
      rooted_fraction DOUBLE,
      collected_on DATE,
      potted_at TIMESTAMP,
      bed_id INTEGER
    )
  )

  Join Batch_Bed(nursery.cutting_batch.bed_id = nursery.nursery_bed.bed_id)
)
