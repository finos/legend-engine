###Service
Service demo::jadewillow::service::BatchesBySubstrateService
{
  pattern: '/jadewillow/v1/batches/{substrate}';
  owners:
  [
    'nursery-propagation'
  ];
  documentation: 'Projects the cutting batches struck in beds using a caller-supplied propagation substrate, resolving the bed attributes through the declared join.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {substrate: String[1]|demo::jadewillow::domain::CuttingBatch.all()->filter(
      b|$b.bed.substrate == $substrate
    )->project(
      [
        x|$x.batchRef,
        x|$x.cultivar,
        x|$x.bed.bedLabel
      ],
      [
        'Batch',
        'Cultivar',
        'Bed'
      ]
    )->sort([asc('Batch')])};
    mapping: demo::jadewillow::mapping::NurseryMapping;
    runtime: demo::jadewillow::runtime::NurseryRuntime;
  }
  testSuites:
  [
    substrateSelectionSuite:
    {
      data:
      [
        connections:
        [
          connection_1:
            Relational
            #{
              nursery.nursery_bed:
                'bed_id,bed_label,substrate,established_on,bed_area_m2\n'+
                '1,Willow Row A,coir,2021-03-14,18.5\n'+
                '2,Hazel Row B,perlite,2022-07-01,12.25\n';

              nursery.cutting_batch:
                'batch_id,batch_ref,cultivar,cutting_count,rooted_fraction,collected_on,potted_at,bed_id\n'+
                '1,CB-001,Salix alba,240,0.75,2024-02-11,2024-04-02 08:30:00,1\n'+
                '2,CB-002,Corylus avellana,180,0.5,2024-03-05,2024-05-10 07:45:00,2\n'+
                '3,CB-003,Salix purpurea,90,0.6,2024-03-18,2024-05-21 09:05:00,1\n';
            }#
        ]
      ]
      tests:
      [
        batchesInMatchingSubstrate:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            substrate = 'coir'
          ]
          asserts:
          [
            onlyCoirBedBatches:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Batch":"CB-001","Cultivar":"Salix alba","Bed":"Willow Row A"},{"Batch":"CB-003","Cultivar":"Salix purpurea","Bed":"Willow Row A"}]';
                  }#;
              }#
          ]
        },
        noBatchesForUnusedSubstrate:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            substrate = 'vermiculite'
          ]
          asserts:
          [
            emptyResultForUnusedSubstrate:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
