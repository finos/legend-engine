import demo::jadewillow::domain::*;

Class {meta::pure::profiles::doc.doc = 'A propagation bed inside a hardy-plant nursery.'} demo::jadewillow::domain::NurseryBed
{
  bedLabel: String[0..1];
  substrate: String[0..1];
  establishedOn: StrictDate[0..1];
  bedAreaM2: Float[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A batch of cuttings struck in a propagation bed.'} demo::jadewillow::domain::CuttingBatch
{
  batchRef: String[0..1];
  cultivar: String[0..1];
  cuttingCount: Integer[0..1];
  rootedFraction: Float[0..1];
  collectedOn: StrictDate[0..1];
  pottedAt: DateTime[0..1];
  bed: NurseryBed[0..1];
}
