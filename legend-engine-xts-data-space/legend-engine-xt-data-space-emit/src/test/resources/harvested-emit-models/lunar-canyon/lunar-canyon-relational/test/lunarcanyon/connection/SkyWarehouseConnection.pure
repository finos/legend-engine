###Connection
RelationalDatabaseConnection test::lunarcanyon::connection::SkyWarehouseConnection
{
  store: test::lunarcanyon::store::SkyDB;
  type: Snowflake;
  timezone: 'UTC';
  quoteIdentifiers: true;
  specification: Snowflake
  {
    name: 'SKY_LOG_DB';
    account: 'hill_observatory_account';
    warehouse: 'SKY_LOG_WH';
    region: 'eu-west-2';
    cloudType: 'aws';
    accountType: MultiTenant;
    organization: 'hill_observatory_org';
    role: 'SKY_LOG_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'SKY_LOG_USER';
    privateKeyVaultReference: 'sky-log-private-key';
    passPhraseVaultReference: 'sky-log-pass-phrase';
  };
}
