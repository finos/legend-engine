###Relational
Database test::lunarcanyon::store::SkyDB
(
  Schema sky
  (
    Table sky_session
    (
      session_code VARCHAR(24) PRIMARY KEY,
      telescope_code VARCHAR(24),
      observer_code VARCHAR(24),
      observed_on DATE NOT NULL,
      started_at TIMESTAMP,
      catalogue_code VARCHAR(24) NOT NULL,
      seeing_index FLOAT,
      exposure_count INTEGER NOT NULL,
      filter_code VARCHAR(24),
      log_note VARCHAR(200)
    )

    Table telescope
    (
      telescope_code VARCHAR(24) PRIMARY KEY,
      telescope_name VARCHAR(80),
      mirror_cm FLOAT,
      mount_kind VARCHAR(24),
      dome_code VARCHAR(24)
    )

    Table observer
    (
      observer_code VARCHAR(24) PRIMARY KEY,
      observer_name VARCHAR(80),
      certifications VARCHAR(120),
      home_site VARCHAR(80)
    )
  )

  Join Session_Telescope_J(sky.sky_session.telescope_code = sky.telescope.telescope_code)
  Join Session_Observer_J(sky.sky_session.observer_code = sky.observer.observer_code)
)
