###DataSpace
DataSpace test::lunarcanyon::dataspace::SkyDataSpace
{
  executionContexts:
  [
    {
      name: 'skyLog';
      description: 'Sky log environment - the session binding served through the observatory warehouse.';
      mapping: test::lunarcanyon::mapping::SkyMapping;
      defaultRuntime: test::lunarcanyon::runtime::SkyRuntime;
    }
  ];
  defaultExecutionContext: 'skyLog';
  title: 'Lunar Canyon Observing Log';
  description: 'Discovery surface over the hill observatory observing log: the session records with the instruments they were booked on and the observers who filed them.';
  elements:
  [
    test::lunarcanyon::domain::Observer,
    test::lunarcanyon::domain::SkySession,
    test::lunarcanyon::domain::Telescope
  ];
  executables:
  [
    {
      id: 1;
      title: 'Catalogue Session Window';
      description: 'The catalogue membership and date window query with its recorded-filter requirement.';
      executable: test::lunarcanyon::service::SessionWindowService;
    },
    {
      id: 2;
      title: 'Sessions By Observer Certification';
      description: 'The certification existence query with its exposure floor, ordering and row cap.';
      executable: test::lunarcanyon::service::SessionCertificationService;
    }
  ];
}
