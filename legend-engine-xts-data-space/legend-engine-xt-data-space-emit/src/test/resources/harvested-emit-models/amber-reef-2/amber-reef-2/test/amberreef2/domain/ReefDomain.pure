Class {meta::pure::profiles::doc.doc = 'A monitored snorkel-trail site on a fringing reef.'} test::amberreef2::domain::ReefSite
{
  siteCode: String[1];
  siteName: String[1];
  zoneCode: String[0..1];
  depthRangeMeters: Float[0..1];
  markerTags: String[*];
}

Class {meta::pure::profiles::doc.doc = 'A habitat zone grouping reef sites that share substrate and exposure.'} test::amberreef2::domain::HabitatZone
{
  zoneCode: String[1];
  zoneName: String[1];
  substrateKind: String[0..1];
  exposureRating: Integer[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A single monitoring dive carried out along a reef trail on a given day.'} test::amberreef2::domain::SurveyDive
{
  diveCode: String[1];
  siteCode: String[1];
  divedOn: StrictDate[0..1];
  visibilityMeters: Float[0..1];
  observerCodes: String[*];
}

Class {meta::pure::profiles::doc.doc = 'A coral colony recorded during a monitoring dive, with its measured extent.'} test::amberreef2::domain::CoralColony
{
  colonyCode: String[1];
  diveCode: String[1];
  speciesTag: String[0..1];
  diameterCm: Float[0..1];
  bleachedPortion: Float[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A named observer team qualified to run reef monitoring dives.'} test::amberreef2::domain::ObserverTeam
{
  teamCode: String[1];
  teamName: String[1];
  memberCodes: String[*];
}

Class {meta::pure::profiles::doc.doc = 'A controlled species label applied to recorded colonies.'} test::amberreef2::domain::SpeciesTag
{
  speciesTag: String[1];
  commonName: String[1];
  growthForm: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'An inbound dive log line as received from a field recorder.'} test::amberreef2::source::IncomingDiveLog
{
  code: String[1];
  site: String[1];
  loggedOn: StrictDate[0..1];
  visibility: Float[0..1];
}
