###DataSpace
DataSpace test::amberreef2::dataspace::ReefTrailDataSpace
{
  executionContexts:
  [
    {
      name: 'monitoring';
      description: 'Monitoring environment - inbound dive logs projected onto the survey dive class.';
      mapping: test::amberreef2::mapping::ReefDiveM2M;
      defaultRuntime: test::amberreef2::runtime::ReefDiveRuntime;
    }
  ];
  defaultExecutionContext: 'monitoring';
  title: 'Amber Reef Trail Monitoring';
  description: 'Discovery surface over the reef trail monitoring register: trail sites, habitat zones, monitoring dives and the colonies recorded on them.';
  elements:
  [
    test::amberreef2::domain::CoralColony,
    test::amberreef2::domain::HabitatZone,
    test::amberreef2::domain::ObserverTeam,
    test::amberreef2::domain::ReefSite,
    test::amberreef2::domain::SpeciesTag,
    test::amberreef2::domain::SurveyDive
  ];
  supportInfo: Email
  {
    address: 'reef-trail-desk@reefmonitoring.invalid';
  };
}
