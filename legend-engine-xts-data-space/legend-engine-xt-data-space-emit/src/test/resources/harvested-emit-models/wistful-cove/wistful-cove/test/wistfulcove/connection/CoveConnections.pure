###Connection
RelationalDatabaseConnection test::wistfulcove::connection::CoveWarehouseConnection
{
  store: test::wistfulcove::store::CoveDB;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'EXAMPLE_COVE_DB';
    account: 'example_cove_account';
    warehouse: 'EXAMPLE_COVE_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    accountType: MultiTenant;
    organization: 'example_cove_org';
    role: 'MOORING_SURVEY_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'EXAMPLE_COVE_USER';
    privateKeyVaultReference: 'example-cove-private-key';
    passPhraseVaultReference: 'example-cove-pass-phrase';
  };
}
