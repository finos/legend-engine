###Connection
RelationalDatabaseConnection test::wistfulcove::connection::CoveH2Connection
{
  store: test::wistfulcove::store::CoveDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists cove;',
      'drop schema if exists archive;',
      'create schema cove;',
      'create schema archive;',
      'create table cove.mooring_record (record_id integer not null, mooring_code varchar(24) not null, cove_code varchar(24) not null, grade_code varchar(8) not null, hull_length_m double not null, beam_width_m double not null, line_count integer not null, surveyed_on date not null, in_z date not null, out_z date, primary key (record_id, in_z));',
      'create table cove.cove_site (site_id integer not null, cove_code varchar(24) not null, cove_name varchar(120) not null, shore_code varchar(24) not null, in_z date not null, out_z date, primary key (site_id, in_z));',
      'create table cove.shore_zone (zone_id integer not null, shore_code varchar(24) not null, zone_name varchar(120) not null, in_z date not null, out_z date, primary key (zone_id, in_z));',
      'create table archive.survey_note (note_id integer not null, mooring_code varchar(24) not null, cove_code varchar(24) not null, note_text varchar(200) not null, in_z date not null, out_z date, primary key (note_id, in_z));',
      'create table archive.tender_run (run_id integer not null, mooring_code varchar(24) not null, cove_code varchar(24) not null, tender_code varchar(24) not null, trip_count integer not null, in_z date not null, out_z date, primary key (run_id, in_z));'
      ];
  };
  auth: DefaultH2
  {
  };
}

