###Service
Service test::wistfulcove::service::SiteTenderRosterAsOf
{
  pattern: '/wistfulcove/v1/siteTenderRoster/{asOf}';
  title: 'Wistful Cove - Site Tender Roster As Of';
  ownership: UserList { users: ['cove-mooring-survey', 'shore-patrol-office'] };
  documentation: 'Maps element-wise over the tender runs reached from each cove site and reaches the shore zone through the included mapping, so the collection end fans the site out to one row per visible run.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {asOf: StrictDate[1]|test::wistfulcove::domain::CoveSite.all($asOf)->project(
      [
        s|$s.coveName,
        s|$s.shore.zoneName,
        s|$s.siteTenderRuns->map(t|$t.tenderCode),
        s|$s.siteTenderRuns->map(t|$t.tripCount)
      ],
      [
        'Cove Name',
        'Shore Zone',
        'Tender Code',
        'Trip Count'
      ]
    )->sort(
      [
        asc('Cove Name'),
        asc('Tender Code')
      ]
    )};
    mapping: test::wistfulcove::mapping::CoveSurveyMapping;
    runtime: test::wistfulcove::runtime::CoveSurveyRuntime;
  }
  testSuites:
  [
    siteTenderRosterAsOfSuite:
    {
      data:
      [
        connections:
        [
          coveH2:
            Relational
            #{
      cove.mooring_record:
        'record_id,mooring_code,cove_code,grade_code,hull_length_m,beam_width_m,line_count,surveyed_on,in_z,out_z\n'+
        '1,M-01,C-1,G1,10.0,3.0,4,2026-01-05,2026-01-01,9999-12-31\n'+
        '2,M-02,C-1,G2,12.5,3.5,3,2026-01-06,2026-01-01,9999-12-31\n'+
        '3,M-03,C-1,G3,8.0,2.5,2,2026-01-07,2026-01-01,9999-12-31\n'+
        '4,M-04,C-2,G4,15.0,4.0,5,2026-01-08,2026-01-01,9999-12-31\n'+
        '5,M-05,C-2,G5,9.5,3.0,1,2026-01-09,2026-01-01,9999-12-31\n'+
        '6,M-06,C-2,G6,11.0,3.5,2,2026-01-10,2026-01-01,9999-12-31\n'+
        '7,M-07,C-3,G7,14.0,4.5,6,2026-01-11,2026-01-01,9999-12-31\n'+
        '8,M-08,C-3,G8,13.0,4.0,3,2026-01-12,2026-01-01,9999-12-31\n'+
        '9,M-09,C-3,G8,7.0,2.0,1,2026-01-13,2026-01-01,9999-12-31\n'+
        '10,M-10,C-1,GX,6.0,2.0,2,2026-01-14,2026-01-01,9999-12-31\n'+
        '11,M-11,C-1,G1,5.0,2.0,2,2026-01-15,2026-01-01,2026-02-01\n';

      cove.cove_site:
        'site_id,cove_code,cove_name,shore_code,in_z,out_z\n'+
        '1,C-1,Kittiwake Cove,S-N,2026-01-01,9999-12-31\n'+
        '2,C-2,Fulmar Cove,S-N,2026-01-01,9999-12-31\n'+
        '3,C-3,Petrel Cove,S-S,2026-01-01,9999-12-31\n';

      cove.shore_zone:
        'zone_id,shore_code,zone_name,in_z,out_z\n'+
        '1,S-N,North Shore,2026-01-01,9999-12-31\n'+
        '2,S-S,South Shore,2026-01-01,9999-12-31\n';

      archive.survey_note:
        'note_id,mooring_code,cove_code,note_text,in_z,out_z\n'+
        '1,M-01,C-1,Fenders replaced,2026-01-01,9999-12-31\n'+
        '2,M-04,C-2,Chain re-shackled,2026-01-01,9999-12-31\n'+
        '3,M-07,C-3,Line re-spliced,2026-01-01,9999-12-31\n'+
        '4,M-01,C-1,Superseded inspection remark,2026-01-01,2026-02-01\n';

      archive.tender_run:
        'run_id,mooring_code,cove_code,tender_code,trip_count,in_z,out_z\n'+
        '1,M-01,C-1,T-1,4,2026-01-01,9999-12-31\n'+
        '2,M-01,C-1,T-2,2,2026-01-01,9999-12-31\n'+
        '3,M-04,C-2,T-3,1,2026-01-01,9999-12-31\n'+
        '4,M-07,C-3,T-4,5,2026-01-01,9999-12-31\n'+
        '5,M-04,C-2,T-9,7,2026-01-01,2026-02-01\n';
            }#,
          referenceH2:
            Relational
            #{
      reference.grade_band:
        'band_id,grade_code,band_name,in_z,out_z\n'+
        '1,G1,Sheltered Inner Berth,2026-01-01,9999-12-31\n'+
        '2,G2,Sheltered Outer Berth,2026-01-01,9999-12-31\n'+
        '3,G3,Exposed Inner Berth,2026-01-01,9999-12-31\n'+
        '4,G8,Deep Water Berth,2026-01-01,9999-12-31\n'+
        '5,G9,Withdrawn Berth Class,2026-01-01,2026-02-01\n';
            }#,
          patrolH2:
            Relational
            #{
      patrol.patrol_log:
        'log_id,shore_code,patrol_code,sweep_count,in_z,out_z\n'+
        '1,S-N,P-1,3,2026-01-01,9999-12-31\n'+
        '2,S-S,P-2,5,2026-01-01,9999-12-31\n'+
        '3,S-N,P-9,1,2026-01-01,2026-02-01\n';
            }#
        ]
      ]
      tests:
      [
        fanOutPerVisibleRun:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            asOf = %2026-04-01
          ]
          asserts:
          [
            rosterRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Cove Name":"Fulmar Cove","Shore Zone":"North Shore","Tender Code":"T-3","Trip Count":1},{"Cove Name":"Kittiwake Cove","Shore Zone":"North Shore","Tender Code":"T-1","Trip Count":4},{"Cove Name":"Kittiwake Cove","Shore Zone":"North Shore","Tender Code":"T-2","Trip Count":2},{"Cove Name":"Petrel Cove","Shore Zone":"South Shore","Tender Code":"T-4","Trip Count":5}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service test::wistfulcove::service::GradeBandCatalogueAsOf
{
  pattern: '/wistfulcove/v1/gradeBands/{asOf}';
  title: 'Wistful Cove - Grade Band Catalogue As Of';
  ownership: UserList { users: ['cove-mooring-survey', 'shore-patrol-office'] };
  documentation: 'Reads the reference store bound by the included mapping at the requested instant, so a withdrawn berth class is absent from the catalogue while the survey services keep resolving against the cove store.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {asOf: StrictDate[1]|test::wistfulcove::domain::GradeBand.all($asOf)->project(
      [
        g|$g.gradeCode,
        g|$g.bandName
      ],
      [
        'Grade Code',
        'Band Name'
      ]
    )->sort(
      [
        asc('Grade Code')
      ]
    )};
    mapping: test::wistfulcove::mapping::CoveSurveyMapping;
    runtime: test::wistfulcove::runtime::CoveSurveyRuntime;
  }
  testSuites:
  [
    gradeBandCatalogueAsOfSuite:
    {
      data:
      [
        connections:
        [
          coveH2:
            Relational
            #{
      cove.mooring_record:
        'record_id,mooring_code,cove_code,grade_code,hull_length_m,beam_width_m,line_count,surveyed_on,in_z,out_z\n'+
        '1,M-01,C-1,G1,10.0,3.0,4,2026-01-05,2026-01-01,9999-12-31\n'+
        '2,M-02,C-1,G2,12.5,3.5,3,2026-01-06,2026-01-01,9999-12-31\n'+
        '3,M-03,C-1,G3,8.0,2.5,2,2026-01-07,2026-01-01,9999-12-31\n'+
        '4,M-04,C-2,G4,15.0,4.0,5,2026-01-08,2026-01-01,9999-12-31\n'+
        '5,M-05,C-2,G5,9.5,3.0,1,2026-01-09,2026-01-01,9999-12-31\n'+
        '6,M-06,C-2,G6,11.0,3.5,2,2026-01-10,2026-01-01,9999-12-31\n'+
        '7,M-07,C-3,G7,14.0,4.5,6,2026-01-11,2026-01-01,9999-12-31\n'+
        '8,M-08,C-3,G8,13.0,4.0,3,2026-01-12,2026-01-01,9999-12-31\n'+
        '9,M-09,C-3,G8,7.0,2.0,1,2026-01-13,2026-01-01,9999-12-31\n'+
        '10,M-10,C-1,GX,6.0,2.0,2,2026-01-14,2026-01-01,9999-12-31\n'+
        '11,M-11,C-1,G1,5.0,2.0,2,2026-01-15,2026-01-01,2026-02-01\n';

      cove.cove_site:
        'site_id,cove_code,cove_name,shore_code,in_z,out_z\n'+
        '1,C-1,Kittiwake Cove,S-N,2026-01-01,9999-12-31\n'+
        '2,C-2,Fulmar Cove,S-N,2026-01-01,9999-12-31\n'+
        '3,C-3,Petrel Cove,S-S,2026-01-01,9999-12-31\n';

      cove.shore_zone:
        'zone_id,shore_code,zone_name,in_z,out_z\n'+
        '1,S-N,North Shore,2026-01-01,9999-12-31\n'+
        '2,S-S,South Shore,2026-01-01,9999-12-31\n';

      archive.survey_note:
        'note_id,mooring_code,cove_code,note_text,in_z,out_z\n'+
        '1,M-01,C-1,Fenders replaced,2026-01-01,9999-12-31\n'+
        '2,M-04,C-2,Chain re-shackled,2026-01-01,9999-12-31\n'+
        '3,M-07,C-3,Line re-spliced,2026-01-01,9999-12-31\n'+
        '4,M-01,C-1,Superseded inspection remark,2026-01-01,2026-02-01\n';

      archive.tender_run:
        'run_id,mooring_code,cove_code,tender_code,trip_count,in_z,out_z\n'+
        '1,M-01,C-1,T-1,4,2026-01-01,9999-12-31\n'+
        '2,M-01,C-1,T-2,2,2026-01-01,9999-12-31\n'+
        '3,M-04,C-2,T-3,1,2026-01-01,9999-12-31\n'+
        '4,M-07,C-3,T-4,5,2026-01-01,9999-12-31\n'+
        '5,M-04,C-2,T-9,7,2026-01-01,2026-02-01\n';
            }#,
          referenceH2:
            Relational
            #{
      reference.grade_band:
        'band_id,grade_code,band_name,in_z,out_z\n'+
        '1,G1,Sheltered Inner Berth,2026-01-01,9999-12-31\n'+
        '2,G2,Sheltered Outer Berth,2026-01-01,9999-12-31\n'+
        '3,G3,Exposed Inner Berth,2026-01-01,9999-12-31\n'+
        '4,G8,Deep Water Berth,2026-01-01,9999-12-31\n'+
        '5,G9,Withdrawn Berth Class,2026-01-01,2026-02-01\n';
            }#,
          patrolH2:
            Relational
            #{
      patrol.patrol_log:
        'log_id,shore_code,patrol_code,sweep_count,in_z,out_z\n'+
        '1,S-N,P-1,3,2026-01-01,9999-12-31\n'+
        '2,S-S,P-2,5,2026-01-01,9999-12-31\n'+
        '3,S-N,P-9,1,2026-01-01,2026-02-01\n';
            }#
        ]
      ]
      tests:
      [
        withdrawnClassExcluded:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            asOf = %2026-04-01
          ]
          asserts:
          [
            bandRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Grade Code":"G1","Band Name":"Sheltered Inner Berth"},{"Grade Code":"G2","Band Name":"Sheltered Outer Berth"},{"Grade Code":"G3","Band Name":"Exposed Inner Berth"},{"Grade Code":"G8","Band Name":"Deep Water Berth"}]';
                  }#;
              }#
          ]
        },
        earlierInstantKeepsWithdrawnClass:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            asOf = %2026-01-15
          ]
          asserts:
          [
            allBandRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Grade Code":"G1","Band Name":"Sheltered Inner Berth"},{"Grade Code":"G2","Band Name":"Sheltered Outer Berth"},{"Grade Code":"G3","Band Name":"Exposed Inner Berth"},{"Grade Code":"G8","Band Name":"Deep Water Berth"},{"Grade Code":"G9","Band Name":"Withdrawn Berth Class"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service test::wistfulcove::service::ShorePatrolAsOf
{
  pattern: '/wistfulcove/v1/shorePatrol/{asOf}';
  title: 'Wistful Cove - Shore Patrol Log As Of';
  ownership: UserList { users: ['cove-mooring-survey', 'shore-patrol-office'] };
  documentation: 'Reads the third store bound by the included mapping at the requested instant, so the patrol sweeps recorded against each shore are visible independently of the mooring surface.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {asOf: StrictDate[1], minSweeps: Integer[1]|test::wistfulcove::domain::PatrolLog.all($asOf)->filter(
      p|$p.sweepCount >= $minSweeps
    )->project(
      [
        p|$p.shoreCode,
        p|$p.patrolCode,
        p|$p.sweepCount
      ],
      [
        'Shore Code',
        'Patrol Code',
        'Sweep Count'
      ]
    )->sort(
      [
        asc('Patrol Code')
      ]
    )};
    mapping: test::wistfulcove::mapping::CoveSurveyMapping;
    runtime: test::wistfulcove::runtime::CoveSurveyRuntime;
  }
  testSuites:
  [
    shorePatrolAsOfSuite:
    {
      data:
      [
        connections:
        [
          coveH2:
            Relational
            #{
      cove.mooring_record:
        'record_id,mooring_code,cove_code,grade_code,hull_length_m,beam_width_m,line_count,surveyed_on,in_z,out_z\n'+
        '1,M-01,C-1,G1,10.0,3.0,4,2026-01-05,2026-01-01,9999-12-31\n'+
        '2,M-02,C-1,G2,12.5,3.5,3,2026-01-06,2026-01-01,9999-12-31\n'+
        '3,M-03,C-1,G3,8.0,2.5,2,2026-01-07,2026-01-01,9999-12-31\n'+
        '4,M-04,C-2,G4,15.0,4.0,5,2026-01-08,2026-01-01,9999-12-31\n'+
        '5,M-05,C-2,G5,9.5,3.0,1,2026-01-09,2026-01-01,9999-12-31\n'+
        '6,M-06,C-2,G6,11.0,3.5,2,2026-01-10,2026-01-01,9999-12-31\n'+
        '7,M-07,C-3,G7,14.0,4.5,6,2026-01-11,2026-01-01,9999-12-31\n'+
        '8,M-08,C-3,G8,13.0,4.0,3,2026-01-12,2026-01-01,9999-12-31\n'+
        '9,M-09,C-3,G8,7.0,2.0,1,2026-01-13,2026-01-01,9999-12-31\n'+
        '10,M-10,C-1,GX,6.0,2.0,2,2026-01-14,2026-01-01,9999-12-31\n'+
        '11,M-11,C-1,G1,5.0,2.0,2,2026-01-15,2026-01-01,2026-02-01\n';

      cove.cove_site:
        'site_id,cove_code,cove_name,shore_code,in_z,out_z\n'+
        '1,C-1,Kittiwake Cove,S-N,2026-01-01,9999-12-31\n'+
        '2,C-2,Fulmar Cove,S-N,2026-01-01,9999-12-31\n'+
        '3,C-3,Petrel Cove,S-S,2026-01-01,9999-12-31\n';

      cove.shore_zone:
        'zone_id,shore_code,zone_name,in_z,out_z\n'+
        '1,S-N,North Shore,2026-01-01,9999-12-31\n'+
        '2,S-S,South Shore,2026-01-01,9999-12-31\n';

      archive.survey_note:
        'note_id,mooring_code,cove_code,note_text,in_z,out_z\n'+
        '1,M-01,C-1,Fenders replaced,2026-01-01,9999-12-31\n'+
        '2,M-04,C-2,Chain re-shackled,2026-01-01,9999-12-31\n'+
        '3,M-07,C-3,Line re-spliced,2026-01-01,9999-12-31\n'+
        '4,M-01,C-1,Superseded inspection remark,2026-01-01,2026-02-01\n';

      archive.tender_run:
        'run_id,mooring_code,cove_code,tender_code,trip_count,in_z,out_z\n'+
        '1,M-01,C-1,T-1,4,2026-01-01,9999-12-31\n'+
        '2,M-01,C-1,T-2,2,2026-01-01,9999-12-31\n'+
        '3,M-04,C-2,T-3,1,2026-01-01,9999-12-31\n'+
        '4,M-07,C-3,T-4,5,2026-01-01,9999-12-31\n'+
        '5,M-04,C-2,T-9,7,2026-01-01,2026-02-01\n';
            }#,
          referenceH2:
            Relational
            #{
      reference.grade_band:
        'band_id,grade_code,band_name,in_z,out_z\n'+
        '1,G1,Sheltered Inner Berth,2026-01-01,9999-12-31\n'+
        '2,G2,Sheltered Outer Berth,2026-01-01,9999-12-31\n'+
        '3,G3,Exposed Inner Berth,2026-01-01,9999-12-31\n'+
        '4,G8,Deep Water Berth,2026-01-01,9999-12-31\n'+
        '5,G9,Withdrawn Berth Class,2026-01-01,2026-02-01\n';
            }#,
          patrolH2:
            Relational
            #{
      patrol.patrol_log:
        'log_id,shore_code,patrol_code,sweep_count,in_z,out_z\n'+
        '1,S-N,P-1,3,2026-01-01,9999-12-31\n'+
        '2,S-S,P-2,5,2026-01-01,9999-12-31\n'+
        '3,S-N,P-9,1,2026-01-01,2026-02-01\n';
            }#
        ]
      ]
      tests:
      [
        closedSweepExcluded:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            asOf = %2026-04-01,
            minSweeps = 1
          ]
          asserts:
          [
            patrolRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Shore Code":"S-N","Patrol Code":"P-1","Sweep Count":3},{"Shore Code":"S-S","Patrol Code":"P-2","Sweep Count":5}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
