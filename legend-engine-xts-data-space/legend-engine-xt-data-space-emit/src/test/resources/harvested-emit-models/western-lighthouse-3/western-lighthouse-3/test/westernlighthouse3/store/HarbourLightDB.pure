###Relational
Database test::westernlighthouse3::store::HarbourLightDB
(
  Schema harbour
  (
    Table navigation_light
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )
      light_code VARCHAR(24) PRIMARY KEY,
      station_code VARCHAR(24) NOT NULL,
      lamp_code VARCHAR(24) NOT NULL,
      character_code VARCHAR(32) NOT NULL,
      focal_height_m DOUBLE NOT NULL,
      range_nm DOUBLE NOT NULL,
      status_code VARCHAR(16) NOT NULL,
      last_inspected DATE NOT NULL,
      in_z DATE PRIMARY KEY,
      out_z DATE
    )
    Table lamp_unit
    (
      lamp_code VARCHAR(24) PRIMARY KEY,
      lamp_type VARCHAR(48) NOT NULL,
      wattage INTEGER NOT NULL,
      installed_on DATE NOT NULL
    )
    Table harbour_station
    (
      station_code VARCHAR(24) PRIMARY KEY,
      station_name VARCHAR(96) NOT NULL,
      coast_sector VARCHAR(48) NOT NULL
    )
  )

  Join Light_Lamp(harbour.navigation_light.lamp_code = harbour.lamp_unit.lamp_code)
  Join Light_Station(harbour.navigation_light.station_code = harbour.harbour_station.station_code)
)
