###Pure
import meta::pure::profiles::*;
import test::westernlighthouse3::domain::*;

Class <<temporal.processingtemporal>> {doc.doc = 'A fixed navigation light on the approach channel, versioned on a processing timeline as its recorded state is revised.'} test::westernlighthouse3::domain::NavigationLight
{
  lightCode: String[1];
  characterCode: String[1];
  focalHeightM: Float[1];
  rangeNm: Float[1];
  statusCode: String[1];
  lastInspected: StrictDate[1];
}

Class {doc.doc = 'A lamp assembly fitted into navigation lights, carrying its type and rated draw.'} test::westernlighthouse3::domain::LampUnit
{
  lampCode: String[1];
  lampType: String[1];
  wattage: Integer[1];
  installedOn: StrictDate[1];
}

Class {doc.doc = 'A harbour station accountable for the navigation lights on one stretch of coast.'} test::westernlighthouse3::domain::HarbourStation
{
  stationCode: String[1];
  stationName: String[1];
  coastSector: String[1];
}

Association {doc.doc = 'Relates a navigation light to the lamp assembly fitted into it.'} test::westernlighthouse3::domain::LightLamp
{
  fittedLamp: LampUnit[0..1];
  litLights: NavigationLight[*];
}

Association {doc.doc = 'Relates a navigation light to the harbour station accountable for it.'} test::westernlighthouse3::domain::StationLight
{
  homeStation: HarbourStation[0..1];
  tendedLights: NavigationLight[*];
}
