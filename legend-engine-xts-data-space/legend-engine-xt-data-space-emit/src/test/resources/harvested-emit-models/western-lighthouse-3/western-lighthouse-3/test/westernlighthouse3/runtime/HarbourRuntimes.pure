###Runtime
Runtime test::westernlighthouse3::runtime::HarbourWatchRuntime
{
  mappings:
  [
    test::westernlighthouse3::mapping::HarbourLightMapping
  ];
  connections:
  [
    test::westernlighthouse3::store::HarbourLightDB:
    [
      watch_connection: test::westernlighthouse3::connection::HarbourWatchConnection
    ]
  ];
}

Runtime test::westernlighthouse3::runtime::HarbourEngineeringRuntime
{
  mappings:
  [
    test::westernlighthouse3::mapping::HarbourLightMapping
  ];
  connections:
  [
    test::westernlighthouse3::store::HarbourLightDB:
    [
      engineering_connection: test::westernlighthouse3::connection::HarbourEngineeringConnection
    ]
  ];
}
