###Diagram
Diagram test::westernlighthouse3::diagram::HarbourLightLayout
{
  classView light-cv
  {
    class: test::westernlighthouse3::domain::NavigationLight;
    position: (140.0,140.0);
    rectangle: (280.0,180.0);
  }
  classView lamp-cv
  {
    class: test::westernlighthouse3::domain::LampUnit;
    position: (560.0,120.0);
    rectangle: (240.0,140.0);
  }
  classView station-cv
  {
    class: test::westernlighthouse3::domain::HarbourStation;
    position: (140.0,440.0);
    rectangle: (240.0,120.0);
  }
  propertyView
  {
    property: test::westernlighthouse3::domain::LightLamp.fittedLamp;
    source: light-cv;
    target: lamp-cv;
    points: [(420.0,230.0),(560.0,190.0)];
  }
  propertyView
  {
    property: test::westernlighthouse3::domain::StationLight.homeStation;
    source: light-cv;
    target: station-cv;
    points: [(280.0,320.0),(260.0,440.0)];
  }
}

Diagram test::westernlighthouse3::diagram::StationOverview
{
  classView station-only-cv
  {
    class: test::westernlighthouse3::domain::HarbourStation;
    position: (200.0,200.0);
    rectangle: (260.0,120.0);
  }
  classView tended-light-cv
  {
    class: test::westernlighthouse3::domain::NavigationLight;
    position: (600.0,200.0);
    rectangle: (280.0,180.0);
  }
  propertyView
  {
    property: test::westernlighthouse3::domain::StationLight.tendedLights;
    source: station-only-cv;
    target: tended-light-cv;
    points: [(460.0,260.0),(600.0,290.0)];
  }
}
