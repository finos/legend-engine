###DataSpace
DataSpace {meta::pure::profiles::doc.doc = 'Governed entry point over the harbour navigation-light maintenance model.'} test::westernlighthouse3::dataspace::HarbourLightDataSpace
{
  executionContexts:
  [
    {
      name: 'watch';
      description: 'Watch tier - the slice used by the light watch to plan nightly checks.';
      mapping: test::westernlighthouse3::mapping::HarbourLightMapping;
      defaultRuntime: test::westernlighthouse3::runtime::HarbourWatchRuntime;
    },
    {
      name: 'engineering';
      description: 'Engineering tier - the slice used to plan lamp refits.';
      mapping: test::westernlighthouse3::mapping::HarbourLightMapping;
      defaultRuntime: test::westernlighthouse3::runtime::HarbourEngineeringRuntime;
    }
  ];
  defaultExecutionContext: 'watch';
  title: 'Harbour Navigation Lights';
  description: 'A curated view over navigation lights, the lamps fitted into them and the harbour stations accountable for them.';
  diagrams:
  [
    {
      title: 'Light Layout';
      diagram: test::westernlighthouse3::diagram::HarbourLightLayout;
    },
    {
      title: 'Station Overview';
      diagram: test::westernlighthouse3::diagram::StationOverview;
    }
  ];
  elements:
  [
    test::westernlighthouse3::domain
  ];
  executables:
  [
    {
      id: 1;
      title: 'Watch list';
      description: 'Serviceable lights due a check.';
      executable: test::westernlighthouse3::service::LightWatchList;
    },
    {
      id: 2;
      title: 'Refit schedule';
      description: 'Lights due a lamp refit.';
      executable: test::westernlighthouse3::service::LampRefitSchedule;
    }
  ];
  supportInfo: Email {
    address: 'harbour-light-watch@example.invalid';
  };
}
