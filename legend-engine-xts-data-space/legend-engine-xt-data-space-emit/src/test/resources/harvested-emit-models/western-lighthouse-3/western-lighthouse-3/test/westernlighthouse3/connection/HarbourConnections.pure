###Connection
RelationalDatabaseConnection test::westernlighthouse3::connection::HarbourWatchConnection
{
  store: test::westernlighthouse3::store::HarbourLightDB;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'HARBOUR_LIGHT_DB';
    account: 'harbour_reference_account';
    warehouse: 'HARBOUR_WATCH_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    role: 'HARBOUR_WATCH_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'HARBOUR_WATCH_USER';
    privateKeyVaultReference: 'harbour.watch.privateKey';
    passPhraseVaultReference: 'harbour.watch.passPhrase';
  };
}

RelationalDatabaseConnection test::westernlighthouse3::connection::HarbourEngineeringConnection
{
  store: test::westernlighthouse3::store::HarbourLightDB;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'HARBOUR_LIGHT_DB';
    account: 'harbour_reference_account';
    warehouse: 'HARBOUR_ENGINEERING_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    role: 'HARBOUR_ENGINEERING_READER';
  };
  auth: OAuth
  {
    oauthKey: 'harbourEngineeringOauthKey';
    scopeName: 'session:role:HARBOUR_ENGINEERING_READER';
  };
}
