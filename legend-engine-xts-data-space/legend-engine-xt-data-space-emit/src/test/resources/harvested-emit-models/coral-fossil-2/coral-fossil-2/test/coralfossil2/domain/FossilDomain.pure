###Pure
Class {meta::pure::profiles::doc.doc = 'One row per dig site per survey date: the surveyed reef-terrace exposure and its stratum.'} test::coralfossil2::domain::DigSite
{
  siteCode: String[1];
  surveyDate: StrictDate[1];
  siteName: String[1];
  stratumLabel: String[1];
  depthM: Float[1];
  recordedAt: DateTime[1];
}

Class {meta::pure::profiles::doc.doc = 'One row per catalogued fossil specimen per survey date.'} test::coralfossil2::domain::Specimen
{
  specimenRef: String[1];
  surveyDate: StrictDate[1];
  siteCode: String[1];
  taxonName: String[1];
  lengthMm: Float[1];
  collectorName: String[0..1];
  catalogedAt: DateTime[1];
}

Class {meta::pure::profiles::doc.doc = 'One row per fossil coral colony reading per survey date and recording instant.'} test::coralfossil2::domain::CoralColony
{
  colonyRef: String[1];
  surveyDate: StrictDate[1];
  recordedAt: DateTime[1];
  growthForm: String[1];
  diameterMm: Float[1];
}

Class test::coralfossil2::domain::FieldCollector
{
  collectorCode: String[1];
  surveyDate: StrictDate[1];
  collectorName: String[1];
  affiliation: String[0..1];
}

Association test::coralfossil2::domain::SpecimenDigSite
{
  site: test::coralfossil2::domain::DigSite[0..1];
  specimens: test::coralfossil2::domain::Specimen[*];
}
