###Relational
Database test::coralfossil2::store::FossilDb
(
  Schema fossil
  (
    Table dig_site
    (
      site_code VARCHAR(16) PRIMARY KEY,
      survey_date DATE PRIMARY KEY,
      site_name VARCHAR(80),
      stratum_label VARCHAR(40),
      depth_m DOUBLE,
      recorded_at TIMESTAMP
    )
    Table specimen
    (
      specimen_ref VARCHAR(16) PRIMARY KEY,
      survey_date DATE PRIMARY KEY,
      site_code VARCHAR(16),
      taxon_name VARCHAR(80),
      length_mm DOUBLE,
      collector_name VARCHAR(80),
      cataloged_at TIMESTAMP
    )
    Table coral_colony
    (
      colony_ref VARCHAR(16) PRIMARY KEY,
      survey_date DATE PRIMARY KEY,
      recorded_at TIMESTAMP PRIMARY KEY,
      growth_form VARCHAR(40),
      diameter_mm DOUBLE
    )
    Table field_collector
    (
      collector_code VARCHAR(16) PRIMARY KEY,
      survey_date DATE PRIMARY KEY,
      collector_name VARCHAR(80),
      affiliation VARCHAR(80)
    )
  )

  Join SpecimenDigSite(fossil.specimen.site_code = fossil.dig_site.site_code and fossil.specimen.survey_date = fossil.dig_site.survey_date)
)
