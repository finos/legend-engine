###Connection
RelationalDatabaseConnection test::coralfossil2::connection::FossilWarehouseConnection
{
  store: test::coralfossil2::store::FossilDb;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'CORAL_FOSSIL_SURVEY';
    account: 'coral_fossil_account';
    warehouse: 'CORAL_FOSSIL_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    enableQueryTags: true;
    role: 'CORAL_FOSSIL_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'CORAL_FOSSIL_SVC';
    privateKeyVaultReference: 'coral-fossil-private-key';
    passPhraseVaultReference: 'coral-fossil-passphrase';
  };
}
