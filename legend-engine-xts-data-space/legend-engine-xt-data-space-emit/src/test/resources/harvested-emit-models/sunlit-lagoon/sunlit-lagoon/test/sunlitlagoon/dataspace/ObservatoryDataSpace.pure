###DataSpace
DataSpace test::sunlitlagoon::dataspace::ObservatoryDataSpace
{
  executionContexts:
  [
    {
      name: 'ridge';
      description: 'Ridge context - the observatory register mapping served through the ridge binding.';
      mapping: test::sunlitlagoon::mapping::ObservatoryMapping;
      defaultRuntime: test::sunlitlagoon::runtime::RidgeRuntime;
    },
    {
      name: 'warehouse';
      description: 'Warehouse context - the same register mapping served through the statically addressed warehouse binding under a delegated authentication strategy.';
      mapping: test::sunlitlagoon::mapping::ObservatoryMapping;
      defaultRuntime: test::sunlitlagoon::runtime::ObservatoryWarehouseRuntime;
    }
  ];
  defaultExecutionContext: 'ridge';
  title: 'Sunlit Lagoon Observatory Register';
  description: 'Discovery surface over the observatory register: the observations, the telescopes that took them, the sites they stand on across the second namespace, the stewards of those sites and the service visits recorded against them.';
  elements:
  [
    test::sunlitlagoon::domain::Observation,
    test::sunlitlagoon::domain::ServiceVisit,
    test::sunlitlagoon::domain::Site,
    test::sunlitlagoon::domain::Steward,
    test::sunlitlagoon::domain::Telescope
  ];
  executables:
  [
    {
      id: 1;
      title: 'Observation Register';
      description: 'The programme-keyed register query with its literal programme list and capture floor.';
      executable: test::sunlitlagoon::service::ObservationRegister;
    },
    {
      id: 2;
      title: 'Site Exposure Digest';
      description: 'The per-site aggregation of observation counts and exposure totals across the namespace boundary.';
      executable: test::sunlitlagoon::service::SiteExposureDigest;
    }
  ];
  supportInfo: Combined
  {
    emails: ['observatory-register-support-group', 'sky-survey-stewards'];
  };
}
