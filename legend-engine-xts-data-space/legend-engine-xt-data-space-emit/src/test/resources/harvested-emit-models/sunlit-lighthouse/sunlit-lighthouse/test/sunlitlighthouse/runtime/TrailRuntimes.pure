###Runtime
Runtime demo::sunlitlighthouse::runtime::MarkerRuntime
{
  mappings:
  [
    demo::sunlitlighthouse::mapping::TrailRegisterMapping
  ];
  connections:
  [
    demo::sunlitlighthouse::store::TrailRegisterDB:
    [
      markerWarehouseConnection: demo::sunlitlighthouse::connection::TrailWarehouseConnection
    ]
  ];
}

