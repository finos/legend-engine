###Relational
Database demo::sunlitlighthouse::store::TrailRegisterDB
(
  Schema trail
  (
    Table marker_register
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )

      marker_code VARCHAR(24) PRIMARY KEY,
      marker_name VARCHAR(120),
      route_code VARCHAR(24),
      surface_class VARCHAR(24),
      elevation_m FLOAT,
      post_height_m DECIMAL(9,3),
      installed_on DATE,
      checked_at TIMESTAMP,
      in_z DATE PRIMARY KEY,
      out_z DATE
    )
    Table shelter_register
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )

      shelter_code VARCHAR(24) PRIMARY KEY,
      shelter_name VARCHAR(120),
      route_code VARCHAR(24),
      condition_band VARCHAR(24),
      bunk_count INTEGER,
      floor_area_m2 FLOAT,
      opened_on DATE,
      in_z DATE PRIMARY KEY,
      out_z DATE
    )
  )

  Schema upkeep
  (
    Table inspection_register
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )

      inspection_code VARCHAR(24) PRIMARY KEY,
      marker_code VARCHAR(24),
      crew_code VARCHAR(24),
      outcome_code VARCHAR(24),
      duration_minutes INTEGER,
      material_kg DECIMAL(9,2),
      inspected_on DATE,
      logged_at TIMESTAMP,
      in_z DATE PRIMARY KEY,
      out_z DATE
    )
  )
)
