###Connection
RelationalDatabaseConnection demo::sunlitlighthouse::connection::TrailWarehouseConnection
{
  store: demo::sunlitlighthouse::store::TrailRegisterDB;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'EXAMPLE_TRAIL_REGISTER_DB';
    account: 'example_trail_account';
    warehouse: 'EXAMPLE_TRAIL_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    role: 'EXAMPLE_TRAIL_ROLE';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'EXAMPLE_TRAIL_USER';
    privateKeyVaultReference: 'example-trail-private-key';
    passPhraseVaultReference: 'example-trail-passphrase';
  };
}
