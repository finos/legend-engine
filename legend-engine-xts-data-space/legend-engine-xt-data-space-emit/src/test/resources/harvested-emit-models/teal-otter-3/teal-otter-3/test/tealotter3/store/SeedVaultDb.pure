###Relational
Database test::tealotter3::store::SeedVaultDb
(
  Schema seedarchive
  (
    Table accession
    (
      accession_code VARCHAR(20) PRIMARY KEY,
      collected_on DATE PRIMARY KEY,
      taxon_code VARCHAR(20),
      vault_code VARCHAR(20),
      seed_count INTEGER,
      viable_pct FLOAT,
      dried BIT
    )

    Table taxon
    (
      taxon_code VARCHAR(20) PRIMARY KEY,
      taxon_name VARCHAR(120) NOT NULL,
      family_code VARCHAR(20)
    )

    Table vault
    (
      vault_code VARCHAR(20) PRIMARY KEY,
      vault_name VARCHAR(80) NOT NULL,
      chill_degrees INTEGER
    )

    Table germination
    (
      trial_id INTEGER PRIMARY KEY,
      accession_code VARCHAR(20) PRIMARY KEY,
      vault_code VARCHAR(20),
      germinated_pct INTEGER,
      tested_on DATE
    )
  )

  Join Accession_Taxon_J(seedarchive.accession.taxon_code = seedarchive.taxon.taxon_code)

  Join Accession_Vault_J(seedarchive.accession.vault_code = seedarchive.vault.vault_code)

  Join Accession_Trial_J
  (
    seedarchive.accession.accession_code = seedarchive.germination.accession_code
      and seedarchive.accession.vault_code = seedarchive.germination.vault_code
  )
)
