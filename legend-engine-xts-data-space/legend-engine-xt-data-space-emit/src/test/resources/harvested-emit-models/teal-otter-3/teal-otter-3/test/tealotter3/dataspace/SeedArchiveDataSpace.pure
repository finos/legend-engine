###DataSpace
DataSpace test::tealotter3::dataspace::SeedArchiveDataSpace
{
  executionContexts:
  [
    {
      name: 'vault';
      description: 'Cold-room environment - the seed archive mapping served through the vault warehouse runtime.';
      mapping: test::tealotter3::mapping::SeedArchiveMapping;
      defaultRuntime: test::tealotter3::runtime::SeedVaultRuntime;
    }
  ];
  defaultExecutionContext: 'vault';
  title: 'Seed Vault Conservation Register';
  description: 'Discovery surface over the stored seed accessions, the taxa and cold rooms they resolve against, and the germination trials recorded for them.';
  elements:
  [
    test::tealotter3::domain::SeedAccession,
    test::tealotter3::domain::SeedTaxon,
    test::tealotter3::domain::SeedVault,
    test::tealotter3::domain::GerminationTrial
  ];
  executables:
  [
    {
      id: 1;
      title: 'Accession Register';
      description: 'The keyed register endpoint with its taxon, vault and seed-count parameters.';
      executable: test::tealotter3::service::AccessionRegister;
    },
    {
      id: 2;
      title: 'Trial Rank Board';
      description: 'The taxon-partitioned germination ranking endpoint.';
      executable: test::tealotter3::service::TrialRankBoard;
    }
  ];
  supportInfo: Email
  {
    address: 'seed-vault-desk@seedconservation.invalid';
  };
}
