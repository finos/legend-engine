###Service
Service test::zephyrthicket::service::WardCanopyService
{
  pattern: '/thicket/v1/wards';
  title: 'Zephyr Thicket - Ward register';
  owners:
  [
    'parkland-registry',
    'ward-desk'
  ];
  documentation: 'Publishes the civic ward register as a tabular projection, restricting the ward type to its own column list and reaching the hosting district through the implemented ward association.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: |test::zephyrthicket::domain::CivicWard.all()->project(
      [
        w|$w.wardCode,
        w|$w.wardName,
        w|$w.wardDistrict.districtName
      ],
      [
        'WardCode',
        'Ward',
        'District'
      ]
    )->sort(
      [
        asc('WardCode')
      ]
    );
    mapping: test::zephyrthicket::mapping::ThicketMapping;
    runtime: test::zephyrthicket::runtime::ThicketRegistryRuntime;
  }
  testSuites:
  [
    wardRegisterSuite:
    {
      data:
      [
        connections:
        [
          thicketRegistryConnection: Reference
            #{
              test::zephyrthicket::data::ThicketTestData
            }#
        ]
      ]
      tests:
      [
        allWards:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            wardRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"WardCode":"W1","Ward":"WILLOW WARD","District":"Riverside District"},{"WardCode":"W2","Ward":"ASPEN WARD","District":"Riverside District"},{"WardCode":"W3","Ward":"CEDAR WARD","District":"Hilltop District"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
