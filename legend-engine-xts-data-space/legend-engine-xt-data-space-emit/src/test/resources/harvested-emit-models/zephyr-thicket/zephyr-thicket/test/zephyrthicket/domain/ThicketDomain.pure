###Pure
import test::zephyrthicket::domain::*;

Profile test::zephyrthicket::domain::ThicketMeta
{
  stereotypes: [governed, surveyed];
  tags: [custodian, registryTier];
}

Class <<ThicketMeta.governed>> {ThicketMeta.custodian = 'parkland-registry', ThicketMeta.registryTier = 'gold', meta::pure::profiles::doc.doc = 'A surveyed parkland parcel, the hub of the registry navigation graph.'} test::zephyrthicket::domain::ParkParcel
{
  parcelCode: String[1];
  parcelName: String[1];
  parcelSlug: String[1];
  areaSqm: Float[1];
}

Class <<ThicketMeta.surveyed>> test::zephyrthicket::domain::CivicWard
{
  wardCode: String[1];
  wardName: String[1];
}

Class test::zephyrthicket::domain::CivicDistrict
{
  districtCode: String[1];
  districtName: String[1];
}

Class test::zephyrthicket::domain::CanopyClass
{
  canopyCode: String[1];
  canopyLabel: String[1];
}

Class test::zephyrthicket::domain::ParcelSteward
{
  stewardCode: String[1];
  stewardName: String[1];
}

Association test::zephyrthicket::domain::Parcel_Ward
{
  parcels: ParkParcel[*];
  ward: CivicWard[1];
}

Association test::zephyrthicket::domain::Parcel_Canopy
{
  canopyParcels: ParkParcel[*];
  canopy: CanopyClass[1];
}

Association test::zephyrthicket::domain::Parcel_Steward
{
  stewardParcels: ParkParcel[*];
  steward: ParcelSteward[1];
}

Association test::zephyrthicket::domain::Ward_District
{
  wards: CivicWard[*];
  wardDistrict: CivicDistrict[1];
}

Association test::zephyrthicket::domain::Parcel_District
{
  districtParcels: ParkParcel[*];
  district: CivicDistrict[1];
}
