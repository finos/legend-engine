###Connection
RelationalDatabaseConnection test::zephyrthicket::connection::ThicketRegistryConnection
{
  store: test::zephyrthicket::store::ThicketRegistryStore;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'THICKET_REGISTRY_DB';
    account: 'parkland_registry_account';
    warehouse: 'THICKET_REGISTRY_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    role: 'THICKET_REGISTRY_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'THICKET_REGISTRY_USER';
    privateKeyVaultReference: 'thicket.registry.privateKey';
    passPhraseVaultReference: 'thicket.registry.passPhrase';
  };
}
