###Relational
Database test::duskyhatchery3::store::HatcheryDb
(
  Schema rearing
  (
    Table brood_batch
    (
      batch_id INTEGER PRIMARY KEY,
      batch_code VARCHAR(24) NOT NULL,
      species_code VARCHAR(24) NOT NULL,
      health_code VARCHAR(8) NOT NULL,
      fry_count INTEGER NOT NULL,
      tank_id INTEGER NOT NULL
    )
    Table rearing_tank
    (
      tank_id INTEGER PRIMARY KEY,
      tank_code VARCHAR(24) NOT NULL,
      tank_label VARCHAR(120) NOT NULL,
      volume_litres INTEGER NOT NULL,
      site_id INTEGER NOT NULL
    )
  )

  Schema facility
  (
    Table hatchery_site
    (
      site_id INTEGER PRIMARY KEY,
      site_code VARCHAR(24) NOT NULL,
      site_name VARCHAR(120) NOT NULL,
      region_label VARCHAR(120) NOT NULL
    )
  )

  Join Batch_Tank
  (
    rearing.brood_batch.tank_id = rearing.rearing_tank.tank_id
  )

  Join Tank_Site
  (
    rearing.rearing_tank.site_id = facility.hatchery_site.site_id
  )
)
