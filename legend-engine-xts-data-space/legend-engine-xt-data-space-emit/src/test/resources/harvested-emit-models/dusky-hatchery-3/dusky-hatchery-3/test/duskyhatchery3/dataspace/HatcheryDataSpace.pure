###DataSpace
DataSpace test::duskyhatchery3::dataspace::HatcheryDataSpace
{
  executionContexts:
  [
    {
      name: 'rearing';
      description: 'Binds the cross-schema rearing store to the hatchery mapping and the local rearing runtime.';
      mapping: test::duskyhatchery3::mapping::HatcheryMapping;
      defaultRuntime: test::duskyhatchery3::runtime::HatcheryH2Runtime;
    }
  ];
  defaultExecutionContext: 'rearing';
  title: 'Dusky Hatchery Rearing Register';
  description: 'A curated entry point over hatchery rearing: brood batches, the tanks holding them and the facility sites those tanks belong to, published as tree-shaped and paginated endpoints.';
  elements:
  [
    test::duskyhatchery3::domain
  ];
  executables:
  [
    {
      id: 1;
      title: 'Brood batch tree';
      description: 'The featured endpoint fetching one batch with its tank and site.';
      executable: test::duskyhatchery3::service::BatchTreeService;
    }
  ];
  supportInfo: Email
  {
    address: 'rearing-support@hatchery-register.invalid';
    documentationUrl: 'https://hatchery-register.invalid/docs/rearing-register';
  };
}
