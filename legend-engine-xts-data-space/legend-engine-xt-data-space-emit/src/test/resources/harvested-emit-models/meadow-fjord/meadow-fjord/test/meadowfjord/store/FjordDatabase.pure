###Relational
Database test::meadowfjord::store::FjordDatabase
(
  Schema GEOGRAPHY
  (
    Table FJORD
    (
      FJORD_ID INTEGER PRIMARY KEY,
      NAME VARCHAR(200) NOT NULL,
      COUNTRY VARCHAR(100) NOT NULL
    )
  )

  Schema HYDROLOGY
  (
    Table MEASUREMENT
    (
      MEAS_ID INTEGER PRIMARY KEY,
      FJORD_ID INTEGER NOT NULL,
      SALINITY INTEGER NOT NULL,
      DEPTH_M INTEGER NOT NULL
    )
  )

  Join Fjord_Measurement(HYDROLOGY.MEASUREMENT.FJORD_ID = GEOGRAPHY.FJORD.FJORD_ID)

  View FJORD_PROFILE_VW
  (
    fjordId: GEOGRAPHY.FJORD.FJORD_ID PRIMARY KEY,
    name: GEOGRAPHY.FJORD.NAME,
    salinity: [test::meadowfjord::store::FjordDatabase]@Fjord_Measurement | HYDROLOGY.MEASUREMENT.SALINITY,
    depthM: [test::meadowfjord::store::FjordDatabase]@Fjord_Measurement | HYDROLOGY.MEASUREMENT.DEPTH_M
  )
)
