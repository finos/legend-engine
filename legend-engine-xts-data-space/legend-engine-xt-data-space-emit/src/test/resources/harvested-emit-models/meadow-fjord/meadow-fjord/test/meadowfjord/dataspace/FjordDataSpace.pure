###DataSpace
DataSpace test::meadowfjord::dataspace::FjordDataSpace
{
  executionContexts:
  [
    {
      name: 'prod';
      description: 'Production tier - the governed fjord and measurement registry.';
      mapping: test::meadowfjord::mapping::FjordMapping;
      defaultRuntime: test::meadowfjord::runtime::FjordRuntime;
    }
  ];
  defaultExecutionContext: 'prod';
  title: 'Fjord Registry';
  description: 'A governed entry point over the fjord domain - fjords, their hydrology measurements, and a derived fjord-profile inline view - wiring the relational mapping and runtime for consumers.';
}
