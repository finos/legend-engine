###DataSpace
DataSpace demo::indigothistle::dataspace::HabitatDataSpace
{
  executionContexts:
  [
    {
      name: 'warehouse';
      description: 'Governed fieldwork tier resolving the observer roster and the sighting log against the warehouse.';
      mapping: demo::indigothistle::mapping::HabitatMapping;
      defaultRuntime: demo::indigothistle::runtime::HabitatRuntime;
    }
  ];
  defaultExecutionContext: 'warehouse';
  title: 'Fieldwork Sightings And Observers';
  description: 'A curated entry point over the bird-ringing fieldwork model: the sighting log, the observers who recorded it, and the camp attributes each sighting reaches through the declared join layer.';
  elements:
  [
    demo::indigothistle::domain::Observer,
    demo::indigothistle::domain::Sighting
  ];
  supportInfo: Email
  {
    address: 'fieldwork-sightings@example.invalid';
  };
}
