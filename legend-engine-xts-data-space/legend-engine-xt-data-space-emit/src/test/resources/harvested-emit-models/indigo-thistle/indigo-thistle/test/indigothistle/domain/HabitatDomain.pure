import demo::indigothistle::domain::*;

Class demo::indigothistle::domain::Observer
{
  observerCode: String[1];
  fullName: String[1];
  certified: Boolean[1];
  enrolledOn: StrictDate[1];
  baseCampName: String[1];
}

Class demo::indigothistle::domain::Sighting
{
  sightingReference: String[1];
  speciesCode: String[1];
  observedAt: DateTime[1];
  individualsCounted: Integer[1];
  ringedPresent: Boolean[1];
  baseCampRegionCode: String[0..1];
  baseCampElevationMetres: Float[0..1];
}

Association demo::indigothistle::domain::Observer_Sighting
{
  recordingObserver: Observer[1];
  recordedSightings: Sighting[*];
}
