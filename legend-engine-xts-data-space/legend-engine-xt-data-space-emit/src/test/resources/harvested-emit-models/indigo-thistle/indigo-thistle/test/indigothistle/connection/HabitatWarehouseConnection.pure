###Connection
RelationalDatabaseConnection demo::indigothistle::connection::HabitatWarehouseConnection
{
  store: demo::indigothistle::store::HabitatDB;
  type: Snowflake;
  timezone: 'UTC';
  specification: Snowflake
  {
    name: 'FIELDWORK_DB';
    account: 'fieldwork_account';
    warehouse: 'FIELDWORK_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    enableQueryTags: false;
    accountType: MultiTenant;
    organization: 'fieldwork_org';
    role: 'FIELDWORK_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'FIELDWORK_USER';
    privateKeyVaultReference: 'fieldwork.privateKey';
    passPhraseVaultReference: 'fieldwork.passPhrase';
  };
}
