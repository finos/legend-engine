###Relational
Database demo::indigothistle::store::HabitatDB
(
  Schema fieldwork
  (
    Table observer
    (
      observer_id INTEGER PRIMARY KEY,
      observer_code VARCHAR(24) NOT NULL,
      full_name VARCHAR(160) NOT NULL,
      certified BIT NOT NULL,
      enrolled_on DATE NOT NULL,
      base_id INTEGER NOT NULL
    )
    Table sighting
    (
      sighting_id INTEGER PRIMARY KEY,
      sighting_reference VARCHAR(32) NOT NULL,
      species_code VARCHAR(12) NOT NULL,
      observed_at TIMESTAMP NOT NULL,
      individuals_counted INTEGER NOT NULL,
      ringed_present BIT NOT NULL,
      observer_id INTEGER NOT NULL
    )
    Table base_camp
    (
      base_id INTEGER PRIMARY KEY,
      base_name VARCHAR(120) NOT NULL,
      region_code VARCHAR(8) NOT NULL,
      elevation_metres DECIMAL(8,2) NOT NULL
    )
  )

  Join SightingObserver(fieldwork.sighting.observer_id = fieldwork.observer.observer_id)
  Join ObserverBaseCamp(fieldwork.observer.base_id = fieldwork.base_camp.base_id)
)
