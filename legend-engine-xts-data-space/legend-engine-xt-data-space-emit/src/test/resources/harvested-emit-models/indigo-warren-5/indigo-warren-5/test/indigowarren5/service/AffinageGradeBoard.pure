###Service
Service test::indigowarren5::service::AffinageGradeBoard
{
  pattern: '/indigowarren5/v1/affinage-grade-board';
  title: 'Indigo Warren 5 - Affinage Grade Board';
  owners:
  [
    'cellar-book-desk',
    'cave-affinage-eng'
  ];
  documentation: 'Grade board over the processing-milestoned affinage book. The read date is computed rather than only compared: when the caller raises the current-day flag the board computes the read date from the current day instead of the handed-in one, so the entries whose cellar window had already closed drop out of the cast. Each standing entry is published beside the wheel it stands against, the grade band the mapping settles from the rind treatment and the turns the wheel was given.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {asOf: StrictDate[1], readToday: Boolean[1], currentDate: StrictDate[1] |
              let readDate = if($readToday,
                                | $currentDate,
                                | $asOf);
              test::indigowarren5::domain::AffinageEntry.all($readDate)
                ->project(~[
                    entry: e | $e.entryCode,
                    wheel: e | $e.entryWheel.wheelCode,
                    band: e | $e.gradeBand,
                    turns: e | $e.turnCount
                  ])
                ->sort([~entry->ascending()]);
           };
    mapping: test::indigowarren5::mapping::CellarMapping;
    runtime: test::indigowarren5::runtime::CellarDayRuntime;
  }
  testSuites:
  [
    affinageGradeBoardSuite:
    {
      data:
      [
        connections:
        [
          cellarConnection:
            Relational
            #{
              cellar.affinage_entry:
                'entry_code,wheel_code,rind_code,turn_count,room_note,in_z,out_z\n'+
                'AE-01,WH-01,BLOOMY,4,cool corner,2026-04-01,9999-12-31\n'+
                'AE-02,WH-02,WASHED,6,damp wall,2026-04-01,9999-12-31\n'+
                'AE-03,WH-03,NATURAL,2,,2026-04-01,9999-12-31\n'+
                'AE-04,WH-04,WAXED,8,dry end,2026-04-01,9999-12-31\n'+
                'AE-05,WH-05,ASHED,3,near the door,2026-04-01,9999-12-31\n'+
                'AE-06,WH-06,CLOTH,5,under the vault,2026-04-01,9999-12-31\n'+
                'AE-07,WH-07,BRINED,7,brine bench,2026-04-01,9999-12-31\n'+
                'AE-08,WH-08,,1,unwrapped shelf,2026-04-01,9999-12-31\n'+
                'AE-09,WH-09,SMOKED,,smoke loft,2026-04-01,9999-12-31\n'+
                'AE-10,WH-01,WASHED,9,rewrapped corner,2026-04-20,9999-12-31\n'+
                'AE-11,WH-02,NATURAL,3,closed window,2026-03-01,2026-04-15\n';
              cellar.wheel:
                'wheel_code,shelf_code,turner_code,milk_kind,rind_code,weight_grams,wrapped_on\n'+
                'WH-01,SH-1,TN-1,ewe,BLOOMY,3200,2026-01-05\n'+
                'WH-02,SH-1,TN-1,goat,WASHED,1800,2026-01-09\n'+
                'WH-03,SH-2,TN-1,cow,NATURAL,5400,2026-01-14\n'+
                'WH-04,SH-2,TN-2,buffalo,WAXED,2600,2026-01-18\n'+
                'WH-05,SH-3,TN-2,ewe,ASHED,1200,2026-01-22\n'+
                'WH-06,SH-3,TN-2,goat,CLOTH,4400,2026-01-27\n'+
                'WH-07,SH-4,TN-3,cow,BRINED,3000,2026-02-02\n'+
                'WH-08,SH-4,TN-3,ewe,,2100,2026-02-06\n'+
                'WH-09,SH-1,TN-3,goat,SMOKED,,2026-02-11\n';
            }#
        ]
      ]
      tests:
      [
        aHandedInReadDateKeepsTheEntryThatWasStillOpenOnIt:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            asOf = %2026-04-10,
            readToday = false,
            currentDate = %2026-08-01
          ]
          asserts:
          [
            tenEntriesStandingOnTheHandedInDate:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"entry":"AE-01","wheel":"WH-01","band":"BAND-1","turns":4},{"entry":"AE-02","wheel":"WH-02","band":"BAND-2","turns":6},{"entry":"AE-03","wheel":"WH-03","band":"BAND-3","turns":2},{"entry":"AE-04","wheel":"WH-04","band":"BAND-4","turns":8},{"entry":"AE-05","wheel":"WH-05","band":"BAND-5","turns":3},{"entry":"AE-06","wheel":"WH-06","band":"BAND-6","turns":5},{"entry":"AE-07","wheel":"WH-07","band":"BAND-7","turns":7},{"entry":"AE-08","wheel":"WH-08","band":"BAND-NONE","turns":1},{"entry":"AE-09","wheel":"WH-09","band":"BAND-UNLISTED","turns":null},{"entry":"AE-11","wheel":"WH-02","band":"BAND-3","turns":3}]';
                  }#;
              }#
          ]
        },
        theCurrentDayFlagComputesTheReadDateAndDropsTheClosedEntry:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            asOf = %2026-04-10,
            readToday = true,
            currentDate = %2026-08-01
          ]
          asserts:
          [
            tenEntriesStandingToday:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"entry":"AE-01","wheel":"WH-01","band":"BAND-1","turns":4},{"entry":"AE-02","wheel":"WH-02","band":"BAND-2","turns":6},{"entry":"AE-03","wheel":"WH-03","band":"BAND-3","turns":2},{"entry":"AE-04","wheel":"WH-04","band":"BAND-4","turns":8},{"entry":"AE-05","wheel":"WH-05","band":"BAND-5","turns":3},{"entry":"AE-06","wheel":"WH-06","band":"BAND-6","turns":5},{"entry":"AE-07","wheel":"WH-07","band":"BAND-7","turns":7},{"entry":"AE-08","wheel":"WH-08","band":"BAND-NONE","turns":1},{"entry":"AE-09","wheel":"WH-09","band":"BAND-UNLISTED","turns":null},{"entry":"AE-10","wheel":"WH-01","band":"BAND-2","turns":9}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
