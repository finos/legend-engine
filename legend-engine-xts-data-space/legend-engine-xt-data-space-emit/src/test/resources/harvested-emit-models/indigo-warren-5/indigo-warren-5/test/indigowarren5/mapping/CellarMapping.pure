      ];
    },
    turnerRotaSuite:
    {
      function: |test::indigowarren5::domain::Turner.all()->project(~[
                    turner: t | $t.turnerCode,
                    name: t | $t.turnerName,
                    rota: t | $t.rotaLabel,
                    cave: t | $t.turnerCave.caveName,
                    county: t | $t.turnerDairy.countyLabel
                  ])->sort([~turner->ascending()]);
      tests:
      [
        everyTurnerResolvesBothOfItsEndsAndTheUnrosteredWalkGetsALabel:
        {
          doc: 'Reads the turners across both of the ends they carry, the cave rota they walk and the dairy that hired them, and settles a rota label from the turner code for the turner the rota book never listed.';
          data:
          [
            test::indigowarren5::store::CellarDb:
              Relational
              #{
                cellar.affinage_entry:
                  'entry_code,wheel_code,rind_code,turn_count,room_note,in_z,out_z\n'+
                  'AE-01,WH-01,BLOOMY,4,cool corner,2026-04-01,9999-12-31\n'+
                  'AE-02,WH-02,WASHED,6,damp wall,2026-04-01,9999-12-31\n'+
                  'AE-03,WH-03,NATURAL,2,,2026-04-01,9999-12-31\n'+
                  'AE-04,WH-04,WAXED,8,dry end,2026-04-01,9999-12-31\n'+
                  'AE-05,WH-05,ASHED,3,near the door,2026-04-01,9999-12-31\n'+
                  'AE-06,WH-06,CLOTH,5,under the vault,2026-04-01,9999-12-31\n'+
                  'AE-07,WH-07,BRINED,7,brine bench,2026-04-01,9999-12-31\n'+
                  'AE-08,WH-08,,1,unwrapped shelf,2026-04-01,9999-12-31\n'+
                  'AE-09,WH-09,SMOKED,,smoke loft,2026-04-01,9999-12-31\n'+
                  'AE-10,WH-01,WASHED,9,rewrapped corner,2026-04-20,9999-12-31\n'+
                  'AE-11,WH-02,NATURAL,3,closed window,2026-03-01,2026-04-15\n';

                cellar.cave:
                  'cave_code,dairy_code,cave_name,humidity_pct,temp_c\n'+
                  'CV-1,DY-1,Long Barrel Cave,92,11\n'+
                  'CV-2,DY-1,Chalk Drift Cave,88,9\n'+
                  'CV-3,DY-2,,,13\n';

                cellar.dairy:
                  'dairy_code,dairy_name,county_label\n'+
                  'DY-1,Wold Edge Dairy,north wold\n'+
