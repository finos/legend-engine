                cellar.cave:
                  'cave_code,dairy_code,cave_name,humidity_pct,temp_c\n'+
                  'CV-1,DY-1,Long Barrel Cave,92,11\n'+
                  'CV-2,DY-1,Chalk Drift Cave,88,9\n'+
                  'CV-3,DY-2,,,13\n';

                cellar.dairy:
                  'dairy_code,dairy_name,county_label\n'+
                  'DY-1,Wold Edge Dairy,north wold\n'+
                  'DY-2,Fen Hollow Dairy,low fen\n';

                cellar.rind_check:
                  'check_code,wheel_code,rind_score,checked_on,note_text\n'+
                  'RC-1,WH-01,12,2026-04-02,rind even\n'+
                  'RC-2,WH-03,18,2026-04-03,  crust firm  \n'+
                  'RC-3,WH-05,,2026-04-04,gauge unread\n'+
                  'RC-4,WH-08,7,2026-04-05,\n'+
                  'RC-5,WH-09,20,2026-04-06,smoke mark\n';

                cellar.shelf:
                  'shelf_code,cave_code,tier,capacity\n'+
                  'SH-1,CV-1,1,40\n'+
                  'SH-2,CV-1,2,30\n'+
                  'SH-3,CV-2,1,25\n'+
                  'SH-4,CV-3,3,20\n';

                cellar.turner:
                  'turner_code,cave_code,dairy_code,turner_name,rota_label\n'+
                  'TN-1,CV-1,DY-1,Alma Reed,rota-a\n'+
                  'TN-2,CV-2,DY-1,Bram Hollis,rota-b\n'+
                  'TN-3,CV-3,DY-2,Cadi Vaughan,\n';

                cellar.wheel:
                  'wheel_code,shelf_code,turner_code,milk_kind,rind_code,weight_grams,wrapped_on\n'+
                  'WH-01,SH-1,TN-1,ewe,BLOOMY,3200,2026-01-05\n'+
                  'WH-02,SH-1,TN-1,goat,WASHED,1800,2026-01-09\n'+
                  'WH-03,SH-2,TN-1,cow,NATURAL,5400,2026-01-14\n'+
                  'WH-04,SH-2,TN-2,buffalo,WAXED,2600,2026-01-18\n'+
                  'WH-05,SH-3,TN-2,ewe,ASHED,1200,2026-01-22\n'+
                  'WH-06,SH-3,TN-2,goat,CLOTH,4400,2026-01-27\n'+
                  'WH-07,SH-4,TN-3,cow,BRINED,3000,2026-02-02\n'+
                  'WH-08,SH-4,TN-3,ewe,,2100,2026-02-06\n'+
                  'WH-09,SH-1,TN-3,goat,SMOKED,,2026-02-11\n';
              }#
          ];
          asserts:
          [
            fiveCardsResolveWheelAndCave:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"check":"RC-1","wheel":"WH-01","score":12,"note":"rind even","cave":"LONG BARREL CAVE"},{"check":"RC-2","wheel":"WH-03","score":18,"note":"crust firm","cave":"LONG BARREL CAVE"},{"check":"RC-3","wheel":"WH-05","score":null,"note":"gauge unread","cave":"CHALK DRIFT CAVE"},{"check":"RC-4","wheel":"WH-08","score":7,"note":null,"cave":"UNNAMED CUT"},{"check":"RC-5","wheel":"WH-09","score":20,"note":"smoke mark","cave":"LONG BARREL CAVE"}]';
                  }#;
