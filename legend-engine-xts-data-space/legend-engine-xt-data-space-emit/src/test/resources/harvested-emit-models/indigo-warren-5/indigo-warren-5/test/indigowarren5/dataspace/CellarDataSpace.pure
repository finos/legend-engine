###DataSpace
DataSpace test::indigowarren5::dataspace::CellarDataSpace
{
  executionContexts:
  [
    {
      name: 'dayWalk';
      description: 'Day-walk cellar book tier resolved through the day cellar connection.';
      mapping: test::indigowarren5::mapping::CellarMapping;
      defaultRuntime: test::indigowarren5::runtime::CellarDayRuntime;
    },
    {
      name: 'nightWalk';
      description: 'Night-walk cellar book tier resolved through the night cellar connection.';
      mapping: test::indigowarren5::mapping::CellarMapping;
      defaultRuntime: test::indigowarren5::runtime::CellarNightRuntime;
    }
  ];
  defaultExecutionContext: 'dayWalk';
  title: 'Farmhouse Cellar Affinage Book';
  description: 'Governed entry point over the processing-milestoned affinage book, the cave and shelf racking graph it hangs off and the two boards published from it.';
}
