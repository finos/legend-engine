###Connection
RelationalDatabaseConnection test::indigowarren5::connection::CellarDayConnection
{
  store: test::indigowarren5::store::CellarDb;
  type: MemSQL;
  specification: Static
  {
    name: 'example_cellar_book';
    host: 'example-cellar-host';
    port: 3306;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'cellarbookprincipal';
  };
}

RelationalDatabaseConnection test::indigowarren5::connection::CellarNightConnection
{
  store: test::indigowarren5::store::CellarDb;
  type: MemSQL;
  specification: Static
  {
    name: 'example_cellar_book_night';
    host: 'example-cellar-night-host';
    port: 3306;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'cellarnightprincipal';
  };
}
