###Mapping
Mapping test::indigowarren5::mapping::CellarBaseMapping
(
  *test::indigowarren5::domain::Dairy[dairy]: Relational
  {
    ~primaryKey
    (
      [test::indigowarren5::store::CellarDb]cellar.dairy.dairy_code
    )
    ~mainTable [test::indigowarren5::store::CellarDb]cellar.dairy
    dairyCode: [test::indigowarren5::store::CellarDb]cellar.dairy.dairy_code,
    dairyName: [test::indigowarren5::store::CellarDb]cellar.dairy.dairy_name,
    countyLabel: toUpper(trim([test::indigowarren5::store::CellarDb]cellar.dairy.county_label))
  }

  *test::indigowarren5::domain::Cave[cave]: Relational
  {
    ~primaryKey
    (
      [test::indigowarren5::store::CellarDb]cellar.cave.cave_code
    )
    ~mainTable [test::indigowarren5::store::CellarDb]cellar.cave
    caveCode: [test::indigowarren5::store::CellarDb]cellar.cave.cave_code,
    caveName: case(
                isNull([test::indigowarren5::store::CellarDb]cellar.cave.cave_name),
                'UNNAMED CUT',
                toUpper(trim([test::indigowarren5::store::CellarDb]cellar.cave.cave_name))
              ),
    humidityPct: [test::indigowarren5::store::CellarDb]cellar.cave.humidity_pct,
    tempC: [test::indigowarren5::store::CellarDb]cellar.cave.temp_c
  }

  *test::indigowarren5::domain::Shelf[shelf]: Relational
  {
    ~primaryKey
    (
      [test::indigowarren5::store::CellarDb]cellar.shelf.shelf_code
    )
    ~mainTable [test::indigowarren5::store::CellarDb]cellar.shelf
    shelfCode: [test::indigowarren5::store::CellarDb]cellar.shelf.shelf_code,
    tier: [test::indigowarren5::store::CellarDb]cellar.shelf.tier,
    capacity: [test::indigowarren5::store::CellarDb]cellar.shelf.capacity
  }
)
