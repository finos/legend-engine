###Connection
RelationalDatabaseConnection test::easternquarry5::connection::RefugeLogConnection
{
  store: test::easternquarry5::store::RefugeLogDb;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'REFUGE_LOG_DB';
    account: 'refuge_log_account';
    warehouse: 'REFUGE_LOG_WH';
    region: 'eu-central-1';
    cloudType: 'aws';
    enableQueryTags: true;
    role: 'REFUGE_LOG_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'REFUGE_LOG_READER_USER';
    privateKeyVaultReference: 'refuge-log-private-key';
    passPhraseVaultReference: 'refuge-log-passphrase';
  };
}
