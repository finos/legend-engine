    query: |test::easternquarry5::domain::SupplyDropLog.all(%latest)->project(
      [
        x|$x.dropCode,
        x|$x.refugeCode,
        x|$x.cratesDelivered,
        x|$x.payloadKg,
        x|$x.rotorMinutes,
        x|$x.droppedOn,
        x|$x.recordedAt
