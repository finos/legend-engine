###Service
Service test::easternquarry5::service::SupplyDropLogExtract
{
  pattern: '/easternquarry5/v1/supplydroplog';
  ownership: DID { identifier: '000000' };
  documentation: 'Publishes every property of the SupplyDropLog log at its latest processing version as a tabular result.';
  autoActivateUpdates: true;
