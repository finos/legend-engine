###Relational
Database test::easternquarry5::store::RefugeLogDb
(
  Schema refuge
  (
    Table refuge_occupancy
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z, INFINITY_DATE = %9999-12-31)
      )

      log_code VARCHAR(24) PRIMARY KEY,
      refuge_code VARCHAR(24) NOT NULL,
      night_of DATE,
      bunks_occupied DOUBLE,
      bunks_free DOUBLE,
      mean_stay_nights DOUBLE,
      recorded_at TIMESTAMP,
      in_z DATE PRIMARY KEY,
      out_z DATE NOT NULL
    )
    Table trail_condition_note
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z, INFINITY_DATE = %9999-12-31)
      )

      note_code VARCHAR(24) PRIMARY KEY,
      trail_code VARCHAR(24) NOT NULL,
      surface_state VARCHAR(32),
      snow_depth_cm DOUBLE,
      ice_cover_pct DOUBLE,
      observed_on DATE,
      recorded_at TIMESTAMP,
      in_z DATE PRIMARY KEY,
      out_z DATE NOT NULL
    )
    Table snowpack_profile
    (
      profile_code VARCHAR(24) PRIMARY KEY,
      slope_aspect VARCHAR(8),
      layer_count DOUBLE,
      density_kg_m3 DOUBLE,
      pit_depth_cm DOUBLE,
      taken_on DATE,
      recorded_at TIMESTAMP
    )
    Table spring_flow_reading
    (
      reading_code VARCHAR(24) PRIMARY KEY,
      spring_code VARCHAR(24) NOT NULL,
      flow_litres_min DOUBLE,
      water_temp_c DOUBLE,
      turbidity_ntu DOUBLE,
      sampled_on DATE,
      recorded_at TIMESTAMP
    )
    Table supply_drop_log
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z, INFINITY_DATE = %9999-12-31)
      )

      drop_code VARCHAR(24) PRIMARY KEY,
      refuge_code VARCHAR(24) NOT NULL,
      crates_delivered DOUBLE,
      payload_kg DOUBLE,
      rotor_minutes DOUBLE,
      dropped_on DATE,
      recorded_at TIMESTAMP,
      in_z DATE PRIMARY KEY,
      out_z DATE NOT NULL
    )
    Table warden_rota
    (
      warden_code VARCHAR(24) PRIMARY KEY,
      refuge_code VARCHAR(24),
      shift_start TIMESTAMP,
      shift_hours DOUBLE,
      rota_day DATE
    )
  )
)
