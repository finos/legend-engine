###Mapping
Mapping test::easternquarry5::mapping::RefugeLogMapping
(
  *test::easternquarry5::domain::RefugeOccupancy[refugeOccupancy]: Relational
  {
    ~primaryKey
    (
      [test::easternquarry5::store::RefugeLogDb]refuge.refuge_occupancy.log_code
    )
    ~mainTable [test::easternquarry5::store::RefugeLogDb]refuge.refuge_occupancy
    logCode: [test::easternquarry5::store::RefugeLogDb]refuge.refuge_occupancy.log_code,
    refugeCode: [test::easternquarry5::store::RefugeLogDb]refuge.refuge_occupancy.refuge_code,
    nightOf: [test::easternquarry5::store::RefugeLogDb]refuge.refuge_occupancy.night_of,
    bunksOccupied: [test::easternquarry5::store::RefugeLogDb]refuge.refuge_occupancy.bunks_occupied,
    bunksFree: [test::easternquarry5::store::RefugeLogDb]refuge.refuge_occupancy.bunks_free,
    meanStayNights: [test::easternquarry5::store::RefugeLogDb]refuge.refuge_occupancy.mean_stay_nights,
    recordedAt: [test::easternquarry5::store::RefugeLogDb]refuge.refuge_occupancy.recorded_at
  }

