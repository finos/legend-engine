  *test::easternquarry5::domain::SupplyDropLog[supplyDropLog]: Relational
  {
    ~primaryKey
    (
      [test::easternquarry5::store::RefugeLogDb]refuge.supply_drop_log.drop_code
    )
    ~mainTable [test::easternquarry5::store::RefugeLogDb]refuge.supply_drop_log
    dropCode: [test::easternquarry5::store::RefugeLogDb]refuge.supply_drop_log.drop_code,
    refugeCode: [test::easternquarry5::store::RefugeLogDb]refuge.supply_drop_log.refuge_code,
    cratesDelivered: [test::easternquarry5::store::RefugeLogDb]refuge.supply_drop_log.crates_delivered,
    payloadKg: [test::easternquarry5::store::RefugeLogDb]refuge.supply_drop_log.payload_kg,
    rotorMinutes: [test::easternquarry5::store::RefugeLogDb]refuge.supply_drop_log.rotor_minutes,
    droppedOn: [test::easternquarry5::store::RefugeLogDb]refuge.supply_drop_log.dropped_on,
    recordedAt: [test::easternquarry5::store::RefugeLogDb]refuge.supply_drop_log.recorded_at
  }

  testSuites:
  [
    refugeOccupancyLatestSuite:
    {
      function: |test::easternquarry5::domain::RefugeOccupancy.all(%latest)->project(
        [
          x|$x.logCode,
          x|$x.refugeCode,
          x|$x.nightOf,
          x|$x.bunksOccupied,
          x|$x.bunksFree,
          x|$x.meanStayNights,
          x|$x.recordedAt
        ],
        [
          'LogCode',
          'RefugeCode',
          'NightOf',
          'BunksOccupied',
          'BunksFree',
          'MeanStayNights',
          'RecordedAt'
        ]
      )->sort([asc('LogCode')])->take(50);
      tests:
      [
        latestVersionOnly:
        {
          doc: 'A superseded processing version is out of range at the latest instant and must not be returned.';
          data:
          [
            test::easternquarry5::store::RefugeLogDb:
              Relational
              #{
                refuge.refuge_occupancy:
                  'log_code,refuge_code,night_of,bunks_occupied,bunks_free,mean_stay_nights,recorded_at,in_z,out_z\n'+
                  'LO-01,RE-01,2026-01-11,11.75,12.25,12.75,2026-01-11 01:30:00,2026-01-05,9999-12-31\n'+
                  'LO-02,RE-02,2026-01-12,,22.25,22.75,2026-01-12 02:30:00,2026-01-05,9999-12-31\n'+
                  'LO-01,RE-01,2026-01-11,31.75,32.25,32.75,2026-01-11 01:30:00,2025-12-01,2026-01-05\n';
              }#
          ];
          asserts:
          [
            latestRowsSurface:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"LogCode":"LO-01","RefugeCode":"RE-01","NightOf":"2026-01-11","BunksOccupied":11.75,"BunksFree":12.25,"MeanStayNights":12.75,"RecordedAt":"2026-01-11T01:30:00.000000000+0000"},{"LogCode":"LO-02","RefugeCode":"RE-02","NightOf":"2026-01-12","BunksOccupied":null,"BunksFree":22.25,"MeanStayNights":22.75,"RecordedAt":"2026-01-12T02:30:00.000000000+0000"}]';
                  }#;
              }#
          ];
        }
      ];
    },
    snowpackProfileLatestSuite:
    {
      function: |test::easternquarry5::domain::SnowpackProfile.all(%latest)->project(
        [
          x|$x.profileCode,
          x|$x.slopeAspect,
          x|$x.layerCount,
          x|$x.densityKgM3,
          x|$x.pitDepthCm,
          x|$x.takenOn,
          x|$x.recordedAt
        ],
        [
          'ProfileCode',
          'SlopeAspect',
          'LayerCount',
          'DensityKgM3',
          'PitDepthCm',
          'TakenOn',
          'RecordedAt'
        ]
      )->sort([asc('ProfileCode')])->take(50);
      tests:
      [
        latestVersionOnly:
        {
          doc: 'The table keeps no version columns, so every row is current under the class-level stereotype alone.';
          data:
          [
            test::easternquarry5::store::RefugeLogDb:
              Relational
              #{
                refuge.snowpack_profile:
                  'profile_code,slope_aspect,layer_count,density_kg_m3,pit_depth_cm,taken_on,recorded_at\n'+
                  'PR-01,state-1,11.25,11.75,12.25,2026-01-11,2026-01-11 01:30:00\n'+
                  'PR-02,state-2,21.25,,22.25,2026-01-12,2026-01-12 02:30:00\n'+
                  'PR-03,state-3,41.25,41.75,42.25,2026-01-13,2026-01-13 03:30:00\n';
              }#
          ];
          asserts:
          [
            latestRowsSurface:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"ProfileCode":"PR-01","SlopeAspect":"state-1","LayerCount":11.25,"DensityKgM3":11.75,"PitDepthCm":12.25,"TakenOn":"2026-01-11","RecordedAt":"2026-01-11T01:30:00.000000000+0000"},{"ProfileCode":"PR-02","SlopeAspect":"state-2","LayerCount":21.25,"DensityKgM3":null,"PitDepthCm":22.25,"TakenOn":"2026-01-12","RecordedAt":"2026-01-12T02:30:00.000000000+0000"},{"ProfileCode":"PR-03","SlopeAspect":"state-3","LayerCount":41.25,"DensityKgM3":41.75,"PitDepthCm":42.25,"TakenOn":"2026-01-13","RecordedAt":"2026-01-13T03:30:00.000000000+0000"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
