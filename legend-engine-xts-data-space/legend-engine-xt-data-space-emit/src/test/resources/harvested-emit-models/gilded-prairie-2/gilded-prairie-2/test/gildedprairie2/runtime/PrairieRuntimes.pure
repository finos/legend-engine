###Runtime
Runtime test::gildedprairie2::runtime::PrairieReferenceRuntime
{
  mappings:
  [
    test::gildedprairie2::mapping::PrairieReferenceMapping
  ];
  connections:
  [
    test::gildedprairie2::store::PrairieAllDB:
    [
      prairieConnection: test::gildedprairie2::connection::PrairieWarehouseConnection
    ]
  ];
}

