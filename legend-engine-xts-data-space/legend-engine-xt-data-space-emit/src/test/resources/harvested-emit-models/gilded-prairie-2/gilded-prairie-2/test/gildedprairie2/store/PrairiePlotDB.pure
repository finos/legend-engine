###Relational
Database test::gildedprairie2::store::PrairiePlotDB
(
  Schema prairie_plot
  (
    Table plot
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )

      plot_code VARCHAR(24) PRIMARY KEY,
      plot_name VARCHAR(120) NOT NULL,
      region_code VARCHAR(24),
      established_on DATE,
      plot_area_m2 FLOAT,
      in_z TIMESTAMP NOT NULL,
      out_z TIMESTAMP NOT NULL
    )

    Table plot_soil
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )

      plot_code VARCHAR(24) PRIMARY KEY,
      soil_series VARCHAR(80) NOT NULL,
      organic_pct FLOAT,
      in_z TIMESTAMP NOT NULL,
      out_z TIMESTAMP NOT NULL
    )
  )

  Join Plot_Soil(prairie_plot.plot.plot_code = prairie_plot.plot_soil.plot_code)
)
