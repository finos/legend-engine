###Connection
RelationalDatabaseConnection test::gildedprairie2::connection::PrairieWarehouseConnection
{
  store: test::gildedprairie2::store::PrairieAllDB;
  type: Snowflake;
  quoteIdentifiers: false;
  specification: Snowflake
  {
    name: 'EXAMPLE_PRAIRIE_SURVEY_DB';
    account: 'example_prairie_account';
    warehouse: 'EXAMPLE_PRAIRIE_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    role: 'EXAMPLE_PRAIRIE_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'EXAMPLE_PRAIRIE_READER';
    privateKeyVaultReference: 'example.prairie.privateKey';
    passPhraseVaultReference: 'example.prairie.passPhrase';
  };
}
