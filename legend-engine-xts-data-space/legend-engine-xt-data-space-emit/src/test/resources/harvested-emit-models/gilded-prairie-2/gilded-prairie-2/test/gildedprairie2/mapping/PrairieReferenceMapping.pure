###Mapping
Mapping test::gildedprairie2::mapping::PrairieReferenceMapping
(
  *test::gildedprairie2::domain::Steward[steward_set]: Relational
  {
    ~primaryKey
    (
      [test::gildedprairie2::store::PrairieAllDB]prairie_ref.steward_ref.steward_code
    )
    ~mainTable [test::gildedprairie2::store::PrairieAllDB]prairie_ref.steward_ref
    stewardCode: [test::gildedprairie2::store::PrairieAllDB]prairie_ref.steward_ref.steward_code,
    stewardName: [test::gildedprairie2::store::PrairieAllDB]prairie_ref.steward_ref.steward_name,
    contactLocality: [test::gildedprairie2::store::PrairieAllDB]prairie_ref.steward_ref.contact_locality
  }

  *test::gildedprairie2::domain::Region[region_set]: Relational
  {
    ~primaryKey
    (
      [test::gildedprairie2::store::PrairieAllDB]prairie_ref.region_ref.region_code
    )
    ~mainTable [test::gildedprairie2::store::PrairieAllDB]prairie_ref.region_ref
    regionCode: [test::gildedprairie2::store::PrairieAllDB]prairie_ref.region_ref.region_code,
    regionName: [test::gildedprairie2::store::PrairieAllDB]prairie_ref.region_ref.region_name,
    hectares: [test::gildedprairie2::store::PrairieAllDB]prairie_ref.region_ref.hectares,
    stewardName: [test::gildedprairie2::store::PrairieAllDB]@Region_Steward | [test::gildedprairie2::store::PrairieAllDB]prairie_ref.steward_ref.steward_name
  }

  test::gildedprairie2::domain::Steward_Regions: Relational
  {
    AssociationMapping
    (
      regions[steward_set, region_set]: [test::gildedprairie2::store::PrairieAllDB]@Region_Steward,
      steward[region_set, steward_set]: [test::gildedprairie2::store::PrairieAllDB]@Region_Steward
    )
  }
)
