###Relational
Database test::gildedprairie2::store::PrairieAllDB
(
  include test::gildedprairie2::store::PrairieReferenceDB
  include test::gildedprairie2::store::PrairiePlotDB
  include test::gildedprairie2::store::PrairieSurveyDB

  Join Plot_Region(prairie_plot.plot.region_code = prairie_ref.region_ref.region_code)
  Join Survey_Plot(prairie_survey.survey.plot_code = prairie_plot.plot.plot_code)
)
