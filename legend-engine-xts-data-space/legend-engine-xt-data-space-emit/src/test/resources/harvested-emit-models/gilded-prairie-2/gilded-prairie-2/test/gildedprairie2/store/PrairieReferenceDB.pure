###Relational
Database test::gildedprairie2::store::PrairieReferenceDB
(
  Schema prairie_ref
  (
    Table steward_ref
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )

      steward_code VARCHAR(24) PRIMARY KEY,
      steward_name VARCHAR(120) NOT NULL,
      contact_locality VARCHAR(80),
      in_z TIMESTAMP NOT NULL,
      out_z TIMESTAMP NOT NULL
    )

    Table region_ref
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )

      region_code VARCHAR(24) PRIMARY KEY,
      region_name VARCHAR(120) NOT NULL,
      steward_code VARCHAR(24),
      hectares DECIMAL(9, 2),
      in_z TIMESTAMP NOT NULL,
      out_z TIMESTAMP NOT NULL
    )
  )

  Join Region_Steward(prairie_ref.region_ref.steward_code = prairie_ref.steward_ref.steward_code)
)
