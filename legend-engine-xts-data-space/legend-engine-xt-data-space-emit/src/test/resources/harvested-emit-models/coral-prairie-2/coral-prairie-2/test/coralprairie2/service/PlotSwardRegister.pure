###Service
Service test::coralprairie2::service::PlotSwardRegister
{
  pattern: '/prairie/v1/plots/{batch}';
  title: 'Coral Prairie - meadow plot sward register for one survey batch';
  documentation: 'Narrows the meadow plot extent to the named grassland regions and one survey batch, then projects the derived sward vocabulary together with the region name reached over one join hop and the rainfall norm reached over two.';
  autoActivateUpdates: false;
  ownership: DID { identifier: '000000' };
  execution: Single
  {
    query: {regions: String[*], batch: Integer[1]|test::coralprairie2::domain::MeadowPlot.all()->filter(
      p|$p.regionName->toOne()->in($regions)
    )->filter(
      p|$p.batchId == $batch
    )->project(
      [
        p|$p.plotCode,
        p|$p.plotName,
        p|$p.swardBand,
        p|$p.regionName,
        p|$p.rainfallMillimetres,
        p|$p.surveyProgramme
      ],
      [
        'Plot/Code',
        'Plot/Name',
        'Plot/Sward Band',
        'Region/Name',
        'Region/Rainfall',
        'Plot/Programme'
      ]
    )->sort([asc('Plot/Code')])};
    mapping: test::coralprairie2::mapping::PrairieMapping;
    runtime: test::coralprairie2::runtime::PrairieRuntime;
  }
  testSuites:
  [
    plotSwardRegisterSuite:
    {
      data:
      [
        connections:
        [
          prairieConnection:
            Relational
            #{
              prairie.meadow_plot:
                'plot_id,batch_id,plot_code,plot_name,region_code,hectares,sward_score,grazing_note\n'+
                '1,5,P-01,Ridge Meadow,R-01,12.5,1,summer grazed\n'+
                '2,5,P-02,Creek Meadow,R-01,8.25,2,ungrazed\n'+
                '3,5,P-03,Bluff Meadow,R-01,15.0,3,summer grazed\n'+
                '4,5,P-04,Draw Meadow,R-02,9.75,4,ungrazed\n'+
                '5,5,P-05,Fenceline Meadow,R-02,11.0,5,winter grazed\n'+
                '6,5,P-06,Hollow Meadow,R-01,7.5,6,ungrazed\n'+
                '7,5,P-07,Knoll Meadow,R-02,13.25,7,summer grazed\n'+
                '8,5,P-08,Slough Meadow,R-01,6.0,8,ungrazed\n'+
                '9,5,P-09,Verge Meadow,R-02,10.5,,unrecorded\n';

              prairie.region:
                'region_code,region_name,biome\n'+
                'R-01,North Prairie,tallgrass\n'+
                'R-02,West Prairie,mixedgrass\n';

              prairie.climate_norm:
                'region_code,rainfall_mm,frost_days\n'+
                'R-01,700,120\n'+
                'R-02,450,140\n';

              prairie.sward_sample:
                'sample_id,batch_id,plot_id,species_count,biomass_kg,sampled_on\n'+
                '1,5,1,24,3.5,2026-05-04\n'+
                '2,5,2,18,2.75,2026-05-05\n'+
                '3,5,4,31,4.25,2026-05-06\n';
            }#
        ]
      ]
      tests:
      [
        everyArmForOneBatch:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            regions = ['North Prairie', 'West Prairie'],
            batch = 5
          ]
          asserts:
          [
            swardArmsAndNullFallback:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Plot/Code":"P-01","Plot/Name":"Ridge Meadow","Plot/Sward Band":"A: bare sward","Region/Name":"North Prairie","Region/Rainfall":700,"Plot/Programme":"prairie-baseline"},{"Plot/Code":"P-02","Plot/Name":"Creek Meadow","Plot/Sward Band":"B: sparse sward","Region/Name":"North Prairie","Region/Rainfall":700,"Plot/Programme":"prairie-baseline"},{"Plot/Code":"P-03","Plot/Name":"Bluff Meadow","Plot/Sward Band":"C: patchy sward","Region/Name":"North Prairie","Region/Rainfall":700,"Plot/Programme":"prairie-baseline"},{"Plot/Code":"P-04","Plot/Name":"Draw Meadow","Plot/Sward Band":"D: mixed sward","Region/Name":"West Prairie","Region/Rainfall":450,"Plot/Programme":"prairie-baseline"},{"Plot/Code":"P-05","Plot/Name":"Fenceline Meadow","Plot/Sward Band":"E: dense sward","Region/Name":"West Prairie","Region/Rainfall":450,"Plot/Programme":"prairie-baseline"},{"Plot/Code":"P-06","Plot/Name":"Hollow Meadow","Plot/Sward Band":"F: tall sward","Region/Name":"North Prairie","Region/Rainfall":700,"Plot/Programme":"prairie-baseline"},{"Plot/Code":"P-07","Plot/Name":"Knoll Meadow","Plot/Sward Band":"G: tussock sward","Region/Name":"West Prairie","Region/Rainfall":450,"Plot/Programme":"prairie-baseline"},{"Plot/Code":"P-08","Plot/Name":"Slough Meadow","Plot/Sward Band":"H: scrubbing sward","Region/Name":"North Prairie","Region/Rainfall":700,"Plot/Programme":"prairie-baseline"},{"Plot/Code":"P-09","Plot/Name":"Verge Meadow","Plot/Sward Band":null,"Region/Name":"West Prairie","Region/Rainfall":450,"Plot/Programme":"prairie-baseline"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
