###Mapping
Mapping test::coralprairie2::mapping::PrairieMapping
(
  *test::coralprairie2::domain::MeadowPlot[plot]: Relational
  {
    ~primaryKey
    (
      [test::coralprairie2::store::PrairieDb]prairie.meadow_plot.plot_id,
      [test::coralprairie2::store::PrairieDb]prairie.meadow_plot.batch_id
    )
    ~mainTable [test::coralprairie2::store::PrairieDb]prairie.meadow_plot
    plotCode: [test::coralprairie2::store::PrairieDb]prairie.meadow_plot.plot_code,
    plotName: [test::coralprairie2::store::PrairieDb]prairie.meadow_plot.plot_name,
    batchId: [test::coralprairie2::store::PrairieDb]prairie.meadow_plot.batch_id,
    hectares: [test::coralprairie2::store::PrairieDb]prairie.meadow_plot.hectares,
    swardBand: case(
                 isNull([test::coralprairie2::store::PrairieDb]prairie.meadow_plot.sward_score),
                 sqlNull(),
                 case(
                 equal([test::coralprairie2::store::PrairieDb]prairie.meadow_plot.sward_score, 1),
                 'A: bare sward',
                 case(
                 equal([test::coralprairie2::store::PrairieDb]prairie.meadow_plot.sward_score, 2),
                 'B: sparse sward',
                 case(
                 equal([test::coralprairie2::store::PrairieDb]prairie.meadow_plot.sward_score, 3),
                 'C: patchy sward',
                 case(
                 equal([test::coralprairie2::store::PrairieDb]prairie.meadow_plot.sward_score, 4),
                 'D: mixed sward',
                 case(
                 equal([test::coralprairie2::store::PrairieDb]prairie.meadow_plot.sward_score, 5),
                 'E: dense sward',
                 case(
                 equal([test::coralprairie2::store::PrairieDb]prairie.meadow_plot.sward_score, 6),
                 'F: tall sward',
                 case(
                 equal([test::coralprairie2::store::PrairieDb]prairie.meadow_plot.sward_score, 7),
                 'G: tussock sward',
                 case(
                 equal([test::coralprairie2::store::PrairieDb]prairie.meadow_plot.sward_score, 8),
                 'H: scrubbing sward',
                 'I: unclassified sward'
               )
               )
               )
               )
               )
               )
               )
               )
               ),
    regionName: [test::coralprairie2::store::PrairieDb]@PlotRegion | [test::coralprairie2::store::PrairieDb]prairie.region.region_name,
    rainfallMillimetres: [test::coralprairie2::store::PrairieDb]@PlotRegion > @RegionClimate | [test::coralprairie2::store::PrairieDb]prairie.climate_norm.rainfall_mm,
    surveyProgramme: 'prairie-baseline'
  }

  *test::coralprairie2::domain::GrasslandRegion[region]: Relational
  {
    ~primaryKey
    (
      [test::coralprairie2::store::PrairieDb]prairie.region.region_code
    )
    ~mainTable [test::coralprairie2::store::PrairieDb]prairie.region
    regionCode: [test::coralprairie2::store::PrairieDb]prairie.region.region_code,
    regionName: [test::coralprairie2::store::PrairieDb]prairie.region.region_name,
    biome: [test::coralprairie2::store::PrairieDb]prairie.region.biome
  }

  *test::coralprairie2::domain::SwardSample[sample]: Relational
  {
    ~primaryKey
    (
      [test::coralprairie2::store::PrairieDb]prairie.sward_sample.sample_id,
      [test::coralprairie2::store::PrairieDb]prairie.sward_sample.batch_id
    )
    ~mainTable [test::coralprairie2::store::PrairieDb]prairie.sward_sample
    sampleId: [test::coralprairie2::store::PrairieDb]prairie.sward_sample.sample_id,
    batchId: [test::coralprairie2::store::PrairieDb]prairie.sward_sample.batch_id,
    speciesCount: [test::coralprairie2::store::PrairieDb]prairie.sward_sample.species_count,
    biomassKilograms: [test::coralprairie2::store::PrairieDb]prairie.sward_sample.biomass_kg,
    sampledOn: [test::coralprairie2::store::PrairieDb]prairie.sward_sample.sampled_on
  }

  test::coralprairie2::domain::Plot_Sample: Relational
  {
    AssociationMapping
    (
      samples[plot, sample]: [test::coralprairie2::store::PrairieDb]@PlotSample,
      plot[sample, plot]: [test::coralprairie2::store::PrairieDb]@PlotSample
    )
  }

  test::coralprairie2::domain::Plot_Region: Relational
  {
    AssociationMapping
    (
      region[plot, region]: [test::coralprairie2::store::PrairieDb]@PlotRegion,
      plots[region, plot]: [test::coralprairie2::store::PrairieDb]@PlotRegion
    )
  }

  testSuites:
  [
    swardBandSuite:
    {
      function: |test::coralprairie2::domain::MeadowPlot.all()->project(
        [
          x|$x.plotCode,
          x|$x.swardBand,
          x|$x.regionName,
          x|$x.rainfallMillimetres,
          x|$x.surveyProgramme
        ],
        [
          'Plot/Code',
          'Plot/Sward Band',
          'Region/Name',
          'Region/Rainfall',
          'Plot/Programme'
        ]
      )->sort([asc('Plot/Code')]);
      tests:
      [
        everySwardArmIsReached:
        {
          data:
          [
            test::coralprairie2::store::PrairieDb: Reference
              #{
                test::coralprairie2::data::PrairieFixture
              }#
          ];
          asserts:
          [
            armsAndNullFallback: EqualToJson
              #{
                expected: ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Plot/Code":"P-01","Plot/Sward Band":"A: bare sward","Region/Name":"North Prairie","Region/Rainfall":700,"Plot/Programme":"prairie-baseline"},{"Plot/Code":"P-02","Plot/Sward Band":"B: sparse sward","Region/Name":"North Prairie","Region/Rainfall":700,"Plot/Programme":"prairie-baseline"},{"Plot/Code":"P-03","Plot/Sward Band":"C: patchy sward","Region/Name":"North Prairie","Region/Rainfall":700,"Plot/Programme":"prairie-baseline"},{"Plot/Code":"P-04","Plot/Sward Band":"D: mixed sward","Region/Name":"West Prairie","Region/Rainfall":450,"Plot/Programme":"prairie-baseline"},{"Plot/Code":"P-05","Plot/Sward Band":"E: dense sward","Region/Name":"West Prairie","Region/Rainfall":450,"Plot/Programme":"prairie-baseline"},{"Plot/Code":"P-06","Plot/Sward Band":"F: tall sward","Region/Name":"North Prairie","Region/Rainfall":700,"Plot/Programme":"prairie-baseline"},{"Plot/Code":"P-07","Plot/Sward Band":"G: tussock sward","Region/Name":"West Prairie","Region/Rainfall":450,"Plot/Programme":"prairie-baseline"},{"Plot/Code":"P-08","Plot/Sward Band":"H: scrubbing sward","Region/Name":"North Prairie","Region/Rainfall":700,"Plot/Programme":"prairie-baseline"},{"Plot/Code":"P-09","Plot/Sward Band":null,"Region/Name":"West Prairie","Region/Rainfall":450,"Plot/Programme":"prairie-baseline"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
