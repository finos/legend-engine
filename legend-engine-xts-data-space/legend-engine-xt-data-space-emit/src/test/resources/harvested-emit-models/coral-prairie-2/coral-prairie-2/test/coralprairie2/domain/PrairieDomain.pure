###Pure
import test::coralprairie2::domain::*;

Class test::coralprairie2::domain::MeadowPlot
{
  plotCode: String[1];
  plotName: String[1];
  batchId: Integer[1];
  hectares: Float[1];
  swardBand: String[0..1];
  regionName: String[0..1];
  rainfallMillimetres: Integer[0..1];
  surveyProgramme: String[1];
}

Class test::coralprairie2::domain::SwardSample
{
  sampleId: Integer[1];
  batchId: Integer[1];
  speciesCount: Integer[1];
  biomassKilograms: Float[1];
  sampledOn: StrictDate[1];
}

Class test::coralprairie2::domain::GrasslandRegion
{
  regionCode: String[1];
  regionName: String[1];
  biome: String[1];
}

Association test::coralprairie2::domain::Plot_Sample
{
  samples: SwardSample[*];
  plot: MeadowPlot[0..1];
}

Association test::coralprairie2::domain::Plot_Region
{
  plots: MeadowPlot[*];
  region: GrasslandRegion[0..1];
}
