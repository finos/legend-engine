###DataSpace
DataSpace test::coralprairie2::dataspace::PrairieDataSpace
{
  executionContexts:
  [
    {
      name: 'survey';
      description: 'Survey tier binding the prairie store to the plot mapping and the warehouse runtime the register endpoint executes against.';
      mapping: test::coralprairie2::mapping::PrairieMapping;
      defaultRuntime: test::coralprairie2::runtime::PrairieRuntime;
    }
  ];
  defaultExecutionContext: 'survey';
  title: 'Coral Prairie Grassland Survey';
  description: 'A curated entry point over the prairie grassland survey domain - meadow plots with their derived sward vocabulary, the grassland regions reached over one join hop and the climate norms reached over two.';
  elements:
  [
    test::coralprairie2::domain
  ];
  executables:
  [
    {
      id: 1;
      title: 'Plot sward register';
      description: 'The featured endpoint that narrows the plot extent to one survey batch and the named regions.';
      executable: test::coralprairie2::service::PlotSwardRegister;
    }
  ];
}
