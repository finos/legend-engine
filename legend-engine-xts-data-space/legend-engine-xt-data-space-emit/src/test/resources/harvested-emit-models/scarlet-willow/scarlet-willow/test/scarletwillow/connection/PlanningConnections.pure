###Connection
RelationalDatabaseConnection test::scarletwillow::connection::PlanningPrimaryConnection
{
  store: test::scarletwillow::store::PlanningDatabase;
  type: SqlServer;
  specification: Static
  {
    name: 'PLANNING_PRIMARY_DB';
    host: 'planning-primary.civic.internal';
    port: 1433;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'planning/planning-primary.civic.internal';
  };
}

RelationalDatabaseConnection test::scarletwillow::connection::PlanningSecondaryConnection
{
  store: test::scarletwillow::store::PlanningDatabase;
  type: SqlServer;
  specification: Static
  {
    name: 'PLANNING_SECONDARY_DB';
    host: 'planning-secondary.civic.internal';
    port: 1433;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'planning/planning-secondary.civic.internal';
  };
}
