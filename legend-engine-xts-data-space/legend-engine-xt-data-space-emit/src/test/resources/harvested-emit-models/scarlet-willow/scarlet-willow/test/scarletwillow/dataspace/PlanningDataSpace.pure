###DataSpace
DataSpace test::scarletwillow::dataspace::PlanningDataSpace
{
  executionContexts:
  [
    {
      name: 'default';
      description: 'Curated entry point over the municipal tree-inventory model, resolving the relational mapping against the primary planning runtime.';
      mapping: test::scarletwillow::mapping::PlanningMapping;
      defaultRuntime: test::scarletwillow::runtime::PlanningPrimaryRuntime;
    }
  ];
  defaultExecutionContext: 'default';
  title: 'Municipal Tree Inventory';
  description: 'A single curated view of the municipal tree-inventory domain, pairing the cross-schema relational mapping with the primary environment runtime that the keyed services select between.';
}
