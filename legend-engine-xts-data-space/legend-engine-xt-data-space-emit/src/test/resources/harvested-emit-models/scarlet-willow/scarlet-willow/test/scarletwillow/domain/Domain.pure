###Pure
import test::scarletwillow::domain::*;

Class test::scarletwillow::domain::Tree
{
  treeTag: String[1];
  plantedOn: StrictDate[1];
  heightMeters: Float[1];
  zoneName: String[0..1];
  activeSiteName: String[0..1];
}

Class test::scarletwillow::domain::Site
{
  siteCode: String[1];
  siteName: String[1];
}

Class test::scarletwillow::domain::District
{
  districtCode: String[1];
  districtName: String[1];
}

Class test::scarletwillow::domain::Region
{
  regionCode: String[1];
  regionName: String[1];
}

Class test::scarletwillow::domain::Species
{
  commonName: String[1];
}

Class test::scarletwillow::domain::SpeciesGroup
{
  groupCode: String[1];
  groupName: String[1];
}

Class test::scarletwillow::domain::TreeStatus
{
  treeTag: String[1];
  lifecycleStatus: String[1];
}

Association test::scarletwillow::domain::Tree_Site
{
  site: Site[1];
  trees: Tree[*];
}

Association test::scarletwillow::domain::Site_District
{
  district: District[1];
  sites: Site[*];
}

Association test::scarletwillow::domain::District_Region
{
  region: Region[1];
  districts: District[*];
}

Association test::scarletwillow::domain::Tree_Species
{
  species: Species[1];
  specimens: Tree[*];
}

Association test::scarletwillow::domain::Species_Group
{
  group: SpeciesGroup[1];
  members: Species[*];
}
