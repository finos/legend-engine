###Relational
Database test::verdantharbor2::store::HarborRegisterDB
(
  Schema harbor
  (
    Table berth_slot
    (
      berth_id BIGINT PRIMARY KEY,
      berth_code VARCHAR(24),
      berth_name VARCHAR(120),
      draft_limit_m DOUBLE,
      opened_on DATE,
      surveyed_at TIMESTAMP,
      lit_flag BIT
    )
    Table crane_unit
    (
      crane_id BIGINT PRIMARY KEY,
      crane_code VARCHAR(24),
      crane_model VARCHAR(80),
      lift_tonnes DOUBLE,
      commissioned_on DATE,
      inspected_at TIMESTAMP,
      rail_mounted_flag BIT
    )
    Table tide_reading
    (
      reading_id BIGINT PRIMARY KEY,
      gauge_code VARCHAR(24),
      water_level_m DOUBLE,
      observed_on DATE,
      recorded_at TIMESTAMP,
      provisional_flag BIT
    )
    Table dredge_survey
    (
      survey_id BIGINT PRIMARY KEY,
      channel_code VARCHAR(24),
      cleared_volume_m3 DOUBLE,
      surveyed_on DATE,
      silt_note VARCHAR(240)
    )
  )
)
