###Connection
RelationalDatabaseConnection test::verdantharbor2::connection::HarborRegisterConnection
{
  store: test::verdantharbor2::store::HarborRegisterDB;
  type: Snowflake;
  quoteIdentifiers: false;
  specification: Snowflake
  {
    name: 'HARBOR_REGISTER';
    account: 'harbor_register_account';
    warehouse: 'HARBOR_REGISTER_WH';
    region: 'eu-west-1';
    cloudType: 'aws';
    accountType: MultiTenant;
    organization: 'harbour_authority_org';
    role: 'HARBOR_REGISTER_READER';
  };
  auth: OAuth
  {
    oauthKey: 'harbor_register_oauth_key';
    scopeName: 'SESSION:ROLE:HARBOR_REGISTER_READER';
  };
}
