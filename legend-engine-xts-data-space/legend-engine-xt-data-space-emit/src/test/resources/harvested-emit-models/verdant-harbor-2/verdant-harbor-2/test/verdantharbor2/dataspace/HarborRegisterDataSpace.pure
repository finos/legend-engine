###DataSpace
DataSpace test::verdantharbor2::dataspace::HarborRegisterDataSpace
{
  executionContexts:
  [
    {
      name: 'harbourRegister';
      description: 'Register tier - every independently keyed harbour table exposed through the one relational mapping and its single warehouse connection.';
      mapping: test::verdantharbor2::mapping::HarborRegisterMapping;
      defaultRuntime: test::verdantharbor2::runtime::HarborRegisterRuntime;
    }
  ];
  defaultExecutionContext: 'harbourRegister';
  title: 'Verdant Harbour Register';
  description: 'A governed entry point over the mooring berths, quayside cranes, tide-gauge readings and channel dredging surveys of a harbour register, each backed by its own independently keyed table in a single schema.';
  supportInfo: Email
  {
    address: 'harbour-register-desk@harbourregister.invalid';
  };
}
