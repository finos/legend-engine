###Service
Service demo::verdantotter2::service::LockChambersAsOf
{
  pattern: '/waterway/v1/lock-chambers/{processingDate}';
  title: 'Waterway - Lock Chambers As Of';
  owners:
  [
    'waterway-navigation',
    'chamber-survey'
  ];
  documentation: 'Returns the lock chambers whose processing window is in force on the requested processing date, projecting the chamber, its reach code, the reach name reached across the declared join, the rise and the commissioning date.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: {processingDate: StrictDate[1]|demo::verdantotter2::domain::LockChamber.all($processingDate)->project(
      [
        l|$l.lockCode,
        l|$l.lockName,
        l|$l.reachCode,
        l|$l.reachName,
        l|$l.riseMetres,
        l|$l.commissionedOn
      ],
      [
        'Lock',
        'Name',
        'Reach',
        'ReachName',
        'Rise',
        'Commissioned'
      ]
    )};
    mapping: demo::verdantotter2::mapping::PassageMapping;
    runtime: demo::verdantotter2::runtime::PassageRuntime;
  }
  testSuites:
  [
    lockChambersAsOfSuite:
    {
      data:
      [
        connections:
        [
          passageConnection:
            Relational
            #{
              navigation.reach:
                'reach_code,reach_name,region_name,summit_metres\n'+
                'RE-01,Fenway Reach,Northern Levels,42.5\n';

              waterway.lock_chamber:
                'lock_id,lock_code,lock_name,reach_code,chamber_length_metres,rise_metres,commissioned_on,surveyed_at,in_z,out_z\n'+
                '1,LK-001,Fenway Bottom Lock,RE-01,21.50,2.75,1846-04-12,2026-02-11 09:15:00,2026-04-01,9999-12-31\n'+
                '2,LK-002,Millpond Staircase,RE-02,19.00,3.10,1852-09-01,2026-06-02 11:00:00,2025-01-01,2025-12-31\n';
            }#
        ]
      ]
      tests:
      [
        inForceChamberWithJoinedReach:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            processingDate = %2026-05-01
          ]
          asserts:
          [
            oneChamberWithReachName:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Lock":"LK-001","Name":"Fenway Bottom Lock","Reach":"RE-01","ReachName":"Fenway Reach","Rise":2.75,"Commissioned":"1846-04-12"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
