###Runtime
Runtime demo::sunlitcove6::runtime::CoveWarehouseRuntime
{
  mappings:
  [
    demo::sunlitcove6::mapping::CoveSurveyMapping
  ];
  connections:
  [
    demo::sunlitcove6::store::CoveSurveyDB:
    [
      coveWarehouse: demo::sunlitcove6::connection::CoveWarehouseConnection
    ]
  ];
}

Runtime demo::sunlitcove6::runtime::CoveRetainedRuntime
{
  mappings:
  [
    demo::sunlitcove6::mapping::CoveSurveyMapping
  ];
  connections:
  [
    demo::sunlitcove6::store::CoveSurveyDB:
    [
      coveWarehouse: demo::sunlitcove6::connection::CoveRetainedConnection
    ]
  ];
}
