###Connection
RelationalDatabaseConnection demo::sunlitcove6::connection::CoveWarehouseConnection
{
  store: demo::sunlitcove6::store::CoveSurveyDB;
  type: Snowflake;
  timezone: 'UTC';
  quoteIdentifiers: false;
  specification: Snowflake
  {
    name: 'SUNLIT_COVE_SURVEY';
    account: 'sunlit_cove_account';
    warehouse: 'SUNLIT_COVE_SURVEY_WH';
    region: 'eu-west-1';
    cloudType: 'aws';
    role: 'COVE_SURVEY_READER';
  };
  auth: OAuth
  {
    scopeName: 'session:role-cove-survey-reader';
    oauthKey: 'sunlitCoveOauthKey';
  };
}

RelationalDatabaseConnection demo::sunlitcove6::connection::CoveRetainedConnection
{
  store: demo::sunlitcove6::store::CoveSurveyDB;
  type: SqlServer;
  timezone: 'UTC';
  specification: Static
  {
    name: 'cove_retained';
    host: 'example-cove-retained-host';
    port: 1433;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'coveretainedprincipal';
  };
}
