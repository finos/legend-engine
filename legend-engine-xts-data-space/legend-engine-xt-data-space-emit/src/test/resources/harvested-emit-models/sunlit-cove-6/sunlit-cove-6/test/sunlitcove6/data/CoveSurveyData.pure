      'P-02,ST-01,PATCH-02,bull,SURGE,232,2,2024-03-02,2026-05-02 08:00:00.000,\n'+
      'P-03,ST-01,PATCH-03,ribbon,SURGE,228,3,2024-03-03,2026-05-03 08:00:00.000,Regrowth plot\n'+
      'P-04,ST-01,PATCH-04,bull,SHELTERED,224,4,2024-03-04,2026-05-03 08:00:00.000,Sheltered lee\n'+
      'P-05,ST-02,PATCH-05,feather,SURGE,216,5,2024-03-05,2026-05-03 08:00:00.000,Southern shoal\n'+
      'P-06,ST-01,PATCH-06,bull,SURGE,0,6,2024-03-06,2026-05-03 08:00:00.000,Storm stripped\n'+
