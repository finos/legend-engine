      'P-08,ST-01,PATCH-08,bull,SURGE,208,8,2024-03-08,2026-12-01 08:00:00.000,Dived after the window\n'+
      'P-09,ST-01,PATCH-09,feather,SURGE,204,9,2024-03-09,2026-05-04 08:00:00.000,Off the scored range\n';

    survey.dive_log:
