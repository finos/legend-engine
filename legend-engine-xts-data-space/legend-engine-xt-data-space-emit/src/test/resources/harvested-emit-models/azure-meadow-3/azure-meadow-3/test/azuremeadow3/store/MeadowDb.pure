###Relational
Database test::azuremeadow3::store::MeadowDb
(
  Schema meadowside
  (
    Table hay_cut
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )

      cut_id INTEGER PRIMARY KEY,
      cut_code VARCHAR(24) NOT NULL,
      parcel_code VARCHAR(24),
      sward_code VARCHAR(16),
      dry_code VARCHAR(16),
      bale_tally INTEGER,
      moisture_pct DOUBLE,
      stem_len_cm DOUBLE,
      cut_note VARCHAR(128),
      cut_on DATE,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )

    Table parcel_book
    (
      parcel_id INTEGER PRIMARY KEY,
      parcel_code VARCHAR(24) NOT NULL,
      parcel_name VARCHAR(96),
      terrace_code VARCHAR(24),
      parcel_kind VARCHAR(16),
      access_code VARCHAR(16),
      plot_tally INTEGER
    )

    Table alpine_parcel_detail
    (
      parcel_id INTEGER PRIMARY KEY,
      slope_pct DOUBLE,
      aspect_kind VARCHAR(24)
    )

    View terrace_load_vw
    (
      ~groupBy
      (
        meadowside.parcel_book.terrace_code
      )
      terrace_code: meadowside.parcel_book.terrace_code PRIMARY KEY,
      parcel_count: count(meadowside.parcel_book.parcel_id),
      plot_total: sum(meadowside.parcel_book.plot_tally)
    )
  )

  Schema terraceside
  (
    Table terrace_book
    (
      terrace_code VARCHAR(24) PRIMARY KEY,
      terrace_name VARCHAR(96),
      keeper_code VARCHAR(24)
    )

    Table keeper_roster
    (
      keeper_code VARCHAR(24) PRIMARY KEY,
      keeper_name VARCHAR(96)
    )
  )

  Filter AlpineParcelFilter(meadowside.parcel_book.parcel_kind = 'ALPINE')

  Join Cut_Parcel(meadowside.hay_cut.parcel_code = meadowside.parcel_book.parcel_code)
  Join Parcel_AlpineDetail(meadowside.parcel_book.parcel_id = meadowside.alpine_parcel_detail.parcel_id)
  Join Parcel_Terrace(meadowside.parcel_book.terrace_code = terraceside.terrace_book.terrace_code and toUpper(trim(terraceside.terrace_book.terrace_code)) != 'RETIRED')
  Join Terrace_Keeper(terraceside.terrace_book.keeper_code = terraceside.keeper_roster.keeper_code)
)
