    )
    ~mainTable [test::coralcove2::store::ReefDB]reef.reef_site
    siteCode: [test::coralcove2::store::ReefDB]reef.reef_site.site_code,
    siteName: [test::coralcove2::store::ReefDB]reef.reef_site.site_name,
    coveName: [test::coralcove2::store::ReefDB]@cove_site | [test::coralcove2::store::ReefDB]reef.cove.cove_name,
    depthM: [test::coralcove2::store::ReefDB]reef.reef_site.depth_m,
    establishedOn: [test::coralcove2::store::ReefDB]reef.reef_site.established_on
