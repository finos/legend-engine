###Relational
Database test::wistfullantern3::store::EstateDB
(
  Schema estate
  (
    Table tree_record
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z, INFINITY_DATE = %9999-12-31)
      )
      tree_key VARCHAR(24) PRIMARY KEY,
      tree_ref VARCHAR(20) NOT NULL,
      park_name VARCHAR(60) NOT NULL,
      species_label VARCHAR(60) NOT NULL,
      canopy_class VARCHAR(20) NOT NULL,
      girth_cm DECIMAL(9, 2) NOT NULL,
      spread_m DOUBLE NOT NULL,
      condition_score INTEGER NOT NULL,
      planted_on DATE NOT NULL,
      surveyed_at TIMESTAMP,
      warden_note VARCHAR(200),
      in_z DATE NOT NULL,
      out_z DATE NOT NULL
    )

    Table park_bench
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z, INFINITY_DATE = %9999-12-31)
      )
      bench_key VARCHAR(24) PRIMARY KEY,
      bench_ref VARCHAR(20) NOT NULL,
      park_name VARCHAR(60) NOT NULL,
      timber_kind VARCHAR(20) NOT NULL,
      seat_count INTEGER NOT NULL,
      plaque_text VARCHAR(120),
      installed_on DATE NOT NULL,
      in_z DATE NOT NULL,
      out_z DATE NOT NULL
    )

    Table path_segment
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z, INFINITY_DATE = %9999-12-31)
      )
      segment_key VARCHAR(24) PRIMARY KEY,
      segment_ref VARCHAR(20) NOT NULL,
      park_name VARCHAR(60) NOT NULL,
      surface_kind VARCHAR(20) NOT NULL,
      length_m DOUBLE NOT NULL,
      width_m DECIMAL(6, 2) NOT NULL,
      inspected_at TIMESTAMP,
      in_z DATE NOT NULL,
      out_z DATE NOT NULL
    )
  )
)
