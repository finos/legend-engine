###Connection
RelationalDatabaseConnection test::wistfullantern3::connection::EstateWarehouseConnection
{
  store: test::wistfullantern3::store::EstateDB;
  type: Snowflake;
  timezone: +0000;
  quoteIdentifiers: false;
  specification: Snowflake
  {
    name: 'PARK_ESTATE_DB';
    account: 'park_estate_account';
    warehouse: 'PARK_ESTATE_WH';
    region: 'eu-west-2';
    cloudType: 'aws';
    accountType: MultiTenant;
    organization: 'parks_estate_org';
    role: 'PARK_ESTATE_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'park_estate_reader';
    privateKeyVaultReference: 'park-estate-private-key';
    passPhraseVaultReference: 'park-estate-pass-phrase';
  };
}
