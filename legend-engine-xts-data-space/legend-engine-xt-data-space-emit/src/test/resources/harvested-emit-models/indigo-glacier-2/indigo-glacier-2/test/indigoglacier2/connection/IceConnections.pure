###Connection
RelationalDatabaseConnection test::indigoglacier2::connection::IceRegistryConnection
{
  store: test::indigoglacier2::store::IceRegistryDb;
  type: Sybase;
  quoteIdentifiers: false;
  specification: Static
  {
    name: 'ICE_REGISTRY';
    host: 'ice-registry-host.example.invalid';
    port: 5000;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'sybase/ice-registry-host.example.invalid';
  };
}

