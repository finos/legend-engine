###Relational
Database test::indigoglacier2::store::IceArchiveDb
(
  Schema archive
  (
    Table reading_history
    (
      reading_code VARCHAR(12) PRIMARY KEY,
      archived_at TIMESTAMP PRIMARY KEY,
      stake_code VARCHAR(12),
      exposed_cm INTEGER,
      history_state VARCHAR(8)
    )
    Table core_history
    (
      core_code VARCHAR(12) PRIMARY KEY,
      archived_on DATE PRIMARY KEY,
      core_length_m DOUBLE,
      shelf_label VARCHAR(24)
    )
  )

  Filter CurrentReadingFilter(archive.reading_history.history_state = 'CURRENT')
  Filter ShelvedCoreFilter(archive.core_history.shelf_label is not null and archive.core_history.core_length_m >= 1.0)
)
