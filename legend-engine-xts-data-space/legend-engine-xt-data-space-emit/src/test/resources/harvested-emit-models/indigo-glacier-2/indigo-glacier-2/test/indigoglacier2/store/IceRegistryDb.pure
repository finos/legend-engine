###Relational
Database test::indigoglacier2::store::IceRegistryDb
(
  Schema registry
  (
    Table glacier_site
    (
      site_code VARCHAR(12) PRIMARY KEY,
      site_name VARCHAR(48),
      valley_name VARCHAR(48),
      opened_on DATE,
      site_state VARCHAR(8)
    )
    Table field_crew
    (
      crew_code VARCHAR(12) PRIMARY KEY,
      crew_name VARCHAR(48),
      home_hut VARCHAR(48),
      crew_size INTEGER,
      crew_state VARCHAR(8)
    )
    Table stake_post
    (
      stake_code VARCHAR(12) PRIMARY KEY,
      site_code VARCHAR(12) PRIMARY KEY,
      installed_at TIMESTAMP,
      post_height DOUBLE,
      post_state VARCHAR(10)
    )
  )

  Filter OpenSiteFilter(registry.glacier_site.site_state = 'OPEN' and registry.glacier_site.site_name is not null)
  Filter ActiveCrewFilter(registry.field_crew.crew_state = 'ACTIVE' and registry.field_crew.crew_size >= 2)
  Filter StandingStakeFilter(registry.stake_post.post_state = 'STANDING' and registry.stake_post.post_height > 0.0)
)
