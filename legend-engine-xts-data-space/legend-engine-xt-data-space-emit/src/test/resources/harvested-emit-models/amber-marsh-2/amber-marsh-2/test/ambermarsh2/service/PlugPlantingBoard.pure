###Service
Service test::ambermarsh2::service::PlugPlantingBoard
{
  pattern: '/ambermarsh2/v1/plugplanting/{minPlugTally}';
  ownership: UserList { users: ['moorland-planting-desk'] };
  documentation: 'Reads the moss plug batch register, keeps the batches that reach a caller-supplied plug tally, and returns a normalised batch label beside the tally expressed in whole trays so that the planting crew reads delivery units rather than plug counts.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: {minPlugTally: Integer[1], mixToken: String[0..1]|test::ambermarsh2::domain::SphagnumPlugBatch.all()->filter(
      b|($b.plugTally >= $minPlugTally) &&
        ($mixToken->isEmpty() || ($b.speciesMix == $mixToken->toOne()))
    )->project(
      [
        b|$b.batchCode->toUpper(),
        b|$b.speciesMix->trim()->toUpper() + ' [' + $b.batchCode->trim() + ']',
        b|$b.plugTally,
        b|($b.plugTally + 143) / 144,
        b|$b.plantedOn
      ],
      [
        'Batch',
        'MixLabel',
        'PlugTally',
        'TrayTally',
        'PlantedOn'
      ]
    )->sort(
      [
        desc('PlugTally'),
        asc('Batch')
      ]
    )};
    mapping: test::ambermarsh2::mapping::MoorlandMapping;
    runtime: test::ambermarsh2::runtime::MoorlandCoreRuntime;
  }
}
