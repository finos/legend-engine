###Service
Service test::ambermarsh2::service::ErosionPinExposureBoard
{
  pattern: '/ambermarsh2/v1/erosionpin/{asOf}';
  ownership: UserList { users: ['moorland-monitoring-desk'] };
  documentation: 'Reads the erosion pin register over the two survey seasons preceding a caller-supplied instant, drops the readings whose exposure is below the reporting floor, and returns the exposure both as recorded and rescaled per season together with the reading age in days.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: {asOf: StrictDate[1]|test::ambermarsh2::domain::ErosionPinReading.all()->filter(
      r|($r.exposedMm > 5) &&
        ($r.readOn >= $asOf->adjust(-2, DurationUnit.YEARS)) &&
        ($r.readOn <= $asOf)
    )->project(
      [
        r|$r.readingCode->toUpper(),
        r|$r.pinRef->trim()->toUpper(),
        r|$r.exposedMm,
        r|($r.exposedMm * 12) / (dateDiff($r.readOn, $asOf, DurationUnit.MONTHS) + 1),
        r|dateDiff($r.readOn, $asOf, DurationUnit.DAYS)
      ],
      [
        'Reading',
        'Pin',
        'ExposedMm',
        'ExposedMmPerYear',
        'ReadingAgeDays'
      ]
    )->sort(
      [
        desc('ExposedMmPerYear'),
        asc('Pin')
      ]
    )};
    mapping: test::ambermarsh2::mapping::MoorlandMapping;
    runtime: test::ambermarsh2::runtime::MoorlandCoreRuntime;
  }
}
