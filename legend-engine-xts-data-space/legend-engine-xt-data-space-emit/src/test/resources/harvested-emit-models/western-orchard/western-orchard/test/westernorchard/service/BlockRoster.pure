###Service
Service demo::westernorchard::service::BlockRoster
{
  pattern: '/orchard/v1/blocks';
  title: 'Western Orchard - Planted Block Roster';
  owners:
  [
    'example-orchard-estate-team',
    'example-orchard-agronomy'
  ];
  documentation: 'Projects the planted block roster above a requested planted area, carrying the boolean irrigation flag and the variety label reached across the planting association.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {minHectares: Float[1]|demo::westernorchard::domain::OrchardBlock.all()->filter(
      b|$b.hectares->toOne() >= $minHectares
    )->project(
      [
        b|$b.blockCode,
        b|$b.cultivar.cultivarName,
        b|$b.irrigated
      ],
      [
        'BlockCode',
        'CultivarName',
        'Irrigated'
      ]
    )->sort(
      [
        asc('BlockCode')
      ]
    )};
    mapping: demo::westernorchard::mapping::OrchardMapping;
    runtime: demo::westernorchard::runtime::OrchardRuntime;
  }
  testSuites:
  [
    blockRosterSuite:
    {
      data:
      [
        connections:
        [
          orchardWarehouse:
            Relational
            #{
              orchard.cultivar:
                'cultivar_code,cultivar_name,rootstock\n'+
                'CV-1,Braeburn,M9\n'+
                'CV-2,Gala,M26\n';

              orchard.orchard_block:
                'block_code,block_name,hectares,planted_on,irrigated,cultivar_code\n'+
                'BK-01,North Slope,4.5,2018-04-12,true,CV-1\n'+
                'BK-02,Windbreak Row,2.25,2020-09-30,false,CV-2\n';
            }#
        ]
      ]
      tests:
      [
        largeBlocksOnly:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            minHectares = 3.0
          ]
          asserts:
          [
            blockRow:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"BlockCode":"BK-01","CultivarName":"Braeburn","Irrigated":true}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
