###DataSpace
DataSpace demo::westernorchard::dataspace::OrchardDataSpace
{
  executionContexts:
  [
    {
      name: 'estateWarehouse';
      description: 'The curated orchard estate model bound to the warehouse-class execution target.';
      mapping: demo::westernorchard::mapping::OrchardMapping;
      defaultRuntime: demo::westernorchard::runtime::OrchardRuntime;
    }
  ];
  defaultExecutionContext: 'estateWarehouse';
  title: 'Western Orchard Estate';
  description: 'A governed entry point over the orchard estate: planted blocks, their grafted varieties, the lots picked from them and the rostered picking crews, with the layout element and the two featured projection endpoints a consumer should see.';
  diagrams:
  [
    {
      title: 'Orchard estate layout';
      description: 'Positions the four domain classes and the three relationship views that connect them.';
      diagram: demo::westernorchard::diagram::OrchardDiagram;
    }
  ];
  elements:
  [
    demo::westernorchard::domain
  ];
  executables:
  [
    {
      id: 1;
      title: 'Harvest lots by block';
      description: 'Featured endpoint returning the lots picked from one block with their variety and crew labels.';
      executable: demo::westernorchard::service::LotLookup;
    },
    {
      id: 2;
      title: 'Planted block roster';
      description: 'Featured endpoint returning the planted blocks above a requested area.';
      executable: demo::westernorchard::service::BlockRoster;
    }
  ];
  supportInfo: Email
  {
    address: 'orchard-estate-support@example.invalid';
    documentationUrl: 'https://example.invalid/docs/orchard-estate';
  };
}
