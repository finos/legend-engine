###Relational
Database demo::westernorchard::store::OrchardDB
(
  Schema orchard
  (
    Table cultivar
    (
      cultivar_code VARCHAR(24) PRIMARY KEY,
      cultivar_name VARCHAR(120),
      rootstock VARCHAR(64)
    )

    Table orchard_block
    (
      block_code VARCHAR(24) PRIMARY KEY,
      block_name VARCHAR(120),
      hectares FLOAT,
      planted_on DATE,
      irrigated BIT,
      cultivar_code VARCHAR(24)
    )

    Table picking_crew
    (
      crew_code VARCHAR(24) PRIMARY KEY,
      crew_name VARCHAR(120),
      headcount INTEGER
    )

    Table harvest_lot
    (
      lot_ref VARCHAR(24) PRIMARY KEY,
      block_code VARCHAR(24),
      crew_code VARCHAR(24),
      picked_on DATE,
      bin_count INTEGER,
      grade_label VARCHAR(32)
    )
  )

  Join Block_Cultivar(orchard.orchard_block.cultivar_code = orchard.cultivar.cultivar_code)
  Join Block_Lot(orchard.orchard_block.block_code = orchard.harvest_lot.block_code)
  Join Lot_Crew(orchard.harvest_lot.crew_code = orchard.picking_crew.crew_code)
)
