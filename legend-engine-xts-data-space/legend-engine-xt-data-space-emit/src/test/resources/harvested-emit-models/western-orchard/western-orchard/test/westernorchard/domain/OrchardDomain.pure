###Pure
import demo::westernorchard::domain::*;

Class {meta::pure::profiles::doc.doc = 'A grafted fruit variety planted across orchard blocks.'} demo::westernorchard::domain::Cultivar
{
  cultivarCode: String[1];
  cultivarName: String[1];
  rootstock: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A planted block of the orchard estate.'} demo::westernorchard::domain::OrchardBlock
{
  blockCode: String[1];
  blockName: String[1];
  hectares: Float[0..1];
  plantedOn: StrictDate[0..1];
  irrigated: Boolean[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A picking crew rostered against harvest lots.'} demo::westernorchard::domain::PickingCrew
{
  crewCode: String[1];
  crewName: String[1];
  headcount: Integer[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A single picked lot of fruit taken off one block.'} demo::westernorchard::domain::HarvestLot
{
  lotRef: String[1];
  pickedOn: StrictDate[0..1];
  binCount: Integer[0..1];
  gradeLabel: String[0..1];
}

Association {meta::pure::profiles::doc.doc = 'Associates a block with the variety planted on it.'} demo::westernorchard::domain::BlockCultivar
{
  cultivar: Cultivar[1];
  plantedBlocks: OrchardBlock[*];
}

Association {meta::pure::profiles::doc.doc = 'Associates a block with the lots picked from it.'} demo::westernorchard::domain::BlockLot
{
  block: OrchardBlock[1];
  lots: HarvestLot[*];
}

Association {meta::pure::profiles::doc.doc = 'Associates a lot with the crew that picked it.'} demo::westernorchard::domain::LotCrew
{
  crew: PickingCrew[1];
  pickedLots: HarvestLot[*];
}
