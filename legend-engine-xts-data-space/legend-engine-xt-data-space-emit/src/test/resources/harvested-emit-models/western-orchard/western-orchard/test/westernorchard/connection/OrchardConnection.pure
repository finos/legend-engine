###Connection
RelationalDatabaseConnection demo::westernorchard::connection::OrchardWarehouseConnection
{
  store: demo::westernorchard::store::OrchardDB;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'WESTERN_ORCHARD_DB';
    account: 'orchard_estate_account';
    warehouse: 'ORCHARD_QUERY_WH';
    region: 'us-west-2';
    cloudType: 'aws';
    role: 'ORCHARD_READER_ROLE';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'ORCHARD_ESTATE_USER';
    privateKeyVaultReference: 'orchard-estate-private-key';
    passPhraseVaultReference: 'orchard-estate-pass-phrase';
  };
}
