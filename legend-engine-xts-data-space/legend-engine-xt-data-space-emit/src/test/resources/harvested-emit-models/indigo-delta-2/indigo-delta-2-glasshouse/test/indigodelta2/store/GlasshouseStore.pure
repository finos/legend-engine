###Relational
Database test::indigodelta2::store::GlasshouseDB
(
  Schema garden
  (
    Table glasshouse
    (
      house_id VARCHAR(20) PRIMARY KEY,
      house_code VARCHAR(20) NOT NULL,
      house_name VARCHAR(60) NOT NULL,
      climate_lane VARCHAR(20) NOT NULL
    )
    Table irrigation_cycle
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      cycle_id VARCHAR(20) PRIMARY KEY,
      cycle_code VARCHAR(20) NOT NULL,
      house_id VARCHAR(20) NOT NULL,
      watering_mode VARCHAR(20) NOT NULL,
      water_litres INTEGER NOT NULL,
      minutes_run INTEGER NOT NULL,
      moisture_target DOUBLE NOT NULL,
      started_on DATE NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
  )

  Join Cycle_Glasshouse(garden.irrigation_cycle.house_id = garden.glasshouse.house_id)
)
