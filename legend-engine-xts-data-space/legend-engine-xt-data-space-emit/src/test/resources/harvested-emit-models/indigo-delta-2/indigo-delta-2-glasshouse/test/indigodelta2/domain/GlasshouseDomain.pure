###Pure
import meta::pure::profiles::*;
import test::indigodelta2::domain::*;

Class {meta::pure::profiles::doc.doc = 'A glasshouse section with a stable code, a descriptive name and a climate lane used to organize irrigation work.'} test::indigodelta2::domain::Glasshouse
{
  houseCode: String[1];
  houseName: String[1];
  climateLane: String[1];
}

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'A watering cycle whose measurements and operating assignment are effective over the garden calendar.'} test::indigodelta2::domain::IrrigationCycle
{
  cycleCode: String[1];
  houseCode: String[1];
  wateringMode: String[1];
  waterLitres: Integer[1];
  minutesRun: Integer[1];
  moistureTarget: Float[1];
  startedOn: StrictDate[1];

  cycleLabel()
  {
    $this.cycleCode->toUpper()->trim()->substring(0, 7)
  }: String[1];

  moistureBand()
  {
    if($this.moistureTarget >= 70.0, | 'DEEP', | if($this.moistureTarget >= 45.0, | 'STEADY', | 'LIGHT'))
  }: String[1];
}

Association test::indigodelta2::domain::Cycle_Glasshouse
{
  house: Glasshouse[1];
  cycles: IrrigationCycle[*];
}
