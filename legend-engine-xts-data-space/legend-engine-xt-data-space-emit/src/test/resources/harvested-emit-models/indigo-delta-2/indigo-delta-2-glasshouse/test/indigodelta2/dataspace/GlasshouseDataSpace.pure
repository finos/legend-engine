###DataSpace
DataSpace test::indigodelta2::dataspace::GlasshouseDataSpace
{
  executionContexts:
  [
    {
      name: 'east';
      description: 'East glasshouse execution context for the local garden register.';
      mapping: test::indigodelta2::mapping::GlasshouseMapping;
      defaultRuntime: test::indigodelta2::runtime::GardenEastRuntime;
    },
    {
      name: 'west';
      description: 'West glasshouse execution context for the alternate garden register.';
      mapping: test::indigodelta2::mapping::GlasshouseMapping;
      defaultRuntime: test::indigodelta2::runtime::GardenWestRuntime;
    }
  ];
  defaultExecutionContext: 'east';
  title: 'Indigo Delta Glasshouse Irrigation';
  description: 'Executable garden context over business-temporal irrigation cycles and the glasshouses they serve.';
  elements:
  [
    test::indigodelta2::domain::Glasshouse,
    test::indigodelta2::domain::IrrigationCycle,
    test::indigodelta2::domain::Cycle_Glasshouse
  ];
}
