###Mapping
Mapping test::opallantern3::mapping::LanternStructureMapping
(
  *test::opallantern3::domain::LampUnit[lamp_unit]: Relational
  {
    ~primaryKey
    (
      [test::opallantern3::store::LanternDb]lantern.lamp_unit.unit_code,
      [test::opallantern3::store::LanternDb]lantern.lamp_unit.in_z
    )
    ~mainTable [test::opallantern3::store::LanternDb]lantern.lamp_unit
    unitCode: [test::opallantern3::store::LanternDb]lantern.lamp_unit.unit_code,
    stationName: [test::opallantern3::store::LanternDb]lantern.lamp_unit.station_name,
    lensGrade: [test::opallantern3::store::LanternDb]lantern.lamp_unit.lens_grade,
    focalHeightMetres: [test::opallantern3::store::LanternDb]lantern.lamp_unit.focal_height_m,
    ratedCandela: [test::opallantern3::store::LanternDb]lantern.lamp_unit.rated_candela,
    commissionedOn: [test::opallantern3::store::LanternDb]lantern.lamp_unit.commissioned_on,
    surveyedAt: [test::opallantern3::store::LanternDb]lantern.lamp_unit.surveyed_at
  }

  *test::opallantern3::domain::LampKeeper[lamp_keeper]: Relational
  {
    ~primaryKey
    (
      [test::opallantern3::store::LanternDb]lantern.lamp_keeper.keeper_code,
      [test::opallantern3::store::LanternDb]lantern.lamp_keeper.in_z
    )
    ~mainTable [test::opallantern3::store::LanternDb]lantern.lamp_keeper
    keeperCode: [test::opallantern3::store::LanternDb]lantern.lamp_keeper.keeper_code,
    keeperName: [test::opallantern3::store::LanternDb]lantern.lamp_keeper.keeper_name,
    districtName: [test::opallantern3::store::LanternDb]lantern.lamp_keeper.district_name
  }

  test::opallantern3::domain::Unit_Keeper: Relational
  {
    AssociationMapping
    (
      keeper[lamp_unit, lamp_keeper]: [test::opallantern3::store::LanternDb]@Lantern_Unit_Keeper,
      keptUnits[lamp_keeper, lamp_unit]: [test::opallantern3::store::LanternDb]@Lantern_Unit_Keeper
    )
  }
)
