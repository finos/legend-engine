###Connection
RelationalDatabaseConnection test::jadeglacier::connection::ConservatoryLakeConnection
{
  store: test::jadeglacier::store::ConservatoryDatabase;
  type: Snowflake;
  timezone: +0000;
  specification: Snowflake
  {
    name: 'JADE_CONSERVATORY_DB';
    account: 'jade_conservatory_account';
    warehouse: 'CONSERVATORY_QUERY_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    enableQueryTags: false;
    role: 'CONSERVATORY_READER';
  };
  auth: OAuth
  {
    oauthKey: 'CONSERVATORY_OAUTH';
    scopeName: 'SESSION:ROLE:CONSERVATORY_READER';
  };
}
