###Relational
Database test::jadeglacier::store::ConservatoryDatabase
(
  Schema conservatory
  (
    Table plant_accession
    (
      accession_code VARCHAR(16) PRIMARY KEY,
      taxon_name VARCHAR(128),
      glasshouse_code VARCHAR(16),
      pot_size_cm INTEGER,
      acquired_year INTEGER,
      curator_note VARCHAR(128)
    )

    View glasshouse_census
    (
      ~groupBy (conservatory.plant_accession.glasshouse_code)
      glasshouse_code: conservatory.plant_accession.glasshouse_code PRIMARY KEY,
      accession_count: count(conservatory.plant_accession.accession_code),
      largest_pot_cm: max(conservatory.plant_accession.pot_size_cm)
    )
  )

  Join Accession_Census(conservatory.plant_accession.glasshouse_code = conservatory.glasshouse_census.glasshouse_code)
)
