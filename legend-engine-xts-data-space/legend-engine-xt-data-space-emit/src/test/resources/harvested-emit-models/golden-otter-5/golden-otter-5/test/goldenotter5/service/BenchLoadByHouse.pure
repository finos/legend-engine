###Service
Service test::goldenotter5::service::BenchLoadByHouse
{
  pattern: '/goldenotter5/v1/bench-load';
  title: 'Bench Load By House';
  ownership: DID { identifier: 'nursery-load' };
  documentation: 'Groups qualifying batches by glasshouse and derives a distinct vigour and cultivar count with a conditional label.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: {houseName: String[1], seasonYear: Integer[1]|test::goldenotter5::domain::PropagationBatch.all()->filter(
      b|($b.houseName == $houseName) && $b.sownInSeason($seasonYear)
    )->groupBy(
      [
        b|$b.houseName
      ],
      [
        agg(b|if($b.cuttingCount > 40, |$b.vigourCode + '/' + $b.cultivarName, |'SPARSE'), y|$y->distinct()->count())
      ],
      [
        'House',
        'DistinctVigourCultivars'
      ]
    )};
    mapping: test::goldenotter5::mapping::NurseryMapping;
    runtime: test::goldenotter5::runtime::NurseryRuntime;
  }
  testSuites:
  [
    benchLoadSuite:
    {
      data:
      [
        connections:
        [
          h2Connection: Relational
          #{
            nursery.propagation_batch:
              'batch_id,bench_id,sown_date,cutting_count,vigour_code,cultivar_name,misting_note,rooted_count\n'+
              '1,1,2026-05-01,10,A,FERN,light,5\n'+
              '2,1,2026-05-02,50,B,MOSS,light,25\n';
            nursery.bench:
              'bench_id,bench_label,house_id,bench_area_m2\n1,BENCH-1,1,20\n';
            nursery.glasshouse:
              'house_id,house_name,zone_label\n1,HOUSE-1,NORTH\n';
          }#
        ]
      ]
      tests:
      [
        oneHouse:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            houseName = 'HOUSE-1',
            seasonYear = 2026
          ]
          asserts:
          [
            oneDistinctLabel:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"House":"HOUSE-1","DistinctVigourCultivars":2}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
