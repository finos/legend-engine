###DataSpace
DataSpace test::goldenotter5::dataspace::NurseryDataSpace
{
  executionContexts:
  [
    {
      name: 'propagation';
      description: 'Propagation workspace for nursery bench planning.';
      mapping: test::goldenotter5::mapping::NurseryMapping;
      defaultRuntime: test::goldenotter5::runtime::NurseryRuntime;
    },
    {
      name: 'published';
      description: 'Published nursery propagation catalogue.';
      mapping: test::goldenotter5::mapping::NurseryMapping;
      defaultRuntime: test::goldenotter5::runtime::NurseryRuntime;
    }
  ];
  defaultExecutionContext: 'published';
  title: 'Glasshouse Propagation Nursery';
  description: 'A DataSpace exposing propagation batches and bench loads through two execution contexts.';
}
