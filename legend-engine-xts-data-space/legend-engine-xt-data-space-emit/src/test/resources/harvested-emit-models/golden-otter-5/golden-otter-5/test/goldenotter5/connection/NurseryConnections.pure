###Connection
RelationalDatabaseConnection test::goldenotter5::connection::h2Connection
{
  store: test::goldenotter5::store::NurseryDb;
  type: H2;
  specification: LocalH2 { testDataSetupSqls: []; };
  auth: DefaultH2;
}

RelationalDatabaseConnection test::goldenotter5::connection::publishedConnection
{
  store: test::goldenotter5::store::NurseryDb;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'NURSERY_DB';
    account: 'nursery_account';
    warehouse: 'NURSERY_WH';
    region: 'eu-west-1';
  };
  auth: OAuth
  {
    oauthKey: 'NURSERY_OAUTH';
    scopeName: 'SESSION:ROLE:NURSERY_READER';
  };
}
