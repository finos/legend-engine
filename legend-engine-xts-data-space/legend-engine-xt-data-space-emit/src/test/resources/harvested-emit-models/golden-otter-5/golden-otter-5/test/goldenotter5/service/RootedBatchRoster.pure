###Service
Service test::goldenotter5::service::RootedBatchRoster
{
  pattern: '/goldenotter5/v1/rooted-roster';
  owners: ['nursery-curation'];
  documentation: 'Projects derived vigour bands and rooted shares for batches sown in a requested season.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: {seasonYear: Integer[1]|test::goldenotter5::domain::PropagationBatch.all()->filter(b|$b.sownInSeason($seasonYear))->project(
      [
        b|$b.vigourBand(),
        b|$b.rootedShare()
      ],
      [
        'VigourBand',
        'RootedShare'
      ]
    )->sort([asc('VigourBand')])->take(10)};
    mapping: test::goldenotter5::mapping::NurseryMapping;
    runtime: test::goldenotter5::runtime::NurseryRuntime;
  }
  testSuites:
  [
    rootedRosterSuite:
    {
      data:
      [
        connections:
        [
          h2Connection: Relational
          #{
            nursery.propagation_batch:
              'batch_id,bench_id,sown_date,cutting_count,vigour_code,cultivar_name,misting_note,rooted_count\n1,1,2026-05-01,10,A,FERN,light,5\n2,1,2026-05-02,50,B,MOSS,light,25\n';
            nursery.bench:
              'bench_id,bench_label,house_id,bench_area_m2\n1,BENCH-1,1,20\n';
            nursery.glasshouse:
              'house_id,house_name,zone_label\n1,HOUSE-1,NORTH\n';
          }#
        ]
      ]
      tests:
      [
        rootedRows:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            seasonYear = 2026
          ]
          asserts:
          [
            twoRootedRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"VigourBand":"SPARSE","RootedShare":0.5},{"VigourBand":"STANDARD","RootedShare":0.5}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
