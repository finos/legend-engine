###Service
Service test::goldenotter5::service::PropagationBatchesInWindow
{
  pattern: '/goldenotter5/v1/propagation-window';
  title: 'Propagation Batches In Window';
  owners: ['nursery-curation'];
  documentation: 'Groups propagation batches inside a date window using a nested date, collection, text and calendar predicate chain.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: {cutoff: StrictDate[1], vigourCodes: String[*], seasonYear: Integer[1], seasonMonth: Integer[1]|test::goldenotter5::domain::PropagationBatch.all()->filter(
      b|($b.sownDate <= adjust($cutoff, 0, DurationUnit.DAYS)) && ($b.vigourCode->in($vigourCodes) && (($b.cultivarName != 'WITHDRAWN') && (($b.mistingNote->isEmpty() == false) && (($b.sownDate->year() == $seasonYear) && ($b.sownDate->monthNumber() == $seasonMonth)))))
    )->groupBy(
      [
        b|$b.benchLabel
      ],
      [
        agg(b|$b.cuttingCount, y|$y->sum()),
        agg(b|$b.batchId, y|$y->count())
      ],
      [
        'Bench',
        'TotalCuttings',
        'BatchCount'
      ]
    )->sort([asc('Bench')])};
    mapping: test::goldenotter5::mapping::NurseryMapping;
    runtime: test::goldenotter5::runtime::NurseryRuntime;
  }
  testSuites:
  [
    propagationWindowSuite:
    {
      data:
      [
        connections:
        [
          h2Connection:
            Relational
            #{
              nursery.propagation_batch:
                'batch_id,bench_id,sown_date,cutting_count,vigour_code,cultivar_name,misting_note,rooted_count\n'+
                '1,1,2026-05-01,10,A,FERN,light,5\n'+
                '2,1,2026-05-02,20,B,FERN,light,10\n'+
                '3,1,2026-05-03,30,C,FERN,light,15\n'+
                '4,1,2026-05-04,40,D,MOSS,light,20\n'+
                '5,1,2026-05-05,50,E,MOSS,light,25\n'+
                '6,1,2026-05-06,60,F,MOSS,light,30\n'+
                '7,1,2026-05-07,70,G,IVY,,35\n'+
                '8,1,2026-05-08,80,H,IVY,light,40\n'+
                '9,1,2026-05-09,90,X,IVY,light,\n'+
                '10,2,2025-12-01,120,A,FERN,light,60\n';
              nursery.bench:
                'bench_id,bench_label,house_id,bench_area_m2\n'+
                '1,BENCH-1,1,20\n'+
                '2,BENCH-2,1,30\n';
              nursery.glasshouse:
                'house_id,house_name,zone_label\n'+
                '1,HOUSE-1,NORTH\n';
            }#
        ]
      ]
      tests:
      [
        currentSeason:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            cutoff = %2026-05-31,
            vigourCodes = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H', 'X'],
            seasonYear = 2026,
            seasonMonth = 5
          ]
          asserts:
          [
            benchTotals:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Bench":"BENCH-1","TotalCuttings":380,"BatchCount":8}]';
                  }#;
              }#
          ]
        },
        emptyWindow:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            cutoff = %2024-01-31,
            vigourCodes = ['A'],
            seasonYear = 2024,
            seasonMonth = 1
          ]
          asserts:
          [
            noRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
