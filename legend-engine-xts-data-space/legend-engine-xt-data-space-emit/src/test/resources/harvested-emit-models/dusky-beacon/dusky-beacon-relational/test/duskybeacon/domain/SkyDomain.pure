import test::duskybeacon::domain::*;

Class test::duskybeacon::domain::Observatory
{
  obsCode: String[1];
  obsName: String[1];
  elevationM: Integer[1];
}

Class test::duskybeacon::domain::Telescope
{
  instrumentCode: String[1];
  opticalClass: String[1];
  apertureCm: Integer[1];
  apertureBand: String[1];
  commissionedOn: StrictDate[1];
}

Association test::duskybeacon::domain::ObservatoryTelescopes
{
  observatory: Observatory[1];
  telescopes: Telescope[*];
}
