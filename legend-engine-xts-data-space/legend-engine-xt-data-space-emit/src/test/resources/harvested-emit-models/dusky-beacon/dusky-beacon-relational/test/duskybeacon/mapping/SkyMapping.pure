###Mapping
Mapping test::duskybeacon::mapping::SkyMapping
(
  *test::duskybeacon::domain::Observatory[observatory]: Relational
  {
    ~primaryKey
    (
      [test::duskybeacon::store::SkyDB]sky.observatory.obs_code
    )
    ~mainTable [test::duskybeacon::store::SkyDB]sky.observatory
    obsCode: [test::duskybeacon::store::SkyDB]sky.observatory.obs_code,
    obsName: [test::duskybeacon::store::SkyDB]sky.observatory.obs_name,
    elevationM: [test::duskybeacon::store::SkyDB]sky.observatory.elevation_m,
    telescopes[telescope]: [test::duskybeacon::store::SkyDB]@Observatory_Telescope
  }

  *test::duskybeacon::domain::Telescope[telescope]: Relational
  {
    ~primaryKey
    (
      [test::duskybeacon::store::SkyDB]sky.telescope.instrument_code
    )
    ~mainTable [test::duskybeacon::store::SkyDB]sky.telescope
    instrumentCode: [test::duskybeacon::store::SkyDB]sky.telescope.instrument_code,
    opticalClass: toUpper([test::duskybeacon::store::SkyDB]sky.telescope.optical_class),
    apertureCm: [test::duskybeacon::store::SkyDB]sky.telescope.aperture_cm,
    apertureBand: case([test::duskybeacon::store::SkyDB]sky.telescope.aperture_cm > 200, 'WIDE', case([test::duskybeacon::store::SkyDB]sky.telescope.aperture_cm > 100, 'MEDIUM', 'NARROW')),
    commissionedOn: [test::duskybeacon::store::SkyDB]sky.telescope.commissioned_on,
    observatory[observatory]: [test::duskybeacon::store::SkyDB]@Observatory_Telescope
  }

  testSuites:
  [
    telescopeRosterSuite:
    {
      function: |test::duskybeacon::domain::Telescope.all()->project(
        [
          t|$t.instrumentCode,
          t|$t.opticalClass,
          t|$t.apertureBand,
          t|$t.observatory.obsName->toOne()
        ],
        [
          'Instrument',
          'Optics',
          'Band',
          'Observatory'
        ]
      )->sort([asc('Instrument')]);
      tests:
      [
        rosterWalksJoin:
        {
          doc: 'Projects every telescope with its aperture band and the observatory name reached through the inner join, exercising the association implementation.';
          data:
          [
            test::duskybeacon::store::SkyDB:
              Reference
              #{
                test::duskybeacon::data::SkyTestData
              }#
          ];
          asserts:
          [
            roster:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Instrument":"T-100","Optics":"REFLECTOR","Band":"WIDE","Observatory":"Ridgecrest Dome"},{"Instrument":"T-200","Optics":"REFRACTOR","Band":"MEDIUM","Observatory":"Ridgecrest Dome"},{"Instrument":"T-300","Optics":"SCHMIDT","Band":"NARROW","Observatory":"Coastal Array"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
