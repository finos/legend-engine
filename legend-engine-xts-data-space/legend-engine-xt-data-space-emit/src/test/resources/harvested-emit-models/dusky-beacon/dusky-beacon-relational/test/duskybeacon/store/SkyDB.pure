###Relational
Database test::duskybeacon::store::SkyDB
(
  Schema sky
  (
    Table observatory
    (
      obs_code VARCHAR(24) PRIMARY KEY,
      obs_name VARCHAR(128) NOT NULL,
      elevation_m INTEGER NOT NULL
    )
    Table telescope
    (
      instrument_code VARCHAR(24) PRIMARY KEY,
      obs_code VARCHAR(24) NOT NULL,
      optical_class VARCHAR(64) NOT NULL,
      aperture_cm INTEGER NOT NULL,
      commissioned_on DATE NOT NULL
    )
  )

  Join Observatory_Telescope(sky.observatory.obs_code = sky.telescope.obs_code)
)
