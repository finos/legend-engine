###DataSpace
DataSpace test::duskybeacon::dataspace::SkyDataSpace
{
  executionContexts:
  [
    {
      name: 'survey';
      description: 'Survey tier - the sky survey store used for roster curation and test execution.';
      mapping: test::duskybeacon::mapping::SkyMapping;
      defaultRuntime: test::duskybeacon::runtime::SkyRuntime;
    }
  ];
  defaultExecutionContext: 'survey';
  title: 'Observatory Telescope Roster';
  description: 'A governed entry point over the observatory survey domain - observatories and the telescopes mounted at them - wiring the mapping, runtime and featured endpoint consumers should start from.';
  elements:
  [
    test::duskybeacon::domain
  ];
  executables:
  [
    {
      id: 1;
      title: 'Recent telescopes';
      description: 'Featured endpoint returning the large-aperture telescopes commissioned within a window.';
      executable: test::duskybeacon::service::RecentTelescopes;
    }
  ];
}
