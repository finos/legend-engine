###DataSpace
DataSpace test::emberorchard::dataspace::OrchardRegisterDataSpace
{
  executionContexts:
  [
    {
      name: 'nursery';
      description: 'The production-tier context: the register projection planned against the nursery warehouse that the propagation desk works from.';
      mapping: test::emberorchard::mapping::OrchardMapping;
      defaultRuntime: test::emberorchard::runtime::OrchardNurseryRuntime;
    }
  ];
  defaultExecutionContext: 'nursery';
  title: 'Ember Orchard Propagation Register';
  description: 'Curates the orchard propagation register: the documented specimen record and its irrigation allocation, bound onto a two-schema nursery store and published through one environment-keyed register projection.';
  elements:
  [
    test::emberorchard::domain::IrrigationAllocation,
    test::emberorchard::domain::SpecimenRecord
  ];
  executables:
  [
    {
      id: 1;
      title: 'Specimen register projection';
      description: 'The wide unrestricted projection of the propagation register.';
      executable: test::emberorchard::service::SpecimenRegister;
    }
  ];
}
