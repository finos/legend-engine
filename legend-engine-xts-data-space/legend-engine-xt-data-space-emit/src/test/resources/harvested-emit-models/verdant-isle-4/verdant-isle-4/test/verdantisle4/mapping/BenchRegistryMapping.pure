###Mapping
Mapping test::verdantisle4::mapping::BenchRegistryMapping
(
  *test::verdantisle4::domain::Bench[bench]: Relational
  {
    ~primaryKey
    (
      [test::verdantisle4::store::BenchRegistryDB]benchreg.bench.bench_code
    )
    ~mainTable [test::verdantisle4::store::BenchRegistryDB]benchreg.bench
    benchCode: [test::verdantisle4::store::BenchRegistryDB]benchreg.bench.bench_code,
    benchName: [test::verdantisle4::store::BenchRegistryDB]benchreg.bench.bench_name,
    houseCode: [test::verdantisle4::store::BenchRegistryDB]benchreg.bench.house_code
  }

  *test::verdantisle4::domain::Keeper[keeper]: Relational
  {
    ~primaryKey
    (
      [test::verdantisle4::store::BenchRegistryDB]benchreg.keeper.keeper_code
    )
    ~mainTable [test::verdantisle4::store::BenchRegistryDB]benchreg.keeper
    keeperCode: [test::verdantisle4::store::BenchRegistryDB]benchreg.keeper.keeper_code,
    keeperName: [test::verdantisle4::store::BenchRegistryDB]benchreg.keeper.keeper_name,
    rota[keeperRota]: [test::verdantisle4::store::BenchRegistryDB]@Keeper_Rota
  }

  *test::verdantisle4::domain::KeeperRota[keeperRota]: Relational
  {
    ~primaryKey
    (
      [test::verdantisle4::store::BenchRegistryDB]benchreg.keeper_rota.rota_code
    )
    ~mainTable [test::verdantisle4::store::BenchRegistryDB]benchreg.keeper_rota
