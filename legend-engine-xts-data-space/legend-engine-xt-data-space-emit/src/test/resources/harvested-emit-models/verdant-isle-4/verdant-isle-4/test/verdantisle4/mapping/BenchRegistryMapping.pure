    rotaName: [test::verdantisle4::store::BenchRegistryDB]benchreg.keeper_rota.rota_name,
    cadenceCode: [test::verdantisle4::store::BenchRegistryDB]benchreg.keeper_rota.cadence_code
  }

  test::verdantisle4::domain::Bench_Keeper: Relational
  {
    AssociationMapping
    (
      benches[keeper, bench]: [test::verdantisle4::store::BenchRegistryDB]@Bench_Keeper,
      keeper[bench, keeper]: [test::verdantisle4::store::BenchRegistryDB]@Bench_Keeper
