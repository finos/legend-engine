###Relational
Database test::verdantisle4::store::NurseryComposedDB
(
  include test::verdantisle4::store::BenchRegistryDB
  include test::verdantisle4::store::IslandRefDB
  include test::verdantisle4::store::SeedRegistryDB

  Schema nurserylocal
  (
    Table dispatch_record
    (
      dispatch_id INTEGER PRIMARY KEY,
      dispatch_code VARCHAR(24),
      lot_code VARCHAR(24),
      zone_code VARCHAR(16),
      dispatch_state VARCHAR(16),
      tray_count INTEGER,
      dispatched_on DATE
    )

    Table dispatch_tag
    (
      tag_code VARCHAR(24) PRIMARY KEY,
      dispatch_code VARCHAR(24),
      tag_state VARCHAR(16)
    )
  )

  Join Dispatch_Lot(nurserylocal.dispatch_record.lot_code = seedreg.seed_lot.lot_code)

  Join Dispatch_Zone(nurserylocal.dispatch_record.zone_code = islandref.island_zone.zone_code)

  Join Lot_Bench(seedreg.seed_lot.bench_code = benchreg.bench.bench_code)
)
