###Relational
Database test::verdantisle4::store::SeedRegistryDB
(
  Schema seedreg
  (
    Table seed_lot
    (
      lot_id INTEGER PRIMARY KEY,
      lot_code VARCHAR(24),
      cultivar_code VARCHAR(16),
      bench_code VARCHAR(16),
      keeper_code VARCHAR(16),
      lot_state VARCHAR(16),
      seed_count INTEGER,
      viability_pct FLOAT,
      sown_on DATE
    )

    Table cultivar
    (
      cultivar_code VARCHAR(16) PRIMARY KEY,
      cultivar_name VARCHAR(96),
      species_group VARCHAR(32),
      germination_days INTEGER
    )
  )

  Join Lot_Cultivar(toUpper(seedreg.seed_lot.cultivar_code) = seedreg.cultivar.cultivar_code)
)
