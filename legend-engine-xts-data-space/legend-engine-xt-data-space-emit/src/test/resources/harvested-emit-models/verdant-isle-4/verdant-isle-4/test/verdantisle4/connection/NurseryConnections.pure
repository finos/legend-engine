###Connection
RelationalDatabaseConnection test::verdantisle4::connection::NurseryPublishedConnection
{
  store: test::verdantisle4::store::NurseryComposedDB;
  type: Snowflake;
  timezone: +0000;
  specification: Snowflake
  {
    name: 'ISLAND_NURSERY_DB';
    account: 'island_nursery_account';
    warehouse: 'ISLAND_NURSERY_WH';
    region: 'eu-west-1';
    cloudType: 'aws';
    enableQueryTags: false;
    role: 'ISLAND_NURSERY_READER';
  };
  auth: OAuth
  {
    scopeName: 'session:role-island-nursery-reader';
    oauthKey: 'islandNurseryOauthKey';
  };
  postProcessors:
  [
    mapper
    {
      mappers:
      [
        schema {from: 'nurserylocal'; to: 'nursery_published';},
        schema {from: 'seedreg'; to: 'nursery_published';},
        schema {from: 'benchreg'; to: 'nursery_published';},
        table {from: 'island_zone'; to: 'island_zone_current'; schemaFrom: 'islandref'; schemaTo: 'nursery_published';}
      ];
    }
  ];
}

###Connection
RelationalDatabaseConnection test::verdantisle4::connection::NurseryVerificationConnection
{
  store: test::verdantisle4::store::NurseryComposedDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [];
  };
  auth: DefaultH2;
}
