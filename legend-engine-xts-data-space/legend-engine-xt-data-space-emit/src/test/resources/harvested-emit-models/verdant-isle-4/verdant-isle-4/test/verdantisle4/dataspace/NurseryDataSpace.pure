###DataSpace
DataSpace test::verdantisle4::dataspace::NurseryDataSpace
{
  executionContexts:
  [
    {
      name: 'published';
      description: 'Published context - the composed nursery binding read through the connection whose mapper rewrites every registry schema onto the published one.';
      mapping: test::verdantisle4::mapping::NurseryPublishedMapping;
      defaultRuntime: test::verdantisle4::runtime::NurseryProductionRuntime;
    },
    {
      name: 'composed';
      description: 'Composed context - the same stores bound without the tag and watch sets, for consumers reading only the dispatch register and its reference sides.';
      mapping: test::verdantisle4::mapping::NurseryComposedMapping;
      defaultRuntime: test::verdantisle4::runtime::NurseryComposedRuntime;
    }
  ];
  defaultExecutionContext: 'published';
  title: 'Island Nursery Dispatch Register';
  description: 'Discovery surface over an island seed nursery: the seed lots sown on its benches, the cultivars they cite through an upper-casing join, the keepers and rotas tending the benches, the island zones lots are dispatched to, and the tags and watch states raised against them.';
  elements:
  [
    test::verdantisle4::domain::Bench,
    test::verdantisle4::domain::BenchWatch,
    test::verdantisle4::domain::Cultivar,
    test::verdantisle4::domain::DispatchRecord,
    test::verdantisle4::domain::DispatchTag,
    test::verdantisle4::domain::IslandZone,
    test::verdantisle4::domain::Keeper,
    test::verdantisle4::domain::KeeperRota,
    test::verdantisle4::domain::SeedLot
  ];
  supportInfo: Email
  {
    address: 'island-nursery-desk@islandnursery.invalid';
  };
}
