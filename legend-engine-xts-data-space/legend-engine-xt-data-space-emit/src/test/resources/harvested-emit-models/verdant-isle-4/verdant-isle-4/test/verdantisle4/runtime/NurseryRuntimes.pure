###Runtime
Runtime test::verdantisle4::runtime::NurseryProductionRuntime
{
  mappings:
  [
    test::verdantisle4::mapping::NurseryPublishedMapping
  ];
  connections:
  [
    test::verdantisle4::store::NurseryComposedDB:
    [
      nurseryPublished: test::verdantisle4::connection::NurseryPublishedConnection
    ]
  ];
}

Runtime test::verdantisle4::runtime::NurseryComposedRuntime
{
  mappings:
  [
    test::verdantisle4::mapping::NurseryComposedMapping
  ];
  connections:
  [
    test::verdantisle4::store::NurseryComposedDB:
    [
      nurseryComposed: test::verdantisle4::connection::NurseryPublishedConnection
    ]
  ];
}

Runtime test::verdantisle4::runtime::NurseryVerificationRuntime
{
  mappings:
  [
    test::verdantisle4::mapping::NurseryPublishedMapping
  ];
  connections:
  [
    test::verdantisle4::store::NurseryComposedDB:
    [
      nurseryVerificationH2: test::verdantisle4::connection::NurseryVerificationConnection
    ]
  ];
}

Runtime test::verdantisle4::runtime::NurseryReviewRuntime
{
  mappings:
  [
    test::verdantisle4::mapping::NurseryComposedMapping
  ];
  connections:
  [
