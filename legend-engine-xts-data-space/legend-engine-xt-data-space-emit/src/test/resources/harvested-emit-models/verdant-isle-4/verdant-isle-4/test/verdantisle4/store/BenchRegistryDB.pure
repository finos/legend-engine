###Relational
Database test::verdantisle4::store::BenchRegistryDB
(
  Schema benchreg
  (
    Table bench
    (
      bench_code VARCHAR(16) PRIMARY KEY,
      bench_name VARCHAR(96),
      house_code VARCHAR(16),
      keeper_code VARCHAR(16)
    )

    Table keeper
    (
      keeper_code VARCHAR(16) PRIMARY KEY,
      keeper_name VARCHAR(96),
      rota_code VARCHAR(16)
    )

    Table keeper_rota
    (
      rota_code VARCHAR(16) PRIMARY KEY,
      rota_name VARCHAR(96),
      cadence_code VARCHAR(16)
    )

    Table bench_watch
    (
      bench_code VARCHAR(16) PRIMARY KEY,
      watch_state VARCHAR(16)
    )
  )

  Join Bench_Keeper(benchreg.bench.keeper_code = benchreg.keeper.keeper_code)

  Join Keeper_Rota(benchreg.keeper.rota_code = benchreg.keeper_rota.rota_code)
)
