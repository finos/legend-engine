###Service
Service test::verdanthatchery2::service::SiteRoster
{
  pattern: '/verdanthatchery2/siteRoster/{catchmentNames}';
  title: 'Fell Beck Hatchery - Site Roster By Catchment';
  documentation: 'Publishes the hatchery sites sitting on a supplied set of catchments, ordered by site name and capped, so the third unit of the store is exercised through its own published query.';
  autoActivateUpdates: false;
  owners:
  [
    'fell-beck-hatchery-ops'
  ];
  execution: Single
  {
    query: {catchmentNames: String[*]|test::verdanthatchery2::domain::HatcherySite.all()->filter(
      s|$s.catchmentName->in($catchmentNames)
    )->project(
      [
        s|$s.siteCode,
        s|$s.siteName,
        s|$s.catchmentName
      ],
      [
        'Site/Code',
        'Site/Name',
        'Site/Catchment'
      ]
    )->sort(
      [
        asc('Site/Name')
      ]
    )->limit(5)};
    mapping: test::verdanthatchery2::mapping::HatcheryMapping;
    runtime: test::verdanthatchery2::runtime::HatcheryWarehouseRuntime;
  }
}
