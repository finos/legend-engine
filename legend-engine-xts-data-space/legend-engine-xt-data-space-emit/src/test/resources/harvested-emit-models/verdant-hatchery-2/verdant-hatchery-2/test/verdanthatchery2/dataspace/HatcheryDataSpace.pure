###DataSpace
DataSpace test::verdanthatchery2::dataspace::HatcheryDataSpace
{
  executionContexts:
  [
    {
      name: 'warehouse';
      description: 'The hatchery warehouse binding every published fry-batch query resolves through.';
      mapping: test::verdanthatchery2::mapping::HatcheryMapping;
      defaultRuntime: test::verdanthatchery2::runtime::HatcheryWarehouseRuntime;
    }
  ];
  defaultExecutionContext: 'warehouse';
  title: 'Fell Beck Hatchery Fry Batches';
  description: 'One curated entry point over the hatchery model: the graded fry batches, the ponds that hold them and the sites those ponds sit on, together with the three published queries a consumer may run.';
  elements:
  [
    test::verdanthatchery2::domain::FryBatch,
    test::verdanthatchery2::domain::RearingPond,
    test::verdanthatchery2::domain::HatcherySite
  ];
  executables:
  [
    {
      id: 1;
      title: 'Graded Fry Batch Register';
      description: 'The species-and-health register carrying the rearing-stage band.';
      executable: test::verdanthatchery2::service::BatchRegister;
    },
    {
      id: 2;
      title: 'Rearing Pond Capacity';
      description: 'The pond volumes held by one hatchery site.';
      executable: test::verdanthatchery2::service::PondCapacity;
    },
    {
      id: 3;
      title: 'Site Roster By Catchment';
      description: 'The hatchery sites sitting on a supplied set of catchments.';
      executable: test::verdanthatchery2::service::SiteRoster;
    }
  ];
}
