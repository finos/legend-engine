###Relational
Database test::verdanthatchery2::store::HatcheryDb
(
  Schema hatchery
  (
    Table fry_batch
    (
      batch_code VARCHAR(24) PRIMARY KEY,
      pond_code VARCHAR(24) NOT NULL,
      species_code VARCHAR(24) NOT NULL,
      stocked_on DATE NOT NULL,
      fry_count INTEGER NOT NULL,
      mean_length_mm DOUBLE NOT NULL,
      health_score INTEGER NOT NULL,
      grader_name VARCHAR(120),
      tagged_flag VARCHAR(1) NOT NULL
    )

    Table rearing_pond
    (
      pond_code VARCHAR(24) PRIMARY KEY,
      pond_name VARCHAR(120) NOT NULL,
      site_code VARCHAR(24) NOT NULL,
      volume_m3 DOUBLE NOT NULL
    )

    Table hatchery_site
    (
      site_code VARCHAR(24) PRIMARY KEY,
      site_name VARCHAR(120) NOT NULL,
      catchment_name VARCHAR(120) NOT NULL
    )
  )

  Join Pond_Batch(hatchery.fry_batch.pond_code = hatchery.rearing_pond.pond_code)

  Join Site_Pond(hatchery.rearing_pond.site_code = hatchery.hatchery_site.site_code)
)
