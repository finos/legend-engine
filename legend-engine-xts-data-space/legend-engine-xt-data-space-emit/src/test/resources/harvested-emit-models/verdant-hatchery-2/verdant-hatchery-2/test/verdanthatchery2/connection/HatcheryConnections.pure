###Connection
RelationalDatabaseConnection test::verdanthatchery2::connection::HatcheryWarehouseConnection
{
  store: test::verdanthatchery2::store::HatcheryDb;
  type: Snowflake;
  timezone: +0000;
  quoteIdentifiers: false;
  specification: Snowflake
  {
    name: 'FELL_BECK_HATCHERY_DB';
    account: 'fell_beck_hatchery_account';
    warehouse: 'FELL_BECK_HATCHERY_WH';
    region: 'eu-west-1';
    cloudType: 'aws';
    accountType: MultiTenant;
    organization: 'fell_beck_fisheries_org';
    role: 'HATCHERY_READER';
  };
  auth: OAuth
  {
    oauthKey: 'fell_beck_hatchery_oauth_key';
    scopeName: 'SESSION:ROLE:HATCHERY_READER';
  };
}
