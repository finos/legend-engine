###Pure
import test::verdanthatchery2::domain::*;

Class {meta::pure::profiles::doc.doc = 'A rearing pond in the hatchery raceway, sized by its working volume.'} test::verdanthatchery2::domain::RearingPond
{
  pondCode: String[1];
  pondName: String[1];
  siteCode: String[1];
  volumeM3: Float[1];
}

Class {meta::pure::profiles::doc.doc = 'A hatchery site on a named catchment, holding the raceway its ponds belong to.'} test::verdanthatchery2::domain::HatcherySite
{
  siteCode: String[1];
  siteName: String[1];
  catchmentName: String[1];
}

Class {meta::pure::profiles::doc.doc = 'One stocked batch of fry, graded on mean length into a rearing stage and resolved onto the pond and the site that hold it.'} test::verdanthatchery2::domain::FryBatch
{
  batchCode: String[1];
  pondCode: String[1];
  speciesCode: String[1];
  stockedOn: StrictDate[1];
  fryCount: Integer[1];
  meanLengthMm: Float[1];
  healthScore: Integer[1];
  graderName: String[0..1];
  vigourBand: String[0..1];
  tagNote: String[1];
  pondName: String[1];
  siteName: String[1];
  stockedYear()
  {
    $this.stockedOn->year()
  }: Integer[1];
  gradedBy()
  {
    if($this.graderName->isEmpty(), | 'UNATTRIBUTED', | $this.graderName->toOne())
  }: String[1];
}
