###Service
Service test::verdanthatchery2::service::PondCapacity
{
  pattern: '/verdanthatchery2/pondCapacity/{siteCode}';
  title: 'Fell Beck Hatchery - Rearing Pond Capacity';
  documentation: 'Lists the rearing ponds held by one hatchery site with their working volumes, ordered by volume and capped, so the pond unit of the store is planned in its own right rather than only as a join target.';
  autoActivateUpdates: false;
  owners:
  [
    'fell-beck-hatchery-ops'
  ];
  execution: Single
  {
    query: {siteCode: String[1]|test::verdanthatchery2::domain::RearingPond.all()->filter(
      p|$p.siteCode == $siteCode
    )->project(
      [
        p|$p.pondCode,
        p|$p.pondName,
        p|$p.volumeM3
      ],
      [
        'Pond/Code',
        'Pond/Name',
        'Pond/Volume'
      ]
    )->sort(
      [
        desc('Pond/Volume')
      ]
    )->limit(5)};
    mapping: test::verdanthatchery2::mapping::HatcheryMapping;
    runtime: test::verdanthatchery2::runtime::HatcheryWarehouseRuntime;
  }
}
