    rectangle: (220.0,110.0);
  }
  classView lineView
  {
    class: test::duskyquokka::domain::TransitLine;
    position: (440.0,80.0);
    rectangle: (220.0,110.0);
  }
  classView railcarView
  {
    class: test::duskyquokka::domain::Railcar;
