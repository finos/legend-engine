###DataSpace
DataSpace test::duskyquokka::dataspace::TransitDataSpace
{
  executionContexts:
  [
    {
      name: 'network';
      description: 'Network tier - the depot, line, railcar and inspection register served from the transit warehouse.';
      mapping: test::duskyquokka::mapping::TransitMapping;
      defaultRuntime: test::duskyquokka::runtime::TransitRuntime;
    }
  ];
  defaultExecutionContext: 'network';
  title: 'Transit Network Register';
  description: 'A curated entry point over the transit network model: depots, the lines they host, the railcars allocated to those lines and the inspection trail behind each railcar.';
  diagrams:
  [
    {
      title: 'Transit Network Overview';
      description: 'The depot, line, railcar and inspection classes with the relationship views that connect them.';
      diagram: test::duskyquokka::diagram::TransitDiagram;
    }
  ];
  elements:
  [
    test::duskyquokka::domain::Depot,
    test::duskyquokka::domain::TransitLine,
    test::duskyquokka::domain::Railcar,
    test::duskyquokka::domain::InspectionLog
  ];
  executables:
  [
    {
      id: 1;
      title: 'Depot register';
      description: 'The depot roster projection published as an executable of this entry point.';
      executable: test::duskyquokka::service::DepotRegisterService;
      executionContextKey: 'network';
    },
    {
      id: 2;
      title: 'Line allocation';
      description: 'The line-to-depot allocation projection published as an executable of this entry point.';
      executable: test::duskyquokka::service::LineAllocationService;
      executionContextKey: 'network';
    }
  ];
  supportInfo: Email
  {
    address: 'transit-network-register@transitnetwork.invalid';
  };
}
