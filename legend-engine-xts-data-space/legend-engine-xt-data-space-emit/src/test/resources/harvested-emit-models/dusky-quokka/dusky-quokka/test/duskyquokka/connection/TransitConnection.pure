###Connection
RelationalDatabaseConnection test::duskyquokka::connection::TransitConnection
{
  store: test::duskyquokka::store::TransitDB;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'TRANSIT_WH_DB';
    account: 'example_account';
    warehouse: 'TRANSIT_WH';
    region: 'example-region';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'example_user';
    privateKeyVaultReference: 'example-private-key-ref';
    passPhraseVaultReference: 'example-pass-phrase-ref';
  };
}
