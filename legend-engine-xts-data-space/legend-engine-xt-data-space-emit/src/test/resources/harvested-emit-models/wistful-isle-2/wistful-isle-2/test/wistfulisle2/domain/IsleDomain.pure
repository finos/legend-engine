import demo::wistfulisle2::domain::*;

Class {meta::pure::profiles::doc.doc = 'A monitored seabird nest site pegged to one shelf of a reserve cliff ledge.'} demo::wistfulisle2::domain::NestSite
{
  nestId: Integer[1];
  nestTag: String[1];
  eggCount: Integer[1];
  lastCheckedAt: DateTime[1];
  occupied: Boolean[1];
  ledgeLabel: String[1];
  isleName: String[1];
  accessNote: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A named ledge section of a reserve cliff that carries a group of nest sites.'} demo::wistfulisle2::domain::LedgeSection
{
  ledgeId: Integer[1];
  ledgeLabel: String[1];
  heightMetres: Integer[1];
}

Class {meta::pure::profiles::doc.doc = 'A tidal island that the surveyed ledge sections belong to.'} demo::wistfulisle2::domain::ReserveIsle
{
  isleCode: String[1];
  isleName: String[1];
  tideRangeCm: Integer[1];
}

Association demo::wistfulisle2::domain::LedgeNests
{
  ledge: LedgeSection[1];
  ledgeNests: NestSite[*];
}

Association demo::wistfulisle2::domain::IsleLedges
{
  isle: ReserveIsle[1];
  isleLedges: LedgeSection[*];
}
