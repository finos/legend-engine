###DataSpace
DataSpace demo::wistfulisle2::dataspace::IsleReserveDataSpace
{
  executionContexts:
  [
    {
      name: 'nestSurvey';
      description: 'Survey tier - nest sites, ledge sections and isles served from the in-process reserve store.';
      mapping: demo::wistfulisle2::mapping::IsleMapping;
      defaultRuntime: demo::wistfulisle2::runtime::IsleSurveyRuntime;
    },
    {
      name: 'wardenReview';
      description: 'Review tier - the same curated model bound to the warehouse copy the reserve wardens report from.';
      mapping: demo::wistfulisle2::mapping::IsleMapping;
      defaultRuntime: demo::wistfulisle2::runtime::IsleReviewRuntime;
    }
  ];
  defaultExecutionContext: 'nestSurvey';
  title: 'Wistful Isle Nest Reserve';
  description: 'A governed entry point over tidal-isle nest sites, the cliff ledge sections that carry them and the isles they belong to, wiring one curated relational mapping to an in-process survey tier and a warehouse review tier.';
}
