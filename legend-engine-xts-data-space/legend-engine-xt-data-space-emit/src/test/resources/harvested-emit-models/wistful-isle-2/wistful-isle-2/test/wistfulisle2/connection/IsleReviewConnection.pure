###Connection
RelationalDatabaseConnection demo::wistfulisle2::connection::IsleReviewConnection
{
  store: demo::wistfulisle2::store::IsleDB;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'EXAMPLE_ISLE_RESERVE_DB';
    account: 'example_isle_account';
    warehouse: 'EXAMPLE_ISLE_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    role: 'EXAMPLE_ISLE_ROLE';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'EXAMPLE_ISLE_USER';
    privateKeyVaultReference: 'example-isle-private-key';
    passPhraseVaultReference: 'example-isle-passphrase';
  };
}
