###Relational
Database demo::wistfulisle2::store::IsleDB
(
  Schema reserve
  (
    Table isle
    (
      isle_code VARCHAR(20) PRIMARY KEY,
      isle_name VARCHAR(120) NOT NULL,
      tide_range_cm INTEGER NOT NULL
    )
    Table ledge
    (
      ledge_id INTEGER PRIMARY KEY,
      ledge_label VARCHAR(120) NOT NULL,
      isle_code VARCHAR(20) NOT NULL,
      height_m INTEGER NOT NULL
    )
    Table nest_site
    (
      nest_id INTEGER PRIMARY KEY,
      nest_tag VARCHAR(40) NOT NULL,
      ledge_id INTEGER NOT NULL,
      egg_count INTEGER NOT NULL,
      last_checked_at TIMESTAMP,
      occupied BIT NOT NULL
    )
  )

  Join Nest_Ledge(reserve.nest_site.ledge_id = reserve.ledge.ledge_id)
  Join Ledge_Isle(reserve.ledge.isle_code = reserve.isle.isle_code)
)
