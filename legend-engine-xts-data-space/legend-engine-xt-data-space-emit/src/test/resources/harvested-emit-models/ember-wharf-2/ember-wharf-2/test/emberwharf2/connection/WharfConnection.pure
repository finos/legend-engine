###Connection
RelationalDatabaseConnection test::emberwharf2::connection::WharfWarehouseConnection
{
  store: test::emberwharf2::store::WharfDb;
  type: Snowflake;
  timezone: 'UTC';
  specification: Snowflake
  {
    name: 'WHARF_OPS_DB';
    account: 'wharf_ops_account';
    warehouse: 'WHARF_OPS_WH';
    region: 'eu-west-1';
    cloudType: 'aws';
    enableQueryTags: false;
    accountType: MultiTenant;
    organization: 'harbour_authority_org';
    role: 'WHARF_OPS_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'WHARF_OPS_USER';
    privateKeyVaultReference: 'wharf.ops.privateKey';
    passPhraseVaultReference: 'wharf.ops.passPhrase';
  };
}
