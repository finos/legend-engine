###Connection
RelationalDatabaseConnection test::quietwillow2::connection::WorkshopWarehouseConnection
{
  store: test::quietwillow2::store::WorkshopDB;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'WORKSHOP_DB';
    account: 'heritage_railway_reference_account';
    warehouse: 'WORKSHOP_WH';
    region: 'us-east-1';
  };
  auth: OAuth
  {
    oauthKey: 'WORKSHOP_OAUTH';
    scopeName: 'SESSION:ROLE:WORKSHOP_READER';
  };
}
