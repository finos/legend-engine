###Service
Service test::quietwillow2::service::CarriageRegisterAsOf
{
  pattern: '/quietwillow2/v1/carriages/register/{asOf}/{regionName}/{minSeats}';
  ownership: UserList { users: ['heritage-railway-workshop-office'] };
  documentation: 'Publishes the carriage register as it stood on a requested day, narrowed by the region reached through the two-hop depot chain, by the seating floor the caller supplies and by the classes the workshop keeps in traffic, and labelled with the depot name reached through the first hop.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {asOf: StrictDate[1], regionName: String[1], minSeats: Integer[1]|test::quietwillow2::domain::Carriage.all($asOf)->filter(
      c|($c.regionName->toOne() == $regionName) && (($c.seats >= $minSeats) && (($c.carriageClass == test::quietwillow2::domain::CarriageClass.SALOON) || ($c.carriageClass == test::quietwillow2::domain::CarriageClass.COMPOSITE)))
    )->project(
      [
        c|$c.carriageCode,
        c|$c.carriageName,
        c|$c.depotName,
        c|$c.regionName,
        c|$c.fleetLabel,
        c|$c.seats
      ],
      [
        'CARRIAGE_CODE',
        'CARRIAGE_NAME',
        'DEPOT_NAME',
        'REGION_NAME',
        'FLEET_LABEL',
        'SEATS'
      ]
    )->sort(
      [
        asc('CARRIAGE_CODE')
      ]
    )->limit(5)};
    mapping: test::quietwillow2::mapping::WorkshopMapping;
    runtime: test::quietwillow2::runtime::WorkshopRuntime;
  }
  testSuites:
  [
    carriageRegisterSuite:
    {
      data:
      [
        connections:
        [
          warehouseConnection:
            Relational
            #{
              fleet.carriage:
                'carriage_code,carriage_name,class_code,seats,tare_tonnes,depot_code,from_z,thru_z\n'+
                'CR-01,Larch Saloon,SA,42,14.5,DP-01,2026-01-01,9999-12-31\n'+
                'CR-02,Rowan Composite,CO,36,12.0,DP-02,2026-02-01,9999-12-31\n'+
                'CR-03,Alder Observation,OB,24,11.5,DP-01,2026-01-01,9999-12-31\n'+
                'CR-04,Hazel Saloon,SA,20,9.0,DP-01,2026-01-01,9999-12-31\n'+
                'CR-05,Birch Composite,CO,38,12.5,DP-01,2026-08-01,9999-12-31\n';

              depots.depot:
                'depot_code,depot_name,region_code\n'+
                'DP-01,Lakeside Depot,RG-01\n'+
                'DP-02,Moorfoot Depot,RG-02\n';

              depots.region:
                'region_code,region_name\n'+
                'RG-01,Northern Fells\n'+
                'RG-02,Southern Moors\n';
            }#
        ]
      ]
      tests:
      [
        carriagesInTrafficOnTheQueriedDay:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            asOf = %2026-06-01,
            regionName = 'Northern Fells',
            minSeats = 30
          ]
          asserts:
          [
            onlyTheLargeSaloon:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"CARRIAGE_CODE":"CR-01","CARRIAGE_NAME":"Larch Saloon","DEPOT_NAME":"Lakeside Depot","REGION_NAME":"Northern Fells","FLEET_LABEL":"SA-CR-01","SEATS":42}]';
                  }#;
              }#
          ]
        },
        laterSheetStillOutOfRange:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            asOf = %2026-06-01,
            regionName = 'Northern Fells',
            minSeats = 37
          ]
          asserts:
          [
            nothingCurrentYet:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"CARRIAGE_CODE":"CR-01","CARRIAGE_NAME":"Larch Saloon","DEPOT_NAME":"Lakeside Depot","REGION_NAME":"Northern Fells","FLEET_LABEL":"SA-CR-01","SEATS":42}]';
                  }#;
              }#
          ]
        },
        laterSheetOnceInRange:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            asOf = %2026-09-01,
            regionName = 'Northern Fells',
            minSeats = 37
          ]
          asserts:
          [
            birchCompositeNowCurrent:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"CARRIAGE_CODE":"CR-01","CARRIAGE_NAME":"Larch Saloon","DEPOT_NAME":"Lakeside Depot","REGION_NAME":"Northern Fells","FLEET_LABEL":"SA-CR-01","SEATS":42},{"CARRIAGE_CODE":"CR-05","CARRIAGE_NAME":"Birch Composite","DEPOT_NAME":"Lakeside Depot","REGION_NAME":"Northern Fells","FLEET_LABEL":"CO-CR-05","SEATS":38}]';
                  }#;
              }#
          ]
        },
        southernMoorsRegisterThroughTheSecondHop:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            asOf = %2026-06-01,
            regionName = 'Southern Moors',
            minSeats = 10
          ]
          asserts:
          [
            oneCompositeInTheOtherRegion:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"CARRIAGE_CODE":"CR-02","CARRIAGE_NAME":"Rowan Composite","DEPOT_NAME":"Moorfoot Depot","REGION_NAME":"Southern Moors","FLEET_LABEL":"CO-CR-02","SEATS":36}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
