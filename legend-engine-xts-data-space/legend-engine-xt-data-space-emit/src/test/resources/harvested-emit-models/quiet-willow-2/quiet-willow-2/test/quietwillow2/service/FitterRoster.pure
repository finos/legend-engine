###Service
Service test::quietwillow2::service::FitterRoster
{
  pattern: '/quietwillow2/v1/fitters/roster/{worksName}';
  ownership: UserList { users: ['heritage-railway-workshop-office'] };
  documentation: 'Lists the fitters attached to a named works site. The site name is not carried on the roster row itself, so the filter and the projection both resolve it through the join out of the staff schema into the works schema, which keeps a cross-schema read on a store with no milestoning at all.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {worksName: String[1]|test::quietwillow2::domain::Fitter.all()->filter(
      f|$f.worksName->toOne() == $worksName
    )->project(
      [
        f|$f.fitterCode,
        f|$f.fitterName,
        f|$f.worksName
      ],
      [
        'FITTER_CODE',
        'FITTER_NAME',
        'WORKS_NAME'
      ]
    )->sort(
      [
        asc('FITTER_CODE')
      ]
    )->limit(4)};
    mapping: test::quietwillow2::mapping::WorkshopMapping;
    runtime: test::quietwillow2::runtime::WorkshopRuntime;
  }
  testSuites:
  [
    fitterRosterSuite:
    {
      data:
      [
        connections:
        [
          warehouseConnection:
            Relational
            #{
              staff.fitter:
                'fitter_code,fitter_name,works_code\n'+
                'FT-01,Nora Ashby,WK-01\n'+
                'FT-02,Idris Fell,WK-01\n'+
                'FT-03,Marta Quill,WK-02\n';

              works.works_site:
                'works_code,works_name,region_code\n'+
                'WK-01,Fellside Works,RG-01\n'+
                'WK-02,Moorfoot Works,RG-02\n';
            }#
        ]
      ]
      tests:
      [
        rosterOfTheNamedWorks:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            worksName = 'Fellside Works'
          ]
          asserts:
          [
            twoFittersAtFellside:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"FITTER_CODE":"FT-01","FITTER_NAME":"Nora Ashby","WORKS_NAME":"Fellside Works"},{"FITTER_CODE":"FT-02","FITTER_NAME":"Idris Fell","WORKS_NAME":"Fellside Works"}]';
                  }#;
              }#
          ]
        },
        rosterOfAnUnstaffedWorks:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            worksName = 'Riverbank Works'
          ]
          asserts:
          [
            noFittersAnywhere:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
