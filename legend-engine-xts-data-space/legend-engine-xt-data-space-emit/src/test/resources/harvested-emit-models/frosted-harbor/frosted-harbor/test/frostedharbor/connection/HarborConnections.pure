###Connection
RelationalDatabaseConnection test::frostedharbor::connection::HarborRegisterConnection
{
  store: test::frostedharbor::store::HarborDb;
  type: Postgres;
  specification: Static
  {
    name: 'HARBOR_REGISTER_DB';
    host: 'harbor.register.internal';
    port: 5432;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'harborregisterprincipal';
  };
}

RelationalDatabaseConnection test::frostedharbor::connection::HarborQuaysideConnection
{
  store: test::frostedharbor::store::HarborDb;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists harbor;',
      'create schema harbor;',
      'create table harbor.dock (dock_id integer not null, dock_code varchar(24) not null, dock_name varchar(120) not null, zone_code varchar(24) not null);',
      'create table harbor.berth (berth_id integer not null, berth_code varchar(24) not null, dock_id integer not null, capacity_ton integer not null);',
      'create table harbor.assignment (assignment_id integer not null, assignment_code varchar(24) not null, berth_id integer not null, grade_label varchar(8) not null, attach_level integer not null, base_level integer not null, peak_level integer not null, period_code varchar(12) not null, reported_on date not null, logged_by varchar(60) not null, from_z date not null, thru_z date not null);',
      'create table harbor.cargo_unit (unit_id integer not null, unit_code varchar(24) not null, assignment_id integer not null, kind_label varchar(8) not null, mass_kg integer not null, logged_by varchar(60) not null, status_code varchar(4) not null);',
      'create table harbor.relay_unit (unit_id integer not null, unit_code varchar(24) not null, assignment_id integer not null, kind_label varchar(8) not null, mass_kg integer not null, logged_by varchar(60) not null, status_code varchar(4) not null);',
      'create table harbor.inspection (inspection_id integer not null, inspection_code varchar(24) not null, berth_id integer not null, inspected_on date not null, inspector_name varchar(60) not null);'
      ];
  };
  auth: DefaultH2;
}
