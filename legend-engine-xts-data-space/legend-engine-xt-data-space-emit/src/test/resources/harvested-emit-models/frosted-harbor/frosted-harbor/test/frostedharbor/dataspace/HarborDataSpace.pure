###DataSpace
DataSpace test::frostedharbor::dataspace::HarborDataSpace
{
  executionContexts:
  [
    {
      name: 'quayside';
      description: 'Quayside tier - the berthing record bound to the harbor mapping and the embedded quayside runtime.';
      mapping: test::frostedharbor::mapping::HarborMapping;
      defaultRuntime: test::frostedharbor::runtime::HarborQuaysideRuntime;
    },
    {
      name: 'register';
      description: 'Register tier - the same berthing record bound to the hosted register runtime.';
      mapping: test::frostedharbor::mapping::HarborMapping;
      defaultRuntime: test::frostedharbor::runtime::HarborRegisterRuntime;
    }
  ];
  defaultExecutionContext: 'quayside';
  title: 'Frosted Harbor Berthing Record';
  description: 'A governed entry point over the harbour berthing record - docks and their berths, the milestoned berth assignments that reach a dock zone across two join hops, and the load register routed across the quayside and relay populations.';
  elements:
  [
    test::frostedharbor::domain::Dock,
    test::frostedharbor::domain::Berth,
    test::frostedharbor::domain::BerthAssignment,
    test::frostedharbor::domain::CargoLoad,
    test::frostedharbor::domain::BerthInspection
  ];
  executables:
  [
    {
      id: 1;
      title: 'Berth grade board';
      description: 'Grouped peak attachment levels rejoined to their detail rows.';
      executable: test::frostedharbor::service::BerthGradeBoard;
    },
    {
      id: 2;
      title: 'Zone load board';
      description: 'Load register across both backing populations.';
      executable: test::frostedharbor::service::ZoneLoadBoard;
    }
  ];
  supportInfo: Email
  {
    address: 'berthing-record-desk@frostedharbor.invalid';
  };
}
