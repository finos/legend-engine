###Mapping
Mapping test::frostedharbor::mapping::HarborMapping
(
  include mapping test::frostedharbor::mapping::HarborEnumMappings

  *test::frostedharbor::domain::Dock[dock]: Relational
  {
    ~primaryKey
    (
      [test::frostedharbor::store::HarborDb]harbor.dock.dock_id
    )
    ~mainTable [test::frostedharbor::store::HarborDb]harbor.dock
    dockCode: [test::frostedharbor::store::HarborDb]harbor.dock.dock_code,
    dockName: [test::frostedharbor::store::HarborDb]harbor.dock.dock_name,
    zoneCode: [test::frostedharbor::store::HarborDb]harbor.dock.zone_code,
    berthCount: [test::frostedharbor::store::HarborDb]@Dock_Summary | [test::frostedharbor::store::HarborDb]harbor.dock_summary_vw.berth_count,
    maxCapacityTon: [test::frostedharbor::store::HarborDb]@Dock_Summary | [test::frostedharbor::store::HarborDb]harbor.dock_summary_vw.max_capacity_ton
  }

  *test::frostedharbor::domain::Berth[berth]: Relational
  {
    ~primaryKey
    (
      [test::frostedharbor::store::HarborDb]harbor.berth.berth_id
    )
    ~mainTable [test::frostedharbor::store::HarborDb]harbor.berth
    berthCode: [test::frostedharbor::store::HarborDb]harbor.berth.berth_code,
    capacityTon: [test::frostedharbor::store::HarborDb]harbor.berth.capacity_ton
  }

  *test::frostedharbor::domain::BerthAssignment[assignment]: Relational
  {
    ~primaryKey
    (
      [test::frostedharbor::store::HarborDb]harbor.assignment.assignment_id
    )
    ~mainTable [test::frostedharbor::store::HarborDb]harbor.assignment
    recordCode: [test::frostedharbor::store::HarborDb]harbor.assignment.assignment_code,
    loggedBy: [test::frostedharbor::store::HarborDb]harbor.assignment.logged_by,
    grade: EnumerationMapping GradeMapping: [test::frostedharbor::store::HarborDb]harbor.assignment.grade_label,
    attachLevel: [test::frostedharbor::store::HarborDb]harbor.assignment.attach_level,
    baseLevel: [test::frostedharbor::store::HarborDb]harbor.assignment.base_level,
    peakLevel: [test::frostedharbor::store::HarborDb]harbor.assignment.peak_level,
    periodCode: [test::frostedharbor::store::HarborDb]harbor.assignment.period_code,
    reportedOn: [test::frostedharbor::store::HarborDb]harbor.assignment.reported_on,
    dockZone: [test::frostedharbor::store::HarborDb]@Assignment_Berth > @Berth_Dock | [test::frostedharbor::store::HarborDb]harbor.dock.zone_code
  }

  *test::frostedharbor::domain::CargoLoad[cargoLoad]: Operation
  {
    meta::pure::router::operations::union_OperationSetImplementation_1__SetImplementation_MANY_(quaysideLoad, relayLoad)
  }

  test::frostedharbor::domain::CargoLoad[quaysideLoad]: Relational
  {
    ~filter [test::frostedharbor::store::HarborDb]OpenUnit
    ~primaryKey
    (
      [test::frostedharbor::store::HarborDb]harbor.cargo_unit.unit_id
    )
    ~mainTable [test::frostedharbor::store::HarborDb]harbor.cargo_unit
    recordCode: [test::frostedharbor::store::HarborDb]harbor.cargo_unit.unit_code,
    loggedBy: [test::frostedharbor::store::HarborDb]harbor.cargo_unit.logged_by,
    kind: EnumerationMapping KindMapping: [test::frostedharbor::store::HarborDb]harbor.cargo_unit.kind_label,
    massKg: [test::frostedharbor::store::HarborDb]harbor.cargo_unit.mass_kg,
    rosterLabel: [test::frostedharbor::store::HarborDb]@Unit_Roster | [test::frostedharbor::store::HarborDb]harbor.unit_roster_vw.roster_label,
    sourceKind: 'QUAYSIDE'
  }

  test::frostedharbor::domain::CargoLoad[relayLoad]: Relational
  {
    ~filter [test::frostedharbor::store::HarborDb]OpenRelay
    ~primaryKey
    (
      [test::frostedharbor::store::HarborDb]harbor.relay_unit.unit_id
    )
    ~mainTable [test::frostedharbor::store::HarborDb]harbor.relay_unit
    recordCode: [test::frostedharbor::store::HarborDb]harbor.relay_unit.unit_code,
    loggedBy: [test::frostedharbor::store::HarborDb]harbor.relay_unit.logged_by,
    kind: EnumerationMapping KindMapping: [test::frostedharbor::store::HarborDb]harbor.relay_unit.kind_label,
    massKg: [test::frostedharbor::store::HarborDb]harbor.relay_unit.mass_kg,
    rosterLabel: [test::frostedharbor::store::HarborDb]@Relay_Roster | [test::frostedharbor::store::HarborDb]harbor.relay_roster_vw.roster_label,
    sourceKind: 'RELAY'
  }

  *test::frostedharbor::domain::BerthInspection[inspection]: Relational
  {
    ~primaryKey
    (
      [test::frostedharbor::store::HarborDb]harbor.inspection.inspection_id
    )
    ~mainTable [test::frostedharbor::store::HarborDb]harbor.inspection
    inspectionCode: [test::frostedharbor::store::HarborDb]harbor.inspection.inspection_code,
    inspectedOn: [test::frostedharbor::store::HarborDb]harbor.inspection.inspected_on,
    inspectorName: [test::frostedharbor::store::HarborDb]harbor.inspection.inspector_name
  }

  test::frostedharbor::domain::Dock_Berth: Relational
  {
    AssociationMapping
    (
      dockBerths[dock, berth]: [test::frostedharbor::store::HarborDb]@Berth_Dock,
      berthDock[berth, dock]: [test::frostedharbor::store::HarborDb]@Berth_Dock
    )
  }

  test::frostedharbor::domain::Berth_Assignment: Relational
  {
    AssociationMapping
    (
      berthAssignments[berth, assignment]: [test::frostedharbor::store::HarborDb]@Assignment_Berth,
      assignmentBerth[assignment, berth]: [test::frostedharbor::store::HarborDb]@Assignment_Berth
    )
  }

  test::frostedharbor::domain::Berth_Inspection: Relational
  {
    AssociationMapping
    (
      berthInspections[berth, inspection]: [test::frostedharbor::store::HarborDb]@Inspection_Berth,
      inspectionBerth[inspection, berth]: [test::frostedharbor::store::HarborDb]@Inspection_Berth
    )
  }

  testSuites:
  [
    cargoLoadSuite:
    {
      function: |test::frostedharbor::domain::CargoLoad.all()->project(
        [
          c|$c.recordCode,
          c|$c.kind,
          c|$c.massKg,
          c|$c.rosterLabel,
          c|$c.sourceKind
        ],
        [
          'Load',
          'Kind',
          'MassKg',
          'Roster',
          'Source'
        ]
      )->sort([asc('Load')]);
      tests:
      [
        unionedLoads:
        {
          doc: 'Routes the load register across both backing populations through the union operation, translating the stored kind label to an enumeration value, reading the roster label from a view and defaulting the source kind to a literal on each side, while the withdrawn rows on both sides are dropped by their store filters.';
          data:
          [
            test::frostedharbor::store::HarborDb:
              Relational
              #{
                harbor.cargo_unit:
                  'unit_id,unit_code,assignment_id,kind_label,mass_kg,logged_by,status_code\n'+
                  '1,CU-01,1,CRATE,1200,quay-crew,A\n'+
                  '2,CU-02,1,PALLET,300,quay-crew,A\n'+
                  '3,CU-03,2,DRUM,900,quay-crew,A\n'+
                  '4,CU-04,2,CRATE,150,quay-crew,X\n';

                harbor.relay_unit:
                  'unit_id,unit_code,assignment_id,kind_label,mass_kg,logged_by,status_code\n'+
                  '1,RU-01,1,DRUM,700,relay-crew,A\n'+
                  '2,RU-02,3,CRATE,450,relay-crew,A\n'+
                  '3,RU-03,3,PALLET,800,relay-crew,X\n';
              }#
          ];
          asserts:
          [
            rows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Load":"CU-01","Kind":"Crate","MassKg":1200,"Roster":"ROSTER-CRATE","Source":"QUAYSIDE"},{"Load":"CU-02","Kind":"Pallet","MassKg":300,"Roster":"ROSTER-PALLET","Source":"QUAYSIDE"},{"Load":"CU-03","Kind":"Drum","MassKg":900,"Roster":"ROSTER-DRUM","Source":"QUAYSIDE"},{"Load":"RU-01","Kind":"Drum","MassKg":700,"Roster":"RELAY-DRUM","Source":"RELAY"},{"Load":"RU-02","Kind":"Crate","MassKg":450,"Roster":"RELAY-CRATE","Source":"RELAY"}]';
                  }#;
              }#
          ];
        }
      ];
    },
    dockSummarySuite:
    {
      function: |test::frostedharbor::domain::Dock.all()->project(
        [
          d|$d.dockCode,
          d|$d.zoneCode,
          d|$d.berthCount,
          d|$d.maxCapacityTon
        ],
        [
          'Dock',
          'Zone',
          'Berths',
          'MaxTon'
        ]
      )->sort([asc('Dock')]);
      tests:
      [
        summarisedDocks:
        {
          doc: 'Reads the two aggregate dock properties through the grouped view rather than from the dock table, so a dock with two berths and a dock with one both report their own berth count and largest berth capacity.';
          data:
          [
            test::frostedharbor::store::HarborDb:
              Relational
              #{
                harbor.dock:
                  'dock_id,dock_code,dock_name,zone_code\n'+
                  '1,DK-01,North Quay,Z-1\n'+
                  '2,DK-02,South Quay,Z-2\n';

                harbor.berth:
                  'berth_id,berth_code,dock_id,capacity_ton\n'+
                  '1,BR-01,1,500\n'+
                  '2,BR-02,1,650\n'+
                  '3,BR-03,2,400\n';
              }#
          ];
          asserts:
          [
            rows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Dock":"DK-01","Zone":"Z-1","Berths":2,"MaxTon":650},{"Dock":"DK-02","Zone":"Z-2","Berths":1,"MaxTon":400}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
