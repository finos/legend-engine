###Service
Service test::gildedvineyard6::service::RegionCatalog
{
  pattern: '/gildedvineyard6/v1/regions';
  title: 'Trail Regions';
  owners:
  [
    'ridge-survey',
    'trail-maintenance'
  ];
  documentation: 'Returns every survey region of the trail network as a two-column tabular projection with explicit result labels and no predicate, so the plan reduces to a single select over the region table.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |test::gildedvineyard6::domain::Region.all()->project(
      [
        r|$r.code,
        r|$r.name
      ],
      [
        'Region',
        'RegionName'
      ]
    )->sort([asc('Region')]);
    mapping: test::gildedvineyard6::mapping::TrailMapping;
    runtime: test::gildedvineyard6::runtime::TrailRuntime;
  }
  testSuites:
  [
    regionSuite:
    {
      data:
      [
        connections:
        [
          trailWarehouseConnection:
            Relational
            #{
              trails.region:
                'region_code,region_name\n'+
                'RG-N,North Ridge\n'+
                'RG-S,South Ridge\n';
            }#
        ]
      ]
      tests:
      [
        allRegionsProjected:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            bothRegions:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Region":"RG-N","RegionName":"North Ridge"},{"Region":"RG-S","RegionName":"South Ridge"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
