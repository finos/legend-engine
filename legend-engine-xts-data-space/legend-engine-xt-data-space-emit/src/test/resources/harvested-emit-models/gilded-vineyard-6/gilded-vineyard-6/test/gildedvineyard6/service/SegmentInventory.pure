###Service
Service test::gildedvineyard6::service::SegmentInventory
{
  pattern: '/gildedvineyard6/v1/segments';
  title: 'Trail Segment Inventory';
  owners:
  [
    'ridge-survey',
    'trail-maintenance'
  ];
  documentation: 'Returns the trail segment inventory with the trailhead name reached through the single-hop segment-to-trailhead join, so the projection mixes main-table columns with a join-reached column and an unrecorded difficulty grading flows through as a null.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |test::gildedvineyard6::domain::TrailSegment.all()->project(
      [
        s|$s.code,
        s|$s.lengthKm,
        s|$s.difficultyCode,
        s|$s.trailheadName
      ],
      [
        'Segment',
        'LengthKm',
        'Difficulty',
        'Trailhead'
      ]
    )->sort([asc('Segment')]);
    mapping: test::gildedvineyard6::mapping::TrailMapping;
    runtime: test::gildedvineyard6::runtime::TrailRuntime;
  }
  testSuites:
  [
    segmentSuite:
    {
      data:
      [
        connections:
        [
          trailWarehouseConnection:
            Relational
            #{
              trails.trailhead:
                'trailhead_id,trailhead_code,trailhead_name,region_code,elevation_m\n'+
                '1,TH-01,Larch Gate,RG-N,880\n'+
                '2,TH-02,Fern Gate,RG-S,640\n';

              trails.trail_segment:
                'segment_id,segment_code,trailhead_id,length_km,difficulty_code\n'+
                '1,SEG-01,1,4.5,HARD\n'+
                '2,SEG-02,1,2.25,EASY\n'+
                '3,SEG-03,2,7.0,\n';
            }#
        ]
      ]
      tests:
      [
        segmentsWithTrailheadName:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            joinReachedNamesResolved:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Segment":"SEG-01","LengthKm":4.5,"Difficulty":"HARD","Trailhead":"Larch Gate"},{"Segment":"SEG-02","LengthKm":2.25,"Difficulty":"EASY","Trailhead":"Larch Gate"},{"Segment":"SEG-03","LengthKm":7.0,"Difficulty":null,"Trailhead":"Fern Gate"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
