###DataSpace
DataSpace test::gildedvineyard6::dataspace::TrailDataSpace
{
  executionContexts:
  [
    {
      name: 'survey';
      description: 'Survey environment - the trail network binding served through the ridge survey warehouse.';
      mapping: test::gildedvineyard6::mapping::TrailMapping;
      defaultRuntime: test::gildedvineyard6::runtime::TrailRuntime;
    }
  ];
  defaultExecutionContext: 'survey';
  title: 'Ridge Trail Network';
  description: 'Discovery surface over the ridge trail network: trailheads, the segments leaving them, the shelters along those segments and the patrol visits recorded at each shelter.';
  elements:
  [
    test::gildedvineyard6::domain::PatrolVisit,
    test::gildedvineyard6::domain::Region,
    test::gildedvineyard6::domain::Shelter,
    test::gildedvineyard6::domain::TrailSegment,
    test::gildedvineyard6::domain::Trailhead
  ];
  supportInfo: Email
  {
    address: 'ridge-trail-desk@ridgetrails.invalid';
  };
}
