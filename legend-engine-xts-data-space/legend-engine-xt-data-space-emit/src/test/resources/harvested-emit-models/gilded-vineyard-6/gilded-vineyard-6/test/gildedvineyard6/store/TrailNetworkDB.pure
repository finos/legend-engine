###Relational
Database test::gildedvineyard6::store::TrailNetworkDB
(
  Schema trails
  (
    Table region
    (
      region_code VARCHAR(24) PRIMARY KEY,
      region_name VARCHAR(120) NOT NULL
    )
    Table trailhead
    (
      trailhead_id INTEGER PRIMARY KEY,
      trailhead_code VARCHAR(24) NOT NULL,
      trailhead_name VARCHAR(120) NOT NULL,
      region_code VARCHAR(24) NOT NULL,
      elevation_m INTEGER NOT NULL
    )
    Table trail_segment
    (
      segment_id INTEGER PRIMARY KEY,
      segment_code VARCHAR(24) NOT NULL,
      trailhead_id INTEGER NOT NULL,
      length_km DOUBLE NOT NULL,
      difficulty_code VARCHAR(16)
    )
    Table shelter
    (
      shelter_id INTEGER PRIMARY KEY,
      shelter_code VARCHAR(24) NOT NULL,
      shelter_name VARCHAR(120) NOT NULL,
      segment_id INTEGER NOT NULL,
      bunk_count INTEGER NOT NULL
    )
    Table patrol_visit
    (
      visit_id INTEGER PRIMARY KEY,
      visit_code VARCHAR(24) NOT NULL,
      shelter_id INTEGER NOT NULL,
      visited_on DATE NOT NULL,
      condition_code VARCHAR(16)
    )
  )

  Join Segment_Trailhead(trails.trail_segment.trailhead_id = trails.trailhead.trailhead_id)
  Join Shelter_Segment(trails.shelter.segment_id = trails.trail_segment.segment_id)
  Join Visit_Shelter(trails.patrol_visit.shelter_id = trails.shelter.shelter_id)
)
