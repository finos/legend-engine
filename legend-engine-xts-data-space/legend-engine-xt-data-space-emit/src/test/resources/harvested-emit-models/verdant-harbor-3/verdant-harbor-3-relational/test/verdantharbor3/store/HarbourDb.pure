###Relational
Database test::verdantharbor3::store::HarbourDb
(
  Schema harbour
  (
    Table mooring_berth
    (
      berth_code VARCHAR(24),
      quay_code VARCHAR(24),
      hull_class VARCHAR(40),
      commissioned_on DATE,
      last_inspected_at TIMESTAMP,
      cleat_load_kn FLOAT,
      depth_at_chart_datum_m FLOAT,
      bollard_count INTEGER,
      pontoon_note VARCHAR(200)
    )

    Table dredge_pass
    (
      pass_ref VARCHAR(24),
      swept_on DATE,
      vessel_code VARCHAR(40),
      crew_size INTEGER,
      duration_hours FLOAT,
      logged_at TIMESTAMP,
      spoil_note VARCHAR(200)
    )
  )
)
