###Connection
RelationalDatabaseConnection test::verdantharbor3::connection::HarbourWarehouseConnection
{
  store: test::verdantharbor3::store::HarbourDb;
  type: Snowflake;
  timezone: 'UTC';
  quoteIdentifiers: true;
  specification: Snowflake
  {
    name: 'HARBOUR_CARGO_DB';
    account: 'tidal_harbour_account';
    warehouse: 'HARBOUR_CARGO_WH';
    region: 'eu-west-1';
    cloudType: 'aws';
    accountType: MultiTenant;
    organization: 'tidal_harbour_org';
    role: 'HARBOUR_CARGO_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'HARBOUR_CARGO_USER';
    privateKeyVaultReference: 'harbour-cargo-private-key';
    passPhraseVaultReference: 'harbour-cargo-pass-phrase';
  };
}
