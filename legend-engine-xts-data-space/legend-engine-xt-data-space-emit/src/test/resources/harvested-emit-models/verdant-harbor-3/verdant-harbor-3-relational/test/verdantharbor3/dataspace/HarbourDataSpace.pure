###DataSpace
DataSpace test::verdantharbor3::dataspace::HarbourDataSpace
{
  executionContexts:
  [
    {
      name: 'inventory';
      description: 'Inventory environment - both harbour roots resolved through the single warehouse runtime.';
      mapping: test::verdantharbor3::mapping::HarbourMapping;
      defaultRuntime: test::verdantharbor3::runtime::HarbourRuntime;
    }
  ];
  defaultExecutionContext: 'inventory';
  title: 'Tidal Harbour Cargo Inventory';
  description: 'Discovery surface over the harbour cargo inventory: the mooring berth register and the dredging passes swept through the approach channel.';
  elements:
  [
    test::verdantharbor3::domain::DredgePass,
    test::verdantharbor3::domain::MooringBerth
  ];
  supportInfo: Email
  {
    address: 'harbour-cargo-desk@tidalharbour.invalid';
  };
}
