Class {meta::pure::profiles::doc.doc = 'A mooring berth on a harbour quay; every property is optional because every backing column is nullable.'} test::verdantharbor3::domain::MooringBerth
{
  berthCode: String[0..1];
  quayCode: String[0..1];
  hullClass: String[0..1];
  commissionedOn: StrictDate[0..1];
  lastInspectedAt: DateTime[0..1];
  cleatLoadKn: Float[0..1];
  depthAtChartDatumM: Float[0..1];
  bollardCount: Integer[0..1];
  pontoonNote: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A single dredging pass swept through the harbour approach; independent of the berth inventory, with no declared relationship to it.'} test::verdantharbor3::domain::DredgePass
{
  passRef: String[0..1];
  sweptOn: StrictDate[0..1];
  vesselCode: String[0..1];
  crewSize: Integer[0..1];
  durationHours: Float[0..1];
  loggedAt: DateTime[0..1];
  spoilNote: String[0..1];
}
