###Relational
Database test::sunlitotter::store::OtterDB
(
  Schema otter
  (
    Table river_reach
    (
      reach_code VARCHAR(20) PRIMARY KEY,
      survey_year INTEGER PRIMARY KEY,
      reach_name VARCHAR(120) NOT NULL,
      catchment VARCHAR(60) NOT NULL,
      protected_site BIT NOT NULL
    )
    Table otter_raft
    (
      raft_code VARCHAR(20) NOT NULL,
      sighted_on DATE,
      reach_code VARCHAR(20) NOT NULL,
      survey_year INTEGER NOT NULL,
      pup_tally INTEGER NOT NULL,
      adult_tally INTEGER NOT NULL,
      water_clarity_m DOUBLE NOT NULL,
      fish_density DECIMAL(9,3) NOT NULL,
      observer_grade VARCHAR(40) NOT NULL,
      telemetry_tagged BIT NOT NULL
    )
  )

  Join Raft_Reach
  (
    otter.otter_raft.reach_code = otter.river_reach.reach_code
      and otter.otter_raft.survey_year = otter.river_reach.survey_year
  )
)
