###Pure
import test::sunlitotter::domain::*;

Class {meta::pure::profiles::doc.doc = 'A named stretch of river surveyed in a given season.'} test::sunlitotter::domain::RiverReach
{
  reachCode: String[1];
  surveyYear: Integer[1];
  reachName: String[1];
  catchment: String[1];
  protectedSite: Boolean[1];
}

Class {meta::pure::profiles::doc.doc = 'A family group of otters observed on a river reach.'} test::sunlitotter::domain::OtterRaft
{
  raftCode: String[1];
  sightedOn: StrictDate[0..1];
  pupTally: Integer[1];
  adultTally: Integer[1];
  waterClarityM: Float[1];
  fishDensity: Decimal[1];
  observerGrade: String[1];
  telemetryTagged: Boolean[1];
  reach: RiverReach[1];

  groupSize()
  {
    $this.pupTally + $this.adultTally
  }: Integer[1];
}
