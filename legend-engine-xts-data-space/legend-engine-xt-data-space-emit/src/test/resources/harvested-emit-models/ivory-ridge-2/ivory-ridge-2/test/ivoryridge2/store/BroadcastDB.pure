###Relational
Database test::ivoryridge2::store::BroadcastDB
(
  Schema airtime
  (
    Table radio_station
    (
      station_code VARCHAR(12) PRIMARY KEY,
      station_name VARCHAR(120) NOT NULL,
      transmitter_kw DOUBLE NOT NULL
    )

    Table presenter
    (
      presenter_code VARCHAR(12) PRIMARY KEY,
      presenter_name VARCHAR(120) NOT NULL,
      studio_city VARCHAR(80)
    )

    Table programme
    (
      programme_code VARCHAR(16) PRIMARY KEY,
      station_code VARCHAR(12),
      programme_name VARCHAR(120) NOT NULL,
      genre_code VARCHAR(24) NOT NULL
    )

    Table broadcast_slot
    (
      slot_code VARCHAR(20) PRIMARY KEY,
      aired_on DATE NOT NULL,
      slot_seq INTEGER NOT NULL,
      programme_code VARCHAR(16),
      presenter_code VARCHAR(12),
      listeners INTEGER NOT NULL,
      duration_minutes INTEGER NOT NULL,
      live_flag BIT
    )
  )

  Join BroadcastSlot_Programme
  (
    airtime.broadcast_slot.programme_code = airtime.programme.programme_code
  )

  Join BroadcastSlot_Presenter
  (
    airtime.broadcast_slot.presenter_code = airtime.presenter.presenter_code
  )

  Join Programme_RadioStation
  (
    airtime.programme.station_code = airtime.radio_station.station_code
  )
)
