###Connection
RelationalDatabaseConnection test::goldenarboretum2::connection::ArboretumH2Connection
{
  store: test::goldenarboretum2::store::ArboretumDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists grove;',
      'create schema grove;',
      'create table grove.grove_zone (grove_code varchar(20) not null, grove_name varchar(60) not null, curator_name varchar(60) not null);',
      'create table grove.grove_bed (bed_code varchar(20) not null, bed_name varchar(60) not null, grove_code varchar(20) not null, soil_type varchar(20) not null);',
      'create table grove.cultivar (cultivar_code varchar(20) not null, cultivar_name varchar(60) not null, leaf_habit varchar(20) not null);',
      'create table grove.tree_specimen (specimen_code varchar(20) not null, bed_code varchar(20) not null, cultivar_code varchar(20) not null, height_cm integer not null, girth_mm integer not null, condition_code varchar(20) not null);',
      'create table grove.canopy_survey (survey_code varchar(20) not null, specimen_code varchar(20) not null, canopy_m2 double not null, survey_year integer not null);'
      ];
  };
  auth: DefaultH2;
}
