###DataSpace
DataSpace test::goldenarboretum2::dataspace::ArboretumDataSpace
{
  executionContexts:
  [
    {
      name: 'grove';
      description: 'Grove tier - the collection store the roster and trace endpoints run against in process.';
      mapping: test::goldenarboretum2::mapping::ArboretumMapping;
      defaultRuntime: test::goldenarboretum2::runtime::ArboretumH2Runtime;
    },
    {
      name: 'nursery';
      description: 'Nursery tier - the propagation store bound through its own mapping and warehouse runtime.';
      mapping: test::goldenarboretum2::mapping::NurseryMapping;
      defaultRuntime: test::goldenarboretum2::runtime::NurseryLakeRuntime;
    }
  ];
  defaultExecutionContext: 'grove';
  title: 'Arboretum Collections And Propagation';
  description: 'A governed entry point over the arboretum collection domain - tree specimens with the bed, grove and cultivar attributes reached through the store join paths, their canopy measurements, and the nursery propagation lines - wiring both mappings, their runtimes, the curated layout diagrams and the endpoints a consumer should start from.';
  diagrams:
  [
    {
      title: 'Canopy Collection Layout';
      diagram: test::goldenarboretum2::diagram::CanopyDiagram;
    },
    {
      title: 'Nursery Propagation Layout';
      diagram: test::goldenarboretum2::diagram::NurseryDiagram;
    }
  ];
  elements:
  [
    test::goldenarboretum2::domain::TreeSpecimen,
    test::goldenarboretum2::domain::CanopySurvey,
    test::goldenarboretum2::domain::NurseryStock
  ];
  executables:
  [
    {
      id: 1;
      title: 'Canopy roster';
      description: 'Featured endpoint returning the specimens of one recorded condition above a height floor.';
      executable: test::goldenarboretum2::service::CanopyRoster;
    },
    {
      id: 2;
      title: 'Canopy survey trace';
      description: 'Featured endpoint returning the measurements of one survey year with the specimen they were recorded against.';
      executable: test::goldenarboretum2::service::SurveyTrace;
    }
  ];
  supportInfo: Email
  {
    address: 'arboretum-collections@arboretum.invalid';
  };
}
