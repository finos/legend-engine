###Relational
Database test::goldenarboretum2::store::ArboretumDB
(
  Schema grove
  (
    Table grove_zone
    (
      grove_code VARCHAR(20) PRIMARY KEY,
      grove_name VARCHAR(60) NOT NULL,
      curator_name VARCHAR(60) NOT NULL
    )
    Table grove_bed
    (
      bed_code VARCHAR(20) PRIMARY KEY,
      bed_name VARCHAR(60) NOT NULL,
      grove_code VARCHAR(20) NOT NULL,
      soil_type VARCHAR(20) NOT NULL
    )
    Table cultivar
    (
      cultivar_code VARCHAR(20) PRIMARY KEY,
      cultivar_name VARCHAR(60) NOT NULL,
      leaf_habit VARCHAR(20) NOT NULL
    )
    Table tree_specimen
    (
      specimen_code VARCHAR(20) PRIMARY KEY,
      bed_code VARCHAR(20) NOT NULL,
      cultivar_code VARCHAR(20) NOT NULL,
      height_cm INTEGER NOT NULL,
      girth_mm INTEGER NOT NULL,
      condition_code VARCHAR(20) NOT NULL
    )
    Table canopy_survey
    (
      survey_code VARCHAR(20) PRIMARY KEY,
      specimen_code VARCHAR(20) NOT NULL,
      canopy_m2 DOUBLE NOT NULL,
      survey_year INTEGER NOT NULL
    )
  )

  Join Specimen_Bed(grove.tree_specimen.bed_code = grove.grove_bed.bed_code)

  Join Bed_Zone(grove.grove_bed.grove_code = grove.grove_zone.grove_code)

  Join Specimen_Cultivar(grove.tree_specimen.cultivar_code = grove.cultivar.cultivar_code)

  Join Survey_Specimen(grove.canopy_survey.specimen_code = grove.tree_specimen.specimen_code)
)
