###Service
Service test::goldenarboretum2::service::CanopyRoster
{
  pattern: '/arboretum/v1/canopy-roster/{conditionCode}';
  title: 'Arboretum Collections - Canopy Roster By Condition';
  owners:
  [
    'arboretum-collections',
    'grove-records'
  ];
  documentation: 'Narrows the specimen extent to one recorded condition and a minimum height, then projects the main-table attributes together with the bed, grove and cultivar columns reached through the store join paths and orders the result on two projected columns.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: {conditionCode: String[1]|test::goldenarboretum2::domain::TreeSpecimen.all()->filter(
      s|($s.conditionCode->toUpper() == $conditionCode) && ($s.heightCm > 100)
    )->project(
      [
        s|$s.specimenCode,
        s|$s.heightCm,
        s|$s.girthMm,
        s|$s.bedName,
        s|$s.groveName,
        s|$s.cultivarName
      ],
      [
        'Specimen',
        'Height',
        'Girth',
        'Bed',
        'Grove',
        'Cultivar'
      ]
    )->sort(
      [
        desc('Height'),
        asc('Specimen')
      ]
    )};
    mapping: test::goldenarboretum2::mapping::ArboretumMapping;
    runtime: test::goldenarboretum2::runtime::ArboretumH2Runtime;
  }
  testSuites:
  [
    canopyRosterSuite:
    {
      data:
      [
        connections:
        [
          h2Connection:
            Relational
            #{
              grove.grove_zone:
                'grove_code,grove_name,curator_name\n'+
                'GZ-1,North Grove,Ash Curator\n';

              grove.grove_bed:
                'bed_code,bed_name,grove_code,soil_type\n'+
                'GB-1,Ridge Bed,GZ-1,LOAM\n'+
                'GB-2,Hollow Bed,GZ-1,CLAY\n';

              grove.cultivar:
                'cultivar_code,cultivar_name,leaf_habit\n'+
                'CV-1,Golden Ash,DECIDUOUS\n'+
                'CV-2,Silver Fir,EVERGREEN\n';

              grove.tree_specimen:
                'specimen_code,bed_code,cultivar_code,height_cm,girth_mm,condition_code\n'+
                'TS-01,GB-1,CV-1,820,240,HEALTHY\n'+
                'TS-02,GB-1,CV-2,410,120,MONITOR\n'+
                'TS-03,GB-2,CV-1,150,60,HEALTHY\n'+
                'TS-04,GB-2,CV-2,80,30,HEALTHY\n';
            }#
        ]
      ]
      tests:
      [
        healthySelectsTallSpecimens:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            conditionCode = 'HEALTHY'
          ]
          asserts:
          [
            twoHealthySpecimensAboveTheHeightFloor:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Specimen":"TS-01","Height":820,"Girth":240,"Bed":"Ridge Bed","Grove":"North Grove","Cultivar":"Golden Ash"},{"Specimen":"TS-03","Height":150,"Girth":60,"Bed":"Hollow Bed","Grove":"North Grove","Cultivar":"Golden Ash"}]';
                  }#;
              }#
          ]
        },
        felledSelectsNothing:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            conditionCode = 'FELLED'
          ]
          asserts:
          [
            noSpecimenCarriesThatCondition:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
