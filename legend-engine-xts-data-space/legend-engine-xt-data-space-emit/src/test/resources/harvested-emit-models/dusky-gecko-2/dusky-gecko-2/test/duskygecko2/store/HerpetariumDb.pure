###Relational
Database test::duskygecko2::store::HerpetariumDb
(
  Schema husbandry
  (
    Table enclosure
    (
      enclosure_id INTEGER PRIMARY KEY,
      enclosure_code VARCHAR(20) NOT NULL,
      zone_label VARCHAR(40) NOT NULL,
      humidity_pct DOUBLE NOT NULL,
      temp_setpoint DECIMAL(5,2) NOT NULL,
      opened_on DATE NOT NULL
    )

    Table keeper_shift
    (
      shift_id INTEGER PRIMARY KEY,
      enclosure_code VARCHAR(20) NOT NULL,
      keeper_alias VARCHAR(40) NOT NULL,
      started_at TIMESTAMP NOT NULL
    )
  )

  Schema taxonomy
  (
    Table species_profile
    (
      profile_id INTEGER PRIMARY KEY,
      species_alias VARCHAR(60) NOT NULL,
      activity_pattern VARCHAR(20) NOT NULL,
      adult_length_cm DOUBLE NOT NULL
    )
  )
)
