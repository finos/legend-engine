###DataSpace
DataSpace test::duskygecko2::dataspace::HerpetariumDataSpace
{
  executionContexts:
  [
    {
      name: 'house';
      description: 'Reptile house tier - the husbandry and taxonomy schemas served through the in-process store.';
      mapping: test::duskygecko2::mapping::HerpetariumMapping;
      defaultRuntime: test::duskygecko2::runtime::HerpetariumH2Runtime;
    },
    {
      name: 'warehouse';
      description: 'Warehouse tier - the same curated binding planned against the vault-authenticated warehouse connection.';
      mapping: test::duskygecko2::mapping::HerpetariumMapping;
      defaultRuntime: test::duskygecko2::runtime::HerpetariumWarehouseRuntime;
    }
  ];
  defaultExecutionContext: 'house';
  title: 'Dusky Gecko Reptile House Husbandry';
  description: 'Discovery surface over the reptile house husbandry records: enclosures and keeper shifts in the husbandry schema, species profiles in the taxonomy schema, and the diagrammed relationships between them.';
  elements:
  [
    test::duskygecko2::domain::Enclosure,
    test::duskygecko2::domain::KeeperShift,
    test::duskygecko2::domain::SpeciesProfile
  ];
  executables:
  [
    {
      id: 1;
      title: 'Enclosures above a humidity floor';
      description: 'Featured endpoint returning the banded enclosures that reach the supplied humidity floor.';
      executable: test::duskygecko2::service::EnclosuresByHumidityFloor;
    },
    {
      id: 2;
      title: 'Species profiles by activity pattern';
      description: 'Featured endpoint returning the taxonomy-schema species profiles for one activity pattern.';
      executable: test::duskygecko2::service::SpeciesProfilesByPattern;
    }
  ];
  supportInfo: Email
  {
    address: 'reptile-house-desk@herpetarium.invalid';
  };
}
