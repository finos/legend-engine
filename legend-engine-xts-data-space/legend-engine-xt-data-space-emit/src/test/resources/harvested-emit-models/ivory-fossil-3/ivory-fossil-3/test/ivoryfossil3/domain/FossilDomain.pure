###Pure
Enum {meta::pure::profiles::doc.doc = 'Preservation grade recorded for a catalogued fossil.'} test::ivoryfossil3::domain::PreservationGrade
{
  PRISTINE,
  WEATHERED,
  FRAGMENT,
  UNGRADED
}

Class {meta::pure::profiles::doc.doc = 'Any item held in the fossil collection.'} test::ivoryfossil3::domain::CollectionItem
{
  catalogueRef: String[1];
  recordKind: String[1];
}

Class {meta::pure::profiles::doc.doc = 'Measured outline of a specimen.'} test::ivoryfossil3::domain::Measurement
{
  lengthMm: Float[0..1];
  widthMm: Float[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A catalogued fossil specimen recovered from a dig-site layer.'} test::ivoryfossil3::domain::Specimen extends test::ivoryfossil3::domain::CollectionItem
{
  siteCode: String[1];
  specimenNo: Integer[1];
  layerNo: Integer[0..1];
  labelText: String[0..1];
  kindLabel: String[0..1];
  grade: test::ivoryfossil3::domain::PreservationGrade[1];
  foundOn: StrictDate[0..1];
  size: test::ivoryfossil3::domain::Measurement[0..1];
  siteName: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A numbered rock layer at a dig site.'} test::ivoryfossil3::domain::Stratum
{
  siteCode: String[1];
  layerNo: Integer[1];
  eraCode: String[0..1];
  depthM: Float[0..1];
  depthBand(limit: Float[1]) {if($this.depthM->isEmpty(), | 'UNMEASURED', | if($this.depthM->toOne() > $limit, | 'DEEP', | 'SHALLOW'))}: String[1];
}

Class {meta::pure::profiles::doc.doc = 'An excavation site.'} test::ivoryfossil3::domain::DigSite
{
  siteCode: String[1];
  siteName: String[1];
  regionCode: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A hand-written field tag captured before cataloguing.'} test::ivoryfossil3::domain::FieldTag
{
  tagRef: String[1];
  lengthMm: Float[0..1];
  wearScore: Integer[0..1];
  finderNote: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A graded index card derived from a field tag.'} test::ivoryfossil3::domain::SpecimenCard
{
  tagRef: String[1];
  grade: test::ivoryfossil3::domain::PreservationGrade[1];
  condition: test::ivoryfossil3::domain::PreservationGrade[1];
  note: String[1];
}

Association test::ivoryfossil3::domain::Stratum_Site
{
  strata: test::ivoryfossil3::domain::Stratum[*];
  site: test::ivoryfossil3::domain::DigSite[0..1];
}
