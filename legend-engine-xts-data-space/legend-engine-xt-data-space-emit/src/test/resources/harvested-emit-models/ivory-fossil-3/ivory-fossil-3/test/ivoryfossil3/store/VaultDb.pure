###Relational
Database test::ivoryfossil3::store::VaultDb
(
  include test::ivoryfossil3::store::FieldDb

  Schema vault
  (
    Table specimen
    (
      site_code VARCHAR(12) PRIMARY KEY,
      specimen_no INTEGER PRIMARY KEY,
      layer_no INTEGER,
      label_note VARCHAR(40),
      kind_code VARCHAR(4),
      grade_code VARCHAR(4),
      length_mm FLOAT,
      width_mm FLOAT,
      found_on DATE,
      status_code VARCHAR(2)
    )
    Table specimen_archive
    (
      site_code VARCHAR(12) PRIMARY KEY,
      specimen_no INTEGER PRIMARY KEY,
      layer_no INTEGER,
      label_note VARCHAR(40),
      kind_code VARCHAR(4),
      grade_code VARCHAR(4),
      length_mm FLOAT,
      width_mm FLOAT,
      found_on DATE,
      shelf_state VARCHAR(2)
    )
  )

  Join SpecimenStratum(vault.specimen.site_code = field.stratum.site_code and vault.specimen.layer_no = field.stratum.layer_no)
  Join ArchiveStratum(vault.specimen_archive.site_code = field.stratum.site_code and vault.specimen_archive.layer_no = field.stratum.layer_no)

  Filter CataloguedSpecimen(vault.specimen.status_code = 'C')
  Filter ShelvedArchive(vault.specimen_archive.shelf_state = 'S')
)
