###DataSpace
DataSpace test::ivoryfossil3::dataspace::FossilVaultDataSpace
{
  executionContexts:
  [
    {
      name: 'curated';
      description: 'Curated fossil register on the curated warehouse.';
      mapping: test::ivoryfossil3::mapping::FossilMapping;
      defaultRuntime: test::ivoryfossil3::runtime::VaultCuratedRuntime;
    },
    {
      name: 'staging';
      description: 'Staging copy of the fossil register.';
      mapping: test::ivoryfossil3::mapping::FossilMapping;
      defaultRuntime: test::ivoryfossil3::runtime::VaultStagingRuntime;
    },
    {
      name: 'reader';
      description: 'Read-only fossil register.';
      mapping: test::ivoryfossil3::mapping::FossilMapping;
      defaultRuntime: test::ivoryfossil3::runtime::VaultReaderRuntime;
    }
  ];
  defaultExecutionContext: 'curated';
  title: 'Fossil Vault Register';
  description: 'Catalogued and archived fossil specimens with their dig-site layers.';
  diagrams:
  [
    {
      title: 'Specimens';
      diagram: test::ivoryfossil3::diagram::SpecimenDiagram;
    }
  ];
  elements:
  [
    test::ivoryfossil3::domain::Specimen,
    test::ivoryfossil3::domain::Stratum
  ];
}

DataSpace test::ivoryfossil3::dataspace::FossilFieldDataSpace
{
  executionContexts:
  [
    {
      name: 'primary';
      description: 'Field layers on the primary field server.';
      mapping: test::ivoryfossil3::mapping::FossilMapping;
      defaultRuntime: test::ivoryfossil3::runtime::FieldPrimaryRuntime;
    },
    {
      name: 'replica';
      description: 'Field layers on the replica field server.';
      mapping: test::ivoryfossil3::mapping::FossilMapping;
      defaultRuntime: test::ivoryfossil3::runtime::FieldReplicaRuntime;
    }
  ];
  defaultExecutionContext: 'primary';
  title: 'Fossil Field Layers';
  description: 'Dig sites and the numbered layers specimens are recovered from.';
  diagrams:
  [
    {
      title: 'Field';
      diagram: test::ivoryfossil3::diagram::FieldDiagram;
    }
  ];
  elements:
  [
    test::ivoryfossil3::domain::Stratum,
    test::ivoryfossil3::domain::DigSite
  ];
}
