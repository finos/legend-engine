###Connection
RelationalDatabaseConnection test::ivoryfossil3::connection::VaultCuratedConnection
{
  store: test::ivoryfossil3::store::VaultDb;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'FOSSIL_REGISTER';
    account: 'fossil_curated_account';
    warehouse: 'FOSSIL_WH';
    region: 'eu-west-1';
    cloudType: 'aws';
    role: 'FOSSIL_CURATOR';
  };
  auth: OAuth
  {
    scopeName: 'session:role-fossil-curator';
    oauthKey: 'fossilcuratedaccountKey';
  };
  postProcessors:
  [
    mapper
    {
      mappers:
      [
        schema {from: 'vault'; to: 'vault_curated';},
        schema {from: 'field'; to: 'field_curated';},
        table {from: 'specimen_archive'; to: 'specimen_shelf'; schemaFrom: 'vault_curated'; schemaTo: 'vault_curated';}
      ];
    }
  ];
}

RelationalDatabaseConnection test::ivoryfossil3::connection::VaultStagingConnection
{
  store: test::ivoryfossil3::store::VaultDb;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'FOSSIL_REGISTER';
    account: 'fossil_staging_account';
    warehouse: 'FOSSIL_WH';
    region: 'eu-west-1';
    cloudType: 'aws';
    role: 'FOSSIL_STAGER';
  };
  auth: OAuth
  {
    scopeName: 'session:role-fossil-stager';
    oauthKey: 'fossilstagingaccountKey';
  };
  postProcessors:
  [
    mapper
    {
      mappers:
      [
        schema {from: 'vault'; to: 'vault_staging';},
        table {from: 'dig_site'; to: 'dig_site_current'; schemaFrom: 'field'; schemaTo: 'field';}
      ];
    }
  ];
}

