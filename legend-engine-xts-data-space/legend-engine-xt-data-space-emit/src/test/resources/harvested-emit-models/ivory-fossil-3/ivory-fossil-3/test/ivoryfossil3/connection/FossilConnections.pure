RelationalDatabaseConnection test::ivoryfossil3::connection::FieldPrimaryConnection
{
  store: test::ivoryfossil3::store::VaultDb;
  type: Sybase;
  specification: Static
  {
    name: 'FOSSIL_FIELD_PRIMARY';
    host: 'fossil-field-primary.example.invalid';
    port: 5000;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'sybase/fossil-field-primary.example.invalid';
  };
  postProcessors:
  [
    mapper
    {
      mappers:
      [
        schema {from: 'field'; to: 'field_archive';}
      ];
    }
  ];
}

