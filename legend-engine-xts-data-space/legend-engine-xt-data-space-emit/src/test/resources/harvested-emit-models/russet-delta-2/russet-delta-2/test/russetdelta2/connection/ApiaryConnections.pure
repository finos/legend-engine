###Connection
RelationalDatabaseConnection test::russetdelta2::connection::ApiaryH2Connection
{
  store: test::russetdelta2::store::ApiaryDb;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [];
  };
  auth: DefaultH2;
}

RelationalDatabaseConnection test::russetdelta2::connection::HarvestH2Connection
{
  store: test::russetdelta2::store::HarvestDb;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [];
  };
  auth: DefaultH2;
}

RelationalDatabaseConnection test::russetdelta2::connection::ApiaryWarehouseConnection
{
  store: test::russetdelta2::store::ApiaryDb;
  type: Snowflake;
  quoteIdentifiers: false;
  specification: Snowflake
  {
    name: 'APIARY_DB';
    account: 'apiary_yard_account';
    warehouse: 'APIARY_WH';
    region: 'eu-west-1';
    cloudType: 'aws';
    accountType: MultiTenant;
    organization: 'apiary_org';
    role: 'APIARY_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'APIARY_YARD_READER';
    privateKeyVaultReference: 'apiary.yard.privateKey';
    passPhraseVaultReference: 'apiary.yard.passPhrase';
  };
}

RelationalDatabaseConnection test::russetdelta2::connection::HarvestWarehouseConnection
{
  store: test::russetdelta2::store::HarvestDb;
  type: Snowflake;
  quoteIdentifiers: false;
  specification: Snowflake
  {
    name: 'HARVEST_DB';
    account: 'apiary_harvest_account';
    warehouse: 'HARVEST_WH';
    region: 'eu-west-1';
    cloudType: 'aws';
    accountType: MultiTenant;
    organization: 'apiary_org';
    role: 'HARVEST_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'APIARY_HARVEST_READER';
    privateKeyVaultReference: 'apiary.harvest.privateKey';
    passPhraseVaultReference: 'apiary.harvest.passPhrase';
  };
}
