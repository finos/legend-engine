###Relational
Database test::russetdelta2::store::HarvestDb
(
  Schema harvest
  (
    Table honey_lot
    (
      lot_code VARCHAR(16) PRIMARY KEY,
      yard_code VARCHAR(16),
      lot_kind VARCHAR(16),
      kilograms INTEGER,
      moisture_pct INTEGER,
      jar_count INTEGER
    )
    Table extraction_run
    (
      run_code VARCHAR(16) PRIMARY KEY,
      lot_code VARCHAR(16),
      run_on DATE,
      spun_frames INTEGER,
      operator_code VARCHAR(16)
    )
  )

  Join Run_Lot(harvest.extraction_run.lot_code = harvest.honey_lot.lot_code)
)
