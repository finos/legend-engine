###Connection
RelationalDatabaseConnection test::easternprairie2::connection::PrairieWarehouseConnection
{
  store: test::easternprairie2::store::PrairieSurveyDb;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'PRAIRIE_SURVEY';
    account: 'prairie_survey_warehouse';
    warehouse: 'PRAIRIE_SURVEY_WH';
    region: 'us-east-2';
    cloudType: 'aws';
    role: 'PRAIRIE_SURVEY_READER';
  };
  auth: OAuth
  {
    scopeName: 'session:role-prairie-survey-reader';
    oauthKey: 'prairieSurveyWarehouseOauthKey';
  };
}
