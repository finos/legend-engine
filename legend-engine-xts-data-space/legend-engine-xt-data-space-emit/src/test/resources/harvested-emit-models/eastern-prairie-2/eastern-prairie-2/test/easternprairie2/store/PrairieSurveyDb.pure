###Relational
Database test::easternprairie2::store::PrairieSurveyDb
(
  Schema survey
  (
    Table run_timeline
    (
      event_id BIGINT PRIMARY KEY,
      run_code VARCHAR(16) NOT NULL,
      observer VARCHAR(40) NOT NULL,
      logged_at TIMESTAMP NOT NULL,
      minutes_spent BIGINT,
      travel_minutes BIGINT,
      review_note VARCHAR(80)
    )

    Table plot_timeline
    (
      event_id BIGINT PRIMARY KEY,
      plot_code VARCHAR(16) NOT NULL,
      observer VARCHAR(40) NOT NULL,
      logged_at TIMESTAMP NOT NULL,
      stems_counted BIGINT,
      seedlings BIGINT
    )

    Table survey_run
    (
      run_code VARCHAR(16) PRIMARY KEY,
      lead_observer VARCHAR(40) NOT NULL,
      started_at TIMESTAMP NOT NULL,
      run_kind VARCHAR(16) NOT NULL,
      is_complete BIT NOT NULL,
      cover_ratio DOUBLE
    )

    Table tally_sheet
    (
      sheet_id BIGINT PRIMARY KEY,
      run_code VARCHAR(16) NOT NULL,
      sheet_ref VARCHAR(16) NOT NULL,
      recorded_by VARCHAR(40) NOT NULL
    )
  )

  Join Run_Sheet(survey.survey_run.run_code = survey.tally_sheet.run_code)
)
