###Mapping
Mapping test::easternprairie2::mapping::RunTimelineMapping
(
  *test::easternprairie2::domain::RunEvent[runEvent]: Relational
  {
    ~primaryKey
    (
      [test::easternprairie2::store::PrairieSurveyDb]survey.run_timeline.event_id
    )
    ~mainTable [test::easternprairie2::store::PrairieSurveyDb]survey.run_timeline
    eventId: [test::easternprairie2::store::PrairieSurveyDb]survey.run_timeline.event_id,
    runCode: [test::easternprairie2::store::PrairieSurveyDb]survey.run_timeline.run_code,
    observer: [test::easternprairie2::store::PrairieSurveyDb]survey.run_timeline.observer,
    loggedAt: [test::easternprairie2::store::PrairieSurveyDb]survey.run_timeline.logged_at,
    minutesSpent: [test::easternprairie2::store::PrairieSurveyDb]survey.run_timeline.minutes_spent,
    travelMinutes: [test::easternprairie2::store::PrairieSurveyDb]survey.run_timeline.travel_minutes,
    reviewNote: [test::easternprairie2::store::PrairieSurveyDb]survey.run_timeline.review_note
  }

  testSuites:
  [
    runEventSuite:
    {
      function: |test::easternprairie2::domain::RunEvent.all()->project(
        [
          e|$e.eventId,
          e|$e.runCode,
          e|$e.observer,
          e|$e.minutesSpent,
          e|$e.reviewNote
        ],
        [
          'Event',
          'Run',
          'Observer',
          'Minutes',
          'Note'
        ]
      )->sort([asc('Event')]);
      tests:
      [
        runEventsBindOneToOne:
        {
          doc: 'Effort entries bind their columns one to one, keeping an absent review note as null.';
          data:
          [
            test::easternprairie2::store::PrairieSurveyDb:
              Relational
              #{
                survey.run_timeline:
                  'event_id,run_code,observer,logged_at,minutes_spent,travel_minutes,review_note\n'+
                  '1,NWPR-101,ana,2026-03-01 00:00:00,50,10,\n'+
                  '9,SEPR-202,dee,2026-04-11 10:00:00,35,5,recheck\n';
              }#
          ];
          asserts:
          [
            runEventRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Event":1,"Run":"NWPR-101","Observer":"ana","Minutes":50,"Note":null},{"Event":9,"Run":"SEPR-202","Observer":"dee","Minutes":35,"Note":"recheck"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
