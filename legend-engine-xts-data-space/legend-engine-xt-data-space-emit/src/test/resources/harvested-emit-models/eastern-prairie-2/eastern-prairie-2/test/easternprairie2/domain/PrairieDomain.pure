###Pure
import meta::pure::profiles::*;

Class {doc.doc = 'One logged effort entry of a prairie survey run.'} test::easternprairie2::domain::RunEvent
{
  eventId: Integer[1];
  runCode: String[1];
  observer: String[1];
  loggedAt: DateTime[1];
  minutesSpent: Integer[0..1];
  travelMinutes: Integer[0..1];
  reviewNote: String[0..1];
  weekNumber() {$this.loggedAt->weekOfYear()}: Integer[1];
}

Class {doc.doc = 'One stem count taken on a restoration plot.'} test::easternprairie2::domain::PlotEvent
{
  eventId: Integer[1];
  plotCode: String[1];
  observer: String[1];
  loggedAt: DateTime[1];
  stemsCounted: Integer[0..1];
  seedlings: Integer[0..1];
  weekNumber() {$this.loggedAt->weekOfYear()}: Integer[1];
}

Class {doc.doc = 'A field survey run led by one observer.'} test::easternprairie2::domain::SurveyRun
{
  runCode: String[1];
  leadObserver: String[1];
  startedAt: DateTime[1];
  runKind: String[1];
  isComplete: Boolean[1];
  coverRatio: Float[0..1];
  weekNumber() {$this.startedAt->weekOfYear()}: Integer[1];
}

Class {doc.doc = 'A paper tally sheet filled in during a survey run.'} test::easternprairie2::domain::TallySheet
{
  sheetId: Integer[1];
  sheetRef: String[1];
  recordedBy: String[1];
}

Association test::easternprairie2::domain::RunSheets
{
  run: test::easternprairie2::domain::SurveyRun[1];
  sheets: test::easternprairie2::domain::TallySheet[*];
}
