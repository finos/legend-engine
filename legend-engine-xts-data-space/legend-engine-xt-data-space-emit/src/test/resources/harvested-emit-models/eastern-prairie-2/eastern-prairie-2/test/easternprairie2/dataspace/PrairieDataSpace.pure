###DataSpace
DataSpace test::easternprairie2::dataspace::PrairieSurveyDataSpace
{
  executionContexts:
  [
    {
      name: 'runs';
      description: 'Survey runs and their tally sheets over the shared runtime.';
      mapping: test::easternprairie2::mapping::FieldRunMapping;
      defaultRuntime: test::easternprairie2::runtime::PrairieSurveyRuntime;
    },
    {
      name: 'runTimeline';
      description: 'Run effort timeline over the shared runtime.';
      mapping: test::easternprairie2::mapping::RunTimelineMapping;
      defaultRuntime: test::easternprairie2::runtime::PrairieSurveyRuntime;
    },
    {
      name: 'plotTimeline';
      description: 'Plot stem-count timeline over the shared runtime.';
      mapping: test::easternprairie2::mapping::PlotTimelineMapping;
      defaultRuntime: test::easternprairie2::runtime::PrairieSurveyRuntime;
    },
    {
      name: 'sheetAudit';
      description: 'Tally-sheet audit view of the run mapping over the shared runtime.';
      mapping: test::easternprairie2::mapping::FieldRunMapping;
      defaultRuntime: test::easternprairie2::runtime::PrairieSurveyRuntime;
    }
  ];
  defaultExecutionContext: 'runs';
  title: 'Prairie Restoration Survey';
  description: 'Survey runs, tally sheets, run effort and plot stem counts of a tallgrass prairie restoration.';
  elements:
  [
    test::easternprairie2::domain
  ];
}
