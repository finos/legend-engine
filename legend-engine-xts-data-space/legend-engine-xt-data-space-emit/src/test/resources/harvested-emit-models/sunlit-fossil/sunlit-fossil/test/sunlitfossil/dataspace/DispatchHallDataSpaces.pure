###DataSpace
DataSpace test::sunlitfossil::dataspace::DispatchHallCuratedDataSpace
{
  executionContexts:
  [
    {
      name: 'curated';
      description: 'Curated tier - the shared specimen-dispatch mapping resolved through the curated warehouse connection.';
      mapping: test::sunlitfossil::mapping::SpecimenDispatchMapping;
      defaultRuntime: test::sunlitfossil::runtime::DispatchHallCuratedRuntime;
    }
  ];
  defaultExecutionContext: 'curated';
  title: 'Sunlit Fossil Dispatch Hall - Curated';
  description: 'Discovery surface over milestoned specimen dispatch dispatches, their line items and portions, bound to the curated deployment whose post-processor rewrites the dispatch-hall schema onto the curated listing schema.';
}

DataSpace test::sunlitfossil::dataspace::DispatchHallArchiveDataSpace
{
  executionContexts:
  [
    {
      name: 'archive';
      description: 'Archive tier - the same specimen-dispatch mapping resolved through the archive warehouse connection.';
      mapping: test::sunlitfossil::mapping::SpecimenDispatchMapping;
      defaultRuntime: test::sunlitfossil::runtime::DispatchHallArchiveRuntime;
    }
  ];
  defaultExecutionContext: 'archive';
  title: 'Sunlit Fossil Dispatch Hall - Archive';
  description: 'The same milestoned specimen-dispatch surface published against the archive deployment, where only the schema qualifier of the generated SQL differs from the curated tier.';
}
