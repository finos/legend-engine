###Relational
Database test::teallantern4::store::TideGaugeDb
(
  Schema tides
  (
    Table gauge_reading
    (
      reading_code VARCHAR(24) PRIMARY KEY,
      station_code VARCHAR(16) NOT NULL,
      gauge_kind VARCHAR(16) NOT NULL,
      quality_flag VARCHAR(16),
      reading_date DATE NOT NULL,
      height_cm INTEGER NOT NULL
    )
  )
)
