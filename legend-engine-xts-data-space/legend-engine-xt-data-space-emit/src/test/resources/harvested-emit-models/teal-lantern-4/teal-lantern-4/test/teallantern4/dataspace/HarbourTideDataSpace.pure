###DataSpace
DataSpace test::teallantern4::dataspace::HarbourTideDataSpace
{
  executionContexts:
  [
    {
      name: 'lake';
      description: 'The include-only harbour mapping executed through the schema-remapped lake warehouse.';
      mapping: test::teallantern4::mapping::HarbourLakeMapping;
      defaultRuntime: test::teallantern4::runtime::HarbourLakeRuntime;
    }
  ];
  defaultExecutionContext: 'lake';
  title: 'Harbour Tide Gauges';
  description: 'Discovery surface over the daily verified float-gauge readings of the harbour tide stations.';
  executables:
  [
    {
      id: 1;
      title: 'Verified Float Readings For A Day';
      description: 'The readings of one day taken by float gauges with a good quality flag.';
      executable: test::teallantern4::service::FloatGaugeDailyReadings;
    }
  ];
  supportInfo: Email
  {
    address: 'harbour-tide-desk';
  };
}
