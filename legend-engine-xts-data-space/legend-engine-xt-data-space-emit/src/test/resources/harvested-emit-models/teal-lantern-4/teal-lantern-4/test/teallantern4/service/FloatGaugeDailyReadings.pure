###Service
Service test::teallantern4::service::FloatGaugeDailyReadings
{
  pattern: '/teallantern4/v1/float-readings/{readingDate}';
  title: 'Harbour Tide Gauges - Verified Float Readings For A Day';
  documentation: 'Lists the readings taken on the requested day by float gauges whose quality flag has been verified as good, reporting the day, the station, the reading code and the water height.';
  autoActivateUpdates: false;
  ownership: UserList { users: ['tide-desk', 'harbour-master', 'gauge-maintenance', 'coastal-survey', 'pilot-office'] };
  execution: Single
  {
    query: {readingDate: StrictDate[1]|test::teallantern4::domain::TideReading.all()->filter(
      r|($r.readingDate == $readingDate) && (($r.gaugeKind == 'FLOAT') && ($r.qualityFlag == 'GOOD'))
    )->project(
      [
        r|$r.readingDate,
        r|$r.stationCode,
        r|$r.readingCode,
        r|$r.heightCm
      ],
      [
        'ReadingDate',
        'Station',
        'Reading',
        'HeightCm'
      ]
    )->sort([asc('Reading')])};
    mapping: test::teallantern4::mapping::HarbourLakeMapping;
    runtime: test::teallantern4::runtime::HarbourLakeRuntime;
  }
  testSuites:
  [
    floatReadingsSuite:
    {
      data:
      [
        connections:
        [
          harbourConnection:
            Relational
            #{
              tides.gauge_reading:
                'reading_code,station_code,gauge_kind,quality_flag,reading_date,height_cm\n'+
                'TR-1,pier-north,float,good,2026-07-14,312\n'+
                'TR-2,PIER-SOUTH,RADAR,good,2026-07-14,298\n'+
                'TR-3,breakwater,FLOAT,suspect,2026-07-14,305\n'+
                'TR-4,breakwater,FLOAT,,2026-07-14,301\n'+
                'TR-5,PIER-NORTH,FLOAT,GOOD,2026-07-15,288\n';
            }#
        ]
      ]
      tests:
      [
        onlyTheVerifiedFloatReadingOfTheDay:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            readingDate = %2026-07-14
          ]
          asserts:
          [
            radarSuspectAndUncheckedReadingsDropOut:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"ReadingDate":"2026-07-14","Station":"PIER-NORTH","Reading":"TR-1","HeightCm":312}]';
                  }#;
              }#
          ]
        },
        aDayWithNoReadingsReturnsNothing:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            readingDate = %2026-07-16
          ]
          asserts:
          [
            emptyDay:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
