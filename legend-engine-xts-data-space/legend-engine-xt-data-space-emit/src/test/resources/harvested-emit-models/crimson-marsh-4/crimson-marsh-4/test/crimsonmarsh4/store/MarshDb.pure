###Relational
Database test::crimsonmarsh4::store::MarshDb
(
  Schema marsh
  (
    Table reed_census
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      census_ref VARCHAR(20) PRIMARY KEY,
      bed_code VARCHAR(12) NOT NULL,
      stem_grade INTEGER,
      stem_density INTEGER,
      water_depth_cm INTEGER,
      from_z DATE PRIMARY KEY,
      thru_z DATE
    )

    Table reed_bed
    (
      bed_code VARCHAR(12) PRIMARY KEY,
      bed_name VARCHAR(64) NOT NULL,
      warden_code VARCHAR(12) NOT NULL
    )
  )

  Join Census_Bed(marsh.reed_census.bed_code = marsh.reed_bed.bed_code)
)
