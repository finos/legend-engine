###Connection
RelationalDatabaseConnection test::crimsonmarsh4::connection::MarshH2Connection
{
  store: test::crimsonmarsh4::store::MarshDb;
  type: H2;
  specification: LocalH2 { testDataSetupSqls: []; };
  auth: DefaultH2;
}

RelationalDatabaseConnection test::crimsonmarsh4::connection::MarshWarehouseConnection
{
  store: test::crimsonmarsh4::store::MarshDb;
  type: Snowflake;
  timezone: +0000;
  quoteIdentifiers: false;
  specification: Snowflake
  {
    name: 'MARSH_REED_DB';
    account: 'marsh_reed_account';
    warehouse: 'MARSH_WH';
    region: 'eu-west-2';
    cloudType: 'aws';
    accountType: MultiTenant;
    organization: 'marsh_reed_org';
    role: 'MARSH_READER';
  };
  auth: OAuth
  {
    oauthKey: 'marsh_oauth_key';
    scopeName: 'SESSION:ROLE:MARSH_READER';
  };
}
