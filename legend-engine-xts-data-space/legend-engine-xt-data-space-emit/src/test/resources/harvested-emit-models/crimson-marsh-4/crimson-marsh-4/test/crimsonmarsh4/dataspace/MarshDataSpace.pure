###DataSpace
DataSpace test::crimsonmarsh4::dataspace::MarshDataSpace
{
  executionContexts:
  [
    {
      name: 'warden';
      description: 'Warden environment - the census binding served through the local marsh warehouse.';
      mapping: test::crimsonmarsh4::mapping::MarshMapping;
      defaultRuntime: test::crimsonmarsh4::runtime::MarshRuntime;
    },
    {
      name: 'warehouse';
      description: 'Warehouse environment - the same census binding served through the published warehouse connection.';
      mapping: test::crimsonmarsh4::mapping::MarshMapping;
      defaultRuntime: test::crimsonmarsh4::runtime::MarshWarehouseRuntime;
    }
  ];
  defaultExecutionContext: 'warden';
  title: 'Crimson Marsh Reed Census';
  description: 'Discovery surface over the reed census timeline: the banded census versions and the reed beds they are held against.';
  elements:
  [
    test::crimsonmarsh4::domain::ReedBed,
    test::crimsonmarsh4::domain::ReedCensus
  ];
  supportInfo: Email
  {
    address: 'marsh-census-desk@marshcensus.invalid';
  };
}
