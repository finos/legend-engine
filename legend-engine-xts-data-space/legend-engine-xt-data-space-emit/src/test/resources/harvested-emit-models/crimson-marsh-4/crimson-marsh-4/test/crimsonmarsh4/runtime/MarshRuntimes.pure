###Runtime
Runtime test::crimsonmarsh4::runtime::MarshRuntime
{
  mappings:
  [
    test::crimsonmarsh4::mapping::MarshMapping
  ];
  connections:
  [
    test::crimsonmarsh4::store::MarshDb:
    [
      h2Connection: test::crimsonmarsh4::connection::MarshH2Connection
    ]
  ];
}

Runtime test::crimsonmarsh4::runtime::MarshWarehouseRuntime
{
  mappings:
  [
    test::crimsonmarsh4::mapping::MarshMapping
  ];
  connections:
  [
    test::crimsonmarsh4::store::MarshDb:
    [
      warehouseConnection: test::crimsonmarsh4::connection::MarshWarehouseConnection
    ]
  ];
}
