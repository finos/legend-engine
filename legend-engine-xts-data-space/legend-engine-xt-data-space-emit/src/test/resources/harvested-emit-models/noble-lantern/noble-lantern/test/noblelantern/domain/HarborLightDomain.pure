###Pure
import test::noblelantern::domain::*;

Class {meta::pure::profiles::doc.doc = 'A lantern station on the harbour approaches, described by its district, its optic class and the heights the light is carried at.'} test::noblelantern::domain::LanternStation
{
  stationCode: String[1];
  stationName: String[1];
  districtName: String[1];
  opticClass: String[1];
  stationKind: String[1];
  focalHeightM: Float[1];
  towerHeightM: Float[0..1];
  commissionedOn: StrictDate[1];
  inspectedAt: DateTime[0..1];
}

Class {meta::pure::profiles::doc.doc = 'One keeper watch logged at a lantern station, recording the shift, the observed weather and the stamps bounding the watch.'} test::noblelantern::domain::KeeperWatch
{
  watchCode: String[1];
  stationCode: String[1];
  keeperName: String[1];
  watchShift: String[1];
  weatherNote: String[0..1];
  visibilityKm: Float[1];
  windSpeedKt: Float[0..1];
  loggedOn: StrictDate[1];
  startedAt: DateTime[1];
  endedAt: DateTime[0..1];
}
