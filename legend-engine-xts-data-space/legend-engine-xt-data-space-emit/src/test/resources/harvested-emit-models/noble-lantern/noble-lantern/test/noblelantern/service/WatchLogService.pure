###Service
Service test::noblelantern::service::WatchLogService
{
  pattern: '/noble-lantern/v1/night-watches';
  title: 'Noble Lantern - Night Watch Log';
  owners:
  [
    'harbor-light-register-desk',
    'keeper-roster-ops'
  ];
  documentation: 'Publishes the night watches kept by the named keeper family at the accepted stations, with the keeper name normalised before the substring test and the logged visibility held above the reporting floor; the projected rows are narrowed once more, ordered and capped.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: |test::noblelantern::domain::KeeperWatch.all()->filter(
      w|($w.watchShift == 'NIGHT') && ($w.keeperName->toLower()->contains('hal') && ($w.stationCode->in(['LS-01', 'LS-03', 'LS-04']) && ($w.visibilityKm > 4.0)))
    )->project(
      [
        w|$w.watchCode,
        w|$w.stationCode,
        w|$w.keeperName,
        w|$w.watchShift,
        w|$w.weatherNote,
        w|$w.visibilityKm,
        w|$w.windSpeedKt,
        w|$w.loggedOn,
        w|$w.startedAt,
        w|$w.endedAt
      ],
      [
        'Watch',
        'Station',
        'Keeper',
        'Shift',
        'Weather',
        'Visibility',
        'WindSpeed',
        'LoggedOn',
        'StartedAt',
        'EndedAt'
      ]
    )->filter(
      r|$r.getString('Keeper')->toUpper()->endsWith('Z') || ($r.getString('Shift') == 'NIGHT')
    )->sort(
      [
        asc('Watch')
      ]
    )->limit(10);
    mapping: test::noblelantern::mapping::HarborLightMapping;
    runtime: test::noblelantern::runtime::HarborLightRuntime;
  }
  testSuites:
  [
    nightWatchSuite:
    {
      data:
      [
        connections:
        [
          harborLightConnection:
            Relational
            #{
              beacon.keeper_watch:
                'watch_code,station_code,keeper_name,watch_shift,weather_note,visibility_km,wind_speed_kt,logged_on,started_at,ended_at\n'+
                'KW-01,LS-01,Halvard Nye,NIGHT,Clear horizon,12.5,18.0,2026-04-02,2026-04-02 20:00:00,2026-04-03 04:00:00\n'+
                'KW-02,LS-01,Marin Sault,DAY,,9.0,,2026-04-03,2026-04-03 06:00:00,\n'+
                'KW-03,LS-03,Halina Brace,NIGHT,Fog layer,3.5,22.5,2026-04-04,2026-04-04 19:30:00,2026-04-05 03:30:00\n'+
                'KW-04,LS-04,Halcyon Reed,NIGHT,Light drizzle,7.25,11.0,2026-04-05,2026-04-05 20:15:00,\n';
            }#
        ]
      ]
      tests:
      [
        nightWatchRows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            clearNightWatches:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Watch":"KW-01","Station":"LS-01","Keeper":"Halvard Nye","Shift":"NIGHT","Weather":"Clear horizon","Visibility":12.5,"WindSpeed":18.0,"LoggedOn":"2026-04-02","StartedAt":"2026-04-02T20:00:00.000000000+0000","EndedAt":"2026-04-03T04:00:00.000000000+0000"},{"Watch":"KW-04","Station":"LS-04","Keeper":"Halcyon Reed","Shift":"NIGHT","Weather":"Light drizzle","Visibility":7.25,"WindSpeed":11.0,"LoggedOn":"2026-04-05","StartedAt":"2026-04-05T20:15:00.000000000+0000","EndedAt":null}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
