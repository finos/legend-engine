###Connection
RelationalDatabaseConnection test::noblelantern::connection::HarborLightWarehouseConnection
{
  store: test::noblelantern::store::HarborLightDatabase;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'EXAMPLE_HARBOR_LIGHT_DB';
    account: 'example_harbor_light_account';
    warehouse: 'EXAMPLE_HARBOR_LIGHT_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    role: 'EXAMPLE_HARBOR_LIGHT_ROLE';
  };
  auth: OAuth
  {
    oauthKey: 'harbor_light_register_oauth_key';
    scopeName: 'SESSION:ROLE:HARBOR_LIGHT_REGISTER_READER';
  };
}
