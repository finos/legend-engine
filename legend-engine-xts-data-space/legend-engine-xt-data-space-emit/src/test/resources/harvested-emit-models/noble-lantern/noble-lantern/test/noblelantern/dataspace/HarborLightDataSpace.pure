###DataSpace
DataSpace test::noblelantern::dataspace::HarborLightDataSpace
{
  executionContexts:
  [
    {
      name: 'harbor';
      description: 'Harbour environment - the station register and the keeper watch log resolved through the harbour light mapping and its warehouse runtime.';
      mapping: test::noblelantern::mapping::HarborLightMapping;
      defaultRuntime: test::noblelantern::runtime::HarborLightRuntime;
    }
  ];
  defaultExecutionContext: 'harbor';
  title: 'Noble Lantern Harbour Light Registers';
  description: 'Curated entry point over the harbour approach lights: the lantern station register and the keeper watches logged at those stations, served from one mapping and runtime pair and laid out in a class diagram.';
  elements:
  [
    test::noblelantern::domain::LanternStation
  ];
  executables:
  [
    {
      id: 1;
      title: 'Northern Approach Station Register';
      description: 'The normalised district prefix test over the accepted optic set, kept to mainland stations above the reporting focal height.';
      executable: test::noblelantern::service::StationRegisterService;
    }
  ];
  supportInfo: Email
  {
    address: 'harbor-light-register-support-group';
  };
}
