###Pure
import meta::pure::profiles::*;
import test::opalwarren2::domain::*;

Class {doc.doc = 'One hung bell in the tower register, carrying the readings its tone label and ringing tier are resolved from.'} test::opalwarren2::domain::TowerBell
{
  bellRef: String[1];
  bellName: String[1];
  toneCode: String[1];
  canonWeightKg: Integer[1];
  headstockCode: String[1];
  toneLabel: String[1];
  ringingTier: String[1];
  swingMargin: Integer[1];
}

Class {doc.doc = 'The belfry frame a ring of bells is hung in.'} test::opalwarren2::domain::Belfry
{
  belfryCode: String[1];
  belfryName: String[1];
  frameKind: String[1];
}

Association {doc.doc = 'Holds a ring of bells against the belfry frame it hangs in.'} test::opalwarren2::domain::BellHousing
{
  housedBells: TowerBell[*];
  belfry: Belfry[0..1];
}
