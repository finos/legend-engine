###Relational
Database test::opalwarren2::store::BellCoreDb
(
  Schema tower
  (
    Table hung_bell
    (
      bell_id INTEGER PRIMARY KEY,
      bell_ref VARCHAR(16),
      bell_name VARCHAR(128),
      tone_code VARCHAR(8),
      canon_weight_kg INTEGER,
      headstock_code VARCHAR(16),
      belfry_code VARCHAR(16),
      status_code VARCHAR(16)
    )
    Table belfry_frame
    (
      belfry_code VARCHAR(16) PRIMARY KEY,
      belfry_name VARCHAR(128),
      frame_kind VARCHAR(32)
    )
  )
)
