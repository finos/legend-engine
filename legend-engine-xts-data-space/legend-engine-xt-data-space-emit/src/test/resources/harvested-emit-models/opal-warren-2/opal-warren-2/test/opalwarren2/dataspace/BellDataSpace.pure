###DataSpace
DataSpace test::opalwarren2::dataspace::BellDataSpace
{
  executionContexts:
  [
    {
      name: 'towerRegister';
      description: 'Primary tier - the graded ring of bells and the belfry frames they hang in, over the in-process store.';
      mapping: test::opalwarren2::mapping::BellRegisterMapping;
      defaultRuntime: test::opalwarren2::runtime::BellRegisterRuntime;
    }
  ];
  defaultExecutionContext: 'towerRegister';
  title: 'Opal Warren 2 Tower Ring Register';
  description: 'A governed entry point over the hung bells of a tower ring, their resolved tone labels and ringing tiers, and the belfry frames they are housed in, wiring the register mapping to an in-process tier.';
}
