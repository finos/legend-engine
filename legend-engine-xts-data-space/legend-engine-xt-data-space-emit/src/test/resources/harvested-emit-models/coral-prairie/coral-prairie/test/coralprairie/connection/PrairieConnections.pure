###Connection
RelationalDatabaseConnection test::coralprairie::connection::PrairieConnection
{
  store: test::coralprairie::store::PrairieStore;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'PRAIRIE_RESTORATION_DB';
    account: 'prairie_restoration_account';
    warehouse: 'PRAIRIE_RESTORATION_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    role: 'PRAIRIE_RESTORATION_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'PRAIRIE_RESTORATION_USER';
    privateKeyVaultReference: 'prairie.restoration.privateKey';
    passPhraseVaultReference: 'prairie.restoration.passPhrase';
  };
}
