###DataSpace
DataSpace test::wistfulthistle3::dataspace::GardenDataSpace
{
  executionContexts:
  [
    {
      name: 'curatedCollection';
      description: 'Primary tier - the curated accession, bed and herbarium surfaces of the botanic garden warehouse.';
      mapping: test::wistfulthistle3::mapping::GardenMapping;
      defaultRuntime: test::wistfulthistle3::runtime::GardenCuratedRuntime;
    },
    {
      name: 'archiveCollection';
      description: 'Archive tier - the same curated model read against the archive warehouse the garden keeps its retired accessions in.';
      mapping: test::wistfulthistle3::mapping::GardenMapping;
      defaultRuntime: test::wistfulthistle3::runtime::GardenArchiveRuntime;
    }
  ];
  defaultExecutionContext: 'curatedCollection';
  title: 'Botanic Garden Living Collection';
  description: 'A governed entry point over the living collection of a botanic garden: plant accessions, the beds they stand in and the herbarium sheets pressed behind them, wired to a curated warehouse tier and an archive tier.';
}
