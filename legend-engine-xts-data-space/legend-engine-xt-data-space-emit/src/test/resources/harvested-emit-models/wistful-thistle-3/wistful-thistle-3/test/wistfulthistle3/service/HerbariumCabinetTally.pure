###Service
Service test::wistfulthistle3::service::HerbariumCabinetTally
{
  pattern: '/garden/v1/herbarium/{cabinetCode}';
  title: 'Botanic Garden - Herbarium Cabinet Sheets';
  ownership: DID { identifier: 'garden-herbarium' };
  documentation: 'Lists the sheets filed in one herbarium cabinet whose accession is one of a supplied set and which carry at least the requested number of duplicates, projecting the filing columns of the sheet surface.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: {cabinetCode: String[1], accessions: String[*], minDuplicates: Integer[1]|test::wistfulthistle3::domain::HerbariumSheet.all()->filter(
      s|(($s.cabinetCode == $cabinetCode) && ($s.accessionCode->in($accessions))) && ($s.duplicateCount >= $minDuplicates)
    )->project(
      [
        s|$s.sheetCode,
        s|$s.accessionCode,
        s|$s.collectorName,
        s|$s.duplicateCount
      ],
      [
        'Sheet',
        'Accession',
        'Collector',
        'Duplicates'
      ]
    )->sort([asc('Sheet')])};
    mapping: test::wistfulthistle3::mapping::GardenMapping;
    runtime: test::wistfulthistle3::runtime::GardenCuratedRuntime;
  }
  testSuites:
  [
    cabinetTallySuite:
    {
      data:
      [
        connections:
        [
          gardenCuratedConnection:
            Relational
            #{
              garden.herbarium_sheet:
                'sheet_code,accession_code,collector_name,cabinet_code,duplicate_count\n'+
                'SH-001,ACC-001,Wren Aster,CAB-1,3\n'+
                'SH-002,ACC-002,Ash Verbena,CAB-1,1\n'+
                'SH-003,ACC-003,Rook Sedge,CAB-1,4\n'+
                'SH-004,ACC-001,Wren Aster,CAB-2,5\n';
            }#
        ]
      ]
      tests:
      [
        firstCabinetWellDuplicated:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            cabinetCode = 'CAB-1',
            accessions = ['ACC-001', 'ACC-002', 'ACC-003'],
            minDuplicates = 3
          ]
          asserts:
          [
            twoSheetsFiled:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Sheet":"SH-001","Accession":"ACC-001","Collector":"Wren Aster","Duplicates":3},{"Sheet":"SH-003","Accession":"ACC-003","Collector":"Rook Sedge","Duplicates":4}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
