###Relational
Database test::wistfulthistle3::store::GardenDb
(
  Schema garden
  (
    Table plant_accession
    (
      accession_code VARCHAR(24) PRIMARY KEY,
      taxon_name VARCHAR(160) NOT NULL,
      family_name VARCHAR(80) NOT NULL,
      origin_region VARCHAR(60) NOT NULL,
      bed_code VARCHAR(24) NOT NULL,
      height_cm INTEGER NOT NULL,
      hardiness_zone INTEGER NOT NULL,
      propagation_note VARCHAR(240)
    )

    Table garden_bed
    (
      bed_code VARCHAR(24) PRIMARY KEY,
      bed_name VARCHAR(120) NOT NULL,
      quarter_name VARCHAR(60) NOT NULL,
      exposure VARCHAR(24) NOT NULL,
      area_sqm INTEGER NOT NULL
    )

    Table herbarium_sheet
    (
      sheet_code VARCHAR(24) PRIMARY KEY,
      accession_code VARCHAR(24) NOT NULL,
      collector_name VARCHAR(120) NOT NULL,
      cabinet_code VARCHAR(24) NOT NULL,
      duplicate_count INTEGER NOT NULL
    )
  )
)
