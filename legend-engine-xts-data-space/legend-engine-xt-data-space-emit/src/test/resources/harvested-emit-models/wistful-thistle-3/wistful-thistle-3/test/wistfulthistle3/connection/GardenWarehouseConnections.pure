###Connection
RelationalDatabaseConnection test::wistfulthistle3::connection::GardenCuratedConnection
{
  store: test::wistfulthistle3::store::GardenDb;
  type: Snowflake;
  quoteIdentifiers: false;
  specification: Snowflake
  {
    name: 'GARDEN_CURATED';
    account: 'garden_curated_account';
    warehouse: 'GARDEN_CURATED_WH';
    region: 'eu-west-2';
    cloudType: 'aws';
    accountType: MultiTenant;
    organization: 'garden_org';
    role: 'GARDEN_CURATOR';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'GARDEN_CURATED_USER';
    privateKeyVaultReference: 'garden-curated-private-key';
    passPhraseVaultReference: 'garden-curated-passphrase';
  };
}

###Connection
RelationalDatabaseConnection test::wistfulthistle3::connection::GardenArchiveConnection
{
  store: test::wistfulthistle3::store::GardenDb;
  type: Snowflake;
  quoteIdentifiers: false;
  specification: Snowflake
  {
    name: 'GARDEN_ARCHIVE';
    account: 'garden_archive_account';
    warehouse: 'GARDEN_ARCHIVE_WH';
    region: 'eu-west-2';
    cloudType: 'aws';
    accountType: MultiTenant;
    organization: 'garden_org';
    role: 'GARDEN_ARCHIVIST';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'GARDEN_ARCHIVE_USER';
    privateKeyVaultReference: 'garden-archive-private-key';
    passPhraseVaultReference: 'garden-archive-passphrase';
  };
}
