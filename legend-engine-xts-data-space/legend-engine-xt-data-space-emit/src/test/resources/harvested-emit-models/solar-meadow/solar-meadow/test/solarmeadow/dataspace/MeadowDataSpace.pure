###DataSpace
DataSpace test::solarmeadow::dataspace::MeadowDataSpace
{
  executionContexts:
  [
    {
      name: 'localMeadow';
      description: 'Primary tier - live plots, their grouped bloom view and the banded counts over the in-process store.';
      mapping: test::solarmeadow::mapping::MeadowMapping;
      defaultRuntime: test::solarmeadow::runtime::MeadowH2Runtime;
    },
    {
      name: 'archiveMeadow';
      description: 'Archive tier - the same curated mapping bound to the warehouse surface that holds the retained survey seasons.';
      mapping: test::solarmeadow::mapping::MeadowMapping;
      defaultRuntime: test::solarmeadow::runtime::MeadowLakeRuntime;
    }
  ];
  defaultExecutionContext: 'localMeadow';
  title: 'Solar Meadow Restoration Monitoring';
  description: 'A governed entry point over restored wildflower plots, their sward types, the grouped per-plot bloom view and the banded pollinator bloom counts, wiring the curated mapping to an in-process tier and a warehouse archive tier.';
}
