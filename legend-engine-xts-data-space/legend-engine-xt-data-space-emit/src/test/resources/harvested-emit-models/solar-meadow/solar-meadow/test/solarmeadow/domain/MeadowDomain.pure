###Pure
import test::solarmeadow::domain::*;

Class test::solarmeadow::domain::MeadowPlot
{
  plotCode: String[1];
  plotName: String[1];
  swardName: String[1];
  canopyTier: String[1];
  sownYear: Integer[1];
  areaM2: Float[1];
  firstSurveyDate: StrictDate[1];
  summary: PlotBloomSummary[0..1];
  displayLabel() {$this.plotName->toUpper()->trim() + ' / ' + $this.swardName}: String[1];
  stemsPerAre() {if($this.summary->isEmpty(), | 0.0, | $this.summary.totalStems->toOne() / ($this.areaM2 / 100.0))}: Float[1];
}

Class test::solarmeadow::domain::PlotBloomSummary
{
  plotCode: String[1];
  countTally: Integer[1];
  totalStems: Integer[1];
  peakCover: Float[0..1];
}

Class test::solarmeadow::domain::SwardType
{
  swardCode: String[1];
  swardName: String[1];
  canopyTier: String[1];
}

Class test::solarmeadow::domain::BloomCount
{
  countId: Integer[1];
  plotCode: String[1];
  taxonCode: String[1];
  countedOn: StrictDate[1];
  stemTally: Integer[1];
  coverPct: Float[0..1];
  coverBand: String[1];
  swardName: String[1];
  countSeason() {if($this.countedOn->monthNumber() <= 5, | 'EARLY', | if($this.countedOn->monthNumber() <= 7, | 'PEAK', | 'LATE'))}: String[1];
}

Class test::solarmeadow::domain::PollinatorTaxon
{
  taxonCode: String[1];
  taxonName: String[1];
  guildCode: String[1];
  forageSpan: Integer[1];
}
