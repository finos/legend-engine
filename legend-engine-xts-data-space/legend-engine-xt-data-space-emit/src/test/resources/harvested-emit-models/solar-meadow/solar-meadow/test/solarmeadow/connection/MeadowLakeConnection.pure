###Connection
RelationalDatabaseConnection test::solarmeadow::connection::MeadowLakeConnection
{
  store: test::solarmeadow::store::MeadowDatabase;
  type: Snowflake;
  timezone: +0000;
  specification: Snowflake
  {
    name: 'MEADOW_RESTORATION_DB';
    account: 'meadow_reference_account';
    warehouse: 'MEADOW_QUERY_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    enableQueryTags: false;
    role: 'MEADOW_READER';
  };
  auth: OAuth
  {
    oauthKey: 'MEADOW_OAUTH';
    scopeName: 'SESSION:ROLE:MEADOW_READER';
  };
}
