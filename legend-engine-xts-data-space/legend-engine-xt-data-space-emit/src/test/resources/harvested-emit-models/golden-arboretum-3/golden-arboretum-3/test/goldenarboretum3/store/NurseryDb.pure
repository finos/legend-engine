###Relational
Database test::goldenarboretum3::store::NurseryDb
(
  include test::goldenarboretum3::store::NurseryReferenceDb

  Schema nursery
  (
    Table propagation_lot
    (
      lot_code VARCHAR(24) PRIMARY KEY,
      lot_label VARCHAR(120) NOT NULL,
      bed_code VARCHAR(24),
      species_code VARCHAR(24),
      substrate_code VARCHAR(24),
      stage_code VARCHAR(24),
      vigour_code VARCHAR(8),
      health_flag INTEGER,
      sown_count INTEGER,
      struck_count INTEGER,
      potted_on DATE,
      keeper_note VARCHAR(200)
    )
    Table nursery_bed
    (
      bed_code VARCHAR(24) PRIMARY KEY,
      bed_name VARCHAR(120) NOT NULL,
      zone_code VARCHAR(24),
      bench_metres INTEGER,
      shaded_flag INTEGER
    )
    Table stock_plant
    (
      stock_code VARCHAR(24) PRIMARY KEY,
      lot_code VARCHAR(24),
      stock_label VARCHAR(120) NOT NULL,
      girth_millimetres INTEGER,
      cuttings_taken INTEGER
    )
    Table treatment_log
    (
      treatment_ref VARCHAR(24) PRIMARY KEY,
      lot_code VARCHAR(24),
      treatment_name VARCHAR(120) NOT NULL,
      applied_on DATE,
      dose_millilitres INTEGER
    )
  )

  Join Lot_Bed(nursery.propagation_lot.bed_code = nursery.nursery_bed.bed_code)
  Join Lot_Species(nursery.propagation_lot.species_code = [test::goldenarboretum3::store::NurseryReferenceDb]reference.species_ref.species_code)
  Join Lot_Substrate(nursery.propagation_lot.substrate_code = [test::goldenarboretum3::store::NurseryReferenceDb]reference.substrate_ref.substrate_code)
  Join Bed_Zone(nursery.nursery_bed.zone_code = [test::goldenarboretum3::store::NurseryReferenceDb]reference.zone_ref.zone_code)
  Join Stock_Lot(nursery.stock_plant.lot_code = nursery.propagation_lot.lot_code)
  Join Treatment_Lot(nursery.treatment_log.lot_code = nursery.propagation_lot.lot_code)
)
