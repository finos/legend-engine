###Service
Service test::goldenarboretum3::service::SpeciesCatalogue
{
  pattern: '/nursery/v1/species/{familyName}';
  title: 'Species Catalogue By Family';
  documentation: 'Publishes the curated species catalogue for one family from the reference store on its own mapping and runtime, so the reference tier is executable independently of the nursery register.';
  autoActivateUpdates: true;
  ownership: DID { identifier: '000000' };
  execution: Single
  {
    query: {familyName: String[1]|test::goldenarboretum3::domain::SpeciesReference.all()->filter(
      s|$s.familyName == $familyName
    )->project(
      [
        s|$s.speciesCode,
        s|$s.speciesName,
        s|$s.familyName,
        s|$s.nativeRange
      ],
      [
        'species/code',
        'species/name',
        'species/family',
        'species/range'
      ]
    )->sort(
      [
        asc('species/code')
      ]
    )};
    mapping: test::goldenarboretum3::mapping::NurseryReferenceMapping;
    runtime: test::goldenarboretum3::runtime::NurseryReferenceRuntime;
  }
  testSuites:
  [
    catalogueSuite:
    {
      data:
      [
        connections:
        [
          nurseryReferenceConnection:
            Relational
            #{
              reference.species_ref:
                'species_code,species_name,family_name,native_range\n'+
                'SP-OAK,Sessile oak,Fagaceae,western uplands\n'+
                'SP-BEECH,Common beech,fagaceae,lowland scarp\n'+
                'SP-HAZEL,Common hazel,Betulaceae,mixed woodland\n';
            }#
        ]
      ]
      tests:
      [
        oneFamilyFoldedFromMixedCase:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            familyName = 'FAGACEAE'
          ]
          asserts:
          [
            bothFagaceaeSpellings:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"species/code":"SP-BEECH","species/name":"Common beech","species/family":"FAGACEAE","species/range":"lowland scarp"},{"species/code":"SP-OAK","species/name":"Sessile oak","species/family":"FAGACEAE","species/range":"western uplands"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
