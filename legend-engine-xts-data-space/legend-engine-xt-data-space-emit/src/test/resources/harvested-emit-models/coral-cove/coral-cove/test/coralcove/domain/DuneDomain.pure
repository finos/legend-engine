###Pure
import test::coralcove::domain::*;

Class <<temporal.processingtemporal>> {meta::pure::profiles::doc.doc = 'A dune stabilisation plot as registered at a processing instant, with the survey measurements captured for that version of the plot.'} test::coralcove::domain::PlotRegistration
{
  plotCode: String[1];
  sectorCode: String[1];
  plotName: String[0..1];
  crestHeightM: Float[0..1];
  stabilisedAreaHa: Decimal[0..1];
  surveyedOn: StrictDate[0..1];
  lastCheckedAt: DateTime[0..1];
  warden: String[0..1];
}

Class <<temporal.processingtemporal>> {meta::pure::profiles::doc.doc = 'A marram planting batch worked into a dune plot, versioned by the processing window in which its counts were current.'} test::coralcove::domain::PlantingBatch
{
  batchId: Integer[1];
  plotCode: String[1];
  speciesCode: String[1];
  culmCount: Integer[0..1];
  survivalRate: Float[0..1];
  meanCulmHeightCm: Decimal[0..1];
  plantedOn: StrictDate[0..1];
  recordedAt: DateTime[0..1];
}

Class <<temporal.processingtemporal>> {meta::pure::profiles::doc.doc = 'A drift fence run installed across a dune sector, versioned by the processing window in which its measured length was current.'} test::coralcove::domain::FenceRun
{
  fenceCode: String[1];
  sectorCode: String[1];
  fenceMaterial: String[0..1];
  fenceLengthM: Decimal[0..1];
  driftCaptureRatio: Float[0..1];
  installedOn: StrictDate[0..1];
  inspectedAt: DateTime[0..1];
}
