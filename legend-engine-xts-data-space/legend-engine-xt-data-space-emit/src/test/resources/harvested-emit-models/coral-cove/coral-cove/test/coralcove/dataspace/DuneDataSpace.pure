###DataSpace
DataSpace test::coralcove::dataspace::DuneDataSpace
{
  executionContexts:
  [
    {
      name: 'restoration';
      description: 'Restoration environment - the milestoned dune register bound through the warehouse runtime.';
      mapping: test::coralcove::mapping::DuneMapping;
      defaultRuntime: test::coralcove::runtime::DuneRuntime;
    }
  ];
  defaultExecutionContext: 'restoration';
  title: 'Coastal Dune Restoration Register';
  description: 'Discovery surface over the coastal dune restoration programme: the versioned plot register, the marram planting batches worked into those plots and the drift fence runs protecting each sector, all readable at a chosen processing instant.';
  elements:
  [
    test::coralcove::domain::FenceRun,
    test::coralcove::domain::PlantingBatch,
    test::coralcove::domain::PlotRegistration
  ];
  executables:
  [
    {
      id: 1;
      title: 'Plot register as of a processing instant';
      description: 'The featured endpoint that resolves the rostered dune plots above the crest-height threshold at a requested instant.';
      executable: test::coralcove::service::PlotRegisterAsOf;
    },
    {
      id: 2;
      title: 'Planting batches as of a processing instant';
      description: 'The endpoint that resolves the recognised marram batches above the minimum culm count at a requested instant.';
      executable: test::coralcove::service::PlantingBatchAsOf;
    },
    {
      id: 3;
      title: 'Fence runs as of a processing instant';
      description: 'The endpoint that resolves the approved drift fence runs on rostered sectors at a requested instant.';
      executable: test::coralcove::service::FenceRunAsOf;
    }
  ];
  supportInfo: Email
  {
    address: 'dune-restoration-desk@dunerestoration.invalid';
    documentationUrl: 'https://dunerestoration.invalid/docs/plot-register';
  };
}
