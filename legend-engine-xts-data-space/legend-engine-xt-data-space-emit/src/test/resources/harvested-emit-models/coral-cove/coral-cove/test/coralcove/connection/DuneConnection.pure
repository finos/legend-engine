###Connection
RelationalDatabaseConnection test::coralcove::connection::DuneWarehouseConnection
{
  store: test::coralcove::store::DuneDb;
  type: Snowflake;
  quoteIdentifiers: false;
  specification: Snowflake
  {
    name: 'EXAMPLE_DUNE_RESTORATION_DB';
    account: 'example_dune_account';
    warehouse: 'EXAMPLE_DUNE_WH';
    region: 'eu-west-2';
    cloudType: 'aws';
    role: 'EXAMPLE_DUNE_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'EXAMPLE_DUNE_USER';
    privateKeyVaultReference: 'example-dune-private-key';
    passPhraseVaultReference: 'example-dune-passphrase';
  };
}
