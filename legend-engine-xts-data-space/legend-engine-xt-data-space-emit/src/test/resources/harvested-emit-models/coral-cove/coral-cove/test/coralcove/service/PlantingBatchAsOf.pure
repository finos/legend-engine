###Service
Service test::coralcove::service::PlantingBatchAsOf
{
  pattern: '/dune/v1/planting-batches/{asOfDate}';
  title: 'Dune Restoration - Planting Batches As Of';
  documentation: 'Resolves the marram planting batches at a requested processing instant and projects the counts and survival measurements for the recognised species that clear the minimum culm count.';
  autoActivateUpdates: false;
  ownership: UserList { users: ['dune-restoration-register'] };
  execution: Single
  {
    // Plan: the same date parameter enters a second milestoned accessor, so this
    // read resolves its own window predicate over the planting table's in/out
    // columns; a six-element species membership test and a culm-count comparison
    // then compose with that predicate, and the projection pins seven columns
    // spanning an integer key, strings, an integer measure, a float rate, a
    // fixed-precision height and a date - four levels of expression above the
    // extent read, all pushed into one SQL select.
    query: {asOfDate: StrictDate[1]|test::coralcove::domain::PlantingBatch.all($asOfDate)->filter(
      b|($b.speciesCode->in(['AMMO-ARE', 'ELYM-FAR', 'LEYM-MOL', 'CARE-ARE', 'FEST-RUB', 'HONC-PEP'])) &&
        ($b.culmCount->toOne() >= 2000)
    )->project(
      [
        b|$b.batchId,
        b|$b.plotCode,
        b|$b.speciesCode,
        b|$b.culmCount,
        b|$b.survivalRate,
        b|$b.meanCulmHeightCm,
        b|$b.plantedOn
      ],
      [
        'Batch/Id',
        'Batch/PlotCode',
        'Batch/Species',
        'Batch/CulmCount',
        'Batch/SurvivalRate',
        'Batch/MeanCulmHeightCm',
        'Batch/PlantedOn'
      ]
    )->sort([asc('Batch/Id')])};
    mapping: test::coralcove::mapping::DuneMapping;
    runtime: test::coralcove::runtime::DuneRuntime;
  }
  testSuites:
  [
    plantingBatchAsOfSuite:
    {
      data:
      [
        connections:
        [
          duneWarehouseConnection:
            Relational
            #{
              dune.planting_batch:
                'batch_id,in_z,plot_code,species_code,culm_count,survival_rate,mean_culm_height_cm,planted_on,recorded_at,out_z\n'+
                '1,2025-03-01,CC-PL-01,AMMO-ARE,4200,0.62,31.50,2025-02-25,2025-02-25 09:00:00,2026-03-01\n'+
                '1,2026-03-01,CC-PL-01,AMMO-ARE,4400,0.71,38.25,2026-02-24,2026-02-24 09:10:00,9999-12-31\n'+
                '2,2026-03-01,CC-PL-02,ELYM-FAR,1850,0.55,22.75,2026-02-26,2026-02-26 09:20:00,9999-12-31\n'+
                '3,2026-03-01,CC-PL-03,SPAR-ANG,5200,0.68,41.00,2026-02-27,2026-02-27 09:30:00,9999-12-31\n';
            }#
        ]
      ]
      tests:
      [
        batchesAtProcessingInstant:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            asOfDate = %2026-05-01
          ]
          asserts:
          [
            onlyOpenRecognisedBatchAboveCountSurfaces:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Batch/Id":1,"Batch/PlotCode":"CC-PL-01","Batch/Species":"AMMO-ARE","Batch/CulmCount":4400,"Batch/SurvivalRate":0.71,"Batch/MeanCulmHeightCm":38.25,"Batch/PlantedOn":"2026-02-24"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
