###Service
Service demo::tealglacier3::service::DistrictRegisterService
{
  pattern: '/tealglacier3/v1/district-register';
  title: 'Teal Glacier 3 - District Register';
  ownership: UserList { users: ['alpine-trail-register-desk'] };
  documentation: 'Publishes the district references the footbridges quote together with the names the register carries for them, read from the same store relation the bridge register reaches across its join so the relation is planned once as a join target and once as an extent in its own right.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: {|demo::tealglacier3::domain::TrailDistrict.all()->project(
      [
        d|$d.districtCode,
        d|$d.districtName
      ],
      [
        'District',
        'DistrictName'
      ]
    )};
    mapping: demo::tealglacier3::mapping::TrailMapping;
    runtime: demo::tealglacier3::runtime::TrailRegisterRuntime;
  }

  testSuites:
  [
    districtRegisterSuite:
    {
      data:
      [
        connections:
        [
          trailRegister:
            Relational
            #{
              alpine.district:
                'district_code,district_name\n'+
                'DT-01,North Cirque\n';
            }#
        ]
      ]
      tests:
      [
        districtRowFromTheRegister:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            districtRow:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"District":"DT-01","DistrictName":"North Cirque"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
