###Pure
Class {meta::pure::profiles::doc.doc = 'A footbridge on the alpine trail network, carrying the reference the inspection register keys on, the district it is walked out of, the span the load rating was assessed over, the date it was last inspected and whether that assessment left it rated to carry a load.'} demo::tealglacier3::domain::TrailBridge
{
  bridgeId: Integer[1];
  bridgeCode: String[1];
  districtCode: String[1];
  districtName: String[0..1];
  spanM: Integer[1];
  inspectedOn: StrictDate[1];
  loadRated: Boolean[1];
  spanLabel() {$this.bridgeCode->trim()->toUpper() + '/' + $this.spanM->toString()->lpad(3, '0') + 'M'}: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A district the trail network is walked out of, holding the reference the bridges quote and the name the register publishes in their place.'} demo::tealglacier3::domain::TrailDistrict
{
  districtCode: String[1];
  districtName: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A volunteer inspection party the district rosters against a walk-out; it is published in the catalogued entry point and drawn in the register layout so a consumer reads how a bridge inspection is staffed, and it carries no store binding of its own because the roster is kept off the register.'} demo::tealglacier3::domain::InspectionParty
{
  partyCode: String[1];
  districtCode: String[1];
  walkOutSize: Integer[1];
}
