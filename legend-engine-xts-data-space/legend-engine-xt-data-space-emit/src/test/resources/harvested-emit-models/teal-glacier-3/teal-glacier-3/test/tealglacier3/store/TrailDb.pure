###Relational
Database demo::tealglacier3::store::TrailDb
(
  Schema alpine
  (
    Table trail_bridge
    (
      bridge_id INTEGER PRIMARY KEY,
      bridge_code VARCHAR(20) NOT NULL,
      district_code VARCHAR(20) NOT NULL,
      span_m INTEGER NOT NULL,
      inspected_on DATE NOT NULL,
      load_rated BIT NOT NULL
    )
    Table district
    (
      district_code VARCHAR(20) PRIMARY KEY,
      district_name VARCHAR(60) NOT NULL
    )
  )

  Join Bridge_District(alpine.trail_bridge.district_code = alpine.district.district_code)
)
