###Connection
RelationalDatabaseConnection demo::tealglacier3::connection::TrailRegisterConnection
{
  store: demo::tealglacier3::store::TrailDb;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists alpine cascade;',
      'create schema alpine;',
      'create table alpine.district (district_code varchar(20) primary key, district_name varchar(60) not null);',
      'create table alpine.trail_bridge (bridge_id integer primary key, bridge_code varchar(20) not null, district_code varchar(20) not null, span_m integer not null, inspected_on date not null, load_rated boolean not null);'
      ];
  };
  auth: DefaultH2;
}
