###Pure
import test::jadeisle2::domain::*;

Class {meta::pure::profiles::doc.doc = 'A walked section of the isle trail network.'} test::jadeisle2::domain::TrailSegment
{
  segmentCode: String[1];
  segmentName: String[1];
  lengthM: Integer[1];
  habitatName: String[0..1];
}

Class {meta::pure::profiles::doc.doc = 'A protected habitat zone the trail segments run through.'} test::jadeisle2::domain::HabitatZone
{
  habitatCode: String[1];
  habitatName: String[1];
  protectionLevel: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A counted tally of walkers recorded on a trail segment.'} test::jadeisle2::domain::VisitorCount
{
  countCode: String[1];
  visitors: Integer[1];
}

Class <<temporal.processingtemporal>> {meta::pure::profiles::doc.doc = 'A warden patrol of a trail segment, corrected in place over processing time.'} test::jadeisle2::domain::TrailPatrol
{
  patrolCode: String[1];
  segmentCode: String[1];
  wardenName: String[1];
  patrolGrade: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A rostered warden shift carried out under a patrol.'} test::jadeisle2::domain::WardenShift
{
  shiftCode: String[1];
  shiftName: String[1];
  crewSize: Integer[1];
  noteText: String[0..1];
}

Association test::jadeisle2::domain::Segment_Habitat
{
  habitatSegments: TrailSegment[*];
  habitat: HabitatZone[0..1];
}

Association test::jadeisle2::domain::Segment_Visits
{
  visits: VisitorCount[*];
  visitSegment: TrailSegment[0..1];
}

Association test::jadeisle2::domain::Patrol_Shift
{
  shifts: WardenShift[*];
  patrol: TrailPatrol[0..1];
}
