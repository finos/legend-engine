###Connection
RelationalDatabaseConnection test::jadeisle2::connection::IsleCoreConnection
{
  store: test::jadeisle2::store::IsleCoreDb;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'EXAMPLE_JADE_ISLE_CORE_DB';
    account: 'example_jade_isle_account';
    warehouse: 'EXAMPLE_JADE_ISLE_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    role: 'EXAMPLE_JADE_ISLE_ROLE';
  };
  auth: OAuth
  {
    scopeName: 'session:role:EXAMPLE_JADE_ISLE_ROLE';
    oauthKey: 'exampleJadeIsleOauthKey';
  };
}

