###Relational
Database test::jadeisle2::store::IsleVisitDb
(
  Schema patrol
  (
    Table trail_patrol
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )

      patrol_code VARCHAR(12) PRIMARY KEY,
      segment_code VARCHAR(12),
      warden_name VARCHAR(80),
      patrol_grade VARCHAR(20),
      in_z DATE NOT NULL,
      out_z DATE NOT NULL
    )
    Table warden_shift
    (
      shift_code VARCHAR(12) PRIMARY KEY,
      patrol_code VARCHAR(12),
      shift_name VARCHAR(80),
      crew_size INTEGER
    )
  )

  Schema roster
  (
    Table shift_note
    (
      shift_code VARCHAR(12) PRIMARY KEY,
      note_text VARCHAR(160)
    )
  )

  Join Patrol_Shift_J(patrol.trail_patrol.patrol_code = patrol.warden_shift.patrol_code)
  Join Shift_Note_J(patrol.warden_shift.shift_code = roster.shift_note.shift_code)
)
