###Relational
Database test::jadeisle2::store::IsleCoreDb
(
  Schema trail
  (
    Table trail_segment
    (
      segment_code VARCHAR(12) PRIMARY KEY,
      habitat_code VARCHAR(12),
      segment_name VARCHAR(80),
      length_m INTEGER
    )
    Table visitor_count
    (
      count_code VARCHAR(12) PRIMARY KEY,
      segment_code VARCHAR(12),
      visitors INTEGER
    )
  )

  Schema habitat
  (
    Table habitat_zone
    (
      habitat_code VARCHAR(12) PRIMARY KEY,
      habitat_name VARCHAR(80),
      protection_level VARCHAR(20)
    )
  )

  Join Segment_Habitat_J(trail.trail_segment.habitat_code = habitat.habitat_zone.habitat_code)
  Join Segment_Visit_J(trail.trail_segment.segment_code = trail.visitor_count.segment_code)
)
