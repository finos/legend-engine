###Service
Service test::jadeisle2::service::SegmentBoard
{
  pattern: '/jadeisle/v1/segment-board';
  title: 'Isle Trail Segment Board';
  owners:
  [
    'example-jade-isle-reserve-office'
  ];
  documentation: 'Trail segments named by the caller, with the habitat reached across the schema boundary and a display label.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {segmentCodes: String[*]|test::jadeisle2::domain::TrailSegment.all()->filter(
      s|$s.segmentCode->in($segmentCodes)
    )->project(
      [
        s|$s.segmentCode,
        s|$s.segmentName,
        s|$s.lengthM,
        s|$s.habitatName,
        s|$s.segmentCode + ' | ' + $s.segmentName
      ],
      [
        'Segment',
        'Name',
        'Length',
        'Habitat',
        'Label'
      ]
    )->sort([asc('Segment')])};
    mapping: test::jadeisle2::mapping::IsleCoreMapping;
    runtime: test::jadeisle2::runtime::IsleCoreRuntime;
  }
  testSuites:
  [
    segmentBoardSuite:
    {
      data:
      [
        connections:
        [
          connection_1:
            Relational
            #{
              trail.trail_segment:
                'segment_code,habitat_code,segment_name,length_m\n'+
                'SEG-1,HAB-1,Kelp Shore Path,1200\n'+
                'SEG-2,HAB-2,Fern Hollow Loop,900\n'+
                'SEG-3,HAB-2,Drift Line Spur,400\n';
              habitat.habitat_zone:
                'habitat_code,habitat_name,protection_level\n'+
                'HAB-1,Rocky Foreshore,strict\n'+
                'HAB-2,Coastal Fernland,managed\n';
            }#
        ]
      ]
      tests:
      [
        namedSegments:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            segmentCodes = ['SEG-1', 'SEG-2']
          ]
          asserts:
          [
            namedSegmentRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Segment":"SEG-1","Name":"Kelp Shore Path","Length":1200,"Habitat":"Rocky Foreshore","Label":"SEG-1 | Kelp Shore Path"},{"Segment":"SEG-2","Name":"Fern Hollow Loop","Length":900,"Habitat":"Coastal Fernland","Label":"SEG-2 | Fern Hollow Loop"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
