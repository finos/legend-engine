###Service
Service test::cedarhatchery2::service::GradeScaleRoster
{
  pattern: '/cedarhatchery/v1/grade-scale-roster';
  title: 'Cedar Hatchery - Grade Scale Roster';
  documentation: 'Projects the health grade scale, the lookup extent that the association-implemented grade hop of the health board resolves onto.';
  autoActivateUpdates: false;
  ownership: DID { identifier: '000000' };
  execution: Single
  {
    query: {|test::cedarhatchery2::domain::GradeScale.all()->project(
      [
        g|$g.gradeCode,
        g|$g.gradeLabel,
        g|$g.severityRank
      ],
      [
        'Grade Code',
        'Grade Label',
        'Severity'
      ]
    )->distinct()->sort(
      [
        asc('Grade Code')
      ]
    )->limit(10)};
    mapping: test::cedarhatchery2::mapping::HatcheryHealthMapping;
    runtime: test::cedarhatchery2::runtime::HatcheryHealthRuntime;
  }
  testSuites:
  [
    gradeScaleRosterSuite:
    {
      data:
      [
        connections:
        [
          connection_1:
            Relational
            #{
              health.grade_scale:
                'grade_code,grade_label,severity_rank\n'+
                'GR-A,Prime,1\n'+
                'GR-B,Sound,2\n'+
                'GR-C,Watch,3\n'+
                'GR-D,Unranked,\n';
            }#
        ]
      ]
      tests:
      [
        everyGradeIncludingOneWithoutARank:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            fourGrades:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Grade Code":"GR-A","Grade Label":"Prime","Severity":1},{"Grade Code":"GR-B","Grade Label":"Sound","Severity":2},{"Grade Code":"GR-C","Grade Label":"Watch","Severity":3},{"Grade Code":"GR-D","Grade Label":"Unranked","Severity":null}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
