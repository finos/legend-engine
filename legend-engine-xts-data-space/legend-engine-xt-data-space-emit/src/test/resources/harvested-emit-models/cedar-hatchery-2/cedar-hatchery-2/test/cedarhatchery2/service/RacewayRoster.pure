###Service
Service test::cedarhatchery2::service::RacewayRoster
{
  pattern: '/cedarhatchery/v1/raceway-roster';
  title: 'Cedar Hatchery - Raceway Roster';
  documentation: 'Projects the raceway channels of the hatchery site from the same store as the lot board but through the rearing-tier runtime, with no processing instant involved because the raceway relation is not milestoned.';
  autoActivateUpdates: false;
  ownership: DID { identifier: '000000' };
  execution: Single
  {
    query: {|test::cedarhatchery2::domain::Raceway.all()->project(
      [
        r|$r.racewayCode,
        r|$r.racewayName,
        r|$r.waterSource
      ],
      [
        'Raceway Code',
        'Raceway Name',
        'Water Source'
      ]
    )->distinct()->sort(
      [
        asc('Raceway Code')
      ]
    )->limit(10)};
    mapping: test::cedarhatchery2::mapping::HatcheryCoreMapping;
    runtime: test::cedarhatchery2::runtime::HatcheryCoreRearingRuntime;
  }
  testSuites:
  [
    racewayRosterSuite:
    {
      data:
      [
        connections:
        [
          connection_1:
            Relational
            #{
              hatchery.raceway:
                'raceway_code,raceway_name,water_source\n'+
                'RW-01,North Raceway,SPRING\n'+
                'RW-02,South Raceway,WELL\n'+
                'RW-03,Hatch House Trough,\n';
            }#
        ]
      ]
      tests:
      [
        everyChannelIncludingOneWithoutAWaterSource:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            threeChannels:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Raceway Code":"RW-01","Raceway Name":"North Raceway","Water Source":"SPRING"},{"Raceway Code":"RW-02","Raceway Name":"South Raceway","Water Source":"WELL"},{"Raceway Code":"RW-03","Raceway Name":"Hatch House Trough","Water Source":null}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
