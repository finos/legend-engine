###Connection
RelationalDatabaseConnection test::cedarhatchery2::connection::HatcheryCoreWarehouseConnection
{
  store: test::cedarhatchery2::store::HatcheryCoreDb;
  type: Snowflake;
  timezone: 'UTC';
  specification: Snowflake
  {
    name: 'CEDAR_HATCHERY_CORE_DB';
    account: 'cedar_hatchery_account';
    warehouse: 'CEDAR_HATCHERY_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    accountType: MultiTenant;
    organization: 'cedar_hatchery_org';
    role: 'CEDAR_HATCHERY_CORE_READER';
  };
  auth: OAuth
  {
    oauthKey: 'cedarHatcheryCoreOauthKey';
    scopeName: 'session:role:CEDAR_HATCHERY_CORE_READER';
  };
}

