###Relational
Database test::cedarhatchery2::store::HatcheryCoreDb
(
  Schema hatchery
  (
    Table stock_lot
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )
      lot_id VARCHAR(16) PRIMARY KEY,
      lot_code VARCHAR(24) NOT NULL,
      species_code VARCHAR(8),
      raceway_code VARCHAR(8),
      feed_code VARCHAR(8),
      fish_count INTEGER,
      mean_length_mm DOUBLE,
      in_z DATE PRIMARY KEY,
      out_z DATE
    )
    Table species
    (
      species_code VARCHAR(8) PRIMARY KEY,
      species_name VARCHAR(60) NOT NULL,
      family_name VARCHAR(60)
    )
    Table raceway
    (
      raceway_code VARCHAR(8) PRIMARY KEY,
      raceway_name VARCHAR(60) NOT NULL,
      water_source VARCHAR(16)
    )
    Table feed_plan
    (
      feed_code VARCHAR(8) PRIMARY KEY,
      feed_name VARCHAR(60) NOT NULL,
      pellet_size_mm DOUBLE
    )
  )

  Join StockLot_Species(hatchery.stock_lot.species_code = hatchery.species.species_code)

  Join StockLot_Raceway(hatchery.stock_lot.raceway_code = hatchery.raceway.raceway_code)

  Join StockLot_FeedPlan(hatchery.stock_lot.feed_code = hatchery.feed_plan.feed_code)
)
