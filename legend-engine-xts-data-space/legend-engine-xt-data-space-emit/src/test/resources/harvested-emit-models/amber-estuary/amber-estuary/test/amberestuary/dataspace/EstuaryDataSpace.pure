###DataSpace
DataSpace test::amberestuary::dataspace::EstuaryDataSpace
{
  executionContexts:
  [
    {
      name: 'survey';
      description: 'Survey tier binding the tide-flat store to the estuary mapping and the warehouse-backed runtime that serves the zone endpoint.';
      mapping: test::amberestuary::mapping::EstuaryMapping;
      defaultRuntime: test::amberestuary::runtime::EstuaryRuntime;
    }
  ];
  defaultExecutionContext: 'survey';
  title: 'Amber Estuary Sediment Survey';
  description: 'Entry point over the estuary sediment survey: gauge stations and the silt readings recorded against them, projected as banded tabular results.';
  elements:
  [
    test::amberestuary::domain
  ];
  executables:
  [
    {
      id: 1;
      title: 'Readings by tidal zone';
      description: 'The featured endpoint that bands the silt load recorded in one tidal zone.';
      executable: test::amberestuary::service::ReadingsByZoneService;
    }
  ];
}
