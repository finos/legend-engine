###Connection
RelationalDatabaseConnection test::emeraldhatchery3::connection::HatcheryH2Connection
{
  store: test::emeraldhatchery3::store::HatcheryDb;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists rearing;',
      'create schema rearing;',
      'create table rearing.pond (pond_id integer primary key, pond_code varchar(24) not null, water_source varchar(24) not null, capacity_litres integer not null, grade_band varchar(16) not null, decommissioned_on date);',
      'create table rearing.rearing_batch (batch_id integer primary key, batch_code varchar(24) not null, pond_code varchar(24) not null, species_group varchar(32) not null, fry_count integer not null, stocked_on date not null, released_on date);'
      ];
  };
  auth: DefaultH2;
}
