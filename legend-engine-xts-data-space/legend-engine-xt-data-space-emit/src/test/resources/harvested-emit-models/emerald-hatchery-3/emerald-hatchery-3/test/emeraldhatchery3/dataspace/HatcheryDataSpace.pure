###DataSpace
DataSpace test::emeraldhatchery3::dataspace::HatcheryDataSpace
{
  executionContexts:
  [
    {
      name: 'rearing';
      description: 'Live rearing environment - ponds and cohorts served through the on-site rearing warehouse.';
      mapping: test::emeraldhatchery3::mapping::HatcheryMapping;
      defaultRuntime: test::emeraldhatchery3::runtime::HatcheryRuntime;
    },
    {
      name: 'archive';
      description: 'Retired-pond archive environment - decommissioned ponds served through the archive warehouse.';
      mapping: test::emeraldhatchery3::mapping::PondArchiveMapping;
      defaultRuntime: test::emeraldhatchery3::runtime::PondArchiveRuntime;
    }
  ];
  defaultExecutionContext: 'rearing';
  title: 'Emerald Hatchery Rearing Product';
  description: 'Discovery surface over a freshwater hatchery: the ponds in service, the cohorts stocked into them and the archive of retired ponds.';
  elements:
  [
    test::emeraldhatchery3::domain::ArchivedPond,
    test::emeraldhatchery3::domain::RearingBatch,
    test::emeraldhatchery3::domain::RearingPond
  ];
  supportInfo: Email
  {
    address: 'rearing-desk@emeraldhatchery.invalid';
  };
}
