###Runtime
Runtime test::emeraldhatchery3::runtime::HatcheryRuntime
{
  mappings:
  [
    test::emeraldhatchery3::mapping::HatcheryMapping
  ];
  connections:
  [
    test::emeraldhatchery3::store::HatcheryDb:
    [
      hatcheryConnection: test::emeraldhatchery3::connection::HatcheryH2Connection
    ]
  ];
}

Runtime test::emeraldhatchery3::runtime::PondArchiveRuntime
{
  mappings:
  [
    test::emeraldhatchery3::mapping::PondArchiveMapping
  ];
  connections:
  [
    test::emeraldhatchery3::store::PondArchiveDb:
    [
      archiveConnection: test::emeraldhatchery3::connection::PondArchiveH2Connection
    ]
  ];
}
