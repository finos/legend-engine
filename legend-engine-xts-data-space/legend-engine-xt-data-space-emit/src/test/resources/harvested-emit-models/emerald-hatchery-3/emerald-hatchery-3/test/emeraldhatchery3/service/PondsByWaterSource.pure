###Service
Service test::emeraldhatchery3::service::PondsByWaterSource
{
  pattern: '/hatchery/v1/ponds/active';
  title: 'Hatchery - Active Ponds by Water Source';
  documentation: 'Lists the ponds still in service for a supplied set of water sources, ignoring undersized holding ponds, ordered by pond code.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {waterSources: String[*]|test::emeraldhatchery3::domain::RearingPond.all()->filter(
      p|($p.decommissionedOn->isEmpty() && ($p.waterSource->in($waterSources))) && ($p.capacityLitres >= 1000)
    )->project(
      [
        p|$p.pondCode,
        p|$p.waterSource,
        p|$p.capacityLitres
      ],
      [
        'PondCode',
        'WaterSource',
        'CapacityLitres'
      ]
    )->sort([asc('PondCode')])};
    mapping: test::emeraldhatchery3::mapping::HatcheryMapping;
    runtime: test::emeraldhatchery3::runtime::HatcheryRuntime;
  }
  testSuites:
  [
    activePondSuite:
    {
      data:
      [
        connections:
        [
          hatcheryConnection:
            Relational
            #{
              rearing.pond:
                'pond_id,pond_code,water_source,capacity_litres,grade_band,decommissioned_on\n'+
                '1,P-101,spring,12000,grow-out,\n'+
                '2,P-102,river,8000,nursery,2024-03-01\n'+
                '3,P-103,well,15000,grow-out,\n'+
                '4,P-104,spring,900,nursery,\n';
            }#
        ]
      ]
      tests:
      [
        springAndWellPonds:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            waterSources = ['spring', 'well']
          ]
          asserts:
          [
            twoActivePonds:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"PondCode":"P-101","WaterSource":"spring","CapacityLitres":12000},{"PondCode":"P-103","WaterSource":"well","CapacityLitres":15000}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
