###Mapping
Mapping test::emeraldhatchery3::mapping::PondArchiveMapping
(
  *test::emeraldhatchery3::domain::ArchivedPond[archivedPond]: Relational
  {
    ~primaryKey
    (
      [test::emeraldhatchery3::store::PondArchiveDb]retired.pond_archive.archive_id
    )
    ~mainTable [test::emeraldhatchery3::store::PondArchiveDb]retired.pond_archive
    pondCode: [test::emeraldhatchery3::store::PondArchiveDb]retired.pond_archive.pond_code,
    waterSource: [test::emeraldhatchery3::store::PondArchiveDb]retired.pond_archive.water_source,
    gradeBand: [test::emeraldhatchery3::store::PondArchiveDb]retired.pond_archive.grade_band,
    retiredOn: [test::emeraldhatchery3::store::PondArchiveDb]retired.pond_archive.retired_on
  }
)
