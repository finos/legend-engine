###Relational
Database test::emeraldhatchery3::store::HatcheryDb
(
  Schema rearing
  (
    Table pond
    (
      pond_id INTEGER PRIMARY KEY,
      pond_code VARCHAR(24) NOT NULL,
      water_source VARCHAR(24) NOT NULL,
      capacity_litres INTEGER NOT NULL,
      grade_band VARCHAR(16) NOT NULL,
      decommissioned_on DATE
    )
    Table rearing_batch
    (
      batch_id INTEGER PRIMARY KEY,
      batch_code VARCHAR(24) NOT NULL,
      pond_code VARCHAR(24) NOT NULL,
      species_group VARCHAR(32) NOT NULL,
      fry_count INTEGER NOT NULL,
      stocked_on DATE NOT NULL,
      released_on DATE
    )
  )
)
