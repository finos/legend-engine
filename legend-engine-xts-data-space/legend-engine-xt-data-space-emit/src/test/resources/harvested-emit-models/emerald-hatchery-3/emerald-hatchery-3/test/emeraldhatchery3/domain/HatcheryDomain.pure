import meta::pure::profiles::*;

Class {doc.doc = 'A rearing pond on a freshwater hatchery site, holding a single water source and a nominal working volume.'} test::emeraldhatchery3::domain::RearingPond
{
  pondCode: String[1];
  waterSource: String[1];
  capacityLitres: Integer[1];
  gradeBand: String[1];
  decommissionedOn: StrictDate[0..1];
}

Class {doc.doc = 'A cohort of fry stocked into a rearing pond and grown out until release.'} test::emeraldhatchery3::domain::RearingBatch
{
  batchCode: String[1];
  pondCode: String[1];
  speciesGroup: String[1];
  fryCount: Integer[1];
  stockedOn: StrictDate[1];
  releasedOn: StrictDate[0..1];
}

Class {doc.doc = 'A retired rearing pond retained in the site archive after decommissioning.'} test::emeraldhatchery3::domain::ArchivedPond
{
  pondCode: String[1];
  waterSource: String[1];
  gradeBand: String[1];
  retiredOn: StrictDate[1];
}
