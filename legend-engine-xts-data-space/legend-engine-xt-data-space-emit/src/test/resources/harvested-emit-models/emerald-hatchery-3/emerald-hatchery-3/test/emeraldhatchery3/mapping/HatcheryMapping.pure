###Mapping
Mapping test::emeraldhatchery3::mapping::HatcheryMapping
(
  *test::emeraldhatchery3::domain::RearingPond[pond]: Relational
  {
    ~primaryKey
    (
      [test::emeraldhatchery3::store::HatcheryDb]rearing.pond.pond_id
    )
    ~mainTable [test::emeraldhatchery3::store::HatcheryDb]rearing.pond
    pondCode: [test::emeraldhatchery3::store::HatcheryDb]rearing.pond.pond_code,
    waterSource: [test::emeraldhatchery3::store::HatcheryDb]rearing.pond.water_source,
    capacityLitres: [test::emeraldhatchery3::store::HatcheryDb]rearing.pond.capacity_litres,
    gradeBand: [test::emeraldhatchery3::store::HatcheryDb]rearing.pond.grade_band,
    decommissionedOn: [test::emeraldhatchery3::store::HatcheryDb]rearing.pond.decommissioned_on
  }
  *test::emeraldhatchery3::domain::RearingBatch[batch]: Relational
  {
    ~primaryKey
    (
      [test::emeraldhatchery3::store::HatcheryDb]rearing.rearing_batch.batch_id
    )
    ~mainTable [test::emeraldhatchery3::store::HatcheryDb]rearing.rearing_batch
    batchCode: [test::emeraldhatchery3::store::HatcheryDb]rearing.rearing_batch.batch_code,
    pondCode: [test::emeraldhatchery3::store::HatcheryDb]rearing.rearing_batch.pond_code,
    speciesGroup: [test::emeraldhatchery3::store::HatcheryDb]rearing.rearing_batch.species_group,
    fryCount: [test::emeraldhatchery3::store::HatcheryDb]rearing.rearing_batch.fry_count,
    stockedOn: [test::emeraldhatchery3::store::HatcheryDb]rearing.rearing_batch.stocked_on,
    releasedOn: [test::emeraldhatchery3::store::HatcheryDb]rearing.rearing_batch.released_on
  }
)
