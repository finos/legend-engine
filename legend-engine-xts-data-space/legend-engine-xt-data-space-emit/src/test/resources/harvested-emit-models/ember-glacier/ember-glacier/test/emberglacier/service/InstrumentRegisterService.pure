###Service
Service test::emberglacier::service::InstrumentRegisterService
{
  pattern: '/emberglacier/v1/instrument-register';
  title: 'Ember Glacier - Instrument Register';
  ownership: UserList { users: ['skywatch-estate-desk'] };
  documentation: 'Every detector with the band it works in and the scale it samples at, reaching its telescope, that telescope enclosure and the site behind it, so the deepest projection column crosses three named joins.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: |test::emberglacier::domain::Instrument.all()->project(
      [
        i|$i.instrumentCode,
        i|$i.bandName,
        i|$i.pixelScale,
        i|$i.telescope.telescopeCode,
        i|$i.telescope.dome.domeCode,
        i|$i.telescope.dome.observatory.observatoryCode
      ],
      [
        'Instrument',
        'Band',
        'PixelScale',
        'Telescope',
        'Dome',
        'Observatory'
      ]
    )->sort([asc('Instrument')]);
    mapping: test::emberglacier::mapping::SkywatchMapping;
    runtime: test::emberglacier::runtime::SkywatchRuntime;
  }
  testSuites:
  [
    instrumentRegisterServiceSuite:
    {
      data:
      [
        connections:
        [
          skywatchConnection:
            Relational
            #{
              skywatch.observatory:
                'observatory_id,observatory_code,observatory_name,elevation_m,opened_on,public_nights\n'+
                '1,OB-01,Ridge Crest Observatory,1820,2001-04-12,true\n'+
                '2,OB-02,Lake Bluff Observatory,640,1994-09-30,false\n'+
                '3,OB-03,Pine Flat Observatory,310,2015-06-01,true\n';
              skywatch.dome:
                'dome_id,dome_code,observatory_id,aperture_m,shutter_kind\n'+
                '1,DM-01,1,6.5,CLAMSHELL\n'+
                '2,DM-02,1,4.0,UPDOWN\n'+
                '3,DM-03,2,3.2,ROLLOFF\n';
              skywatch.telescope:
                'telescope_id,telescope_code,dome_id,mirror_cm,mount_kind\n'+
                '1,TS-01,1,90,EQUATORIAL\n'+
                '2,TS-02,2,60,ALTAZ\n'+
                '3,TS-03,3,40,ALTAZ\n';
              skywatch.instrument:
                'instrument_id,instrument_code,telescope_id,band_name,pixel_scale\n'+
                '1,IS-01,1,BROADBAND,0.32\n'+
                '2,IS-02,1,NARROWBAND,0.28\n'+
                '3,IS-03,3,BROADBAND,0.55\n';
            }#
        ]
      ]
      tests:
      [
        everyDetectorDownToItsSite:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            threeDetectors:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Instrument":"IS-01","Band":"BROADBAND","PixelScale":0.32,"Telescope":"TS-01","Dome":"DM-01","Observatory":"OB-01"},{"Instrument":"IS-02","Band":"NARROWBAND","PixelScale":0.28,"Telescope":"TS-01","Dome":"DM-01","Observatory":"OB-01"},{"Instrument":"IS-03","Band":"BROADBAND","PixelScale":0.55,"Telescope":"TS-03","Dome":"DM-03","Observatory":"OB-02"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
