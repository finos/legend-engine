###Service
Service test::emberglacier::service::FaintTargetRegisterService
{
  pattern: '/emberglacier/v1/faint-target-register';
  title: 'Ember Glacier - Faint Target Register';
  ownership: UserList { users: ['skywatch-night-desk'] };
  documentation: 'Targets listed fainter than a floating-point threshold, so the comparison against a non-integral literal is part of the generated where clause.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: |test::emberglacier::domain::SkyTarget.all()->filter(
      t|$t.magnitude > 8.0
    )->project(
      [
        t|$t.targetCode,
        t|$t.magnitude
      ],
      [
        'Target',
        'Magnitude'
      ]
    )->sort([asc('Target')]);
    mapping: test::emberglacier::mapping::SkywatchMapping;
    runtime: test::emberglacier::runtime::SkywatchRuntime;
  }
  testSuites:
  [
    faintTargetRegisterServiceSuite:
    {
      data:
      [
        connections:
        [
          skywatchConnection:
            Relational
            #{
              skywatch.sky_target:
                'target_id,target_code,target_name,catalog_code,magnitude\n'+
                '1,TG-01,Kite Nebula,NGC,8.4\n'+
                '2,TG-02,Anvil Cluster,ngc,6.1\n'+
                '3,TG-03,Ribbon Galaxy,IC,11.2\n'+
                '4,TG-900,Drift Comet,NGC,9.0\n';
            }#
        ]
      ]
      tests:
      [
        onlyTheFaintTargets:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            threeFaintTargets:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Target":"TG-01","Magnitude":8.4},{"Target":"TG-03","Magnitude":11.2},{"Target":"TG-900","Magnitude":9.0}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
