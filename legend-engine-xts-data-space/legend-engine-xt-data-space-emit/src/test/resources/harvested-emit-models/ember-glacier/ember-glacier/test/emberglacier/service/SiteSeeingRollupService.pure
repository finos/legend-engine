###Service
Service test::emberglacier::service::SiteSeeingRollupService
{
  pattern: '/emberglacier/v1/site-seeing-rollup';
  title: 'Ember Glacier - Site Seeing Rollup';
  ownership: UserList { users: ['skywatch-night-desk'] };
  documentation: 'Cloud cover recorded and sky notes taken per site, grouped so the plan emits one aggregate row per site rather than one row per note.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: |test::emberglacier::domain::SeeingReading.all()->groupBy(
      [
        r|$r.siteCode
      ],
      [
        agg(r|$r.cloudCover, y|$y->sum()),
        agg(r|$r.readingCode, y|$y->count())
      ],
      [
        'Site',
        'CloudCover',
        'Readings'
      ]
    )->sort([asc('Site')]);
    mapping: test::emberglacier::mapping::SkywatchMapping;
    runtime: test::emberglacier::runtime::SkywatchRuntime;
  }
  testSuites:
  [
    siteSeeingRollupServiceSuite:
    {
      data:
      [
        connections:
        [
          skywatchConnection:
            Relational
            #{
              skywatch.seeing_reading:
                'reading_id,reading_code,session_id,site_code,seeing_arcsec,cloud_cover,recorded_at\n'+
                '1,SR-01,1,OB-01,1.1,5,2026-05-04 21:35:00\n'+
                '2,SR-02,2,OB-01,0.8,0,2026-05-06 22:20:00\n'+
                '3,SR-03,3,OB-03,2.4,40,2026-05-08 20:50:00\n'+
                '4,SR-04,5,OB-01,1.6,20,2026-05-12 21:10:00\n';
            }#
        ]
      ]
      tests:
      [
        cloudCoverPerSite:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            twoSites:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Site":"OB-01","CloudCover":25,"Readings":3},{"Site":"OB-03","CloudCover":40,"Readings":1}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
