  testSuites:
  [
    siteFlagSuite:
    {
      function: |test::emberglacier::domain::Observatory.all()->project(
  [
    o|$o.observatoryCode,
    o|$o.observatoryName,
    o|$o.elevationM,
    o|$o.openedOn,
    o|$o.publicNights
  ],
  [
    'Observatory',
    'Name',
    'Elevation',
    'OpenedOn',
    'PublicNights'
  ]
)->sort(
  [
    asc('Observatory')
  ]
);
      tests:
      [
        everyColumnTypeOfTheSiteTable:
        {
          doc: 'The site class mapping binds a string, an integer, a date and a boolean column off its own main table, so one projection proves every column type it declares.';
          data:
          [
            test::emberglacier::store::SkywatchDb:
              Relational
              #{
                skywatch.observatory:
                  'observatory_id,observatory_code,observatory_name,elevation_m,opened_on,public_nights\n'+
                  '1,OB-01,Ridge Crest Observatory,1820,2001-04-12,true\n'+
                  '2,OB-02,Lake Bluff Observatory,640,1994-09-30,false\n';
              }#
          ];
          asserts:
          [
            bothSitesWithTheirFlag:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Observatory":"OB-01","Name":"Ridge Crest Observatory","Elevation":1820,"OpenedOn":"2001-04-12","PublicNights":true},{"Observatory":"OB-02","Name":"Lake Bluff Observatory","Elevation":640,"OpenedOn":"1994-09-30","PublicNights":false}]';
                  }#;
              }#
          ];
        }
      ];
    },
    associationTraversalSuite:
    {
      function: |test::emberglacier::domain::Telescope.all()->project(
  [
    t|$t.telescopeCode,
    t|$t.dome.domeCode,
    t|$t.dome.observatory.observatoryCode
  ],
  [
    'Telescope',
    'Dome',
    'Observatory'
  ]
)->sort(
  [
    asc('Telescope')
  ]
);
      tests:
      [
        twoAssociationsResolvedThroughNamedJoins:
        {
          doc: 'The enclosure and site ends are reached through their association mappings, so the traversal becomes two named joins and a telescope pointing at an enclosure that is not there still reports itself, with both traversed columns empty.';
          data:
          [
            test::emberglacier::store::SkywatchDb:
              Relational
              #{
                skywatch.observatory:
                  'observatory_id,observatory_code,observatory_name,elevation_m,opened_on,public_nights\n'+
                  '1,OB-01,Ridge Crest Observatory,1820,2001-04-12,true\n';
                skywatch.dome:
                  'dome_id,dome_code,observatory_id,aperture_m,shutter_kind\n'+
                  '1,DM-01,1,6.5,CLAMSHELL\n';
                skywatch.telescope:
                  'telescope_id,telescope_code,dome_id,mirror_cm,mount_kind\n'+
                  '1,TS-01,1,90,EQUATORIAL\n'+
                  '2,TS-09,9,55,ALTAZ\n';
              }#
          ];
          asserts:
          [
            theResolvedTelescopeAndTheDanglingOne:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Telescope":"TS-01","Dome":"DM-01","Observatory":"OB-01"},{"Telescope":"TS-09","Dome":null,"Observatory":null}]';
                  }#;
              }#
          ];
        }
      ];
    },
    sessionAttributionSuite:
    {
      function: |test::emberglacier::domain::ObservingSession.all()->project(
  [
    s|$s.sessionCode,
    s|$s.observer.observerCode,
    s|$s.target.targetCode,
    s|$s.instrument.instrumentCode,
    s|$s.exposureS
  ],
  [
    'Session',
    'Observer',
    'Target',
    'Instrument',
    'ExposureS'
  ]
)->sort(
  [
    asc('Session')
  ]
);
      tests:
      [
        everyAttributionEndOfARun:
        {
          doc: 'A run reaches its observer, its target and its detector through three separate association mappings, and each end resolves on its own, so a run booked against an observer who is not on file still reports the two ends that do resolve.';
          data:
          [
            test::emberglacier::store::SkywatchDb:
              Relational
              #{
                skywatch.telescope:
                  'telescope_id,telescope_code,dome_id,mirror_cm,mount_kind\n'+
                  '1,TS-01,1,90,EQUATORIAL\n';
                skywatch.instrument:
                  'instrument_id,instrument_code,telescope_id,band_name,pixel_scale\n'+
                  '1,IS-01,1,BROADBAND,0.32\n';
                skywatch.observer:
                  'observer_id,observer_code,observer_name,cohort_code\n'+
                  '1,OV-01,Aster Vale,COHORT-N1\n';
                skywatch.sky_target:
                  'target_id,target_code,target_name,catalog_code,magnitude\n'+
                  '1,TG-01,Kite Nebula,NGC,8.4\n';
                skywatch.observing_session:
                  'session_id,session_code,telescope_id,observer_id,target_id,instrument_id,started_at,exposure_s,frames_kept,session_state,logged_on\n'+
                  '1,SS-01,1,1,1,1,2026-05-04 21:30:00,120,48,COMPLETE,2026-05-05\n'+
                  '2,SS-99,1,9,1,1,2026-05-06 21:30:00,150,50,COMPLETE,2026-05-07\n';
              }#
          ];
          asserts:
          [
            theFullyAttributedRunAndThePartlyAttributedOne:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Session":"SS-01","Observer":"OV-01","Target":"TG-01","Instrument":"IS-01","ExposureS":120},{"Session":"SS-99","Observer":null,"Target":"TG-01","Instrument":"IS-01","ExposureS":150}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
