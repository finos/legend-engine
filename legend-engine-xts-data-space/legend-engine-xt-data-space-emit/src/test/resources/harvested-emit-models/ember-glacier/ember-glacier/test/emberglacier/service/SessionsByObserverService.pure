###Service
Service test::emberglacier::service::SessionsByObserverService
{
  pattern: '/emberglacier/v1/sessions-by-observer';
  title: 'Ember Glacier - Sessions By Observer';
  ownership: UserList { users: ['skywatch-rota-desk'] };
  documentation: 'Runs taken by one named observer that were closed in a recorded state, reaching the observer across the association and reporting the day each run was logged.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: {observerCode: String[1]|test::emberglacier::domain::ObservingSession.all()->filter(
      s|($s.observer.observerCode == $observerCode) && ($s.sessionState->isNotEmpty())
    )->project(
      [
        s|$s.sessionCode,
        s|$s.sessionState->toOne(),
        s|$s.target.targetCode,
        s|$s.loggedOn
      ],
      [
        'Session',
        'State',
        'Target',
        'LoggedOn'
      ]
    )->sort([asc('Session')])};
    mapping: test::emberglacier::mapping::SkywatchMapping;
    runtime: test::emberglacier::runtime::SkywatchRuntime;
  }
  testSuites:
  [
    sessionsByObserverServiceSuite:
    {
      data:
      [
        connections:
        [
          skywatchConnection:
            Relational
            #{
              skywatch.telescope:
                'telescope_id,telescope_code,dome_id,mirror_cm,mount_kind\n'+
                '1,TS-01,1,90,EQUATORIAL\n'+
                '2,TS-02,2,60,ALTAZ\n'+
                '3,TS-03,3,40,ALTAZ\n';
              skywatch.instrument:
                'instrument_id,instrument_code,telescope_id,band_name,pixel_scale\n'+
                '1,IS-01,1,BROADBAND,0.32\n'+
                '2,IS-02,1,NARROWBAND,0.28\n'+
                '3,IS-03,3,BROADBAND,0.55\n';
              skywatch.observer:
                'observer_id,observer_code,observer_name,cohort_code\n'+
                '1,OV-01,Aster Vale,COHORT-N1\n'+
                '2,OV-02,Bramble Quint,COHORT-N2\n'+
                '3,OV-03,Cinder Rowe,\n';
              skywatch.sky_target:
                'target_id,target_code,target_name,catalog_code,magnitude\n'+
                '1,TG-01,Kite Nebula,NGC,8.4\n'+
                '2,TG-02,Anvil Cluster,ngc,6.1\n'+
                '3,TG-03,Ribbon Galaxy,IC,11.2\n'+
                '4,TG-900,Drift Comet,NGC,9.0\n';
              skywatch.observing_session:
                'session_id,session_code,telescope_id,observer_id,target_id,instrument_id,started_at,exposure_s,frames_kept,session_state,logged_on\n'+
                '1,SS-01,1,1,1,1,2026-05-04 21:30:00,120,48,COMPLETE,2026-05-05\n'+
                '2,SS-02,1,2,2,2,2026-05-06 22:15:00,240,96,COMPLETE,2026-05-07\n'+
                '3,SS-03,3,3,3,3,2026-05-08 20:45:00,60,12,COMPLETE,2026-05-09\n'+
                '4,SS-04,2,1,4,1,2026-05-10 23:05:00,180,45,COMPLETE,2026-05-11\n'+
                '5,SS-05,1,2,1,2,2026-05-12 21:00:00,300,162,ABANDONED,2026-05-13\n'+
                '6,SS-06,3,1,2,3,2026-05-14 19:50:00,90,18,,2026-05-15\n';
            }#
        ]
      ]
      tests:
      [
        theClosedRunsOfOneObserver:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            observerCode = 'OV-01'
          ]
          asserts:
          [
            twoClosedRuns:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Session":"SS-01","State":"COMPLETE","Target":"TG-01","LoggedOn":"2026-05-05"},{"Session":"SS-04","State":"COMPLETE","Target":"TG-900","LoggedOn":"2026-05-11"}]';
                  }#;
              }#
          ]
        },
        anObserverWithOneRun:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            observerCode = 'OV-03'
          ]
          asserts:
          [
            oneClosedRun:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Session":"SS-03","State":"COMPLETE","Target":"TG-03","LoggedOn":"2026-05-09"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
