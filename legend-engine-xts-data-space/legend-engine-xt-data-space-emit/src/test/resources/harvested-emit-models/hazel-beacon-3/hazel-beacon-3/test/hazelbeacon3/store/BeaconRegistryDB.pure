###Relational
Database test::hazelbeacon3::store::BeaconRegistryDB
(
  Schema registry
  (
    Table beacon_record
    (
      beacon_code VARCHAR(24) PRIMARY KEY,
      beacon_name VARCHAR(120) NOT NULL,
      station_code VARCHAR(24) NOT NULL,
      lamp_code VARCHAR(24),
      grade_code VARCHAR(8),
      commissioned_on DATE NOT NULL,
      focal_height_m INTEGER
    )
    Table station_record
    (
      station_code VARCHAR(24) PRIMARY KEY,
      station_name VARCHAR(120) NOT NULL,
      coast_sector VARCHAR(48) NOT NULL
    )
    Table lamp_record
    (
      lamp_code VARCHAR(24) PRIMARY KEY,
      lamp_type VARCHAR(48) NOT NULL,
      rated_hours INTEGER
    )
  )

  Schema survey
  (
    Table inspection_record
    (
      inspection_ref VARCHAR(24) PRIMARY KEY,
      beacon_code VARCHAR(24) NOT NULL,
      inspected_on DATE NOT NULL,
      inspector_code VARCHAR(24) NOT NULL,
      lens_score INTEGER,
      battery_pct INTEGER
    )
    Table defect_record
    (
      defect_ref VARCHAR(24) PRIMARY KEY,
      inspection_ref VARCHAR(24) NOT NULL,
      defect_code VARCHAR(24) NOT NULL,
      severity_code VARCHAR(8),
      raised_on DATE NOT NULL
    )
  )

  Join Beacon_Station(registry.beacon_record.station_code = registry.station_record.station_code)
  Join Beacon_Lamp(registry.beacon_record.lamp_code = registry.lamp_record.lamp_code)
  Join Inspection_Beacon(survey.inspection_record.beacon_code = registry.beacon_record.beacon_code)
  Join Defect_Inspection(survey.defect_record.inspection_ref = survey.inspection_record.inspection_ref)
)
