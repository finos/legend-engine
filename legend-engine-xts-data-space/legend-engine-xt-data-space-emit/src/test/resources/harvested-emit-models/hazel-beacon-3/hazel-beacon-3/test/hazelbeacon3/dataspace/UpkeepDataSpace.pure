###DataSpace
DataSpace test::hazelbeacon3::dataspace::UpkeepDataSpace
{
  executionContexts:
  [
    {
      name: 'upkeep';
      description: 'Upkeep environment - the order and part binding served through the depot warehouse.';
      mapping: test::hazelbeacon3::mapping::UpkeepMapping;
      defaultRuntime: test::hazelbeacon3::runtime::UpkeepRuntime;
    }
  ];
  defaultExecutionContext: 'upkeep';
  title: 'Beacon Upkeep Orders And Depot Parts';
  description: 'A governed entry point over the depot side of the coastal beacon programme - banded maintenance orders, the crews that work them and the parts drawn against them - kept separate from the register binding because it resolves against the depot store.';
  elements:
  [
    test::hazelbeacon3::domain::UpkeepOrder,
    test::hazelbeacon3::domain::PartUsage,
    test::hazelbeacon3::domain::UpkeepCrew
  ];
  diagrams:
  [
    {
      title: 'Order And Part Usage';
      diagram: test::hazelbeacon3::diagram::UpkeepDiagram;
    }
  ];
  executables:
  [
    {
      id: 1;
      title: 'Near-Term Upkeep Orders';
      description: 'The orders of the reporting month whose derived band is worked in the near term.';
      executable: test::hazelbeacon3::service::UpkeepOrderFeed;
    }
  ];
  supportInfo: Email
  {
    address: 'beacon-upkeep-desk@coastaltrust.invalid';
  };
}
