###Connection
RelationalDatabaseConnection test::hazelbeacon3::connection::UpkeepConnection
{
  store: test::hazelbeacon3::store::UpkeepDB;
  type: Snowflake;
  timezone: +0000;
  quoteIdentifiers: false;
  specification: Snowflake
  {
    name: 'BEACON_UPKEEP_DB';
    account: 'coastal_trust_account';
    warehouse: 'BEACON_UPKEEP_WH';
    region: 'eu-west-1';
    cloudType: 'aws';
    accountType: VPS;
    organization: 'coastal_trust_org';
    role: 'BEACON_UPKEEP_READER';
  };
  auth: OAuth
  {
    oauthKey: 'beacon_upkeep_oauth_key';
    scopeName: 'SESSION:ROLE:BEACON_UPKEEP_READER';
  };
}
