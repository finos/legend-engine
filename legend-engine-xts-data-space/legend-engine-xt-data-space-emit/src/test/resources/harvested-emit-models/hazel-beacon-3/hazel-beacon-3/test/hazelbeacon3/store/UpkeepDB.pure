###Relational
Database test::hazelbeacon3::store::UpkeepDB
(
  Schema work
  (
    Table work_order
    (
      order_ref VARCHAR(24) PRIMARY KEY,
      beacon_code VARCHAR(24) NOT NULL,
      crew_code VARCHAR(24) NOT NULL,
      priority_code VARCHAR(8),
      opened_on DATE NOT NULL,
      closed_on DATE
    )
    Table part_usage
    (
      usage_ref VARCHAR(24) PRIMARY KEY,
      order_ref VARCHAR(24) NOT NULL,
      part_code VARCHAR(24) NOT NULL,
      quantity INTEGER NOT NULL
    )
  )

  Schema crew
  (
    Table crew_record
    (
      crew_code VARCHAR(24) PRIMARY KEY,
      crew_name VARCHAR(120) NOT NULL,
      depot_name VARCHAR(120) NOT NULL
    )
  )

  Join Order_Crew(work.work_order.crew_code = crew.crew_record.crew_code)
  Join Usage_Order(work.part_usage.order_ref = work.work_order.order_ref)
)
