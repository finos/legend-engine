###Connection
RelationalDatabaseConnection test::gildedvineyard4::connection::VineyardWarehouseConnection
{
  store: test::gildedvineyard4::store::VineyardDatabase;
  type: Snowflake;
  quoteIdentifiers: false;
  specification: Snowflake
  {
    name: 'GILDED_VINEYARD_DB';
    account: 'gilded_vineyard_record';
    warehouse: 'GILDED_VINEYARD_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    role: 'VINEYARD_READ_ROLE';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'vineyard_reader';
    privateKeyVaultReference: 'vineyard-reader-private-key';
    passPhraseVaultReference: 'vineyard-reader-passphrase';
  };
}
