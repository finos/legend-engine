###Pure
import meta::pure::profiles::*;
import test::gildedvineyard4::domain::*;

Class <<temporal.processingtemporal>> {doc.doc = 'A planted vine block of an estate, versioned on a processing timeline so a corrected block record supersedes the earlier one and a point-in-time read sees exactly one version.'} test::gildedvineyard4::domain::VineBlock
{
  blockCode: String[1];
  varietalCode: String[1];
  estateCode: String[1];
  vineCount: Integer[1];
  hectares: Decimal[1];
  soilPh: Float[1];
  plantedOn: StrictDate[1];
  surveyedAt: DateTime[0..1];
  wardenName: String[0..1];
  canopyStyle: String[0..1];
}

Class <<temporal.processingtemporal>> {doc.doc = 'A harvest pass walked over one vine block; carries the measures the grouped services aggregate and is versioned on its own processing timeline.'} test::gildedvineyard4::domain::HarvestPass
{
  passCode: String[1];
  crewCode: String[1];
  passStage: String[1];
  yieldKg: Decimal[1];
  sugarBrix: Float[1];
  pickedOn: StrictDate[1];
  startedAt: DateTime[0..1];
  varietalCode: String[0..1];
}

Class <<temporal.processingtemporal>> {doc.doc = 'A trellis section describing how the canopy of the blocks trained on it is managed.'} test::gildedvineyard4::domain::TrellisSection
{
  sectionCode: String[1];
  canopyStyle: String[1];
  estateCode: String[1];
  rowSpacingM: Float[1];
}

Association {doc.doc = 'Link from a vine block to the harvest passes walked over it; both ends are processing-temporal, so a traversal re-supplies the processing date.'} test::gildedvineyard4::domain::BlockPassLink
{
  block: VineBlock[1];
  passes: HarvestPass[*];
}

Association {doc.doc = 'Link from a trellis section to the vine blocks trained on it.'} test::gildedvineyard4::domain::BlockSectionLink
{
  section: TrellisSection[1];
  blocks: VineBlock[*];
}
