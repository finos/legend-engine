###Pure
import meta::pure::profiles::*;

function {doc.doc = 'Label a block carries in published results: its own code joined to the varietal planted on it.'} test::gildedvineyard4::function::blockLabel(blockCode: String[1], varietalCode: String[1]): String[1]
{
  $blockCode + '/' + $varietalCode
}

function {doc.doc = 'Sugar reading a harvest pass must clear before it is counted: the nominal target less the tolerance the picking desk grants.'} test::gildedvineyard4::function::brixFloor(target: Float[1], tolerance: Float[1]): Float[1]
{
  $target - $tolerance
}
