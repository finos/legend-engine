###Pure
import test::duskyhatchery5::domain::*;

Class <<temporal.processingtemporal>> {meta::pure::profiles::doc.doc = 'A rearing pond whose recorded condition is versioned on a processing timeline.'} test::duskyhatchery5::domain::RearingPond
{
  pondCode: String[1];
  siteName: String[1];
  waterTempC: Float[1];
  volumeLitres: Decimal[1];
}

Class <<temporal.processingtemporal>> {meta::pure::profiles::doc.doc = 'A batch of hatchery fry reared in a pond, versioned on a processing timeline.'} test::duskyhatchery5::domain::FryBatch
{
  batchCode: String[1];
  speciesName: String[1];
  fryTally: Integer[1];
  hatchedOn: StrictDate[1];
  pond: RearingPond[1];
}

Class <<temporal.processingtemporal>> {meta::pure::profiles::doc.doc = 'A logged feeding run against a fry batch, versioned on a processing timeline.'} test::duskyhatchery5::domain::FeedRun
{
  feedCode: String[1];
  batchCode: String[1];
  feedKind: String[1];
  rationGrams: Integer[1];
  loggedAt: DateTime[1];
}
