###Service
Service test::duskyhatchery5::service::FeedTotalsService
{
  pattern: '/duskyhatchery/v1/feed-totals/{processingDate}';
  title: 'Feed Totals By Ration Kind';
  owners:
  [
    'hatchery-operations'
  ];
  documentation: 'Aggregates the logged ration mass per feed kind as of a processing instant, so this query body is an aggregate shape over the same milestoned store rather than a flat projection.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {processingDate: StrictDate[1]|test::duskyhatchery5::domain::FeedRun.all($processingDate)->groupBy(
      [
        f|$f.feedKind
      ],
      [
        agg(f|$f.rationGrams, y|$y->sum())
      ],
      [
        'FeedKind',
        'RationGrams'
      ]
    )->sort([asc('FeedKind')])};
    mapping: test::duskyhatchery5::mapping::HatcheryMapping;
    runtime: test::duskyhatchery5::runtime::HatcheryRuntime;
  }
  testSuites:
  [
    feedTotalsSuite:
    {
      data:
      [
        connections:
        [
          hatcheryConnection:
            Relational
            #{
              hatchery.feed_run:
                'feed_code,batch_code,feed_kind,ration_grams,logged_at,in_z,out_z\n'+
                'FR-01,FB-01,STARTER,500,2025-06-02 07:30:00,2025-01-01,9999-12-31\n'+
                'FR-02,FB-01,STARTER,300,2025-06-03 07:45:00,2025-01-01,9999-12-31\n'+
                'FR-03,FB-02,GROWER,800,2025-06-04 08:00:00,2025-01-01,9999-12-31\n'+
                'FR-04,FB-02,GROWER,900,2024-06-04 08:00:00,2024-01-01,2025-01-01\n';
            }#
        ]
      ]
      tests:
      [
        totalsExcludeSupersededRuns:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            processingDate = %2025-07-01
          ]
          asserts:
          [
            rationTotalsPerKind:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"FeedKind":"GROWER","RationGrams":800},{"FeedKind":"STARTER","RationGrams":800}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
