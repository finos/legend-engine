###Relational
Database demo::borealwarren2::store::CaveDB
(
  Schema cave
  (
    Table ripening_cave
    (
      cave_code VARCHAR(20) PRIMARY KEY,
      cave_name VARCHAR(80) NOT NULL,
      humidity_pct FLOAT NOT NULL
    )
    Table wheel_batch
    (
      batch_code VARCHAR(20) PRIMARY KEY,
      batch_name VARCHAR(80) NOT NULL,
      cave_code VARCHAR(20) NOT NULL,
      milk_kind VARCHAR(16) NOT NULL,
      band_code VARCHAR(2),
      note_text VARCHAR(80),
      rind_days INTEGER NOT NULL,
      weight_kg FLOAT NOT NULL,
      turned_on DATE NOT NULL
    )
  )

  Schema cellarlog
  (
    Table turn_event
    (
      event_id INTEGER PRIMARY KEY,
      batch_code VARCHAR(20) NOT NULL,
      turn_kind VARCHAR(16) NOT NULL,
      brush_count INTEGER NOT NULL
    )

    Table batch_grade
    (
      batch_code VARCHAR(20) PRIMARY KEY,
      grade_label VARCHAR(20) NOT NULL
    )

    View turn_summary_vw
    (
      ~filter BrushedTurnFilter
      ~groupBy
      (
        cellarlog.turn_event.batch_code
      )
      batchCode: cellarlog.turn_event.batch_code PRIMARY KEY,
      brushTotal: sum(cellarlog.turn_event.brush_count),
      turnTally: count(cellarlog.turn_event.turn_kind)
    )
  )

  Join Batch_Cave(cave.wheel_batch.cave_code = cave.ripening_cave.cave_code)
  Join Batch_TurnView(cave.wheel_batch.batch_code = cellarlog.turn_summary_vw.batchCode)
  Join Batch_Grade(cave.wheel_batch.batch_code = cellarlog.batch_grade.batch_code)

  Filter BrushedTurnFilter(cellarlog.turn_event.brush_count > 0)
  Filter RipeningBatchFilter(cave.wheel_batch.rind_days > 0)
)
