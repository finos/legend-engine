###Service
Service demo::borealwarren2::service::BatchHumidityService
{
  pattern: '/borealwarren/v1/batches/humidity';
  title: 'Boreal Warren - Batch Humidity';
  ownership: UserList { users: ['cave-floor-desk'] };
  documentation: 'Pairs the ripening weight of each batch with the humidity of the cave that holds it by joining a batch projection to a cave projection on the cave name, keeping only the oldest few batches so the shape of the joined result is asserted rather than the whole register.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: {|demo::borealwarren2::domain::WheelBatch.all()->project(
      [
        b|$b.batchCode,
        b|$b.cave.caveName,
        b|$b.weightKg
      ],
      [
        'BatchCode',
        'CaveName',
        'WeightKg'
      ]
    )->join(
      demo::borealwarren2::domain::RipeningCave.all()->project(
        [
          c|$c.caveName,
          c|$c.humidityPct
        ],
        [
          'RefCaveName',
          'HumidityPct'
        ]
      ),
      meta::relational::metamodel::join::JoinType.INNER,
      [
        'CaveName'
      ],
      [
        'RefCaveName'
      ]
    )->sort([asc('BatchCode')])->limit(4)};
    mapping: demo::borealwarren2::mapping::BatchMapping;
    runtime: demo::borealwarren2::runtime::CaveRuntime;
  }
  testSuites:
  [
    batchHumiditySuite:
    {
      data:
      [
        connections:
        [
          caveConnection:
            Reference
            #{
              demo::borealwarren2::data::CaveTestData
            }#
        ]
      ]
      tests:
      [
        oldestBatchesWithCaveHumidity:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            joinedHumidityRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"BatchCode":"WB-01","CaveName":"Lower Cellar","WeightKg":9.0,"RefCaveName":"Lower Cellar","HumidityPct":92.0},{"BatchCode":"WB-02","CaveName":"Lower Cellar","WeightKg":5.0,"RefCaveName":"Lower Cellar","HumidityPct":92.0},{"BatchCode":"WB-03","CaveName":"Lower Cellar","WeightKg":5.0,"RefCaveName":"Lower Cellar","HumidityPct":92.0},{"BatchCode":"WB-04","CaveName":"Lower Cellar","WeightKg":6.0,"RefCaveName":"Lower Cellar","HumidityPct":92.0}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
