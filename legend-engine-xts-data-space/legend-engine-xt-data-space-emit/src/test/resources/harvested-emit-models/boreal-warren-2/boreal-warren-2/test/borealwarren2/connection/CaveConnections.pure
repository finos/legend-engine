###Connection
RelationalDatabaseConnection demo::borealwarren2::connection::CaveH2Connection
{
  store: demo::borealwarren2::store::CaveDB;
  type: H2;
  specification: LocalH2 { testDataSetupSqls: []; };
  auth: DefaultH2;
}

RelationalDatabaseConnection demo::borealwarren2::connection::CaveWarehouseConnection
{
  store: demo::borealwarren2::store::CaveDB;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'CAVE_RIPENING_DB';
    account: 'cave_ripening_account';
    warehouse: 'CAVE_WH';
    region: 'us-east-1';
  };
  auth: OAuth
  {
    oauthKey: 'CAVE_OAUTH';
    scopeName: 'SESSION:ROLE:CAVE_ROLE';
  };
}
