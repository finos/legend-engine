###DataSpace
DataSpace demo::borealwarren2::dataspace::CaveDataSpace
{
  executionContexts:
  [
    {
      name: 'cellar';
      description: 'Working cellar tier resolved against the ripening database.';
      mapping: demo::borealwarren2::mapping::BatchMapping;
      defaultRuntime: demo::borealwarren2::runtime::CaveRuntime;
    },
    {
      name: 'warehouse';
      description: 'Warehouse ripening tier resolved through the warehouse connection.';
      mapping: demo::borealwarren2::mapping::BatchMapping;
      defaultRuntime: demo::borealwarren2::runtime::CaveWarehouseRuntime;
    }
  ];
  defaultExecutionContext: 'cellar';
  title: 'Cheese Cave Ripening Register';
  description: 'Governed entry point over the wheel batch ripening register, its brushed-turn summary view and the ripening caves that hold the batches.';
}
