###Mapping
Mapping test::kindlycanyon::mapping::PatrolMapping
(
  *test::kindlycanyon::domain::PatrolLog[patrolLog]: Relational
  {
    ~primaryKey
    (
      [test::kindlycanyon::store::CanyonTrailDB]trail.patrol_log.log_id
    )
    ~mainTable [test::kindlycanyon::store::CanyonTrailDB]trail.patrol_log
    logId: [test::kindlycanyon::store::CanyonTrailDB]trail.patrol_log.log_id,
    loggedOn: [test::kindlycanyon::store::CanyonTrailDB]trail.patrol_log.logged_on,
    closedOn: [test::kindlycanyon::store::CanyonTrailDB]trail.patrol_log.closed_on,
    walkMinutes: [test::kindlycanyon::store::CanyonTrailDB]trail.patrol_log.walk_minutes,
    conditionCode: [test::kindlycanyon::store::CanyonTrailDB]trail.patrol_log.condition_code,
    hazardNote: [test::kindlycanyon::store::CanyonTrailDB]trail.patrol_log.hazard_note
  }

  *test::kindlycanyon::domain::PatrolPost[patrolPost]: Relational
  {
    ~primaryKey
    (
      [test::kindlycanyon::store::CanyonTrailDB]trail.patrol_post.post_id
    )
    ~mainTable [test::kindlycanyon::store::CanyonTrailDB]trail.patrol_post
    postId: [test::kindlycanyon::store::CanyonTrailDB]trail.patrol_post.post_id,
    postName: [test::kindlycanyon::store::CanyonTrailDB]trail.patrol_post.post_name,
    postKind: [test::kindlycanyon::store::CanyonTrailDB]trail.patrol_post.post_kind,
    wardenName: [test::kindlycanyon::store::CanyonTrailDB]@Post_Warden | [test::kindlycanyon::store::CanyonTrailDB]roster.warden_view.warden_name
  }

  test::kindlycanyon::domain::RidgePost[ridgePost] extends [patrolPost]: Relational
  {
    ~filter [test::kindlycanyon::store::CanyonTrailDB]RidgePosts
    ~primaryKey
    (
      [test::kindlycanyon::store::CanyonTrailDB]trail.patrol_post.post_id
    )
    ~mainTable [test::kindlycanyon::store::CanyonTrailDB]trail.patrol_post
    ridgeHeightM: [test::kindlycanyon::store::CanyonTrailDB]trail.patrol_post.ridge_height_m
  }

  test::kindlycanyon::domain::CanyonFloorPost[floorPost] extends [patrolPost]: Relational
  {
    ~filter [test::kindlycanyon::store::CanyonTrailDB]FloorPosts
    ~primaryKey
    (
      [test::kindlycanyon::store::CanyonTrailDB]trail.patrol_post.post_id
    )
    ~mainTable [test::kindlycanyon::store::CanyonTrailDB]trail.patrol_post
    floorDepthM: [test::kindlycanyon::store::CanyonTrailDB]trail.patrol_post.floor_depth_m
  }

  test::kindlycanyon::domain::MobilePost[mobilePost] extends [patrolPost]: Relational
  {
    ~filter [test::kindlycanyon::store::CanyonTrailDB]MobilePosts
    ~primaryKey
    (
      [test::kindlycanyon::store::CanyonTrailDB]trail.patrol_post.post_id
    )
    ~mainTable [test::kindlycanyon::store::CanyonTrailDB]trail.patrol_post
    vehiclePlate: [test::kindlycanyon::store::CanyonTrailDB]trail.patrol_post.vehicle_plate
  }

  *test::kindlycanyon::domain::TrailSegment[trailSegment]: Relational
  {
    ~primaryKey
    (
      [test::kindlycanyon::store::CanyonTrailDB]trail.trail_segment.segment_code
    )
    ~mainTable [test::kindlycanyon::store::CanyonTrailDB]trail.trail_segment
    segmentCode: [test::kindlycanyon::store::CanyonTrailDB]trail.trail_segment.segment_code,
    segmentName: [test::kindlycanyon::store::CanyonTrailDB]trail.trail_segment.segment_name,
    lengthM: [test::kindlycanyon::store::CanyonTrailDB]trail.trail_segment.length_m
  }

  *test::kindlycanyon::domain::Warden[warden]: Relational
  {
    ~primaryKey
    (
      [test::kindlycanyon::store::CanyonTrailDB]roster.warden_view.warden_code
    )
    ~mainTable [test::kindlycanyon::store::CanyonTrailDB]roster.warden_view
    wardenCode: [test::kindlycanyon::store::CanyonTrailDB]roster.warden_view.warden_code,
    wardenName: [test::kindlycanyon::store::CanyonTrailDB]roster.warden_view.warden_name,
    rotaBand: [test::kindlycanyon::store::CanyonTrailDB]roster.warden_view.rota_band
  }

  test::kindlycanyon::domain::Log_Post: Relational
  {
    AssociationMapping
    (
      post[patrolLog, patrolPost]: [test::kindlycanyon::store::CanyonTrailDB]@Log_Post,
      logs[patrolPost, patrolLog]: [test::kindlycanyon::store::CanyonTrailDB]@Log_Post
    )
  }

  test::kindlycanyon::domain::Post_Segment: Relational
  {
    AssociationMapping
    (
      segment[patrolPost, trailSegment]: [test::kindlycanyon::store::CanyonTrailDB]@Post_Segment,
      posts[trailSegment, patrolPost]: [test::kindlycanyon::store::CanyonTrailDB]@Post_Segment
    )
  }

  testSuites:
  [
    patrolRegisterSuite:
    {
      function: |test::kindlycanyon::domain::PatrolLog.all()->project(
        [
          l|$l.logId,
          l|$l.post.postName,
          l|$l.post.postKind,
          l|$l.post.wardenName,
          l|$l.post.segment.segmentName,
          l|$l.effortBand(),
          l|$l.openDays(),
          l|$l.conditionCode
        ],
        [
          'Log',
          'Post',
          'Kind',
          'Warden',
          'Segment',
          'Effort',
          'OpenDays',
          'Condition'
        ]
      )->sort(
        [
          asc('Log')
        ]
      );
      tests:
      [
        everyEffortBandAndBothAbsentHopsArePublished:
        {
          doc: 'Walks the patrol register through the post hop, the cross-schema warden hop and the two-hop segment hop from one fixture, so all three effort bands, the still-open marker, the post that stands on no segment and the patrol naming a post that does not exist are proven together.';
          data:
          [
            test::kindlycanyon::store::CanyonTrailDB:
              Reference
              #{
                test::kindlycanyon::data::PatrolFixture
              }#
          ];
          asserts:
          [
            registerRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Log":"PL-01","Post":"Rim Overlook","Kind":"RIDGE","Warden":"Marla Ovett","Segment":"Rim Traverse","Effort":"LONG","OpenDays":1,"Condition":"DRY"},{"Log":"PL-02","Post":"Rim Overlook","Kind":"RIDGE","Warden":"Marla Ovett","Segment":"Rim Traverse","Effort":"MEDIUM","OpenDays":-1,"Condition":"WET"},{"Log":"PL-03","Post":"Rim Cairn","Kind":"RIDGE","Warden":"Dessa Trill","Segment":"Rim Traverse","Effort":"LONG","OpenDays":0,"Condition":"WET"},{"Log":"PL-04","Post":"Rim Cairn","Kind":"RIDGE","Warden":"Dessa Trill","Segment":"Rim Traverse","Effort":"SHORT","OpenDays":-1,"Condition":"DRY"},{"Log":"PL-05","Post":"Bench Shelter","Kind":"FLOOR","Warden":"Corin Blay","Segment":"Cottonwood Bench","Effort":"MEDIUM","OpenDays":5,"Condition":"WET"},{"Log":"PL-06","Post":"Narrows Wading Point","Kind":"FLOOR","Warden":"Marla Ovett","Segment":"Boulder Narrows","Effort":"SHORT","OpenDays":-1,"Condition":"DRY"},{"Log":"PL-07","Post":"Rove Truck","Kind":"MOBILE","Warden":"Dessa Trill","Segment":"Cottonwood Bench","Effort":"LONG","OpenDays":1,"Condition":"WET"},{"Log":"PL-08","Post":"Relief Truck","Kind":"MOBILE","Warden":null,"Segment":null,"Effort":"MEDIUM","OpenDays":-1,"Condition":"DRY"},{"Log":"PL-09","Post":null,"Kind":null,"Warden":null,"Segment":null,"Effort":"MEDIUM","OpenDays":-1,"Condition":"DRY"}]';
                  }#;
              }#
          ];
        }
      ];
    },
    postCoverageSuite:
    {
      function: |test::kindlycanyon::domain::PatrolPost.all()->filter(
        p|$p.logs->exists(l|$l.walkMinutes >= 90)
      )->project(
        [
          p|$p.postId,
          p|$p.postKind,
          p|$p.wardenName,
          p|$p.segment->toOne().segmentName
        ],
        [
          'Post',
          'Kind',
          'Warden',
          'Segment'
        ]
      )->sort(
        [
          asc('Post')
        ]
      );
      tests:
      [
        existenceOverThePatrolCollectionAndTheCoercedSegmentHop:
        {
          doc: 'Keeps only the posts whose patrol collection holds at least one long walk, so the existence test is proven against posts with several patrols, posts with only short patrols and posts with none, and reads the segment of each surviving post through a single-element coercion.';
          data:
          [
            test::kindlycanyon::store::CanyonTrailDB:
              Reference
              #{
                test::kindlycanyon::data::PatrolFixture
              }#
          ];
          asserts:
          [
            coverageRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Post":"PP-01","Kind":"RIDGE","Warden":"Marla Ovett","Segment":"Rim Traverse"},{"Post":"PP-02","Kind":"RIDGE","Warden":"Dessa Trill","Segment":"Rim Traverse"},{"Post":"PP-05","Kind":"MOBILE","Warden":"Dessa Trill","Segment":"Cottonwood Bench"}]';
                  }#;
              }#
          ];
        }
      ];
    },
    postSubtypeSuite:
    {
      function: |test::kindlycanyon::domain::RidgePost.all()->project(
        [
          p|$p.postId,
          p|$p.postName,
          p|$p.ridgeHeightM
        ],
        [
          'Post',
          'Name',
          'Measure'
        ]
      )->concatenate(
        test::kindlycanyon::domain::CanyonFloorPost.all()->project(
          [
            p|$p.postId,
            p|$p.postName,
            p|$p.floorDepthM
          ],
          [
            'Post',
            'Name',
            'Measure'
          ]
        )
      )->sort(
        [
          asc('Post')
        ]
      );
      tests:
      [
        bothElevationSubtypesResolveThroughTheirOwnFilteredExtent:
        {
          doc: 'Reads the two elevation subtypes out of the shared post table through their own filtered extents, proving each subtype sees only its own rows while the inherited identity and name columns still resolve from the supertype extent.';
          data:
          [
            test::kindlycanyon::store::CanyonTrailDB:
              Reference
              #{
                test::kindlycanyon::data::PatrolFixture
              }#
          ];
          asserts:
          [
            subtypeRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Post":"PP-01","Name":"Rim Overlook","Measure":410},{"Post":"PP-02","Name":"Rim Cairn","Measure":455},{"Post":"PP-03","Name":"Bench Shelter","Measure":120},{"Post":"PP-04","Name":"Narrows Wading Point","Measure":260}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
