###Connection
RelationalDatabaseConnection test::kindlycanyon::connection::CanyonTrailConnection
{
  store: test::kindlycanyon::store::CanyonTrailDB;
  type: Snowflake;
  timezone: 'UTC';
  specification: Snowflake
  {
    name: 'CANYON_TRAIL_DB';
    account: 'canyon_trail_account';
    warehouse: 'CANYON_TRAIL_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    accountType: MultiTenant;
    organization: 'kindly_canyon_org';
    role: 'CANYON_TRAIL_READER';
  };
  auth: OAuth
  {
    oauthKey: 'canyonTrailOauthKey';
    scopeName: 'session:role:CANYON_TRAIL_READER';
  };
}

###Connection
