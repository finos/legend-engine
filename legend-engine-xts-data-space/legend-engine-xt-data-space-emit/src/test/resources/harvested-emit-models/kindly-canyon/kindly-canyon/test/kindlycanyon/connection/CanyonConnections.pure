{
  store: test::kindlycanyon::store::CanyonVisitDB;
  type: Snowflake;
  timezone: 'UTC';
  specification: Snowflake
  {
    name: 'CANYON_VISIT_DB';
    account: 'canyon_visit_account';
    warehouse: 'CANYON_VISIT_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    accountType: MultiTenant;
    organization: 'kindly_canyon_org';
    role: 'CANYON_VISIT_READER';
  };
  auth: OAuth
  {
    oauthKey: 'canyonVisitOauthKey';
    scopeName: 'session:role:CANYON_VISIT_READER';
