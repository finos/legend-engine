###Mapping
Mapping test::quietsummit2::mapping::SummitMapping
(
  *test::quietsummit2::domain::Station[station]: Relational
  {
    ~primaryKey
    (
      [test::quietsummit2::store::SummitDB]alpine.station.station_code
    )
    ~mainTable [test::quietsummit2::store::SummitDB]alpine.station
    stationCode: [test::quietsummit2::store::SummitDB]alpine.station.station_code,
    name: [test::quietsummit2::store::SummitDB]alpine.station.station_name,
    elevationMetres: [test::quietsummit2::store::SummitDB]alpine.station.elevation_metres,
    region: [test::quietsummit2::store::SummitDB]alpine.station.region
  }

  *test::quietsummit2::domain::Sensor[sensor]: Relational
  {
    ~primaryKey
    (
      [test::quietsummit2::store::SummitDB]alpine.sensor.sensor_code
    )
    ~mainTable [test::quietsummit2::store::SummitDB]alpine.sensor
    sensorCode: [test::quietsummit2::store::SummitDB]alpine.sensor.sensor_code,
    label: [test::quietsummit2::store::SummitDB]alpine.sensor.label,
    sensorKind: [test::quietsummit2::store::SummitDB]alpine.sensor.sensor_kind,
    calibratedOn: [test::quietsummit2::store::SummitDB]alpine.sensor.calibrated_on
  }

  *test::quietsummit2::domain::GustReading[gustReading]: Relational
  {
    ~primaryKey
    (
      [test::quietsummit2::store::SummitDB]alpine.gust_reading.reading_code
    )
    ~mainTable [test::quietsummit2::store::SummitDB]alpine.gust_reading
    readingCode: [test::quietsummit2::store::SummitDB]alpine.gust_reading.reading_code,
    stationCode: [test::quietsummit2::store::SummitDB]alpine.gust_reading.station_code,
    gustSpeed: [test::quietsummit2::store::SummitDB]alpine.gust_reading.gust_speed,
    observedOn: [test::quietsummit2::store::SummitDB]alpine.gust_reading.observed_on
  }

  *test::quietsummit2::domain::SnowSample[snowSample]: Relational
  {
    ~primaryKey
    (
      [test::quietsummit2::store::SummitDB]alpine.snow_sample.sample_code
    )
    ~mainTable [test::quietsummit2::store::SummitDB]alpine.snow_sample
    sampleCode: [test::quietsummit2::store::SummitDB]alpine.snow_sample.sample_code,
    stationCode: [test::quietsummit2::store::SummitDB]alpine.snow_sample.station_code,
    depthCentimetres: [test::quietsummit2::store::SummitDB]alpine.snow_sample.depth_centimetres,
    sampledOn: [test::quietsummit2::store::SummitDB]alpine.snow_sample.sampled_on
  }

  testSuites:
  [
    stationRosterSuite:
    {
      function: |test::quietsummit2::domain::Station.all()->project(
  [
    s|$s.stationCode,
    s|$s.name,
    s|$s.elevationMetres,
    s|$s.region
  ],
  [
    'Code',
    'Name',
    'Elevation',
    'Region'
  ]
)->sort(
  [
    asc('Code')
  ]
);
      tests:
      [
        stationRoster:
        {
          doc: 'Projects the four primary-key-anchored station columns over the main table alias to verify the root class mapping.';
          data:
          [
            test::quietsummit2::store::SummitDB:
              Relational
              #{
                alpine.station:
                  'station_code,station_name,elevation_metres,region\n'+
                  'NRDG,North Ridge,2410,NORTH\n'+
                  'SCOL,South Col,1980,SOUTH\n';
              }#
          ];
          asserts:
          [
            bothStations:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Code":"NRDG","Name":"North Ridge","Elevation":2410,"Region":"NORTH"},{"Code":"SCOL","Name":"South Col","Elevation":1980,"Region":"SOUTH"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
