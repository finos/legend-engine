Profile test::quietsummit2::domain::SummitGovernance
{
  stereotypes: [published, provisional];
  tags: [steward, refreshCadence];
}

Class <<test::quietsummit2::domain::SummitGovernance.published>> {test::quietsummit2::domain::SummitGovernance.steward = 'alpine-observation-network', meta::pure::profiles::doc.doc = 'A staffed high-altitude weather post in the ridge observation network.'} test::quietsummit2::domain::Station
{
  stationCode: String[1];
  name: String[1];
  elevationMetres: Integer[1];
  region: String[1];
}

Class <<test::quietsummit2::domain::SummitGovernance.provisional>> {meta::pure::profiles::doc.doc = 'An instrument installed at a weather post, with its last calibration date.'} test::quietsummit2::domain::Sensor
{
  sensorCode: String[1];
  label: String[1];
  sensorKind: String[1];
  calibratedOn: StrictDate[1];
}

Class {meta::pure::profiles::doc.doc = 'A peak wind gust recorded by the anemometer of a weather post.'} test::quietsummit2::domain::GustReading
{
  readingCode: String[1];
  stationCode: String[1];
  gustSpeed: Float[1];
  observedOn: StrictDate[1];
}

Class {meta::pure::profiles::doc.doc = 'A manual snow-depth sample taken at a weather post.'} test::quietsummit2::domain::SnowSample
{
