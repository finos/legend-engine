###Service
Service test::quietsummit2::service::StationRoster
{
  pattern: '/alpine/v1/stations/{region}';
  title: 'Alpine - Station Roster';
  owners:
  [
    'alpine-observation-network',
    'ridge-instrumentation'
  ];
  documentation: 'Returns the weather posts of one ridge region as a flat projection of code, name and elevation, ordered by post code.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {region: String[1]|test::quietsummit2::domain::Station.all()->filter(
      s|$s.region == $region
    )->project(
      [
        s|$s.stationCode,
        s|$s.name,
        s|$s.elevationMetres
      ],
      [
        'Code',
        'Name',
        'Elevation'
      ]
    )->sort(
      [
        asc('Code')
      ]
    )};
    mapping: test::quietsummit2::mapping::SummitMapping;
    runtime: test::quietsummit2::runtime::SummitH2Runtime;
  }
  testSuites:
  [
    stationRosterSuite:
    {
      data:
      [
        connections:
        [
          h2Connection:
            Relational
            #{
              alpine.station:
                'station_code,station_name,elevation_metres,region\n'+
                'NRDG,North Ridge,2410,NORTH\n'+
                'NSAD,North Saddle,2260,NORTH\n'+
                'SCOL,South Col,1980,SOUTH\n';
            }#
        ]
      ]
      tests:
      [
        northernPosts:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            region = 'NORTH'
          ]
          asserts:
          [
            twoNorthernPosts:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Code":"NRDG","Name":"North Ridge","Elevation":2410},{"Code":"NSAD","Name":"North Saddle","Elevation":2260}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
