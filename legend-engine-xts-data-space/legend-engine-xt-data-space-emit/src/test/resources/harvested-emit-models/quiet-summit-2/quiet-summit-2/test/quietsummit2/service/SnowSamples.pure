###Service
Service test::quietsummit2::service::SnowSamples
{
  pattern: '/alpine/v1/snow/{stationCode}/{fromDate}';
  title: 'Alpine - Snow Samples';
  owners:
  [
    'alpine-observation-network',
    'ridge-instrumentation'
  ];
  documentation: 'Returns the manual snow-depth samples taken at one weather post on or after a date, projected flat and ordered by sample date.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {stationCode: String[1], fromDate: StrictDate[1]|test::quietsummit2::domain::SnowSample.all()->filter(
      s|($s.stationCode == $stationCode) && ($s.sampledOn >= $fromDate)
    )->project(
      [
        s|$s.sampleCode,
        s|$s.depthCentimetres,
        s|$s.sampledOn
      ],
      [
        'Code',
        'Depth',
        'Sampled'
      ]
    )->sort(
      [
        asc('Sampled')
      ]
    )};
    mapping: test::quietsummit2::mapping::SummitMapping;
    runtime: test::quietsummit2::runtime::SummitH2Runtime;
  }
  testSuites:
  [
    snowSamplesSuite:
    {
      data:
      [
        connections:
        [
          h2Connection:
            Relational
            #{
              alpine.snow_sample:
                'sample_code,station_code,depth_centimetres,sampled_on\n'+
                'SNAPA,NRDG,64,2026-01-05\n'+
                'SNAPB,NRDG,88,2026-02-06\n'+
                'SNAPC,NRDG,120,2026-03-07\n'+
                'SNAPD,SCOL,41,2026-02-08\n';
            }#
        ]
      ]
      tests:
      [
        lateSeasonSamples:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            stationCode = 'NRDG',
            fromDate = %2026-02-01
          ]
          asserts:
          [
            twoLateSamples:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Code":"SNAPB","Depth":88,"Sampled":"2026-02-06"},{"Code":"SNAPC","Depth":120,"Sampled":"2026-03-07"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
