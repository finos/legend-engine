###Connection
RelationalDatabaseConnection test::quietsummit2::connection::SummitWarehouseConnection
{
  store: test::quietsummit2::store::SummitDB;
  type: Snowflake;
  timezone: 'UTC';
  specification: Snowflake
  {
    name: 'ALPINE_DB';
    account: 'alpine_account';
    warehouse: 'ALPINE_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    enableQueryTags: false;
    accountType: MultiTenant;
    organization: 'alpine_org';
    role: 'ALPINE_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'ALPINE_USER';
    privateKeyVaultReference: 'alpine.privateKey';
    passPhraseVaultReference: 'alpine.passPhrase';
  };
}
