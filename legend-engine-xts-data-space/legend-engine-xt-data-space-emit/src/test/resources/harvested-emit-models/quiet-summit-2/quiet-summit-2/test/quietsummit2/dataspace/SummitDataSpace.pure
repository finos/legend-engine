###DataSpace
DataSpace <<test::quietsummit2::domain::SummitGovernance.published>> {test::quietsummit2::domain::SummitGovernance.steward = 'alpine-observation-network', test::quietsummit2::domain::SummitGovernance.refreshCadence = 'HOURLY'} test::quietsummit2::dataspace::SummitDataSpace
{
  executionContexts:
  [
    {
      name: 'warehouse';
      description: 'Governed ridge-network tier reading the four observation tables from the warehouse.';
      mapping: test::quietsummit2::mapping::SummitMapping;
      defaultRuntime: test::quietsummit2::runtime::SummitWarehouseRuntime;
    },
    {
      name: 'local';
      description: 'In-process tier seeded with sample post, instrument, gust and snow rows.';
      mapping: test::quietsummit2::mapping::SummitMapping;
      defaultRuntime: test::quietsummit2::runtime::SummitH2Runtime;
    }
  ];
  defaultExecutionContext: 'warehouse';
  title: 'Alpine Ridge Observation Network';
  description: 'A governed entry point over the ridge weather posts, their installed instruments and the gust and snow-depth observations they record.';
  supportInfo: Email
  {
    address: 'alpine-observation-network@localhost';
  };
}
