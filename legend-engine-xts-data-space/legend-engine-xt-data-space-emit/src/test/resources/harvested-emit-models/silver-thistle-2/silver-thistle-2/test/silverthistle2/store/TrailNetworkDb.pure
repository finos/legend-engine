###Relational
Database test::silverthistle2::store::TrailNetworkDb
(
  Schema alpine
  (
    Table trail_segment
    (
      segment_id VARCHAR(16) PRIMARY KEY,
      station_id VARCHAR(16) NOT NULL,
      patrol_id VARCHAR(16) NOT NULL,
      label VARCHAR(60) NOT NULL,
      length_m INTEGER NOT NULL,
      grade_code VARCHAR(20) NOT NULL
    )
    Table ranger_station
    (
      station_id VARCHAR(16) PRIMARY KEY,
      region_code VARCHAR(16) NOT NULL,
      station_name VARCHAR(60) NOT NULL,
      upkeep_code VARCHAR(20) NOT NULL
    )
    Table trail_region
    (
      region_code VARCHAR(16) PRIMARY KEY,
      region_name VARCHAR(60) NOT NULL
    )
    Table patrol_log
    (
      patrol_id VARCHAR(16) PRIMARY KEY,
      note VARCHAR(120) NOT NULL,
      patrol_code VARCHAR(20) NOT NULL
    )
    Table survey_mark
    (
      mark_id VARCHAR(16) PRIMARY KEY,
      segment_id VARCHAR(16) NOT NULL,
      mark_name VARCHAR(60) NOT NULL,
      grade_code VARCHAR(20) NOT NULL
    )
    Table trailhead_kiosk
    (
      kiosk_id VARCHAR(16) PRIMARY KEY,
      station_id VARCHAR(16) NOT NULL,
      kiosk_name VARCHAR(60) NOT NULL
    )
  )

  Join Segment_Station(alpine.trail_segment.station_id = alpine.ranger_station.station_id)

  Join Station_Region(alpine.ranger_station.region_code = alpine.trail_region.region_code)

  Join Segment_Patrol(alpine.trail_segment.patrol_id = alpine.patrol_log.patrol_id)
)
