###Pure
import test::silverthistle2::domain::*;

Enum test::silverthistle2::domain::TrailGrade
{
  EASY,
  MODERATE,
  STEEP,
  EXPOSED_SCRAMBLE
}

Enum test::silverthistle2::domain::UpkeepClass
{
  ROUTINE,
  PRIORITY,
  DEFERRED
}

Enum test::silverthistle2::domain::PatrolKind
{
  FOOT,
  SKI,
  MOUNTED
}

Class test::silverthistle2::domain::TrailSegment
{
  segmentId: String[1];
  label: String[1];
  lengthMeters: Integer[1];
  grade: TrailGrade[1];
  regionName: String[0..1];
}

Class test::silverthistle2::domain::RangerStation
{
  stationId: String[1];
  stationName: String[1];
  upkeep: UpkeepClass[1];
}

Class test::silverthistle2::domain::TrailRegion
{
  regionCode: String[1];
  regionName: String[1];
}

Class test::silverthistle2::domain::PatrolLog
{
  patrolId: String[1];
  note: String[1];
  patrolKind: PatrolKind[1];
}

Class test::silverthistle2::domain::SurveyMark
{
  markId: String[1];
  markName: String[1];
  grade: TrailGrade[1];
}

Class test::silverthistle2::domain::TrailheadKiosk
{
  kioskId: String[1];
  kioskName: String[1];
}

Association test::silverthistle2::domain::SegmentStation
{
  station: RangerStation[1];
  segment: TrailSegment[1];
}

Association test::silverthistle2::domain::StationRegion
{
  region: TrailRegion[1];
  homeStation: RangerStation[1];
}

Association test::silverthistle2::domain::SegmentPatrol
{
  patrol: PatrolLog[1];
  patrolledSegment: TrailSegment[1];
}
