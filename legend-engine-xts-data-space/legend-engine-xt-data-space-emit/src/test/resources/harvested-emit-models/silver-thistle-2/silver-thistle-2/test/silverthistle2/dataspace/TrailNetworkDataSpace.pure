###DataSpace
DataSpace test::silverthistle2::dataspace::TrailNetworkDataSpace
{
  executionContexts:
  [
    {
      name: 'network';
      description: 'Trail network context - the single trail mapping served through the single warehouse runtime.';
      mapping: test::silverthistle2::mapping::TrailNetworkMapping;
      defaultRuntime: test::silverthistle2::runtime::TrailNetworkRuntime;
    }
  ];
  defaultExecutionContext: 'network';
  title: 'Silver Thistle Alpine Trail Network';
  description: 'Discovery surface over the alpine trail network: segments, the ranger stations that keep them, the regions above those stations and the patrol log behind each segment.';
  elements:
  [
    test::silverthistle2::domain::TrailSegment,
    test::silverthistle2::domain::RangerStation,
    test::silverthistle2::domain::TrailRegion,
    test::silverthistle2::domain::PatrolLog
  ];
  supportInfo: Email
  {
    address: 'trail-network-support-group';
  };
}
