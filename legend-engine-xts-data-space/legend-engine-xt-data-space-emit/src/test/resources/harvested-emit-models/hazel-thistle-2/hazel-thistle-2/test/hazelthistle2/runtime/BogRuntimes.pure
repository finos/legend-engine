###Runtime
Runtime demo::hazelthistle2::runtime::BogRuntime
{
  mappings:
  [
    demo::hazelthistle2::mapping::MossMapping
  ];
  connections:
  [
    demo::hazelthistle2::store::BogDB:
    [
      h2Connection: demo::hazelthistle2::connection::BogH2Connection
    ]
  ];
}

Runtime demo::hazelthistle2::runtime::BogWarehouseRuntime
{
  mappings:
  [
    demo::hazelthistle2::mapping::MossMapping
  ];
  connections:
  [
    demo::hazelthistle2::store::BogDB:
    [
      warehouseConnection: demo::hazelthistle2::connection::BogWarehouseConnection
    ]
  ];
}
