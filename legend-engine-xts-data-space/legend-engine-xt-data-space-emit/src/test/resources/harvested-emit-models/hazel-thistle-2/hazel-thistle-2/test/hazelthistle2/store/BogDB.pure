###Relational
Database demo::hazelthistle2::store::BogDB
(
  Schema peatland
  (
    Table catchment
    (
      catchment_code VARCHAR(20) PRIMARY KEY,
      catchment_name VARCHAR(80) NOT NULL
    )
    Table bog_plot
    (
      plot_code VARCHAR(20) PRIMARY KEY,
      plot_label VARCHAR(60) NOT NULL,
      catchment_code VARCHAR(20) NOT NULL
    )
    Table moss_survey
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      survey_code VARCHAR(20) PRIMARY KEY,
      surveyed_on DATE NOT NULL,
      moss_class VARCHAR(20) NOT NULL,
      moss_cover_pct FLOAT NOT NULL,
      water_depth_cm FLOAT NOT NULL,
      dam_state VARCHAR(20),
      plot_code VARCHAR(20) NOT NULL,
      from_z DATE PRIMARY KEY,
      thru_z DATE
    )
  )

  Join Survey_Plot(peatland.moss_survey.plot_code = peatland.bog_plot.plot_code)
  Join Plot_Catchment(peatland.bog_plot.catchment_code = peatland.catchment.catchment_code)
)
