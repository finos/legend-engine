###Connection
RelationalDatabaseConnection demo::hazelthistle2::connection::BogH2Connection
{
  store: demo::hazelthistle2::store::BogDB;
  type: H2;
  specification: LocalH2 { testDataSetupSqls: []; };
  auth: DefaultH2;
}

RelationalDatabaseConnection demo::hazelthistle2::connection::BogWarehouseConnection
{
  store: demo::hazelthistle2::store::BogDB;
  type: Snowflake;
  timezone: +0000;
  quoteIdentifiers: false;
  specification: Snowflake
  {
    name: 'PEATLAND_RESTORATION_DB';
    account: 'peatland_restoration_account';
    warehouse: 'PEATLAND_WH';
    region: 'eu-west-2';
    cloudType: 'aws';
    accountType: MultiTenant;
    organization: 'peatland_org';
    role: 'PEATLAND_READER';
  };
  auth: OAuth
  {
    oauthKey: 'peatland_oauth_key';
    scopeName: 'SESSION:ROLE:PEATLAND_READER';
  };
}
