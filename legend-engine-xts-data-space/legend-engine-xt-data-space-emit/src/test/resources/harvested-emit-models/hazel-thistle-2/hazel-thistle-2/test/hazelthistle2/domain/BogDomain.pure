###Pure
import demo::hazelthistle2::domain::*;

Class demo::hazelthistle2::domain::Catchment
{
  catchmentCode: String[1];
  catchmentName: String[1];
}

Class demo::hazelthistle2::domain::BogPlot
{
  plotCode: String[1];
  plotLabel: String[1];
  catchment: Catchment[1];
}

Class <<temporal.businesstemporal>> demo::hazelthistle2::domain::MossSurvey
{
  surveyCode: String[1];
  surveyedOn: StrictDate[1];
  mossClass: String[1];
  mossLabel: String[1];
  mossCoverPct: Float[1];
  waterDepthCm: Float[1];
  wetnessIndex: Float[1];
  damState: String[0..1];
  plot: BogPlot[1];
  recoveryBand(wetnessFloor: Float[1])
  {
    if($this.wetnessIndex >= $wetnessFloor,
       |'RECOVERING',
       |if($this.mossCoverPct >= 20.0,
           |'HOLDING',
           |'DEGRADED'))
  }: String[1];
}
