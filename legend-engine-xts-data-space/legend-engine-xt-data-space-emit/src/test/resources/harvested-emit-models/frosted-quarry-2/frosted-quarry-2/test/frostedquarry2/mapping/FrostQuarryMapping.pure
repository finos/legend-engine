  testSuites:
  [
    blockLineageSuite:
    {
      function: |test::frostedquarry2::domain::IceBlock.all()->project(
        [
          r|$r.blockCode,
          r|$r.cycle.cycleCode,
          r|$r.cycle.panel.panelCode,
          r|$r.cycle.panel.quarry.quarryName,
          r|$r.grades.gradeCode
        ],
        [
          'Block',
          'Cycle',
          'Panel',
          'Quarry',
          'Grade'
        ]
      )->sort([asc('Block'), asc('Grade')]);
      tests:
      [
        theFourHopLineageResolvesThroughFourAssociationMappings:
        {
          data:
          [
            test::frostedquarry2::store::FrostQuarryDB:
              Relational
              #{
                frostquarry.ice_quarry:
                  'quarry_id,quarry_name,region_code,licence_status\n'+
                  'QRY-01,North Firn Quarry,REG-N,ACTIVE\n';
                frostquarry.extraction_panel:
                  'panel_id,quarry_id,panel_code,ice_thickness_m\n'+
                  'PNL-01,QRY-01,P-001,4.5\n';
                frostquarry.harvest_cycle:
                  'cycle_id,panel_id,cycle_code,started_on,crew_size\n'+
                  'CYC-01,PNL-01,C-001,2026-01-05,6\n';
                frostquarry.ice_block:
                  'block_id,cycle_id,block_code,mass_kg,melt_loss_ratio\n'+
                  'BLK-01,CYC-01,B-001,180,0.25\n'+
                  'BLK-02,CYC-01,B-002,220,0.4\n';
                frostquarry.clarity_grade:
                  'grade_id,block_id,grade_code,clarity_score\n'+
                  'GRD-01,BLK-01,CLEAR,91\n'+
                  'GRD-02,BLK-01,BUBBLED,72\n';
              }#
          ];
          asserts:
          [
            theBlockWithTwoGradesFansOutWhileTheUngradedBlockKeepsOneRowWithNoGrade:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Block":"B-001","Cycle":"C-001","Panel":"P-001","Quarry":"North Firn Quarry","Grade":"BUBBLED"},{"Block":"B-001","Cycle":"C-001","Panel":"P-001","Quarry":"North Firn Quarry","Grade":"CLEAR"},{"Block":"B-002","Cycle":"C-001","Panel":"P-001","Quarry":"North Firn Quarry","Grade":null}]';
                  }#;
              }#
          ];
        }
      ];
    },
    transferChainSuite:
    {
      function: |test::frostedquarry2::domain::TransferRun.all()->project(
        [
          r|$r.runCode,
          r|$r.sled.sledCode,
          r|$r.coldStore.storeCode,
          r|$r.coldStore.storeName
        ],
        [
          'Run',
          'Sled',
          'Store',
          'StoreName'
        ]
      )->sort([asc('Run')]);
      tests:
      [
        bothEndsOfTheTransferChainResolveFromTheRunSide:
        {
          data:
          [
            test::frostedquarry2::store::FrostQuarryDB:
              Relational
              #{
                frostquarry.haul_sled:
                  'sled_id,sled_code,capacity_kg\n'+
                  'SLD-01,S-001,900\n';
                frostquarry.transfer_run:
                  'run_id,sled_id,store_id,run_code,run_date\n'+
                  'RUN-01,SLD-01,STR-01,R-001,2026-01-06\n'+
                  'RUN-02,SLD-01,STR-09,R-002,2026-01-07\n';
                frostquarry.cold_store:
                  'store_id,store_code,store_name,holding_temp_c\n'+
                  'STR-01,CS-001,Firn Vault,-18.5\n';
              }#
          ];
          asserts:
          [
            theRunPointingAtAnAbsentColdStoreKeepsItsRowWithEmptyStoreColumns:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Run":"R-001","Sled":"S-001","Store":"CS-001","StoreName":"Firn Vault"},{"Run":"R-002","Sled":"S-001","Store":null,"StoreName":null}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
