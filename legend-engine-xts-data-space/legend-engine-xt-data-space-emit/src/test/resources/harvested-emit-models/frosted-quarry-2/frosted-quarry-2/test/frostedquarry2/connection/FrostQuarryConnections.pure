###Connection
RelationalDatabaseConnection test::frostedquarry2::connection::FrostQuarryConnection
{
  store: test::frostedquarry2::store::FrostQuarryDB;
  type: MemSQL;
  specification: Static
  {
    name: 'frost_quarry_register';
    host: 'example-frost-quarry-host';
    port: 3306;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'frostquarryprincipal';
  };
}
