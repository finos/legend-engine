###Connection
RelationalDatabaseConnection test::indigogecko2::connection::ToolshareWarehouseConnection
{
  store: test::indigogecko2::store::ToolshareStore;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'EXAMPLE_INDIGO_GECKO_DB';
    account: 'example_indigo_gecko_account';
    warehouse: 'EXAMPLE_INDIGO_GECKO_WH';
    region: 'us-east-2';
    cloudType: 'aws';
    role: 'EXAMPLE_INDIGO_GECKO_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'EXAMPLE_INDIGO_GECKO_USER';
    privateKeyVaultReference: 'example-indigo-gecko-private-key';
    passPhraseVaultReference: 'example-indigo-gecko-passphrase';
  };
}

RelationalDatabaseConnection test::indigogecko2::connection::ToolshareBenchConnection
{
  store: test::indigogecko2::store::ToolshareStore;
  type: H2;
  specification: LocalH2 { testDataSetupSqls: []; };
  auth: DefaultH2;
}
