###Relational
Database test::indigogecko2::store::ToolshareStore
(
  Schema toolshare
  (
    Table checkout
    (
      checkout_code VARCHAR(8) PRIMARY KEY,
      period VARCHAR(7),
      status_code VARCHAR(8),
      tool_code VARCHAR(16),
      member_code VARCHAR(8),
      wear_points DOUBLE,
      setup_points DOUBLE,
      taken_on DATE,
      due_on DATE,
      returned_on DATE,
      minutes_used INTEGER,
      wear_grade VARCHAR(2)
    )
    Table member
    (
      member_code VARCHAR(8) PRIMARY KEY,
      member_name VARCHAR(40),
      workshop_code VARCHAR(8)
    )
    Table workshop
    (
      workshop_code VARCHAR(8) PRIMARY KEY,
      workshop_name VARCHAR(40),
      steward_code VARCHAR(8)
    )
    Table steward
    (
      steward_code VARCHAR(8) PRIMARY KEY,
      steward_name VARCHAR(40)
    )
    Table tool
    (
      tool_code VARCHAR(16) PRIMARY KEY,
      tool_name VARCHAR(40),
      supplier_code VARCHAR(8)
    )
    Table supplier
    (
      supplier_code VARCHAR(8) PRIMARY KEY,
      supplier_name VARCHAR(40)
    )
    Table checkout_tag
    (
      checkout_code VARCHAR(8) PRIMARY KEY,
      tag_code VARCHAR(12) PRIMARY KEY
    )
  )

  Filter LiveCheckouts(toolshare.checkout.status_code <> 'VOID')

  Join Checkout_Member(toolshare.checkout.member_code = toolshare.member.member_code)
  Join Member_Workshop(toolshare.member.workshop_code = toolshare.workshop.workshop_code)
  Join Workshop_Steward(toolshare.workshop.steward_code = toolshare.steward.steward_code)
  Join Checkout_Tool(toolshare.checkout.tool_code = toolshare.tool.tool_code)
  Join Tool_Supplier(toolshare.tool.supplier_code = toolshare.supplier.supplier_code)
  Join Checkout_Tag(toolshare.checkout.checkout_code = toolshare.checkout_tag.checkout_code)
)
