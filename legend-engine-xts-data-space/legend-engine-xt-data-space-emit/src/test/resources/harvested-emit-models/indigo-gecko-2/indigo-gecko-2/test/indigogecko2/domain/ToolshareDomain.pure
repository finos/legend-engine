###Pure
import meta::pure::profiles::*;
import test::indigogecko2::domain::*;

Enum {doc.doc = 'The toolshare state of a tool checkout, translated from the desk status code.'} test::indigogecko2::domain::CheckoutState
{
  CHECKED_OUT,
  RETURNED,
  OVERDUE,
  MISSING
}

Class {doc.doc = 'One checkout of a shared tool to a maker-space member for a monthly sharing period.'} test::indigogecko2::domain::ToolCheckout
{
  checkoutCode: String[1];
  period: String[1];
  statusCode: String[1];
  toolCode: String[1];
  wearPoints: Float[0..1];
  setupPoints: Float[0..1];
  takenOn: StrictDate[1];
  dueOn: StrictDate[0..1];
  returnedOn: StrictDate[0..1];
  state: CheckoutState[0..1];
  statusLabel: String[0..1];
  usage: UsageReading[1];
  member: Member[0..1];
  tool: Tool[0..1];
  tags: CheckoutTag[*];
  totalPoints() {$this.wearPoints->toOne() + $this.setupPoints->toOne()}: Float[1];
}

Class {doc.doc = 'Usage reading taken when a checkout is checked: minutes used and wear grade, stored on the checkout row.'} test::indigogecko2::domain::UsageReading
{
  minutesUsed: Integer[0..1];
  wearGrade: String[0..1];
}

Class {doc.doc = 'A maker-space member, attached to a home workshop bench.'} test::indigogecko2::domain::Member
{
  memberCode: String[1];
  memberName: String[0..1];
  workshop: Workshop[0..1];
}

Class {doc.doc = 'A workshop bench grouping members, overseen by a steward.'} test::indigogecko2::domain::Workshop
{
  workshopCode: String[1];
  workshopName: String[0..1];
  steward: Steward[0..1];
}

Class {doc.doc = 'The steward overseeing a workshop bench.'} test::indigogecko2::domain::Steward
{
  stewardCode: String[1];
  stewardName: String[0..1];
}

Class {doc.doc = 'A shared tool in the toolshare pool, bought from a supplier.'} test::indigogecko2::domain::Tool
{
  toolCode: String[1];
  toolName: String[0..1];
  supplier: Supplier[0..1];
}

Class {doc.doc = 'The supplier a toolshare-pool tool was bought from.'} test::indigogecko2::domain::Supplier
{
  supplierCode: String[1];
  supplierName: String[0..1];
}

Class {doc.doc = 'A desk tag attached to a checkout.'} test::indigogecko2::domain::CheckoutTag
{
  tagCode: String[1];
}
