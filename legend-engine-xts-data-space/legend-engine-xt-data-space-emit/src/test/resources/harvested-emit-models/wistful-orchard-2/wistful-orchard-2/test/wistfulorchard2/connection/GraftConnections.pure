###Connection
RelationalDatabaseConnection test::wistfulorchard2::connection::GroveRegisterConnection
{
  store: test::wistfulorchard2::store::GraftRegisterStore;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'GROVE_REGISTER_DB';
    account: 'grove_register_account';
    warehouse: 'GROVE_WH';
    region: 'eu-west-2';
  };
  auth: OAuth
  {
    oauthKey: 'GROVE_OAUTH';
    scopeName: 'SESSION:ROLE:GROVE_ROLE';
  };
}
