###DataSpace
DataSpace test::wistfulorchard2::dataspace::GroveRegisterDataSpace
{
  executionContexts:
  [
    {
      name: 'register';
      description: 'Register environment - the graft run register served through the grove warehouse.';
      mapping: test::wistfulorchard2::mapping::GraftMapping;
      defaultRuntime: test::wistfulorchard2::runtime::GroveRegisterRuntime;
    }
  ];
  defaultExecutionContext: 'register';
  title: 'Wistful Orchard Graft Register';
  description: 'Discovery surface over the orchard graft register: the milestoned graft runs, their banded scion grades and the tray journal totals behind them.';
  elements:
  [
    test::wistfulorchard2::domain::GraftRun,
    test::wistfulorchard2::domain::GroveJournal
  ];
}
