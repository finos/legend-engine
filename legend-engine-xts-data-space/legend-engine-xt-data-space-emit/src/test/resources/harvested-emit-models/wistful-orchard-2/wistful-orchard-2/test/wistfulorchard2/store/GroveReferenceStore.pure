###Relational
Database test::wistfulorchard2::store::GroveReferenceStore
(
  Schema grove
  (
    Table scion_grade
    (
      grade_code VARCHAR(16) PRIMARY KEY,
      grade_label VARCHAR(64) NOT NULL,
      plot_code VARCHAR(16) NOT NULL
    )

    Table grove_plot
    (
      plot_code VARCHAR(16) PRIMARY KEY,
      plot_name VARCHAR(64) NOT NULL,
      orchard_code VARCHAR(16) NOT NULL,
      canopy_flag VARCHAR(16) NOT NULL
    )

    Table orchard_house
    (
      orchard_code VARCHAR(16) PRIMARY KEY,
      orchard_name VARCHAR(64) NOT NULL
    )

    Table house_warden
    (
      orchard_code VARCHAR(16) PRIMARY KEY,
      warden_name VARCHAR(64) NOT NULL
    )

    Table warden_post
    (
      warden_name VARCHAR(64) PRIMARY KEY,
      post_name VARCHAR(64) NOT NULL
    )
  )

  Join Grade_Plot(grove.scion_grade.plot_code = grove.grove_plot.plot_code)
  Join Plot_Orchard(grove.grove_plot.orchard_code = grove.orchard_house.orchard_code)
  Join Orchard_Warden(grove.orchard_house.orchard_code = grove.house_warden.orchard_code)
  Join Warden_Post(grove.house_warden.warden_name = grove.warden_post.warden_name)
)
