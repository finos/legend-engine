###Connection
RelationalDatabaseConnection test::goldenotter9::connection::SanctuaryWarehouseConnection
{
  store: test::goldenotter9::store::OtterSanctuaryDb;
  type: Snowflake;
  quoteIdentifiers: false;
  specification: Snowflake
  {
    name: 'GOLDEN_OTTER_SANCTUARY_DB';
    account: 'golden_otter_account';
    warehouse: 'GOLDEN_OTTER_WH';
    region: 'eu-west-1';
    cloudType: 'aws';
    role: 'OTTER_SANCTUARY_READER';
  };
  auth: OAuth
  {
    oauthKey: 'goldenOtterOauthKey';
    scopeName: 'session:role:OTTER_SANCTUARY_READER';
  };
}
