###Service
Service test::goldenotter9::service::ProtectedOccupiedHolts
{
  pattern: '/goldenotter9/v1/holts/protected-occupied';
  title: 'Otter Sanctuary - Protected Occupied Holts';
  ownership: DID { identifier: '000000' };
  documentation: 'Lists the protected holts that have at least one sighting of two or more animals, combining a boolean equality with an existence test over the to-many sightings.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |test::goldenotter9::domain::Holt.all()->filter(
      h|($h.isProtected == true) && $h.sightings->exists(s|$s.headCount >= 2)
    )->project(
      [
        h|$h.holtCode,
        h|$h.holtName,
        h|$h.entranceCount
      ],
      [
        'HoltCode',
        'HoltName',
        'Entrances'
      ]
    )->sort([asc('HoltCode')]);
    mapping: test::goldenotter9::mapping::SanctuaryMapping;
    runtime: test::goldenotter9::runtime::SanctuaryRuntime;
  }
  testSuites:
  [
    protectedOccupiedHoltsSuite:
    {
      data:
      [
        connections:
        [
          sanctuaryWarehouse:
            Reference
            #{
              test::goldenotter9::data::SanctuaryFixture
            }#
        ]
      ]
      tests:
      [
        protectedWithPairs:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            twoOccupiedHolts:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"HoltCode":"HT-1","HoltName":"Alder Holt","Entrances":4},{"HoltCode":"HT-3","HoltName":"Root Holt","Entrances":2}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
