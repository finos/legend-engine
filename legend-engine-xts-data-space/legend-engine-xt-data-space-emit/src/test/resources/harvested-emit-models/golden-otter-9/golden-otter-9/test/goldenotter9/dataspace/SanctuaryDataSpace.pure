###DataSpace
DataSpace test::goldenotter9::dataspace::SanctuaryDataSpace
{
  executionContexts:
  [
    {
      name: 'sanctuaryWarehouse';
      description: 'The aggregate sanctuary mapping over the warehouse connection.';
      mapping: test::goldenotter9::mapping::SanctuaryMapping;
      defaultRuntime: test::goldenotter9::runtime::SanctuaryRuntime;
    }
  ];
  defaultExecutionContext: 'sanctuaryWarehouse';
  title: 'Golden Otter Sanctuary Register';
  description: 'A governed entry point over the river otter sanctuary - reaches and habitats, holts and their keepers, and the sightings recorded by the watch teams.';
  diagrams:
  [
    {
      title: 'Reaches, Holts, Sightings And Observers';
      diagram: test::goldenotter9::diagram::SanctuaryDiagram;
    }
  ];
  executables:
  [
    {
      id: 1;
      title: 'Tamar Holt Roster';
      executable: test::goldenotter9::service::TamarHoltRoster;
    },
    {
      id: 2;
      title: 'Monthly Sighting Tally';
      executable: test::goldenotter9::service::MonthlySightingTally;
    },
    {
      id: 3;
      title: 'Observer Monthly Effort';
      executable: test::goldenotter9::service::ObserverMonthlyEffort;
    },
    {
      id: 4;
      title: 'Protected Occupied Holts';
      executable: test::goldenotter9::service::ProtectedOccupiedHolts;
    },
    {
      id: 5;
      title: 'Watched Reaches';
      executable: test::goldenotter9::service::WatchedReaches;
    },
    {
      id: 6;
      title: 'Reedbed Watch Teams';
      executable: test::goldenotter9::service::ReedbedWatchTeams;
    },
    {
      id: 7;
      title: 'Latest Holt Observers';
      executable: test::goldenotter9::service::LatestHoltObservers;
    }
  ];
  supportInfo: Email
  {
    address: 'sanctuary-watch-desk';
  };
}
