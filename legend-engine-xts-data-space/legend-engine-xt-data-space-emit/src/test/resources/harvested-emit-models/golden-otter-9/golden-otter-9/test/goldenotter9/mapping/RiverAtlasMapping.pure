###Mapping
Mapping test::goldenotter9::mapping::RiverAtlasMapping
(
  *test::goldenotter9::domain::RiverReach[reach]: Relational
  {
    ~primaryKey
    (
      [test::goldenotter9::store::RiverAtlasDb]atlas.river_reach.reach_code
    )
    ~mainTable [test::goldenotter9::store::RiverAtlasDb]atlas.river_reach
    reachCode: [test::goldenotter9::store::RiverAtlasDb]atlas.river_reach.reach_code,
    reachName: trim([test::goldenotter9::store::RiverAtlasDb]atlas.river_reach.reach_name),
    catchmentName: [test::goldenotter9::store::RiverAtlasDb]atlas.river_reach.catchment_name,
    reachTag: concat(toUpper(trim([test::goldenotter9::store::RiverAtlasDb]atlas.river_reach.catchment_name)), '/', [test::goldenotter9::store::RiverAtlasDb]atlas.river_reach.reach_code),
    flowBand: case(
      isNull([test::goldenotter9::store::RiverAtlasDb]atlas.river_reach.flow_class),
      'UNRATED',
      case(
        equal(toUpper(trim([test::goldenotter9::store::RiverAtlasDb]atlas.river_reach.flow_class)), 'F'),
        'FAST',
        case(
          equal(toUpper(trim([test::goldenotter9::store::RiverAtlasDb]atlas.river_reach.flow_class)), 'M'),
          'MODERATE',
          case(
            equal(toUpper(trim([test::goldenotter9::store::RiverAtlasDb]atlas.river_reach.flow_class)), 'S'),
            'SLOW',
            'UNRATED'
          )
        )
      )
    )
  }
)
