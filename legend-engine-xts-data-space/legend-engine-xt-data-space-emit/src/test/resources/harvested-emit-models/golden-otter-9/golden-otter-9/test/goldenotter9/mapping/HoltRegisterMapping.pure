###Mapping
Mapping test::goldenotter9::mapping::HoltRegisterMapping
(
  *test::goldenotter9::domain::Holt[holt]: Relational
  {
    ~primaryKey
    (
      [test::goldenotter9::store::HoltRegisterDb]holt.holt.holt_code
    )
    ~mainTable [test::goldenotter9::store::HoltRegisterDb]holt.holt
    holtCode: [test::goldenotter9::store::HoltRegisterDb]holt.holt.holt_code,
    holtName: [test::goldenotter9::store::HoltRegisterDb]holt.holt.holt_name,
    isProtected: equal([test::goldenotter9::store::HoltRegisterDb]holt.holt.protected_flag, 1),
    entranceCount: [test::goldenotter9::store::HoltRegisterDb]holt.holt.entrance_count,
    sizeBand: case(
      greaterThan([test::goldenotter9::store::HoltRegisterDb]holt.holt.entrance_count, 3),
      'LARGE',
      case(
        greaterThan([test::goldenotter9::store::HoltRegisterDb]holt.holt.entrance_count, 1),
        'MEDIUM',
        'SINGLE'
      )
    )
  }

  *test::goldenotter9::domain::Habitat[habitat]: Relational
  {
    ~primaryKey
    (
      [test::goldenotter9::store::HoltRegisterDb]holt.habitat.habitat_code
    )
    ~mainTable [test::goldenotter9::store::HoltRegisterDb]holt.habitat
    habitatCode: [test::goldenotter9::store::HoltRegisterDb]holt.habitat.habitat_code,
    habitatLabel: [test::goldenotter9::store::HoltRegisterDb]holt.habitat.habitat_label
  }
)
