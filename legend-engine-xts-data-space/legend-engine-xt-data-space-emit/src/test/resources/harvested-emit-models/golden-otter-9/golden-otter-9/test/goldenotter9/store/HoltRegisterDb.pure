###Relational
Database test::goldenotter9::store::HoltRegisterDb
(
  Schema holt
  (
    Table holt
    (
      holt_code VARCHAR(8) PRIMARY KEY,
      reach_code VARCHAR(8),
      warden_code VARCHAR(8),
      holt_name VARCHAR(48) NOT NULL,
      protected_flag INTEGER,
      entrance_count INTEGER
    )
    Table habitat
    (
      habitat_code VARCHAR(6) PRIMARY KEY,
      habitat_label VARCHAR(32)
    )
  )
)
