###Mapping
Mapping test::goldenotter9::mapping::KeeperMapping
(
  *test::goldenotter9::domain::Observer[observer]: Relational
  {
    ~primaryKey
    (
      [test::goldenotter9::store::KeeperDb]staff.observer.observer_code
    )
    ~mainTable [test::goldenotter9::store::KeeperDb]staff.observer
    observerCode: [test::goldenotter9::store::KeeperDb]staff.observer.observer_code,
    observerName: [test::goldenotter9::store::KeeperDb]staff.observer.observer_name,
    teamName: [test::goldenotter9::store::KeeperDb]staff.observer.team_name,
    gradeLabel: case(
      equal([test::goldenotter9::store::KeeperDb]staff.observer.grade_code, 'S'),
      'SENIOR',
      case(
        equal([test::goldenotter9::store::KeeperDb]staff.observer.grade_code, 'V'),
        'VOLUNTEER',
        'RANGER'
      )
    )
  }
)
