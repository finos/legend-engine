###Service
Service test::goldenotter9::service::ReedbedWatchTeams
{
  pattern: '/goldenotter9/v1/teams/reedbed';
  title: 'Otter Sanctuary - Reedbed Watch Teams';
  ownership: DID { identifier: '000000' };
  documentation: 'Projects the observer team and the habitat reached three hops away for every sighting, keeps the projected rows whose habitat is reedbed and deduplicates them.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |test::goldenotter9::domain::Sighting.all()->project(
      [
        s|$s.observer.teamName,
        s|$s.holt.reach.habitat.habitatLabel
      ],
      [
        'Team',
        'Habitat'
      ]
    )->filter(
      r|$r.getString('Habitat') == 'Reedbed'
    )->distinct()->sort([asc('Team')]);
    mapping: test::goldenotter9::mapping::SanctuaryMapping;
    runtime: test::goldenotter9::runtime::SanctuaryRuntime;
  }
  testSuites:
  [
    reedbedWatchTeamsSuite:
    {
      data:
      [
        connections:
        [
          sanctuaryWarehouse:
            Reference
            #{
              test::goldenotter9::data::SanctuaryFixture
            }#
        ]
      ]
      tests:
      [
        reedbedTeams:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            bothTeamsOnReedbed:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Team":"North Watch","Habitat":"Reedbed"},{"Team":"South Watch","Habitat":"Reedbed"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
