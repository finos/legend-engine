###Mapping
Mapping test::goldenotter9::mapping::SurveyMapping
(
  *test::goldenotter9::domain::Sighting[sighting]: Relational
  {
    ~primaryKey
    (
      [test::goldenotter9::store::SurveyDb]survey.sighting.sighting_code
    )
    ~mainTable [test::goldenotter9::store::SurveyDb]survey.sighting
    sightingCode: [test::goldenotter9::store::SurveyDb]survey.sighting.sighting_code,
    periodMonth: [test::goldenotter9::store::SurveyDb]survey.sighting.period_month,
    periodYear: [test::goldenotter9::store::SurveyDb]survey.sighting.period_year,
    periodKey: concat(toString([test::goldenotter9::store::SurveyDb]survey.sighting.period_year), '-', toString([test::goldenotter9::store::SurveyDb]survey.sighting.period_month)),
    headCount: [test::goldenotter9::store::SurveyDb]survey.sighting.head_count,
    statusCode: [test::goldenotter9::store::SurveyDb]survey.sighting.status_code,
    isLatest: equal([test::goldenotter9::store::SurveyDb]survey.sighting.latest_flag, 1)
  }
)
