###Service
Service test::goldenotter9::service::WatchedReaches
{
  pattern: '/goldenotter9/v1/reaches/watched';
  title: 'Otter Sanctuary - Watched Reaches';
  ownership: DID { identifier: '000000' };
  documentation: 'Lists the reaches holding at least one holt that has any sighting, nesting a non-empty test inside an existence test over two to-many hops, and deduplicates the rows.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |test::goldenotter9::domain::RiverReach.all()->filter(
      r|$r.holts->exists(h|$h.sightings->isNotEmpty())
    )->project(
      [
        r|$r.reachCode,
        r|$r.reachName,
        r|$r.catchmentName,
        r|$r.flowBand
      ],
      [
        'Reach',
        'Name',
        'Catchment',
        'Flow'
      ]
    )->distinct()->sort([asc('Reach')]);
    mapping: test::goldenotter9::mapping::SanctuaryMapping;
    runtime: test::goldenotter9::runtime::SanctuaryRuntime;
  }
  testSuites:
  [
    watchedReachesSuite:
    {
      data:
      [
        connections:
        [
          sanctuaryWarehouse:
            Reference
            #{
              test::goldenotter9::data::SanctuaryFixture
            }#
        ]
      ]
      tests:
      [
        reachesWithSightedHolts:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            twoWatchedReaches:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Reach":"RR-1","Name":"Tamar Upper","Catchment":"Tamar","Flow":"FAST"},{"Reach":"RR-2","Name":"Wye Middle","Catchment":"Wye","Flow":"MODERATE"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
