###Service
Service test::goldenotter9::service::ObserverMonthlyEffort
{
  pattern: '/goldenotter9/v1/observers/{year}/{month}';
  title: 'Otter Sanctuary - Observer Monthly Effort';
  ownership: DID { identifier: '000000' };
  documentation: 'Reports the observers who recorded sightings in one survey month with their grade and the head count of each sighting, using month and year parameters.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {month: Integer[1], year: Integer[1]|test::goldenotter9::domain::Sighting.all()->filter(
      s|($s.periodMonth == $month) && ($s.periodYear == $year)
    )->project(
      [
        s|$s.observer.observerName,
        s|$s.observer.gradeLabel,
        s|$s.holt.holtCode,
        s|$s.headCount
      ],
      [
        'Observer',
        'Grade',
        'Holt',
        'Head'
      ]
    )->sort([asc('Observer'), asc('Holt')])};
    mapping: test::goldenotter9::mapping::SanctuaryMapping;
    runtime: test::goldenotter9::runtime::SanctuaryRuntime;
  }
  testSuites:
  [
    observerMonthlyEffortSuite:
    {
      data:
      [
        connections:
        [
          sanctuaryWarehouse:
            Reference
            #{
              test::goldenotter9::data::SanctuaryFixture
            }#
        ]
      ]
      tests:
      [
        juneEffort:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            month = 6,
            year = 2026
          ]
          asserts:
          [
            threeObserversInJune:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Observer":"Liv Penn","Grade":"RANGER","Holt":"HT-1","Head":2},{"Observer":"Tom Vale","Grade":"VOLUNTEER","Holt":"HT-2","Head":1},{"Observer":"Tom Vale","Grade":"VOLUNTEER","Holt":"HT-3","Head":1}]';
                  }#;
              }#
          ]
        },
        mayEffort:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            month = 5,
            year = 2026
          ]
          asserts:
          [
            oneObserverInMay:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Observer":"Ana Rees","Grade":"SENIOR","Holt":"HT-1","Head":3}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
