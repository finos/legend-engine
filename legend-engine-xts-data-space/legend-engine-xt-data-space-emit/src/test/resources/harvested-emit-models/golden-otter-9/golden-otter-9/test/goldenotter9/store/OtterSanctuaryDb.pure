###Relational
Database test::goldenotter9::store::OtterSanctuaryDb
(
  include test::goldenotter9::store::RiverAtlasDb
  include test::goldenotter9::store::HoltRegisterDb
  include test::goldenotter9::store::SurveyDb
  include test::goldenotter9::store::KeeperDb

  Join Reach_Habitat(atlas.river_reach.habitat_code = holt.habitat.habitat_code)
  Join Holt_Reach(holt.holt.reach_code = atlas.river_reach.reach_code)
  Join Holt_Warden(holt.holt.warden_code = staff.observer.observer_code)
  Join Sighting_Holt(survey.sighting.holt_code = holt.holt.holt_code)
  Join Sighting_Observer(survey.sighting.observer_code = staff.observer.observer_code)
)
