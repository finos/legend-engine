###Connection
RelationalDatabaseConnection test::crimsonridge::connection::CityH2Connection
{
  store: test::crimsonridge::store::CityDatabase;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists city;',
      'create schema city;',
      'create table city.district (district_id integer primary key, district_code varchar(16) not null, district_name varchar(200) not null, planner_count integer not null);',
      'create table city.neighborhood (neighborhood_id integer primary key, neighborhood_code varchar(16) not null, neighborhood_name varchar(200) not null, resident_count integer not null, district_id integer not null);',
      'create table city.park (park_id integer primary key, park_code varchar(16) not null, park_name varchar(200) not null, category_code varchar(4) not null, area_hectares double not null, opened_on date not null, fenced_flag boolean not null, neighborhood_id integer not null);',
      'create table city.transit_stop (stop_id integer primary key, stop_code varchar(16) not null, stop_name varchar(200) not null, shelter_seats integer not null, neighborhood_id integer not null);',
      'create table city.amenity (amenity_id integer primary key, amenity_code varchar(16) not null, amenity_kind varchar(80) not null, installed_on date not null, park_id integer not null);',
      'create table city.crew (crew_id integer primary key, crew_code varchar(16) not null, crew_name varchar(200) not null, headcount integer not null, district_id integer not null);'
      ];
  };
  auth: DefaultH2;
}
