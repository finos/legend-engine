###Mapping
Mapping test::crimsonridge::mapping::NeighborhoodMapping
(
  *test::crimsonridge::domain::District[district]: Relational
  {
    ~primaryKey
    (
      [test::crimsonridge::store::CityDatabase]city.district.district_id
    )
    ~mainTable [test::crimsonridge::store::CityDatabase]city.district
    code: [test::crimsonridge::store::CityDatabase]city.district.district_code,
    name: [test::crimsonridge::store::CityDatabase]city.district.district_name,
    plannerCount: [test::crimsonridge::store::CityDatabase]city.district.planner_count
  }

  *test::crimsonridge::domain::Neighborhood[neighborhood]: Relational
  {
    ~primaryKey
    (
      [test::crimsonridge::store::CityDatabase]city.neighborhood.neighborhood_id
    )
    ~mainTable [test::crimsonridge::store::CityDatabase]city.neighborhood
    code: [test::crimsonridge::store::CityDatabase]city.neighborhood.neighborhood_code,
    name: [test::crimsonridge::store::CityDatabase]city.neighborhood.neighborhood_name,
    residentCount: [test::crimsonridge::store::CityDatabase]city.neighborhood.resident_count
  }

  test::crimsonridge::domain::DistrictNeighborhoods: Relational
  {
    AssociationMapping
    (
      district[neighborhood,district]: [test::crimsonridge::store::CityDatabase]@Neighborhood_District,
      neighborhoods[district,neighborhood]: [test::crimsonridge::store::CityDatabase]@Neighborhood_District
    )
  }

  testSuites:
  [
    testSuite_District:
    {
      function: |test::crimsonridge::domain::District.all()->project(
        [
          x|$x.code,
          x|$x.name,
          x|$x.plannerCount
        ],
        [
          'Code',
          'Name',
          'Planners'
        ]
      );
      tests:
      [
        allDistricts:
        {
          data:
          [
            test::crimsonridge::store::CityDatabase: Reference
              #{
                test::crimsonridge::data::CityFixture
              }#
          ];
          asserts:
          [
            bothDistricts: EqualToJson
              #{
                expected: ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Code":"D-N","Name":"Northgate","Planners":4},{"Code":"D-S","Name":"Southbank","Planners":3}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
