###Pure
import test::crimsonridge::domain::*;

Enum {meta::pure::profiles::doc.doc = 'Planning category assigned to a public green space.'} test::crimsonridge::domain::ParkCategory
{
  POCKET,
  COMMUNITY,
  REGIONAL
}

Class {meta::pure::profiles::doc.doc = 'An administrative planning district.'} test::crimsonridge::domain::District
{
  code: String[1];
  name: String[1];
  plannerCount: Integer[1];
}

Class {meta::pure::profiles::doc.doc = 'A neighborhood inside a planning district.'} test::crimsonridge::domain::Neighborhood
{
  code: String[1];
  name: String[1];
  residentCount: Integer[1];
}

Class {meta::pure::profiles::doc.doc = 'A public green space managed by the city.'} test::crimsonridge::domain::Park
{
  code: String[1];
  name: String[1];
  category: ParkCategory[1];
  areaHectares: Float[1];
  openedOn: StrictDate[1];
  fenced: Boolean[1];
}

Class {meta::pure::profiles::doc.doc = 'A surface transit stop serving a neighborhood.'} test::crimsonridge::domain::TransitStop
{
  code: String[1];
  name: String[1];
  shelterSeats: Integer[1];
}

Class {meta::pure::profiles::doc.doc = 'A built amenity installed inside a park.'} test::crimsonridge::domain::Amenity
{
  code: String[1];
  kind: String[1];
  installedOn: StrictDate[1];
}

Class {meta::pure::profiles::doc.doc = 'A grounds-maintenance crew assigned to a district.'} test::crimsonridge::domain::MaintenanceCrew
{
  code: String[1];
  crewName: String[1];
  headcount: Integer[1];
}

Association test::crimsonridge::domain::DistrictNeighborhoods
{
  district: District[1];
  neighborhoods: Neighborhood[*];
}

Association test::crimsonridge::domain::NeighborhoodParks
{
  parkNeighborhood: Neighborhood[1];
  parks: Park[*];
}

Association test::crimsonridge::domain::NeighborhoodStops
{
  stopNeighborhood: Neighborhood[1];
  transitStops: TransitStop[*];
}

Association test::crimsonridge::domain::ParkAmenities
{
  amenityPark: Park[1];
  amenities: Amenity[*];
}

Association test::crimsonridge::domain::DistrictCrews
{
  crewDistrict: District[1];
  crews: MaintenanceCrew[*];
}
