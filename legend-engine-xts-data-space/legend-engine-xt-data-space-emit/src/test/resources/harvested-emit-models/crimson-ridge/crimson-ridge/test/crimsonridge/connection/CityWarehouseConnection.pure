###Connection
RelationalDatabaseConnection test::crimsonridge::connection::CityWarehouseConnection
{
  store: test::crimsonridge::store::CityDatabase;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'CITY_GREENING_DB';
    account: 'city_planning_account';
    warehouse: 'CITY_GREENING_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    role: 'CITY_PLANNING_ROLE';
  };
  auth: OAuth
  {
    scopeName: 'session:role-city-planning';
    oauthKey: 'cityPlanningOauthKey';
  };
}
