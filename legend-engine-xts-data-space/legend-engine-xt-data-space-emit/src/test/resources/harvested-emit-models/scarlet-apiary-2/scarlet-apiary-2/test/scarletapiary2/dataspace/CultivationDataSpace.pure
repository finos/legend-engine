###DataSpace
DataSpace test::scarletapiary2::dataspace::CultivationDataSpace
{
  executionContexts:
  [
    {
      name: 'lab';
      description: 'Cultivation lab environment - the banded substrate blocks served through the lab warehouse.';
      mapping: test::scarletapiary2::mapping::CultivationMapping;
      defaultRuntime: test::scarletapiary2::runtime::CultivationRuntime;
    }
  ];
  defaultExecutionContext: 'lab';
  title: 'Scarlet Cultivation Lab Blocks';
  description: 'Discovery surface over the mushroom cultivation lab: banded substrate blocks with their fruiting room, strain reference and picked flushes.';
  elements:
  [
    test::scarletapiary2::domain::SubstrateBlock,
    test::scarletapiary2::domain::FruitingRoom,
    test::scarletapiary2::domain::MushroomStrain,
    test::scarletapiary2::domain::FlushHarvest
  ];
  supportInfo: Email
  {
    address: 'cultivation-lab-desk@scarletcultivation.invalid';
  };
}
