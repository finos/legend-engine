###Relational
Database test::scarletapiary2::store::CultivationDb
(
  Schema lab
  (
    Table substrate_block
    (
      block_code VARCHAR(24) PRIMARY KEY,
      room_code VARCHAR(24),
      strain_code VARCHAR(24),
      inoculated_date DATE,
      received_date DATE,
      block_mass_kg DOUBLE,
      moisture_pct DOUBLE,
      yield_grams DOUBLE,
      humidity_pct DOUBLE,
      contam_code VARCHAR(12),
      grade_code VARCHAR(8),
      strain_kind VARCHAR(4),
      status_code VARCHAR(4),
      block_note VARCHAR(200)
    )

    Table fruiting_room
    (
      room_code VARCHAR(24) PRIMARY KEY,
      room_name VARCHAR(120) NOT NULL,
      temp_setpoint_c DOUBLE
    )

    Table strain_ref
    (
      strain_code VARCHAR(24) PRIMARY KEY,
      strain_label VARCHAR(120) NOT NULL
    )

    Table flush_record
    (
      flush_code VARCHAR(24) PRIMARY KEY,
      block_code VARCHAR(24) NOT NULL,
      picked_on DATE,
      picked_grams DOUBLE
    )
  )

  Join Block_Room(lab.substrate_block.room_code = lab.fruiting_room.room_code)
  Join Block_Strain(lab.substrate_block.strain_code = lab.strain_ref.strain_code)
  Join Block_Flush(lab.substrate_block.block_code = lab.flush_record.block_code)
)
