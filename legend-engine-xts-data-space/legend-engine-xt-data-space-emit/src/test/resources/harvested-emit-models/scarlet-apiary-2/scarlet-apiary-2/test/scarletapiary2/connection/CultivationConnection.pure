###Connection
RelationalDatabaseConnection test::scarletapiary2::connection::CultivationConnection
{
  store: test::scarletapiary2::store::CultivationDb;
  type: Snowflake;
  timezone: +0000;
  specification: Snowflake
  {
    name: 'SCARLET_CULTIVATION_DB';
    account: 'scarlet_cultivation_account';
    warehouse: 'CULTIVATION_LAB_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    quotedIdentifiersIgnoreCase: false;
    enableQueryTags: false;
    role: 'CULTIVATION_LAB_READER';
  };
  auth: OAuth
  {
    oauthKey: 'CULTIVATION_LAB_OAUTH';
    scopeName: 'SESSION:ROLE:CULTIVATION_LAB_READER';
  };
}
