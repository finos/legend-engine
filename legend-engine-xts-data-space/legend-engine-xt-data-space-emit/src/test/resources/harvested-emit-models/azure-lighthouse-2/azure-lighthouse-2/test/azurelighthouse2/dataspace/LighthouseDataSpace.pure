###DataSpace
DataSpace demo::azurelighthouse2::dataspace::CoastBeaconDataSpace
{
  executionContexts:
  [
    {
      name: 'coastWatch';
      description: 'Coast-watch tier binding the multi-table beacon store to the beacon mapping and the warehouse-backed engine runtime that serves every published endpoint.';
      mapping: demo::azurelighthouse2::mapping::LighthouseMapping;
      defaultRuntime: demo::azurelighthouse2::runtime::LighthouseRuntime;
    }
  ];
  defaultExecutionContext: 'coastWatch';
  title: 'Coast Beacon Network';
  description: 'Catalogued entry point over a stretch of coast: beacon stations, their lamp rotations, keeper rosters, recorded conditions and supply runs, each projected as tabular results through one curated mapping.';
  elements:
  [
    demo::azurelighthouse2::domain
  ];
  executables:
  [
    {
      id: 1;
      title: 'Station classes by coast stretch';
      description: 'The featured endpoint that classifies the beacon stations of one stretch of coast.';
      executable: demo::azurelighthouse2::service::StationClassService;
    },
    {
      id: 2;
      title: 'Lamp rotation watch list';
      description: 'The featured endpoint that turns recorded rotation periods into a flash-rate watch list.';
      executable: demo::azurelighthouse2::service::RotationWatchService;
    }
  ];
  supportInfo: Email
  {
    address: 'coast-beacon-support@example.invalid';
  };
}
