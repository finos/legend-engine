###Connection
RelationalDatabaseConnection demo::azurelighthouse2::connection::LighthouseWarehouseConnection
{
  store: demo::azurelighthouse2::store::LighthouseDatabase;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'COAST_BEACON_DB';
    account: 'coast_beacon_account';
    warehouse: 'COAST_BEACON_WH';
    region: 'eu-west-1';
    cloudType: 'aws';
    role: 'BEACON_READER';
  };
  auth: OAuth
  {
    oauthKey: 'BEACON_OAUTH';
    scopeName: 'SESSION:ROLE:BEACON_READER';
  };
}
