###Relational
Database demo::azurelighthouse2::store::LighthouseDatabase
(
  Schema beacons
  (
    Table lighthouse_station
    (
      station_code VARCHAR(24) PRIMARY KEY,
      station_name VARCHAR(120) NOT NULL,
      coast_zone VARCHAR(40) NOT NULL,
      focal_height_m INTEGER NOT NULL,
      lamp_watts INTEGER NOT NULL
    )

    Table lamp_rotation
    (
      rotation_id VARCHAR(24) PRIMARY KEY,
      station_code VARCHAR(24) NOT NULL,
      flash_pattern VARCHAR(60) NOT NULL,
      rotation_seconds INTEGER NOT NULL
    )

    Table keeper_shift
    (
      shift_id VARCHAR(24) PRIMARY KEY,
      station_code VARCHAR(24) NOT NULL,
      keeper_name VARCHAR(120) NOT NULL,
      shift_hours INTEGER NOT NULL
    )

    Table weather_log
    (
      log_id VARCHAR(24) PRIMARY KEY,
      station_code VARCHAR(24) NOT NULL,
      visibility_km INTEGER NOT NULL,
      wind_knots INTEGER NOT NULL
    )

    Table supply_run
    (
      run_id VARCHAR(24) PRIMARY KEY,
      station_code VARCHAR(24) NOT NULL,
      cargo_kind VARCHAR(60) NOT NULL,
      crate_count INTEGER NOT NULL
    )
  )
)
