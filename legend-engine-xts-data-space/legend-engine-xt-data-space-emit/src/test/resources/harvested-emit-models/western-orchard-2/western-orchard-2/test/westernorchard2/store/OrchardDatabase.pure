###Relational
Database test::westernorchard2::store::OrchardDatabase
(
  Schema grove
  (
    Table orchard_block
    (
      block_code VARCHAR(24) PRIMARY KEY,
      block_name VARCHAR(120) NOT NULL,
      rootstock VARCHAR(40),
      district VARCHAR(60),
      soil_series VARCHAR(60),
      hectares FLOAT NOT NULL,
      elevation_m FLOAT,
      planted_on DATE NOT NULL,
      surveyed_at TIMESTAMP
    )

    Table tree_row
    (
      row_code VARCHAR(24) PRIMARY KEY,
      block_code VARCHAR(24) NOT NULL,
      cultivar VARCHAR(80) NOT NULL,
      trellis_type VARCHAR(40),
      orientation VARCHAR(24),
      spacing_m FLOAT NOT NULL,
      canopy_width_m FLOAT,
      established_on DATE NOT NULL,
      last_pruned_at TIMESTAMP,
      last_scouted_at TIMESTAMP
    )

    Table harvest_pass
    (
      pass_code VARCHAR(24) PRIMARY KEY,
      row_code VARCHAR(24) NOT NULL,
      crew_lead VARCHAR(80),
      grade_label VARCHAR(24),
      pack_house VARCHAR(80),
      bins_filled FLOAT NOT NULL,
      brix_degrees FLOAT,
      firmness_kg FLOAT,
      started_at TIMESTAMP NOT NULL,
      finished_at TIMESTAMP,
      weighed_at TIMESTAMP
    )
  )
)
