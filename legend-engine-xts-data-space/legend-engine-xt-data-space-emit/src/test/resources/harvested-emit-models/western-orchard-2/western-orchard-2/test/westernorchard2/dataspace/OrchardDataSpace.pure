###DataSpace
DataSpace test::westernorchard2::dataspace::OrchardDataSpace
{
  executionContexts:
  [
    {
      name: 'grove';
      description: 'Grove environment - the three planted registers resolved through the orchard mapping and its warehouse runtime.';
      mapping: test::westernorchard2::mapping::OrchardMapping;
      defaultRuntime: test::westernorchard2::runtime::OrchardRuntime;
    }
  ];
  defaultExecutionContext: 'grove';
  title: 'Western Orchard Planted Registers';
  description: 'Curated entry point over the western orchard: the planted block register, the row register behind it and the picking passes taken over those rows, all served from one mapping and runtime pair.';
  elements:
  [
    test::westernorchard2::domain::OrchardBlock
  ];
  supportInfo: Email
  {
    address: 'orchard-register-desk@westernorchard.invalid';
  };
}
