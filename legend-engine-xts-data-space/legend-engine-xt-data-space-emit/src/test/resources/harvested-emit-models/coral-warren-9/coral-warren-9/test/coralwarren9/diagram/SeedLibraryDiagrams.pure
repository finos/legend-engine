###Diagram
Diagram test::coralwarren9::diagram::CatalogueDiagram
{
  classView family
  {
    class: test::coralwarren9::domain::PlantFamily;
    position: (40.0, 40.0);
    rectangle: (220.0, 120.0);
  }
  classView variety
  {
    class: test::coralwarren9::domain::SeedVariety;
    position: (360.0, 40.0);
    rectangle: (220.0, 140.0);
  }
  propertyView
  {
    property: test::coralwarren9::domain::VarietyFamily.family;
    source: variety;
    target: family;
    points: [(470.0, 110.0), (150.0, 100.0)];
  }
}

Diagram test::coralwarren9::diagram::LendingDiagram
{
  classView packet
  {
    class: test::coralwarren9::domain::SeedPacket;
    position: (360.0, 260.0);
    rectangle: (220.0, 140.0);
  }
  classView variety
  {
    class: test::coralwarren9::domain::SeedVariety;
    position: (360.0, 40.0);
    rectangle: (220.0, 140.0);
  }
  classView branch
  {
    class: test::coralwarren9::domain::LibraryBranch;
    position: (40.0, 260.0);
    rectangle: (220.0, 140.0);
  }
  classView gardener
  {
    class: test::coralwarren9::domain::Gardener;
    position: (680.0, 260.0);
    rectangle: (220.0, 120.0);
  }
  propertyView
  {
    property: test::coralwarren9::domain::PacketVariety.variety;
    source: packet;
    target: variety;
    points: [(470.0, 330.0), (470.0, 110.0)];
  }
  propertyView
  {
    property: test::coralwarren9::domain::PacketBranch.branch;
    source: packet;
    target: branch;
    points: [(470.0, 330.0), (150.0, 330.0)];
  }
  propertyView
  {
    property: test::coralwarren9::domain::PacketDonor.donor;
    source: packet;
    target: gardener;
    points: [(470.0, 330.0), (790.0, 320.0)];
  }
}
