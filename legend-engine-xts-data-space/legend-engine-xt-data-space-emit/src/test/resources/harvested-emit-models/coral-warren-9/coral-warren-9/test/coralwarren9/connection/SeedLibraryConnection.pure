###Connection
RelationalDatabaseConnection test::coralwarren9::connection::SeedLibraryWarehouseConnection
{
  store: test::coralwarren9::store::SeedLibraryDb;
  type: Snowflake;
  quoteIdentifiers: false;
  specification: Snowflake
  {
    name: 'CORAL_WARREN_SEED_LIBRARY_DB';
    account: 'coral_warren_seed_account';
    warehouse: 'CORAL_WARREN_SEED_WH';
    region: 'eu-west-2';
    cloudType: 'aws';
    role: 'SEED_LIBRARY_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'SEED_LIBRARY_READER';
    privateKeyVaultReference: 'coralwarren9.privateKey';
    passPhraseVaultReference: 'coralwarren9.passPhrase';
  };
}
