###Service
Service test::coralwarren9::service::FamilyVarieties
{
  pattern: '/coralwarren9/v1/families/{familyCode}/varieties';
  title: 'Seed Library - Family Varieties';
  ownership: DID { identifier: '000000' };
  documentation: 'Lists the varieties of one plant family, matching the family code parameter across the variety to family join before projecting.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {familyCode: String[1]|test::coralwarren9::domain::SeedVariety.all()->filter(
      v|$v.family.familyCode == $familyCode
    )->project(
      [
        v|$v.varietyCode,
        v|$v.varietyLabel,
        v|$v.daysToHarvest
      ],
      [
        'Variety',
        'Label',
        'DaysToHarvest'
      ]
    )->sort([asc('Variety')])};
    mapping: test::coralwarren9::mapping::SeedLibraryMapping;
    runtime: test::coralwarren9::runtime::SeedLibraryRuntime;
  }
  testSuites:
  [
    familyVarietiesSuite:
    {
      data:
      [
        connections:
        [
          seedLibraryWarehouse:
            Reference
            #{
              test::coralwarren9::data::SeedLibraryFixture
            }#
        ]
      ]
      tests:
      [
        brassicaFamily:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            familyCode = 'FM-BR'
          ]
          asserts:
          [
            twoBrassicas:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Variety":"VR-02","Label":"Cavolo Nero","DaysToHarvest":90},{"Variety":"VR-05","Label":"Purple Sprouting Broccoli","DaysToHarvest":220}]';
                  }#;
              }#
          ]
        },
        unknownFamily:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            familyCode = 'FM-XX'
          ]
          asserts:
          [
            noVarieties:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
