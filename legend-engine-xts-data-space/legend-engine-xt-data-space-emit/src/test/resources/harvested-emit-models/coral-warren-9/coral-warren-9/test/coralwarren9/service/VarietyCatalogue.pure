###Service
Service test::coralwarren9::service::VarietyCatalogue
{
  pattern: '/coralwarren9/v1/varieties';
  title: 'Seed Library - Variety Catalogue';
  ownership: DID { identifier: '000000' };
  documentation: 'Lists every catalogued variety with the label of its plant family reached through the variety to family view join.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |test::coralwarren9::domain::SeedVariety.all()->project(
      [
        v|$v.varietyCode,
        v|$v.varietyLabel,
        v|$v.family.familyLabel,
        v|$v.sowSeason
      ],
      [
        'Variety',
        'Label',
        'Family',
        'Season'
      ]
    )->sort([asc('Variety')]);
    mapping: test::coralwarren9::mapping::SeedLibraryMapping;
    runtime: test::coralwarren9::runtime::SeedLibraryRuntime;
  }
  testSuites:
  [
    varietyCatalogueSuite:
    {
      data:
      [
        connections:
        [
          seedLibraryWarehouse:
            Reference
            #{
              test::coralwarren9::data::SeedLibraryFixture
            }#
        ]
      ]
      tests:
      [
        wholeCatalogue:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            fiveVarieties:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Variety":"VR-01","Label":"Red Baron Onion","Family":"Alliums","Season":"SPRING"},{"Variety":"VR-02","Label":"Cavolo Nero","Family":"Brassicas","Season":"SUMMER"},{"Variety":"VR-03","Label":"Painted Lady Bean","Family":"Legumes","Season":"SPRING"},{"Variety":"VR-04","Label":"Gardeners Delight Tomato","Family":"Nightshades","Season":"SPRING"},{"Variety":"VR-05","Label":"Purple Sprouting Broccoli","Family":"Brassicas","Season":"AUTUMN"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
