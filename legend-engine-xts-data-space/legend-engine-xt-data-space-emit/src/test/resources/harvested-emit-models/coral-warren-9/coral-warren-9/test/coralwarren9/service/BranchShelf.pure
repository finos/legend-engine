###Service
Service test::coralwarren9::service::BranchShelf
{
  pattern: '/coralwarren9/v1/branches/{branchCode}/shelf';
  title: 'Seed Library - Branch Shelf';
  ownership: DID { identifier: '000000' };
  documentation: 'Lists the deduplicated shelf of one branch, matching the branch code parameter across the packet to branch join and upper-casing the variety label.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {branchCode: String[1]|test::coralwarren9::domain::SeedPacket.all()->filter(
      p|$p.branch.branchCode == $branchCode
    )->project(
      [
        p|$p.packetCode,
        p|$p.variety.varietyLabel->toUpper(),
        p|$p.branch.branchTag,
        p|$p.gramWeight
      ],
      [
        'Packet',
        'Variety',
        'Branch',
        'Grams'
      ]
    )->distinct()->sort([asc('Packet')])};
    mapping: test::coralwarren9::mapping::SeedLibraryMapping;
    runtime: test::coralwarren9::runtime::SeedLibraryRuntime;
  }
  testSuites:
  [
    branchShelfSuite:
    {
      data:
      [
        connections:
        [
          seedLibraryWarehouse:
            Reference
            #{
              test::coralwarren9::data::SeedLibraryFixture
            }#
        ]
      ]
      tests:
      [
        millbrookShelf:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            branchCode = 'BR-1'
          ]
          asserts:
          [
            threeMillbrookPackets:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Packet":"PK-01","Variety":"RED BARON ONION","Branch":"LIB-BR-1","Grams":12},{"Packet":"PK-02","Variety":"CAVOLO NERO","Branch":"LIB-BR-1","Grams":8},{"Packet":"PK-06","Variety":"PAINTED LADY BEAN","Branch":"LIB-BR-1","Grams":18}]';
                  }#;
              }#
          ]
        },
        quaysideShelf:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            branchCode = 'BR-3'
          ]
          asserts:
          [
            twoQuaysidePackets:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Packet":"PK-04","Variety":"GARDENERS DELIGHT TOMATO","Branch":"LIB-BR-3","Grams":5},{"Packet":"PK-05","Variety":"PURPLE SPROUTING BROCCOLI","Branch":"LIB-BR-3","Grams":10}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
