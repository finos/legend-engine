###DataSpace
DataSpace test::coralwarren9::dataspace::SeedLibraryDataSpace
{
  executionContexts:
  [
    {
      name: 'seedLibraryWarehouse';
      description: 'The seed library mapping over the cloud warehouse connection.';
      mapping: test::coralwarren9::mapping::SeedLibraryMapping;
      defaultRuntime: test::coralwarren9::runtime::SeedLibraryRuntime;
    }
  ];
  defaultExecutionContext: 'seedLibraryWarehouse';
  title: 'Coral Warren Community Seed Library';
  description: 'A governed entry point over the community seed library - the catalogued varieties and their plant families, the branches that shelve donated packets and the gardeners who donate them.';
  diagrams:
  [
    {
      title: 'Varieties And Families';
      diagram: test::coralwarren9::diagram::CatalogueDiagram;
    },
    {
      title: 'Packets, Branches And Donors';
      diagram: test::coralwarren9::diagram::LendingDiagram;
    }
  ];
  executables:
  [
    {
      id: 1;
      title: 'Variety Catalogue';
      executable: test::coralwarren9::service::VarietyCatalogue;
    },
    {
      id: 2;
      title: 'Family Varieties';
      executable: test::coralwarren9::service::FamilyVarieties;
    },
    {
      id: 3;
      title: 'Seasonal Packets';
      executable: test::coralwarren9::service::SeasonalPackets;
    },
    {
      id: 4;
      title: 'Branch Shelf';
      executable: test::coralwarren9::service::BranchShelf;
    }
  ];
}
