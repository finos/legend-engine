###Connection
RelationalDatabaseConnection test::scarletvineyard::connection::NurseryH2Connection
{
  store: test::scarletvineyard::store::NurseryDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists nursery;',
      'create schema nursery;',
      'create table nursery.propagation_bed (bed_id integer primary key, bed_code varchar(16) not null, bed_name varchar(200) not null, bed_area double not null, soil_mix varchar(80) not null);',
      'create table nursery.seedling_lot (lot_id integer primary key, lot_code varchar(16) not null, cultivar varchar(120) not null, seedling_count integer not null, sown_on date not null);'
      ];
  };
  auth: DefaultH2;
}
