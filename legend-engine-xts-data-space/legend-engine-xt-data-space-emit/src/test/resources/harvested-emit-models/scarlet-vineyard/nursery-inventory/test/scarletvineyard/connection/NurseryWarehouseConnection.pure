###Connection
RelationalDatabaseConnection test::scarletvineyard::connection::NurseryWarehouseConnection
{
  store: test::scarletvineyard::store::NurseryDB;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'NURSERY_INVENTORY';
    account: 'nursery_grounds';
    warehouse: 'NURSERY_WH';
    region: 'us-east-1.aws';
  };
  auth: OAuth
  {
    oauthKey: 'nursery-inventory-key';
    scopeName: 'SESSION:ROLE:NURSERY_READER';
  };
}
