###Relational
Database test::scarletvineyard::store::NurseryDB
(
  Schema nursery
  (
    Table propagation_bed
    (
      bed_id INTEGER PRIMARY KEY,
      bed_code VARCHAR(16) NOT NULL,
      bed_name VARCHAR(200) NOT NULL,
      bed_area FLOAT NOT NULL,
      soil_mix VARCHAR(80) NOT NULL
    )
    Table seedling_lot
    (
      lot_id INTEGER PRIMARY KEY,
      lot_code VARCHAR(16) NOT NULL,
      cultivar VARCHAR(120) NOT NULL,
      seedling_count INTEGER NOT NULL,
      sown_on DATE NOT NULL
    )
  )
)
