###Service
Service test::cobaltmarsh::service::BirdTallies
{
  pattern: '/cobaltmarsh/birdTallies';
  owners:
  [
    'wetland-monitoring'
  ];
  documentation: 'Projects bird tallies with the conditional flock-size band covering large, medium, empty and small observations.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |test::cobaltmarsh::domain::BirdCount.all()->project(
      [
        x|$x.countId,
        x|$x.speciesCode,
        x|$x.tally,
        x|$x.flockSize
      ],
      [
        'CountId',
        'Species',
        'Tally',
        'FlockSize'
      ]
    )->sort(
      [
        asc('CountId')
      ]
    );
    mapping: test::cobaltmarsh::mapping::MarshMapping;
    runtime: test::cobaltmarsh::runtime::MarshRuntime;
  }
  testSuites:
  [
    birdTalliesSuite:
    {
      data:
      [
        connections:
        [
          marshConnection:
            Relational
            #{
                marsh.bird_count:
                  'count_id,station_id,species_code,tally,observed_on\n'+
                  'BC-01,ST-01,WADER,140,2024-05-04\n'+
                  'BC-02,ST-02,DUCK,45,2024-05-04\n'+
                  'BC-03,ST-03,EGRET,0,2024-05-05\n'+
                  'BC-04,ST-04,GULL,7,2024-05-05\n';
            }#
        ]
      ]
      tests:
      [
        projectedRows:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            rows:
              EqualToJson
              #{
                expected: ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"CountId":"BC-01","Species":"WADER","Tally":140,"FlockSize":"Large"},{"CountId":"BC-02","Species":"DUCK","Tally":45,"FlockSize":"Medium"},{"CountId":"BC-03","Species":"EGRET","Tally":0,"FlockSize":"None"},{"CountId":"BC-04","Species":"GULL","Tally":7,"FlockSize":"Small"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
