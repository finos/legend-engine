###DataSpace
DataSpace test::cobaltmarsh::dataspace::MarshDataSpace
{
  executionContexts:
  [
    {
      name: 'prod';
      description: 'Production tier - the governed wetland monitoring network.';
      mapping: test::cobaltmarsh::mapping::MarshMapping;
      defaultRuntime: test::cobaltmarsh::runtime::MarshRuntime;
    }
  ];
  defaultExecutionContext: 'prod';
  title: 'Wetland Monitoring Network';
  description: 'A governed entry point over the wetland monitoring domain - stations, water samples, bird tallies and ranger shifts - wiring the relational mapping, runtime and the featured endpoints a consumer should start from.';
  supportInfo: Email {
    address: 'wetland-monitoring@example.invalid';
  };
  executables:
  [
    {
      id: 1;
      title: 'Stations as of a processing date';
      description: 'Featured endpoint projecting the classified stations visible on a requested processing date.';
      executable: test::cobaltmarsh::service::StationHabitats;
    },
    {
      id: 2;
      title: 'Water sample grades';
      description: 'Featured endpoint projecting water samples with their conditional quality band.';
      executable: test::cobaltmarsh::service::SampleGrades;
    }
  ];
}
