###Connection
RelationalDatabaseConnection test::cobaltmarsh::connection::MarshConnection
{
  store: test::cobaltmarsh::store::MarshDB;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'MARSH_DB';
    account: 'wetland_reference_account';
    warehouse: 'MARSH_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    role: 'MARSH_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'MARSH_MONITOR';
    privateKeyVaultReference: 'snowflake.privateKey';
    passPhraseVaultReference: 'snowflake.passPhrase';
  };
}
