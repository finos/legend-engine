###Relational
Database test::cobaltmarsh::store::MarshDB
(
  Schema marsh
  (
    Table sampling_station
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )

      station_id VARCHAR(20) PRIMARY KEY,
      station_name VARCHAR(80) NOT NULL,
      habitat_code VARCHAR(4) NOT NULL,
      depth_cm INTEGER,
      is_tidal BIT NOT NULL,
      installed_on DATE NOT NULL,
      in_z DATE NOT NULL,
      out_z DATE NOT NULL
    )
    Table water_sample
    (
      sample_id VARCHAR(20) PRIMARY KEY,
      station_id VARCHAR(20) NOT NULL,
      turbidity_ntu DOUBLE NOT NULL,
      oxygen_mgl DOUBLE NOT NULL,
      sampled_on DATE NOT NULL,
      grade_code VARCHAR(4)
    )
    Table bird_count
    (
      count_id VARCHAR(20) PRIMARY KEY,
      station_id VARCHAR(20) NOT NULL,
      species_code VARCHAR(10) NOT NULL,
      tally INTEGER NOT NULL,
      observed_on DATE NOT NULL
    )
    Table ranger_shift
    (
      shift_id VARCHAR(20) PRIMARY KEY,
      station_id VARCHAR(20) NOT NULL,
      ranger_name VARCHAR(80) NOT NULL,
      shift_hours DOUBLE NOT NULL,
      is_night BIT NOT NULL
    )
  )
)
