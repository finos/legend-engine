###Pure
Class test::fabledvineyard::domain::VineBlock
{
  blockCode: String[0..1];
  blockName: String[0..1];
  rowSpacingM: Float[0..1];
  vineCount: Integer[0..1];
  plantedOn: StrictDate[0..1];
  lastWalkedAt: DateTime[0..1];
}

Class test::fabledvineyard::domain::TrellisRun
{
  runCode: String[0..1];
  runLabel: String[0..1];
  wireHeightM: Float[0..1];
  postCount: Integer[0..1];
  installedOn: StrictDate[0..1];
  inspectedAt: DateTime[0..1];
}

Class test::fabledvineyard::domain::CanopyReading
{
  readingCode: String[0..1];
  observerName: String[0..1];
  leafAreaM2: Float[0..1];
  shootCount: Integer[0..1];
  readingOn: StrictDate[0..1];
  recordedAt: DateTime[0..1];
}

Class test::fabledvineyard::domain::IrrigationPulse
{
  pulseCode: String[0..1];
  zoneName: String[0..1];
  litresDelivered: Float[0..1];
  valveCount: Integer[0..1];
  pulseOn: StrictDate[0..1];
  startedAt: DateTime[0..1];
}

Association test::fabledvineyard::domain::Block_TrellisRun
{
  runBlock: test::fabledvineyard::domain::VineBlock[0..1];
  blockRuns: test::fabledvineyard::domain::TrellisRun[*];
}

Association test::fabledvineyard::domain::TrellisRun_CanopyReading
{
  readingRun: test::fabledvineyard::domain::TrellisRun[0..1];
  runReadings: test::fabledvineyard::domain::CanopyReading[*];
}

Association test::fabledvineyard::domain::Block_IrrigationPulse
{
  pulseBlock: test::fabledvineyard::domain::VineBlock[0..1];
  blockPulses: test::fabledvineyard::domain::IrrigationPulse[*];
}
