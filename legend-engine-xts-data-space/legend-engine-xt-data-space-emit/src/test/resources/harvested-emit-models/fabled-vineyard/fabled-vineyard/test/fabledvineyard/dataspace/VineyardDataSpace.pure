###DataSpace
DataSpace test::fabledvineyard::dataspace::VineyardDataSpace
{
  executionContexts:
  [
    {
      name: 'warehouse';
      description: 'Warehouse tier - the four independent trellis roots bound to the single relational mapping and its warehouse runtime.';
      mapping: test::fabledvineyard::mapping::VineyardMapping;
      defaultRuntime: test::fabledvineyard::runtime::VineyardWarehouseRuntime;
    }
  ];
  defaultExecutionContext: 'warehouse';
  title: 'Fabled Vineyard Trellis Record';
  description: 'A governed entry point over the estate trellis record - vine blocks, their trellis runs, canopy readings and irrigation pulses - catalogued alongside the flat registers that project each root.';
  featuredDiagrams:
  [
    test::fabledvineyard::diagram::VineyardDiagram
  ];
  elements:
  [
    test::fabledvineyard::domain::VineBlock,
    test::fabledvineyard::domain::TrellisRun,
    test::fabledvineyard::domain::CanopyReading,
    test::fabledvineyard::domain::IrrigationPulse
  ];
  executables:
  [
    {
      id: 1;
      title: 'Block register';
      description: 'Flat register over the vine block root.';
      executable: test::fabledvineyard::service::BlockRegister;
    },
    {
      id: 2;
      title: 'Trellis register';
      description: 'Flat register over the trellis run root.';
      executable: test::fabledvineyard::service::TrellisRegister;
    },
    {
      id: 3;
      title: 'Canopy register';
      description: 'Flat register over the canopy reading root.';
      executable: test::fabledvineyard::service::CanopyRegister;
    }
  ];
  supportInfo: Email
  {
    address: 'trellis-record-desk@fabledvineyard.invalid';
  };
}
