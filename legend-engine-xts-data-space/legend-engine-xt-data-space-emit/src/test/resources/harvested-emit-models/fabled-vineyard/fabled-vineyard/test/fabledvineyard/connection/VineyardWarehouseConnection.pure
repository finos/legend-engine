###Connection
RelationalDatabaseConnection test::fabledvineyard::connection::VineyardWarehouseConnection
{
  store: test::fabledvineyard::store::VineyardDb;
  type: Snowflake;
  quoteIdentifiers: true;
  specification: Snowflake
  {
    name: 'VINEYARD_TRELLIS_DB';
    account: 'vineyard_trellis_account';
    warehouse: 'VINEYARD_TRELLIS_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    accountType: MultiTenant;
    organization: 'vineyard_estate';
    role: 'VINEYARD_TRELLIS_ROLE';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'VINEYARD_TRELLIS_READER';
    privateKeyVaultReference: 'vineyard-trellis-private-key';
    passPhraseVaultReference: 'vineyard-trellis-pass-phrase';
  };
}
