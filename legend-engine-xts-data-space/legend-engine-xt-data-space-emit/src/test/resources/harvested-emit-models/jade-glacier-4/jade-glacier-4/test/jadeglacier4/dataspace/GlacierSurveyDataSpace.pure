###DataSpace
DataSpace test::jadeglacier4::dataspace::GlacierSurveyDataSpace
{
  executionContexts:
  [
    {
      name: 'icefield';
      description: 'Reads the recovered ice-core register through the ice-core mapping over the survey warehouse runtime.';
      mapping: test::jadeglacier4::mapping::IceCoreSampleMapping;
      defaultRuntime: test::jadeglacier4::runtime::IceCoreSampleRuntime;
    }
  ];
  defaultExecutionContext: 'icefield';
  title: 'Glacier Survey - Ice Core Register';
  description: 'The recovered ice-core register of a monitored icefield: one wide core relation, the descriptive grades the drilling crews log for every recovered column and the archive attributes of the storage boxes the columns are shelved in.';
  elements:
  [
    test::jadeglacier4::domain::IceCoreSample
  ];
  supportInfo: Email
  {
    address: 'glacier-survey-desk@example.invalid';
  };
}
