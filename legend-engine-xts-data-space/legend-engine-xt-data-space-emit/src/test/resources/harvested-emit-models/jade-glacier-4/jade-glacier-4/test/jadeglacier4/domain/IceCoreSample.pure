###Pure
Class {meta::pure::profiles::doc.doc = 'One ice core drawn from a monitored glacier: the coring coordinates, the descriptive grades the field crew records for the recovered column, the archive attributes of the box it is stored in and the two instants the drilling and the logging happened at.'} test::jadeglacier4::domain::IceCoreSample
{
  coreCode: String[1];
  glacierName: String[1];
  basinCode: String[1];
  siteCode: String[1];
  drillCrewCode: String[1];
  surfaceKindCode: String[1];
  layerLabel: String[1];
  crystalGradeCode: String[1];
  debrisKindCode: String[1];
  meltStateCode: String[1];
  samplerCode: String[1];
  storageBoxCode: String[1];
  conditionNote: String[1];
  reviewerName: String[1];
  archiveStatusCode: String[1];
  drilledAt: DateTime[1];
  loggedAt: DateTime[1];
  coreDepthM: Decimal[1];
  coreLengthCm: Decimal[1];
}
