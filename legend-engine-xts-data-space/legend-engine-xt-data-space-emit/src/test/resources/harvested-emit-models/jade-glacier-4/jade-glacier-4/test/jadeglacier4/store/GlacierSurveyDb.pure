###Relational
Database test::jadeglacier4::store::GlacierSurveyDb
(
  Schema icefield
  (
    Table ice_core_sample
    (
      core_code VARCHAR(24) PRIMARY KEY,
      glacier_name VARCHAR(80) NOT NULL,
      basin_code VARCHAR(16) NOT NULL,
      site_code VARCHAR(16) NOT NULL,
      drill_crew_code VARCHAR(16) NOT NULL,
      surface_kind_code VARCHAR(16) NOT NULL,
      layer_label VARCHAR(40) NOT NULL,
      crystal_grade_code VARCHAR(16) NOT NULL,
      debris_kind_code VARCHAR(16) NOT NULL,
      melt_state_code VARCHAR(16) NOT NULL,
      sampler_code VARCHAR(16) NOT NULL,
      storage_box_code VARCHAR(16) NOT NULL,
      condition_note VARCHAR(240) NOT NULL,
      reviewer_name VARCHAR(60) NOT NULL,
      archive_status_code VARCHAR(16) NOT NULL,
      drilled_at TIMESTAMP NOT NULL,
      logged_at TIMESTAMP NOT NULL,
      core_depth_m DECIMAL(9, 2) NOT NULL,
      core_length_cm DECIMAL(9, 2) NOT NULL
    )
  )
)
