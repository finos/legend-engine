###Service
Service test::embertundra4::service::ActiveCurators
{
  pattern: '/ember-tundra-4/v1/curators/{processingDate}/{namePrefix}';
  title: 'Herbarium - Active Curators By Name Prefix';
  documentation: 'Resolves the processing-dated curator roll at a processing date and keeps the active curators whose name upper-cased starts with the requested upper-case prefix, so mixed-case names still match.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: {processingDate: StrictDate[1], namePrefix: String[1]|test::embertundra4::domain::Curator.all($processingDate)->filter(c|($c.activeFlag == 'Y') && $c.curatorName->toUpper()->startsWith($namePrefix))->project([c|$c.curatorCode, c|$c.curatorName], ['Curator', 'Name'])->sort([asc('Curator')])};
    mapping: test::embertundra4::mapping::HerbariumMapping;
    runtime: test::embertundra4::runtime::HerbariumArchiveRuntime;
  }
  testSuites:
  [
    activeCuratorSuite:
    {
      data:
      [
        connections:
        [
          herbariumArchive:
            Relational
            #{
              herbarium.curator:
                'curator_id,curator_code,curator_name,active_flag,in_z,out_z\n'+
                '1,CU-1,Hazel Quill,Y,2026-01-01,9999-12-31\n'+
                '2,CU-2,hal Ferris,Y,2026-01-01,9999-12-31\n'+
                '3,CU-3,Hana Wick,N,2026-01-01,9999-12-31\n'+
                '4,CU-4,Hattie Plum,Y,2025-01-01,2026-03-01\n'+
                '5,CU-5,Iris Vale,Y,2026-01-01,9999-12-31\n';
            }#
        ]
      ]
      tests:
      [
        caseInsensitivePrefix:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            processingDate = %2026-06-01,
            namePrefix = 'HA'
          ]
          asserts:
          [
            twoActiveOpenCurators:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Curator":"CU-1","Name":"Hazel Quill"},{"Curator":"CU-2","Name":"hal Ferris"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
