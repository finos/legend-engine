###Connection
RelationalDatabaseConnection test::embertundra4::connection::HerbariumServicesConnection
{
  store: test::embertundra4::store::HerbariumDB;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'HERBARIUM_DB';
    account: 'herbarium_account';
    warehouse: 'HERBARIUM_SERVICES_WH';
    region: 'us-east-1';
  };
  auth: OAuth
  {
    oauthKey: 'herbarium_services_oauth_key';
    scopeName: 'SESSION:ROLE:HERBARIUM_SERVICES_READER';
  };
}

