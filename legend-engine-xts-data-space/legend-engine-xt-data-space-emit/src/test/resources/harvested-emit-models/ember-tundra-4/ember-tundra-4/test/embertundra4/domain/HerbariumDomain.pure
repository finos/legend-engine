###Pure
Class <<temporal.bitemporal>> {meta::pure::profiles::doc.doc = 'A pressed herbarium specimen, corrected over processing time and effective over business time.'} test::embertundra4::domain::Specimen
{
  specimenCode: String[1];
  taxonName: String[1];
  familyCode: String[1];
  sheetCount: Integer[1];
  heightCm: Float[1];
  collectedOn: StrictDate[1];
  conditionCode: String[0..1];
  sizeBand: String[0..1];
}

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'A determination note written on a specimen sheet, effective over business time.'} test::embertundra4::domain::Annotation
{
  noteCode: String[1];
  authorName: String[1];
  verdict: String[1];
  notedOn: StrictDate[1];
}

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'A storage cabinet holding specimen sheets, effective over business time.'} test::embertundra4::domain::Cabinet
{
  cabinetCode: String[1];
  roomCode: String[1];
  shelfCount: Integer[1];
}

Class <<temporal.processingtemporal>> {meta::pure::profiles::doc.doc = 'A curator registered with the herbarium, corrected over processing time.'} test::embertundra4::domain::Curator
{
  curatorCode: String[1];
  curatorName: String[1];
  activeFlag: String[1];
}

Association test::embertundra4::domain::Specimen_Annotation
{
  specimen: test::embertundra4::domain::Specimen[0..1];
  annotations: test::embertundra4::domain::Annotation[*];
}

Association test::embertundra4::domain::Specimen_Cabinet
{
