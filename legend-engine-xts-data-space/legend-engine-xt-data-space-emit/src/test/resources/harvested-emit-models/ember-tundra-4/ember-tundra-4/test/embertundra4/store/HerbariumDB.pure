###Relational
Database test::embertundra4::store::HerbariumDB
(
  Schema herbarium
  (
    Table specimen
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z),
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      specimen_id INTEGER PRIMARY KEY,
      specimen_code VARCHAR(16) NOT NULL,
      taxon_name VARCHAR(80) NOT NULL,
      family_code VARCHAR(8) NOT NULL,
      sheet_count INTEGER NOT NULL,
      height_cm DOUBLE NOT NULL,
      collected_on DATE NOT NULL,
      condition_code VARCHAR(4),
      cabinet_id INTEGER,
      in_z DATE NOT NULL,
      out_z DATE NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
    Table annotation
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      note_id INTEGER PRIMARY KEY,
      specimen_id INTEGER NOT NULL,
      note_code VARCHAR(16) NOT NULL,
      author_name VARCHAR(60) NOT NULL,
      verdict VARCHAR(30) NOT NULL,
      noted_on DATE NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
    Table cabinet
    (
      milestoning
      (
        business(BUS_FROM = from_z, BUS_THRU = thru_z)
      )
      cabinet_id INTEGER PRIMARY KEY,
      cabinet_code VARCHAR(16) NOT NULL,
      room_code VARCHAR(16) NOT NULL,
      shelf_count INTEGER NOT NULL,
      from_z DATE NOT NULL,
      thru_z DATE NOT NULL
    )
    Table curator
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )
      curator_id INTEGER PRIMARY KEY,
      curator_code VARCHAR(16) NOT NULL,
      curator_name VARCHAR(60) NOT NULL,
      active_flag VARCHAR(1) NOT NULL,
      in_z DATE NOT NULL,
      out_z DATE NOT NULL
    )
  )

  Join SpecimenAnnotation(herbarium.specimen.specimen_id = herbarium.annotation.specimen_id)
  Join SpecimenCabinet(herbarium.specimen.cabinet_id = herbarium.cabinet.cabinet_id)
)
