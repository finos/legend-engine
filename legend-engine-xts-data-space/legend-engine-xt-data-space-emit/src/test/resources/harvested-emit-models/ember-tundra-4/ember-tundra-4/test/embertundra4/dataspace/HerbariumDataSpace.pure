###DataSpace
DataSpace test::embertundra4::dataspace::HerbariumDataSpace
{
  executionContexts:
  [
    {
      name: 'services';
      description: 'Herbarium register resolved through the services warehouse connection.';
      mapping: test::embertundra4::mapping::HerbariumMapping;
      defaultRuntime: test::embertundra4::runtime::HerbariumServicesRuntime;
    }
  ];
  defaultExecutionContext: 'services';
  title: 'Ember Tundra Herbarium Register';
  description: 'A curated entry point over the herbarium register - bitemporal specimen sheets, their business-dated determination notes and storage cabinets, and the processing-dated curator roll - packaging the execution context, its warehouse runtime and the diagram consumers should start from.';
  diagrams:
  [
    {
      title: 'Specimen Sheets And Their Notes';
      diagram: test::embertundra4::diagram::HerbariumDiagram;
    }
  ];
  elements:
  [
    test::embertundra4::domain
  ];
}
