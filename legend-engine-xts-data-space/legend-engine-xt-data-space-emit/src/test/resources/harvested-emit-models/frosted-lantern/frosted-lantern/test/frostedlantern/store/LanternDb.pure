###Relational
Database test::frostedlantern::store::LanternDb
(
  Schema catalogue
  (
    Table workshop
    (
      workshop_code VARCHAR(32) PRIMARY KEY,
      workshop_name VARCHAR(120) NOT NULL,
      town_name VARCHAR(80) NOT NULL,
      guild_code VARCHAR(40) NOT NULL
    )
    Table finish_lot
    (
      lot_code VARCHAR(32) PRIMARY KEY,
      finish_code VARCHAR(40) NOT NULL,
      lot_label VARCHAR(120) NOT NULL,
      lot_year INTEGER NOT NULL
    )
    Table lantern_item
    (
      item_code VARCHAR(32) PRIMARY KEY,
      item_name VARCHAR(120) NOT NULL,
      glass_type VARCHAR(40) NOT NULL,
      finish_code VARCHAR(40) NOT NULL,
      workshop_code VARCHAR(32),
      pane_count INTEGER NOT NULL,
      catalogue_year INTEGER NOT NULL
    )
  )

  Join Item_Workshop(catalogue.lantern_item.workshop_code = catalogue.workshop.workshop_code)
)
