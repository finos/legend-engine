import test::frostedlantern::domain::*;

Class {meta::pure::profiles::doc.doc = 'A workshop that made catalogued lantern items, held in its own table so the item alias reaches it through a join.'} test::frostedlantern::domain::Workshop
{
  workshopCode: String[1];
  workshopName: String[1];
  townName: String[1];
  guildCode: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A finish lot a lantern item was frosted, etched or left clear in.'} test::frostedlantern::domain::FinishLot
{
  lotCode: String[1];
  finishCode: String[1];
  lotLabel: String[1];
  lotYear: Integer[1];
}

Class {meta::pure::profiles::doc.doc = 'A catalogued heritage lantern, qualifying itself against a requested finish and a requested glass family through parameterized qualified properties.'} test::frostedlantern::domain::LanternItem
{
  itemCode: String[1];
  itemName: String[1];
  glassType: String[1];
  finishCode: String[1];
  paneCount: Integer[1];
  catalogueYear: Integer[1];
  workshop: Workshop[0..1];
  matchesFinish(finish: String[1])
  {
    $this.finishCode == $finish
  }: Boolean[1];
  inGlassFamily(families: String[*])
  {
    $this.glassType->in($families)
  }: Boolean[1];
}
