###DataSpace
DataSpace test::frostedlantern::dataspace::LanternDataSpace
{
  executionContexts:
  [
    {
      name: 'catalogue';
      description: 'Catalogue environment - the lantern item, workshop and finish lot binding served through the in-process catalogue database.';
      mapping: test::frostedlantern::mapping::LanternMapping;
      defaultRuntime: test::frostedlantern::runtime::LanternCatalogueRuntime;
    }
  ];
  defaultExecutionContext: 'catalogue';
  title: 'Frosted Lantern Heritage Catalogue';
  description: 'Discovery surface over the heritage lantern catalogue: catalogued items, the workshops that made them and the finish lots they were finished in.';
  elements:
  [
    test::frostedlantern::domain::LanternItem,
    test::frostedlantern::domain::Workshop,
    test::frostedlantern::domain::FinishLot
  ];
  executables:
  [
    {
      id: 1;
      title: 'Lantern Register Extract';
      description: 'The qualified register query over a requested finish, guild and town set.';
      executable: test::frostedlantern::service::LanternRegisterExtract;
    }
  ];
  supportInfo: Email
  {
    address: 'lantern-catalogue-desk@heritageglass.invalid';
  };
}
