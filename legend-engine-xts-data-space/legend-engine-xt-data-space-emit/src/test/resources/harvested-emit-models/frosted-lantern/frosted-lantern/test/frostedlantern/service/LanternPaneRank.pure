###Service
Service test::frostedlantern::service::LanternPaneRank
{
  pattern: '/lantern/v1/pane-rank';
  title: 'Frosted Lantern - Pane rank window';
  owners:
  [
    'lantern-catalogue-desk',
    'heritage-glass-registry'
  ];
  documentation: 'Ranked window over the catalogued items: items in the requested glass families are projected, a per-town rank is assigned over descending pane counts, and the ranked rows are sorted by town and item code before a row limit is applied.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {glassFamilies: String[*]|test::frostedlantern::domain::LanternItem.all()->filter(
      i|$i.inGlassFamily($glassFamilies)
    )->project(
      [
        i|$i.itemCode,
        i|$i.workshop.townName,
        i|$i.paneCount
      ],
      [
        'Item/Code',
        'Workshop/Town',
        'Item/Panes'
      ]
    )->olapGroupBy(
      [
        'Workshop/Town'
      ],
      desc('Item/Panes'),
      w|$w->rank(),
      'Town/PaneRank'
    )->sort(
      [
        asc('Workshop/Town'),
        asc('Item/Code')
      ]
    )->take(5);};
    mapping: test::frostedlantern::mapping::LanternMapping;
    runtime: test::frostedlantern::runtime::LanternCatalogueRuntime;
  }
  testSuites:
  [
    paneRankSuite:
    {
      data:
      [
        connections:
        [
          lanternConnection:
            Relational
            #{
              catalogue.workshop:
                'workshop_code,workshop_name,town_name,guild_code\n'+
                'WS-1,Frost Glassworks,Rimehaven,GLAZIERS\n'+
                'WS-2,Pane And Pane,Rimehaven,GLAZIERS\n'+
                'WS-3,Lantern Loft,Bellmoor,SMITHS\n'+
                'WS-4,Clearlight Shed,Coldwater,GLAZIERS\n';
              catalogue.lantern_item:
                'item_code,item_name,glass_type,finish_code,workshop_code,pane_count,catalogue_year\n'+
                'LI-1,Harbour Lantern,SODA,FROSTED,WS-1,6,1899\n'+
                'LI-2,Cellar Lantern,LEAD,FROSTED,WS-2,4,1901\n'+
                'LI-3,Signal Lantern,SODA,CLEAR,WS-1,8,1903\n'+
                'LI-4,Chapel Lantern,BOROSILICATE,FROSTED,WS-3,12,1905\n'+
                'LI-5,Cart Lantern,SODA,FROSTED,WS-4,3,1907\n'+
                'LI-6,Storm Lantern,LEAD,FROSTED,WS-1,10,1910\n';
            }#
        ]
      ]
      tests:
      [
        rankedWithinEachTown:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            glassFamilies = ['SODA', 'LEAD']
          ]
          asserts:
          [
            fiveRankedRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Item/Code":"LI-5","Workshop/Town":"Coldwater","Item/Panes":3,"Town/PaneRank":1},{"Item/Code":"LI-1","Workshop/Town":"Rimehaven","Item/Panes":6,"Town/PaneRank":3},{"Item/Code":"LI-2","Workshop/Town":"Rimehaven","Item/Panes":4,"Town/PaneRank":4},{"Item/Code":"LI-3","Workshop/Town":"Rimehaven","Item/Panes":8,"Town/PaneRank":2},{"Item/Code":"LI-6","Workshop/Town":"Rimehaven","Item/Panes":10,"Town/PaneRank":1}]';
                  }#;
              }#
          ]
        },
        glassFamilyWithNoItem:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            glassFamilies = ['CERAMIC']
          ]
          asserts:
          [
            emptyResult:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
