###Connection
RelationalDatabaseConnection test::silverorchard3::connection::NorthRegisterConnection
{
  store: test::silverorchard3::store::ApiaryDb;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'APIARY_NORTH_DB';
    account: 'apiary_register_account';
    warehouse: 'APIARY_REGISTER_WH';
    region: 'eu-west-1';
    cloudType: 'aws';
    role: 'APIARY_REGISTER_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'APIARY_REGISTER_USER';
    privateKeyVaultReference: 'apiary-register-private-key';
    passPhraseVaultReference: 'apiary-register-passphrase';
  };
}

RelationalDatabaseConnection test::silverorchard3::connection::SouthRegisterConnection
{
  store: test::silverorchard3::store::ApiaryDb;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'APIARY_SOUTH_DB';
    account: 'apiary_register_account';
    warehouse: 'APIARY_REGISTER_WH';
    region: 'eu-west-2';
    cloudType: 'aws';
    role: 'APIARY_REGISTER_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'APIARY_REGISTER_USER';
    privateKeyVaultReference: 'apiary-register-private-key';
    passPhraseVaultReference: 'apiary-register-passphrase';
  };
}
