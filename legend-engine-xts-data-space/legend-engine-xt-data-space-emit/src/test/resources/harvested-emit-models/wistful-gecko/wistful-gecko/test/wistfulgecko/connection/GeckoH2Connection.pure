###Connection
RelationalDatabaseConnection test::wistfulgecko::connection::GeckoH2Connection
{
  store: test::wistfulgecko::store::GeckoDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists registry;',
      'create schema registry;',
      'drop schema if exists field;',
      'create schema field;',
      'create table registry.observer (observer_code varchar(24) primary key, observer_name varchar(120) not null, team_name varchar(60) not null);',
      'create table field.habitat (habitat_code varchar(24) primary key, habitat_name varchar(120) not null, terrain_code varchar(24) not null);',
      'create table field.gecko_sighting (sighting_code varchar(24) primary key, habitat_code varchar(24) not null, observer_code varchar(24) not null, species_code varchar(24) not null, gecko_count integer not null, night_temp_c double not null, valid_from date not null, valid_thru date not null);',
      'create table field.habitat_survey (survey_code varchar(24) primary key, habitat_code varchar(24) not null, canopy_pct double not null, in_z date not null, out_z date not null);'
      ];
  };
  auth: DefaultH2;
}
