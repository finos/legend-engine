###Mapping
Mapping test::wistfulgecko::mapping::GeckoMapping
(
  include test::wistfulgecko::mapping::GeckoRegistryMapping

  *test::wistfulgecko::domain::Habitat[habitat]: Relational
  {
    ~primaryKey
    (
      [test::wistfulgecko::store::GeckoDB]field.habitat.habitat_code
    )
    ~mainTable [test::wistfulgecko::store::GeckoDB]field.habitat
    habitatCode: [test::wistfulgecko::store::GeckoDB]field.habitat.habitat_code,
    habitatName: [test::wistfulgecko::store::GeckoDB]field.habitat.habitat_name,
    terrainCode: [test::wistfulgecko::store::GeckoDB]field.habitat.terrain_code
  }

  *test::wistfulgecko::domain::GeckoSighting[sighting]: Relational
  {
    ~primaryKey
    (
      [test::wistfulgecko::store::GeckoDB]field.gecko_sighting.sighting_code
    )
    ~mainTable [test::wistfulgecko::store::GeckoDB]field.gecko_sighting
    sightingCode: [test::wistfulgecko::store::GeckoDB]field.gecko_sighting.sighting_code,
    speciesCode: [test::wistfulgecko::store::GeckoDB]field.gecko_sighting.species_code,
    geckoCount: [test::wistfulgecko::store::GeckoDB]field.gecko_sighting.gecko_count,
    nightTempC: [test::wistfulgecko::store::GeckoDB]field.gecko_sighting.night_temp_c,
    habitatName: [test::wistfulgecko::store::GeckoDB]@Sighting_Habitat | [test::wistfulgecko::store::GeckoDB]field.habitat.habitat_name,
    terrainCode: [test::wistfulgecko::store::GeckoDB]@Sighting_Habitat | [test::wistfulgecko::store::GeckoDB]field.habitat.terrain_code,
    observerName: [test::wistfulgecko::store::GeckoDB]@Sighting_Observer | [test::wistfulgecko::store::GeckoDB]registry.observer.observer_name
  }

  *test::wistfulgecko::domain::HabitatSurvey[habitatSurvey]: Relational
  {
    ~primaryKey
    (
      [test::wistfulgecko::store::GeckoDB]field.habitat_survey.survey_code
    )
    ~mainTable [test::wistfulgecko::store::GeckoDB]field.habitat_survey
    surveyCode: [test::wistfulgecko::store::GeckoDB]field.habitat_survey.survey_code,
    canopyPct: [test::wistfulgecko::store::GeckoDB]field.habitat_survey.canopy_pct
  }

  test::wistfulgecko::domain::Habitat_Sightings: Relational
  {
    AssociationMapping
    (
      sightings[habitat, sighting]: [test::wistfulgecko::store::GeckoDB]@Sighting_Habitat,
      habitat[sighting, habitat]: [test::wistfulgecko::store::GeckoDB]@Sighting_Habitat
    )
  }

  testSuites:
  [
    sightingJoinSuite:
    {
      function: |test::wistfulgecko::domain::GeckoSighting.all(%2026-06-01)->project(
        [
          col(s|$s.sightingCode, 'Sighting'),
          col(s|$s.habitatName->toOne(), 'Habitat'),
          col(s|$s.observerName->toOne(), 'Observer'),
          col(s|$s.geckoCount, 'Geckos')
        ]
      )->sort([asc('Sighting')]);
      tests:
      [
        joinedSightingColumns:
        {
          doc: 'Projects the habitat and observer columns reached over the store joins: a sighting whose observer key has no registry row keeps its habitat column and reports an empty observer, while a sighting whose business window closed before the requested effective date is absent entirely.';
          data:
          [
            test::wistfulgecko::store::GeckoDB:
              Relational
              #{
                registry.observer:
                  'observer_code,observer_name,team_name\n'+
                  'OB-1,Ada Fern,night-team\n'+
                  'OB-2,Bo Larch,dawn-team\n';
                field.habitat:
                  'habitat_code,habitat_name,terrain_code\n'+
                  'HB-1,Reed Gully,RIPARIAN\n'+
                  'HB-2,Granite Slope,ROCKY\n'+
                  'HB-3,Sand Flat,DUNE\n';
                field.gecko_sighting:
                  'sighting_code,habitat_code,observer_code,species_code,gecko_count,night_temp_c,valid_from,valid_thru\n'+
                  'GS-01,HB-1,OB-1,SP-LEAFTAIL,4,18.5,2026-01-01,9999-12-31\n'+
                  'GS-02,HB-1,OB-2,SP-DTELLA,2,17.0,2026-01-01,9999-12-31\n'+
                  'GS-03,HB-2,OB-1,SP-LEAFTAIL,6,19.5,2026-01-01,9999-12-31\n'+
                  'GS-04,HB-3,OB-9,SP-LEAFTAIL,3,16.0,2026-01-01,9999-12-31\n'+
                  'GS-05,HB-2,OB-1,SP-LEAFTAIL,9,20.0,2024-01-01,2024-06-30\n';
              }#
          ];
          asserts:
          [
            rows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Sighting":"GS-01","Habitat":"Reed Gully","Observer":"Ada Fern","Geckos":4},{"Sighting":"GS-02","Habitat":"Reed Gully","Observer":"Bo Larch","Geckos":2},{"Sighting":"GS-03","Habitat":"Granite Slope","Observer":"Ada Fern","Geckos":6},{"Sighting":"GS-04","Habitat":"Sand Flat","Observer":null,"Geckos":3}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
