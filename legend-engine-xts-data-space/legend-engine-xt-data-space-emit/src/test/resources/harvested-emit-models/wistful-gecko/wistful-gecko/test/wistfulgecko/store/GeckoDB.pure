###Relational
Database test::wistfulgecko::store::GeckoDB
(
  include test::wistfulgecko::store::GeckoRegistryDB

  Schema field
  (
    Table habitat
    (
      habitat_code VARCHAR(24) PRIMARY KEY,
      habitat_name VARCHAR(120) NOT NULL,
      terrain_code VARCHAR(24) NOT NULL
    )
    Table gecko_sighting
    (
      milestoning
      (
        business(BUS_FROM = valid_from, BUS_THRU = valid_thru)
      )
      sighting_code VARCHAR(24) PRIMARY KEY,
      habitat_code VARCHAR(24) NOT NULL,
      observer_code VARCHAR(24) NOT NULL,
      species_code VARCHAR(24) NOT NULL,
      gecko_count INTEGER NOT NULL,
      night_temp_c DOUBLE NOT NULL,
      valid_from DATE NOT NULL,
      valid_thru DATE NOT NULL
    )
    Table habitat_survey
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )
      survey_code VARCHAR(24) PRIMARY KEY,
      habitat_code VARCHAR(24) NOT NULL,
      canopy_pct DOUBLE NOT NULL,
      in_z DATE NOT NULL,
      out_z DATE NOT NULL
    )
  )

  Join Sighting_Habitat(field.gecko_sighting.habitat_code = field.habitat.habitat_code)
  Join Sighting_Observer(field.gecko_sighting.observer_code = registry.observer.observer_code)
)
