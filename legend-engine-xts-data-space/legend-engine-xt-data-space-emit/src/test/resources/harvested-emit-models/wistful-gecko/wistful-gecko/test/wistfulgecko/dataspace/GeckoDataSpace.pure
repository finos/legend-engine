###DataSpace
DataSpace test::wistfulgecko::dataspace::GeckoSurveyDataSpace
{
  executionContexts:
  [
    {
      name: 'local';
      description: 'Local estate binding the field store to the survey mapping and the embedded test runtime.';
      mapping: test::wistfulgecko::mapping::GeckoMapping;
      defaultRuntime: test::wistfulgecko::runtime::GeckoH2Runtime;
    },
    {
      name: 'warehouse';
      description: 'Warehouse estate binding the same mapping to the key-pair authenticated cloud connection.';
      mapping: test::wistfulgecko::mapping::GeckoMapping;
      defaultRuntime: test::wistfulgecko::runtime::GeckoWarehouseRuntime;
    },
    {
      name: 'archive';
      description: 'Archive estate exposing the retired sighting rows under their own processing window.';
      mapping: test::wistfulgecko::mapping::GeckoArchiveMapping;
      defaultRuntime: test::wistfulgecko::runtime::GeckoArchiveRuntime;
    }
  ];
  defaultExecutionContext: 'local';
  title: 'Wistful Gecko Nocturnal Survey';
  description: 'Entry point over the nocturnal gecko survey: habitat patches, the business-temporal sighting register widened over observer and habitat joins, and the corrected canopy surveys.';
  elements:
  [
    test::wistfulgecko::domain
  ];
  executables:
  [
    {
      id: 1;
      title: 'Sighting board for the local estate';
      description: 'The featured endpoint projecting joined sighting rows as of an effective date.';
      executable: test::wistfulgecko::service::SightingBoardsLocal;
    }
  ];
  supportInfo: Email
  {
    address: 'nocturnal-survey-office@example.invalid';
  };
}
