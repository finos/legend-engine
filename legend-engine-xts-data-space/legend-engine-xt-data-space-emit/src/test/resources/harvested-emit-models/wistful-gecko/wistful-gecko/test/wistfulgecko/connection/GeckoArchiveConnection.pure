###Connection
RelationalDatabaseConnection test::wistfulgecko::connection::GeckoArchiveConnection
{
  store: test::wistfulgecko::store::GeckoArchiveDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists archive;',
      'create schema archive;',
      'create table archive.sighting_archive (archive_code varchar(24) primary key, sighting_code varchar(24) not null, retired_stage varchar(24) not null, in_z date not null, out_z date not null);'
      ];
  };
  auth: DefaultH2;
}
