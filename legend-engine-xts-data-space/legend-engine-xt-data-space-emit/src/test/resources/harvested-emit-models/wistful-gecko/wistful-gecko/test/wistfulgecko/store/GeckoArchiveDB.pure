###Relational
Database test::wistfulgecko::store::GeckoArchiveDB
(
  Schema archive
  (
    Table sighting_archive
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )
      archive_code VARCHAR(24) PRIMARY KEY,
      sighting_code VARCHAR(24) NOT NULL,
      retired_stage VARCHAR(24) NOT NULL,
      in_z DATE NOT NULL,
      out_z DATE NOT NULL
    )
  )
)
