###Pure
import test::wistfulgecko::domain::*;

Class {meta::pure::profiles::doc.doc = 'A licensed field observer who records nocturnal gecko counts.'} test::wistfulgecko::domain::Observer
{
  observerCode: String[1];
  observerName: String[1];
  teamName: String[1];
}

Class {meta::pure::profiles::doc.doc = 'A surveyed habitat patch that gecko sightings are recorded against.'} test::wistfulgecko::domain::Habitat
{
  habitatCode: String[1];
  habitatName: String[1];
  terrainCode: String[1];
}

Class <<temporal.businesstemporal>> {meta::pure::profiles::doc.doc = 'One nocturnal gecko sighting valid over a business window, widened with habitat and observer detail reached over store joins.'} test::wistfulgecko::domain::GeckoSighting
{
  sightingCode: String[1];
  speciesCode: String[1];
  geckoCount: Integer[1];
  nightTempC: Float[1];
  habitatName: String[0..1];
  terrainCode: String[0..1];
  observerName: String[0..1];
}

Class <<temporal.processingtemporal>> {meta::pure::profiles::doc.doc = 'A canopy survey of a habitat patch, corrected in place so only the latest processing window is visible.'} test::wistfulgecko::domain::HabitatSurvey
{
  surveyCode: String[1];
  canopyPct: Float[1];
}

Class <<temporal.processingtemporal>> {meta::pure::profiles::doc.doc = 'A retired sighting row kept in the archive estate under its own processing window.'} test::wistfulgecko::domain::ArchivedSighting
{
  archiveCode: String[1];
  sightingCode: String[1];
  retiredStage: String[1];
}

Association {meta::pure::profiles::doc.doc = 'Links a habitat patch to the sightings recorded in it.'} test::wistfulgecko::domain::Habitat_Sightings
{
  habitat: Habitat[0..1];
  sightings: GeckoSighting[*];
}
