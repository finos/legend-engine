###DataSpace
DataSpace test::teallantern::dataspace::HarbourLightDataSpace
{
  executionContexts:
  [
    {
      name: 'register';
      description: 'Register environment - the station, lamp, inspection and crew bindings served through the primary light warehouse.';
      mapping: test::teallantern::mapping::HarbourLightMapping;
      defaultRuntime: test::teallantern::runtime::HarbourPrimaryRuntime;
    },
    {
      name: 'works';
      description: 'Works environment - the same bindings served through the maintenance warehouse the inspection crews report against.';
      mapping: test::teallantern::mapping::HarbourLightMapping;
      defaultRuntime: test::teallantern::runtime::HarbourWorksRuntime;
    }
  ];
  defaultExecutionContext: 'register';
  title: 'Harbour Light Works';
  description: 'Discovery surface over the harbour navigation lights: the station and lamp register, the glare inspections filed against each lamp and the keeper crews rostered on each station.';
  elements:
  [
    test::teallantern::domain::LanternStation,
    test::teallantern::domain::LampUnit,
    test::teallantern::domain::LampInspection,
    test::teallantern::domain::KeeperCrew
  ];
  executables:
  [
    {
      title: 'Glare band register';
      description: 'The eight-arm glare banding published per lamp kind.';
      executable: test::teallantern::service::GlareBandRegister;
    }
  ];
  supportInfo: Email
  {
    address: 'harbour-light-works@harbourlight.invalid';
  };
}
