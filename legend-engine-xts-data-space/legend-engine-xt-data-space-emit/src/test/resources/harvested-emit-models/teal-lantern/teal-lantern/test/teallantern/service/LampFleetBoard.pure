###Service
Service test::teallantern::service::LampFleetBoard
{
  pattern: '/teallantern/v1/lamp-fleet';
  title: 'Harbour Light - Lamp fleet board';
  owners:
  [
    'harbour-light-works',
    'reach-survey-desk'
  ];
  documentation: 'Lists the lamp fleet, keeping the kinds supplied in the caller collection and every kind when the collection arrives empty, dropping the codes held on the withdrawn list, and publishing a deterministic page of the first three lamps with a nullable measured output alongside the station reached through the fitting join.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: {lampKinds: String[*]|test::teallantern::domain::LampUnit.all()->filter(
      l| if($lampKinds->isEmpty(), | true, | $lampKinds->contains($l.lampKind)) && !($l.lampCode->in(['LMP-99']))
    )->project(
      [
        col(l|$l.lampCode, 'Lamp'),
        col(l|$l.lampKind, 'Kind'),
        col(l|$l.station.stationCode, 'Station'),
        col(l|$l.lumenOutput, 'Lumens')
      ]
    )->sort([asc('Lamp')])->take(3)};
    mapping: test::teallantern::mapping::HarbourLightMapping;
    runtime: test::teallantern::runtime::HarbourWorksRuntime;
  }
  testSuites:
  [
    lampFleetSuite:
    {
      data:
      [
        connections:
        [
          harbourWorksConnection:
            Relational
            #{
              harbour.lantern_station:
                'station_id,station_code,station_name,reach_code,elevation_m,commissioned_on,last_checked_at\n'+
                '1,ST-01,North Mole Light,RCH-N,12.5,1998-04-01,2026-01-02 06:00:00\n'+
                '2,ST-02,South Pier Light,RCH-S,8.0,2004-09-15,2026-01-03 07:30:00\n';

              harbour.lamp_unit:
                'lamp_id,station_id,lamp_code,lamp_kind,lumen_output,installed_on\n'+
                '1,1,LMP-01,BEACON,4200.0,2019-05-01\n'+
                '2,2,LMP-02,SECTOR,3100.0,2020-06-01\n'+
                '3,1,LMP-03,BEACON,,2021-07-01\n'+
                '4,2,LMP-04,BEACON,3900.0,2022-08-01\n'+
                '5,1,LMP-05,BEACON,2600.0,2023-03-01\n'+
                '6,2,LMP-99,BEACON,1200.0,2016-02-01\n';
            }#
        ]
      ]
      tests:
      [
        beaconPage:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            lampKinds = ['BEACON']
          ]
          asserts:
          [
            pagedRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Lamp":"LMP-01","Kind":"BEACON","Station":"ST-01","Lumens":4200.0},{"Lamp":"LMP-03","Kind":"BEACON","Station":"ST-01","Lumens":null},{"Lamp":"LMP-04","Kind":"BEACON","Station":"ST-02","Lumens":3900.0}]';
                  }#;
              }#
          ]
        },
        everyKindPage:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            lampKinds = []
          ]
          asserts:
          [
            pagedRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Lamp":"LMP-01","Kind":"BEACON","Station":"ST-01","Lumens":4200.0},{"Lamp":"LMP-02","Kind":"SECTOR","Station":"ST-02","Lumens":3100.0},{"Lamp":"LMP-03","Kind":"BEACON","Station":"ST-01","Lumens":null}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
