###Connection
RelationalDatabaseConnection test::teallantern::connection::HarbourPrimaryConnection
{
  store: test::teallantern::store::HarbourLightDb;
  type: Snowflake;
  timezone: +0000;
  quoteIdentifiers: true;
  specification: Snowflake
  {
    name: 'HARBOUR_LIGHT_DB';
    account: 'harbour_light_account';
    warehouse: 'HARBOUR_LIGHT_WH';
    region: 'eu-west-1';
    cloudType: 'aws';
    accountType: MultiTenant;
    organization: 'harbour_light_org';
    role: 'HARBOUR_LIGHT_READER';
  };
  auth: OAuth
  {
    oauthKey: 'harbour_light_oauth_key';
    scopeName: 'SESSION:ROLE:HARBOUR_LIGHT_READER';
  };
}

