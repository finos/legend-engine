###DataSpace
DataSpace test::goldenreef5::dataspace::NestingDataSpace
{
  executionContexts:
  [
    {
      name: 'survey';
      description: 'Survey environment - the nesting records served through the local survey database.';
      mapping: test::goldenreef5::mapping::NestingMapping;
      defaultRuntime: test::goldenreef5::runtime::NestingH2Runtime;
    },
    {
      name: 'coastal';
      description: 'Coastal warehouse environment - the same nesting records read from the published schemas rewritten by the connection mapper.';
      mapping: test::goldenreef5::mapping::NestingMapping;
      defaultRuntime: test::goldenreef5::runtime::NestingWarehouseRuntime;
    }
  ];
  defaultExecutionContext: 'survey';
  title: 'Nesting Coast Survey';
  description: 'Discovery surface over the nesting coast survey: the monitored nesting sites recorded over processing time and the clutches walked by the patrol teams.';
  elements:
  [
    test::goldenreef5::domain::NestSite,
    test::goldenreef5::domain::NestRecord,
    test::goldenreef5::domain::PatrolTeam
  ];
  supportInfo: Email
  {
    address: 'nesting-coast-desk@nestingcoast.invalid';
  };
}
