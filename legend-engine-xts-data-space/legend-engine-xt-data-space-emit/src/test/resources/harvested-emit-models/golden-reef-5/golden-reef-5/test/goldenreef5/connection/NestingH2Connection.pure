###Connection
RelationalDatabaseConnection test::goldenreef5::connection::NestingH2Connection
{
  store: test::goldenreef5::store::NestingCoastDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists coast;',
      'create schema coast;',
      'drop schema if exists patrol;',
      'create schema patrol;',
      'create table coast.nest_site (site_code varchar(24) not null, site_name varchar(120) not null, beach_code varchar(24) not null, sector_code varchar(24) not null, substrate_code varchar(24) not null, in_z date not null, out_z date);',
      'create table coast.beach (beach_code varchar(24) primary key, beach_name varchar(120) not null, coast_region varchar(64) not null);',
      'create table patrol.nest_record (nest_ref varchar(24) primary key, site_code varchar(24) not null, team_code varchar(24) not null, laid_date date not null, clutch_size integer not null, hatch_count integer, predation_code varchar(24), sand_temp_c decimal(5,2));',
      'create table patrol.patrol_team (team_code varchar(24) primary key, team_name varchar(120) not null, station_code varchar(24) not null);',
      'create table patrol.field_station (station_code varchar(24) primary key, station_name varchar(120) not null, coast_region varchar(64) not null);'
      ];
  };
  auth: DefaultH2;
}
