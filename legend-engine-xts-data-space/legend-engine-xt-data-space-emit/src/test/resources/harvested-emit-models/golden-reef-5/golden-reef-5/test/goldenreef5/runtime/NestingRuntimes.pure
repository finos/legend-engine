###Runtime
Runtime test::goldenreef5::runtime::NestingH2Runtime
{
  mappings:
  [
    test::goldenreef5::mapping::NestingMapping
  ];
  connections:
  [
    test::goldenreef5::store::NestingCoastDB:
    [
      h2Connection: test::goldenreef5::connection::NestingH2Connection
    ]
  ];
}

Runtime test::goldenreef5::runtime::NestingWarehouseRuntime
{
  mappings:
  [
    test::goldenreef5::mapping::NestingMapping
  ];
  connections:
  [
    test::goldenreef5::store::NestingCoastDB:
    [
      warehouseConnection: test::goldenreef5::connection::NestingWarehouseConnection
    ]
  ];
}
