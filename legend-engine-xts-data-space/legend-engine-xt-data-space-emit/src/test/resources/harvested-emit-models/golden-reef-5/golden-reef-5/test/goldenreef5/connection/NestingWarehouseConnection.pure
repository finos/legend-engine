###Connection
RelationalDatabaseConnection test::goldenreef5::connection::NestingWarehouseConnection
{
  store: test::goldenreef5::store::NestingCoastDB;
  type: Snowflake;
  timezone: -0500;
  quoteIdentifiers: false;
  specification: Snowflake
  {
    name: 'NESTING_COAST_DB';
    account: 'nesting_survey_account';
    warehouse: 'NESTING_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    accountType: MultiTenant;
    organization: 'nesting_survey_org';
    role: 'NESTING_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'NESTING_SURVEY_READER';
    privateKeyVaultReference: 'nesting-survey-private-key';
    passPhraseVaultReference: 'nesting-survey-pass-phrase';
  };
  postProcessors:
  [
    mapper
    {
      mappers:
      [
        schema {from: 'coast'; to: 'coast_published';},
        schema {from: 'patrol'; to: 'patrol_published';},
        table {from: 'nest_site'; to: 'nest_site_current'; schemaFrom: 'coast'; schemaTo: 'coast_published';}
      ];
    }
  ];
}
