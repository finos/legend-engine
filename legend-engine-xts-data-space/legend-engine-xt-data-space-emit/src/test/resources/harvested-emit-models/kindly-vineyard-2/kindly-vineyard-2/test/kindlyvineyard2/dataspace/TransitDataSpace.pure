###DataSpace
DataSpace test::kindlyvineyard2::dataspace::TransitPlanningDataSpace
{
  executionContexts:
  [
    {
      name: 'planning';
      description: 'Planning context for the urban transit registry and grouped corridor summaries.';
      mapping: test::kindlyvineyard2::mapping::TransitMapping;
      defaultRuntime: test::kindlyvineyard2::runtime::TransitH2Runtime;
    }
  ];
  defaultExecutionContext: 'planning';
  title: 'Urban Transit Planning Registry';
  description: 'An addressable planning surface over stops, corridors, hubs, vehicle runs and route digests.';
  elements:
  [
    test::kindlyvineyard2::domain::StopPoint,
    test::kindlyvineyard2::domain::TransitCorridor,
    test::kindlyvineyard2::domain::TransitHub,
    test::kindlyvineyard2::domain::VehicleRun,
    test::kindlyvineyard2::domain::RouteDigest
  ];
  supportInfo: Email
  {
    address: 'transit-planning@citygrid.invalid';
  };
}
