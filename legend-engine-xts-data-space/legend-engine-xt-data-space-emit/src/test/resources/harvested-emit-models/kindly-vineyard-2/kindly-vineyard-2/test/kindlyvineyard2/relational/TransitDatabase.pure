###Relational
Database test::kindlyvineyard2::relational::TransitDB
(
  Schema transit
  (
    Table stop_point
    (
      stop_id INTEGER PRIMARY KEY,
      stop_code VARCHAR(24) NOT NULL,
      corridor_id INTEGER NOT NULL,
      stop_label VARCHAR(80) NOT NULL
    )

    Table corridor
    (
      corridor_id INTEGER PRIMARY KEY,
      corridor_code VARCHAR(24) NOT NULL,
      hub_id INTEGER NOT NULL,
      corridor_label VARCHAR(80) NOT NULL
    )

    Table vehicle_run
    (
      run_id INTEGER PRIMARY KEY,
      corridor_id INTEGER NOT NULL,
      run_code VARCHAR(24) NOT NULL,
      rider_count INTEGER NOT NULL
    )
  )

  Schema support
  (
    Table hub
    (
      hub_id INTEGER PRIMARY KEY,
      hub_code VARCHAR(24) NOT NULL,
      district_code VARCHAR(32) NOT NULL
    )

    Table route_digest
    (
      corridor_code VARCHAR(24) PRIMARY KEY,
      hub_code VARCHAR(24) NOT NULL,
      district_code VARCHAR(32) NOT NULL,
      stop_count INTEGER NOT NULL,
      rider_total INTEGER NOT NULL
    )
  )

  Join Stop_Corridor(transit.stop_point.corridor_id = transit.corridor.corridor_id)
  Join Corridor_Hub(transit.corridor.hub_id = support.hub.hub_id)
  Join Corridor_Run(transit.corridor.corridor_id = transit.vehicle_run.corridor_id)
)
