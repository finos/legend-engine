###Pure
Class test::kindlyvineyard2::domain::StopPoint
{
  stopId: Integer[1];
  stopCode: String[1];
  corridorId: Integer[1];
  corridorCode: String[1];
  stopLabel: String[1];
  districtCode: String[0..1];
  runCodes: String[*];
}

Class test::kindlyvineyard2::domain::TransitCorridor
{
  corridorId: Integer[1];
  corridorCode: String[1];
  hubId: Integer[1];
  corridorLabel: String[1];
}

Class test::kindlyvineyard2::domain::TransitHub
{
  hubId: Integer[1];
  hubCode: String[1];
  districtCode: String[1];
}

Class test::kindlyvineyard2::domain::VehicleRun
{
  runId: Integer[1];
  corridorId: Integer[1];
  runCode: String[1];
  riderCount: Integer[1];
}

Class test::kindlyvineyard2::domain::RouteDigest
{
  corridorCode: String[1];
  hubCode: String[1];
  districtCode: String[1];
  stopCount: Integer[1];
  riderTotal: Integer[1];
}

Association test::kindlyvineyard2::domain::StopCorridor
{
  stop: test::kindlyvineyard2::domain::StopPoint[1];
  corridor: test::kindlyvineyard2::domain::TransitCorridor[1];
}
