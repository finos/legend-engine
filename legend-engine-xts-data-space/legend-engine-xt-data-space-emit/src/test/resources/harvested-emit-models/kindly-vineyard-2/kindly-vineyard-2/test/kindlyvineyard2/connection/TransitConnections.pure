###Connection
RelationalDatabaseConnection test::kindlyvineyard2::connection::TransitH2Connection
{
  store: test::kindlyvineyard2::relational::TransitDB;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [];
  };
  auth: DefaultH2;
}

###Connection
RelationalDatabaseConnection test::kindlyvineyard2::connection::TransitSnowflakeConnection
{
  store: test::kindlyvineyard2::relational::TransitDB;
  type: Snowflake;
  timezone: +0000;
  specification: Snowflake
  {
    name: 'TRANSIT_PLANNING_DB';
    account: 'transitplanningexample';
    warehouse: 'TRANSIT_PLANNING_WH';
    region: 'example-region-1';
    role: 'TRANSIT_PLANNER';
  };
  auth: OAuth
  {
    scopeName: 'SESSION:ROLE:TRANSIT_PLANNER';
    oauthKey: 'transit_planning_oauth_key';
  };
}
