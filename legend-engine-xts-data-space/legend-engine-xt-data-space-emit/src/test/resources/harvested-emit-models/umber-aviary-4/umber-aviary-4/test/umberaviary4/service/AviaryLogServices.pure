###Service
Service test::umberaviary4::service::RingingRecordExtract
{
  pattern: '/umberaviary4/v1/ringingrecord';
  ownership: DID { identifier: '000000' };
  documentation: 'Publishes every property of the RingingRecord log at its latest processing version as a tabular result.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |test::umberaviary4::domain::RingingRecord.all(%latest)->project([x|$x.ringCode, x|$x.speciesCode, x|$x.ageClass, x|$x.wingMm, x|$x.massG, x|$x.ringedOn, x|$x.createdAt, x|$x.updatedAt], ['RingCode', 'SpeciesCode', 'AgeClass', 'WingMm', 'MassG', 'RingedOn', 'CreatedAt', 'UpdatedAt'])->sort([asc('RingCode')]);
    mapping: test::umberaviary4::mapping::AviaryLogMapping;
    runtime: test::umberaviary4::runtime::AviaryLogRuntime;
  }
  testSuites:
  [
    latestSuite:
    {
      data:
      [
        connections:
        [
          aviaryLogConnection:
            Relational
            #{
              aviary.ringing_record:
                'ring_code,species_code,age_class,wing_mm,mass_g,ringed_on,created_at,updated_at,in_z,out_z\n'+
                'RR-01,SP-WREN,juvenile,3.25,4.25,2026-03-10,2026-03-10 06:15:00,2026-03-10 07:15:00,2026-03-01,9999-12-31\n'+
                'RR-02,SP-LINNET,adult,,14.25,2026-03-11,2026-03-11 06:15:00,2026-03-11 07:15:00,2026-03-01,9999-12-31\n'+
                'RR-01,SP-WREN,juvenile,8.25,9.25,2026-03-10,2026-03-10 07:15:00,2026-03-10 08:15:00,2026-02-01,2026-03-01\n';
            }#
        ]
      ]
      tests:
      [
        latestVersions:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            latestRowsOnly:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"RingCode":"RR-01","SpeciesCode":"SP-WREN","AgeClass":"juvenile","WingMm":3.25,"MassG":4.25,"RingedOn":"2026-03-10","CreatedAt":"2026-03-10T06:15:00.000000000+0000","UpdatedAt":"2026-03-10T07:15:00.000000000+0000"},{"RingCode":"RR-02","SpeciesCode":"SP-LINNET","AgeClass":"adult","WingMm":null,"MassG":14.25,"RingedOn":"2026-03-11","CreatedAt":"2026-03-11T06:15:00.000000000+0000","UpdatedAt":"2026-03-11T07:15:00.000000000+0000"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

