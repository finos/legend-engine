###Pure
Enum test::sunlitquarry2::domain::Orientation
{
  SOUTH,
  EAST,
  WEST,
  NORTH
}

Enum test::sunlitquarry2::domain::HealthState
{
  OK,
  WATCH,
  FAULT
}

Enum test::sunlitquarry2::domain::InverterClass
{
  STRING_TIED,
  MICRO,
  HYBRID
}

Class test::sunlitquarry2::domain::SolarSite
{
  siteCode: String[1];
  siteName: String[1];
}

Class test::sunlitquarry2::domain::District
{
  districtCode: String[1];
  districtName: String[1];
  wardenName: String[1];
}

Class test::sunlitquarry2::domain::PanelString
{
  stringCode: String[1];
  orientation: test::sunlitquarry2::domain::Orientation[0..1];
  health: test::sunlitquarry2::domain::HealthState[0..1];
  panelCount: Integer[1];
  tiltDeg: Integer[0..1];
  tiltBand: String[0..1];
  yieldTotalKwh: Integer[0..1];
  readingCount: Integer[0..1];
  inverterModel: String[0..1];
  wardenName: String[0..1];
}

Class test::sunlitquarry2::domain::Inverter
{
  inverterCode: String[1];
  kind: test::sunlitquarry2::domain::InverterClass[0..1];
  ratingKw: Integer[1];
}

Class test::sunlitquarry2::domain::ReadingVersion
{
  versionId: Integer[1];
  stringCode: String[1];
  yieldKwh: Integer[1];
}

Association test::sunlitquarry2::domain::Site_String
{
  strings: test::sunlitquarry2::domain::PanelString[*];
  site: test::sunlitquarry2::domain::SolarSite[0..1];
}

Association test::sunlitquarry2::domain::District_Site
{
  sites: test::sunlitquarry2::domain::SolarSite[*];
  district: test::sunlitquarry2::domain::District[0..1];
}
