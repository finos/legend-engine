###DataSpace
DataSpace test::sunlitquarry2::dataspace::SolarEstateDataSpace
{
  executionContexts:
  [
    {
      name: 'estate';
      description: 'Estate context - the rooftop string register resolved against the local estate warehouse through the layered estate mapping.';
      mapping: test::sunlitquarry2::mapping::SolarEstateMapping;
      defaultRuntime: test::sunlitquarry2::runtime::SolarRuntime;
    }
  ];
  defaultExecutionContext: 'estate';
  title: 'Rooftop Array Estate';
  description: 'Discovery surface over the rooftop array estate: panel strings with their tilt bands and health states, the grouped yield tally behind them, and the roofs and wards they sit on.';
  elements:
  [
    test::sunlitquarry2::domain::PanelString,
    test::sunlitquarry2::domain::SolarSite,
    test::sunlitquarry2::domain::District,
    test::sunlitquarry2::domain::Inverter
  ];
  supportInfo: Email
  {
    address: 'array-estate-desk@arrayestate.invalid';
  };
}
