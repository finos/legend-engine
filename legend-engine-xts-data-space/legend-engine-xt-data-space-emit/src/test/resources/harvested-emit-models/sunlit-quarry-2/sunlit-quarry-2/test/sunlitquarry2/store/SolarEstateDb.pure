###Relational
Database test::sunlitquarry2::store::SolarEstateDb
(
  Schema estate
  (
    Table site
    (
      site_code VARCHAR(16) PRIMARY KEY,
      site_name VARCHAR(128),
      district_code VARCHAR(16),
      status_code VARCHAR(4),
      commissioned_at TIMESTAMP
    )

    Table district
    (
      district_code VARCHAR(16) PRIMARY KEY,
      district_name VARCHAR(128),
      warden_name VARCHAR(128)
    )
  )

  Schema solar
  (
    Table panel_string
    (
      string_code VARCHAR(16) PRIMARY KEY,
      site_code VARCHAR(16),
      orientation_code VARCHAR(8),
      health_code VARCHAR(4),
      panel_count INTEGER,
      tilt_deg INTEGER
    )

    Table inverter
    (
      inverter_code VARCHAR(16) PRIMARY KEY,
      string_code VARCHAR(16),
      model_code VARCHAR(32),
      kind_code VARCHAR(4),
      rating_kw INTEGER
    )

    Table reading_version
    (
      version_id INTEGER PRIMARY KEY,
      string_code VARCHAR(16),
      yield_kwh INTEGER,
      active_flag CHAR(1),
      valid_from TIMESTAMP,
      valid_thru TIMESTAMP
    )

    View string_yield_view
    (
      ~groupBy
      (
        solar.reading_version.string_code
      )
      string_code: solar.reading_version.string_code PRIMARY KEY,
      reading_count: count(solar.reading_version.version_id),
      total_yield_kwh: sum(solar.reading_version.yield_kwh)
    )
  )

  Filter CurrentReading(solar.reading_version.valid_thru > now() and solar.reading_version.active_flag = 'Y')
  Filter CommissionedSite(estate.site.commissioned_at <= now() and estate.site.status_code != 'X')

  Join String_Site(solar.panel_string.site_code = estate.site.site_code)
  Join Site_District(estate.site.district_code = estate.district.district_code)
  Join String_Inverter(solar.panel_string.string_code = solar.inverter.string_code)
  Join String_Yield(solar.panel_string.string_code = solar.string_yield_view.string_code)
)
