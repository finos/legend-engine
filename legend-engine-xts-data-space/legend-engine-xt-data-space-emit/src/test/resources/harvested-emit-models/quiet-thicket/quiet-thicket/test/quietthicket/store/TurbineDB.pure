###Relational
Database test::quietthicket::store::TurbineDB
(
  Schema signal
  (
    Table reading
    (
      reading_code VARCHAR(24) PRIMARY KEY,
      sensor_code VARCHAR(24),
      turbine_code VARCHAR(24),
      captured_at TIMESTAMP NOT NULL,
      wind_speed_ms FLOAT NOT NULL,
      power_output_kw FLOAT NOT NULL,
      blade_pitch_deg FLOAT,
      fault_flag BIT NOT NULL
    )

    Table sensor
    (
      sensor_code VARCHAR(24) PRIMARY KEY,
      sensor_model VARCHAR(60) NOT NULL,
      sensor_state VARCHAR(16) NOT NULL,
      mast_code VARCHAR(24),
      installed_at TIMESTAMP NOT NULL,
      calibrated_on DATE
    )
  )

  Schema fleet
  (
    Table turbine
    (
      turbine_code VARCHAR(24) PRIMARY KEY,
      turbine_name VARCHAR(80) NOT NULL,
      site_code VARCHAR(24),
      rated_kw INTEGER NOT NULL,
      commissioned_on DATE
    )

    Table mast
    (
      mast_code VARCHAR(24) PRIMARY KEY,
      mast_label VARCHAR(80) NOT NULL,
      height_metres INTEGER NOT NULL
    )

    Table maintenance_log
    (
      log_code VARCHAR(24) PRIMARY KEY,
      turbine_code VARCHAR(24),
      logged_at TIMESTAMP NOT NULL,
      crew_code VARCHAR(24) NOT NULL,
      hours_spent INTEGER NOT NULL,
      notes VARCHAR(200)
    )
  )

  Schema siteref
  (
    Table site
    (
      site_code VARCHAR(24) PRIMARY KEY,
      site_name VARCHAR(80) NOT NULL,
      region_code VARCHAR(24),
      grid_zone VARCHAR(24)
    )

    Table region
    (
      region_code VARCHAR(24) PRIMARY KEY,
      region_name VARCHAR(80) NOT NULL
    )
  )

  Join Reading_Sensor(signal.reading.sensor_code = signal.sensor.sensor_code and signal.sensor.sensor_state != 'RETIRED')

  Join Reading_Turbine(signal.reading.turbine_code = fleet.turbine.turbine_code)

  Join Sensor_Mast(signal.sensor.mast_code = fleet.mast.mast_code)

  Join Turbine_Site(fleet.turbine.site_code = siteref.site.site_code)

  Join Site_Region(siteref.site.region_code = siteref.region.region_code)

  Join Log_Turbine(fleet.maintenance_log.turbine_code = fleet.turbine.turbine_code)
)
