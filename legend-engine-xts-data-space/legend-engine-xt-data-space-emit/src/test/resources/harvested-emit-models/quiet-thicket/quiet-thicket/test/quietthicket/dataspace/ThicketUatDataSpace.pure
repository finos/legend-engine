###DataSpace
DataSpace test::quietthicket::dataspace::ThicketUatDataSpace
{
  executionContexts:
  [
    {
      name: 'uat';
      description: 'Acceptance context - the same mapping wired to the acceptance warehouse connection.';
      mapping: test::quietthicket::mapping::TurbineMapping;
      defaultRuntime: test::quietthicket::runtime::ThicketUatRuntime;
    }
  ];
  defaultExecutionContext: 'uat';
  title: 'Turbine Telemetry - Acceptance';
  description: 'The acceptance sibling product over the same single mapping, differing from its production twin only in the runtime its lone execution context defaults to. It features the maintenance log endpoint.';
  elements:
  [
    test::quietthicket::domain::MaintenanceLog,
    test::quietthicket::domain::Sensor,
    test::quietthicket::domain::Mast
  ];
  executables:
  [
    {
      id: 1;
      title: 'Maintenance logs on a day';
      description: 'Day-scoped maintenance endpoint over the log timestamp reduced to its date portion.';
      executable: test::quietthicket::service::LogsOnDay;
    }
  ];
  supportInfo: Email
  {
    address: 'turbine-maintenance@windfleet.invalid';
  };
}
