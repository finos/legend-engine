###Service
Service test::quietthicket::service::LogsByCrewEnvironment
{
  pattern: '/thicket/v1/maintenance/keyed/{environment}/{crewCode}';
  title: 'Turbine Telemetry - Maintenance Logs By Crew And Environment';
  documentation: 'The keyed counterpart restricting on a single equality against a caller-supplied crew code, so selectivity rests entirely on that one column while the key decides which warehouse the identical statement is planned for.';
  autoActivateUpdates: false;
  owners:
  [
    'turbine-telemetry',
    'wind-fleet-ops'
  ];
  execution: Multi
  {
    query: {crewCode: String[1]|test::quietthicket::domain::MaintenanceLog.all()->filter(
      l|$l.crewCode == $crewCode
    )->project(
      [
        l|$l.logCode,
        l|$l.loggedAt,
        l|$l.crewCode,
        l|$l.hoursSpent,
        l|$l.loggedTurbine.turbineNameText
      ],
      [
        'Log/Code',
        'Log/LoggedAt',
        'Log/CrewCode',
        'Log/HoursSpent',
        'Fleet/TurbineName'
      ]
    )->sort(
      [
        asc('Log/Code')
      ]
    )};
    key: 'environment';
    executions['prod']:
    {
      mapping: test::quietthicket::mapping::TurbineMapping;
      runtime: test::quietthicket::runtime::ThicketProdRuntime;
    }
    executions['uat']:
    {
      mapping: test::quietthicket::mapping::TurbineMapping;
      runtime: test::quietthicket::runtime::ThicketUatRuntime;
    }
  }
}
