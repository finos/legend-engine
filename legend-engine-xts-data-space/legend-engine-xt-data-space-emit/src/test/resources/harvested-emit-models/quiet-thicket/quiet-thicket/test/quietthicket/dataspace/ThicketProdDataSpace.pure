###DataSpace
DataSpace test::quietthicket::dataspace::ThicketProdDataSpace
{
  executionContexts:
  [
    {
      name: 'prod';
      description: 'Production context - the one mapping wired to the production warehouse connection.';
      mapping: test::quietthicket::mapping::TurbineMapping;
      defaultRuntime: test::quietthicket::runtime::ThicketProdRuntime;
    }
  ];
  defaultExecutionContext: 'prod';
  title: 'Turbine Telemetry - Production';
  description: 'The production sibling product over the single turbine telemetry mapping. It publishes the reading extent with the fleet and site reference classes its join paths traverse, and features the day-scoped reading endpoint.';
  elements:
  [
    test::quietthicket::domain::SensorReading,
    test::quietthicket::domain::Turbine,
    test::quietthicket::domain::Site
  ];
  executables:
  [
    {
      id: 1;
      title: 'Readings on a day';
      description: 'Day-scoped reading endpoint whose predicate reduces the capture timestamp to its date portion.';
      executable: test::quietthicket::service::ReadingsOnDay;
    },
    {
      id: 2;
      title: 'Readings through a day';
      description: 'Upper-bounded endpoint over the derived capture date, which it also projects as its own column.';
      executable: test::quietthicket::service::ReadingsThroughDay;
    }
  ];
  supportInfo: Email
  {
    address: 'turbine-telemetry@windfleet.invalid';
  };
}
