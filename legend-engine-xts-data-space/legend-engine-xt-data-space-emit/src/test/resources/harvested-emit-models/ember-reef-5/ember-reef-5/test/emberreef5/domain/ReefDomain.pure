Class <<temporal.processingtemporal>> {doc.doc = 'A satellite-derived thermal stress index for the reef pixel.'} test::emberreef5::domain::ThermalStressIndex
{
  {doc.doc = 'Identifier of the report, stable across processing versions.'} reportCode: String[1];
  {doc.doc = 'Identifier of the reporting buoy or survey site.'} buoyCode: String[1];
  {doc.doc = 'Accumulated thermal stress in degree heating weeks.'} degreeHeatingWeeks: Float[0..1];
  {doc.doc = 'Positive anomaly above the climatological maximum.'} hotspotC: Float[0..1];
  {doc.doc = 'Signed temperature anomaly against the baseline.'} anomalyC: Float[0..1];
  {doc.doc = 'Continuous alert score derived from the hotspot.'} alertScore: Float[0..1];
  {doc.doc = 'Cloud cover fraction over the pixel.'} cloudFraction: Float[0..1];
  {doc.doc = 'Mean wind speed over the pixel in metres per second.'} windSpeedMs: Float[0..1];
  {doc.doc = 'Instant the reading window closed.'} readAt: DateTime[0..1];
}

Profile test::emberreef5::profile::ReefVendorProfile
{
  stereotypes: [vendorSourced, openLicensed];
  tags: [licenceStatus, provider];
}

Profile test::emberreef5::profile::ReefPrivacyProfile
{
  stereotypes: [publicObservation, restrictedObservation];
}
