Class <<temporal.processingtemporal>> {doc.doc = 'A daily lagoon-buoy summary of temperature, tide and nutrient readings.'} test::emberreef5::domain::LagoonBuoyDaily
{
  {doc.doc = 'Identifier of the report, stable across processing versions.'} reportCode: String[1];
  {doc.doc = 'Identifier of the reporting buoy or survey site.'} buoyCode: String[1];
  {doc.doc = 'Daily mean lagoon temperature in degrees Celsius.'} meanTempC: Float[0..1];
  {doc.doc = 'Daily maximum lagoon temperature in degrees Celsius.'} maxTempC: Float[0..1];
  {doc.doc = 'Daily minimum lagoon temperature in degrees Celsius.'} minTempC: Float[0..1];
  {doc.doc = 'Daily tidal range at the lagoon mouth in metres.'} tidalRangeM: Float[0..1];
  {doc.doc = 'Nitrate concentration in micromoles.'} nitrateUm: Float[0..1];
  {doc.doc = 'Phosphate concentration in micromoles.'} phosphateUm: Float[0..1];
  {doc.doc = 'Silicate concentration in micromoles.'} silicateUm: Float[0..1];
  {doc.doc = 'Settled sediment load on the trap plate.'} sedimentLoad: Float[0..1];
  {doc.doc = 'Instant the reading window closed.'} readAt: DateTime[0..1];
}

