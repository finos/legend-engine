Class <<temporal.processingtemporal>> {doc.doc = 'A diver transect survey of coral cover, bleaching and grazers.'} test::emberreef5::domain::PolypTransectSurvey
{
  {doc.doc = 'Identifier of the report, stable across processing versions.'} reportCode: String[1];
  {doc.doc = 'Identifier of the reporting buoy or survey site.'} buoyCode: String[1];
  {doc.doc = 'Live coral cover along the transect in percent.'} coverPct: Float[0..1];
  {doc.doc = 'Bleached colony share along the transect in percent.'} bleachedPct: Float[0..1];
  {doc.doc = 'Juvenile recruits per square metre.'} recruitDensity: Float[0..1];
  {doc.doc = 'Macroalgae cover along the transect in percent.'} algaeCoverPct: Float[0..1];
  {doc.doc = 'Chain-and-tape rugosity of the transect.'} rugosityIndex: Float[0..1];
  {doc.doc = 'Grazing urchins per square metre.'} grazerDensity: Float[0..1];
  {doc.doc = 'Estimated reef fish biomass per hundred square metres.'} fishBiomassKg: Float[0..1];
  {doc.doc = 'Instant the reading window closed.'} readAt: DateTime[0..1];
}

