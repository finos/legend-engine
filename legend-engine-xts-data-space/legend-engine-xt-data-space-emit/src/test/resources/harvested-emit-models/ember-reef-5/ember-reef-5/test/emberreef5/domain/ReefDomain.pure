###Pure
import meta::pure::profiles::*;

Class <<temporal.processingtemporal>> {doc.doc = 'An hourly crest-buoy water-quality report. Each correction is a new processing version of the same report.'} test::emberreef5::domain::CrestBuoyHourly
{
  {doc.doc = 'Identifier of the report, stable across processing versions.'} reportCode: String[1];
  {doc.doc = 'Identifier of the reporting buoy or survey site.'} buoyCode: String[1];
  {doc.doc = 'Water temperature at the crest sensor in degrees Celsius.'} waterTempC: Float[0..1];
  {doc.doc = 'Practical salinity at the crest sensor.'} salinityPsu: Float[0..1];
  {doc.doc = 'Acidity reading of the surrounding water column.'} phLevel: Float[0..1];
  {doc.doc = 'Optical turbidity of the water column.'} turbidityNtu: Float[0..1];
  {doc.doc = 'Dissolved oxygen concentration in milligrams per litre.'} dissolvedOxygen: Float[0..1];
  {doc.doc = 'Chlorophyll fluorescence in micrograms per litre.'} chlorophyllUg: Float[0..1];
  {doc.doc = 'Photosynthetically active radiation at the canopy.'} parLight: Float[0..1];
  {doc.doc = 'Mean current speed across the reading window.'} currentSpeed: Float[0..1];
  {doc.doc = 'Significant wave height in metres.'} waveHeightM: Float[0..1];
  {doc.doc = 'Instant the reading window closed.'} readAt: DateTime[0..1];
}

Class <<temporal.processingtemporal>> {doc.doc = 'The revised-calibration variant of the hourly crest-buoy report, with the same shape as the primary variant.'} test::emberreef5::domain::CrestBuoyHourlyRevised
