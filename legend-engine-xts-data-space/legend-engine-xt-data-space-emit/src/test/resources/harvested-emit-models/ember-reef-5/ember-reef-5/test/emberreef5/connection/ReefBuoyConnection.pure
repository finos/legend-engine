###Connection
RelationalDatabaseConnection test::emberreef5::connection::ReefBuoyConnection
{
  store: test::emberreef5::store::ReefBuoyDb;
  type: Snowflake;
  quoteIdentifiers: true;
  specification: Snowflake
  {
    name: 'REEF_BUOY_DB';
    account: 'reef_buoy_account';
    warehouse: 'REEF_BUOY_WH';
    region: 'ap-southeast-2';
    cloudType: 'aws';
    role: 'REEF_BUOY_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'REEF_BUOY_READER_USER';
    privateKeyVaultReference: 'reef-buoy-private-key';
    passPhraseVaultReference: 'reef-buoy-passphrase';
  };
}
