###Service
Service test::emberreef5::service::LagoonBuoyDailyExtract
{
  pattern: '/emberreef5/v1/lagoonbuoydaily';
  ownership: DID { identifier: '000000' };
  documentation: 'Publishes every property of the LagoonBuoyDaily report at its latest processing version as a tabular result.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {|test::emberreef5::domain::LagoonBuoyDaily.all(%latest)->project(
      [
        x|$x.reportCode,
        x|$x.buoyCode,
        x|$x.meanTempC,
        x|$x.maxTempC,
        x|$x.minTempC,
        x|$x.tidalRangeM,
        x|$x.nitrateUm,
        x|$x.phosphateUm,
        x|$x.silicateUm,
        x|$x.sedimentLoad,
        x|$x.readAt
      ],
      [
        'ReportCode',
        'BuoyCode',
        'MeanTempC',
        'MaxTempC',
        'MinTempC',
        'TidalRangeM',
        'NitrateUm',
        'PhosphateUm',
        'SilicateUm',
        'SedimentLoad',
        'ReadAt'
      ]
    )->sort([asc('ReportCode')])};
    mapping: test::emberreef5::mapping::ReefBuoyMapping;
    runtime: test::emberreef5::runtime::ReefBuoyRuntime;
  }
  testSuites:
  [
    latestSuite:
    {
      data:
      [
        connections:
        [
          reefBuoyConnection:
            Relational
            #{
              reef.lagoon_buoy_daily:
                'report_code,buoy_code,mean_temp_c,max_temp_c,min_temp_c,tidal_range_m,nitrate_um,phosphate_um,silicate_um,sediment_load,read_at,in_z,out_z\n'+
                'LD-01,B-3A,12.75,13.25,13.75,14.25,14.75,15.25,15.75,16.25,2026-03-01 06:15:00,2026-02-01,9999-12-31\n'+
                'LD-02,B-3B,22.75,,23.75,24.25,24.75,25.25,25.75,26.25,2026-03-02 07:45:00,2026-02-01,9999-12-31\n'+
                'LD-01,B-3A,32.75,33.25,33.75,34.25,34.75,35.25,35.75,36.25,2026-02-27 05:30:00,2026-01-01,2026-02-01\n';
            }#
        ]
      ]
      tests:
      [
        latestVersions:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            supersededVersionIsDropped:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"ReportCode":"LD-01","BuoyCode":"B-3A","MeanTempC":12.75,"MaxTempC":13.25,"MinTempC":13.75,"TidalRangeM":14.25,"NitrateUm":14.75,"PhosphateUm":15.25,"SilicateUm":15.75,"SedimentLoad":16.25,"ReadAt":"2026-03-01T06:15:00.000000000+0000"},{"ReportCode":"LD-02","BuoyCode":"B-3B","MeanTempC":22.75,"MaxTempC":null,"MinTempC":23.75,"TidalRangeM":24.25,"NitrateUm":24.75,"PhosphateUm":25.25,"SilicateUm":25.75,"SedimentLoad":26.25,"ReadAt":"2026-03-02T07:45:00.000000000+0000"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

