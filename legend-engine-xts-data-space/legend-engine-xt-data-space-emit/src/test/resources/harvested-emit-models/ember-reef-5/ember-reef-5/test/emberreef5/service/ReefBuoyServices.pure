###Service
Service test::emberreef5::service::ThermalStressIndexExtract
{
  pattern: '/emberreef5/v1/thermalstressindex';
  ownership: DID { identifier: '000000' };
  documentation: 'Publishes every property of the ThermalStressIndex report at its latest processing version as a tabular result.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {|test::emberreef5::domain::ThermalStressIndex.all(%latest)->project(
      [
        x|$x.reportCode,
        x|$x.buoyCode,
        x|$x.degreeHeatingWeeks,
        x|$x.hotspotC,
        x|$x.anomalyC,
        x|$x.alertScore,
        x|$x.cloudFraction,
        x|$x.windSpeedMs,
        x|$x.readAt
