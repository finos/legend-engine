###Service
Service test::emberreef5::service::PolypTransectSurveyExtract
{
  pattern: '/emberreef5/v1/polyptransectsurvey';
  ownership: DID { identifier: '000000' };
  documentation: 'Publishes every property of the PolypTransectSurvey report at its latest processing version as a tabular result.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {|test::emberreef5::domain::PolypTransectSurvey.all(%latest)->project(
      [
        x|$x.reportCode,
        x|$x.buoyCode,
        x|$x.coverPct,
        x|$x.bleachedPct,
        x|$x.recruitDensity,
        x|$x.algaeCoverPct,
        x|$x.rugosityIndex,
        x|$x.grazerDensity,
        x|$x.fishBiomassKg,
        x|$x.readAt
      ],
      [
        'ReportCode',
        'BuoyCode',
        'CoverPct',
        'BleachedPct',
        'RecruitDensity',
        'AlgaeCoverPct',
        'RugosityIndex',
        'GrazerDensity',
        'FishBiomassKg',
        'ReadAt'
      ]
    )->sort([asc('ReportCode')])};
    mapping: test::emberreef5::mapping::ReefBuoyMapping;
    runtime: test::emberreef5::runtime::ReefBuoyRuntime;
  }
  testSuites:
  [
    latestSuite:
    {
      data:
      [
        connections:
        [
          reefBuoyConnection:
            Relational
            #{
              reef.polyp_transect_survey:
