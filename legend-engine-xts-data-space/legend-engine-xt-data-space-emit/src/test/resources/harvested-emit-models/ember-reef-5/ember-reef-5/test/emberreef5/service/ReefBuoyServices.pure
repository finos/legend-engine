      [
        'ReportCode',
        'BuoyCode',
        'DegreeHeatingWeeks',
        'HotspotC',
        'AnomalyC',
        'AlertScore',
        'CloudFraction',
        'WindSpeedMs',
        'ReadAt'
      ]
    )->distinct()->sort([asc('ReportCode')])};
    mapping: test::emberreef5::mapping::ReefBuoyMapping;
