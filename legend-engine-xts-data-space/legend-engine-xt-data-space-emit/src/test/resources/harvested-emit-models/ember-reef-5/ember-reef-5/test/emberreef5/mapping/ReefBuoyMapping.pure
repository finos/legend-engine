  testSuites:
  [
    crestBuoyHourlyLatestSuite:
    {
      function: |test::emberreef5::domain::CrestBuoyHourly.all(%latest)->project(
        [
          x|$x.reportCode,
          x|$x.buoyCode,
          x|$x.waterTempC,
          x|$x.salinityPsu,
          x|$x.phLevel,
          x|$x.turbidityNtu,
          x|$x.dissolvedOxygen,
          x|$x.chlorophyllUg,
          x|$x.parLight,
          x|$x.currentSpeed,
          x|$x.waveHeightM,
          x|$x.readAt
        ],
        [
          'ReportCode',
          'BuoyCode',
          'WaterTempC',
          'SalinityPsu',
          'PhLevel',
          'TurbidityNtu',
          'DissolvedOxygen',
          'ChlorophyllUg',
          'ParLight',
          'CurrentSpeed',
          'WaveHeightM',
          'ReadAt'
        ]
      )->sort([asc('ReportCode')]);
      tests:
      [
        latestVersionOnly:
        {
          doc: 'Two current reports and one superseded processing version of the first report; the superseded version is out of range at the latest instant and must not be returned, and the null optional reading surfaces as an empty cell.';
          data:
          [
            test::emberreef5::store::ReefBuoyDb:
              Relational
              #{
                reef.crest_buoy_hourly:
                  'report_code,buoy_code,water_temp_c,salinity_psu,ph_level,turbidity_ntu,dissolved_oxygen,chlorophyll_ug,par_light,current_speed,wave_height_m,read_at,in_z,out_z\n'+
                  'CH-01,B-1A,10.25,10.75,11.25,11.75,12.25,12.75,13.25,13.75,14.25,2026-03-01 06:15:00,2026-02-01,9999-12-31\n'+
                  'CH-02,B-1B,20.25,,21.25,21.75,22.25,22.75,23.25,23.75,24.25,2026-03-02 07:45:00,2026-02-01,9999-12-31\n'+
                  'CH-01,B-1A,30.25,30.75,31.25,31.75,32.25,32.75,33.25,33.75,34.25,2026-02-27 05:30:00,2026-01-01,2026-02-01\n';
              }#
          ];
          asserts:
          [
            supersededVersionIsDropped:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"ReportCode":"CH-01","BuoyCode":"B-1A","WaterTempC":10.25,"SalinityPsu":10.75,"PhLevel":11.25,"TurbidityNtu":11.75,"DissolvedOxygen":12.25,"ChlorophyllUg":12.75,"ParLight":13.25,"CurrentSpeed":13.75,"WaveHeightM":14.25,"ReadAt":"2026-03-01T06:15:00.000000000+0000"},{"ReportCode":"CH-02","BuoyCode":"B-1B","WaterTempC":20.25,"SalinityPsu":null,"PhLevel":21.25,"TurbidityNtu":21.75,"DissolvedOxygen":22.25,"ChlorophyllUg":22.75,"ParLight":23.25,"CurrentSpeed":23.75,"WaveHeightM":24.25,"ReadAt":"2026-03-02T07:45:00.000000000+0000"}]';
                  }#;
              }#
          ];
        }
      ];
    },
    polypTransectSurveyLatestSuite:
    {
      function: |test::emberreef5::domain::PolypTransectSurvey.all(%latest)->project(
        [
          x|$x.reportCode,
          x|$x.buoyCode,
          x|$x.coverPct,
          x|$x.bleachedPct,
          x|$x.recruitDensity,
          x|$x.algaeCoverPct,
          x|$x.rugosityIndex,
          x|$x.grazerDensity,
          x|$x.fishBiomassKg,
          x|$x.readAt
        ],
        [
          'ReportCode',
          'BuoyCode',
          'CoverPct',
          'BleachedPct',
          'RecruitDensity',
          'AlgaeCoverPct',
          'RugosityIndex',
          'GrazerDensity',
          'FishBiomassKg',
          'ReadAt'
        ]
      )->sort([asc('ReportCode')]);
      tests:
      [
        latestVersionOnly:
        {
          doc: 'Two current reports and one superseded processing version of the first report; the superseded version is out of range at the latest instant and must not be returned, and the null optional reading surfaces as an empty cell.';
          data:
          [
            test::emberreef5::store::ReefBuoyDb:
              Relational
              #{
                reef.polyp_transect_survey:
                  'report_code,buoy_code,cover_pct,bleached_pct,recruit_density,algae_cover_pct,rugosity_index,grazer_density,fish_biomass_kg,read_at,in_z,out_z\n'+
                  'PT-01,B-5A,15.25,15.75,16.25,16.75,17.25,17.75,18.25,2026-03-01 06:15:00,2026-02-01,9999-12-31\n'+
                  'PT-02,B-5B,25.25,,26.25,26.75,27.25,27.75,28.25,2026-03-02 07:45:00,2026-02-01,9999-12-31\n'+
                  'PT-01,B-5A,35.25,35.75,36.25,36.75,37.25,37.75,38.25,2026-02-27 05:30:00,2026-01-01,2026-02-01\n';
              }#
          ];
          asserts:
          [
            supersededVersionIsDropped:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"ReportCode":"PT-01","BuoyCode":"B-5A","CoverPct":15.25,"BleachedPct":15.75,"RecruitDensity":16.25,"AlgaeCoverPct":16.75,"RugosityIndex":17.25,"GrazerDensity":17.75,"FishBiomassKg":18.25,"ReadAt":"2026-03-01T06:15:00.000000000+0000"},{"ReportCode":"PT-02","BuoyCode":"B-5B","CoverPct":25.25,"BleachedPct":null,"RecruitDensity":26.25,"AlgaeCoverPct":26.75,"RugosityIndex":27.25,"GrazerDensity":27.75,"FishBiomassKg":28.25,"ReadAt":"2026-03-02T07:45:00.000000000+0000"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
