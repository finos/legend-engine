###DataSpace
DataSpace <<test::emberreef5::profile::ReefPrivacyProfile.publicObservation, test::emberreef5::profile::ReefVendorProfile.vendorSourced>> {test::emberreef5::profile::ReefVendorProfile.licenceStatus = 'open-observation', test::emberreef5::profile::ReefVendorProfile.provider = 'reef-buoy-collective'} test::emberreef5::dataspace::ReefBuoyDataSpace
{
  executionContexts:
  [
    {
      name: 'observed';
      description: 'Latest processing versions of every buoy, survey and stress report.';
      mapping: test::emberreef5::mapping::ReefBuoyMapping;
      defaultRuntime: test::emberreef5::runtime::ReefBuoyRuntime;
    }
  ];
  defaultExecutionContext: 'observed';
  title: 'Reef Buoy Observatory';
  description: 'Crest and lagoon buoy reports, diver transect surveys and the satellite thermal stress index for a fringing reef, each published at its latest processing version.';
  elements:
  [
    test::emberreef5::domain
  ];
  executables:
  [
    {
      id: 1;
      title: 'CrestBuoyHourly extract';
      description: 'Latest processing versions of the CrestBuoyHourly report.';
      executable: test::emberreef5::service::CrestBuoyHourlyExtract;
      executionContextKey: 'observed';
    },
    {
      id: 2;
      title: 'CrestBuoyHourlyRevised extract';
      description: 'Latest processing versions of the CrestBuoyHourlyRevised report.';
      executable: test::emberreef5::service::CrestBuoyHourlyRevisedExtract;
      executionContextKey: 'observed';
    },
    {
      id: 3;
      title: 'LagoonBuoyDaily extract';
      description: 'Latest processing versions of the LagoonBuoyDaily report.';
      executable: test::emberreef5::service::LagoonBuoyDailyExtract;
      executionContextKey: 'observed';
    },
    {
      id: 4;
      title: 'LagoonBuoyDailyRevised extract';
      description: 'Latest processing versions of the LagoonBuoyDailyRevised report.';
      executable: test::emberreef5::service::LagoonBuoyDailyRevisedExtract;
      executionContextKey: 'observed';
    },
    {
      id: 5;
      title: 'PolypTransectSurvey extract';
      description: 'Latest processing versions of the PolypTransectSurvey report.';
      executable: test::emberreef5::service::PolypTransectSurveyExtract;
      executionContextKey: 'observed';
    },
    {
      id: 6;
      title: 'PolypTransectSurveyRevised extract';
      description: 'Latest processing versions of the PolypTransectSurveyRevised report.';
      executable: test::emberreef5::service::PolypTransectSurveyRevisedExtract;
      executionContextKey: 'observed';
    },
    {
      id: 7;
      title: 'ThermalStressIndex extract';
      description: 'Latest processing versions of the ThermalStressIndex report.';
      executable: test::emberreef5::service::ThermalStressIndexExtract;
      executionContextKey: 'observed';
    }
  ];
  supportInfo: Combined
  {
    emails: ['reef-buoy-observatory-stewards'];
  };
}
