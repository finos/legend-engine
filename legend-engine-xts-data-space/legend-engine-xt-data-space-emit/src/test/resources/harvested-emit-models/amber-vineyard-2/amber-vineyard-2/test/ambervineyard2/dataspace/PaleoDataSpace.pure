###DataSpace
DataSpace test::ambervineyard2::dataspace::PaleoDataSpace
{
  executionContexts:
  [
    {
      name: 'default';
      description: 'Curated entry point over the fossil dig catalogue, resolving the composed mapping against the warehouse runtime.';
      mapping: test::ambervineyard2::mapping::PaleoMapping;
      defaultRuntime: test::ambervineyard2::runtime::PaleoRuntime;
    }
  ];
  defaultExecutionContext: 'default';
  title: 'Fossil Dig Catalogue';
  description: 'A single consumable surface over the fossil dig catalogue - milestoned fossils, their dig sites, excavators and taxon references - naming the composed relational mapping and the warehouse runtime that serves it.';
  diagrams:
  [
    {
      title: 'Fossil Catalogue Overview';
      description: 'Fossils specialising the base dig record, and the dig sites and excavators they reach.';
      diagram: test::ambervineyard2::diagram::PaleoDiagram;
    }
  ];
  elements:
  [
    test::ambervineyard2::domain::Fossil,
    test::ambervineyard2::domain::DigSite
  ];
  supportInfo: Combined
  {
    emails:
    [
      'fossil-catalogue-support-group',
      'paleo-research-support-group'
    ];
  };
}
