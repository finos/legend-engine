###Relational
Database test::ambervineyard2::store::FossilStore
(
  Schema fossil
  (
    Table dig_fossil
    (
      milestoning
      (
        business(BUS_FROM = valid_from, BUS_THRU = valid_thru)
      )
      fossil_id INTEGER PRIMARY KEY,
      catalogue_number VARCHAR(40) NOT NULL,
      taxon_name VARCHAR(200) NOT NULL,
      era_code INTEGER NOT NULL,
      grade_code INTEGER,
      collector VARCHAR(120) NOT NULL,
      method VARCHAR(60),
      length_cm FLOAT,
      mass_g FLOAT,
      ref_code VARCHAR(40),
      site_id INTEGER,
      parent_fossil_id INTEGER,
      valid_from DATE PRIMARY KEY,
      valid_thru DATE
    )

    Table note_primary
    (
      note_id VARCHAR(40) PRIMARY KEY,
      kind VARCHAR(40) NOT NULL,
      body VARCHAR(400) NOT NULL
    )
    Table note_secondary
    (
      note_id VARCHAR(40) PRIMARY KEY,
      kind VARCHAR(40) NOT NULL,
      body VARCHAR(400) NOT NULL
    )
  )

  Schema catalog
  (
    Table taxon_ref
    (
      ref_code VARCHAR(40) PRIMARY KEY,
      ref_type_code VARCHAR(20) NOT NULL,
      authority_name VARCHAR(200) NOT NULL
    )
  )
)
