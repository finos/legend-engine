###Connection
RelationalDatabaseConnection test::amberlighthouse3::connection::LighthouseConnection
{
  store: test::amberlighthouse3::store::LighthouseDb;
  type: H2;
  specification: LocalH2
  {
    testDataSetupSqls: [
      'drop schema if exists coastal;',
      'create schema coastal;',
      'create table coastal.lighthouse_station (station_id integer primary key, station_code varchar(16) not null, station_label varchar(64) not null, coast_code varchar(16) not null, lens_grade_char varchar(4) not null);',
      'create table coastal.lamp_fitting (lamp_id integer primary key, station_code varchar(16) not null, lamp_code varchar(16) not null, lamp_kind varchar(24) not null, wattage integer not null);'
      ];
  };
  auth: DefaultH2;
}
