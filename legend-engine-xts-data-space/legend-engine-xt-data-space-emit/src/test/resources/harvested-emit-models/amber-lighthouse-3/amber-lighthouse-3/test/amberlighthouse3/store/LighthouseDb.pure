###Relational
Database test::amberlighthouse3::store::LighthouseDb
(
  Schema coastal
  (
    Table lighthouse_station
    (
      station_id INTEGER PRIMARY KEY,
      station_code VARCHAR(16) NOT NULL,
      station_label VARCHAR(64) NOT NULL,
      coast_code VARCHAR(16) NOT NULL,
      lens_grade_char VARCHAR(4) NOT NULL
    )

    Table lamp_fitting
    (
      lamp_id INTEGER PRIMARY KEY,
      station_code VARCHAR(16) NOT NULL,
      lamp_code VARCHAR(16) NOT NULL,
      lamp_kind VARCHAR(24) NOT NULL,
      wattage INTEGER NOT NULL
    )

    View coast_tending_summary
    (
      ~groupBy (coastal.lighthouse_station.coast_code)
      coast_code: coastal.lighthouse_station.coast_code PRIMARY KEY,
      station_count: count(coastal.lighthouse_station.station_code)
    )
  )

  Join Station_Lamp(coastal.lighthouse_station.station_code = coastal.lamp_fitting.station_code)
)
