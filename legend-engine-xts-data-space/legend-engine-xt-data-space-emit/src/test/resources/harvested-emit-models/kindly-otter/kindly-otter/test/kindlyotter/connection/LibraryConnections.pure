###Connection
RelationalDatabaseConnection test::kindlyotter::connection::LibraryPrimaryConnection
{
  store: test::kindlyotter::store::LibraryBranchDb;
  type: Snowflake;
  timezone: 'UTC';
  specification: Snowflake
  {
    name: 'LIBRARY_BRANCH_DB';
    account: 'library_branch_account';
    warehouse: 'LIBRARY_PRIMARY_WH';
    region: 'eu-west-1';
    cloudType: 'aws';
    accountType: MultiTenant;
    organization: 'kindly_library_org';
    role: 'LIBRARY_PRIMARY_READER';
  };
  auth: OAuth
  {
    oauthKey: 'library_primary_oauth_key';
    scopeName: 'SESSION:ROLE:LIBRARY_PRIMARY_READER';
  };
  postProcessors:
  [
    mapper
    {
      mappers:
      [
        schema {from: 'libmain'; to: 'lib_primary';},
        table {from: 'branch_month'; to: 'branch_month_p'; schemaFrom: 'libmain'; schemaTo: 'lib_primary';},
        table {from: 'branch_profile'; to: 'branch_profile_p'; schemaFrom: 'libmain'; schemaTo: 'lib_primary';},
        table {from: 'title_stock'; to: 'title_stock_p'; schemaFrom: 'libmain'; schemaTo: 'lib_primary';},
        table {from: 'volunteer_hours'; to: 'volunteer_hours_p'; schemaFrom: 'libmain'; schemaTo: 'lib_primary';},
        table {from: 'outreach_event'; to: 'outreach_event_p'; schemaFrom: 'libmain'; schemaTo: 'lib_primary';}
      ];
    }
  ];
}

###Connection
RelationalDatabaseConnection test::kindlyotter::connection::LibraryMirrorConnection
{
  store: test::kindlyotter::store::LibraryBranchDb;
  type: Snowflake;
  timezone: 'UTC';
  specification: Snowflake
  {
    name: 'LIBRARY_BRANCH_DB';
    account: 'library_branch_account';
    warehouse: 'LIBRARY_MIRROR_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    accountType: MultiTenant;
    organization: 'kindly_library_org';
    role: 'LIBRARY_MIRROR_READER';
  };
  auth: OAuth
  {
    oauthKey: 'library_mirror_oauth_key';
    scopeName: 'SESSION:ROLE:LIBRARY_MIRROR_READER';
  };
  postProcessors:
  [
    mapper
    {
      mappers:
      [
        schema {from: 'libmain'; to: 'lib_mirror';},
        table {from: 'branch_month'; to: 'branch_month_m'; schemaFrom: 'libmain'; schemaTo: 'lib_mirror';},
        table {from: 'branch_profile'; to: 'branch_profile_m'; schemaFrom: 'libmain'; schemaTo: 'lib_mirror';},
        table {from: 'title_stock'; to: 'title_stock_m'; schemaFrom: 'libmain'; schemaTo: 'lib_mirror';},
        table {from: 'volunteer_hours'; to: 'volunteer_hours_m'; schemaFrom: 'libmain'; schemaTo: 'lib_mirror';},
        table {from: 'outreach_event'; to: 'outreach_event_m'; schemaFrom: 'libmain'; schemaTo: 'lib_mirror';}
      ];
    }
  ];
}
