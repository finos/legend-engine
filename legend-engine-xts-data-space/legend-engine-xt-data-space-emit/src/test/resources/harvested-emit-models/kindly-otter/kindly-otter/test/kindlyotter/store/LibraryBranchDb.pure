###Relational
Database test::kindlyotter::store::LibraryBranchDb
(
  Schema libmain
  (
    Table branch_month
    (
      branch_code VARCHAR(16) PRIMARY KEY,
      period_code VARCHAR(8) PRIMARY KEY,
      checkouts_m01 INTEGER,
      checkouts_m02 INTEGER,
      checkouts_m03 INTEGER,
      checkouts_m04 INTEGER,
      checkouts_m05 INTEGER,
      checkouts_m06 INTEGER,
      checkouts_m07 INTEGER,
      checkouts_m08 INTEGER,
      checkouts_m09 INTEGER,
      checkouts_m10 INTEGER,
      checkouts_m11 INTEGER,
      checkouts_m12 INTEGER,
      annual_total INTEGER,
      note_text VARCHAR(128)
    )
    Table branch_profile
    (
      branch_code VARCHAR(16) PRIMARY KEY,
      branch_name VARCHAR(128),
      district_code VARCHAR(16),
      opened_year INTEGER,
      seat_count INTEGER,
      service_grade VARCHAR(4)
    )
    Table title_stock
    (
      stock_code VARCHAR(16) PRIMARY KEY,
      branch_code VARCHAR(16),
      media_type VARCHAR(16),
      copy_count INTEGER,
      hold_count INTEGER,
      retired_flag VARCHAR(1)
    )
    Table volunteer_hours
    (
      volunteer_code VARCHAR(16) PRIMARY KEY,
      period_code VARCHAR(8) PRIMARY KEY,
      branch_code VARCHAR(16),
      logged_hours DOUBLE,
      badge_grade VARCHAR(4)
    )
    Table outreach_event
    (
      event_code VARCHAR(16) PRIMARY KEY,
      branch_code VARCHAR(16),
      event_date DATE,
      attendance INTEGER,
      theme_code VARCHAR(16)
    )
  )
)
