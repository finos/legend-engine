###DataSpace
DataSpace {meta::pure::profiles::doc.doc = 'Governed publication of the branch lending record set.'} test::kindlyotter::dataspace::LibraryBranchDataSpace
{
  executionContexts:
  [
    {
      name: 'primary';
      description: 'Primary estate - the single mapping resolved through the connection that rewrites every declared relation onto the primary namespace.';
      mapping: test::kindlyotter::mapping::LibraryBranchMapping;
      defaultRuntime: test::kindlyotter::runtime::LibraryPrimaryRuntime;
    },
    {
      name: 'mirror';
      description: 'Mirror estate - the same mapping resolved through the connection that rewrites the same relations onto the mirrored namespace.';
      mapping: test::kindlyotter::mapping::LibraryBranchMapping;
      defaultRuntime: test::kindlyotter::runtime::LibraryMirrorRuntime;
    }
  ];
  defaultExecutionContext: 'primary';
  title: 'Kindly Library Branch Records';
  description: 'A governed entry point over the branch record set - wide monthly lending series, branch service profiles, shelved stock with its reservation queue, volunteer periods and the outreach register - published against two physical estates reached by identifier rewriting alone.';
  diagrams:
  [
    {
      title: 'Branch Records';
      diagram: test::kindlyotter::diagram::BranchRecordDiagram;
    },
    {
      title: 'Branch Activity';
      diagram: test::kindlyotter::diagram::BranchActivityDiagram;
    }
  ];
  elements:
  [
    test::kindlyotter::domain
  ];
  executables:
  [
    {
      id: 1;
      title: 'Monthly lending series';
      description: 'Featured endpoint returning the wide monthly lending series per branch year.';
      executable: test::kindlyotter::service::BranchMonthSeriesFeed;
    },
    {
      id: 2;
      title: 'Stock and reservations';
      description: 'Featured endpoint returning the shelved stock lines with their reservation queue.';
      executable: test::kindlyotter::service::TitleStockFeed;
    }
  ];
  supportInfo: Email {
    address: 'branch-records-desk@example.invalid';
  };
}
