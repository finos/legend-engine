###DataSpace
DataSpace test::copperisle3::dataspace::IsleSurveyDataSpace
{
  executionContexts:
  [
    {
      name: 'colonyCensus';
      description: 'Primary tier - colony counts, isle sectors and observer shifts read through the census mapping.';
      mapping: test::copperisle3::mapping::IsleSurveyMapping;
      defaultRuntime: test::copperisle3::runtime::IsleSurveyRuntime;
    }
  ];
  defaultExecutionContext: 'colonyCensus';
  title: 'Copper Isle Seabird Census';
  description: 'A governed entry point over the seabird colony census: nest, chick and adult counts per isle sector, the sector register itself and the observer shift roster, all published through one census mapping and its survey runtime, with a stored diagram fixing the curated class view.';
}
