###Relational
Database test::copperisle3::store::IsleSurveyDb
(
  Schema isle
  (
    Table colony_count
    (
      count_id INTEGER PRIMARY KEY,
      sector_code VARCHAR(16) NOT NULL,
      species_code VARCHAR(16) NOT NULL,
      nest_count INTEGER NOT NULL,
      chick_count INTEGER NOT NULL,
      adult_count INTEGER NOT NULL,
      count_date DATE NOT NULL,
      survey_method VARCHAR(24) NOT NULL,
      tide_state VARCHAR(16) NOT NULL,
      visibility_class VARCHAR(16) NOT NULL
    )

    Table isle_sector
    (
      sector_code VARCHAR(16) PRIMARY KEY,
      sector_name VARCHAR(64) NOT NULL,
      cliff_height_m DOUBLE NOT NULL,
      access_grade VARCHAR(16) NOT NULL,
      habitat_class VARCHAR(32) NOT NULL
    )

    Table observer_shift
    (
      shift_id INTEGER PRIMARY KEY,
      observer_name VARCHAR(64) NOT NULL,
      shift_date DATE NOT NULL,
      hours_logged DOUBLE NOT NULL,
      station_code VARCHAR(16) NOT NULL
    )
  )
)
