###Service
Service test::copperisle3::service::ColonyCensusFilter
{
  pattern: '/copperisle/v1/colony-census/{speciesCode}';
  title: 'Seabird Observatory - Colony Census Filter';
  documentation: 'Selects the counted colonies of one species that met a nest-count floor, were recorded by a recognised survey method and were not observed in poor visibility, then projects the sector, the counts and the derived bird total from the census mapping.';
  autoActivateUpdates: false;
  ownership: DID { identifier: '000000' };
  execution: Single
  {
    query: {speciesCode: String[1], minNests: Integer[1]|test::copperisle3::domain::ColonyCount.all()->filter(
      c|((($c.speciesCode->toUpper()->trim() == $speciesCode->toUpper()->trim()) && ($c.nestCount >= $minNests)) && !($c.visibilityClass->toLower() == 'poor')) && (($c.surveyMethod->startsWith('BOAT') || $c.surveyMethod->startsWith('CLIFF')) || $c.surveyMethod->endsWith('COUNT'))
    )->project(
      [
        c|$c.sectorCode,
        c|$c.speciesCode->toUpper(),
        c|$c.nestCount,
        c|(($c.chickCount + $c.adultCount) - $c.nestCount),
        c|$c.countDate,
        c|$c.surveyMethod
      ],
      [
        'Sector Code',
        'Species Code',
        'Nest Count',
        'Fledging Surplus',
        'Count Date',
        'Survey Method'
      ]
    )->sort(
      [
        asc('Sector Code')
      ]
    )};
    mapping: test::copperisle3::mapping::IsleSurveyMapping;
    runtime: test::copperisle3::runtime::IsleSurveyRuntime;
  }
  testSuites:
  [
    colonyCensusFilterSuite:
    {
      data:
      [
        connections:
        [
          isleSurvey: Reference
            #{
              test::copperisle3::data::IsleSurveyData
            }#
        ]
      ]
      tests:
      [
        puffinColoniesAboveFloor:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            speciesCode = 'puffin',
            minNests = 100
          ]
          asserts:
          [
            onlyLargeWellObservedColonies:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Sector Code":"CI-N","Species Code":"PUFFIN","Nest Count":120,"Fledging Surplus":206,"Count Date":"2026-05-18","Survey Method":"BOAT_TRANSECT"},{"Sector Code":"CI-W","Species Code":"PUFFIN","Nest Count":210,"Fledging Surplus":370,"Count Date":"2026-05-21","Survey Method":"CLIFF_SCAN"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
