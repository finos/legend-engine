###Connection
RelationalDatabaseConnection test::copperisle3::connection::IsleSurveyConnection
{
  store: test::copperisle3::store::IsleSurveyDb;
  type: Snowflake;
  timezone: 'UTC';
  specification: Snowflake
  {
    name: 'ISLE_SURVEY_DB';
    account: 'isle_survey_account';
    warehouse: 'ISLE_SURVEY_WH';
    region: 'eu-west-1';
    cloudType: 'aws';
    accountType: MultiTenant;
    organization: 'seabird_observatory_org';
    role: 'ISLE_SURVEY_READER';
  };
  auth: OAuth
  {
    oauthKey: 'isle_survey_oauth_key';
    scopeName: 'SESSION:ROLE-ANY';
  };
}
