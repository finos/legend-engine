###Relational
Database test::westernquarry::store::DepotDb
(
  Schema recycling
  (
    Table bale_lot
    (
      lot_code VARCHAR(24) PRIMARY KEY,
      depot_code VARCHAR(24),
      material_code VARCHAR(24),
      press_code VARCHAR(24),
      purity_pct DOUBLE,
      mass_kg DOUBLE,
      bale_count INTEGER,
      pressed_on DATE
    )

    Table sort_depot
    (
      depot_code VARCHAR(24) PRIMARY KEY,
      depot_name VARCHAR(120) NOT NULL,
      district_name VARCHAR(120)
    )
  )

  Join Lot_Depot(recycling.bale_lot.depot_code = recycling.sort_depot.depot_code)
)
