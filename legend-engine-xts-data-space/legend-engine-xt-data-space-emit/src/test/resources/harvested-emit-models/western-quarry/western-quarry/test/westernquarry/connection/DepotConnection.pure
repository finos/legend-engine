###Connection
RelationalDatabaseConnection test::westernquarry::connection::DepotConnection
{
  store: test::westernquarry::store::DepotDb;
  type: Snowflake;
  timezone: +0000;
  specification: Snowflake
  {
    name: 'WESTERN_RECYCLING_DB';
    account: 'western_recycling_account';
    warehouse: 'BALE_SORTING_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    quotedIdentifiersIgnoreCase: false;
    enableQueryTags: false;
    role: 'BALE_SORTING_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'BALE_SORTING_READER';
    privateKeyVaultReference: 'western-recycling-private-key';
    passPhraseVaultReference: 'western-recycling-passphrase';
  };
}
