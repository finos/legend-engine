###DataSpace
DataSpace test::westernquarry::dataspace::DepotDataSpace
{
  executionContexts:
  [
    {
      name: 'sorting';
      description: 'Sorting environment - the graded bale register as the depot warehouse serves it.';
      mapping: test::westernquarry::mapping::DepotBaleMapping;
      defaultRuntime: test::westernquarry::runtime::DepotRuntime;
    }
  ];
  defaultExecutionContext: 'sorting';
  title: 'Western Recycling Bale Sorting';
  description: 'Discovery surface over the municipal bale sorting model: graded bale lots and the depots that pressed them, with the published register as its featured executable.';
  elements:
  [
    test::westernquarry::domain::BaleLot,
    test::westernquarry::domain::SortDepot
  ];
  executables:
  [
    {
      id: 1;
      title: 'Baled Lot Register';
      description: 'The whole graded bale register as the published service serves it.';
      executable: test::westernquarry::service::BaleLotRegister;
    }
  ];
  supportInfo: Email
  {
    address: 'bale-sorting-desk@westernrecycling.invalid';
  };
}
