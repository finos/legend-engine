###Connection
RelationalDatabaseConnection test::olivedelta::connection::ReefConnection
{
  store: test::olivedelta::store::ReefDB;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'REEF_MONITOR_DB';
    account: 'reef_monitor_account';
    warehouse: 'REEF_MONITOR_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    role: 'REEF_MONITOR_ROLE';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'reef_monitor_reader';
    privateKeyVaultReference: 'reef-monitor-private-key';
    passPhraseVaultReference: 'reef-monitor-passphrase';
  };
}
