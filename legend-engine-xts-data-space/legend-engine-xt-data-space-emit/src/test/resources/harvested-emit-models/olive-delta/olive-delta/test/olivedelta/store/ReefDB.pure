###Relational
Database test::olivedelta::store::ReefDB
(
  Schema reef
  (
    Table survey_site
    (
      site_code VARCHAR(24) PRIMARY KEY,
      site_name VARCHAR(120) NOT NULL,
      lagoon_zone VARCHAR(24) NOT NULL,
      team_code VARCHAR(24) NOT NULL
    )
    Table coral_colony
    (
      colony_code VARCHAR(24) PRIMARY KEY,
      site_code VARCHAR(24) NOT NULL,
      growth_form VARCHAR(64) NOT NULL,
      diameter_cm INTEGER NOT NULL
    )
    Table dive_team
    (
      team_code VARCHAR(24) PRIMARY KEY,
      team_name VARCHAR(120) NOT NULL,
      shore_base VARCHAR(120) NOT NULL
    )
  )

  Schema monitor
  (
    Table bleach_check
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )

      check_code VARCHAR(24) PRIMARY KEY,
      site_code VARCHAR(24) NOT NULL,
      bleach_percent INTEGER NOT NULL,
      in_z DATE PRIMARY KEY,
      out_z DATE
    )
  )

  Join Site_Colony(reef.survey_site.site_code = reef.coral_colony.site_code)
  Join Site_Team(reef.survey_site.team_code = reef.dive_team.team_code)
  Join Check_Site(monitor.bleach_check.site_code = reef.survey_site.site_code)
)
