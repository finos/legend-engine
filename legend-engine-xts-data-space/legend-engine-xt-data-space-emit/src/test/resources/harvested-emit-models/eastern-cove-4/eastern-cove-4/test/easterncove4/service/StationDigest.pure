###Service
Service test::easterncove4::service::ReadingDigest
{
  pattern: '/easterncove4/v1/reading-digest/{asOf}';
  title: 'Eastern Cove - Gauge Reading Digest At A Pinned Instant';
  owners:
  [
    'cove-tide-watch-desk'
  ];
  documentation: 'Resolves the tide-gauge readings that are live at the requested processing instant and projects each one beside the station it was taken at and the warden keeping watch over that station, so the temporal predicate and the three-hop warden path both land in the pushed-down SQL.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: {asOf: StrictDate[1]|test::easterncove4::domain::GaugeReading.all($asOf)->project(
      [
        r|$r.readingId,
        r|$r.gaugeCode,
        r|$r.swellCode,
        r|$r.heightCm,
        r|$r.stationName,
        r|$r.wardenName
      ],
      [
        'Reading',
        'Gauge',
        'Swell',
        'HeightCm',
        'Station',
        'Warden'
      ]
    )->sort([asc('Reading')])};
    mapping: test::easterncove4::mapping::CoveMapping;
    runtime: test::easterncove4::runtime::CoveWarehouseRuntime;
  }
  testSuites:
  [
    readingDigestSuite:
    {
      data:
      [
        connections:
        [
          coveWarehouseConnection:
            Relational
            #{
              tide.station:
                'station_code,station_name,cove_code,sensor_type\n'+
                'ST-1,Kelp Point,EAST-COVE,PRESSURE\n'+
                'ST-2,Shingle Bar,EAST-COVE,ACOUSTIC\n'+
                'ST-3,Gull Stack,NORTH-COVE,RADAR\n';

              tide.gauge_reading:
                'reading_id,in_z,station_code,gauge_code,swell_code,height_cm,water_temp_c,taken_on,out_z\n'+
                '1,2026-01-01,ST-1,GA-001,GROUNDSWELL,214,11.5,2026-01-05,9999-12-31\n'+
                '2,2026-01-01,ST-2,GA-002,WINDSWELL,168,11.0,2026-01-06,9999-12-31\n'+
                '3,2026-01-01,ST-3,GA-003,GROUNDSWELL,305,10.25,2026-01-07,9999-12-31\n'+
                '4,2026-01-01,ST-1,GA-004,CONFUSED,190,11.75,2026-01-08,2026-02-01\n';

              crew.warden:
                'warden_code,warden_name,watch_code\n'+
                'WD-1,Ada Marlow,EARLY\n'+
                'WD-2,Bo Selkirk,LATE\n';

              crew.station_watch:
                'station_code,warden_code\n'+
                'ST-1,WD-1\n'+
                'ST-2,WD-2\n';
            }#
        ]
      ]
      tests:
      [
        supersededReadingIsOutOfRange:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            asOf = %2026-03-01
          ]
          asserts:
          [
            rows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Reading":1,"Gauge":"GA-001","Swell":"GROUNDSWELL","HeightCm":214,"Station":"Kelp Point","Warden":"Ada Marlow"},{"Reading":2,"Gauge":"GA-002","Swell":"WINDSWELL","HeightCm":168,"Station":"Shingle Bar","Warden":"Bo Selkirk"},{"Reading":3,"Gauge":"GA-003","Swell":"GROUNDSWELL","HeightCm":305,"Station":"Gull Stack","Warden":null}]';
                  }#;
              }#
          ]
        },
        earlierInstantStillSeesTheSupersededReading:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            asOf = %2026-01-15
          ]
          asserts:
          [
            rows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Reading":1,"Gauge":"GA-001","Swell":"GROUNDSWELL","HeightCm":214,"Station":"Kelp Point","Warden":"Ada Marlow"},{"Reading":2,"Gauge":"GA-002","Swell":"WINDSWELL","HeightCm":168,"Station":"Shingle Bar","Warden":"Bo Selkirk"},{"Reading":3,"Gauge":"GA-003","Swell":"GROUNDSWELL","HeightCm":305,"Station":"Gull Stack","Warden":null},{"Reading":4,"Gauge":"GA-004","Swell":"CONFUSED","HeightCm":190,"Station":"Kelp Point","Warden":"Ada Marlow"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

###Service
Service test::easterncove4::service::SwellWatch
{
  pattern: '/easterncove4/v1/swell-watch/{asOf}';
  title: 'Eastern Cove - Readings Narrowed To The Watched Swell Codes';
  owners:
  [
    'cove-tide-watch-desk'
  ];
  documentation: 'Narrows the readings live at the requested processing instant with a membership test over the swell codes currently being watched, then projects the surviving readings beside their station. The membership set is a service parameter, so the temporal predicate and the generated IN list both push down into one statement.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: {asOf: StrictDate[1], swells: String[*]|test::easterncove4::domain::GaugeReading.all($asOf)->filter(
      r|$r.swellCode->in($swells)
    )->project(
      [
        r|$r.readingId,
        r|$r.swellCode,
        r|$r.heightCm,
        r|$r.stationName
      ],
      [
        'Reading',
        'Swell',
        'HeightCm',
        'Station'
      ]
    )->sort([asc('Reading')])};
    mapping: test::easterncove4::mapping::CoveMapping;
    runtime: test::easterncove4::runtime::CoveWarehouseRuntime;
  }
  testSuites:
  [
    swellWatchSuite:
    {
      data:
      [
        connections:
        [
          coveWarehouseConnection:
            Relational
            #{
              tide.station:
                'station_code,station_name,cove_code,sensor_type\n'+
                'ST-1,Kelp Point,EAST-COVE,PRESSURE\n'+
                'ST-2,Shingle Bar,EAST-COVE,ACOUSTIC\n'+
                'ST-3,Gull Stack,NORTH-COVE,RADAR\n';

              tide.gauge_reading:
                'reading_id,in_z,station_code,gauge_code,swell_code,height_cm,water_temp_c,taken_on,out_z\n'+
                '1,2026-01-01,ST-1,GA-001,GROUNDSWELL,214,11.5,2026-01-05,9999-12-31\n'+
                '2,2026-01-01,ST-2,GA-002,WINDSWELL,168,11.0,2026-01-06,9999-12-31\n'+
                '3,2026-01-01,ST-3,GA-003,GROUNDSWELL,305,10.25,2026-01-07,9999-12-31\n'+
                '4,2026-01-01,ST-1,GA-004,CONFUSED,190,11.75,2026-01-08,2026-02-01\n';
            }#
        ]
      ]
      tests:
      [
        onlyWatchedSwellCodesSurvive:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            asOf = %2026-03-01,
            swells = ['GROUNDSWELL', 'WINDSWELL']
          ]
          asserts:
          [
            rows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Reading":1,"Swell":"GROUNDSWELL","HeightCm":214,"Station":"Kelp Point"},{"Reading":2,"Swell":"WINDSWELL","HeightCm":168,"Station":"Shingle Bar"},{"Reading":3,"Swell":"GROUNDSWELL","HeightCm":305,"Station":"Gull Stack"}]';
                  }#;
              }#
          ]
        },
        oneWatchedSwellCodeNarrowsFurther:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            asOf = %2026-03-01,
            swells = ['WINDSWELL']
          ]
          asserts:
          [
            rows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Reading":2,"Swell":"WINDSWELL","HeightCm":168,"Station":"Shingle Bar"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
