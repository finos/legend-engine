###Relational
Database test::easterncove4::store::CoveDatabase
(
  Schema tide
  (
    Table station
    (
      station_code VARCHAR(16) PRIMARY KEY,
      station_name VARCHAR(120) NOT NULL,
      cove_code VARCHAR(16) NOT NULL,
      sensor_type VARCHAR(24) NOT NULL
    )

    Table gauge_reading
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z, INFINITY_DATE = %9999-12-31)
      )

      reading_id INTEGER PRIMARY KEY,
      in_z DATE PRIMARY KEY,
      station_code VARCHAR(16),
      gauge_code VARCHAR(24) NOT NULL,
      swell_code VARCHAR(16) NOT NULL,
      height_cm INTEGER NOT NULL,
      water_temp_c DOUBLE NOT NULL,
      taken_on DATE NOT NULL,
      out_z DATE NOT NULL
    )
  )

  Schema crew
  (
    Table warden
    (
      warden_code VARCHAR(16) PRIMARY KEY,
      warden_name VARCHAR(120) NOT NULL,
      watch_code VARCHAR(16) NOT NULL
    )

    Table station_watch
    (
      station_code VARCHAR(16) PRIMARY KEY,
      warden_code VARCHAR(16) PRIMARY KEY
    )

    Table mooring_check
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z, INFINITY_DATE = %9999-12-31)
      )

      check_id INTEGER PRIMARY KEY,
      in_z DATE PRIMARY KEY,
      station_code VARCHAR(16),
      buoy_code VARCHAR(24) NOT NULL,
      condition_code VARCHAR(16) NOT NULL,
      scour_depth_cm INTEGER NOT NULL,
      checked_on DATE NOT NULL,
      out_z DATE NOT NULL
    )
  )

  Join Reading_Station(tide.gauge_reading.station_code = tide.station.station_code)
  Join Station_Watch(tide.station.station_code = crew.station_watch.station_code)
  Join Watch_Warden(crew.station_watch.warden_code = crew.warden.warden_code)
  Join Check_Station(crew.mooring_check.station_code = tide.station.station_code)
)
