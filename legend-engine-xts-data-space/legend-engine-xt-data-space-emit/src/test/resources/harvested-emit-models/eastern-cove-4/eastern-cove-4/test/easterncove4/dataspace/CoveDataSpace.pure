###DataSpace
DataSpace test::easterncove4::dataspace::CoveWatchDataSpace
{
  executionContexts:
  [
    {
      name: 'watch';
      description: 'Watch tier - the versioned gauge and mooring register resolved through the warehouse surface, the context a query inherits when none is named.';
      mapping: test::easterncove4::mapping::CoveMapping;
      defaultRuntime: test::easterncove4::runtime::CoveWarehouseRuntime;
    }
  ];
  defaultExecutionContext: 'watch';
  title: 'Eastern Cove Tide Watch Register';
  description: 'A governed entry point over the versioned tide-gauge readings, the buoy inspections made off each station, the stations themselves and the warden roster reached across schemas, wiring the curated mapping to the watch tier alongside the endpoints consumers should start from.';
  elements:
  [
    test::easterncove4::domain::GaugeReading,
    test::easterncove4::domain::MooringCheck,
    test::easterncove4::domain::Station,
    test::easterncove4::domain::Warden
  ];
  executables:
  [
    {
      id: 1;
      title: 'Gauge reading digest';
      description: 'Featured endpoint returning the readings live at a pinned processing instant beside their station and warden.';
      executable: test::easterncove4::service::ReadingDigest;
    },
    {
      id: 2;
      title: 'Swell watch';
      description: 'Featured endpoint narrowing the live readings to the swell codes currently being watched.';
      executable: test::easterncove4::service::SwellWatch;
    },
    {
      id: 3;
      title: 'Mooring board';
      description: 'Featured endpoint returning the buoy inspections live at a pinned processing instant beside the sensor carried by their station.';
      executable: test::easterncove4::service::MooringBoard;
    }
  ];
  supportInfo: Email
  {
    address: 'cove-tide-watch@example.invalid';
  };
}
