###Relational
Database test::gildedtundra::store::CalendarDatabase
(
  Schema tundra
  (
    Table observation_window
    (
      year_window_start TIMESTAMP PRIMARY KEY,
      year_window_end TIMESTAMP NOT NULL,
      prior_year_window_start TIMESTAMP NOT NULL,
      prior_year_window_end TIMESTAMP NOT NULL,
      season_window_start TIMESTAMP NOT NULL,
      season_window_end TIMESTAMP NOT NULL,
      prior_season_window_start TIMESTAMP NOT NULL,
      prior_season_window_end TIMESTAMP NOT NULL,
      quarter_window_start TIMESTAMP NOT NULL,
      quarter_window_end TIMESTAMP NOT NULL,
      prior_quarter_window_start TIMESTAMP NOT NULL,
      prior_quarter_window_end TIMESTAMP NOT NULL,
      month_window_start TIMESTAMP NOT NULL,
      month_window_end TIMESTAMP NOT NULL,
      prior_month_window_start TIMESTAMP NOT NULL,
      prior_month_window_end TIMESTAMP NOT NULL,
      two_months_back_window_start TIMESTAMP NOT NULL,
      two_months_back_window_end TIMESTAMP NOT NULL,
      compiled_for_date DATE,
      period_close_flag CHAR(1) NOT NULL,
      lake_window_low INTEGER,
      lake_window_high INTEGER
    )
  )
)
