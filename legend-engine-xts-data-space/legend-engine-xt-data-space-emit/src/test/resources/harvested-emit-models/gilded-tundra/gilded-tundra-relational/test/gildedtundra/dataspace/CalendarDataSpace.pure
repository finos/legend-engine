###DataSpace
DataSpace test::gildedtundra::dataspace::CalendarDataSpace
{
  executionContexts:
  [
    {
      name: 'calendar';
      description: 'Permafrost observation calendar served through the tundra warehouse; the only executable entry point of the model, pairing the single mapping with the single runtime.';
      mapping: test::gildedtundra::mapping::CalendarMapping;
      defaultRuntime: test::gildedtundra::runtime::CalendarRuntime;
    }
  ];
  defaultExecutionContext: 'calendar';
  description: 'Discovery surface over the nested calendar windows the permafrost observation programme compiles its surveys against.';
}
