###Pure
import meta::pure::profiles::*;

Class {doc.doc = 'One row of the permafrost observation calendar: nested year, season, quarter and month windows expressed as mandatory boundary instants at several historical offsets, plus the optional survey date the row was compiled for and the single-character period-close flag. Flat projection target with no inheritance, constraint, derived property or association.'} test::gildedtundra::domain::ObservationCalendarWindow
{
  yearWindowStart: DateTime[1];
  yearWindowEnd: DateTime[1];
  priorYearWindowStart: DateTime[1];
  priorYearWindowEnd: DateTime[1];
  seasonWindowStart: DateTime[1];
  seasonWindowEnd: DateTime[1];
  priorSeasonWindowStart: DateTime[1];
  priorSeasonWindowEnd: DateTime[1];
  quarterWindowStart: DateTime[1];
  quarterWindowEnd: DateTime[1];
  priorQuarterWindowStart: DateTime[1];
  priorQuarterWindowEnd: DateTime[1];
  monthWindowStart: DateTime[1];
  monthWindowEnd: DateTime[1];
  priorMonthWindowStart: DateTime[1];
  priorMonthWindowEnd: DateTime[1];
  twoMonthsBackWindowStart: DateTime[1];
  twoMonthsBackWindowEnd: DateTime[1];
  compiledForDate: StrictDate[0..1];
  periodCloseFlag: String[1];
}
