###Service
Service test::azurethistle::service::TurbineRegisterFeed
{
  pattern: '/estate/v1/turbines';
  title: 'Upland Turbine Estate - Daily Turbine Register';
  ownership: DID { identifier: 'upland-turbine-estate-platform' };
  documentation: 'Serves the daily turbine register read through the estate mapping: the machine, the park it stands in and the curtailment and service-lock labels its flag columns resolve to, including the rows whose flags were never logged.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: |test::azurethistle::domain::TurbineRecord.all()
      ->project(
        [
          t|$t.assetCode,
          t|$t.turbineName,
          t|$t.parkCode,
          t|$t.curtailmentLabel,
          t|$t.serviceLockLabel
        ],
        [
          'AssetCode',
          'TurbineName',
          'ParkCode',
          'CurtailmentLabel',
          'ServiceLockLabel'
        ]
      )
      ->sort(
        [
          asc('AssetCode')
        ]
      );
    mapping: test::azurethistle::mapping::TurbineEstateMapping;
    runtime: test::azurethistle::runtime::EstateWarehouseRuntime;
  }
  testSuites:
  [
    turbineRegisterSuite:
    {
      data:
      [
        connections:
        [
          estateWarehouseConnection:
            Reference
            #{
              test::azurethistle::data::TurbineEstateData
            }#
        ]
      ]
      tests:
      [
        everyLoggedTurbine:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            tenTurbineRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"AssetCode":"TB-01","TurbineName":"Turbine 01","ParkCode":"PARK-A","CurtailmentLabel":"CURTAILED-TB-01","ServiceLockLabel":"LOCKED-PEAT"},{"AssetCode":"TB-02","TurbineName":"Turbine 02","ParkCode":"PARK-B","CurtailmentLabel":"FREE-TB-02","ServiceLockLabel":"OPEN-MORAINE"},{"AssetCode":"TB-03","TurbineName":"Turbine 03","ParkCode":"PARK-A","CurtailmentLabel":null,"ServiceLockLabel":null},{"AssetCode":"TB-04","TurbineName":"Turbine 04","ParkCode":"PARK-B","CurtailmentLabel":"CURTAILED-TB-04","ServiceLockLabel":"OPEN-PEAT"},{"AssetCode":"TB-05","TurbineName":"Turbine 05","ParkCode":"PARK-A","CurtailmentLabel":"FREE-TB-05","ServiceLockLabel":"LOCKED-MORAINE"},{"AssetCode":"TB-06","TurbineName":"Turbine 06","ParkCode":"PARK-B","CurtailmentLabel":"CURTAILED-TB-06","ServiceLockLabel":null},{"AssetCode":"TB-07","TurbineName":"Turbine 07","ParkCode":"PARK-A","CurtailmentLabel":null,"ServiceLockLabel":"OPEN-PEAT"},{"AssetCode":"TB-08","TurbineName":"Turbine 08","ParkCode":"PARK-B","CurtailmentLabel":"FREE-TB-08","ServiceLockLabel":"LOCKED-MORAINE"},{"AssetCode":"TB-09","TurbineName":"Turbine 09","ParkCode":"PARK-A","CurtailmentLabel":"CURTAILED-TB-09","ServiceLockLabel":"OPEN-SCREE"},{"AssetCode":"TB-10","TurbineName":"Turbine 10","ParkCode":"PARK-B","CurtailmentLabel":null,"ServiceLockLabel":null}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

###Service
Service test::azurethistle::service::NacelleTelemetryFeed
{
  pattern: '/estate/v1/nacelle-readings';
  title: 'Upland Turbine Estate - Nacelle Telemetry';
  ownership: DID { identifier: 'upland-turbine-estate-platform' };
  documentation: 'Serves the nacelle telemetry readings taken across the park, each carrying the met mast it is compared against and the alarm label its flag column resolves to.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: |test::azurethistle::domain::NacelleReading.all()
      ->project(
        [
          n|$n.assetCode,
          n|$n.readingSeq,
          n|$n.mastCode,
          n|$n.alarmLabel
        ],
        [
          'AssetCode',
          'ReadingSeq',
          'MastCode',
          'AlarmLabel'
        ]
      )
      ->sort(
        [
          asc('AssetCode')
        ]
      );
    mapping: test::azurethistle::mapping::TurbineEstateMapping;
    runtime: test::azurethistle::runtime::EstateWarehouseRuntime;
  }
  testSuites:
  [
    nacelleTelemetrySuite:
    {
      data:
      [
        connections:
        [
          estateWarehouseConnection:
            Reference
            #{
              test::azurethistle::data::TurbineEstateData
            }#
        ]
      ]
      tests:
      [
        everyNacelleReading:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            fourNacelleRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"AssetCode":"TB-01","ReadingSeq":1,"MastCode":"MST-1","AlarmLabel":"ALARM"},{"AssetCode":"TB-02","ReadingSeq":2,"MastCode":"MST-2","AlarmLabel":"CLEAR"},{"AssetCode":"TB-03","ReadingSeq":3,"MastCode":"MST-3","AlarmLabel":null},{"AssetCode":"TB-04","ReadingSeq":4,"MastCode":"MST-1","AlarmLabel":"ALARM"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

###Service
Service test::azurethistle::service::BladeInspectionFeed
{
  pattern: '/estate/v1/blade-inspections';
  title: 'Upland Turbine Estate - Blade Inspections';
  ownership: DID { identifier: 'upland-turbine-estate-platform' };
  documentation: 'Serves the rope-access blade inspections held against the estate, each carrying the inspector, the defect tally and the repair label its flag column resolves to.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: |test::azurethistle::domain::BladeInspection.all()
      ->project(
        [
          b|$b.bladeSetCode,
          b|$b.inspectorName,
          b|$b.defectCount,
          b|$b.repairLabel
        ],
        [
          'BladeSetCode',
          'InspectorName',
          'DefectCount',
          'RepairLabel'
        ]
      )
      ->sort(
        [
          asc('BladeSetCode')
        ]
      );
    mapping: test::azurethistle::mapping::TurbineEstateMapping;
    runtime: test::azurethistle::runtime::EstateStandbyRuntime;
  }
  testSuites:
  [
    bladeInspectionSuite:
    {
      data:
      [
        connections:
        [
          estateStandbyConnection:
            Reference
            #{
              test::azurethistle::data::TurbineEstateData
            }#
        ]
      ]
      tests:
      [
        everyBladeInspection:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            threeBladeRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"BladeSetCode":"BLD-01","InspectorName":"Inspector 01","DefectCount":1,"RepairLabel":"REPAIR-DUE-BLD-01"},{"BladeSetCode":"BLD-02","InspectorName":"Inspector 02","DefectCount":2,"RepairLabel":"REPAIR-NONE"},{"BladeSetCode":"BLD-03","InspectorName":"Inspector 03","DefectCount":3,"RepairLabel":null}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

###Service
Service test::azurethistle::service::FeederExportFeed
{
  pattern: '/estate/v1/feeders';
  title: 'Upland Turbine Estate - Substation Feeders';
  ownership: DID { identifier: 'upland-turbine-estate-platform' };
  documentation: 'Serves the substation feeders the park exports through, each carrying the substation it belongs to and the islanding label its flag column resolves to.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: |test::azurethistle::domain::SubstationFeeder.all()
      ->project(
        [
          f|$f.feederCode,
          f|$f.substationName,
          f|$f.islandingLabel
        ],
        [
          'FeederCode',
          'SubstationName',
          'IslandingLabel'
        ]
      )
      ->sort(
        [
          asc('FeederCode')
        ]
      );
    mapping: test::azurethistle::mapping::TurbineEstateMapping;
    runtime: test::azurethistle::runtime::EstateWarehouseRuntime;
  }
  testSuites:
  [
    feederExportSuite:
    {
      data:
      [
        connections:
        [
          estateWarehouseConnection:
            Reference
            #{
              test::azurethistle::data::TurbineEstateData
            }#
        ]
      ]
      tests:
      [
        everyFeeder:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            threeFeederRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"FeederCode":"FDR-1","SubstationName":"Corrie Substation","IslandingLabel":"ISLANDED"},{"FeederCode":"FDR-2","SubstationName":"Glen Substation","IslandingLabel":"GRID-TIED"},{"FeederCode":"FDR-3","SubstationName":"Corrie Substation","IslandingLabel":null}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

