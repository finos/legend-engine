###Service
Service test::azurethistle::service::TurbineDeicingFeed
{
  pattern: '/estate/v1/turbines/deicing';
  title: 'Upland Turbine Estate - De-icing and Yaw States';
  ownership: DID { identifier: 'upland-turbine-estate-platform' };
  documentation: 'Serves the de-icing and yaw-fault states of every turbine alongside the crew that last worked it, so the two remaining flag conditionals on the wide turbine class can be read on their own.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: |test::azurethistle::domain::TurbineRecord.all()
      ->project(
        [
          t|$t.assetCode,
          t|$t.deiceLabel,
          t|$t.yawFaultLabel,
          t|$t.serviceCrew
        ],
        [
          'AssetCode',
          'DeiceLabel',
          'YawFaultLabel',
          'ServiceCrew'
        ]
      )
      ->sort(
        [
          asc('AssetCode')
        ]
      );
    mapping: test::azurethistle::mapping::TurbineEstateMapping;
    runtime: test::azurethistle::runtime::EstateStandbyRuntime;
  }
  testSuites:
  [
    turbineDeicingSuite:
    {
      data:
      [
        connections:
        [
          estateStandbyConnection:
            Reference
            #{
              test::azurethistle::data::TurbineEstateData
            }#
        ]
      ]
      tests:
      [
        everyDeicingAndYawArm:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            tenTurbineRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"AssetCode":"TB-01","DeiceLabel":"DEICE-ON","YawFaultLabel":"YAW-FAULT","ServiceCrew":"Corrie Crew"},{"AssetCode":"TB-02","DeiceLabel":"DEICE-OFF","YawFaultLabel":"YAW-OK","ServiceCrew":"Glen Crew"},{"AssetCode":"TB-03","DeiceLabel":null,"YawFaultLabel":null,"ServiceCrew":"Ridge Crew"},{"AssetCode":"TB-04","DeiceLabel":"DEICE-ON","YawFaultLabel":"YAW-OK","ServiceCrew":"Corrie Crew"},{"AssetCode":"TB-05","DeiceLabel":"DEICE-OFF","YawFaultLabel":"YAW-FAULT","ServiceCrew":"Glen Crew"},{"AssetCode":"TB-06","DeiceLabel":"DEICE-OFF","YawFaultLabel":null,"ServiceCrew":"Ridge Crew"},{"AssetCode":"TB-07","DeiceLabel":null,"YawFaultLabel":"YAW-FAULT","ServiceCrew":"Corrie Crew"},{"AssetCode":"TB-08","DeiceLabel":"DEICE-ON","YawFaultLabel":"YAW-OK","ServiceCrew":"Glen Crew"},{"AssetCode":"TB-09","DeiceLabel":"DEICE-OFF","YawFaultLabel":"YAW-FAULT","ServiceCrew":"Ridge Crew"},{"AssetCode":"TB-10","DeiceLabel":"DEICE-ON","YawFaultLabel":"YAW-OK","ServiceCrew":"Corrie Crew"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
