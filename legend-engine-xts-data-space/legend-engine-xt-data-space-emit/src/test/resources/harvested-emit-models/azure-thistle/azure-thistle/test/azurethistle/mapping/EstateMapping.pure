###Mapping
Mapping test::azurethistle::mapping::TurbineEstateMapping
(
  *test::azurethistle::domain::TurbineRecord[turbine]: Relational
  {
    ~primaryKey
    (
      [test::azurethistle::store::TurbineEstateDb]estate.turbine_record.reading_date,
      [test::azurethistle::store::TurbineEstateDb]estate.turbine_record.asset_code
    )
    ~mainTable [test::azurethistle::store::TurbineEstateDb]estate.turbine_record
    readingDate: [test::azurethistle::store::TurbineEstateDb]estate.turbine_record.reading_date,
    assetCode: [test::azurethistle::store::TurbineEstateDb]estate.turbine_record.asset_code,
    turbineName: [test::azurethistle::store::TurbineEstateDb]estate.turbine_record.turbine_name,
    parkCode: [test::azurethistle::store::TurbineEstateDb]estate.turbine_record.park_code,
    feederCode: [test::azurethistle::store::TurbineEstateDb]estate.turbine_record.feeder_code,
    trackCode: [test::azurethistle::store::TurbineEstateDb]estate.turbine_record.track_code,
    mastCode: [test::azurethistle::store::TurbineEstateDb]estate.turbine_record.mast_code,
    bladeSetCode: [test::azurethistle::store::TurbineEstateDb]estate.turbine_record.blade_set_code,
    modelCode: [test::azurethistle::store::TurbineEstateDb]estate.turbine_record.model_code,
    hubHeightM: [test::azurethistle::store::TurbineEstateDb]estate.turbine_record.hub_height_m,
    rotorDiameterM: [test::azurethistle::store::TurbineEstateDb]estate.turbine_record.rotor_diameter_m,
    ratedOutputKw: [test::azurethistle::store::TurbineEstateDb]estate.turbine_record.rated_output_kw,
    generatedKwh: [test::azurethistle::store::TurbineEstateDb]estate.turbine_record.generated_kwh,
    availableHours: [test::azurethistle::store::TurbineEstateDb]estate.turbine_record.available_hours,
    downtimeHours: [test::azurethistle::store::TurbineEstateDb]estate.turbine_record.downtime_hours,
    rotorSpeedRpm: [test::azurethistle::store::TurbineEstateDb]estate.turbine_record.rotor_speed_rpm,
    pitchAngleDeg: [test::azurethistle::store::TurbineEstateDb]estate.turbine_record.pitch_angle_deg,
    nacelleBearingDeg: [test::azurethistle::store::TurbineEstateDb]estate.turbine_record.nacelle_bearing_deg,
    windSpeedMs: [test::azurethistle::store::TurbineEstateDb]estate.turbine_record.wind_speed_ms,
    ambientTempC: [test::azurethistle::store::TurbineEstateDb]estate.turbine_record.ambient_temp_c,
    commissionedOn: [test::azurethistle::store::TurbineEstateDb]estate.turbine_record.commissioned_on,
    lastServiceOn: [test::azurethistle::store::TurbineEstateDb]estate.turbine_record.last_service_on,
    loggedAt: [test::azurethistle::store::TurbineEstateDb]estate.turbine_record.logged_at,
    serviceCrew: [test::azurethistle::store::TurbineEstateDb]estate.turbine_record.service_crew,
    terrainClass: [test::azurethistle::store::TurbineEstateDb]estate.turbine_record.terrain_class,
    curtailmentLabel: case(
                        isNull([test::azurethistle::store::TurbineEstateDb]estate.turbine_record.curtailment_flag),
                        sqlNull(),
                        case(
                          equal([test::azurethistle::store::TurbineEstateDb]estate.turbine_record.curtailment_flag, 1),
                          concat('CURTAILED-', toUpper([test::azurethistle::store::TurbineEstateDb]estate.turbine_record.asset_code)),
                          concat('FREE-', toUpper([test::azurethistle::store::TurbineEstateDb]estate.turbine_record.asset_code))
                        )
                      ),
    yawFaultLabel: case(
                     isNull([test::azurethistle::store::TurbineEstateDb]estate.turbine_record.yaw_fault_flag),
                     sqlNull(),
                     case(
                       equal([test::azurethistle::store::TurbineEstateDb]estate.turbine_record.yaw_fault_flag, 1),
                       'YAW-FAULT',
                       'YAW-OK'
                     )
                   ),
    deiceLabel: case(
                  isNull([test::azurethistle::store::TurbineEstateDb]estate.turbine_record.deice_flag),
                  sqlNull(),
                  case(
                    equal([test::azurethistle::store::TurbineEstateDb]estate.turbine_record.deice_flag, 1),
                    'DEICE-ON',
                    'DEICE-OFF'
                  )
                ),
    serviceLockLabel: case(
                        isNull([test::azurethistle::store::TurbineEstateDb]estate.turbine_record.service_lock_flag),
                        sqlNull(),
                        case(
                          equal([test::azurethistle::store::TurbineEstateDb]estate.turbine_record.service_lock_flag, 1),
                          concat('LOCKED-', toUpper([test::azurethistle::store::TurbineEstateDb]estate.turbine_record.terrain_class)),
                          concat('OPEN-', toUpper([test::azurethistle::store::TurbineEstateDb]estate.turbine_record.terrain_class))
                        )
                      )
  }

