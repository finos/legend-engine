  testSuites:
  [
    turbineOperatingLabelSuite:
    {
      function: |test::azurethistle::domain::TurbineRecord.all()->project(
  [
    t|$t.assetCode,
    t|$t.readingDate,
    t|$t.parkCode,
    t|$t.terrainClass,
    t|$t.curtailmentLabel,
    t|$t.yawFaultLabel,
    t|$t.deiceLabel,
    t|$t.serviceLockLabel
  ],
  [
    'AssetCode',
    'ReadingDate',
    'ParkCode',
    'TerrainClass',
    'CurtailmentLabel',
    'YawFaultLabel',
    'DeiceLabel',
    'ServiceLockLabel'
  ]
)->sort(
  [
    asc('AssetCode')
  ]
);
      tests:
      [
        everyOperatingArmAndTheAbsentFlagFallback:
        {
          doc: 'Covers both arms of each of the four turbine operating conditionals - curtailment, yaw fault, de-icing and service lock - and the null sentinel each one falls back to when its flag column is absent, alongside the direct column bindings resolved through the main-table alias and its declared composite primary key.';
          data:
          [
            test::azurethistle::store::TurbineEstateDb:
              Reference
              #{
                test::azurethistle::data::TurbineEstateData
              }#
          ];
          asserts:
          [
            tenTurbineRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"AssetCode":"TB-01","ReadingDate":"2026-03-01","ParkCode":"PARK-A","TerrainClass":"peat","CurtailmentLabel":"CURTAILED-TB-01","YawFaultLabel":"YAW-FAULT","DeiceLabel":"DEICE-ON","ServiceLockLabel":"LOCKED-PEAT"},{"AssetCode":"TB-02","ReadingDate":"2026-03-02","ParkCode":"PARK-B","TerrainClass":"moraine","CurtailmentLabel":"FREE-TB-02","YawFaultLabel":"YAW-OK","DeiceLabel":"DEICE-OFF","ServiceLockLabel":"OPEN-MORAINE"},{"AssetCode":"TB-03","ReadingDate":"2026-03-03","ParkCode":"PARK-A","TerrainClass":"scree","CurtailmentLabel":null,"YawFaultLabel":null,"DeiceLabel":null,"ServiceLockLabel":null},{"AssetCode":"TB-04","ReadingDate":"2026-03-04","ParkCode":"PARK-B","TerrainClass":"peat","CurtailmentLabel":"CURTAILED-TB-04","YawFaultLabel":"YAW-OK","DeiceLabel":"DEICE-ON","ServiceLockLabel":"OPEN-PEAT"},{"AssetCode":"TB-05","ReadingDate":"2026-03-05","ParkCode":"PARK-A","TerrainClass":"moraine","CurtailmentLabel":"FREE-TB-05","YawFaultLabel":"YAW-FAULT","DeiceLabel":"DEICE-OFF","ServiceLockLabel":"LOCKED-MORAINE"},{"AssetCode":"TB-06","ReadingDate":"2026-03-06","ParkCode":"PARK-B","TerrainClass":"scree","CurtailmentLabel":"CURTAILED-TB-06","YawFaultLabel":null,"DeiceLabel":"DEICE-OFF","ServiceLockLabel":null},{"AssetCode":"TB-07","ReadingDate":"2026-03-07","ParkCode":"PARK-A","TerrainClass":"peat","CurtailmentLabel":null,"YawFaultLabel":"YAW-FAULT","DeiceLabel":null,"ServiceLockLabel":"OPEN-PEAT"},{"AssetCode":"TB-08","ReadingDate":"2026-03-08","ParkCode":"PARK-B","TerrainClass":"moraine","CurtailmentLabel":"FREE-TB-08","YawFaultLabel":"YAW-OK","DeiceLabel":"DEICE-ON","ServiceLockLabel":"LOCKED-MORAINE"},{"AssetCode":"TB-09","ReadingDate":"2026-03-09","ParkCode":"PARK-A","TerrainClass":"scree","CurtailmentLabel":"CURTAILED-TB-09","YawFaultLabel":"YAW-FAULT","DeiceLabel":"DEICE-OFF","ServiceLockLabel":"OPEN-SCREE"},{"AssetCode":"TB-10","ReadingDate":"2026-03-10","ParkCode":"PARK-B","TerrainClass":"peat","CurtailmentLabel":null,"YawFaultLabel":"YAW-OK","DeiceLabel":"DEICE-ON","ServiceLockLabel":null}]';
                  }#;
              }#
          ];
        }
      ];
    },
    feederIslandingSuite:
    {
      function: |test::azurethistle::domain::SubstationFeeder.all()->project(
  [
    f|$f.feederCode,
    f|$f.readingDate,
    f|$f.substationName,
    f|$f.islandingLabel
  ],
  [
    'FeederCode',
    'ReadingDate',
    'SubstationName',
    'IslandingLabel'
  ]
)->sort(
  [
    asc('FeederCode')
  ]
);
      tests:
      [
        islandedGridTiedAndAbsentFlag:
        {
          doc: 'Reads the feeder class through its own main-table alias, so the reading-date and track-code columns it shares by name with the turbine and track tables resolve against the feeder table only, and covers both islanding arms plus the absent-flag sentinel.';
          data:
          [
            test::azurethistle::store::TurbineEstateDb:
              Reference
              #{
                test::azurethistle::data::TurbineEstateData
              }#
          ];
          asserts:
          [
            threeFeederRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"FeederCode":"FDR-1","ReadingDate":"2026-03-01","SubstationName":"Corrie Substation","IslandingLabel":"ISLANDED"},{"FeederCode":"FDR-2","ReadingDate":"2026-03-02","SubstationName":"Glen Substation","IslandingLabel":"GRID-TIED"},{"FeederCode":"FDR-3","ReadingDate":"2026-03-03","SubstationName":"Corrie Substation","IslandingLabel":null}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
