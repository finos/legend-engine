###DataSpace
DataSpace test::azurethistle::dataspace::TurbineEstateDataSpace
{
  executionContexts:
  [
    {
      name: 'primary';
      description: 'Primary environment - the estate binding served through the main hill warehouse.';
      mapping: test::azurethistle::mapping::TurbineEstateMapping;
      defaultRuntime: test::azurethistle::runtime::EstateWarehouseRuntime;
    },
    {
      name: 'standby';
      description: 'Standby environment - the same estate binding served through the second-region warehouse.';
      mapping: test::azurethistle::mapping::TurbineEstateMapping;
      defaultRuntime: test::azurethistle::runtime::EstateStandbyRuntime;
    }
  ];
  defaultExecutionContext: 'primary';
  title: 'Upland Turbine Estate';
  description: 'Discovery surface over the upland wind-farm maintenance estate: the daily turbine register and the nacelle, blade, feeder, track and mast records read alongside it.';
  elements:
  [
    test::azurethistle::domain::TurbineRecord,
    test::azurethistle::domain::NacelleReading,
    test::azurethistle::domain::BladeInspection,
    test::azurethistle::domain::SubstationFeeder,
    test::azurethistle::domain::AccessTrack,
    test::azurethistle::domain::MetMast
  ];
  supportInfo: Email
  {
    address: 'estate-maintenance-desk@uplandturbineestate.invalid';
  };
}
