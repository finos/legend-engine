###Connection
RelationalDatabaseConnection test::azurethistle::connection::EstateWarehouseConnection
{
  store: test::azurethistle::store::TurbineEstateDb;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'EXAMPLE_TURBINE_ESTATE_DB';
    account: 'example_estate_account';
    warehouse: 'EXAMPLE_ESTATE_WH';
    region: 'eu-west-1';
    cloudType: 'aws';
    role: 'EXAMPLE_ESTATE_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'EXAMPLE_ESTATE_USER';
    privateKeyVaultReference: 'example-estate-private-key';
    passPhraseVaultReference: 'example-estate-passphrase';
  };
}

RelationalDatabaseConnection test::azurethistle::connection::EstateStandbyConnection
{
  store: test::azurethistle::store::TurbineEstateDb;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'EXAMPLE_TURBINE_ESTATE_STANDBY_DB';
    account: 'example_estate_standby_account';
    warehouse: 'EXAMPLE_ESTATE_STANDBY_WH';
    region: 'eu-west-2';
    cloudType: 'aws';
    role: 'EXAMPLE_ESTATE_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'EXAMPLE_ESTATE_USER';
    privateKeyVaultReference: 'example-estate-private-key';
    passPhraseVaultReference: 'example-estate-passphrase';
  };
}
