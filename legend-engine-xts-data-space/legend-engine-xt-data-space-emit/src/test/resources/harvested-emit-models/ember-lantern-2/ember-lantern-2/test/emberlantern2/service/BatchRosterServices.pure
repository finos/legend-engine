###Service
Service test::emberlantern2::service::BatchRosterAsOf
{
  pattern: '/emberlantern2/v1/batchRoster/{processingDate}';
  title: 'Ember Lantern - Batch Roster As Of';
  ownership: UserList { users: ['lantern-workshop-records', 'glassworks-operations'] };
  documentation: 'Enters the milestoned batch accessor with the requested instant and projects the whole mixed-type property surface of the surviving version into a wide labelled tabular result.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {processingDate: StrictDate[1]|test::emberlantern2::domain::LanternBatch.all($processingDate)->project(
      [
        b|$b.batchCode,
        b|$b.workshopCode,
        b|$b.unitCount,
        b|$b.glazeRatio,
        b|$b.wickGrade,
        b|$b.firedOn
      ],
      [
        'Batch Code',
        'Workshop Code',
        'Unit Count',
        'Glaze Ratio',
        'Wick Grade',
        'Fired On'
      ]
    )->sort(
      [
        asc('Batch Code')
      ]
    )};
    mapping: test::emberlantern2::mapping::LanternWorkshopMapping;
    runtime: test::emberlantern2::runtime::LanternWorkshopRuntime;
  }
  testSuites:
  [
    batchRosterAsOfSuite:
    {
      data:
      [
        connections:
        [
          workshopH2:
            Relational
            #{
      workshop.lantern_batch:
        'batch_id,batch_code,workshop_code,unit_count,glaze_ratio,wick_grade,fired_on,in_z,out_z\n'+
        '1,B-100,WS-1,120,0.45,G1,2026-01-10,2026-01-01,2026-03-01\n'+
        '1,B-100,WS-1,150,0.55,G1,2026-02-10,2026-03-01,9999-12-31\n'+
        '2,B-200,WS-2,80,0.3,G2,2026-02-20,2026-02-01,9999-12-31\n'+
        '3,B-300,WS-1,40,0.1,G3,2026-01-05,2026-01-01,2026-02-01\n'+
        '4,B-400,WS-2,200,0.75,G2,2026-05-01,2026-06-01,9999-12-31\n';

      workshop.workshop_site:
        'site_id,workshop_code,site_name,region_code,in_z,out_z\n'+
        '1,WS-1,Ember Lane Workshop,R-N,2026-01-01,9999-12-31\n'+
        '2,WS-2,Harbour Glassworks,R-S,2026-01-01,9999-12-31\n';

      workshop.kiln_run:
        'run_id,batch_code,kiln_code,peak_temp_c,in_z,out_z\n'+
        '1,B-100,K-1,980,2026-01-01,9999-12-31\n'+
        '2,B-100,K-2,1040,2026-01-01,9999-12-31\n'+
        '3,B-200,K-1,760,2026-01-01,2026-03-01\n'+
        '4,B-300,K-3,880,2026-01-01,9999-12-31\n';

      archive.batch_note:
        'note_id,batch_code,note_text,noted_on,in_z,out_z\n'+
        '1,B-100,Second firing recorded,2026-02-11,2026-01-01,9999-12-31\n'+
        '2,B-200,Wick grade re-checked,2026-02-21,2026-01-01,9999-12-31\n'+
        '3,B-300,Batch withdrawn from run,2026-01-06,2026-01-01,2026-02-01\n';
            }#
        ]
      ]
      tests:
      [
        versionValidAtInstant:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            processingDate = %2026-04-01
          ]
          asserts:
          [
            rosterRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Batch Code":"B-100","Workshop Code":"WS-1","Unit Count":150,"Glaze Ratio":0.55,"Wick Grade":"G1","Fired On":"2026-02-10"},{"Batch Code":"B-200","Workshop Code":"WS-2","Unit Count":80,"Glaze Ratio":0.3,"Wick Grade":"G2","Fired On":"2026-02-20"}]';
                  }#;
              }#
          ]
        },
        earlierInstantSeesEarlierVersions:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            processingDate = %2026-01-15
          ]
          asserts:
          [
            earlierRosterRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Batch Code":"B-100","Workshop Code":"WS-1","Unit Count":120,"Glaze Ratio":0.45,"Wick Grade":"G1","Fired On":"2026-01-10"},{"Batch Code":"B-300","Workshop Code":"WS-1","Unit Count":40,"Glaze Ratio":0.1,"Wick Grade":"G3","Fired On":"2026-01-05"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service test::emberlantern2::service::BatchSiteRosterAsOf
{
  pattern: '/emberlantern2/v1/batchSiteRoster/{processingDate}';
  title: 'Ember Lantern - Batch Site Roster As Of';
  ownership: UserList { users: ['lantern-workshop-records', 'glassworks-operations'] };
  documentation: 'Filters the batches visible at the requested instant by a unit-count floor and a membership test over the known workshop codes, then reaches the owning site through the association so the join and the temporal window compose in one statement.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {processingDate: StrictDate[1], minUnits: Integer[1]|test::emberlantern2::domain::LanternBatch.all($processingDate)->filter(
      b|($b.unitCount >= $minUnits) && $b.workshopCode->in(['WS-1', 'WS-2'])
    )->project(
      [
        b|$b.batchCode,
        b|$b.site.siteName,
        b|$b.site.regionCode,
        b|$b.unitCount
      ],
      [
        'Batch Code',
        'Site Name',
        'Region Code',
        'Unit Count'
      ]
    )->sort(
      [
        asc('Batch Code')
      ]
    )};
    mapping: test::emberlantern2::mapping::LanternWorkshopMapping;
    runtime: test::emberlantern2::runtime::LanternWorkshopRuntime;
  }
  testSuites:
  [
    batchSiteRosterAsOfSuite:
    {
      data:
      [
        connections:
        [
          workshopH2:
            Relational
            #{
      workshop.lantern_batch:
        'batch_id,batch_code,workshop_code,unit_count,glaze_ratio,wick_grade,fired_on,in_z,out_z\n'+
        '1,B-100,WS-1,120,0.45,G1,2026-01-10,2026-01-01,2026-03-01\n'+
        '1,B-100,WS-1,150,0.55,G1,2026-02-10,2026-03-01,9999-12-31\n'+
        '2,B-200,WS-2,80,0.3,G2,2026-02-20,2026-02-01,9999-12-31\n'+
        '3,B-300,WS-1,40,0.1,G3,2026-01-05,2026-01-01,2026-02-01\n'+
        '4,B-400,WS-2,200,0.75,G2,2026-05-01,2026-06-01,9999-12-31\n';

      workshop.workshop_site:
        'site_id,workshop_code,site_name,region_code,in_z,out_z\n'+
        '1,WS-1,Ember Lane Workshop,R-N,2026-01-01,9999-12-31\n'+
        '2,WS-2,Harbour Glassworks,R-S,2026-01-01,9999-12-31\n';

      workshop.kiln_run:
        'run_id,batch_code,kiln_code,peak_temp_c,in_z,out_z\n'+
        '1,B-100,K-1,980,2026-01-01,9999-12-31\n'+
        '2,B-100,K-2,1040,2026-01-01,9999-12-31\n'+
        '3,B-200,K-1,760,2026-01-01,2026-03-01\n'+
        '4,B-300,K-3,880,2026-01-01,9999-12-31\n';

      archive.batch_note:
        'note_id,batch_code,note_text,noted_on,in_z,out_z\n'+
        '1,B-100,Second firing recorded,2026-02-11,2026-01-01,9999-12-31\n'+
        '2,B-200,Wick grade re-checked,2026-02-21,2026-01-01,9999-12-31\n'+
        '3,B-300,Batch withdrawn from run,2026-01-06,2026-01-01,2026-02-01\n';
            }#
        ]
      ]
      tests:
      [
        floorExcludesSmallBatch:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            processingDate = %2026-04-01,
            minUnits = 100
          ]
          asserts:
          [
            siteRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Batch Code":"B-100","Site Name":"Ember Lane Workshop","Region Code":"R-N","Unit Count":150}]';
                  }#;
              }#
          ]
        },
        lowerFloorKeepsBoth:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            processingDate = %2026-04-01,
            minUnits = 50
          ]
          asserts:
          [
            bothSiteRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Batch Code":"B-100","Site Name":"Ember Lane Workshop","Region Code":"R-N","Unit Count":150},{"Batch Code":"B-200","Site Name":"Harbour Glassworks","Region Code":"R-S","Unit Count":80}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

Service test::emberlantern2::service::BatchRosterWarehouseAsOf
{
  pattern: '/emberlantern2/v1/warehouse/batchRoster/{processingDate}';
  title: 'Ember Lantern - Batch Roster As Of Through The Warehouse';
  ownership: UserList { users: ['lantern-workshop-records', 'glassworks-operations'] };
  documentation: 'The same milestoned roster read compiled against the cloud-warehouse runtime, so the temporal rewrite and the projected column list are emitted in the warehouse dialect instead of the in-process one.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: {processingDate: StrictDate[1], minUnits: Integer[1]|test::emberlantern2::domain::LanternBatch.all($processingDate)->filter(
      b|$b.unitCount >= $minUnits
    )->project(
      [
        b|$b.batchCode,
        b|$b.workshopCode,
        b|$b.unitCount,
        b|$b.firedOn
      ],
      [
        'Batch Code',
        'Workshop Code',
        'Unit Count',
        'Fired On'
      ]
    )->sort(
      [
        asc('Batch Code')
      ]
    )};
    mapping: test::emberlantern2::mapping::LanternWorkshopMapping;
    runtime: test::emberlantern2::runtime::LanternWarehouseRuntime;
  }
}
