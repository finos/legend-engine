###Runtime
Runtime test::emberlantern2::runtime::LanternWorkshopRuntime
{
  mappings:
  [
    test::emberlantern2::mapping::LanternWorkshopMapping,
    test::emberlantern2::mapping::ArchiveNoteMapping,
    test::emberlantern2::mapping::KilnRunMapping
  ];
  connections:
  [
    test::emberlantern2::store::LanternDB:
    [
      workshopH2: test::emberlantern2::connection::LanternH2Connection
    ]
  ];
}

###Runtime
Runtime test::emberlantern2::runtime::CatalogueRuntime
{
  mappings:
  [
    test::emberlantern2::mapping::CatalogueGlazeMapping
  ];
  connections:
  [
    test::emberlantern2::store::CatalogueDB:
    [
      catalogueH2: test::emberlantern2::connection::CatalogueH2Connection
    ]
  ];
}

###Runtime
Runtime test::emberlantern2::runtime::LanternWarehouseRuntime
{
  mappings:
  [
    test::emberlantern2::mapping::LanternWorkshopMapping
  ];
  connections:
  [
    test::emberlantern2::store::LanternDB:
    [
      warehouse: test::emberlantern2::connection::LanternWarehouseConnection
    ]
  ];
}
