###Mapping
Mapping test::emberlantern2::mapping::CatalogueGlazeMapping
(
  *test::emberlantern2::domain::GlazeRecipe[recipe]: Relational
  {
    ~primaryKey
    (
      [test::emberlantern2::store::CatalogueDB]catalogue.glaze_recipe.recipe_id
    )
    ~mainTable [test::emberlantern2::store::CatalogueDB]catalogue.glaze_recipe
    wickGrade: [test::emberlantern2::store::CatalogueDB]catalogue.glaze_recipe.wick_grade,
    recipeName: [test::emberlantern2::store::CatalogueDB]catalogue.glaze_recipe.recipe_name,
    blendRatio: [test::emberlantern2::store::CatalogueDB]catalogue.glaze_recipe.blend_ratio
  }

  testSuites:
  [
    recipeWindowSuite:
    {
      function: |test::emberlantern2::domain::GlazeRecipe.all(%2026-04-01)->project(
        [
          r|$r.wickGrade,
          r|$r.recipeName,
          r|$r.blendRatio
        ],
        [
          'Wick Grade',
          'Recipe Name',
          'Blend Ratio'
        ]
      )->sort(
        [
          asc('Wick Grade')
        ]
      );
      tests:
      [
        retiredRecipeExcluded:
        {
          doc: 'The recipe whose processing window closed before the requested instant is absent, so the catalogue reads as it stood at that instant.';
          data:
          [
            test::emberlantern2::store::CatalogueDB:
              Relational
              #{
      catalogue.glaze_recipe:
        'recipe_id,wick_grade,recipe_name,blend_ratio,in_z,out_z\n'+
        '1,G1,Amber Wash,0.45,2026-01-01,9999-12-31\n'+
        '2,G2,Slate Wash,0.3,2026-01-01,9999-12-31\n'+
        '3,G3,Retired Wash,0.1,2026-01-01,2026-02-01\n';
              }#
          ];
          asserts:
          [
            recipeRows: EqualToJson
              #{
                expected: ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Wick Grade":"G1","Recipe Name":"Amber Wash","Blend Ratio":0.45},{"Wick Grade":"G2","Recipe Name":"Slate Wash","Blend Ratio":0.3}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
