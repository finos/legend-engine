###Relational
Database test::emberlantern2::store::LanternDB
(
  Schema workshop
  (
    Table lantern_batch
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z, INFINITY_DATE = %9999-12-31T00:00:00.0000)
      )

      batch_id INTEGER PRIMARY KEY,
      batch_code VARCHAR(24) NOT NULL,
      workshop_code VARCHAR(24) NOT NULL,
      unit_count INTEGER NOT NULL,
      glaze_ratio DOUBLE NOT NULL,
      wick_grade VARCHAR(8) NOT NULL,
      fired_on DATE NOT NULL,
      in_z DATE PRIMARY KEY,
      out_z DATE
    )
    Table workshop_site
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z, INFINITY_DATE = %9999-12-31T00:00:00.0000)
      )

      site_id INTEGER PRIMARY KEY,
      workshop_code VARCHAR(24) NOT NULL,
      site_name VARCHAR(120) NOT NULL,
      region_code VARCHAR(24) NOT NULL,
      in_z DATE PRIMARY KEY,
      out_z DATE
    )
    Table kiln_run
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z, INFINITY_DATE = %9999-12-31T00:00:00.0000)
      )

      run_id INTEGER PRIMARY KEY,
      batch_code VARCHAR(24) NOT NULL,
      kiln_code VARCHAR(24) NOT NULL,
      peak_temp_c INTEGER NOT NULL,
      in_z DATE PRIMARY KEY,
      out_z DATE
    )
  )

  Schema archive
  (
    Table batch_note
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z, INFINITY_DATE = %9999-12-31T00:00:00.0000)
      )

      note_id INTEGER PRIMARY KEY,
      batch_code VARCHAR(24) NOT NULL,
      note_text VARCHAR(200) NOT NULL,
      noted_on DATE NOT NULL,
      in_z DATE PRIMARY KEY,
      out_z DATE
    )
  )

  Join Batch_Site(workshop.lantern_batch.workshop_code = workshop.workshop_site.workshop_code)
  Join Batch_KilnRun(workshop.lantern_batch.batch_code = workshop.kiln_run.batch_code)
  Join Batch_Note(workshop.lantern_batch.batch_code = archive.batch_note.batch_code)
)

###Relational
Database test::emberlantern2::store::CatalogueDB
(
  Schema catalogue
  (
    Table glaze_recipe
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z, INFINITY_DATE = %9999-12-31T00:00:00.0000)
      )

      recipe_id INTEGER PRIMARY KEY,
      wick_grade VARCHAR(8) NOT NULL,
      recipe_name VARCHAR(120) NOT NULL,
      blend_ratio DOUBLE NOT NULL,
      in_z DATE PRIMARY KEY,
      out_z DATE
    )
  )
)
