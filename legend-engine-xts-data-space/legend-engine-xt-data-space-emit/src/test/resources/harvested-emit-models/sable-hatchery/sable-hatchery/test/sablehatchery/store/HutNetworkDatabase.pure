###Relational
Database test::sablehatchery::store::HutNetworkDatabase
(
  Schema hutnet
  (
    Table trail_hut
    (
      hut_code VARCHAR(24) PRIMARY KEY,
      hut_name VARCHAR(120) NOT NULL,
      valley_name VARCHAR(80) NOT NULL,
      access_grade VARCHAR(24) NOT NULL,
      season_label VARCHAR(24) NOT NULL,
      custodian_name VARCHAR(120),
      surface_type VARCHAR(40),
      water_source VARCHAR(40),
      bunk_count INTEGER NOT NULL,
      walk_in_hours FLOAT,
      water_tank_kl DECIMAL(9, 2)
    )

    Table stay_record
    (
      stay_id VARCHAR(24) PRIMARY KEY,
      hut_name VARCHAR(120) NOT NULL,
      valley_name VARCHAR(80) NOT NULL,
      access_grade VARCHAR(24) NOT NULL,
      season_label VARCHAR(24) NOT NULL,
      party_size INTEGER NOT NULL,
      check_in_time TIMESTAMP,
      meals_served DECIMAL(9, 2),
      load_factor FLOAT
    )
  )
)
