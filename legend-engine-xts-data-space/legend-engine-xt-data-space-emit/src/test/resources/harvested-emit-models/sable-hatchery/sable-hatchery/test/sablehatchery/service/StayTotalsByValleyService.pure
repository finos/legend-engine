###Service
Service test::sablehatchery::service::StayTotalsByValleyService
{
  pattern: '/hut-network/v1/stay-totals';
  owners:
  [
    'hut-network-office'
  ];
  documentation: 'Aggregate the guests hosted and the stays recorded per valley across the whole network.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |test::sablehatchery::domain::StayRecord.all()->groupBy(
      [
        s|$s.valleyName
      ],
      [
        agg(
          s|$s.partySize,
          vals|$vals->sum()
        ),
        agg(
          s|$s.stayId,
          vals|$vals->count()
        )
      ],
      [
        'Valley',
        'Guests',
        'Stays'
      ]
    )->sort(
      [
        asc('Valley')
      ]
    );
    mapping: test::sablehatchery::mapping::HutNetworkMapping;
    runtime: test::sablehatchery::runtime::HutNetworkRuntime;
  }
  testSuites:
  [
    valleyTotalSuite:
    {
      data:
      [
        connections:
        [
          connection_1:
            Relational
            #{
              hutnet.stay_record:
                'stay_id,hut_name,valley_name,access_grade,season_label,party_size,check_in_time,meals_served,load_factor\n'+
                'SR-01,Kastel Hut,Ober Valley,alpine,high-season,9,2024-07-01 10:00:00,18.50,0.90\n'+
                'SR-02,Kastel Hut,Ober Valley,alpine,high-season,4,2024-07-02 11:00:00,8.00,0.55\n'+
                'SR-03,Ridge Shelter,Ober Valley,alpine,early-season,2,2024-06-05 09:30:00,4.00,0.20\n'+
                'SR-04,Ridge Shelter,Unter Valley,forest,high-season,6,2024-07-04 12:00:00,12.00,0.60\n'+
                'SR-05,Larch Cabin,Ober Valley,alpine,off-season,3,2024-11-02 08:00:00,3.00,0.10\n'+
                'SR-06,Kastel Hut,Ober Valley,alpine,high-season,1,2024-07-06 16:00:00,2.00,0.15\n';
            }#
        ]
      ]
      tests:
      [
        guestsAndStaysPerValley:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            twoValleyGroupsAggregated:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Valley":"Ober Valley","Guests":19,"Stays":5},{"Valley":"Unter Valley","Guests":6,"Stays":1}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
