###DataSpace
DataSpace test::sablehatchery::dataspace::HutNetworkDataSpace
{
  executionContexts:
  [
    {
      name: 'network';
      description: 'Network tier binding the hut store to the network mapping and the warehouse-backed runtime that serves the three endpoints.';
      mapping: test::sablehatchery::mapping::HutNetworkMapping;
      defaultRuntime: test::sablehatchery::runtime::HutNetworkRuntime;
    }
  ];
  defaultExecutionContext: 'network';
  title: 'Sable Hatchery Trail-Hut Network';
  description: 'Entry point over the alpine trail-hut network: huts, the overnight stays recorded against them, and per-valley guest totals.';
  elements:
  [
    test::sablehatchery::domain
  ];
  executables:
  [
    {
      id: 1;
      title: 'Stays by valley and grade';
      description: 'Bands the stays recorded in one valley at one access grade.';
      executable: test::sablehatchery::service::StaysByValleyService;
    },
    {
      id: 2;
      title: 'Huts by valley and grade';
      description: 'Lists the huts of one valley at one access grade.';
      executable: test::sablehatchery::service::HutsByGradeService;
    },
    {
      id: 3;
      title: 'Stay totals by valley';
      description: 'Aggregates guests hosted and stays recorded per valley.';
      executable: test::sablehatchery::service::StayTotalsByValleyService;
    }
  ];
}
