###Connection
RelationalDatabaseConnection test::sablehatchery::connection::HutWarehouseConnection
{
  store: test::sablehatchery::store::HutNetworkDatabase;
  type: Snowflake;
  timezone: 'UTC';
  specification: Snowflake
  {
    name: 'HUT_NETWORK_DB';
    account: 'hut_network_account';
    warehouse: 'HUT_NETWORK_WH';
    region: 'eu-central-1';
    cloudType: 'aws';
    role: 'HUT_NETWORK_READER';
  };
  auth: OAuth
  {
    oauthKey: 'hut_network_oauth_key';
    scopeName: 'SESSION:ROLE-ANY';
  };
}
