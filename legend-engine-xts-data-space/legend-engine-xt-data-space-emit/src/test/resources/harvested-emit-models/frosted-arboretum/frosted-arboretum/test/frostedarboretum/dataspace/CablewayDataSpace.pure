###DataSpace
DataSpace test::frostedarboretum::dataspace::CablewayDataSpace
{
  executionContexts:
  [
    {
      name: 'winter';
      description: 'Winter environment - the seasonal allotment binding served through the winter warehouse.';
      mapping: test::frostedarboretum::mapping::CablewayMapping;
      defaultRuntime: test::frostedarboretum::runtime::CablewayWinterRuntime;
    },
    {
      name: 'shoulder';
      description: 'Shoulder environment - the same binding served through the shoulder-season warehouse.';
      mapping: test::frostedarboretum::mapping::CablewayMapping;
      defaultRuntime: test::frostedarboretum::runtime::CablewayShoulderRuntime;
    }
  ];
  defaultExecutionContext: 'winter';
  title: 'Cableway Cabin Allotments';
  description: 'Discovery surface over the cableway cabin allotments: the business-temporal allotment extent, the station reference behind it and the keyed rollout published over both seasonal environments.';
  elements:
  [
    test::frostedarboretum::domain::CabinAllotment,
    test::frostedarboretum::domain::Station
  ];
  supportInfo: Email
  {
    address: 'cableway-operations-desk@cablewayops.invalid';
  };
}
