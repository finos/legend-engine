###Mapping
Mapping test::frostedarboretum::mapping::CablewayMapping
(
  *test::frostedarboretum::domain::CabinAllotment[cabinAllotment]: Relational
  {
    ~filter [test::frostedarboretum::store::CablewayDb]WinterSeason
    ~primaryKey
    (
      [test::frostedarboretum::store::CablewayDb]cableway.cabin_allotment.allot_id
    )
    ~mainTable [test::frostedarboretum::store::CablewayDb]cableway.cabin_allotment
    cabinCode: [test::frostedarboretum::store::CablewayDb]cableway.cabin_allotment.cabin_code,
    stationCode: [test::frostedarboretum::store::CablewayDb]cableway.cabin_allotment.station_code,
    cabinClass: [test::frostedarboretum::store::CablewayDb]cableway.cabin_allotment.cabin_class,
    plannedZone: [test::frostedarboretum::store::CablewayDb]cableway.cabin_allotment.planned_zone,
    serviceZone: [test::frostedarboretum::store::CablewayDb]cableway.cabin_allotment.service_zone,
    haulKind: [test::frostedarboretum::store::CablewayDb]cableway.cabin_allotment.haul_kind,
    allotState: [test::frostedarboretum::store::CablewayDb]cableway.cabin_allotment.allot_state,
    seatCount: [test::frostedarboretum::store::CablewayDb]cableway.cabin_allotment.seat_count,
    cableLengthM: [test::frostedarboretum::store::CablewayDb]cableway.cabin_allotment.cable_length_m,
    stationName: [test::frostedarboretum::store::CablewayDb]@Allotment_Station | [test::frostedarboretum::store::CablewayDb]cableway.station_ref.station_name,
    staffedFlag: [test::frostedarboretum::store::CablewayDb]@Allotment_Station | [test::frostedarboretum::store::CablewayDb]cableway.station_ref.staffed_flag
  }

  *test::frostedarboretum::domain::Station[station]: Relational
  {
    ~primaryKey
    (
      [test::frostedarboretum::store::CablewayDb]cableway.station_ref.station_code
    )
    ~mainTable [test::frostedarboretum::store::CablewayDb]cableway.station_ref
    stationCode: [test::frostedarboretum::store::CablewayDb]cableway.station_ref.station_code,
    stationName: [test::frostedarboretum::store::CablewayDb]cableway.station_ref.station_name,
    staffedFlag: [test::frostedarboretum::store::CablewayDb]cableway.station_ref.staffed_flag
  }
)
