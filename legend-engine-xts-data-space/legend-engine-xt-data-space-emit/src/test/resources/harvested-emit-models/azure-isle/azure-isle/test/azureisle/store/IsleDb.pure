###Relational
Database test::azureisle::store::IsleDb
(
  Schema reserve
  (
    Table reserve_area
    (
      reserve_code VARCHAR(12) PRIMARY KEY,
      reserve_name VARCHAR(120) NOT NULL,
      warden_team VARCHAR(120)
    )

    Table island
    (
      island_code VARCHAR(12) PRIMARY KEY,
      island_name VARCHAR(120) NOT NULL,
      reserve_code VARCHAR(12) NOT NULL,
      area_ha INTEGER
    )

    Table species
    (
      species_code VARCHAR(12) PRIMARY KEY,
      common_name VARCHAR(120) NOT NULL,
      conservation_tier VARCHAR(12)
    )

    Table colony
    (
      colony_code VARCHAR(12) PRIMARY KEY,
      colony_name VARCHAR(120) NOT NULL,
      island_code VARCHAR(12) NOT NULL,
      species_code VARCHAR(12) NOT NULL,
      founded_on DATE
    )
  )

  Schema survey
  (
    Table nest_plot
    (
      plot_code VARCHAR(12) PRIMARY KEY,
      colony_code VARCHAR(12) NOT NULL,
      habitat_kind VARCHAR(40),
      slope_deg INTEGER
    )

    Table nest_count
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z, INFINITY_DATE = %9999-12-31)
      )

      count_id INTEGER PRIMARY KEY,
      plot_code VARCHAR(12) NOT NULL,
      counted_on DATE NOT NULL,
      nest_total INTEGER NOT NULL,
      chick_total INTEGER,
      observer_code VARCHAR(12),
      weather_code VARCHAR(2),
      count_method VARCHAR(2) NOT NULL,
      in_z DATE PRIMARY KEY,
      out_z DATE NOT NULL
    )

    Table observer
    (
      observer_code VARCHAR(12) NOT NULL,
      observer_name VARCHAR(120) NOT NULL,
      team_code VARCHAR(12) NOT NULL
    )

    Table census_visit
    (
      visit_id INTEGER PRIMARY KEY,
      colony_code VARCHAR(12) NOT NULL,
      visited_at TIMESTAMP NOT NULL,
      visit_status VARCHAR(12) NOT NULL,
      headcount INTEGER
    )

    View colony_latest_visit
    (
      ~filter CompletedVisit
      ~groupBy
      (
        survey.census_visit.colony_code
      )
      colony_code: survey.census_visit.colony_code PRIMARY KEY,
      latest_visit_at: max(survey.census_visit.visited_at),
      peak_headcount: max(survey.census_visit.headcount)
    )

    View observer_roster
    (
      ~filter ActiveObserver
      ~distinct
      observer_code: survey.observer.observer_code PRIMARY KEY,
      observer_name: survey.observer.observer_name,
      team_code: survey.observer.team_code
    )
  )

  Join Count_Plot(survey.nest_count.plot_code = survey.nest_plot.plot_code)
  Join Plot_Colony(survey.nest_plot.colony_code = reserve.colony.colony_code)
  Join Colony_Island(reserve.colony.island_code = reserve.island.island_code)
  Join Island_Reserve(reserve.island.reserve_code = reserve.reserve_area.reserve_code)
  Join Colony_Species(reserve.colony.species_code = reserve.species.species_code)
  Join Count_Observer(survey.nest_count.observer_code = survey.observer_roster.observer_code)
  Join Visit_Colony(survey.colony_latest_visit.colony_code = reserve.colony.colony_code)

  Filter CompletedVisit(survey.census_visit.visit_status = 'DONE' or survey.census_visit.visit_status = 'VERIFIED')
  Filter ActiveObserver(survey.observer.team_code <> 'RETIRED')
)
