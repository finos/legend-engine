###Relational
Database test::solarcavern2::store::CavernDb
(
  Schema speleo
  (
    Table chamber_reading
    (
      reading_id INTEGER PRIMARY KEY,
      chamber_code VARCHAR(24),
      passage_name VARCHAR(64),
      surveyor_team VARCHAR(48),
      depth_m DECIMAL(9,3),
      humidity_pct DECIMAL(5,2),
      logged_at TIMESTAMP,
      calibrated_on DATE,
      lamp_active BIT,
      mapped_on_num DECIMAL(8,0),
      sealed_on_num DECIMAL(8,0),
      sampled_on_num DECIMAL(8,0)
    )
  )
)
