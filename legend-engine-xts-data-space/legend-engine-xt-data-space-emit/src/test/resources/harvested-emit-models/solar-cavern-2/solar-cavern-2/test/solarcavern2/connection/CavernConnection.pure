###Connection
RelationalDatabaseConnection test::solarcavern2::connection::CavernWarehouseConnection
{
  store: test::solarcavern2::store::CavernDb;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'EXAMPLE_CAVERN_MONITORING_DB';
    account: 'example_cavern_account';
    warehouse: 'EXAMPLE_CAVERN_WH';
    region: 'us-east-2';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'CAVERN_MONITORING_READER';
    privateKeyVaultReference: 'cavern.monitoring.privateKey';
    passPhraseVaultReference: 'cavern.monitoring.passPhrase';
  };
}
