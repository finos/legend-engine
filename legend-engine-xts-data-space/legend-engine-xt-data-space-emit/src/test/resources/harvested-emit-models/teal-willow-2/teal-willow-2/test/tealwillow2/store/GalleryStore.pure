###Relational
Database test::tealwillow2::store::GalleryStore
(
  Schema wing
  (
    Table gallery
    (
      gallery_id VARCHAR(16) PRIMARY KEY,
      gallery_name VARCHAR(128),
      wing_code VARCHAR(16)
    )
    Table exhibit
    (
      exhibit_id VARCHAR(16) PRIMARY KEY,
      title VARCHAR(128),
      gallery_id VARCHAR(16),
      curator_id VARCHAR(16),
      theme_code VARCHAR(16)
    )
  )
)
