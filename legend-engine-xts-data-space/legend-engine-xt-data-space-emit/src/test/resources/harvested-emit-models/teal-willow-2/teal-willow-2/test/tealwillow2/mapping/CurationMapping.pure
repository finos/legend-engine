###Mapping
Mapping test::tealwillow2::mapping::CurationMapping
(
  include mapping test::tealwillow2::mapping::GalleryBaseMapping

  *test::tealwillow2::domain::Artifact[artifact]: Relational
  {
    ~primaryKey
    (
      [test::tealwillow2::store::CurationStore]vault.artifact.artifact_id
    )
    ~mainTable [test::tealwillow2::store::CurationStore]vault.artifact
    artifactId: [test::tealwillow2::store::CurationStore]vault.artifact.artifact_id,
    label: toUpper(rtrim([test::tealwillow2::store::CurationStore]vault.artifact.label)),
    material: [test::tealwillow2::store::CurationStore]vault.artifact.material_code,
    conditionLabel: case(
                      equal([test::tealwillow2::store::CurationStore]vault.artifact.condition_code, 'A'),
                      'PRISTINE',
                      case(
                        equal([test::tealwillow2::store::CurationStore]vault.artifact.condition_code, 'B'),
                        'STABLE',
                        case(
                          equal([test::tealwillow2::store::CurationStore]vault.artifact.condition_code, 'C'),
                          'FRAGILE',
                          case(
                            equal([test::tealwillow2::store::CurationStore]vault.artifact.condition_code, 'D'),
                            'GUARDED',
                            case(
                              equal([test::tealwillow2::store::CurationStore]vault.artifact.condition_code, 'E'),
                              concat('REVIEW ', toUpper([test::tealwillow2::store::CurationStore]vault.artifact.material_code)),
                              'UNASSESSED'
                            )
                          )
                        )
                      )
                    ),
    galleryTrail: [test::tealwillow2::store::CurationStore]@Exhibit_Artifact > [test::tealwillow2::store::CurationStore]@Gallery_Exhibit | toUpper([test::tealwillow2::store::CurationStore]wing.gallery.gallery_name)
  }

  *test::tealwillow2::domain::Curator[curator]: Relational
  {
    ~primaryKey
    (
      [test::tealwillow2::store::CurationStore]vault.curator.curator_id
    )
    ~mainTable [test::tealwillow2::store::CurationStore]vault.curator
    curatorId: [test::tealwillow2::store::CurationStore]vault.curator.curator_id,
    curatorName: toUpper(rtrim([test::tealwillow2::store::CurationStore]vault.curator.curator_name)),
    sectionCode: [test::tealwillow2::store::CurationStore]vault.curator.section_code
  }

  test::tealwillow2::domain::Exhibit_Artifact: Relational
  {
    AssociationMapping
    (
      exhibit[artifact, exhibit]: [test::tealwillow2::store::CurationStore]@Exhibit_Artifact,
      artifacts[exhibit, artifact]: [test::tealwillow2::store::CurationStore]@Exhibit_Artifact
    )
  }

  test::tealwillow2::domain::Exhibit_Curator: Relational
  {
    AssociationMapping
    (
      curator[exhibit, curator]: [test::tealwillow2::store::CurationStore]@Exhibit_Curator,
      curatedExhibits[curator, exhibit]: [test::tealwillow2::store::CurationStore]@Exhibit_Curator
    )
  }

  testSuites:
  [
    artifactTrailSuite:
    {
      function: |test::tealwillow2::domain::Artifact.all()->project(
  [
    a|$a.artifactId,
    a|$a.label,
    a|$a.material,
    a|$a.conditionLabel,
    a|$a.galleryTrail->toOne()
  ],
  [
    'ArtifactId',
    'Label',
    'Material',
    'Condition',
    'GalleryTrail'
  ]
)->sort([asc('ArtifactId')]);
      tests:
      [
        trailRows:
        {
          data:
          [
            test::tealwillow2::store::CurationStore: Reference
              #{
                test::tealwillow2::data::CurationTestData
              }#
          ];
          asserts:
          [
            projectedRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"ArtifactId":"A-1","Label":"CEREMONIAL AXE","Material":"STONE","Condition":"PRISTINE","GalleryTrail":"ANCIENT WING"},{"ArtifactId":"A-2","Label":"CAST FIGURINE","Material":"BRONZE","Condition":"STABLE","GalleryTrail":"ANCIENT WING"},{"ArtifactId":"A-3","Label":"NEON PANEL","Material":"CLAY","Condition":"FRAGILE","GalleryTrail":"MODERN WING"},{"ArtifactId":"A-4","Label":"ETCHED PANE","Material":"GLASS","Condition":"UNASSESSED","GalleryTrail":"ANCIENT WING"},{"ArtifactId":"A-5","Label":"DRIFT CARVING","Material":"WOOD","Condition":"PRISTINE","GalleryTrail":null}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
