###Relational
Database test::tealwillow2::store::CurationStore
(
  include test::tealwillow2::store::GalleryStore
  include test::tealwillow2::store::CollectionStore

  Join Gallery_Exhibit(wing.gallery.gallery_id = wing.exhibit.gallery_id)
  Join Exhibit_Artifact(wing.exhibit.exhibit_id = vault.artifact.exhibit_id)
  Join Exhibit_Curator(wing.exhibit.curator_id = vault.curator.curator_id)
)
