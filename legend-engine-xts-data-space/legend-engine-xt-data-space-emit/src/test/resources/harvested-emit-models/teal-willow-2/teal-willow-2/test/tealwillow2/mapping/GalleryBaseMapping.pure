###Mapping
Mapping test::tealwillow2::mapping::GalleryBaseMapping
(
  *test::tealwillow2::domain::Gallery[gallery]: Relational
  {
    ~primaryKey
    (
      [test::tealwillow2::store::CurationStore]wing.gallery.gallery_id
    )
    ~mainTable [test::tealwillow2::store::CurationStore]wing.gallery
    galleryId: [test::tealwillow2::store::CurationStore]wing.gallery.gallery_id,
    galleryName: case(
                   isNotEmpty([test::tealwillow2::store::CurationStore]wing.gallery.gallery_name),
                   toUpper(rtrim([test::tealwillow2::store::CurationStore]wing.gallery.gallery_name)),
                   concat('UNNAMED GALLERY ', [test::tealwillow2::store::CurationStore]wing.gallery.gallery_id)
                 ),
    wingCode: [test::tealwillow2::store::CurationStore]wing.gallery.wing_code
  }

  *test::tealwillow2::domain::Exhibit[exhibit]: Relational
  {
    ~primaryKey
    (
      [test::tealwillow2::store::CurationStore]wing.exhibit.exhibit_id
    )
    ~mainTable [test::tealwillow2::store::CurationStore]wing.exhibit
    exhibitId: [test::tealwillow2::store::CurationStore]wing.exhibit.exhibit_id,
    title: toUpper(rtrim([test::tealwillow2::store::CurationStore]wing.exhibit.title)),
    themeCode: [test::tealwillow2::store::CurationStore]wing.exhibit.theme_code,
    galleryLabel: [test::tealwillow2::store::CurationStore]@Gallery_Exhibit | toUpper([test::tealwillow2::store::CurationStore]wing.gallery.gallery_name),
    curatorLabel: [test::tealwillow2::store::CurationStore]@Exhibit_Curator | toUpper([test::tealwillow2::store::CurationStore]vault.curator.curator_name)
  }

  test::tealwillow2::domain::Gallery_Exhibit: Relational
  {
    AssociationMapping
    (
      gallery[exhibit, gallery]: [test::tealwillow2::store::CurationStore]@Gallery_Exhibit,
      exhibits[gallery, exhibit]: [test::tealwillow2::store::CurationStore]@Gallery_Exhibit
    )
  }
)
