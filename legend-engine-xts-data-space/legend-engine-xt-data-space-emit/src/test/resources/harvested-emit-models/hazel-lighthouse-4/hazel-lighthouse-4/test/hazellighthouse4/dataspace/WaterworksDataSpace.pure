###DataSpace
DataSpace test::hazellighthouse4::dataspace::WaterworksDataSpace
{
  executionContexts:
  [
    {
      name: 'warehouse';
      description: 'Warehouse tier - reservoirs, the pump stations they feed, the service calls raised against them and the crews that answered.';
      mapping: test::hazellighthouse4::mapping::WaterworksMapping;
      defaultRuntime: test::hazellighthouse4::runtime::WaterworksRuntime;
    }
  ];
  defaultExecutionContext: 'warehouse';
  title: 'Waterworks Pump Network';
  description: 'A governed entry point over the municipal pump network - the register of stations serving a district, the rolled up service-call downtime per reservoir and the flow ranking within each district.';
  executables:
  [
    {
      id: 1;
      title: 'Pump Station Register';
      description: 'The district-parameterised register query over the mapped station model.';
      executable: test::hazellighthouse4::service::PumpStationRegisterService;
    },
    {
      id: 2;
      title: 'Reservoir Downtime Rollup';
      description: 'The service-call downtime aggregate rolled up through the chained join to the reservoir.';
      executable: test::hazellighthouse4::service::DistrictDowntimeService;
    },
    {
      id: 3;
      title: 'Pump Station Flow Rank';
      description: 'The partitioned flow ranking over the station projection.';
      executable: test::hazellighthouse4::service::StationFlowRankService;
    }
  ];
  supportInfo: Email
  {
    address: 'pump-network-desk@waterworks.invalid';
  };
}
