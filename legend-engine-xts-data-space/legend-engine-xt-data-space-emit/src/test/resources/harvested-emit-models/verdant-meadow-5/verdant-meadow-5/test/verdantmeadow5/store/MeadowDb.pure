###Relational
Database test::verdantmeadow5::store::MeadowDb
(
  Schema meadow
  (
    Table hay_cut
    (
      cut_code VARCHAR(24) PRIMARY KEY,
      parcel_code VARCHAR(24) NOT NULL,
      season_label VARCHAR(24) NOT NULL,
      cut_week INTEGER NOT NULL,
      yield_bales INTEGER NOT NULL
    )

    Table pollinator_transect
    (
      transect_code VARCHAR(24) PRIMARY KEY,
      parcel_code VARCHAR(24) NOT NULL,
      bee_count INTEGER NOT NULL,
      butterfly_count INTEGER NOT NULL
    )

    Table meadow_parcel
    (
      parcel_code VARCHAR(24) PRIMARY KEY,
      parcel_name VARCHAR(120) NOT NULL,
      quarter_name VARCHAR(60) NOT NULL,
      area_hectares DOUBLE NOT NULL
    )

    Table meadow_parcel_latest
    (
      parcel_code VARCHAR(24) PRIMARY KEY,
      parcel_name VARCHAR(120) NOT NULL,
      quarter_name VARCHAR(60) NOT NULL,
      area_hectares DOUBLE NOT NULL,
      snapshot_tag VARCHAR(24) NOT NULL
    )

    Table sward_sample
    (
      sample_code VARCHAR(24) PRIMARY KEY,
      parcel_code VARCHAR(24) NOT NULL,
      herb_cover_pct INTEGER NOT NULL,
      grass_cover_pct INTEGER NOT NULL,
      sampler_alias VARCHAR(60) NOT NULL
    )
  )
)
