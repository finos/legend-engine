###Service
Service test::verdantmeadow5::service::MeadowParcelRegister
{
  pattern: '/meadow/v1/parcels';
  title: 'Hay Meadow - Parcel Register';
  ownership: DID { identifier: 'meadow-registry' };
  documentation: 'Projects the full-history parcel register: every parcel row the holding has ever recorded, ordered by parcel code.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: |test::verdantmeadow5::domain::MeadowParcel.all()->project(
      [
        p|$p.parcelCode,
        p|$p.parcelName,
        p|$p.quarterName,
        p|$p.areaHectares
      ],
      [
        'Parcel Code',
        'Parcel Name',
        'Quarter Name',
        'Area Hectares'
      ]
    )->sort([asc('Parcel Code')]);
    mapping: test::verdantmeadow5::mapping::MeadowMapping;
    runtime: test::verdantmeadow5::runtime::MeadowRuntime;
  }
  testSuites:
  [
    meadowParcelRegisterSuite:
    {
      data:
      [
        connections:
        [
          meadowCuratedConnection:
            Relational
            #{
              meadow.meadow_parcel:
                'parcel_code,parcel_name,quarter_name,area_hectares\n'+
                'MP-03,Nettle Paddock,West Quarter,1.5\n'+
                'MP-01,Long Meadow,North Quarter,6.5\n'+
                'MP-02,Brook Meadow,North Quarter,4.0\n';
            }#
        ]
      ]
      tests:
      [
        everyParcelInCodeOrder:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            threeParcelsSortedByCode:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Parcel Code":"MP-01","Parcel Name":"Long Meadow","Quarter Name":"North Quarter","Area Hectares":6.5},{"Parcel Code":"MP-02","Parcel Name":"Brook Meadow","Quarter Name":"North Quarter","Area Hectares":4.0},{"Parcel Code":"MP-03","Parcel Name":"Nettle Paddock","Quarter Name":"West Quarter","Area Hectares":1.5}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
