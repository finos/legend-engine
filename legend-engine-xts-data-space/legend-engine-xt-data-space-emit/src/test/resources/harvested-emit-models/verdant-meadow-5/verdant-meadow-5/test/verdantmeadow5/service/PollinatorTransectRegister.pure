###Service
Service test::verdantmeadow5::service::PollinatorTransectRegister
{
  pattern: '/meadow/v1/pollinator-transects';
  title: 'Hay Meadow - Pollinator Transect Register';
  ownership: DID { identifier: 'meadow-fieldwork' };
  documentation: 'Projects every walked pollinator transect with its two counted groups, ordered by transect code.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: |test::verdantmeadow5::domain::PollinatorTransect.all()->project(
      [
        t|$t.transectCode,
        t|$t.parcelCode,
        t|$t.beeCount,
        t|$t.butterflyCount
      ],
      [
        'Transect Code',
        'Parcel Code',
        'Bee Count',
        'Butterfly Count'
      ]
    )->sort([asc('Transect Code')]);
    mapping: test::verdantmeadow5::mapping::MeadowMapping;
    runtime: test::verdantmeadow5::runtime::MeadowRuntime;
  }
  testSuites:
  [
    pollinatorTransectRegisterSuite:
    {
      data:
      [
        connections:
        [
          meadowCuratedConnection:
            Relational
            #{
              meadow.pollinator_transect:
                'transect_code,parcel_code,bee_count,butterfly_count\n'+
                'PT-02,MP-02,64,18\n'+
                'PT-01,MP-01,132,41\n';
            }#
        ]
      ]
      tests:
      [
        bothTransectsWithTheirCounts:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            twoTransectsSortedByCode:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Transect Code":"PT-01","Parcel Code":"MP-01","Bee Count":132,"Butterfly Count":41},{"Transect Code":"PT-02","Parcel Code":"MP-02","Bee Count":64,"Butterfly Count":18}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
