###Service
Service test::verdantmeadow5::service::HayCutRegister
{
  pattern: '/meadow/v1/hay-cuts';
  title: 'Hay Meadow - Cut Register';
  ownership: DID { identifier: 'meadow-fieldwork' };
  documentation: 'Projects the whole hay-cut register into its labelled columns, ordered by cut code, with no narrowing predicate.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: |test::verdantmeadow5::domain::HayCut.all()->project(
      [
        c|$c.cutCode,
        c|$c.parcelCode,
        c|$c.seasonLabel,
        c|$c.cutWeek,
        c|$c.yieldBales
      ],
      [
        'Cut Code',
        'Parcel Code',
        'Season Label',
        'Cut Week',
        'Yield Bales'
      ]
    )->sort([asc('Cut Code')]);
    mapping: test::verdantmeadow5::mapping::MeadowMapping;
    runtime: test::verdantmeadow5::runtime::MeadowRuntime;
  }
  testSuites:
  [
    hayCutRegisterSuite:
    {
      data:
      [
        connections:
        [
          meadowCuratedConnection:
            Relational
            #{
              meadow.hay_cut:
                'cut_code,parcel_code,season_label,cut_week,yield_bales\n'+
                'HC-02,MP-02,summer,26,140\n'+
                'HC-01,MP-01,summer,24,180\n'+
                'HC-03,MP-01,autumn,36,60\n';
            }#
        ]
      ]
      tests:
      [
        everyCutInCodeOrder:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            threeCutsSortedByCode:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Cut Code":"HC-01","Parcel Code":"MP-01","Season Label":"summer","Cut Week":24,"Yield Bales":180},{"Cut Code":"HC-02","Parcel Code":"MP-02","Season Label":"summer","Cut Week":26,"Yield Bales":140},{"Cut Code":"HC-03","Parcel Code":"MP-01","Season Label":"autumn","Cut Week":36,"Yield Bales":60}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
