###Connection
RelationalDatabaseConnection test::verdantmeadow5::connection::MeadowCuratedConnection
{
  store: test::verdantmeadow5::store::MeadowDb;
  type: Snowflake;
  quoteIdentifiers: false;
  specification: Snowflake
  {
    name: 'MEADOW_CURATED';
    account: 'meadow_curated_account';
    warehouse: 'MEADOW_CURATED_WH';
    region: 'eu-west-1';
    cloudType: 'aws';
    accountType: MultiTenant;
    organization: 'meadow_org';
    role: 'MEADOW_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'MEADOW_CURATED_USER';
    privateKeyVaultReference: 'meadow-curated-private-key';
    passPhraseVaultReference: 'meadow-curated-passphrase';
  };
}

###Connection
RelationalDatabaseConnection test::verdantmeadow5::connection::MeadowArchiveConnection
{
  store: test::verdantmeadow5::store::MeadowDb;
  type: Snowflake;
  quoteIdentifiers: false;
  specification: Snowflake
  {
    name: 'MEADOW_ARCHIVE';
    account: 'meadow_archive_account';
    warehouse: 'MEADOW_ARCHIVE_WH';
    region: 'eu-west-1';
    cloudType: 'aws';
    accountType: MultiTenant;
    organization: 'meadow_org';
    role: 'MEADOW_ARCHIVIST';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'MEADOW_ARCHIVE_USER';
    privateKeyVaultReference: 'meadow-archive-private-key';
    passPhraseVaultReference: 'meadow-archive-passphrase';
  };
}
