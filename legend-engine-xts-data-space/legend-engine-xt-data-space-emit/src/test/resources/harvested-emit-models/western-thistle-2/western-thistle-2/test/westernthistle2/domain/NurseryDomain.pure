###Pure
import test::westernthistle2::domain::*;

Class test::westernthistle2::domain::PropagationHouse
{
  houseCode: String[1];
  houseName: String[1];
  glazingType: String[1];
  benchAreaSqm: Float[1];
  heated: Boolean[1];
}

Class test::westernthistle2::domain::Cultivar
{
  cultivarCode: String[1];
  cultivarName: String[1];
  familyName: String[1];
  daysToGerminate: Integer[1];
  seedWeightMg: Decimal[1];
}

Class test::westernthistle2::domain::SeedLot
{
  lotCode: String[1];
  sownOn: StrictDate[1];
  seedCount: Integer[1];
  germinationRate: Float[1];
  treated: Boolean[1];
  house: PropagationHouse[1];
  cultivar: Cultivar[1];
}

Class test::westernthistle2::domain::BenchReading
{
  houseCode: String[1];
  readingAt: DateTime[1];
  airTempC: Float[1];
  humidityPct: Float[1];
  house: PropagationHouse[1];
}
