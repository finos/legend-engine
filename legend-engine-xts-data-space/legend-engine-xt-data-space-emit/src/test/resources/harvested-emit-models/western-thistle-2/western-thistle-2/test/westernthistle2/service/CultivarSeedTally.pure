###Service
Service test::westernthistle2::service::CultivarSeedTally
{
  pattern: '/nursery/v1/cultivar-seed-tally/{minSeedCount}';
  title: 'Propagation Nursery - Cultivar seed tally';
  documentation: 'Aggregates sown seed counts per cultivar and glazing type above a caller-supplied floor, so the same mapping is exercised through a grouped and sorted body rather than a flat projection.';
  autoActivateUpdates: false;
  ownership: DID { identifier: '000000' };
  execution: Single
  {
    query: {minSeedCount: Integer[1]|test::westernthistle2::domain::SeedLot.all()->filter(
      l|$l.seedCount >= $minSeedCount
    )->groupBy(
      [
        l|$l.cultivar.cultivarName,
        l|$l.house.glazingType
      ],
      [
        agg(l|$l.seedCount, c|$c->sum())
      ],
      [
        'Cultivar',
        'Glazing',
        'TotalSeeds'
      ]
    )->sort(
      [
        asc('Cultivar'),
        asc('Glazing')
      ]
    )};
    mapping: test::westernthistle2::mapping::NurseryMapping;
    runtime: test::westernthistle2::runtime::NurseryWarehouseRuntime;
  }
  testSuites:
  [
    cultivarSeedTallySuite:
    {
      data:
      [
        connections:
        [
          nurseryWarehouse:
            Reference
              #{
                test::westernthistle2::data::NurseryFixture
              }#
        ]
      ]
      tests:
      [
        largeLotsOnly:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            minSeedCount = 200
          ]
          asserts:
          [
            oneGroupPerCultivarAndGlazing:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Cultivar":"Frost Kale","Glazing":"double-glazed","TotalSeeds":250},{"Cultivar":"Sunrise Cosmos","Glazing":"double-glazed","TotalSeeds":400},{"Cultivar":"Sunrise Cosmos","Glazing":"single-glazed","TotalSeeds":300}]';
                  }#;
              }#
          ]
        },
        floorAboveEveryLot:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            minSeedCount = 900
          ]
          asserts:
          [
            noGroupSurvivesTheFloor:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
