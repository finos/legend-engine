###Relational
Database test::westernthistle2::store::NurseryDb
(
  Schema nursery
  (
    Table propagation_house
    (
      house_code VARCHAR(20) PRIMARY KEY,
      house_name VARCHAR(80) NOT NULL,
      glazing_type VARCHAR(40) NOT NULL,
      bench_area_sqm FLOAT NOT NULL,
      heated_flag BIT NOT NULL
    )
    Table cultivar
    (
      cultivar_code VARCHAR(20) PRIMARY KEY,
      cultivar_name VARCHAR(80) NOT NULL,
      family_name VARCHAR(60) NOT NULL,
      days_to_germinate INTEGER NOT NULL,
      seed_weight_mg DECIMAL(8, 3) NOT NULL
    )
    Table seed_lot
    (
      lot_code VARCHAR(20) PRIMARY KEY,
      sown_on DATE PRIMARY KEY,
      house_code VARCHAR(20) NOT NULL,
      cultivar_code VARCHAR(20) NOT NULL,
      seed_count INTEGER NOT NULL,
      germination_rate FLOAT NOT NULL,
      treated_flag BIT NOT NULL
    )
    Table bench_reading
    (
      house_code VARCHAR(20) PRIMARY KEY,
      reading_at TIMESTAMP PRIMARY KEY,
      air_temp_c FLOAT NOT NULL,
      humidity_pct FLOAT NOT NULL
    )
  )

  Join SeedLot_House(nursery.seed_lot.house_code = nursery.propagation_house.house_code)
  Join SeedLot_Cultivar(nursery.seed_lot.cultivar_code = nursery.cultivar.cultivar_code)
  Join Reading_House(nursery.bench_reading.house_code = nursery.propagation_house.house_code)
)
