###DataSpace
DataSpace test::westernthistle2::dataspace::NurseryDataSpace
{
  executionContexts:
  [
    {
      name: 'propagation';
      description: 'Propagation environment - the nursery mapping served through the propagation warehouse runtime.';
      mapping: test::westernthistle2::mapping::NurseryMapping;
      defaultRuntime: test::westernthistle2::runtime::NurseryWarehouseRuntime;
    }
  ];
  defaultExecutionContext: 'propagation';
  title: 'Propagation Nursery Bench Estate';
  description: 'Discovery surface over the propagation nursery: the sown seed lots, the houses they occupy and the cultivar reference behind them, with the keyed register and the grouped tally published as executables.';
  elements:
  [
    test::westernthistle2::domain::SeedLot,
    test::westernthistle2::domain::PropagationHouse,
    test::westernthistle2::domain::Cultivar
  ];
  executables:
  [
    {
      id: 1;
      title: 'House Bench Register';
      description: 'The keyed register of seed lots sown in one propagation house.';
      executable: test::westernthistle2::service::HouseBenchRegister;
    },
    {
      id: 2;
      title: 'Cultivar Seed Tally';
      description: 'The grouped seed tally per cultivar and glazing type.';
      executable: test::westernthistle2::service::CultivarSeedTally;
    }
  ];
  supportInfo: Email
  {
    address: 'propagation-bench-desk@nurserypropagation.invalid';
  };
}
