###Connection
RelationalDatabaseConnection test::duskydelta::connection::ApiaryWarehouseConnection
{
  store: test::duskydelta::store::ApiaryDatabase;
  type: Snowflake;
  timezone: +0100;
  quoteIdentifiers: false;
  specification: Snowflake
  {
    name: 'APIARY_FIELD_DB';
    account: 'apiary_field_account';
    warehouse: 'APIARY_FIELD_WH';
    region: 'eu-west-1';
    cloudType: 'aws';
    accountType: MultiTenant;
    organization: 'apiary_field_org';
    role: 'APIARY_FIELD_READER';
  };
  auth: OAuth
  {
    oauthKey: 'apiary_field_oauth_key';
    scopeName: 'SESSION:ROLE:APIARY_FIELD_READER';
  };
}


###Connection
RelationalDatabaseConnection test::duskydelta::connection::ColonyRegistryWarehouseConnection
{
  store: test::duskydelta::store::ColonyRegistryDatabase;
  type: Snowflake;
  timezone: +0100;
  quoteIdentifiers: false;
  specification: Snowflake
  {
    name: 'COLONY_REGISTRY_DB';
    account: 'colony_registry_account';
    warehouse: 'COLONY_REGISTRY_WH';
    region: 'eu-west-1';
    cloudType: 'aws';
    accountType: MultiTenant;
    organization: 'colony_registry_org';
    role: 'COLONY_REGISTRY_READER';
  };
  auth: OAuth
  {
    oauthKey: 'colony_registry_oauth_key';
    scopeName: 'SESSION:ROLE:COLONY_REGISTRY_READER';
  };
}
