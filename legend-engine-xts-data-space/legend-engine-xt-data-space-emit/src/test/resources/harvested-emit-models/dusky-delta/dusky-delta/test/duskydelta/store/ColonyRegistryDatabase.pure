###Relational
Database test::duskydelta::store::ColonyRegistryDatabase
(
  Schema registry
  (
    Table colony_registry
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z, INFINITY_DATE = %9999-12-31)
      )

      colony_id INTEGER PRIMARY KEY,
      hive_code VARCHAR(24) NOT NULL,
      registry_state VARCHAR(24) NOT NULL,
      inspector_code VARCHAR(24) NOT NULL,
      frames_registered INTEGER NOT NULL,
      in_z DATE PRIMARY KEY,
      out_z DATE
    )
  )

  Schema reference
  (
    Table inspector_ref
    (
      inspector_code VARCHAR(24) PRIMARY KEY,
      inspector_name VARCHAR(120) NOT NULL,
      depot_label VARCHAR(60) NOT NULL
    )
  )

  Join Colony_Inspector(registry.colony_registry.inspector_code = reference.inspector_ref.inspector_code)
)
