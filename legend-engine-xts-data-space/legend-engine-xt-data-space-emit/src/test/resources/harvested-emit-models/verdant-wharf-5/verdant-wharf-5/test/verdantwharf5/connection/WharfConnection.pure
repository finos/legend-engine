###Connection
RelationalDatabaseConnection test::verdantwharf5::connection::WharfConnection
{
  store: test::verdantwharf5::store::WharfDB;
  type: Snowflake;
  timezone: 'UTC';
  specification: Snowflake
  {
    name: 'WHARF_OPERATIONS_DB';
    account: 'wharf_operations_account';
    warehouse: 'WHARF_OPERATIONS_WH';
    region: 'eu-west-2';
    cloudType: 'aws';
    accountType: MultiTenant;
    organization: 'harbour_operations_org';
    role: 'WHARF_OPERATIONS_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'wharf_operations_reader';
    privateKeyVaultReference: 'wharf-operations-private-key';
    passPhraseVaultReference: 'wharf-operations-pass-phrase';
  };
}
