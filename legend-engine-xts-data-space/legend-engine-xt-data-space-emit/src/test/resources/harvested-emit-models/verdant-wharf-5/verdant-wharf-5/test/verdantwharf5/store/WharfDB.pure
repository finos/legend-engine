###Relational
Database test::verdantwharf5::store::WharfDB
(
  Schema harbour
  (
    Table wharf_berth
    (
      berth_code VARCHAR(16) PRIMARY KEY,
      opened_on DATE PRIMARY KEY,
      berth_name VARCHAR(120) NOT NULL,
      tide_window VARCHAR(24),
      depth_m FLOAT
    )
    Table vessel_call
    (
      call_code VARCHAR(16) PRIMARY KEY,
      call_leg INTEGER PRIMARY KEY,
      berth_code VARCHAR(16),
      vessel_name VARCHAR(120) NOT NULL,
      arrived_at TIMESTAMP,
      cargo_class VARCHAR(24) NOT NULL,
      pallet_total INTEGER,
      priority_code VARCHAR(8)
    )
  )

  Schema logistics
  (
    Table cargo_pallet
    (
      pallet_code VARCHAR(16) PRIMARY KEY,
      call_code VARCHAR(16),
      call_leg INTEGER,
      pallet_weight_kg DECIMAL(12, 2),
      seal_code VARCHAR(16)
    )
    Table pallet_check
    (
      check_code VARCHAR(16) PRIMARY KEY,
      pallet_code VARCHAR(16),
      inspector_team VARCHAR(60),
      checked_at TIMESTAMP,
      outcome_code VARCHAR(8)
    )
  )

  Join Berth_Call(harbour.vessel_call.berth_code = harbour.wharf_berth.berth_code)
  Join Call_Pallet(logistics.cargo_pallet.call_code = harbour.vessel_call.call_code and logistics.cargo_pallet.call_leg = harbour.vessel_call.call_leg)
  Join Pallet_Check(logistics.pallet_check.pallet_code = logistics.cargo_pallet.pallet_code)
)
