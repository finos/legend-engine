###Pure
Class test::cedarprairie3::domain::PrairiePlot
{
  plotCode: String[1];
  plotName: String[1];
  sectorCode: String[1];
  seededOn: StrictDate[1];
  areaHa: Integer[1];
  nativePct: Integer[1];
  invasivePct: Integer[1];
  restorationBand: String[0..1];
  standNote: String[1];
}

Class test::cedarprairie3::domain::SeedLot
{
  lotCode: String[1];
  mixName: String[1];
  germinationPct: Integer[1];
  purityPct: Integer[1];
  harvestYear: Integer[1];
  viabilityScore: Float[1];
}

Class test::cedarprairie3::domain::StewardCrew
{
  crewCode: String[1];
  crewName: String[1];
  depotCode: String[1];
  staffedCount: Integer[1];
}

Association test::cedarprairie3::domain::Plot_Lot_Link
{
  plots: test::cedarprairie3::domain::PrairiePlot[*];
  lot: test::cedarprairie3::domain::SeedLot[0..1];
}

Association test::cedarprairie3::domain::Plot_Crew_Link
{
  tendedPlots: test::cedarprairie3::domain::PrairiePlot[*];
  crew: test::cedarprairie3::domain::StewardCrew[0..1];
}
