###Mapping
Mapping test::cedarprairie3::mapping::PrairieBaseMapping
(
  *test::cedarprairie3::domain::PrairiePlot[prairiePlot]: Relational
  {
    ~primaryKey
    (
      [test::cedarprairie3::store::PrairieDB]planting.prairie_plot.plot_id
    )
    ~mainTable [test::cedarprairie3::store::PrairieDB]planting.prairie_plot
    plotCode: [test::cedarprairie3::store::PrairieDB]planting.prairie_plot.plot_code,
    plotName: [test::cedarprairie3::store::PrairieDB]planting.prairie_plot.plot_name,
    sectorCode: toUpper(trim([test::cedarprairie3::store::PrairieDB]planting.prairie_plot.sector_code)),
    seededOn: [test::cedarprairie3::store::PrairieDB]planting.prairie_plot.seeded_on,
    areaHa: [test::cedarprairie3::store::PrairieDB]planting.prairie_plot.area_ha,
    nativePct: [test::cedarprairie3::store::PrairieDB]planting.prairie_plot.native_pct,
    invasivePct: [test::cedarprairie3::store::PrairieDB]planting.prairie_plot.invasive_pct,
    restorationBand: case(
                       [test::cedarprairie3::store::PrairieDB]planting.prairie_plot.native_pct >= 90,
                       'REFERENCE',
                       case(
                         [test::cedarprairie3::store::PrairieDB]planting.prairie_plot.native_pct >= 75,
                         'ADVANCED',
                         case(
                           [test::cedarprairie3::store::PrairieDB]planting.prairie_plot.native_pct >= 60,
                           'ESTABLISHING',
                           case(
                             [test::cedarprairie3::store::PrairieDB]planting.prairie_plot.native_pct >= 40 and [test::cedarprairie3::store::PrairieDB]planting.prairie_plot.invasive_pct <= 10,
                             'RECOVERING',
                             case(
                               [test::cedarprairie3::store::PrairieDB]planting.prairie_plot.invasive_pct >= 60,
                               'INVADED',
                               case(
                                 [test::cedarprairie3::store::PrairieDB]planting.prairie_plot.moisture_code = 'WET',
                                 'WET-SETBACK',
                                 case(
                                   [test::cedarprairie3::store::PrairieDB]planting.prairie_plot.canopy_code = 'SHADE',
                                   'SHADED',
                                   case(
                                     [test::cedarprairie3::store::PrairieDB]planting.prairie_plot.native_pct >= 15,
                                     'SPARSE',
                                     sqlNull()
                                   )
                                 )
                               )
                             )
                           )
                         )
                       )
                     ),
    standNote: concat(
                 concat(
                   toUpper([test::cedarprairie3::store::PrairieDB]planting.prairie_plot.canopy_code),
                   '/'
                 ),
                 toLower(substring([test::cedarprairie3::store::PrairieDB]planting.prairie_plot.moisture_code, 1, 3))
               )
  }

  *test::cedarprairie3::domain::SeedLot[seedLot]: Relational
  {
    ~primaryKey
    (
      [test::cedarprairie3::store::PrairieDB]planting.seed_lot.lot_id
    )
    ~mainTable [test::cedarprairie3::store::PrairieDB]planting.seed_lot
    lotCode: [test::cedarprairie3::store::PrairieDB]planting.seed_lot.lot_code,
    mixName: toUpper([test::cedarprairie3::store::PrairieDB]planting.seed_lot.mix_name),
    germinationPct: [test::cedarprairie3::store::PrairieDB]planting.seed_lot.germination_pct,
    purityPct: [test::cedarprairie3::store::PrairieDB]planting.seed_lot.purity_pct,
    harvestYear: [test::cedarprairie3::store::PrairieDB]planting.seed_lot.harvest_year,
    viabilityScore: divide(
                      times(
                        [test::cedarprairie3::store::PrairieDB]planting.seed_lot.germination_pct,
                        [test::cedarprairie3::store::PrairieDB]planting.seed_lot.purity_pct
                      ),
                      100
                    )
  }

  *test::cedarprairie3::domain::StewardCrew[stewardCrew]: Relational
  {
    ~primaryKey
    (
      [test::cedarprairie3::store::PrairieDB]steward.steward_crew.crew_id
    )
    ~mainTable [test::cedarprairie3::store::PrairieDB]steward.steward_crew
    crewCode: [test::cedarprairie3::store::PrairieDB]steward.steward_crew.crew_code,
    crewName: [test::cedarprairie3::store::PrairieDB]steward.steward_crew.crew_name,
    depotCode: toUpper(trim([test::cedarprairie3::store::PrairieDB]steward.steward_crew.depot_code)),
    staffedCount: [test::cedarprairie3::store::PrairieDB]steward.steward_crew.staffed_count
  }
)
