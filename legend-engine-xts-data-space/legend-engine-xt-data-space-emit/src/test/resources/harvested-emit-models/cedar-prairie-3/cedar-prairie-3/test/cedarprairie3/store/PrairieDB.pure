###Relational
Database test::cedarprairie3::store::PrairieDB
(
  Schema planting
  (
    Table prairie_plot
    (
      plot_id INTEGER PRIMARY KEY,
      plot_code VARCHAR(16),
      plot_name VARCHAR(64),
      sector_code VARCHAR(16),
      seeded_on DATE,
      area_ha INTEGER,
      native_pct INTEGER,
      invasive_pct INTEGER,
      canopy_code VARCHAR(16),
      moisture_code VARCHAR(16),
      lot_id INTEGER,
      crew_id INTEGER
    )

    Table seed_lot
    (
      lot_id INTEGER PRIMARY KEY,
      lot_code VARCHAR(16),
      mix_name VARCHAR(64),
      germination_pct INTEGER,
      purity_pct INTEGER,
      harvest_year INTEGER
    )
  )

  Schema steward
  (
    Table steward_crew
    (
      crew_id INTEGER PRIMARY KEY,
      crew_code VARCHAR(16),
      crew_name VARCHAR(64),
      depot_code VARCHAR(16),
      staffed_count INTEGER
    )
  )

  Join Plot_Lot(planting.prairie_plot.lot_id = planting.seed_lot.lot_id)
  Join Plot_Crew(planting.prairie_plot.crew_id = steward.steward_crew.crew_id)
)
