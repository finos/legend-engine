###DataSpace
DataSpace test::cedarprairie3::dataspace::PrairieDataSpace
{
  executionContexts:
  [
    {
      name: 'register';
      description: 'Register environment - the banded plot register served through the prairie register warehouse.';
      mapping: test::cedarprairie3::mapping::PrairieNetworkMapping;
      defaultRuntime: test::cedarprairie3::runtime::PrairieRuntime;
    }
  ];
  defaultExecutionContext: 'register';
  title: 'Cedar Prairie Restoration Register';
  description: 'Discovery surface over the prairie restoration register: the banded plots, the seed lots they were sown from and the steward crews that tend them.';
  elements:
  [
    test::cedarprairie3::domain::PrairiePlot,
    test::cedarprairie3::domain::SeedLot,
    test::cedarprairie3::domain::StewardCrew
  ];
  supportInfo: Email
  {
    address: 'prairie-register-desk@prairieregister.invalid';
  };
}
