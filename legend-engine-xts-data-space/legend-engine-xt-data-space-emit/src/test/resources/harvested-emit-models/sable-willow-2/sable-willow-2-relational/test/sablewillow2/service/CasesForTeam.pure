###Service
Service test::sablewillow2::service::CasesForTeam
{
  pattern: '/rehab/v1/cases/{teamName}';
  title: 'Sable Willow 2 - Intake Cases For A Care Rota';
  ownership: DID { identifier: 'wildlife-rehabilitation-register' };
  documentation: 'Reads the processing-temporal intake register at a pinned instant, keeps the revisions handled by the requested care rota and projects the case alongside its species, its enclosure and the habitat species reached by climbing to the parent complex and crossing onto the reference register.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {teamName: String[1]|test::sablewillow2::domain::IntakeCase.all(%2026-06-01T00:00:00)->filter(
      c|$c.careTeam.teamName->toOne() == $teamName
    )->project(
      [
        c|$c.caseRef,
        c|$c.species.commonName->toOne(),
        c|$c.enclosure.enclosureName->toOne(),
        c|$c.ancestorSpecies.commonName->toOne(),
        c|$c.releaseWeightKg
      ],
      [
        'Case Ref',
        'Species',
        'Enclosure',
        'Ancestor Habitat Species',
        'Release Weight'
      ]
    )->sort(
      [
        asc('Case Ref')
      ]
    )};
    mapping: test::sablewillow2::mapping::RehabMapping;
    runtime: test::sablewillow2::runtime::RehabRuntime;
  }
  testSuites:
  [
    casesForTeamSuite:
    {
      data:
      [
        connections:
        [
          rehabConnection:
            Reference
            #{
              test::sablewillow2::data::RehabTestData
            }#
        ]
      ]
      tests:
      [
        rotaWithTwoLiveRevisions:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            teamName = 'River Ward Rota'
          ]
          asserts:
          [
            twoMultiHopRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Case Ref":"RC-1001","Species":"Eurasian otter","Enclosure":"Otter Pool","Ancestor Habitat Species":"Eurasian otter","Release Weight":3.25},{"Case Ref":"RC-1002","Species":"Barn owl","Enclosure":"Songbird Aviary","Ancestor Habitat Species":"Barn owl","Release Weight":1.75}]';
                  }#;
              }#
          ]
        },
        rotaWhoseOnlyRevisionIsOutOfWindow:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            teamName = 'Woodland Ward Rota'
          ]
          asserts:
          [
            noRowsInsideTheWindow:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
