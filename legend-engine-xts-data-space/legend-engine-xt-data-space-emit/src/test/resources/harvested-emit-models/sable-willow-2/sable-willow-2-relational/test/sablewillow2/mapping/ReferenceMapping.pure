###Mapping
Mapping test::sablewillow2::mapping::ReferenceMapping
(
  *test::sablewillow2::domain::Species[species]: Relational
  {
    ~primaryKey
    (
      [test::sablewillow2::store::RehabDB]reference.species.species_id
    )
    ~mainTable [test::sablewillow2::store::RehabDB]reference.species
    commonName: [test::sablewillow2::store::RehabDB]reference.species.common_name,
    familyName: [test::sablewillow2::store::RehabDB]reference.species.family_name,
    habitatSuitability: [test::sablewillow2::store::RehabDB]reference.species.habitat_suitability
  }

  *test::sablewillow2::domain::CareTeam[careTeam]: Relational
  {
    ~primaryKey
    (
      [test::sablewillow2::store::RehabDB]facility.care_team.team_id
    )
    ~mainTable [test::sablewillow2::store::RehabDB]facility.care_team
    teamName: [test::sablewillow2::store::RehabDB]facility.care_team.team_name,
    rotaCode: [test::sablewillow2::store::RehabDB]facility.care_team.rota_code
  }
)
