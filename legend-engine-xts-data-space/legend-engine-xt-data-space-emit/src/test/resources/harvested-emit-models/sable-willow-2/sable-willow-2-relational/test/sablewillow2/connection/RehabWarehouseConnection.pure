###Connection
RelationalDatabaseConnection test::sablewillow2::connection::RehabWarehouseConnection
{
  store: test::sablewillow2::store::RehabDB;
  type: Snowflake;
  quoteIdentifiers: false;
  specification: Snowflake
  {
    name: 'REHAB_REGISTER';
    account: 'rehab_register_account';
    warehouse: 'REHAB_QUERY_WH';
    region: 'eu-west-2';
    cloudType: 'aws';
    accountType: MultiTenant;
    organization: 'rehab_org';
    role: 'REHAB_REGISTER_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'REHAB_REGISTER_USER';
    privateKeyVaultReference: 'rehabRegister.privateKey';
    passPhraseVaultReference: 'rehabRegister.passPhrase';
  };
  postProcessors:
  [
    mapper
    {
      mappers:
      [
        schema {from: 'intake'; to: 'intake_curated';},
        schema {from: 'facility'; to: 'facility_curated';},
        schema {from: 'reference'; to: 'reference_curated';}
      ];
    }
  ];
}
