###Service
Service test::sablewillow2::service::SpeciesRoster
{
  pattern: '/rehab/v1/species';
  title: 'Sable Willow 2 - Species Reference Roster';
  ownership: DID { identifier: 'wildlife-rehabilitation-register' };
  documentation: 'Publishes the untimelined species reference register through the reporting runtime, projecting the register onto three labelled columns without narrowing it.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: |test::sablewillow2::domain::Species.all()->project(
      [
        s|$s.commonName,
        s|$s.familyName,
        s|$s.habitatSuitability
      ],
      [
        'Common Name',
        'Family Name',
        'Habitat Suitability'
      ]
    )->sort(
      [
        asc('Common Name')
      ]
    );
    mapping: test::sablewillow2::mapping::RehabMapping;
    runtime: test::sablewillow2::runtime::RehabReportingRuntime;
  }
  testSuites:
  [
    speciesRosterSuite:
    {
      data:
      [
        connections:
        [
          rehabReportingConnection:
            Reference
            #{
              test::sablewillow2::data::RehabTestData
            }#
        ]
      ]
      tests:
      [
        wholeRegister:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            fiveReferenceRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Common Name":"Barn owl","Family Name":"Tytonidae","Habitat Suitability":"WOODLAND"},{"Common Name":"Common kingfisher","Family Name":"Alcedinidae","Habitat Suitability":"RIVERBANK"},{"Common Name":"Common swift","Family Name":"Apodidae","Habitat Suitability":"AVIARY"},{"Common Name":"Eurasian otter","Family Name":"Mustelidae","Habitat Suitability":"WETLAND"},{"Common Name":"West European hedgehog","Family Name":"Erinaceidae","Habitat Suitability":"SCRUB"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
