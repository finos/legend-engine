###Relational
Database test::sablewillow2::store::SpeciesReferenceDB
(
  Schema reference
  (
    Table species
    (
      species_id INTEGER PRIMARY KEY,
      common_name VARCHAR(120) NOT NULL,
      family_name VARCHAR(120) NOT NULL,
      habitat_suitability VARCHAR(40) NOT NULL
    )
  )
)

Database test::sablewillow2::store::FacilityDB
(
  include test::sablewillow2::store::SpeciesReferenceDB

  Schema facility
  (
    Table enclosure
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )

      enclosure_id INTEGER PRIMARY KEY,
      enclosure_name VARCHAR(120) NOT NULL,
      habitat_code VARCHAR(40) NOT NULL,
      parent_enclosure_id INTEGER,
      in_z TIMESTAMP NOT NULL,
      out_z TIMESTAMP NOT NULL
    )
    Table care_team
    (
      team_id INTEGER PRIMARY KEY,
      team_name VARCHAR(120) NOT NULL,
      rota_code VARCHAR(40) NOT NULL
    )
  )

  Join Enclosure_Parent(facility.enclosure.parent_enclosure_id = {target}.enclosure_id)

  Join Enclosure_Suitability(toUpper(facility.enclosure.habitat_code) = reference.species.habitat_suitability)
)

Database test::sablewillow2::store::RehabDB
(
  include test::sablewillow2::store::FacilityDB

  Schema intake
  (
    Table rescue_admission
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )

      case_id INTEGER PRIMARY KEY,
      case_ref VARCHAR(40) NOT NULL,
      species_id INTEGER NOT NULL,
      enclosure_id INTEGER NOT NULL,
      team_id INTEGER NOT NULL,
      admitted_at TIMESTAMP NOT NULL,
      release_weight_kg DOUBLE NOT NULL,
      in_z TIMESTAMP NOT NULL,
      out_z TIMESTAMP NOT NULL
    )
  )

  Join Case_Species(intake.rescue_admission.species_id = reference.species.species_id)

  Join Case_Enclosure(intake.rescue_admission.enclosure_id = facility.enclosure.enclosure_id)

  Join Case_Team(intake.rescue_admission.team_id = facility.care_team.team_id)
)
