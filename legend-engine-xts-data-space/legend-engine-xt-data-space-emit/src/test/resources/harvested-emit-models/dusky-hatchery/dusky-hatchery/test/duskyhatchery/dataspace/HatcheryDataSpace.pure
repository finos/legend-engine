###DataSpace
DataSpace test::duskyhatchery::dataspace::HatcheryDataSpace
{
  executionContexts:
  [
    {
      name: 'rearing';
      description: 'Rearing tier - the hatchery store bound through the warehouse connection used for pond operations and test execution.';
      mapping: test::duskyhatchery::mapping::HatcheryMapping;
      defaultRuntime: test::duskyhatchery::runtime::HatcheryRuntime;
    }
  ];
  defaultExecutionContext: 'rearing';
  title: 'Dusky Hatchery Pond Operations';
  description: 'A curated entry point over the freshwater hatchery model - processing-milestoned rearing ponds, their sites and watersheds, species stockings, feed deliveries and water quality readings - wiring the mapping, the runtime, the layout diagrams and the featured endpoints a consumer should start from.';
  diagrams:
  [
    {
      title: 'Pond Layout';
      diagram: test::duskyhatchery::diagram::PondLayoutDiagram;
    },
    {
      title: 'Pond Operations';
      diagram: test::duskyhatchery::diagram::PondOperationsDiagram;
    }
  ];
  elements:
  [
    test::duskyhatchery::domain
  ];
  executables:
  [
    {
      id: 1;
      title: 'Pond register';
      description: 'Featured endpoint returning the ponds recorded at an instant with their site and watershed.';
      executable: test::duskyhatchery::service::PondRegister;
    },
    {
      id: 2;
      title: 'Species stock digest';
      description: 'Featured endpoint returning the stockings of the requested species against the pond version in force.';
      executable: test::duskyhatchery::service::StockDigest;
    },
    {
      id: 3;
      title: 'Feed batch audit';
      description: 'Featured endpoint returning the deliveries of one ration type with their optional supplier annotation.';
      executable: test::duskyhatchery::service::FeedAudit;
    }
  ];
  supportInfo: Email {
    address: 'hatchery-operations@example.invalid';
  };
}
