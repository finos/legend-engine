###Mapping
Mapping test::duskyhatchery::mapping::HatcheryMapping
(
  *test::duskyhatchery::domain::RearingPond[pond]: Relational
  {
    ~primaryKey
    (
      [test::duskyhatchery::store::HatcheryDB]hatchery.rearing_pond.pond_code
    )
    ~mainTable [test::duskyhatchery::store::HatcheryDB]hatchery.rearing_pond
    pondCode: [test::duskyhatchery::store::HatcheryDB]hatchery.rearing_pond.pond_code,
    pondName: [test::duskyhatchery::store::HatcheryDB]hatchery.rearing_pond.pond_name,
    volumeLitres: [test::duskyhatchery::store::HatcheryDB]hatchery.rearing_pond.volume_litres,
    aerated: [test::duskyhatchery::store::HatcheryDB]hatchery.rearing_pond.aerated,
    commissionedOn: [test::duskyhatchery::store::HatcheryDB]hatchery.rearing_pond.commissioned_on,
    site[site]: [test::duskyhatchery::store::HatcheryDB]@Pond_Site,
    stocks[stock]: [test::duskyhatchery::store::HatcheryDB]@Pond_Stock,
    feedBatches[feed]: [test::duskyhatchery::store::HatcheryDB]@Pond_Feed,
    readings[reading]: [test::duskyhatchery::store::HatcheryDB]@Pond_Reading
  }

  *test::duskyhatchery::domain::HatcherySite[site]: Relational
  {
    ~primaryKey
    (
      [test::duskyhatchery::store::HatcheryDB]hatchery.hatchery_site.site_code
    )
    ~mainTable [test::duskyhatchery::store::HatcheryDB]hatchery.hatchery_site
    siteCode: [test::duskyhatchery::store::HatcheryDB]hatchery.hatchery_site.site_code,
    siteName: [test::duskyhatchery::store::HatcheryDB]hatchery.hatchery_site.site_name,
    watershed: [test::duskyhatchery::store::HatcheryDB]hatchery.hatchery_site.watershed,
    elevationMetres: [test::duskyhatchery::store::HatcheryDB]hatchery.hatchery_site.elevation_metres,
    ponds[pond]: [test::duskyhatchery::store::HatcheryDB]@Pond_Site
  }

  *test::duskyhatchery::domain::SpeciesStock[stock]: Relational
  {
    ~primaryKey
    (
      [test::duskyhatchery::store::HatcheryDB]hatchery.species_stock.stock_code
    )
    ~mainTable [test::duskyhatchery::store::HatcheryDB]hatchery.species_stock
    stockCode: [test::duskyhatchery::store::HatcheryDB]hatchery.species_stock.stock_code,
    speciesName: [test::duskyhatchery::store::HatcheryDB]hatchery.species_stock.species_name,
    fryCount: [test::duskyhatchery::store::HatcheryDB]hatchery.species_stock.fry_count,
    meanGrams: [test::duskyhatchery::store::HatcheryDB]hatchery.species_stock.mean_grams,
    stockedAt: [test::duskyhatchery::store::HatcheryDB]hatchery.species_stock.stocked_at,
    pond[pond]: [test::duskyhatchery::store::HatcheryDB]@Pond_Stock
  }

  *test::duskyhatchery::domain::FeedBatch[feed]: Relational
  {
    ~primaryKey
    (
      [test::duskyhatchery::store::HatcheryDB]hatchery.feed_batch.batch_code
    )
    ~mainTable [test::duskyhatchery::store::HatcheryDB]hatchery.feed_batch
    batchCode: [test::duskyhatchery::store::HatcheryDB]hatchery.feed_batch.batch_code,
    feedType: [test::duskyhatchery::store::HatcheryDB]hatchery.feed_batch.feed_type,
    kilograms: [test::duskyhatchery::store::HatcheryDB]hatchery.feed_batch.kilograms,
    deliveredOn: [test::duskyhatchery::store::HatcheryDB]hatchery.feed_batch.delivered_on,
    supplierNote: [test::duskyhatchery::store::HatcheryDB]hatchery.feed_batch.supplier_note,
    fedPond[pond]: [test::duskyhatchery::store::HatcheryDB]@Pond_Feed
  }

  *test::duskyhatchery::domain::WaterReading[reading]: Relational
  {
    ~primaryKey
    (
      [test::duskyhatchery::store::HatcheryDB]hatchery.water_reading.reading_id
    )
    ~mainTable [test::duskyhatchery::store::HatcheryDB]hatchery.water_reading
    readingId: [test::duskyhatchery::store::HatcheryDB]hatchery.water_reading.reading_id,
    temperatureC: [test::duskyhatchery::store::HatcheryDB]hatchery.water_reading.temperature_c,
    oxygenMgl: [test::duskyhatchery::store::HatcheryDB]hatchery.water_reading.oxygen_mgl,
    recordedAt: [test::duskyhatchery::store::HatcheryDB]hatchery.water_reading.recorded_at,
    compliant: [test::duskyhatchery::store::HatcheryDB]hatchery.water_reading.compliant,
    monitoredPond[pond]: [test::duskyhatchery::store::HatcheryDB]@Pond_Reading
  }

  testSuites:
  [
    waterReadingSuite:
    {
      function: |test::duskyhatchery::domain::WaterReading.all()->project(
        [
          r|$r.readingId,
          r|$r.monitoredPond(%2026-06-01).pondCode,
          r|$r.temperatureC,
          r|$r.oxygenMgl,
          r|$r.recordedAt,
          r|$r.compliant
        ],
        [
          'Reading',
          'Pond',
          'Temperature',
          'Oxygen',
          'Recorded',
          'Compliant'
        ]
      )->sort(
        [
          asc('Reading')
        ]
      );
      tests:
      [
        readingsResolveTheirRecordedPond:
        {
          doc: 'Every reading binds through the declared identity column set and the anchoring main table alias, and the pond it points at is the version recorded at the queried processing instant.';
          data:
          [
            test::duskyhatchery::store::HatcheryDB:
              Relational
              #{
                hatchery.rearing_pond:
                'pond_code,pond_name,site_code,volume_litres,aerated,commissioned_on,in_z,out_z\n'+
                'P-01,Alder Raceway,S-1,42000,true,2024-03-01,2026-01-01,9999-12-31\n'+
                'P-02,Birch Basin,S-1,31000,false,2023-07-15,2026-01-01,9999-12-31\n'+
                'P-03,Cedar Channel,S-2,55000,true,2025-01-20,2026-01-01,9999-12-31\n'+
                'P-04,Dogwood Trough,S-2,18000,false,2022-11-05,2026-01-01,9999-12-31\n'+
                'P-05,Elm Pool,S-3,27000,true,2024-09-30,2026-01-01,9999-12-31\n'+
                'P-06,Fir Tank,S-3,9000,false,2021-05-12,2020-01-01,2026-01-01\n'+
                'P-06,Fir Tank,S-3,12000,true,2021-05-12,2026-01-01,9999-12-31\n';
                hatchery.hatchery_site:
                'site_code,site_name,watershed,elevation_metres\n'+
                'S-1,Northern Hatchery,Aspen Creek,310\n'+
                'S-2,Coastal Hatchery,Salt Marsh,40\n'+
                'S-3,Upland Hatchery,Granite Brook,720\n';
                hatchery.species_stock:
                'stock_code,pond_code,species_name,fry_count,mean_grams,stocked_at\n'+
                'ST-01,P-01,Brook Char,12000,4.5,2026-02-10 08:00:00\n'+
                'ST-02,P-01,Rainbow Trout,9000,6.25,2026-03-04 09:30:00\n'+
                'ST-03,P-02,Brook Char,4000,3.75,2026-01-22 07:45:00\n'+
                'ST-04,P-03,Arctic Grayling,15000,2.5,2026-04-18 10:00:00\n'+
                'ST-05,P-04,Rainbow Trout,1200,8.0,2026-05-02 11:15:00\n'+
                'ST-06,P-05,Brook Char,7000,5.5,2026-05-21 06:30:00\n'+
                'ST-07,P-06,Arctic Grayling,800,1.75,2026-03-30 12:00:00\n';
                hatchery.feed_batch:
                'batch_code,pond_code,feed_type,kilograms,delivered_on,supplier_note\n'+
                'FB-01,P-01,STARTER,120.5,2026-02-01,Delivered in sealed drums\n'+
                'FB-02,P-01,GROWER,340.0,2026-03-15,\n'+
                'FB-03,P-02,STARTER,80.25,2026-02-20,Split across two pallets\n'+
                'FB-04,P-03,FINISHER,560.0,2026-04-05,\n'+
                'FB-05,P-04,GROWER,45.5,2026-05-10,Short delivery noted\n'+
                'FB-06,P-05,STARTER,210.0,2026-05-25,\n'+
                'FB-07,P-06,FINISHER,30.0,2026-04-02,Trial ration\n';
                hatchery.water_reading:
                'reading_id,pond_code,temperature_c,oxygen_mgl,recorded_at,compliant\n'+
                '1,P-01,11.5,9.2,2026-05-30 06:00:00,true\n'+
                '2,P-01,14.0,7.8,2026-05-31 06:00:00,true\n'+
                '3,P-02,16.5,6.1,2026-05-30 06:00:00,false\n'+
                '4,P-03,10.0,10.4,2026-05-30 06:00:00,true\n'+
                '5,P-04,18.25,5.4,2026-05-31 06:00:00,false\n'+
                '6,P-05,12.75,8.9,2026-05-30 06:00:00,true\n'+
                '7,P-06,19.0,4.8,2026-05-31 06:00:00,false\n';
              }#
          ];
          asserts:
          [
            mappedReadings:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Reading":1,"Pond":"P-01","Temperature":11.5,"Oxygen":9.2,"Recorded":"2026-05-30T06:00:00.000000000+0000","Compliant":true},{"Reading":2,"Pond":"P-01","Temperature":14.0,"Oxygen":7.8,"Recorded":"2026-05-31T06:00:00.000000000+0000","Compliant":true},{"Reading":3,"Pond":"P-02","Temperature":16.5,"Oxygen":6.1,"Recorded":"2026-05-30T06:00:00.000000000+0000","Compliant":false},{"Reading":4,"Pond":"P-03","Temperature":10.0,"Oxygen":10.4,"Recorded":"2026-05-30T06:00:00.000000000+0000","Compliant":true},{"Reading":5,"Pond":"P-04","Temperature":18.25,"Oxygen":5.4,"Recorded":"2026-05-31T06:00:00.000000000+0000","Compliant":false},{"Reading":6,"Pond":"P-05","Temperature":12.75,"Oxygen":8.9,"Recorded":"2026-05-30T06:00:00.000000000+0000","Compliant":true},{"Reading":7,"Pond":"P-06","Temperature":19.0,"Oxygen":4.8,"Recorded":"2026-05-31T06:00:00.000000000+0000","Compliant":false}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
