###Connection
RelationalDatabaseConnection test::duskyhatchery::connection::HatcheryConnection
{
  store: test::duskyhatchery::store::HatcheryDB;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'HATCHERY_DB';
    account: 'hatchery_account';
    warehouse: 'HATCHERY_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    role: 'HATCHERY_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'HATCHERY_USER';
    privateKeyVaultReference: 'hatchery.privateKey';
    passPhraseVaultReference: 'hatchery.passPhrase';
  };
}
