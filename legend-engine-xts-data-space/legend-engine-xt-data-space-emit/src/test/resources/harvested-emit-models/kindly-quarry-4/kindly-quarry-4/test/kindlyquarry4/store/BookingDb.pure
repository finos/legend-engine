###Relational
Database test::kindlyquarry4::store::ObservatoryBookingDb
(
  Schema BOOKING
  (
    Table TELESCOPE_BOOKING
    (
      BOOKING_CODE VARCHAR(20) PRIMARY KEY,
      BRANCH_CODE VARCHAR(20) NOT NULL,
      INSTRUMENT_CODE VARCHAR(20) NOT NULL,
      BOOKING_TIER VARCHAR(20) NOT NULL,
      OPTIC_GRADE VARCHAR(20) NOT NULL,
      BOOKED_ON DATE NOT NULL,
      COLLECTED_AT TIMESTAMP NOT NULL,
      NIGHTS_BOOKED INTEGER NOT NULL,
      APERTURE_MM INTEGER NOT NULL
    )
  )
)
