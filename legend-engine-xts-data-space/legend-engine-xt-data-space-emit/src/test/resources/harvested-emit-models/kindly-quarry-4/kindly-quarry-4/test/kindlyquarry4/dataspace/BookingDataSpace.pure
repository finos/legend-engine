###DataSpace
DataSpace test::kindlyquarry4::dataspace::ObservatoryBookingDataSpace
{
  executionContexts:
  [
    {
      name: 'bookings';
      description: 'Booking environment - the telescope booking binding served through the observatory booking register.';
      mapping: test::kindlyquarry4::mapping::ObservatoryBookingMapping;
      defaultRuntime: test::kindlyquarry4::runtime::ObservatoryBookingRuntime;
    }
  ];
  defaultExecutionContext: 'bookings';
  title: 'Kindly Quarry 4 Observatory Booking Register';
  description: 'Discovery surface over the community observatory booking register: the bookings themselves, the lending tiers they are booked under and the optical families of the instruments lent.';
  elements:
  [
    test::kindlyquarry4::domain::TelescopeBooking
  ];
  supportInfo: Email
  {
    address: 'observatory-booking-desk@observatorybookings.invalid';
  };
}
