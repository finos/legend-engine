Enum {meta::pure::profiles::doc.doc = 'The lending tier a telescope booking was taken under.'} test::kindlyquarry4::domain::BookingTier
{
  STANDARD,
  EXTENDED,
  TUITION
}

Enum {meta::pure::profiles::doc.doc = 'The optical family of the instrument that was lent out.'} test::kindlyquarry4::domain::OpticGrade
{
  REFRACTOR,
  REFLECTOR,
  CATADIOPTRIC
}

Class {meta::pure::profiles::doc.doc = 'One telescope lent from a community observatory branch, carrying the tier it was booked under and the optical family of the instrument.'} test::kindlyquarry4::domain::TelescopeBooking
{
  bookingCode: String[1];
  branchCode: String[1];
  instrumentCode: String[1];
  bookingTier: test::kindlyquarry4::domain::BookingTier[1];
  opticGrade: test::kindlyquarry4::domain::OpticGrade[1];
  bookedOn: StrictDate[1];
  collectedAt: DateTime[1];
  nightsBooked: Integer[1];
  apertureMm: Integer[1];
}
