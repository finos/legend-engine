###Relational
Database test::sablebeacon::store::GaugeDB
(
  Schema hydro
  (
    Table reading
    (
      reading_id INTEGER PRIMARY KEY,
      sensor_id INTEGER NOT NULL,
      reading_date DATE NOT NULL,
      level_cm INTEGER NOT NULL,
      grade_code VARCHAR(10) NOT NULL
    )
    Table sensor
    (
      sensor_id INTEGER PRIMARY KEY,
      sensor_name VARCHAR(200) NOT NULL,
      station_id INTEGER NOT NULL
    )
    Table station
    (
      station_id INTEGER PRIMARY KEY,
      station_name VARCHAR(200) NOT NULL,
      district_id INTEGER NOT NULL
    )
    Table district
    (
      district_id INTEGER PRIMARY KEY,
      district_name VARCHAR(200) NOT NULL,
      gauge_zone_id INTEGER NOT NULL
    )
    Table gauge_zone
    (
      gauge_zone_id INTEGER PRIMARY KEY,
      gauge_zone_name VARCHAR(200) NOT NULL,
      basin_id INTEGER NOT NULL
    )
    Table basin
    (
      basin_id INTEGER PRIMARY KEY,
      basin_name VARCHAR(200) NOT NULL
    )

    View ReadingBasinView
    (
      reading_id: hydro.reading.reading_id PRIMARY KEY,
      basin_name: @Reading_Sensor > @Sensor_Station > @Station_District > @District_GaugeZone > @GaugeZone_Basin | hydro.basin.basin_name
    )
  )

  Join Reading_Sensor(hydro.reading.sensor_id = hydro.sensor.sensor_id)
  Join Sensor_Station(hydro.sensor.station_id = hydro.station.station_id)
  Join Station_District(hydro.station.district_id = hydro.district.district_id)
  Join District_GaugeZone(hydro.district.gauge_zone_id = hydro.gauge_zone.gauge_zone_id)
  Join GaugeZone_Basin(hydro.gauge_zone.basin_id = hydro.basin.basin_id)
)
