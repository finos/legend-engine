import test::sablebeacon::domain::*;

Class {meta::pure::profiles::doc.doc = 'A single water-level reading taken by a river gauge sensor.'} test::sablebeacon::domain::Reading
{
  readingId: Integer[1];
  readingDate: StrictDate[1];
  levelCm: Integer[1];
  gradeCode: String[1];
  gradeLabel: String[0..1];
  sensorName: String[0..1];
  basinName: String[0..1];
  levelBand() {if($this.levelCm >= 200, | 'HIGH', | if($this.levelCm >= 80, | 'NORMAL', | 'LOW'))}: String[1];
  gradedLabel() {$this.gradeCode + ' / ' + $this.levelBand()}: String[1];
  isGraded() {$this.gradeLabel->isNotEmpty()}: Boolean[1];
}

Class {meta::pure::profiles::doc.doc = 'A reading resolved to its drainage basin through the view-backed join chain.'} test::sablebeacon::domain::ReadingBasin
{
  readingId: Integer[1];
  basinName: String[0..1];
}
