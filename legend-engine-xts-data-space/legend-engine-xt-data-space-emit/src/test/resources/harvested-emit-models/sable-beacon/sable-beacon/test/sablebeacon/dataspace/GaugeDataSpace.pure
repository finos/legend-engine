###DataSpace
DataSpace test::sablebeacon::dataspace::GaugeDataSpace
{
  executionContexts:
  [
    {
      name: 'survey';
      description: 'Field survey tier backed by the in-process gauge store.';
      mapping: test::sablebeacon::mapping::GaugeMapping;
      defaultRuntime: test::sablebeacon::runtime::GaugeRuntime;
    },
    {
      name: 'published';
      description: 'Published tier serving the curated river gauge network.';
      mapping: test::sablebeacon::mapping::GaugeMapping;
      defaultRuntime: test::sablebeacon::runtime::GaugeRuntime;
    }
  ];
  defaultExecutionContext: 'published';
  title: 'River Gauge Network';
  description: 'A governed view of river gauge readings resolved through the sensor, station, district, zone and basin hierarchy.';
}
