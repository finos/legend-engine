###Connection
RelationalDatabaseConnection test::russetcanyon2::connection::CanyonWarehouseConnection
{
  store: test::russetcanyon2::store::CanyonDatabase;
  type: Snowflake;
  timezone: +0000;
  quoteIdentifiers: false;
  specification: Snowflake
  {
    name: 'RUSSET_CANYON_SURVEY_DB';
    account: 'russet_canyon_account';
    warehouse: 'RUSSET_CANYON_WH';
    region: 'us-west-2';
    cloudType: 'aws';
    role: 'CANYON_SURVEY_ROLE';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'CANYON_SURVEY_USER';
    privateKeyVaultReference: 'russet-canyon-private-key';
    passPhraseVaultReference: 'russet-canyon-passphrase';
  };
}
