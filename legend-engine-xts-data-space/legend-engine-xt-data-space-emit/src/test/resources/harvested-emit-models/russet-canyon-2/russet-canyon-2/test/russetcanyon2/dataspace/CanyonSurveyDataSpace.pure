###DataSpace
DataSpace test::russetcanyon2::dataspace::CanyonSurveyDataSpace
{
  executionContexts:
  [
    {
      name: 'survey';
      description: 'Survey context - the included canyon mapping served through the survey warehouse runtime.';
      mapping: test::russetcanyon2::mapping::CanyonMapping;
      defaultRuntime: test::russetcanyon2::runtime::CanyonRuntime;
    }
  ];
  defaultExecutionContext: 'survey';
  title: 'Russet Canyon Trail Survey';
  description: 'Governed entry point over the processing-temporal canyon trail survey: trail heads, their segments and the rock layers beneath them, reached through the included mapping and the survey warehouse runtime.';
  elements:
  [
    test::russetcanyon2::domain::TrailSegment
  ];
  executables:
  [
    {
      id: 1;
      title: 'Segment Grade Survey';
      description: 'The graded-segment window query published to survey consumers.';
      executable: test::russetcanyon2::service::SegmentGradeSurvey;
    }
  ];
  supportInfo: Email
  {
    address: 'canyon-trail-survey@canyonsurvey.invalid';
  };
}
