###Diagram
Diagram test::russetcanyon2::diagram::CanyonDiagram
{
  classView trailHead
  {
    class: test::russetcanyon2::domain::TrailHead;
    position: (40.0, 40.0);
    rectangle: (240.0, 140.0);
  }
  classView trailSegment
  {
    class: test::russetcanyon2::domain::TrailSegment;
    position: (380.0, 40.0);
    rectangle: (240.0, 140.0);
  }
  classView rockLayer
  {
    class: test::russetcanyon2::domain::RockLayer;
    position: (380.0, 260.0);
    rectangle: (240.0, 120.0);
  }
  propertyView
  {
    property: test::russetcanyon2::domain::TrailHead_Segment.segments;
    source: trailHead;
    target: trailSegment;
    points: [(160.0, 110.0), (500.0, 110.0)];
  }
  propertyView
  {
    property: test::russetcanyon2::domain::Segment_Layer.layers;
    source: trailSegment;
    target: rockLayer;
    points: [(500.0, 110.0), (500.0, 320.0)];
  }
}
