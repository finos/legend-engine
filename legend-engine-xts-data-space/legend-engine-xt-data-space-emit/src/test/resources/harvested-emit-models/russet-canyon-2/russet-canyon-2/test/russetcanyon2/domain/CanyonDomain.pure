###Pure
Class <<meta::pure::profiles::temporal.processingtemporal>> test::russetcanyon2::domain::TrailHead
{
  trailCode: String[1];
  trailName: String[1];
  elevationM: Integer[1];
  accessNote: String[0..1];
}

Class <<meta::pure::profiles::temporal.processingtemporal>> test::russetcanyon2::domain::TrailSegment
{
  segmentCode: String[1];
  surfaceType: String[1];
  lengthM: Integer[1];
  gradePercent: Integer[1];
}

Class <<meta::pure::profiles::temporal.processingtemporal>> test::russetcanyon2::domain::RockLayer
{
  layerCode: String[1];
  layerName: String[1];
  thicknessM: Integer[1];
}

Association test::russetcanyon2::domain::TrailHead_Segment
{
  head: test::russetcanyon2::domain::TrailHead[0..1];
  segments: test::russetcanyon2::domain::TrailSegment[*];
}

Association test::russetcanyon2::domain::Segment_Layer
{
  segment: test::russetcanyon2::domain::TrailSegment[0..1];
  layers: test::russetcanyon2::domain::RockLayer[*];
}
