###Mapping
Mapping test::russetcanyon2::mapping::CanyonBaseMapping
(
  *test::russetcanyon2::domain::TrailHead[head]: Relational
  {
    ~primaryKey
    (
      [test::russetcanyon2::store::CanyonDatabase]canyon.trail_head.trail_code
    )
    ~mainTable [test::russetcanyon2::store::CanyonDatabase]canyon.trail_head
    trailCode: [test::russetcanyon2::store::CanyonDatabase]canyon.trail_head.trail_code,
    trailName: [test::russetcanyon2::store::CanyonDatabase]canyon.trail_head.trail_name,
    elevationM: [test::russetcanyon2::store::CanyonDatabase]canyon.trail_head.elevation_m,
    accessNote: [test::russetcanyon2::store::CanyonDatabase]canyon.trail_head.access_note
  }

  *test::russetcanyon2::domain::TrailSegment[segment]: Relational
  {
    ~primaryKey
    (
      [test::russetcanyon2::store::CanyonDatabase]canyon.trail_segment.segment_code
    )
    ~mainTable [test::russetcanyon2::store::CanyonDatabase]canyon.trail_segment
    segmentCode: [test::russetcanyon2::store::CanyonDatabase]canyon.trail_segment.segment_code,
    surfaceType: [test::russetcanyon2::store::CanyonDatabase]canyon.trail_segment.surface_type,
    lengthM: [test::russetcanyon2::store::CanyonDatabase]canyon.trail_segment.length_m,
    gradePercent: [test::russetcanyon2::store::CanyonDatabase]canyon.trail_segment.grade_percent
  }

  *test::russetcanyon2::domain::RockLayer[layer]: Relational
  {
    ~primaryKey
    (
      [test::russetcanyon2::store::CanyonDatabase]canyon.rock_layer.layer_code
    )
    ~mainTable [test::russetcanyon2::store::CanyonDatabase]canyon.rock_layer
    layerCode: [test::russetcanyon2::store::CanyonDatabase]canyon.rock_layer.layer_code,
    layerName: [test::russetcanyon2::store::CanyonDatabase]canyon.rock_layer.layer_name,
    thicknessM: [test::russetcanyon2::store::CanyonDatabase]canyon.rock_layer.thickness_m
  }

  test::russetcanyon2::domain::TrailHead_Segment: Relational
  {
    AssociationMapping
    (
      segments[head, segment]: [test::russetcanyon2::store::CanyonDatabase]@Head_Segment_J,
      head[segment, head]: [test::russetcanyon2::store::CanyonDatabase]@Head_Segment_J
    )
  }

  test::russetcanyon2::domain::Segment_Layer: Relational
  {
    AssociationMapping
    (
      layers[segment, layer]: [test::russetcanyon2::store::CanyonDatabase]@Segment_Layer_J,
      segment[layer, segment]: [test::russetcanyon2::store::CanyonDatabase]@Segment_Layer_J
    )
  }
)
