###Connection
RelationalDatabaseConnection test::amberestuary2::connection::ReedBedWarehouseConnection
{
  store: test::amberestuary2::store::ReedBedDatabase;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'WETLAND_DB';
    account: 'wetland_reserve_account';
    warehouse: 'WETLAND_WH';
    region: 'eu-west-2';
    cloudType: 'aws';
    role: 'WETLAND_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'WETLAND_SURVEY_USER';
    privateKeyVaultReference: 'wetland.privateKey';
    passPhraseVaultReference: 'wetland.passPhrase';
  };
}
