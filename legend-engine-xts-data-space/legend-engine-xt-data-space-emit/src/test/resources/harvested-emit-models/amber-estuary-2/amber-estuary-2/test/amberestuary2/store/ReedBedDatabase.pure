###Relational
Database test::amberestuary2::store::ReedBedDatabase
(
  Schema wetland
  (
    Table reed_plot
    (
      plot_code VARCHAR(24) NOT NULL,
      survey_date DATE,
      plot_label VARCHAR(120) NOT NULL,
      sector_code VARCHAR(24) NOT NULL,
      reed_density DOUBLE NOT NULL,
      water_depth_cm DOUBLE NOT NULL,
      stem_count INTEGER NOT NULL,
      salinity_psu DOUBLE,
      canopy_pct DOUBLE,
      warden_code VARCHAR(24),
      habitat_note VARCHAR(240),
      season_code VARCHAR(24) NOT NULL,
      access_flag VARCHAR(1) NOT NULL,
      tide_stage VARCHAR(24) NOT NULL
    )

    Table nesting_platform
    (
      platform_code VARCHAR(24) NOT NULL,
      sector_code VARCHAR(24) NOT NULL,
      platform_label VARCHAR(120) NOT NULL,
      install_year INTEGER NOT NULL,
      mount_height_m DOUBLE NOT NULL
    )
  )

  Join plot_platform(wetland.reed_plot.sector_code = wetland.nesting_platform.sector_code)
)
