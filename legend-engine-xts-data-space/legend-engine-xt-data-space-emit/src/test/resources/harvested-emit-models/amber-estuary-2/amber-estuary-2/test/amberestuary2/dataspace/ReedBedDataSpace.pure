###DataSpace
DataSpace test::amberestuary2::dataspace::ReedBedDataSpace
{
  executionContexts:
  [
    {
      name: 'reserve';
      description: 'Reserve tier binding the wetland store to the reed bed mapping and the warehouse-backed runtime both published endpoints resolve under.';
      mapping: test::amberestuary2::mapping::ReedBedMapping;
      defaultRuntime: test::amberestuary2::runtime::ReedBedRuntime;
    }
  ];
  defaultExecutionContext: 'reserve';
  title: 'Amber Estuary Reed Bed Survey';
  description: 'Entry point over the reed bed reserve survey: reed plots keyed by plot code and survey date, the nesting platforms joined to them by sector, and the sector roll-up both published as tabular endpoints.';
  elements:
  [
    test::amberestuary2::domain
  ];
  executables:
  [
    {
      id: 1;
      title: 'Plots by reserve sector';
      description: 'The featured endpoint projecting the surveyed plots of one sector with their joined platform and banded water depth.';
      executable: test::amberestuary2::service::PlotsBySectorService;
    },
    {
      id: 2;
      title: 'Sector stem summary';
      description: 'The aggregate endpoint rolling the surveyed plots up per sector above a stem floor.';
      executable: test::amberestuary2::service::SectorSummaryService;
    }
  ];
  supportInfo: Email {
    address: 'reed-bed-warden@localhost';
  };
}
