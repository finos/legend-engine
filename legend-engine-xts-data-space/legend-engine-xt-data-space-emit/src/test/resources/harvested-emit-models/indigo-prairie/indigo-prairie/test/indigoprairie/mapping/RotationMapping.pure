###Mapping
Mapping demo::indigoprairie::mapping::RotationMapping
(
  *demo::indigoprairie::domain::HerdMove[moveSet]: Relational
  {
    ~primaryKey
    (
      [demo::indigoprairie::store::PaddockDB]rotation.herd_move.move_id
    )
    ~mainTable [demo::indigoprairie::store::PaddockDB]rotation.herd_move
    moveId: [demo::indigoprairie::store::PaddockDB]rotation.herd_move.move_id,
    moveCode: [demo::indigoprairie::store::PaddockDB]rotation.herd_move.move_code,
    herdSize: [demo::indigoprairie::store::PaddockDB]rotation.herd_move.herd_size,
    paddockName: [demo::indigoprairie::store::PaddockDB]@Move_Paddock | [demo::indigoprairie::store::PaddockDB]paddock.grazing_paddock.paddock_name
  }

  *demo::indigoprairie::domain::MoveNote[noteSet]: Relational
  {
    ~primaryKey
    (
      [demo::indigoprairie::store::PaddockDB]rotation.move_note.note_id
    )
    ~mainTable [demo::indigoprairie::store::PaddockDB]rotation.move_note
    noteId: [demo::indigoprairie::store::PaddockDB]rotation.move_note.note_id,
    noteText: [demo::indigoprairie::store::PaddockDB]rotation.move_note.note_text,
    recordedBy: [demo::indigoprairie::store::PaddockDB]rotation.move_note.recorded_by,
    paddockName: [demo::indigoprairie::store::PaddockDB]@Note_Move > @Move_Paddock | [demo::indigoprairie::store::PaddockDB]paddock.grazing_paddock.paddock_name
  }

  demo::indigoprairie::domain::Move_Notes: Relational
  {
    AssociationMapping
    (
      notes[moveSet, noteSet]: [demo::indigoprairie::store::PaddockDB]@Note_Move,
      noteMove[noteSet, moveSet]: [demo::indigoprairie::store::PaddockDB]@Note_Move
    )
  }

  testSuites:
  [
    rotationMoveSuite:
    {
      function: |demo::indigoprairie::domain::HerdMove.all()->project(
  [
    m|$m.moveCode,
    m|$m.herdSize,
    m|$m.paddockName,
    m|$m.notes.recordedBy
  ],
  [
    'MoveCode',
    'HerdSize',
    'PaddockName',
    'RecordedBy'
  ]
)->sort(
  [
    asc('MoveCode'),
    asc('RecordedBy')
  ]
);
      tests:
      [
        movesCarryNotesAndPaddock:
        {
          doc: 'Crosses from the rotation schema onto the paddock schema for the move main table and traverses the move-to-note association implementation in the rotation tier mapping.';
          data:
          [
            demo::indigoprairie::store::PaddockDB:
              Relational
              #{
                paddock.grazing_paddock:
                  'paddock_id,paddock_name,grass_association,acreage\n'+
                  'PD-01,North Swale,Big Bluestem,64.5\n'+
                  'PD-02,Cedar Draw,Little Bluestem,41.25\n';

                rotation.herd_move:
                  'move_id,move_code,herd_size,paddock_id\n'+
                  'HM-01,mv-spring-1,120,PD-01\n'+
                  'HM-02,mv-spring-2,88,PD-02\n';

                rotation.move_note:
                  'note_id,note_text,recorded_by,move_id\n'+
                  'MN-01,Sward height even,range rider,HM-01\n'+
                  'MN-02,Water point clear,herd steward,HM-02\n';
              }#
          ];
          asserts:
          [
            twoMovesWithNotes:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"MoveCode":"mv-spring-1","HerdSize":120,"PaddockName":"North Swale","RecordedBy":"range rider"},{"MoveCode":"mv-spring-2","HerdSize":88,"PaddockName":"Cedar Draw","RecordedBy":"herd steward"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
