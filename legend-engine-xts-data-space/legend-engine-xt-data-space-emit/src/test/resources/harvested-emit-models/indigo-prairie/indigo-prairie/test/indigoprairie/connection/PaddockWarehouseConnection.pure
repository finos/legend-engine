###Connection
RelationalDatabaseConnection demo::indigoprairie::connection::PaddockWarehouseConnection
{
  store: demo::indigoprairie::store::PaddockDB;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'PRAIRIE_GRAZING_DB';
    account: 'prairie_grazing_account';
    warehouse: 'PRAIRIE_GRAZING_WH';
    region: 'us-east-2';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'GRAZING_ROTATION_READER';
    privateKeyVaultReference: 'grazing.rotation.privateKey';
    passPhraseVaultReference: 'grazing.rotation.passPhrase';
  };
}
