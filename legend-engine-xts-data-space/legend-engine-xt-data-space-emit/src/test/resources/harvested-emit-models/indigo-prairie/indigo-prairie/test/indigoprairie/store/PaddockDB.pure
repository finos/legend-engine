###Relational
Database demo::indigoprairie::store::PaddockDB
(
  Schema paddock
  (
    Table grazing_paddock
    (
      paddock_id VARCHAR(24) PRIMARY KEY,
      paddock_name VARCHAR(120) NOT NULL,
      grass_association VARCHAR(60) NOT NULL,
      acreage DOUBLE NOT NULL
    )
    Table forage_sample
    (
      sample_id VARCHAR(24) PRIMARY KEY,
      sample_code VARCHAR(40) NOT NULL,
      dry_matter_pct DOUBLE NOT NULL,
      paddock_id VARCHAR(24) NOT NULL
    )
  )

  Schema rotation
  (
    Table herd_move
    (
      move_id VARCHAR(24) PRIMARY KEY,
      move_code VARCHAR(40) NOT NULL,
      herd_size INTEGER NOT NULL,
      paddock_id VARCHAR(24) NOT NULL
    )
    Table move_note
    (
      note_id VARCHAR(24) PRIMARY KEY,
      note_text VARCHAR(240) NOT NULL,
      recorded_by VARCHAR(60) NOT NULL,
      move_id VARCHAR(24) NOT NULL
    )
  )

  Join Sample_Paddock(paddock.forage_sample.paddock_id = paddock.grazing_paddock.paddock_id)
  Join Move_Paddock(rotation.herd_move.paddock_id = paddock.grazing_paddock.paddock_id)
  Join Note_Move(rotation.move_note.move_id = rotation.herd_move.move_id)
)
