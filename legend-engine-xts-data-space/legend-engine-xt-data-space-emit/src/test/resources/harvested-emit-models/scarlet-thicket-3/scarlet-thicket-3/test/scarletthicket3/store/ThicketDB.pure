###Relational
Database test::scarletthicket3::store::ThicketDB
(
  Schema nursery
  (
    Table seed_lot
    (
      lot_code VARCHAR(24) PRIMARY KEY,
      cultivar_code VARCHAR(24) NOT NULL,
      bed_code VARCHAR(24) NOT NULL,
      site_code VARCHAR(24) NOT NULL,
      treatment_code VARCHAR(24) NOT NULL,
      season_code VARCHAR(16) NOT NULL,
      grade_code VARCHAR(16) NOT NULL,
      status_code VARCHAR(16) NOT NULL,
      habitat_code VARCHAR(16) NOT NULL,
      storage_band_code VARCHAR(16) NOT NULL,
      quantity_grams FLOAT NOT NULL,
      viability_pct INTEGER NOT NULL,
      collected_on DATE NOT NULL
    )

    Table collection_site
    (
      site_code VARCHAR(24) PRIMARY KEY,
      site_name VARCHAR(120) NOT NULL,
      region_code VARCHAR(16) NOT NULL
    )

    Table seed_treatment
    (
      treatment_code VARCHAR(24) PRIMARY KEY,
      treatment_name VARCHAR(120) NOT NULL,
      treatment_kind VARCHAR(24) NOT NULL
    )

    Table nursery_bed
    (
      bed_code VARCHAR(24) PRIMARY KEY,
      bed_label VARCHAR(120) NOT NULL,
      block_code VARCHAR(24) NOT NULL,
      team_code VARCHAR(24) NOT NULL,
      capacity_units INTEGER NOT NULL
    )

    Table bed_block
    (
      block_code VARCHAR(24) PRIMARY KEY,
      block_label VARCHAR(120) NOT NULL,
      glasshouse_code VARCHAR(16) NOT NULL
    )

    Table cultivar
    (
      cultivar_code VARCHAR(24) PRIMARY KEY,
      cultivar_name VARCHAR(120) NOT NULL,
      family_code VARCHAR(24) NOT NULL,
      habit_code VARCHAR(16) NOT NULL,
      steward_team_code VARCHAR(24) NOT NULL,
      graft_flag VARCHAR(1) NOT NULL,
      rootstock_code VARCHAR(24)
    )

    Table cultivar_family
    (
      family_code VARCHAR(24) PRIMARY KEY,
      family_name VARCHAR(120) NOT NULL
    )

    Table grower_team
    (
      team_code VARCHAR(24) PRIMARY KEY,
      team_name VARCHAR(120) NOT NULL,
      depot_code VARCHAR(24) NOT NULL
    )

    Table team_depot
    (
      depot_code VARCHAR(24) PRIMARY KEY,
      depot_name VARCHAR(120) NOT NULL
    )
  )

  Schema reference_data
  (
    Table germination_check
    (
      check_code VARCHAR(24) PRIMARY KEY,
      lot_code VARCHAR(24) NOT NULL,
      checked_on DATE NOT NULL,
      sprout_count INTEGER NOT NULL
    )

    Table site_region
    (
      region_code VARCHAR(16) PRIMARY KEY,
      region_name VARCHAR(120) NOT NULL
    )

    Table storage_band
    (
      band_code VARCHAR(16) PRIMARY KEY,
      band_label VARCHAR(120) NOT NULL
    )
  )

  Filter GraftedCultivars(nursery.cultivar.graft_flag = 'Y')

  Join Bed_Block
  (
    nursery.nursery_bed.block_code = nursery.bed_block.block_code
  )

  Join Bed_Team
  (
    nursery.nursery_bed.team_code = nursery.grower_team.team_code
  )

  Join Cultivar_Family
  (
    nursery.cultivar.family_code = nursery.cultivar_family.family_code
  )

  Join Cultivar_Team
  (
    nursery.cultivar.steward_team_code = nursery.grower_team.team_code
  )

  Join Lot_Bed
  (
    nursery.seed_lot.bed_code = nursery.nursery_bed.bed_code
  )

  Join Lot_Cultivar
  (
    nursery.seed_lot.cultivar_code = nursery.cultivar.cultivar_code
  )

  Join Lot_Site
  (
    nursery.seed_lot.site_code = nursery.collection_site.site_code
  )

  Join Lot_Treatment
  (
    nursery.seed_lot.treatment_code = nursery.seed_treatment.treatment_code
  )

  Join Team_Depot
  (
    nursery.grower_team.depot_code = nursery.team_depot.depot_code
  )
)
