###Relational
Database test::quietarboretum2::store::AccessionDb
(
  Schema arbor
  (
    Table accession_record
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )

      accession_code VARCHAR(24) PRIMARY KEY,
      taxon_name VARCHAR(128) NOT NULL,
      bed_code VARCHAR(16) NOT NULL,
      curator_name VARCHAR(64) NOT NULL,
      specimen_count INTEGER NOT NULL,
      height_cm INTEGER,
      spread_cm INTEGER,
      propagation_count INTEGER NOT NULL,
      planted_on DATE NOT NULL,
      verified_on DATE,
      surveyed_at TIMESTAMP,
      updated_at TIMESTAMP,
      in_z DATE PRIMARY KEY,
      out_z DATE
    )
  )
)
