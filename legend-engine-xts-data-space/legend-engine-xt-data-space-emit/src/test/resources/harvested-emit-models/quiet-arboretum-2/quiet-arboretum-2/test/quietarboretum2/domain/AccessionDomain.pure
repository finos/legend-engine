###Pure
import test::quietarboretum2::domain::*;

Class <<meta::pure::profiles::temporal.processingtemporal, CollectionProfile.curated>> {CollectionProfile.steward = 'collection-registrar', CollectionProfile.reviewCycle = 'seasonal'} test::quietarboretum2::domain::AccessionRecord
{
  accessionCode: String[1];
  taxonName: String[1];
  bedCode: String[1];
  curatorName: String[1];
  specimenCount: Integer[1];
  heightCm: Integer[0..1];
  spreadCm: Integer[0..1];
  propagationCount: Integer[1];
  plantedOn: StrictDate[1];
  verifiedOn: StrictDate[0..1];
  surveyedAt: DateTime[0..1];
  updatedAt: DateTime[0..1];
  sourceRegister: String[1];
}

Class <<CollectionProfile.curated>> test::quietarboretum2::domain::BedPlan
{
  bedCode: String[1];
  bedName: String[1];
  soilClass: String[0..1];
  bedAreaSqm: Integer[1];
  companionBedCodes: String[*];
}

Class <<CollectionProfile.curated>> test::quietarboretum2::domain::TaxonProfile
{
  taxonName: String[1];
  commonName: String[0..1];
  familyName: String[1];
  hardinessBand: String[0..1];
  synonyms: String[*];
}

