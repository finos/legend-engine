}

Class test::quietarboretum2::domain::LabelPrint
{
  printCode: String[1];
  accessionCode: String[1];
  labelText: String[1];
  reprintCount: Integer[0..1];
}

Class {CollectionProfile.steward = 'collection-registrar'} test::quietarboretum2::domain::CuratorNote
{
