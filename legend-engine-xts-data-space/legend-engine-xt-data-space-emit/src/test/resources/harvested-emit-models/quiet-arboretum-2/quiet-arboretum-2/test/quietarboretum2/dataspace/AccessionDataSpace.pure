###DataSpace
DataSpace test::quietarboretum2::dataspace::AccessionDataSpace
{
  executionContexts:
  [
    {
      name: 'registerReview';
      description: 'Review tier - the processing-milestoned accession register served through the in-process execution connection.';
      mapping: test::quietarboretum2::mapping::AccessionMapping;
      defaultRuntime: test::quietarboretum2::runtime::AccessionH2Runtime;
    },
    {
      name: 'registerWarehouse';
      description: 'Warehouse tier - the same register bound onto the warehouse-dialect connection.';
      mapping: test::quietarboretum2::mapping::AccessionMapping;
      defaultRuntime: test::quietarboretum2::runtime::AccessionWarehouseRuntime;
    }
  ];
  defaultExecutionContext: 'registerReview';
  title: 'Quiet Arboretum Accession Register';
  description: 'Governed discovery surface over the accession register: the processing-milestoned collection records and the bed, taxon and propagation classes curated alongside them.';
  elements:
  [
    test::quietarboretum2::domain::AccessionRecord,
    test::quietarboretum2::domain::BedPlan,
    test::quietarboretum2::domain::TaxonProfile
  ];
}
