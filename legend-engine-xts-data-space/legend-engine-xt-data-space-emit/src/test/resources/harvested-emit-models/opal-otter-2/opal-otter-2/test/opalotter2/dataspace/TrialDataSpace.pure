###DataSpace
DataSpace test::opalotter2::dataspace::TrialDataSpace
{
  executionContexts:
  [
    {
      name: 'reach';
      description: 'Reach survey environment - the text-keyed scenario binding served through the seeded embedded database.';
      mapping: test::opalotter2::mapping::TrialTextMapping;
      defaultRuntime: test::opalotter2::runtime::TrialRuntime;
    }
  ];
  defaultExecutionContext: 'reach';
  title: 'Opal Otter Reach Trial Scenarios';
  description: 'Discovery surface over the reach trial scenario registry and the scenario collections it is grouped into.';
  elements:
  [
    test::opalotter2::domain::TrialScenario,
    test::opalotter2::domain::ScenarioCollection
  ];
}
