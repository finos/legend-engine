###Pure
Class test::opalotter2::domain::TrialScenario
{
  trialCode: String[1];
  trialName: String[1];
  habitatCode: String[1];
  surveyorCode: String[1];
  reachLabel: String[1];
  activeFlag: String[1];
  sampleCount: Integer[1];
  collectionCode: String[0..1];
  collectionName: String[0..1];
  baseScenarioRef: Integer[0..1];
  baseScenarioName: String[0..1];
  waterTempC: Float[0..1];
  flowRate: Float[0..1];
  turbidityNtu: Float[0..1];
  bankCoverPct: Float[0..1];
  spraintCount: Integer[0..1];
  noteText: String[0..1];
  seasonCode: String[0..1];
  weatherCode: String[0..1];
  verifiedCode: String[0..1];
}

Class test::opalotter2::domain::ScenarioCollection
{
  collectionCode: String[1];
  collectionName: String[1];
  scenarios: test::opalotter2::domain::TrialScenario[*];
}

Class test::opalotter2::domain::BaseScenario
{
  baseRef: Integer[1];
  baseName: String[1];
}

Association test::opalotter2::domain::Collection_Scenarios
{
  collection: test::opalotter2::domain::ScenarioCollection[1];
  scenarios: test::opalotter2::domain::TrialScenario[*];
}

Association test::opalotter2::domain::Scenario_BaseScenario
{
  baseScenario: test::opalotter2::domain::BaseScenario[1];
  scenario: test::opalotter2::domain::TrialScenario[1];
}
