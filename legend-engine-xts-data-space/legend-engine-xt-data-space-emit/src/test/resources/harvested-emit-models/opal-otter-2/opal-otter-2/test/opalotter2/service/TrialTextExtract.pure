###Service
Service test::opalotter2::service::TrialTextExtract
{
  pattern: '/otter/v1/trial-scenarios/text';
  title: 'Otter Reach Trial Scenario Extract';
  documentation: 'Wide extract over the text-keyed reach trial scenarios: every scenario is projected with its transformed name, surveyor and reach label alongside the collection label resolved across the inner join, ordered by trial identifier.';
  ownership: DID { identifier: '' };
  autoActivateUpdates: true;
  execution: Single
  {
    query: {|test::opalotter2::domain::TrialScenario.all()->project(
      [
        t|$t.trialCode,
        t|$t.trialName,
        t|$t.habitatCode,
        t|$t.surveyorCode,
        t|$t.reachLabel,
        t|$t.activeFlag,
        t|$t.sampleCount,
        t|$t.collectionCode,
        t|$t.collectionName,
        t|$t.seasonCode,
        t|$t.weatherCode,
        t|$t.verifiedCode
      ],
      [
        'Trial',
        'Name',
        'Habitat',
        'Surveyor',
        'Reach',
        'Active',
        'Samples',
        'Collection/Code',
        'Collection/Label',
        'Season',
        'Weather',
        'Verified'
      ]
    )->sort(
      [
        asc('Trial')
      ]
    );};
    mapping: test::opalotter2::mapping::TrialTextMapping;
    runtime: test::opalotter2::runtime::TrialRuntime;
  }
  testSuites:
  [
    trialTextExtractSuite:
    {
      data:
      [
        connections:
        [
          seedConnection:
            Relational
            #{
              reach.scenario_collection:
                'collection_code,collection_label\n'+
                'CO-01,Upper Reach Set\n'+
                'CO-02,Lower Reach Set\n';

              reach.trial_scenario:
                'trial_code,trial_name,habitat_code,surveyor_code,reach_label,active_flag,sample_count,collection_code,base_scenario_ref,base_scenario_name,water_temp_c,flow_rate,turbidity_ntu,bank_cover_pct,spraint_count,note_text,season_code,weather_code,verified_code\n'+
                'TR-01,riffle sweep,HB-01,SV-Alpha, Alder Riffle ,Y,12,CO-01,41,Riffle Baseline,9.5,0.8,3.5,62.0,4,first pass,spr,dry,Y\n'+
                'TR-02,pool sweep,HB-02,SV-Beta, Willow Pool ,Y,8,CO-02,42,Pool Baseline,11.0,0.4,6.0,48.0,2,second pass,sum,wet,N\n';
            }#
        ]
      ]
      tests:
      [
        wideTextExtract:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            bothSeededScenarios:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Trial":"TR-01","Name":"RIFFLE SWEEP","Habitat":"HB-01","Surveyor":"sv-alpha","Reach":"Alder Riffle","Active":"Y","Samples":12,"Collection/Code":"CO-01","Collection/Label":"Upper Reach Set","Season":"spr","Weather":"dry","Verified":"Y"},{"Trial":"TR-02","Name":"POOL SWEEP","Habitat":"HB-02","Surveyor":"sv-beta","Reach":"Willow Pool","Active":"Y","Samples":8,"Collection/Code":"CO-02","Collection/Label":"Lower Reach Set","Season":"sum","Weather":"wet","Verified":"N"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
