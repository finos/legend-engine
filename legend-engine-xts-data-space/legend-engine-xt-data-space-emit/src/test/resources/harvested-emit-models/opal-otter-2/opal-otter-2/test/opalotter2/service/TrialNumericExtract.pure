###Service
Service test::opalotter2::service::TrialNumericExtract
{
  pattern: '/otter/v1/trial-scenarios/numeric';
  title: 'Otter Reach Trial Scenario Narrow Extract';
  documentation: 'Narrow extract declared against the whole-number-keyed near copy of the same scenario binding while the paired runtime connects only the text-keyed store, so the executable compiles but no connection can serve its mapping at execution time.';
  ownership: DID { identifier: '' };
  autoActivateUpdates: true;
  execution: Single
  {
    query: {|test::opalotter2::domain::TrialScenario.all()->project(
      [
        t|$t.trialCode,
        t|$t.sampleCount,
        t|$t.baseScenarioRef,
        t|$t.baseScenarioName
      ],
      [
        'Trial',
        'Samples',
        'Base/Ref',
        'Base/Label'
      ]
    )->sort(
      [
        asc('Trial')
      ]
    );};
    mapping: test::opalotter2::mapping::TrialNumericMapping;
    runtime: test::opalotter2::runtime::TrialRuntime;
  }
}
