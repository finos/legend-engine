###DataSpace
DataSpace test::goldenarboretum4::dataspace::NurseryDataSpace
{
  executionContexts:
  [
    {
      name: 'curated';
      description: 'Curated tier - the propagation mapping paired with the warehouse runtime consumers resolve through by default.';
      mapping: test::goldenarboretum4::mapping::PropagationMapping;
      defaultRuntime: test::goldenarboretum4::runtime::NurseryRuntime;
    }
  ];
  defaultExecutionContext: 'curated';
  title: 'Nursery Propagation Register';
  description: 'A governed entry point over the propagation nursery register - batches, their translated habit, vigour, rooting and stock grade codes, and the beds they were struck in.';
  elements:
  [
    test::goldenarboretum4::domain
  ];
  supportInfo: Combined
  {
    emails: ['nursery-propagation-desk', 'nursery-collections-stewards'];
  };
}
