###Relational
Database test::goldenarboretum4::store::NurseryDatabase
(
  Schema NURSERY
  (
    Table PROPAGATION_RECORD
    (
      BATCH_CODE VARCHAR(20) PRIMARY KEY,
      BED_CODE VARCHAR(20) NOT NULL,
      BED_NAME VARCHAR(120) NOT NULL,
      TAXON_NAME VARCHAR(200) NOT NULL,
      FAMILY_NAME VARCHAR(120),
      HABIT_CODE VARCHAR(20) NOT NULL,
      VIGOUR_CODE VARCHAR(20) NOT NULL,
      ROOTING_CODE VARCHAR(20) NOT NULL,
      GRADE_CODE VARCHAR(20) NOT NULL,
      SHADE_CODE VARCHAR(20) NOT NULL,
      SEASON_CODE VARCHAR(20) NOT NULL,
      SOIL_CODE VARCHAR(20) NOT NULL,
      CUTTINGS_STRUCK DOUBLE,
      BED_AREA_SQM DOUBLE,
      SOWN_ON DATE,
      LOGGED_AT TIMESTAMP,
      PROPAGATOR_NOTE VARCHAR(400)
    )
  )
)
