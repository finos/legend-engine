###Connection
RelationalDatabaseConnection test::goldenarboretum4::connection::NurseryConnection
{
  store: test::goldenarboretum4::store::NurseryDatabase;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'NURSERY_PROPAGATION_DB';
    account: 'nursery_propagation_account';
    warehouse: 'NURSERY_PROPAGATION_WH';
    region: 'eu-west-1';
  };
  auth: OAuth
  {
    oauthKey: 'nursery_propagation_oauth';
    scopeName: 'SESSION:ROLE:NURSERY_PROPAGATION_READER';
  };
}
