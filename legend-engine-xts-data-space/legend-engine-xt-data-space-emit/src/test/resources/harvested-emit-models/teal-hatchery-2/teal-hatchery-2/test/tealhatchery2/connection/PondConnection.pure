###Connection
RelationalDatabaseConnection test::tealhatchery2::connection::PondConnection
{
  store: test::tealhatchery2::store::PondRegisterDb;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'EXAMPLE_POND_REGISTER_DB';
    account: 'example_pond_register_account';
    warehouse: 'EXAMPLE_POND_REGISTER_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    role: 'EXAMPLE_POND_REGISTER_ROLE';
  };
  auth: OAuth
  {
    scopeName: 'session:role:EXAMPLE_POND_REGISTER_ROLE';
    oauthKey: 'examplePondRegisterOauthKey';
  };
}
