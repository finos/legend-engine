###DataSpace
DataSpace test::tealhatchery2::dataspace::PondDataSpace
{
  executionContexts:
  [
    {
      name: 'rearing';
      description: 'Rearing environment - the pond register bound to the warehouse runtime the services are planned against.';
      mapping: test::tealhatchery2::mapping::PondRegisterMapping;
      defaultRuntime: test::tealhatchery2::runtime::PondRuntime;
    }
  ];
  defaultExecutionContext: 'rearing';
  title: 'Teal Hatchery 2 Pond Register';
  description: 'Discovery surface over the wetland rearing ponds: the ponds themselves, the standing and archived larva batches unioned behind them and the water readings taken on each pond.';
  elements:
  [
    test::tealhatchery2::domain::RearingPond,
    test::tealhatchery2::domain::LarvaBatch,
    test::tealhatchery2::domain::WaterReading
  ];
  supportInfo: Email
  {
    address: 'pond-rearing-desk@pondrearing.invalid';
  };
}
