###Relational
Database test::coralwarren6::store::CompostCoreDb
(
  Schema SITE
  (
    Table COMPOST_SITE
    (
      SITE_CODE VARCHAR(20) PRIMARY KEY,
      SITE_NAME VARCHAR(80) NOT NULL,
      WARD_CODE VARCHAR(20) NOT NULL
    )
  )
)

Database test::coralwarren6::store::CompostYardDb
(
  include test::coralwarren6::store::CompostCoreDb

  Schema YARD
  (
    Table WINDROW
    (
      milestoning
      (
        business(BUS_FROM = FROM_Z, BUS_THRU = THRU_Z)
      )
      WINDROW_CODE VARCHAR(20) PRIMARY KEY,
      SITE_CODE VARCHAR(20) NOT NULL,
      WARD_CODE VARCHAR(20) NOT NULL,
      FEEDSTOCK_GRADE VARCHAR(20) NOT NULL,
      AERATION_MODE VARCHAR(20) NOT NULL,
      MOISTURE_PCT INTEGER NOT NULL,
      TURN_COUNT INTEGER NOT NULL,
      TONNAGE INTEGER NOT NULL,
      WINDROW_STATE VARCHAR(20) NOT NULL,
      FROM_Z DATE PRIMARY KEY,
      THRU_Z DATE NOT NULL
    )
  )

  Schema PROBE
  (
    Table TEMPERATURE_PROBE
    (
      milestoning
      (
        business(BUS_FROM = FROM_Z, BUS_THRU = THRU_Z)
      )
      PROBE_CODE VARCHAR(20) PRIMARY KEY,
      WINDROW_CODE VARCHAR(20) NOT NULL,
      PROBE_GRADE VARCHAR(20) NOT NULL,
      FROM_Z DATE PRIMARY KEY,
      THRU_Z DATE NOT NULL
    )
  )

  Join Windrow_Site(YARD.WINDROW.SITE_CODE = SITE.COMPOST_SITE.SITE_CODE)

  Join Windrow_Probe(YARD.WINDROW.WINDROW_CODE = PROBE.TEMPERATURE_PROBE.WINDROW_CODE)
)
