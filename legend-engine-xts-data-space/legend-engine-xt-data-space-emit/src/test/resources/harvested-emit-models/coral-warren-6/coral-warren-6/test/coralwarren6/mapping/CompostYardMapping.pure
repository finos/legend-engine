###Mapping
Mapping test::coralwarren6::mapping::CompostYardMapping
(
  include test::coralwarren6::mapping::CompostSiteMapping

  *test::coralwarren6::domain::Windrow[windrow]: Relational
  {
    ~primaryKey
    (
      [test::coralwarren6::store::CompostYardDb]YARD.WINDROW.WINDROW_CODE
    )
    ~mainTable [test::coralwarren6::store::CompostYardDb]YARD.WINDROW
    windrowCode: [test::coralwarren6::store::CompostYardDb]YARD.WINDROW.WINDROW_CODE,
    siteCode: [test::coralwarren6::store::CompostYardDb]YARD.WINDROW.SITE_CODE,
    wardCode: [test::coralwarren6::store::CompostYardDb]YARD.WINDROW.WARD_CODE,
    feedstockGrade: [test::coralwarren6::store::CompostYardDb]YARD.WINDROW.FEEDSTOCK_GRADE,
    aerationMode: [test::coralwarren6::store::CompostYardDb]YARD.WINDROW.AERATION_MODE,
    moisturePct: [test::coralwarren6::store::CompostYardDb]YARD.WINDROW.MOISTURE_PCT,
    turnCount: [test::coralwarren6::store::CompostYardDb]YARD.WINDROW.TURN_COUNT,
    tonnage: [test::coralwarren6::store::CompostYardDb]YARD.WINDROW.TONNAGE,
    windrowState: [test::coralwarren6::store::CompostYardDb]YARD.WINDROW.WINDROW_STATE
  }

  *test::coralwarren6::domain::TemperatureProbe[probe]: Relational
  {
    ~primaryKey
    (
      [test::coralwarren6::store::CompostYardDb]PROBE.TEMPERATURE_PROBE.PROBE_CODE
    )
    ~mainTable [test::coralwarren6::store::CompostYardDb]PROBE.TEMPERATURE_PROBE
    probeCode: [test::coralwarren6::store::CompostYardDb]PROBE.TEMPERATURE_PROBE.PROBE_CODE,
    windrowCode: [test::coralwarren6::store::CompostYardDb]PROBE.TEMPERATURE_PROBE.WINDROW_CODE,
    probeGrade: [test::coralwarren6::store::CompostYardDb]PROBE.TEMPERATURE_PROBE.PROBE_GRADE
  }

  test::coralwarren6::domain::Windrow_Site: Relational
  {
    AssociationMapping
    (
      compostSite[windrow, site]: [test::coralwarren6::store::CompostYardDb]@Windrow_Site,
      windrows[site, windrow]: [test::coralwarren6::store::CompostYardDb]@Windrow_Site
    )
  }

  test::coralwarren6::domain::Windrow_Probe: Relational
  {
    AssociationMapping
    (
      probes[windrow, probe]: [test::coralwarren6::store::CompostYardDb]@Windrow_Probe,
      windrow[probe, windrow]: [test::coralwarren6::store::CompostYardDb]@Windrow_Probe
    )
  }
)
