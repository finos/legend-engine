###Connection
RelationalDatabaseConnection test::coralwarren6::connection::CompostYardConnection
{
  store: test::coralwarren6::store::CompostYardDb;
  type: MemSQL;
  specification: Static
  {
    name: 'compost_yard_register';
    host: 'example-compost-yard-host';
    port: 3306;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'compostyardregisterprincipal';
  };
  postProcessors:
  [
    mapper
    {
      mappers:
      [
        schema {from: 'YARD'; to: 'YARD_PUBLISHED';},
        schema {from: 'PROBE'; to: 'PROBE_PUBLISHED';},
        table {from: 'WINDROW'; to: 'windrow_current'; schemaFrom: 'YARD'; schemaTo: 'YARD_PUBLISHED';},
        table {from: 'TEMPERATURE_PROBE'; to: 'temperature_probe_current'; schemaFrom: 'PROBE'; schemaTo: 'PROBE_PUBLISHED';}
      ];
    }
  ];
}
