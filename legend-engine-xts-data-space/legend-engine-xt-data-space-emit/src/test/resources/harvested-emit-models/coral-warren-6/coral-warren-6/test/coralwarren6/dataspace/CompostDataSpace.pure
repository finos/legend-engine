###DataSpace
DataSpace test::coralwarren6::dataspace::CompostYardDataSpace
{
  executionContexts:
  [
    {
      name: 'yard';
      description: 'Yard environment - the windrow binding served through the composting yard register.';
      mapping: test::coralwarren6::mapping::CompostYardMapping;
      defaultRuntime: test::coralwarren6::runtime::CompostYardRuntime;
    }
  ];
  defaultExecutionContext: 'yard';
  title: 'Coral Warren 6 Composting Yard Register';
  description: 'Discovery surface over the municipal composting yard: the sites that operate the windrows, the windrows restated over business time and the temperature probes graded by reading depth.';
  elements:
  [
    test::coralwarren6::domain::CompostSite,
    test::coralwarren6::domain::TemperatureProbe,
    test::coralwarren6::domain::Windrow
  ];
  executables:
  [
    {
      id: 1;
      title: 'Windrow Tonnage Tally';
      description: 'The keyed tonnage tally over the actively turned, core-probed windrows standing at a business date.';
      executable: test::coralwarren6::service::WindrowTonnageTally;
    }
  ];
  supportInfo: Email
  {
    address: 'compost-yard-desk@compostyard.invalid';
  };
}
