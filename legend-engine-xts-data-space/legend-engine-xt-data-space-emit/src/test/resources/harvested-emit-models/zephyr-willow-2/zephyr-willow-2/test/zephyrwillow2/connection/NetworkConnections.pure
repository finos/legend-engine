###Connection
RelationalDatabaseConnection test::zephyrwillow2::connection::NetworkLakeConnection
{
  store: test::zephyrwillow2::store::DepotNetworkDB;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'NETWORK_LAKE_DB';
    account: 'network_lake_account';
    warehouse: 'NETWORK_LAKE_WH';
    region: 'eu-west-2';
    cloudType: 'aws';
    role: 'NETWORK_LAKE_ROLE';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'NETWORK_LAKE_USER';
    privateKeyVaultReference: 'network-lake-private-key';
    passPhraseVaultReference: 'network-lake-passphrase';
  };
}

