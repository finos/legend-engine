  [
    test::zephyrwillow2::mapping::NetworkMapping
  ];
  connections:
  [
    test::zephyrwillow2::store::DepotNetworkDB:
    [
      networkConnection: test::zephyrwillow2::connection::NetworkLakeConnection
    ]
  ];
}

