###Service
Service test::zephyrwillow2::service::RoundRegister
{
  pattern: '/zephyrwillow2/v1/round-register';
  title: 'Metro Waste - collection rounds inside a quarter';
  ownership: DID { identifier: 'metro-waste-register' };
  documentation: 'Lists the live collection rounds of the requested material grades above a weight floor whose collection date falls inside the ninety-day window opening on the supplied date, reporting the depot reached through the container reference path and the handling instruction decided inside the mapping.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {grades: String[*], minKg: Float[1], fromOn: StrictDate[1]|test::zephyrwillow2::domain::CollectionRound.all()->filter(
      r|($r.gradeCode->in($grades)) && (($r.grossKg >= $minKg) && (($r.collectedOn >= $fromOn) && ($r.collectedOn < $fromOn->adjust(90, meta::pure::functions::date::DurationUnit.DAYS))))
    )->project(
      [
        r|$r.roundId,
        r|$r.gradeCode,
        r|$r.grossKg,
        r|$r.depotSiteName,
        r|$r.handlingNote
      ],
      [
        'Round',
        'Grade',
        'GrossKg',
        'Site',
        'Handling'
      ]
    )->sort([asc('Round')])};
    mapping: test::zephyrwillow2::mapping::NetworkMapping;
    runtime: test::zephyrwillow2::runtime::NetworkLakeRuntime;
  }
  testSuites:
  [
    roundRegisterSuite:
    {
      data:
      [
        connections:
        [
          networkConnection:
            Reference
            #{
              test::zephyrwillow2::data::NetworkTestData
            }#
        ]
      ]
      tests:
      [
        recyclableRoundsOfTheSpringQuarter:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            grades = ['PA', 'GL'],
            minKg = 100.0,
            fromOn = %2026-03-01
          ]
          asserts:
          [
            fiveRoundsInsideTheWindow:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Round":"R-01","Grade":"PA","GrossKg":940.5,"Site":"Northgate Depot","Handling":"BULK TRANSFER"},{"Round":"R-02","Grade":"GL","GrossKg":640.25,"Site":"Northgate Depot","Handling":"DOUBLE LIFT"},{"Round":"R-03","Grade":"PA","GrossKg":420.5,"Site":"Northgate Depot","Handling":"SINGLE LIFT"},{"Round":"R-04","Grade":"PA","GrossKg":180.5,"Site":"Northgate Depot","Handling":"DRY BEFORE BALING"},{"Round":"R-05","Grade":"GL","GrossKg":120.25,"Site":"Northgate Depot","Handling":"STANDARD BALING"}]';
                  }#;
              }#
          ]
        },
        residualGradeInsideTheSameWindow:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            grades = ['MX'],
            minKg = 10.0,
            fromOn = %2026-03-01
          ]
          asserts:
          [
            oneResidualRound:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Round":"R-07","Grade":"MX","GrossKg":80.5,"Site":"Eastfield Depot","Handling":"MIXED LANE"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

###Service
Service test::zephyrwillow2::service::RoundDigest
{
  pattern: '/zephyrwillow2/v1/round-digest';
  title: 'Metro Waste - grade and lane digest';
  ownership: DID { identifier: 'metro-waste-register' };
  documentation: 'Folds the repeated grade and sorting-lane pairs of the live rounds together so each pair appears once, then keeps the leading five for the depot noticeboard.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {|test::zephyrwillow2::domain::CollectionRound.all()->project(
      [
        r|$r.gradeCode,
        r|$r.handling.lane
      ],
      [
        'Grade',
        'Lane'
      ]
    )->distinct()->sort([asc('Grade')])->limit(5)};
    mapping: test::zephyrwillow2::mapping::NetworkMapping;
    runtime: test::zephyrwillow2::runtime::NetworkLakeRuntime;
  }
  testSuites:
  [
    roundDigestSuite:
    {
      data:
      [
        connections:
        [
          networkConnection:
            Reference
            #{
              test::zephyrwillow2::data::NetworkTestData
            }#
        ]
      ]
      tests:
      [
        distinctGradeAndLanePairs:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            threeSortingLanes:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Grade":"GL","Lane":"LANE-B"},{"Grade":"MX","Lane":"LANE-C"},{"Grade":"PA","Lane":"LANE-A"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

###Service
Service test::zephyrwillow2::service::AuthorityRoster
{
  pattern: '/zephyrwillow2/v1/authority-roster';
  title: 'Metro Waste - depot, ward and authority roster';
  ownership: DID { identifier: 'metro-waste-register' };
  documentation: 'Publishes the duplicate-free roster of depot, ward and collection authority behind the live rounds, so the association path and the five-hop reference path onto the authority are resolved in the same statement.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {|test::zephyrwillow2::domain::CollectionRound.all()->project(
      [
        r|$r.depotSiteName,
        r|$r.container.site.ward.wardName,
        r|$r.authorityName
      ],
      [
        'Site',
        'Ward',
        'Authority'
      ]
    )->distinct()->sort([asc('Site')])};
    mapping: test::zephyrwillow2::mapping::NetworkMapping;
    runtime: test::zephyrwillow2::runtime::NetworkLakeRuntime;
  }
  testSuites:
  [
    authorityRosterSuite:
    {
      data:
      [
        connections:
        [
          networkConnection:
            Reference
            #{
              test::zephyrwillow2::data::NetworkTestData
            }#
        ]
      ]
      tests:
      [
        threeDepotsUnderOneAuthority:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            rosterOfThreeDepots:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Site":"Eastfield Depot","Ward":"Riverside Ward","Authority":"Metro Waste Authority"},{"Site":"Northgate Depot","Ward":"Riverside Ward","Authority":"Metro Waste Authority"},{"Site":"Southbank Depot","Ward":"Hillcrest Ward","Authority":"Metro Waste Authority"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
