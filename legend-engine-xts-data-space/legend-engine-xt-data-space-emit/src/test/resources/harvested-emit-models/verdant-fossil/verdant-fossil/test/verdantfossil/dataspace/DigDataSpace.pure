###DataSpace
DataSpace test::verdantfossil::dataspace::DigDataSpace
{
  executionContexts:
  [
    {
      name: 'register';
      description: 'Register tier - the warehouse the dig register queries run against.';
      mapping: test::verdantfossil::mapping::DigMapping;
      defaultRuntime: test::verdantfossil::runtime::DigRuntime;
    }
  ];
  defaultExecutionContext: 'register';
  title: 'Quarry Dig Register';
  description: 'A curated entry point over the quarry excavation register - sites, trenches, strata, recovered finds, crates and field seasons - wiring the relational mapping, its runtime and the featured endpoints a consumer should start from.';
  elements:
  [
    test::verdantfossil::domain::DigSite,
    test::verdantfossil::domain::Trench,
    test::verdantfossil::domain::Find,
    test::verdantfossil::domain::Stratum
  ];
  executables:
  [
    {
      id: 1;
      title: 'Find label board';
      description: 'Featured endpoint projecting find labels with their trench and site.';
      executable: test::verdantfossil::service::FindLabelBoard;
    },
    {
      id: 2;
      title: 'Site trench board';
      description: 'Featured endpoint walking the site-to-trench association.';
      executable: test::verdantfossil::service::SiteTrenchBoard;
    }
  ];
  supportInfo: Email
  {
    address: 'dig-register-support@quarryregister.invalid';
  };
}
