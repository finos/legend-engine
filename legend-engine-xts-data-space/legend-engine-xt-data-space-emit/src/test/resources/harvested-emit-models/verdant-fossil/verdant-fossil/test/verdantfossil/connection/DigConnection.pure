###Connection
RelationalDatabaseConnection test::verdantfossil::connection::DigConnection
{
  store: test::verdantfossil::store::DigDb;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'EXAMPLE_DIG_REGISTER_DB';
    account: 'example_dig_account';
    warehouse: 'EXAMPLE_DIG_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    role: 'EXAMPLE_DIG_ROLE';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'example_dig_reader';
    privateKeyVaultReference: 'example-dig-private-key';
    passPhraseVaultReference: 'example-dig-pass-phrase';
  };
}
