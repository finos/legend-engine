  testSuites:
  [
    soilSampleSuite:
    {
      function: |test::solarprairie2::domain::SoilSample.all()->project(
        [
          s|$s.soilCode,
          s|$s.soilLabel->toUpper(),
          s|$s.recordedOn,
          s|$s.phReading,
          s|$s.coreDepthCm,
          s|$s.siteName,
          s|$s.districtCode
        ],
        [
          'Sample',
          'Label',
          'Recorded',
          'Ph',
          'DepthCm',
          'Site',
          'District'
        ]
      )->sort(
        [
          asc('Sample')
        ]
      );
      tests:
      [
        samplesResolveTheirSiteAcrossTheDeclaredJoin:
        {
          doc: 'Projects the soil cores through their own main table alias and resolves the site name and district of each core across the declared join, including a core whose survey date is absent.';
          data:
          [
            test::solarprairie2::store::PrairieFieldDB:
              Relational
              #{
                prairie.prairie_site:
                  'site_code,site_name,district_code,hectares,established_year\n'+
                  'PS-01,North Ridge Prairie,DIS-NORTH,42.5,2015\n'+
                  'PS-02,South Draw Prairie,DIS-SOUTH,18.25,2019\n';
                prairie.soil_sample:
                  'soil_code,site_code,soil_label,recorded_on,ph_reading,core_depth_cm\n'+
                  'SS-01,PS-01,Ridge Core One,2026-04-08,6.4,30\n'+
                  'SS-02,PS-01,Ridge Core Two,,6.9,45\n'+
                  'SS-03,PS-02,Draw Core One,2026-05-20,7.2,25\n';
              }#
          ];
          asserts:
          [
            threeCoresResolved:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Sample":"SS-01","Label":"RIDGE CORE ONE","Recorded":"2026-04-08","Ph":6.4,"DepthCm":30,"Site":"North Ridge Prairie","District":"DIS-NORTH"},{"Sample":"SS-02","Label":"RIDGE CORE TWO","Recorded":null,"Ph":6.9,"DepthCm":45,"Site":"North Ridge Prairie","District":"DIS-NORTH"},{"Sample":"SS-03","Label":"DRAW CORE ONE","Recorded":"2026-05-20","Ph":7.2,"DepthCm":25,"Site":"South Draw Prairie","District":"DIS-SOUTH"}]';
                  }#;
              }#
          ];
        }
      ];
    },
    prairieSiteSuite:
    {
      function: |test::solarprairie2::domain::PrairieSite.all()->filter(
        p|$p.hectares >= 20.0
      )->project(
        [
          p|$p.siteCode,
          p|$p.siteName->toUpper(),
          p|$p.districtCode,
          p|$p.hectares,
          p|$p.establishedYear
        ],
        [
          'Site',
          'Name',
          'District',
          'Hectares',
          'Established'
        ]
      )->sort(
        [
          asc('Site')
        ]
      );
      tests:
      [
        onlySitesAboveTheAreaFloorAreProjected:
        {
          doc: 'Projects the site main table on its own, keeping only the sites whose managed area clears the reporting floor so the smaller site is suppressed.';
          data:
          [
            test::solarprairie2::store::PrairieFieldDB:
              Relational
              #{
                prairie.prairie_site:
                  'site_code,site_name,district_code,hectares,established_year\n'+
                  'PS-01,North Ridge Prairie,DIS-NORTH,42.5,2015\n'+
                  'PS-02,South Draw Prairie,DIS-SOUTH,18.25,2019\n';
              }#
          ];
          asserts:
          [
            onlyTheLargerSiteRetained:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Site":"PS-01","Name":"NORTH RIDGE PRAIRIE","District":"DIS-NORTH","Hectares":42.5,"Established":2015}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
