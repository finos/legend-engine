Association {meta::pure::profiles::doc.doc = 'Links the rain gauges of a site to the invasive patches mapped on the same site, so rainfall and spread are read together.'} test::solarprairie2::domain::RainfallWeedWatch
{
  watchedGauges: RainGauge[*];
  watchedPatches: WeedPatch[*];
}
