###DataSpace
DataSpace test::solarprairie2::dataspace::PrairieStationDataSpace
{
  executionContexts:
  [
    {
      name: 'field';
      description: 'Field tier binding the prairie warehouse store to the restoration mapping and the field-warehouse runtime the survey endpoints resolve under.';
      mapping: test::solarprairie2::mapping::PrairieMapping;
      defaultRuntime: test::solarprairie2::runtime::PrairieFieldRuntime;
    },
    {
      name: 'audit';
      description: 'Audit tier binding the same store and mapping to the audit-warehouse runtime the visitor access endpoint resolves under.';
      mapping: test::solarprairie2::mapping::PrairieMapping;
      defaultRuntime: test::solarprairie2::runtime::PrairieAuditRuntime;
    }
  ];
  defaultExecutionContext: 'field';
  title: 'Solar Prairie Restoration Station';
  description: 'Entry point over the prairie restoration station: the managed sites at the centre of the model and the survey, husbandry, infrastructure and visitor-access records that each resolve back to their site through a declared join and a declared association.';
  elements:
  [
    test::solarprairie2::domain
  ];
  executables:
  [
    {
      id: 1;
      title: 'Soil samples by district';
      description: 'The featured endpoint projecting the soil cores of one management district above the acidity floor.';
      executable: test::solarprairie2::service::SoilSamplesByDistrictService;
    },
    {
      id: 2;
      title: 'Pollinator visits';
      description: 'The endpoint projecting the timed pollinator walks above the visit floor.';
      executable: test::solarprairie2::service::PollinatorVisitsService;
    },
    {
      id: 3;
      title: 'Trail sections';
      description: 'The visitor access endpoint projecting every trail section with its marker tally.';
      executable: test::solarprairie2::service::TrailSectionsService;
    }
  ];
  supportInfo: Email {
    address: 'prairie-station-support@localhost';
  };
}
