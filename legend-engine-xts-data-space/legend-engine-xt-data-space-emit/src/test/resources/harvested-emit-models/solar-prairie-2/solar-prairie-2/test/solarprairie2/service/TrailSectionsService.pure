###Service
Service test::solarprairie2::service::TrailSectionsService
{
  pattern: '/prairie/v1/trail-sections';
  title: 'Trail Sections';
  owners:
  [
    'prairie-visitor-access-team'
  ];
  documentation: 'Publishes every section of visitor trail crossing the restoration sites, projecting the section with its marker tally and the site name resolved across the site join, and resolving against the audit warehouse rather than the field warehouse.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: {|test::solarprairie2::domain::TrailSection.all()->project(
      [
        t|$t.trailCode,
        t|$t.trailLabel->toUpper(),
        t|$t.sectionLengthKm,
        t|$t.markerCount,
        t|$t.siteName
      ],
      [
        'Section',
        'Label',
        'Km',
        'Markers',
        'Site'
      ]
    )->sort(
      [
        asc('Section')
      ]
    )};
    mapping: test::solarprairie2::mapping::PrairieMapping;
    runtime: test::solarprairie2::runtime::PrairieAuditRuntime;
  }
  testSuites:
  [
    trailSectionSuite:
    {
      data:
      [
        connections:
        [
          connection_1:
            Relational
            #{
              prairie.prairie_site:
                'site_code,site_name,district_code,hectares,established_year\n'+
                'PS-01,North Ridge Prairie,DIS-NORTH,42.5,2015\n'+
                'PS-02,South Draw Prairie,DIS-SOUTH,18.25,2019\n';
              prairie.trail_section:
                'trail_code,site_code,trail_label,recorded_on,section_length_km,marker_count\n'+
                'TR-01,PS-01,Ridge Loop,2026-03-14,2.4,6\n'+
                'TR-02,PS-02,Draw Spur,2026-03-15,1.1,3\n';
            }#
        ]
      ]
      tests:
      [
        everySectionResolvesItsSite:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            bothSectionsPublished:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Section":"TR-01","Label":"RIDGE LOOP","Km":2.4,"Markers":6,"Site":"North Ridge Prairie"},{"Section":"TR-02","Label":"DRAW SPUR","Km":1.1,"Markers":3,"Site":"South Draw Prairie"}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
