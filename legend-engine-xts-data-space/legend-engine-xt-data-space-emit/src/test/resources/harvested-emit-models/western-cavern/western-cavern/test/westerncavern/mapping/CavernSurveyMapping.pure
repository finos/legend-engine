###Mapping
Mapping test::westerncavern::mapping::CavernSurveyMapping
(
  test::westerncavern::domain::CaveSystem[cave_system_set]: Relational
  {
    ~primaryKey
    (
      [test::westerncavern::store::CavernSurveyDatabase]speleo.cave_system.system_code,
      [test::westerncavern::store::CavernSurveyDatabase]speleo.cave_system.batch_id
    )
    ~mainTable [test::westerncavern::store::CavernSurveyDatabase]speleo.cave_system
    systemCode: [test::westerncavern::store::CavernSurveyDatabase]speleo.cave_system.system_code,
    batchId: [test::westerncavern::store::CavernSurveyDatabase]speleo.cave_system.batch_id,
    systemName: [test::westerncavern::store::CavernSurveyDatabase]speleo.cave_system.system_name,
    regionName: [test::westerncavern::store::CavernSurveyDatabase]speleo.cave_system.region_name,
    discoveredOn: [test::westerncavern::store::CavernSurveyDatabase]speleo.cave_system.discovered_on,
    mappedLengthMetres: [test::westerncavern::store::CavernSurveyDatabase]speleo.cave_system.mapped_length_metres,
    systemNote: [test::westerncavern::store::CavernSurveyDatabase]speleo.cave_system.system_note,
    registerName: 'Western Cavern Survey Register'
  }

  test::westerncavern::domain::Passage[passage_set]: Relational
  {
    ~primaryKey
    (
      [test::westerncavern::store::CavernSurveyDatabase]speleo.passage.passage_code,
      [test::westerncavern::store::CavernSurveyDatabase]speleo.passage.batch_id
    )
    ~mainTable [test::westerncavern::store::CavernSurveyDatabase]speleo.passage
    passageCode: [test::westerncavern::store::CavernSurveyDatabase]speleo.passage.passage_code,
    batchId: [test::westerncavern::store::CavernSurveyDatabase]speleo.passage.batch_id,
    systemCode: [test::westerncavern::store::CavernSurveyDatabase]speleo.passage.system_code,
    passageName: [test::westerncavern::store::CavernSurveyDatabase]speleo.passage.passage_name,
    passageLengthMetres: [test::westerncavern::store::CavernSurveyDatabase]speleo.passage.passage_length_metres,
    passageWidthMetres: [test::westerncavern::store::CavernSurveyDatabase]speleo.passage.passage_width_metres,
    hazardNote: [test::westerncavern::store::CavernSurveyDatabase]speleo.passage.hazard_note
  }

  test::westerncavern::domain::SurveyRun[survey_run_set]: Relational
  {
    ~primaryKey
    (
      [test::westerncavern::store::CavernSurveyDatabase]speleo.survey_run.run_code,
      [test::westerncavern::store::CavernSurveyDatabase]speleo.survey_run.batch_id
    )
    ~mainTable [test::westerncavern::store::CavernSurveyDatabase]speleo.survey_run
    runCode: [test::westerncavern::store::CavernSurveyDatabase]speleo.survey_run.run_code,
    batchId: [test::westerncavern::store::CavernSurveyDatabase]speleo.survey_run.batch_id,
    systemCode: [test::westerncavern::store::CavernSurveyDatabase]speleo.survey_run.system_code,
    runName: [test::westerncavern::store::CavernSurveyDatabase]speleo.survey_run.run_name,
    runDate: [test::westerncavern::store::CavernSurveyDatabase]speleo.survey_run.run_date,
    leadSurveyor: [test::westerncavern::store::CavernSurveyDatabase]speleo.survey_run.lead_surveyor,
    instrumentNote: [test::westerncavern::store::CavernSurveyDatabase]speleo.survey_run.instrument_note
  }

  test::westerncavern::domain::SurveyLeg[survey_leg_set]: Relational
  {
    ~primaryKey
    (
      [test::westerncavern::store::CavernSurveyDatabase]speleo.survey_leg.leg_code,
      [test::westerncavern::store::CavernSurveyDatabase]speleo.survey_leg.batch_id
    )
    ~mainTable [test::westerncavern::store::CavernSurveyDatabase]speleo.survey_leg
    legCode: [test::westerncavern::store::CavernSurveyDatabase]speleo.survey_leg.leg_code,
    batchId: [test::westerncavern::store::CavernSurveyDatabase]speleo.survey_leg.batch_id,
    runCode: [test::westerncavern::store::CavernSurveyDatabase]speleo.survey_leg.run_code,
    passageCode: [test::westerncavern::store::CavernSurveyDatabase]speleo.survey_leg.passage_code,
    legLengthMetres: [test::westerncavern::store::CavernSurveyDatabase]speleo.survey_leg.leg_length_metres,
    depthChangeMetres: [test::westerncavern::store::CavernSurveyDatabase]speleo.survey_leg.depth_change_metres,
    gradeLabel: case(isNull([test::westerncavern::store::CavernSurveyDatabase]speleo.survey_leg.grade_code), sqlNull(),
      case(equal([test::westerncavern::store::CavernSurveyDatabase]speleo.survey_leg.grade_code, 1), 'SKETCH_ONLY',
      case(equal([test::westerncavern::store::CavernSurveyDatabase]speleo.survey_leg.grade_code, 2), 'ROUGH_TAPE',
      case(equal([test::westerncavern::store::CavernSurveyDatabase]speleo.survey_leg.grade_code, 3), 'COMPASS_TAPE',
      case(equal([test::westerncavern::store::CavernSurveyDatabase]speleo.survey_leg.grade_code, 4), 'CALIBRATED_TAPE',
      case(equal([test::westerncavern::store::CavernSurveyDatabase]speleo.survey_leg.grade_code, 5), 'PRECISE_COMPASS',
      case(equal([test::westerncavern::store::CavernSurveyDatabase]speleo.survey_leg.grade_code, 6), 'THEODOLITE',
      case(equal([test::westerncavern::store::CavernSurveyDatabase]speleo.survey_leg.grade_code, 7), 'LASER_SCAN',
      case(equal([test::westerncavern::store::CavernSurveyDatabase]speleo.survey_leg.grade_code, 8), 'CONTROLLED_TRAVERSE',
      'UNGRADED'))))))))),
    surveyedPassageName: [test::westerncavern::store::CavernSurveyDatabase]@Passage_SurveyLeg | speleo.passage.passage_name,
    registerName: 'Western Cavern Survey Register'
  }

