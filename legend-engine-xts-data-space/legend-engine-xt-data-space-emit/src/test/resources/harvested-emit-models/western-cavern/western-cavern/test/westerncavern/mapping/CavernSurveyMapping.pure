    passageCode: [test::westerncavern::store::CavernSurveyDatabase]speleo.climate_station.passage_code,
    stationName: [test::westerncavern::store::CavernSurveyDatabase]speleo.climate_station.station_name,
    installedOn: [test::westerncavern::store::CavernSurveyDatabase]speleo.climate_station.installed_on,
    sensorNote: [test::westerncavern::store::CavernSurveyDatabase]speleo.climate_station.sensor_note
