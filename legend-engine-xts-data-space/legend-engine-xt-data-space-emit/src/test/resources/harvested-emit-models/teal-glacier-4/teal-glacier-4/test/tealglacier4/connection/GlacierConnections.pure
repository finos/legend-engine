###Connection
RelationalDatabaseConnection test::tealglacier4::connection::GlacierFieldConnection
{
  store: test::tealglacier4::store::GlacierFieldDB;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'TEAL_GLACIER_FIELD_DB';
    account: 'teal_glacier_account';
    warehouse: 'TEAL_GLACIER_FIELD_WH';
    region: 'eu-north-1';
    cloudType: 'aws';
    role: 'GLACIER_FIELD_READER';
  };
  auth: OAuth
  {
    oauthKey: 'GLACIER_FIELD_OAUTH';
    scopeName: 'SESSION:ROLE:GLACIER_FIELD_READER';
  };
}

RelationalDatabaseConnection test::tealglacier4::connection::GlacierArchiveConnection
{
  store: test::tealglacier4::store::GlacierArchiveDB;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'TEAL_GLACIER_ARCHIVE_DB';
    account: 'teal_glacier_account';
    warehouse: 'TEAL_GLACIER_ARCHIVE_WH';
    region: 'eu-north-1';
    cloudType: 'aws';
    role: 'GLACIER_ARCHIVE_READER';
  };
  auth: OAuth
  {
    oauthKey: 'GLACIER_ARCHIVE_OAUTH';
    scopeName: 'SESSION:ROLE:GLACIER_ARCHIVE_READER';
  };
}
