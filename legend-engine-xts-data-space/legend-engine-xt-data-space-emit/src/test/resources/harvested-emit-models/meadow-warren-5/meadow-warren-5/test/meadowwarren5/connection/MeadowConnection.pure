###Connection
RelationalDatabaseConnection test::meadowwarren5::connection::MeadowWarehouseConnection
{
  store: test::meadowwarren5::store::MeadowDatabase;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'EXAMPLE_MEADOW_WARREN_DB';
    account: 'example_meadow_warren_account';
    warehouse: 'EXAMPLE_MEADOW_WARREN_WH';
    region: 'eu-west-1';
    cloudType: 'aws';
    role: 'EXAMPLE_MEADOW_WARREN_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'EXAMPLE_MEADOW_WARREN_USER';
    privateKeyVaultReference: 'example-meadow-warren-private-key';
    passPhraseVaultReference: 'example-meadow-warren-passphrase';
  };
}
