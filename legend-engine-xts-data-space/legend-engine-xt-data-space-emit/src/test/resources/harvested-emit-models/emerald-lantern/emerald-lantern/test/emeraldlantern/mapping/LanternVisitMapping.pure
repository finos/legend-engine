###Mapping
Mapping test::emeraldlantern::mapping::LanternVisitMapping
(
  test::emeraldlantern::domain::VisitOutcome: EnumerationMapping VisitOutcomeMapping
  {
    Serviceable: ['SV'],
    Repaired: ['RP'],
    Escalated: ['ES']
  }

  *test::emeraldlantern::domain::KeeperVisit[keeperVisit]: Relational
  {
    ~primaryKey
    (
      [test::emeraldlantern::store::LanternDb]beacon.keeper_visit.station_id,
      [test::emeraldlantern::store::LanternDb]beacon.keeper_visit.visit_seq
    )
    ~mainTable [test::emeraldlantern::store::LanternDb]beacon.keeper_visit
    stationId: [test::emeraldlantern::store::LanternDb]beacon.keeper_visit.station_id,
    visitSeq: [test::emeraldlantern::store::LanternDb]beacon.keeper_visit.visit_seq,
    stationCode: [test::emeraldlantern::store::LanternDb]@Visit_Station | beacon.lantern_station.station_code,
    visitLabel: case(
                  equal([test::emeraldlantern::store::LanternDb]beacon.keeper_visit.visit_kind, 'RT'),
                  'ROUTINE CHECK',
                  case(
                    equal([test::emeraldlantern::store::LanternDb]beacon.keeper_visit.visit_kind, 'RP'),
                    concat('REPAIR CALL ', toUpper([test::emeraldlantern::store::LanternDb]beacon.keeper_visit.outcome_code)),
                    sqlNull()
                  )
                ),
    outcome: EnumerationMapping VisitOutcomeMapping: [test::emeraldlantern::store::LanternDb]beacon.keeper_visit.outcome_code,
    hoursOnSite: [test::emeraldlantern::store::LanternDb]beacon.keeper_visit.hours_on_site,
    districtOffice: [test::emeraldlantern::store::LanternDb]@Visit_Station > @Station_Office | harbour.district_office.office_name,
    coastSector: [test::emeraldlantern::store::LanternDb]@Visit_Station > @Station_Office > @Office_Sector | harbour.coast_sector.sector_name
  }

  testSuites:
  [
    keeperVisitBindingSuite:
    {
      function: |test::emeraldlantern::domain::KeeperVisit.all()->project(
  [
    col(x|$x.stationId, 'StationId'),
    col(x|$x.visitSeq, 'VisitSeq'),
    col(x|$x.stationCode, 'StationCode'),
    col(x|$x.visitLabel, 'VisitLabel'),
    col(x|$x.outcome, 'Outcome'),
    col(x|$x.hoursOnSite, 'HoursOnSite'),
    col(x|$x.districtOffice, 'DistrictOffice'),
    col(x|$x.coastSector, 'CoastSector')
  ]
)->sort([asc('StationId'), asc('VisitSeq')]);
      tests:
      [
        everyVisitBinding:
        {
          doc: 'Resolves the two-part visit key, both labelled visit kinds and the unlabelled fallback, an outcome code with no constant, and the two-hop and three-hop office and sector paths - complete for the northern and eastern stations, broken where the western district has no office and where the visit names no registered station.';
          data:
          [
            test::emeraldlantern::store::LanternDb:
              Relational
              #{
                beacon.lantern_station:
                  'station_id,station_code,station_name,district_code,keeper_name,lamp_kind,optic_kind,rotation_label,lens_state_code,service_tier_code,focal_metres,candela_rating,lens_diameter_metres,rotation_period_seconds,commissioned_on\n'+
                  '1,ST-1,Emerald Point,north,A Okafor,LED,ROTATING,BEAM-A,CL,R,18.5,12000.0,1.2,8.0,2019-04-01\n'+
                  '3,ST-3,Saddle Rock,east,C Duarte,HALOGEN,ROTATING,BEAM-B,CK,C,25.0,20000.0,1.6,6.0,2015-02-20\n'+
                  '4,ST-4,Gull Ledge,west,D Moreau,LED,ROTATING,BEAM-A,UN,R,9.5,1500.0,0.7,10.0,2022-09-09\n';
                beacon.keeper_visit:
                  'station_id,visit_seq,visit_kind,outcome_code,hours_on_site,visited_on\n'+
                  '1,1,RT,SV,3,2026-01-10\n'+
                  '1,2,RP,rp,6,2026-02-14\n'+
                  '3,1,XX,ES,9,2026-01-22\n'+
                  '4,1,RT,ZZ,2,2026-03-03\n'+
                  '9,1,RT,SV,5,2026-03-18\n';
                harbour.district_office:
                  'district_code,office_name,coast_code\n'+
                  'north,North Harbour Office,NC\n'+
                  'east,East Reach Office,EC\n';
                harbour.coast_sector:
                  'coast_code,sector_name\n'+
                  'NC,Northern Coast\n'+
                  'EC,Eastern Coast\n';
              }#
          ];
          asserts:
          [
            visitRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"StationId":1,"VisitSeq":1,"StationCode":"ST-1","VisitLabel":"ROUTINE CHECK","Outcome":"Serviceable","HoursOnSite":3,"DistrictOffice":"North Harbour Office","CoastSector":"Northern Coast"},{"StationId":1,"VisitSeq":2,"StationCode":"ST-1","VisitLabel":"REPAIR CALL RP","Outcome":null,"HoursOnSite":6,"DistrictOffice":"North Harbour Office","CoastSector":"Northern Coast"},{"StationId":3,"VisitSeq":1,"StationCode":"ST-3","VisitLabel":null,"Outcome":"Escalated","HoursOnSite":9,"DistrictOffice":"East Reach Office","CoastSector":"Eastern Coast"},{"StationId":4,"VisitSeq":1,"StationCode":"ST-4","VisitLabel":"ROUTINE CHECK","Outcome":null,"HoursOnSite":2,"DistrictOffice":null,"CoastSector":null},{"StationId":9,"VisitSeq":1,"StationCode":null,"VisitLabel":"ROUTINE CHECK","Outcome":"Serviceable","HoursOnSite":5,"DistrictOffice":null,"CoastSector":null}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
