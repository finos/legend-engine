###DataSpace
DataSpace test::emeraldlantern::dataspace::LanternDataSpace
{
  executionContexts:
  [
    {
      name: 'harbourBoard';
      description: 'Harbour board context - the station family and the keeper visits read through the board depot.';
      mapping: test::emeraldlantern::mapping::LanternMapping;
      defaultRuntime: test::emeraldlantern::runtime::HarbourBoardRuntime;
    }
  ];
  defaultExecutionContext: 'harbourBoard';
  title: 'Emerald Lantern Station Register';
  description: 'Entry point for exploring the coastal lantern stations, their turning-optic specialisation and the keeper visits paid to them, with the district office and coast sector each visit answers to.';
  elements:
  [
    test::emeraldlantern::domain::KeeperVisit,
    test::emeraldlantern::domain::LanternStation,
    test::emeraldlantern::domain::RotatingLantern
  ];
}
