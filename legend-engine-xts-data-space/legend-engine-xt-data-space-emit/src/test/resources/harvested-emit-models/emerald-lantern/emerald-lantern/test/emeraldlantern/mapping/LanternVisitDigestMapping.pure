###Mapping
Mapping test::emeraldlantern::mapping::LanternVisitDigestMapping
(
  test::emeraldlantern::domain::ServiceTier: EnumerationMapping VisitUrgencyMapping
  {
    Routine: ['SHORT'],
    Priority: ['LONG'],
    Critical: ['OVERNIGHT']
  }

  *test::emeraldlantern::domain::VisitDigest[visitDigest]: Pure
  {
    ~src test::emeraldlantern::domain::KeeperVisit
    stationCode: if($src.stationCode->isEmpty(), |'UNPLATED', |$src.stationCode->toOne()->toUpper()->trim()),
    visitSeq: $src.visitSeq,
    urgency: EnumerationMapping VisitUrgencyMapping: [if($src.hoursOnSite >= 8, |'OVERNIGHT', |if($src.hoursOnSite >= 4, |'LONG', |'SHORT'))],
    effortBand: if($src.hoursOnSite >= 8, |'FULL SHIFT', |'PART SHIFT')
  }

  testSuites:
  [
    visitDigestSuite:
    {
      function: |test::emeraldlantern::domain::VisitDigest.all()->graphFetch(#{test::emeraldlantern::domain::VisitDigest{stationCode,visitSeq,urgency,effortBand}}#)->serialize(#{test::emeraldlantern::domain::VisitDigest{stationCode,visitSeq,urgency,effortBand}}#);
      tests:
      [
        everyUrgencyBand:
        {
          doc: 'Folds the hours on site onto each queue urgency - a short, a long and an overnight visit - and replaces a missing plate with the placeholder.';
          data:
          [
            ModelStore:
              ModelStore
              #{
                test::emeraldlantern::domain::KeeperVisit:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"stationId":1,"visitSeq":1,"stationCode":"st-1 ","hoursOnSite":3},{"stationId":1,"visitSeq":2,"stationCode":"st-1","hoursOnSite":6},{"stationId":3,"visitSeq":1,"stationCode":"st-3","hoursOnSite":9},{"stationId":9,"visitSeq":1,"hoursOnSite":5}]';
                  }#
              }#
          ];
          asserts:
          [
            digestRows:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"stationCode":"ST-1","visitSeq":1,"urgency":"Routine","effortBand":"PART SHIFT"},{"stationCode":"ST-1","visitSeq":2,"urgency":"Priority","effortBand":"PART SHIFT"},{"stationCode":"ST-3","visitSeq":1,"urgency":"Critical","effortBand":"FULL SHIFT"},{"stationCode":"UNPLATED","visitSeq":1,"urgency":"Priority","effortBand":"PART SHIFT"}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
