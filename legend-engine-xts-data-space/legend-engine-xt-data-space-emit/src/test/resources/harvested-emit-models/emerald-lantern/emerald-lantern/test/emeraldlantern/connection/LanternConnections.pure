###Connection
RelationalDatabaseConnection test::emeraldlantern::connection::HarbourBoardConnection
{
  store: test::emeraldlantern::store::LanternDb;
  type: Sybase;
  timezone: +0000;
  quoteIdentifiers: false;
  specification: Static
  {
    name: 'LANTERN_BOARD_DB';
    host: 'example-lantern-board-host';
    port: 5000;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'lanternboardprincipal';
  };
  postProcessors:
  [
    mapper
    {
      mappers:
      [
        table {from: 'keeper_visit'; to: 'keeper_visit_current'; schemaFrom: 'beacon'; schemaTo: 'beacon';},
        table {from: 'district_office'; to: 'district_office_current'; schemaFrom: 'harbour'; schemaTo: 'harbour';},
        table {from: 'coast_sector'; to: 'coast_sector_current'; schemaFrom: 'harbour'; schemaTo: 'harbour';}
      ];
    }
  ];
}

###Connection
RelationalDatabaseConnection test::emeraldlantern::connection::DistrictDepotConnection
{
  store: test::emeraldlantern::store::LanternDb;
  type: Sybase;
  timezone: +0000;
  quoteIdentifiers: false;
  specification: Static
  {
    name: 'LANTERN_DEPOT_DB';
    host: 'example-lantern-depot-host';
    port: 5100;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'lanterndepotprincipal';
  };
  postProcessors:
  [
    mapper
    {
      mappers:
      [
        table {from: 'keeper_visit'; to: 'keeper_visit_current'; schemaFrom: 'beacon'; schemaTo: 'beacon';},
        table {from: 'district_office'; to: 'district_office_current'; schemaFrom: 'harbour'; schemaTo: 'harbour';},
        table {from: 'coast_sector'; to: 'coast_sector_current'; schemaFrom: 'harbour'; schemaTo: 'harbour';}
      ];
    }
  ];
}
