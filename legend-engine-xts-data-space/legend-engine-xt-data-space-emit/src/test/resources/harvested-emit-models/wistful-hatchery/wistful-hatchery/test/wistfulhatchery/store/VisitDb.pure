###Relational
Database test::wistfulhatchery::store::VisitDb
(
  Schema visit
  (
    Table guided_visit
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )
      visit_id INTEGER PRIMARY KEY,
      visit_code VARCHAR(20) NOT NULL,
      docent_id INTEGER NOT NULL,
      visitor_count INTEGER NOT NULL,
      visited_on DATE NOT NULL,
      in_z DATE NOT NULL,
      out_z DATE NOT NULL
    )
    Table docent
    (
      docent_id INTEGER PRIMARY KEY,
      docent_name VARCHAR(60) NOT NULL,
      shift_name VARCHAR(40) NOT NULL
    )
  )

  Join Visit_Docent(visit.guided_visit.docent_id = visit.docent.docent_id)
)
