###Mapping
Mapping test::wistfulhatchery::mapping::HabitatMapping
(
  *test::wistfulhatchery::domain::Enclosure[enclosure]: Relational
  {
    ~primaryKey
    (
      [test::wistfulhatchery::store::HabitatDb]habitat.enclosure.enclosure_id
    )
    ~mainTable [test::wistfulhatchery::store::HabitatDb]habitat.enclosure
    enclosureCode: [test::wistfulhatchery::store::HabitatDb]habitat.enclosure.enclosure_code,
    canopyType: [test::wistfulhatchery::store::HabitatDb]habitat.enclosure.canopy_type
  }

  *test::wistfulhatchery::domain::ClimateReading[reading]: Relational
  {
    ~primaryKey
    (
      [test::wistfulhatchery::store::HabitatDb]habitat.climate_reading.reading_id
    )
    ~mainTable [test::wistfulhatchery::store::HabitatDb]habitat.climate_reading
    humidityPct: [test::wistfulhatchery::store::HabitatDb]habitat.climate_reading.humidity_pct,
    takenOn: [test::wistfulhatchery::store::HabitatDb]habitat.climate_reading.taken_on,
    enclosureCode: [test::wistfulhatchery::store::HabitatDb]@Reading_Enclosure | [test::wistfulhatchery::store::HabitatDb]habitat.enclosure.enclosure_code,
    canopyType: [test::wistfulhatchery::store::HabitatDb]@Reading_Enclosure | [test::wistfulhatchery::store::HabitatDb]habitat.enclosure.canopy_type,
    comfortBand: case(
                   greaterThanEqual([test::wistfulhatchery::store::HabitatDb]habitat.climate_reading.humidity_pct, 80),
                   'humid',
                   case(
                     greaterThanEqual([test::wistfulhatchery::store::HabitatDb]habitat.climate_reading.humidity_pct, 60),
                     'balanced',
                     case(
                       greaterThan([test::wistfulhatchery::store::HabitatDb]habitat.climate_reading.humidity_pct, 30),
                       'dry',
                       sqlNull()
                     )
                   )
                 )
  }

  *test::wistfulhatchery::domain::NectarStation[station]: Relational
  {
    ~primaryKey
    (
      [test::wistfulhatchery::store::HabitatDb]habitat.nectar_station.station_id
    )
    ~mainTable [test::wistfulhatchery::store::HabitatDb]habitat.nectar_station
    stationCode: [test::wistfulhatchery::store::HabitatDb]habitat.nectar_station.station_code,
    flowerMix: [test::wistfulhatchery::store::HabitatDb]habitat.nectar_station.flower_mix,
    enclosureCode: [test::wistfulhatchery::store::HabitatDb]@Station_Enclosure | [test::wistfulhatchery::store::HabitatDb]habitat.enclosure.enclosure_code
  }

  testSuites:
  [
    comfortBandSuite:
    {
      function: test::wistfulhatchery::domain::ClimateReading.all(%2026-06-01)->project(~[takenOn: r|$r.takenOn, enclosureCode: r|$r.enclosureCode, canopyType: r|$r.canopyType, comfortBand: r|$r.comfortBand])->sort([~takenOn->ascending()]);
      tests:
      [
        everyComfortBandArm:
        {
          doc: 'Projects the in-force humidity readings so each comfort band arm and the too-dry sentinel are exercised alongside the enclosure lookup join, while the reading whose processing window closed before the query date is excluded.';
          data:
          [
            test::wistfulhatchery::store::HabitatDb:
              Relational
              #{
                habitat.enclosure:
                  'enclosure_id,enclosure_code,canopy_type\n'+
                  '1,EN-01,Open Canopy\n'+
                  '2,EN-02,Closed Canopy\n';

                habitat.climate_reading:
                  'reading_id,enclosure_id,humidity_pct,taken_on,in_z,out_z\n'+
                  '1,1,85.0,2026-05-01,2026-01-01,9999-12-31\n'+
                  '2,1,65.0,2026-05-02,2026-01-01,9999-12-31\n'+
                  '3,2,45.0,2026-05-03,2026-01-01,9999-12-31\n'+
                  '4,2,20.0,2026-05-04,2026-01-01,9999-12-31\n'+
                  '5,2,90.0,2026-05-05,2020-01-01,2021-12-31\n';

                habitat.nectar_station:
                  'station_id,station_code,enclosure_id,flower_mix\n'+
                  '1,NS-01,1,Ridge Mix\n'+
                  '2,NS-02,2,Fen Mix\n';
              }#
          ];
          asserts:
          [
            comfortRows:
              Relation
              #{
                takenOn,enclosureCode,canopyType,comfortBand
                2026-05-01,EN-01,Open Canopy,humid
                2026-05-02,EN-01,Open Canopy,balanced
                2026-05-03,EN-02,Closed Canopy,dry
                2026-05-04,EN-02,Closed Canopy,;
              }#
          ];
        }
      ];
    }
  ]
)
