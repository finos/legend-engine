###Mapping
Mapping test::wistfulhatchery::mapping::BroodBaseMapping
(
  *test::wistfulhatchery::domain::Facility[facility]: Relational
  {
    ~primaryKey
    (
      [test::wistfulhatchery::store::BroodDb]brood.facility.facility_id
    )
    ~mainTable [test::wistfulhatchery::store::BroodDb]brood.facility
    facilityName: [test::wistfulhatchery::store::BroodDb]brood.facility.facility_name,
    regionName: [test::wistfulhatchery::store::BroodDb]brood.facility.region_name
  }

  *test::wistfulhatchery::domain::BroodRoom[room]: Relational
  {
    ~primaryKey
    (
      [test::wistfulhatchery::store::BroodDb]brood.brood_room.room_id
    )
    ~mainTable [test::wistfulhatchery::store::BroodDb]brood.brood_room
    roomCode: [test::wistfulhatchery::store::BroodDb]brood.brood_room.room_code,
    temperatureC: [test::wistfulhatchery::store::BroodDb]brood.brood_room.temperature_c,
    facilityName: [test::wistfulhatchery::store::BroodDb]@Room_Facility | [test::wistfulhatchery::store::BroodDb]brood.facility.facility_name
  }
)
