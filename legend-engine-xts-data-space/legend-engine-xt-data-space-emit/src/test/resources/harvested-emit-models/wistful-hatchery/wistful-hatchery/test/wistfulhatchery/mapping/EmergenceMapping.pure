###Mapping
Mapping test::wistfulhatchery::mapping::EmergenceMapping
(
  *test::wistfulhatchery::domain::EmergenceRecord[record]: Relational
  {
    ~primaryKey
    (
      [test::wistfulhatchery::store::EmergenceDb]emergence.emergence_record.record_id
    )
    ~mainTable [test::wistfulhatchery::store::EmergenceDb]emergence.emergence_record
    cohortCode: [test::wistfulhatchery::store::EmergenceDb]emergence.emergence_record.cohort_code,
    emergedCount: [test::wistfulhatchery::store::EmergenceDb]emergence.emergence_record.emerged_count,
    recordedOn: [test::wistfulhatchery::store::EmergenceDb]emergence.emergence_record.recorded_on,
    releaseCode: [test::wistfulhatchery::store::EmergenceDb]@Emergence_Release | [test::wistfulhatchery::store::EmergenceDb]emergence.release_event.event_code
  }

  *test::wistfulhatchery::domain::ReleaseEvent[release]: Relational
  {
    ~primaryKey
    (
      [test::wistfulhatchery::store::EmergenceDb]emergence.release_event.event_id
    )
    ~mainTable [test::wistfulhatchery::store::EmergenceDb]emergence.release_event
    eventCode: [test::wistfulhatchery::store::EmergenceDb]emergence.release_event.event_code,
    cohortCode: [test::wistfulhatchery::store::EmergenceDb]emergence.release_event.cohort_code,
    releasedCount: [test::wistfulhatchery::store::EmergenceDb]emergence.release_event.released_count,
    releasedOn: [test::wistfulhatchery::store::EmergenceDb]emergence.release_event.released_on,
    observerName: [test::wistfulhatchery::store::EmergenceDb]@Release_Observer | [test::wistfulhatchery::store::EmergenceDb]emergence.observer.observer_name,
    teamName: [test::wistfulhatchery::store::EmergenceDb]@Release_Observer | [test::wistfulhatchery::store::EmergenceDb]emergence.observer.team_name
  }

  *test::wistfulhatchery::domain::Observer[observer]: Relational
  {
    ~primaryKey
    (
      [test::wistfulhatchery::store::EmergenceDb]emergence.observer.observer_id
    )
    ~mainTable [test::wistfulhatchery::store::EmergenceDb]emergence.observer
    observerName: [test::wistfulhatchery::store::EmergenceDb]emergence.observer.observer_name,
    teamName: [test::wistfulhatchery::store::EmergenceDb]emergence.observer.team_name
  }

  testSuites:
  [
    releaseObserverSuite:
    {
      function: test::wistfulhatchery::domain::ReleaseEvent.all()->project(~[eventCode: r|$r.eventCode, observerName: r|$r.observerName, teamName: r|$r.teamName, releasedCount: r|$r.releasedCount])->sort([~eventCode->ascending()]);
      tests:
      [
        releasesCarryObserverTeam:
        {
          doc: 'Projects each release event with the observer name and team reached by a single hop so the join and the release tallies are both asserted.';
          data:
          [
            test::wistfulhatchery::store::EmergenceDb:
              Relational
              #{
                emergence.observer:
                  'observer_id,observer_name,team_name\n'+
                  '1,Wren Alder,Dawn Team\n'+
                  '2,Rowan Sedge,Dusk Team\n';

                emergence.release_event:
                  'event_id,event_code,cohort_code,released_count,released_on,observer_id\n'+
                  '1,RE-01,C-01,120,2026-05-10,1\n'+
                  '2,RE-02,C-02,80,2026-05-11,2\n'+
                  '3,RE-03,C-03,45,2026-05-12,1\n';

                emergence.emergence_record:
                  'record_id,cohort_code,emerged_count,recorded_on,in_z,out_z\n'+
                  '1,C-01,118,2026-05-09,2026-01-01,9999-12-31\n';
              }#
          ];
          asserts:
          [
            releaseRows:
              Relation
              #{
                eventCode,observerName,teamName,releasedCount
                RE-01,Wren Alder,Dawn Team,120
                RE-02,Rowan Sedge,Dusk Team,80
                RE-03,Wren Alder,Dawn Team,45;
              }#
          ];
        }
      ];
    }
  ]
)
