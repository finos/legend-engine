###Pure
import meta::pure::profiles::*;
import test::wistfulhatchery::domain::*;

Class {doc.doc = 'A conservatory building that holds brood rooms.'} test::wistfulhatchery::domain::Facility
{
  facilityName: String[1];
  regionName: String[1];
}

Class {doc.doc = 'A climate-controlled room inside a facility in which cohorts are reared.'} test::wistfulhatchery::domain::BroodRoom
{
  roomCode: String[1];
  temperatureC: Float[1];
  facilityName: String[1];
}

Class <<temporal.processingtemporal>> {doc.doc = 'One reared cohort of larvae, corrected over processing time.'} test::wistfulhatchery::domain::LarvalCohort
{
  cohortCode: String[1];
  speciesName: String[1];
  larvaCount: Integer[1];
  roomCode: String[1];
  regionName: String[1];
  vigourBand: String[0..1];
  startedOn: StrictDate[1];
  readinessNote() {if($this.vigourBand->isEmpty(), |'unassessed', |if($this.larvaCount >= 400, |($this.vigourBand->toOne()->toUpper()->trim() + '-DENSE'), |if($this.larvaCount >= 200, |($this.vigourBand->toOne()->toUpper()->trim() + '-STEADY'), |($this.vigourBand->toOne()->toUpper()->trim() + '-SPARSE'))))}: String[1];
}

Class {doc.doc = 'A nectar or larval host planting kept in a brood room.'} test::wistfulhatchery::domain::HostPlant
{
  plantCode: String[1];
  plantSpecies: String[1];
  roomCode: String[1];
  plantedOn: StrictDate[1];
}

Class <<temporal.processingtemporal>> {doc.doc = 'A count of adults emerged from one cohort, corrected over processing time.'} test::wistfulhatchery::domain::EmergenceRecord
{
  cohortCode: String[1];
  emergedCount: Integer[1];
  recordedOn: StrictDate[1];
  releaseCode: String[0..1];
}

Class {doc.doc = 'A release of emerged adults into a planted enclosure.'} test::wistfulhatchery::domain::ReleaseEvent
{
  eventCode: String[1];
  cohortCode: String[1];
  releasedCount: Integer[1];
  releasedOn: StrictDate[1];
  observerName: String[1];
  teamName: String[1];
}

Class {doc.doc = 'A volunteer who records releases.'} test::wistfulhatchery::domain::Observer
{
  observerName: String[1];
  teamName: String[1];
}

Class {doc.doc = 'A planted flight enclosure open to released adults.'} test::wistfulhatchery::domain::Enclosure
{
  enclosureCode: String[1];
  canopyType: String[1];
}

Class <<temporal.processingtemporal>> {doc.doc = 'A humidity reading taken in an enclosure, corrected over processing time.'} test::wistfulhatchery::domain::ClimateReading
{
  enclosureCode: String[1];
  canopyType: String[1];
  humidityPct: Float[1];
  takenOn: StrictDate[1];
  comfortBand: String[0..1];
}

Class {doc.doc = 'A feeding station stocked with a flower mix inside an enclosure.'} test::wistfulhatchery::domain::NectarStation
{
  stationCode: String[1];
  flowerMix: String[1];
  enclosureCode: String[1];
}

Class <<temporal.processingtemporal>> {doc.doc = 'A guided public visit through the flight enclosures, corrected over processing time.'} test::wistfulhatchery::domain::GuidedVisit
{
  visitCode: String[1];
  visitorCount: Integer[1];
  visitedOn: StrictDate[1];
  docentName: String[1];
  shiftName: String[1];
}

Class {doc.doc = 'A guide who leads public visits on a named shift.'} test::wistfulhatchery::domain::Docent
{
  docentName: String[1];
  shiftName: String[1];
}
