###Relational
Database test::wistfulhatchery::store::EmergenceDb
(
  Schema emergence
  (
    Table emergence_record
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )
      record_id INTEGER PRIMARY KEY,
      cohort_code VARCHAR(20) NOT NULL,
      emerged_count INTEGER NOT NULL,
      recorded_on DATE NOT NULL,
      in_z DATE NOT NULL,
      out_z DATE NOT NULL
    )
    Table release_event
    (
      event_id INTEGER PRIMARY KEY,
      event_code VARCHAR(20) NOT NULL,
      cohort_code VARCHAR(20) NOT NULL,
      released_count INTEGER NOT NULL,
      released_on DATE NOT NULL,
      observer_id INTEGER NOT NULL
    )
    Table observer
    (
      observer_id INTEGER PRIMARY KEY,
      observer_name VARCHAR(60) NOT NULL,
      team_name VARCHAR(60) NOT NULL
    )
  )

  Join Release_Observer(emergence.release_event.observer_id = emergence.observer.observer_id)
  Join Emergence_Release(emergence.emergence_record.cohort_code = emergence.release_event.cohort_code)
)
