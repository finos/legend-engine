###Relational
Database test::wistfulhatchery::store::HabitatDb
(
  Schema habitat
  (
    Table enclosure
    (
      enclosure_id INTEGER PRIMARY KEY,
      enclosure_code VARCHAR(20) NOT NULL,
      canopy_type VARCHAR(40) NOT NULL
    )
    Table climate_reading
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )
      reading_id INTEGER PRIMARY KEY,
      enclosure_id INTEGER NOT NULL,
      humidity_pct DOUBLE NOT NULL,
      taken_on DATE NOT NULL,
      in_z DATE NOT NULL,
      out_z DATE NOT NULL
    )
    Table nectar_station
    (
      station_id INTEGER PRIMARY KEY,
      station_code VARCHAR(20) NOT NULL,
      enclosure_id INTEGER NOT NULL,
      flower_mix VARCHAR(60) NOT NULL
    )
  )

  Join Reading_Enclosure(habitat.climate_reading.enclosure_id = habitat.enclosure.enclosure_id)
  Join Station_Enclosure(habitat.nectar_station.enclosure_id = habitat.enclosure.enclosure_id)
)
