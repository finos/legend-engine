###Connection
RelationalDatabaseConnection test::wistfulhatchery::connection::BroodWarehouseConnection
{
  store: test::wistfulhatchery::store::BroodDb;
  type: Snowflake;
  timezone: 'UTC';
  specification: Snowflake
  {
    name: 'BROOD_REARING_DB';
    account: 'conservatory_brood_account';
    warehouse: 'BROOD_REARING_WH';
    region: 'eu-west-2';
    cloudType: 'aws';
    role: 'BROOD_REARING_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'BROOD_REARING_USER';
    privateKeyVaultReference: 'brood.rearing.privateKey';
    passPhraseVaultReference: 'brood.rearing.passPhrase';
  };
}

