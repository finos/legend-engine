###Pure
Class <<temporal.processingtemporal>> {meta::pure::profiles::doc.doc = 'A bench survey as currently recorded; every correction opens a new processing version so only the latest recording is resolved.'} test::noblequarry::live::domain::BenchSurvey
{
  surveyRef: String[1];
  benchCode: String[1];
  surveyorCode: String[1];
  faceHeightMetres: Float[1];
  surveyedOn: StrictDate[1];
  validFrom: StrictDate[1];
  validTo: StrictDate[0..1];
}

Class <<temporal.processingtemporal>> {meta::pure::profiles::doc.doc = 'One blast fired on a quarry bench as currently recorded.'} test::noblequarry::live::domain::BlastRecord
{
  blastRef: String[1];
  benchCode: String[1];
  siteRef: String[1];
  firedOn: StrictDate[1];
  chargeKg: Float[1];
  holeCount: Integer[1];
}

Association test::noblequarry::live::domain::SurveyBlasts
{
  surveys: test::noblequarry::live::domain::BenchSurvey[*];
  blasts: test::noblequarry::live::domain::BlastRecord[*];
}

Association test::noblequarry::live::domain::SurveySites
{
  liveSurveys: test::noblequarry::live::domain::BenchSurvey[*];
  sites: test::noblequarry::shared::domain::QuarrySite[*];
}

Association test::noblequarry::live::domain::BlastSites
{
  liveBlasts: test::noblequarry::live::domain::BlastRecord[*];
  sites: test::noblequarry::shared::domain::QuarrySite[*];
}
