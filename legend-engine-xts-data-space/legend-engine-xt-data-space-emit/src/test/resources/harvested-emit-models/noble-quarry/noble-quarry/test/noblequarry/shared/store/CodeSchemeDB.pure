###Relational
Database test::noblequarry::shared::store::CodeSchemeDB
(
  include test::noblequarry::shared::store::SiteRegistryDB

  Schema xref
  (
    Table code_scheme
    (
      source_key VARCHAR(16) PRIMARY KEY,
      local_code VARCHAR(24) PRIMARY KEY,
      in_batch INTEGER PRIMARY KEY,
      link_group VARCHAR(16) NOT NULL,
      linked_code VARCHAR(24),
      out_batch INTEGER NOT NULL
    )
  )
)
