###Connection
RelationalDatabaseConnection test::noblequarry::live::connection::QuarryLiveConnection
{
  store: test::noblequarry::live::store::QuarryLiveDB;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'NOBLE_QUARRY_LIVE_DB';
    account: 'example_noble_quarry_account';
    warehouse: 'NOBLE_QUARRY_LIVE_WH';
    region: 'eu-west-1';
    cloudType: 'aws';
    role: 'NOBLE_QUARRY_LIVE_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'EXAMPLE_NOBLE_QUARRY_LIVE_READER';
    privateKeyVaultReference: 'noblequarry.live.privateKey';
    passPhraseVaultReference: 'noblequarry.live.passPhrase';
  };
  postProcessors:
  [
    mapper
    {
      mappers:
      [
        schema {from: 'quarry'; to: 'quarry_curated';},
        schema {from: 'xref'; to: 'xref_published';}
      ];
    }
  ];
}
