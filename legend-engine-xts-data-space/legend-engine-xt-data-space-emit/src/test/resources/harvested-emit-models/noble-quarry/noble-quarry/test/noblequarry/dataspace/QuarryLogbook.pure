###DataSpace
DataSpace <<test::noblequarry::profile::QuarryCatalogue.curatedLogbook>> {test::noblequarry::profile::QuarryCatalogue.logbookPath = 'operations/quarry/bench-surveys', test::noblequarry::profile::QuarryCatalogue.stewardTeam = 'Bench Survey Office'} test::noblequarry::dataspace::QuarryLogbook
{
  executionContexts:
  [
    {
      name: 'live';
      description: 'Currently recorded bench surveys and blasts resolved at the latest processing date.';
      mapping: test::noblequarry::live::mapping::QuarryLiveMapping;
      defaultRuntime: test::noblequarry::live::runtime::QuarryLiveRuntime;
    }
  ];
  defaultExecutionContext: 'live';
  title: 'Noble Quarry Bench Logbook';
  description: 'Entry point over the quarry bench logbook - bench surveys, the blasts fired on each bench and the registered sites they cross-reference - with the two survey registers featured as ready-made endpoints.';
  elements:
  [
    test::noblequarry::live::domain
  ];
  executables:
  [
    {
      id: 1;
      title: 'Live survey register';
      description: 'Every currently recorded bench survey.';
      executable: test::noblequarry::live::service::LiveSurveyRegister;
    },
    {
      id: 2;
      title: 'Archived survey register';
      description: 'Every bench survey frozen into an archive cycle.';
      executable: test::noblequarry::archive::service::ArchivedSurveyRegister;
    }
  ];
  supportInfo: Combined
  {
    emails: ['bench-survey-office-group', 'quarry-logbook-stewards'];
  };
}
