###Connection
RelationalDatabaseConnection test::noblequarry::archive::connection::QuarryArchiveConnection
{
  store: test::noblequarry::archive::store::QuarryArchiveDB;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'NOBLE_QUARRY_ARCHIVE_DB';
    account: 'example_noble_quarry_account';
    warehouse: 'NOBLE_QUARRY_ARCHIVE_WH';
    region: 'eu-west-1';
    cloudType: 'aws';
    role: 'NOBLE_QUARRY_ARCHIVE_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'EXAMPLE_NOBLE_QUARRY_ARCHIVE_READER';
    privateKeyVaultReference: 'noblequarry.archive.privateKey';
    passPhraseVaultReference: 'noblequarry.archive.passPhrase';
  };
  postProcessors:
  [
    mapper
    {
      mappers:
      [
        schema {from: 'quarry_archive'; to: 'quarry_archive_curated';},
        schema {from: 'xref'; to: 'xref_published';}
      ];
    }
  ];
}
