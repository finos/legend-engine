###Relational
Database test::frostedfossil4::store::IceArchiveDb
(
  Schema archive
  (
    Table ice_core
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )

      core_code VARCHAR(24) PRIMARY KEY,
      site_code VARCHAR(24) NOT NULL,
      drill_depth_metres DOUBLE NOT NULL,
      isotope_index DECIMAL(9, 4) NOT NULL,
      sealed_at TIMESTAMP,
      retrieved_on DATE NOT NULL,
      in_z DATE PRIMARY KEY,
      out_z DATE
    )

    Table core_segment
    (
      milestoning
      (
        processing(PROCESSING_IN = in_z, PROCESSING_OUT = out_z)
      )

      segment_code VARCHAR(24) PRIMARY KEY,
      core_code VARCHAR(24) NOT NULL,
      segment_length_cm INTEGER NOT NULL,
      density_g_cm3 DOUBLE NOT NULL,
      in_z DATE PRIMARY KEY,
      out_z DATE
    )

    Table drill_site
    (
      site_code VARCHAR(24) PRIMARY KEY,
      site_name VARCHAR(120) NOT NULL,
      region_name VARCHAR(80) NOT NULL
    )
  )

  Join Core_Site_J
  (
    [test::frostedfossil4::store::IceArchiveDb]archive.ice_core.site_code =
      [test::frostedfossil4::store::IceArchiveDb]archive.drill_site.site_code
  )

  Join Core_Segment_J
  (
    [test::frostedfossil4::store::IceArchiveDb]archive.ice_core.core_code =
      [test::frostedfossil4::store::IceArchiveDb]archive.core_segment.core_code
  )
)
