###Pure
import test::frostedfossil4::domain::*;

Class <<meta::pure::profiles::temporal.processingtemporal>> test::frostedfossil4::domain::IceCore
{
  coreCode: String[1];
  siteCode: String[1];
  drillDepthMetres: Float[1];
  isotopeIndex: Decimal[1];
  sealedAt: DateTime[0..1];
  retrievedOn: StrictDate[1];
  siteRegion: String[0..1];
}

Class <<meta::pure::profiles::temporal.processingtemporal>> test::frostedfossil4::domain::CoreSegment
{
  segmentCode: String[1];
  coreCode: String[1];
  segmentLengthCm: Integer[1];
  densityGcm3: Float[1];
}

Class test::frostedfossil4::domain::DrillSite
{
  siteCode: String[1];
  siteName: String[1];
  regionName: String[1];
}

Association test::frostedfossil4::domain::Core_DrillSite
{
  drillSite: DrillSite[0..1];
  cores: IceCore[*];
}

Association test::frostedfossil4::domain::Core_Segments
{
  core: IceCore[0..1];
  segments: CoreSegment[*];
}
