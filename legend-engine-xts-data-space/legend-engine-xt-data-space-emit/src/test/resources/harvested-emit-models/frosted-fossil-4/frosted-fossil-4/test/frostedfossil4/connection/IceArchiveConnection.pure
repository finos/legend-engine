###Connection
RelationalDatabaseConnection test::frostedfossil4::connection::IceArchiveWarehouseConnection
{
  store: test::frostedfossil4::store::IceArchiveDb;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'EXAMPLE_ICE_ARCHIVE_DB';
    account: 'example_ice_archive_account';
    warehouse: 'EXAMPLE_ICE_ARCHIVE_WH';
    region: 'eu-north-1';
    cloudType: 'aws';
    role: 'EXAMPLE_ICE_ARCHIVE_READER';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'EXAMPLE_ICE_ARCHIVE_READER';
    privateKeyVaultReference: 'icearchive.privateKey';
    passPhraseVaultReference: 'icearchive.passPhrase';
  };
}
