###DataSpace
DataSpace demo::meadowmarsh2::dataspace::MarshDataSpace
{
  executionContexts:
  [
    {
      name: 'fleet';
      description: 'Fleet context - the single association-bearing mapping resolved through the shared warehouse runtime.';
      mapping: demo::meadowmarsh2::mapping::MarshMapping;
      defaultRuntime: demo::meadowmarsh2::runtime::MarshRuntime;
    }
  ];
  defaultExecutionContext: 'fleet';
  title: 'Marsh Meadow Bike Share Fleet';
  description: 'Discovery surface over the marsh bike-share network: stations and their docks, the bicycles parked in them, the rides taken on those bicycles and the maintenance tickets raised against them, all navigable through mapped associations rather than restated joins.';
  elements:
  [
    demo::meadowmarsh2::domain::Bicycle,
    demo::meadowmarsh2::domain::Dock,
    demo::meadowmarsh2::domain::Ride,
    demo::meadowmarsh2::domain::Rider,
    demo::meadowmarsh2::domain::Station,
    demo::meadowmarsh2::domain::Ticket
  ];
  executables:
  [
    {
      id: 1;
      title: 'Station Dock Roster';
      description: 'The open docks of one ward with their station labels and capacities.';
      executable: demo::meadowmarsh2::service::StationDockRoster;
    },
    {
      id: 2;
      title: 'Rider Ride Log';
      description: 'The causeway rides of one membership tier with rider and bicycle labels attached.';
      executable: demo::meadowmarsh2::service::RiderRideLog;
    },
    {
      id: 3;
      title: 'Bicycle Ticket Digest';
      description: 'The per-model ticket counts and gear totals of one severity.';
      executable: demo::meadowmarsh2::service::BicycleTicketDigest;
    }
  ];
  supportInfo: Email
  {
    address: 'bikeshare-fleet-desk@marshmeadowtransport.invalid';
  };
}
