###Service
Service demo::meadowmarsh2::service::StationDockRoster
{
  pattern: '/bikeshare/v1/station-docks/{wardName}';
  title: 'Bike Share - Station Dock Roster';
  owners:
  [
    'marsh-bikeshare-operations',
    'marsh-station-stewardship'
  ];
  documentation: 'Publishes the docks of one ward with the station label reached as a join-path-bound column and the ward reached by navigating the station association end, narrowing the population to the open docks with a case-normalised equality.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: {wardName: String[1]|demo::meadowmarsh2::domain::Dock.all()->filter(
      d|($d.dockStatus->toUpper() == 'OPEN') && ($d.station.wardName->toOne() == $wardName)
    )->project(
      [
        d|$d.dockCode,
        d|$d.stationName,
        d|$d.station.wardName,
        d|$d.station.dockCapacity
      ],
      [
        'Dock/Code',
        'Dock/StationName',
        'Station/Ward',
        'Station/DockCapacity'
      ]
    )->sort(
      [
        asc('Dock/Code')
      ]
    )};
    mapping: demo::meadowmarsh2::mapping::MarshMapping;
    runtime: demo::meadowmarsh2::runtime::MarshRuntime;
  }
  testSuites:
  [
    stationDockSuite:
    {
      data:
      [
        connections:
        [
          marshWarehouse:
            Relational
            #{
              geo.station:
                'station_code,station_name,ward_name,dock_capacity\n'+
                'SN-01,Marsh Meadow Green,Reedbank,12\n'+
                'SN-02,Willow Causeway,Alderfen,8\n';

              fleet.dock:
                'dock_code,station_code,dock_status,installed_on\n'+
                'DK-01,SN-01,OPEN,2024-03-01\n'+
                'DK-02,SN-02,OPEN,2024-05-14\n'+
                'DK-03,SN-01,CLOSED,2023-11-02\n';
            }#
        ]
      ]
      tests:
      [
        theRequestedWardKeepsOnlyItsOpenDocks:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            wardName = 'Reedbank'
          ]
          asserts:
          [
            theClosedDockAndTheOtherWardBothDropOut:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Dock/Code":"DK-01","Dock/StationName":"Marsh Meadow Green","Station/Ward":"Reedbank","Station/DockCapacity":12}]';
                  }#;
              }#
          ]
        },
        aWardWithNoStationsReturnsNothing:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            wardName = 'Sedgemoor'
          ]
          asserts:
          [
            theUnknownWardEmptiesThePopulation:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

###Service
Service demo::meadowmarsh2::service::RiderRideLog
{
  pattern: '/bikeshare/v1/rider-rides/{membershipTier}';
  title: 'Bike Share - Rider Ride Log';
  owners:
  [
    'marsh-bikeshare-operations',
    'marsh-station-stewardship'
  ];
  documentation: 'Publishes the rides taken by the riders of one membership tier, reaching the rider name and tier across one association end and the bicycle model as a join-path-bound column, then deduplicating the projected log.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: {membershipTier: String[1]|demo::meadowmarsh2::domain::Ride.all()->filter(
      r|($r.rider.membershipTier->toOne() == $membershipTier) && ($r.routeLabel->toOne()->startsWith('Causeway'))
    )->project(
      [
        r|$r.rideCode,
        r|$r.rider.riderName,
        r|$r.bicycleModel,
        r|$r.routeLabel,
        r|$r.distanceKm
      ],
      [
        'Ride/Code',
        'Rider/Name',
        'Ride/BicycleModel',
        'Ride/RouteLabel',
        'Ride/DistanceKm'
      ]
    )->distinct()->sort(
      [
        asc('Ride/Code')
      ]
    )};
    mapping: demo::meadowmarsh2::mapping::MarshMapping;
    runtime: demo::meadowmarsh2::runtime::MarshRuntime;
  }
  testSuites:
  [
    riderRideSuite:
    {
      data:
      [
        connections:
        [
          marshWarehouse:
            Relational
            #{
              geo.station:
                'station_code,station_name,ward_name,dock_capacity\n'+
                'SN-01,Marsh Meadow Green,Reedbank,12\n';

              fleet.dock:
                'dock_code,station_code,dock_status,installed_on\n'+
                'DK-01,SN-01,OPEN,2024-03-01\n';

              fleet.bicycle:
                'bicycle_tag,dock_code,model_name,gear_count,wheel_size_mm\n'+
                'BC-01,DK-01,Reedcutter Seven,7,700\n'+
                'BC-02,DK-01,Sedge Runner Three,3,650\n';

              fleet.rider:
                'rider_code,rider_name,membership_tier,joined_on\n'+
                'RD-01,Avery Fen,ANNUAL,2023-04-01\n'+
                'RD-02,Briar Holt,CASUAL,2025-06-11\n';

              fleet.ride:
                'ride_code,bicycle_tag,rider_code,started_at,distance_km,route_label\n'+
                'RI-01,BC-01,RD-01,2026-05-02 07:15:00,4.5,Causeway Loop\n'+
                'RI-02,BC-02,RD-01,2026-05-03 08:05:00,2.25,Reedbank Spur\n'+
                'RI-03,BC-02,RD-02,2026-05-04 18:40:00,6.75,Causeway Loop\n';
            }#
        ]
      ]
      tests:
      [
        theAnnualTierKeepsOnlyItsCausewayRide:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            membershipTier = 'ANNUAL'
          ]
          asserts:
          [
            thePrefixMissAndTheOtherTierBothDropOut:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Ride/Code":"RI-01","Rider/Name":"Avery Fen","Ride/BicycleModel":"Reedcutter Seven","Ride/RouteLabel":"Causeway Loop","Ride/DistanceKm":4.5}]';
                  }#;
              }#
          ]
        },
        theCasualTierKeepsItsOwnCausewayRide:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            membershipTier = 'CASUAL'
          ]
          asserts:
          [
            theTierParameterMovesThePopulationAndNotTheShape:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Ride/Code":"RI-03","Rider/Name":"Briar Holt","Ride/BicycleModel":"Sedge Runner Three","Ride/RouteLabel":"Causeway Loop","Ride/DistanceKm":6.75}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}

###Service
Service demo::meadowmarsh2::service::BicycleTicketDigest
{
  pattern: '/bikeshare/v1/ticket-digest/{severityLabel}';
  title: 'Bike Share - Bicycle Ticket Digest';
  owners:
  [
    'marsh-bikeshare-operations',
    'marsh-station-stewardship'
  ];
  documentation: 'Groups the maintenance tickets of one severity by the bicycle model reached across the ticket association end onto a column of that class, counting the tickets and summing the gear counts so the aggregation runs over projected association-reached labels.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: {severityLabel: String[1]|demo::meadowmarsh2::domain::Ticket.all()->filter(
      t|$t.severityLabel == $severityLabel
    )->groupBy(
      [
        t|$t.ticketedBicycle.modelName->toOne()
      ],
      [
        agg(t|$t.ticketedBicycle.gearCount->toOne(), y|$y->sum()),
        agg(t|$t.ticketCode, y|$y->count())
      ],
      [
        'Bicycle/Model',
        'Total/Gears',
        'Total/Tickets'
      ]
    )->sort(
      [
        asc('Bicycle/Model')
      ]
    )};
    mapping: demo::meadowmarsh2::mapping::MarshMapping;
    runtime: demo::meadowmarsh2::runtime::MarshRuntime;
  }
  testSuites:
  [
    ticketDigestSuite:
    {
      data:
      [
        connections:
        [
          marshWarehouse:
            Relational
            #{
              fleet.bicycle:
                'bicycle_tag,dock_code,model_name,gear_count,wheel_size_mm\n'+
                'BC-01,DK-01,Reedcutter Seven,7,700\n'+
                'BC-02,DK-01,Sedge Runner Three,3,650\n';

              fleet.ticket:
                'ticket_code,bicycle_tag,raised_on,severity_label,note_text\n'+
                'TK-01,BC-01,2026-04-02,HIGH,brake pad worn\n'+
                'TK-02,BC-01,2026-04-09,HIGH,rear light dim\n'+
                'TK-03,BC-02,2026-04-11,LOW,bell rattles\n';
            }#
        ]
      ]
      tests:
      [
        theHighSeverityTicketsCollapseIntoOneModelGroup:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            severityLabel = 'HIGH'
          ]
          asserts:
          [
            twoTicketsOfOneModelSumTheirGearCounts:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Bicycle/Model":"Reedcutter Seven","Total/Gears":14,"Total/Tickets":2}]';
                  }#;
              }#
          ]
        },
        anUnusedSeverityGroupsNothing:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            severityLabel = 'CRITICAL'
          ]
          asserts:
          [
            theUnusedSeverityLeavesNoGroups:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
