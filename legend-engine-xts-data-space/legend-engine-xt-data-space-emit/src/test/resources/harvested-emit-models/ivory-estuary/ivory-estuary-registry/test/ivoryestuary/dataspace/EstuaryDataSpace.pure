###DataSpace
DataSpace {meta::pure::profiles::doc.doc = 'A curated entry point over the tidal-wetland monitoring model.'} test::ivoryestuary::dataspace::EstuaryDataSpace
{
  executionContexts:
  [
    {
      name: 'dev';
      description: 'Development tier over the wetland monitoring store.';
      mapping: test::ivoryestuary::mapping::EstuaryMapping;
      defaultRuntime: test::ivoryestuary::runtime::EstuaryRuntime;
    }
  ];
  defaultExecutionContext: 'dev';
  title: 'Tidal Wetland Monitoring';
  description: 'Publishes the monitoring-station roster of a tidal-wetland network: station codes, installation timestamps, salinity and tidal-range readings, telemetry state and the wetland each station sits in. The station endpoint is the featured executable and the layout element is the consumer-facing overview.';
  diagrams:
  [
    {
      title: 'Wetland Monitoring Overview';
      diagram: test::ivoryestuary::diagram::EstuaryDiagram;
    }
  ];
  elements:
  [
    test::ivoryestuary::domain
  ];
  executables:
  [
    {
      id: 1;
      title: 'Stations by tidal range';
      description: 'The threshold-parameterised station projection published as an executable of this entry point.';
      executable: test::ivoryestuary::service::StationsByTidalRangeService;
      executionContextKey: 'dev';
    }
  ];
  supportInfo: Email
  {
    address: 'estuary-monitoring@example.com';
  };
}
