###Service
Service test::ivoryestuary::service::StationsByTidalRangeService
{
  pattern: '/ivoryestuary/v1/stations/{minRangeM}';
  owners:
  [
    'estuary-monitoring'
  ];
  documentation: 'Projects active telemetry stations whose tidal range reaches a caller-supplied threshold, resolving the wetland name through the declared join.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: {minRangeM: Float[1]|test::ivoryestuary::domain::MonitoringStation.all()->filter(
      s|($s.tidalRangeM >= $minRangeM) && $s.telemetryActive
    )->project(
      [
        x|$x.stationCode,
        x|$x.wetland.wetlandName,
        x|$x.tidalRangeM
      ],
      [
        'Station',
        'Wetland',
        'TidalRangeM'
      ]
    )->sort([asc('Station')])};
    mapping: test::ivoryestuary::mapping::EstuaryMapping;
    runtime: test::ivoryestuary::runtime::EstuaryRuntime;
  }
  testSuites:
  [
    tidalRangeThresholdSuite:
    {
      data:
      [
        connections:
        [
          connection_1:
            Relational
            #{
              estuary.tidal_wetland:
                'wetland_id,wetland_name,designation\n'+
                '1,Nightheron Flats,ramsar\n'+
                '2,Cordgrass Reach,local\n';
              estuary.monitoring_station:
                'station_id,station_code,installed_at,salinity_ppt,tidal_range_m,telemetry_active,wetland_id\n'+
                '1,ST-001,2024-05-01 06:15:00,18.250,2.4,true,1\n'+
                '2,ST-002,2023-11-12 09:00:00,7.125,0.8,true,2\n'+
                '3,ST-003,2022-02-03 14:30:00,21.500,3.1,false,1\n';
            }#
        ]
      ]
      tests:
      [
        aboveThresholdAndActive:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            minRangeM = 2.0
          ]
          asserts:
          [
            onlyActiveStationAboveThreshold:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Station":"ST-001","Wetland":"Nightheron Flats","TidalRangeM":2.4}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
