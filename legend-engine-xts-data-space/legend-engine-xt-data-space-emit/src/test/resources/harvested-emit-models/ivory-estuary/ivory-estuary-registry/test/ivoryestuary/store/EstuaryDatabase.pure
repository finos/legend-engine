###Relational
Database test::ivoryestuary::store::EstuaryDB
(
  Schema estuary
  (
    Table tidal_wetland
    (
      wetland_id INTEGER PRIMARY KEY,
      wetland_name VARCHAR(200) NOT NULL,
      designation VARCHAR(50) NOT NULL
    )
    Table monitoring_station
    (
      station_id INTEGER PRIMARY KEY,
      station_code VARCHAR(40) NOT NULL,
      installed_at TIMESTAMP NOT NULL,
      salinity_ppt DECIMAL(9,3) NOT NULL,
      tidal_range_m DOUBLE NOT NULL,
      telemetry_active BIT NOT NULL,
      wetland_id INTEGER NOT NULL
    )
  )

  Join Station_Wetland(estuary.monitoring_station.wetland_id = estuary.tidal_wetland.wetland_id)
)
