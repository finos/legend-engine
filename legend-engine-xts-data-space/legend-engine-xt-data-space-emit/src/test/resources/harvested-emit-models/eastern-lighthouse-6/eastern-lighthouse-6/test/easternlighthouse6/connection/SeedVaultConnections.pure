###Connection
RelationalDatabaseConnection test::easternlighthouse6::connection::SeedVaultRegisterConnection
{
  store: test::easternlighthouse6::store::SeedVaultDb;
  type: SqlServer;
  specification: Static
  {
    name: 'seed_vault_register';
    host: 'example-seed-vault-host';
    port: 1433;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'seedvaultregisterprincipal';
  };
}

RelationalDatabaseConnection test::easternlighthouse6::connection::SeedVaultReportingConnection
{
  store: test::easternlighthouse6::store::SeedVaultDb;
  type: SqlServer;
  specification: Static
  {
    name: 'seed_vault_reporting';
    host: 'example-seed-vault-reporting-host';
    port: 1433;
  };
  auth: DelegatedKerberos
  {
    serverPrincipal: 'seedvaultreportingprincipal';
  };
}
