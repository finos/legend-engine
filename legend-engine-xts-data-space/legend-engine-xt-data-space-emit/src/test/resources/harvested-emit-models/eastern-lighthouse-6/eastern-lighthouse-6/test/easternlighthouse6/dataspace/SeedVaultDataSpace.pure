###DataSpace
DataSpace {meta::pure::profiles::doc.doc = 'Governed publication of the upland seed vault accession register.'} test::easternlighthouse6::dataspace::SeedVaultDataSpace
{
  executionContexts:
  [
    {
      name: 'register';
      description: 'Register estate - the accession mapping resolved through the register connection, so the plan is generated for the dialect that estate speaks.';
      mapping: test::easternlighthouse6::mapping::SeedVaultMapping;
      defaultRuntime: test::easternlighthouse6::runtime::SeedVaultRegisterRuntime;
    },
    {
      name: 'reporting';
      description: 'Reporting estate - the same accession mapping resolved through the reporting connection, so consumers reading history are kept off the register estate.';
      mapping: test::easternlighthouse6::mapping::SeedVaultMapping;
      defaultRuntime: test::easternlighthouse6::runtime::SeedVaultReportingRuntime;
    }
  ];
  defaultExecutionContext: 'register';
  title: 'Upland Seed Vault Accession Register';
  description: 'A governed entry point over the seed accessions kept in the upland vault - the taxon, provenance, handling and storage columns recorded against each accession, the instants it moved through the vault and the measured mass, moisture, germination rate and packet tally - published against two physical estates that differ only in the connection each execution context resolves.';
  elements:
  [
    test::easternlighthouse6::domain
  ];
  supportInfo: Combined
  {
    emails:
    [
      'seed-vault-collections-support-group',
      'upland-survey-support-group'
    ];
  };
}
