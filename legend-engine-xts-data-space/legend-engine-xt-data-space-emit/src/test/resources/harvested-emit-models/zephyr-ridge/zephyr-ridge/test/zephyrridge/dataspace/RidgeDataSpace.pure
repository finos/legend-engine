###DataSpace
DataSpace demo::zephyrridge::dataspace::RidgeSoaringDataSpace
{
  executionContexts:
  [
    {
      name: 'current';
      description: 'Current tier - the soaring binding served through the connection whose mapper stage rewrites the logical schema onto the current one.';
      mapping: demo::zephyrridge::mapping::RidgeSoaringMapping;
      defaultRuntime: demo::zephyrridge::runtime::RidgeCurrentRuntime;
    },
    {
      name: 'season';
      description: 'Season tier - the same logical model resolved through the connection whose mapper stage rewrites the logical schema onto the season archive.';
      mapping: demo::zephyrridge::mapping::RidgeSoaringMapping;
      defaultRuntime: demo::zephyrridge::runtime::RidgeSeasonRuntime;
    }
  ];
  defaultExecutionContext: 'current';
  title: 'Zephyr Ridge Soaring Network';
  description: 'Entry point over the ridge soaring network: logged flights carrying the thermal band the mapping cascade resolves, the region and roster detail reached through the posting joins and the inline views, the pilots and gliders reached across the association mappings, and the register endpoint consumers should start from.';
  diagrams:
  [
    {
      title: 'Ridge sites and flights';
      diagram: demo::zephyrridge::diagram::RidgeSiteDiagram;
    },
    {
      title: 'Ridge crew and gliders';
      diagram: demo::zephyrridge::diagram::RidgeCrewDiagram;
    }
  ];
  elements:
  [
    demo::zephyrridge::domain
  ];
  executables:
  [
    {
      id: 1;
      title: 'Ridge flight register';
      description: 'Featured endpoint returning the logged flights launched inside a caller-sized window around an injected date.';
      executable: demo::zephyrridge::service::RidgeFlightRegister;
    }
  ];
}
