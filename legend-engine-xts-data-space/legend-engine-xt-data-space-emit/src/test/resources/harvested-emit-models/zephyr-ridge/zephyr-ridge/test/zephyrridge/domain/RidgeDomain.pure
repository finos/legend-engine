###Pure
import demo::zephyrridge::domain::*;

Enum demo::zephyrridge::domain::WingClass
{
  SINGLE_SEAT,
  TWO_SEAT,
  MOTOR_ASSISTED,
  VINTAGE,
  UNCLASSED
}

Enum demo::zephyrridge::domain::PilotRating
{
  STUDENT,
  SOLO,
  CROSS_COUNTRY,
  INSTRUCTOR,
  UNRATED
}

Class demo::zephyrridge::domain::Region
{
  regionCode: String[1];
  regionName: String[1];
  terrainSide: String[1];
  summary: RegionSummary[0..1];
}

Class demo::zephyrridge::domain::RegionSummary
{
  regionCode: String[1];
  siteCount: Integer[1];
  maxElevationM: Integer[1];
}

Class demo::zephyrridge::domain::LaunchSite
{
  siteCode: String[1];
  siteName: String[1];
  aspectCode: String[1];
  elevationM: Integer[1];
  region: Region[0..1];
  rosterLabel: String[0..1];
  displayName() {$this.siteName->toUpper()->trim()}: String[1];
  highRidge() {$this.elevationM >= 900}: Boolean[1];
}

Class demo::zephyrridge::domain::Glider
{
  gliderCode: String[1];
  wingClass: WingClass[1];
  serviceState: String[1];
  seatCount: Integer[1];
  sharedCockpit() {$this.seatCount >= 2}: Boolean[1];
}

Class demo::zephyrridge::domain::PostalAddress
{
  addressLine: String[1];
  town: String[1];
  postCode: String[1];
}

Class demo::zephyrridge::domain::Pilot
{
  pilotCode: String[1];
  pilotName: String[1];
  rating: PilotRating[1];
  address: PostalAddress[0..1];
  homeRegionName: String[0..1];
  badgeLabel() {$this.pilotCode->toUpper() + '/' + $this.pilotName->toUpper()}: String[1];
}

Class demo::zephyrridge::domain::SoaringFlight
{
  flightRef: String[1];
  launchOn: StrictDate[1];
  landOn: StrictDate[0..1];
  climbScore: Integer[1];
  durationMin: Integer[1];
  thermalBand: String[0..1];
  siteRegionName: String[0..1];
  siteRosterLabel: String[0..1];
  glider: Glider[0..1];
  {meta::pure::profiles::doc.doc = 'Whole days between the launch date and the instant the caller is asking about; negative once the asked-about instant precedes the launch.'} daysBefore(asOf: StrictDate[1]) {dateDiff($this.launchOn, $asOf, DurationUnit.DAYS)}: Integer[1];
}

Class demo::zephyrridge::domain::Beacon
{
  beaconCode: String[1];
  bandCode: String[1];
  activeFlag: String[1];
}

Class demo::zephyrridge::domain::WindReading
{
  readOn: StrictDate[1];
  gustKph: Integer[1];
  veerDeg: Integer[1];
  gustBand: String[0..1];
  readingSiteName: String[0..1];
}

Association demo::zephyrridge::domain::Site_Flights
{
  site: LaunchSite[0..1];
  flights: SoaringFlight[*];
}

Association demo::zephyrridge::domain::Pilot_Flights
{
  pilot: Pilot[0..1];
  pilotFlights: SoaringFlight[*];
}

Association demo::zephyrridge::domain::Site_Beacons
{
  beaconSite: LaunchSite[0..1];
  beacons: Beacon[*];
}
