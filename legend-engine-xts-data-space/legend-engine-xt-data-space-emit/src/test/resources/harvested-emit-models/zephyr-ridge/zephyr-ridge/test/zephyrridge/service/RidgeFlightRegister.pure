###Service
Service demo::zephyrridge::service::RidgeFlightRegister
{
  pattern: '/zephyrridge/v1/ridge-flight-register/{asOf}/{windowDays}';
  title: 'Zephyr Ridge - Ridge Flight Register';
  documentation: 'The logged flight register for the ridge soaring network. The window is arithmetic on an injected date rather than the wall clock, so the register is reproducible: the launch date must sit inside a caller-sized window that opens a given number of days before the injected date and closes the day after it, and the whole-day distance between launch and the injected date must stay inside the retention span. Short hops are dropped, and the caller supplied aspect and region sets each narrow the register only when they are not empty. The survivors are projected with the band the mapping cascade resolved, the region reached through the two-hop posting path, the roster label read off the inline view and the whole-day age resolved by the qualified property, then ordered and capped.';
  autoActivateUpdates: false;
  ownership: DID { identifier: '000000' };
  execution: Single
  {
    query: {asOf: StrictDate[1], windowDays: Integer[1], aspects: String[*], regionNames: String[*]|demo::zephyrridge::domain::SoaringFlight.all()->filter(
      f|($f.launchOn >= $asOf->adjust($windowDays * -1, meta::pure::functions::date::DurationUnit.DAYS)) &&
        ($f.launchOn <= $asOf->adjust(1, meta::pure::functions::date::DurationUnit.DAYS)) &&
        (dateDiff($f.launchOn, $asOf, meta::pure::functions::date::DurationUnit.DAYS) <= 120) &&
        ($f.durationMin >= 45) &&
        ($aspects->isEmpty() || $aspects->contains($f.site->toOne().aspectCode)) &&
        ($regionNames->isEmpty() || $regionNames->contains($f.siteRegionName->toOne()))
    )->project(
      [
        f|$f.flightRef,
        f|$f.siteRegionName->toOne(),
        f|$f.siteRosterLabel->toOne(),
        f|$f.thermalBand,
        f|$f.durationMin,
        f|$f.daysBefore($asOf)
      ],
      [
        'Flight',
        'Region',
        'Roster',
        'Band',
        'Minutes',
        'DaysBefore'
      ]
    )->sort([asc('Flight')])->limit(10)};
    mapping: demo::zephyrridge::mapping::RidgeSoaringMapping;
    runtime: demo::zephyrridge::runtime::RidgeCurrentRuntime;
  }
  testSuites:
  [
    ridgeFlightRegisterSuite:
    {
      data:
      [
        connections:
        [
          ridgeCurrent: Reference
            #{
              demo::zephyrridge::data::RidgeSoaringData
            }#
        ]
      ]
      tests:
      [
        everyClauseRemovesItsOwnFlight:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            asOf = %2026-05-01,
            windowDays = 60,
            aspects = ['NW', 'NE'],
            regionNames = []
          ]
          asserts:
          [
            onlyTheTwoFullyQualifyingFlightsRemain:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Flight":"FL-01","Region":"Northern Escarpment","Roster":"ROSTER-NORTH","Band":"STEADY LIFT","Minutes":124,"DaysBefore":30},{"Flight":"FL-03","Region":"Northern Escarpment","Roster":"ROSTER-NORTH","Band":null,"Minutes":210,"DaysBefore":28}]';
                  }#;
              }#
          ]
        },
        aRegionSetThatMatchesNoPostingEmptiesTheRegister:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            asOf = %2026-05-01,
            windowDays = 60,
            aspects = [],
            regionNames = ['Western Fells']
          ]
          asserts:
          [
            theRegionMembershipClauseRemovesEveryFlight:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
