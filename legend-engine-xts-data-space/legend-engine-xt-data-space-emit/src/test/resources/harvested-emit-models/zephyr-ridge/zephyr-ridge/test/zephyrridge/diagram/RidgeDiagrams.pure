###Diagram
Diagram demo::zephyrridge::diagram::RidgeSiteDiagram
{
  classView launchSite
  {
    class: demo::zephyrridge::domain::LaunchSite;
    position: (40.0, 40.0);
    rectangle: (240.0, 160.0);
  }
  classView region
  {
    class: demo::zephyrridge::domain::Region;
    position: (380.0, 40.0);
    rectangle: (240.0, 120.0);
  }
  classView regionSummary
  {
    class: demo::zephyrridge::domain::RegionSummary;
    position: (380.0, 220.0);
    rectangle: (240.0, 120.0);
  }
  classView soaringFlight
  {
    class: demo::zephyrridge::domain::SoaringFlight;
    position: (40.0, 260.0);
    rectangle: (240.0, 200.0);
  }
  classView beacon
  {
    class: demo::zephyrridge::domain::Beacon;
    position: (40.0, 520.0);
    rectangle: (240.0, 120.0);
  }
  propertyView
  {
    property: demo::zephyrridge::domain::Site_Flights.flights;
    source: launchSite;
    target: soaringFlight;
    points: [(160.0, 120.0), (160.0, 360.0)];
  }
  propertyView
  {
    property: demo::zephyrridge::domain::Site_Beacons.beacons;
    source: launchSite;
    target: beacon;
    points: [(160.0, 120.0), (160.0, 580.0)];
  }
}

###Diagram
Diagram demo::zephyrridge::diagram::RidgeCrewDiagram
{
  classView pilot
  {
    class: demo::zephyrridge::domain::Pilot;
    position: (40.0, 40.0);
    rectangle: (240.0, 180.0);
  }
  classView postalAddress
  {
    class: demo::zephyrridge::domain::PostalAddress;
    position: (380.0, 40.0);
    rectangle: (240.0, 120.0);
  }
  classView glider
  {
    class: demo::zephyrridge::domain::Glider;
    position: (380.0, 240.0);
    rectangle: (240.0, 140.0);
  }
  classView soaringFlight
  {
    class: demo::zephyrridge::domain::SoaringFlight;
    position: (40.0, 280.0);
    rectangle: (240.0, 200.0);
  }
  propertyView
  {
    property: demo::zephyrridge::domain::Pilot_Flights.pilotFlights;
    source: pilot;
    target: soaringFlight;
    points: [(160.0, 130.0), (160.0, 380.0)];
  }
}
