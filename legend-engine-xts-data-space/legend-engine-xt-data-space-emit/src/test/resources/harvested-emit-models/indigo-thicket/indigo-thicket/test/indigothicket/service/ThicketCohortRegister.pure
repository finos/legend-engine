###Service
Service test::indigothicket::service::ThicketCohortRegister
{
  pattern: '/indigothicket/v1/cohort-register/{environment}';
  title: 'Indigo Thicket - Ringing Cohort Register By Environment';
  documentation: 'Narrows the ringing records to the adult first-capture cohort whose ringing instant and later check instant both fall inside the supplied window, using a single conjunction of two boolean equalities and four instant comparisons, and projects the cohort key and the wing band through helper functions the warehouse cannot evaluate, so the projected columns are computed after the rows come back. The environment path segment selects which warehouse runtime plans and runs the identical body.';
  autoActivateUpdates: false;
  ownership: DID { identifier: '000000' };
  execution: Multi
  {
    query: {fromInstant: DateTime[1], toInstant: DateTime[1]|test::indigothicket::domain::RingingRecord.all()->filter(
      r|((((($r.adult == true) && ($r.retrap == false)) && ($r.ringedAt >= $fromInstant)) && ($r.checkedAt >= $fromInstant)) && ($r.ringedAt <= $toInstant)) && ($r.checkedAt <= $toInstant)
    )->project(
      [
        r|test::indigothicket::function::cohortKey($r.site.siteName, $r.speciesCode),
        r|$r.site.siteName,
        r|$r.speciesCode,
        r|test::indigothicket::function::wingBand($r.wingMm),
        r|$r.massG
      ],
      [
        'Cohort',
        'Site',
        'Species',
        'WingBand',
        'MassG'
      ]
    )};
    key: 'environment';
    executions['survey']:
    {
      mapping: test::indigothicket::mapping::ThicketMapping;
      runtime: test::indigothicket::runtime::ThicketSurveyRuntime;
    }
    executions['audit']:
    {
      mapping: test::indigothicket::mapping::ThicketMapping;
      runtime: test::indigothicket::runtime::ThicketAuditRuntime;
    }
  }
  testSuites:
  [
    cohortRegisterSuite:
    {
      data:
      [
        connections:
        [
          thicketWarehouse:
            Relational
            #{
              thicket.ringing_site:
                'site_code,site_name,habitat_code\n'+
                'ST-1,Ridge Thicket,scrub\n'+
                'ST-2,Hollow Coppice,coppice\n';

              thicket.record_sighting:
                'sighting_code,record_code,observer_role,sighting_note\n'+
                'SI-01,RR-02,ringer_trainee,ring read at the feeder\n';

              thicket.ringing_record:
                'record_code,site_code,species_code,wing_mm,mass_g,ringed_at,checked_at,retrap,adult\n'+
                'RR-01,ST-1,wa-blackcap,72,18,2026-02-10 08:00:00.000,2026-02-11 08:00:00.000,false,true\n'+
                'RR-02,ST-1,ti-bluetit,64,11,2026-02-12 08:00:00.000,2026-02-13 08:00:00.000,true,true\n'+
                'RR-03,ST-2,fi-chaffinch,92,24,2026-02-14 08:00:00.000,2026-02-15 08:00:00.000,false,false\n'+
                'RR-04,ST-2,wa-whitethroat,70,16,2026-01-05 08:00:00.000,2026-01-06 08:00:00.000,false,true\n'+
                'RR-05,ST-1,wa-chiffchaff,68,8,2026-02-16 08:00:00.000,2026-02-17 08:00:00.000,true,true\n';
            }#
        ]
      ]
      tests:
      [
        theConjunctionAdmitsOnlyTheAdultFirstCaptureInsideTheWindow:
        {
          serializationFormat: PURE_TDSOBJECT;
          keys: ['survey'];
          parameters:
          [
            fromInstant = %2026-02-01T00:00:00,
            toInstant = %2026-02-28T23:59:59
          ]
          asserts:
          [
            theRetrapTheNonAdultAndTheRecordOutsideTheWindowAreAllRejected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Cohort":"RIDGE THICKET::WARBLER_GUILD","Site":"Ridge Thicket","Species":"WA-BLACKCAP","WingBand":"MEDIUM_WINGED","MassG":18}]';
                  }#;
              }#
          ]
        },
        theEarlierWindowAdmitsOnlyTheRecordWhoseInstantsPrecedeIt:
        {
          serializationFormat: PURE_TDSOBJECT;
          keys: ['audit'];
          parameters:
          [
            fromInstant = %2026-01-01T00:00:00,
            toInstant = %2026-01-31T23:59:59
          ]
          asserts:
          [
            theSameBodyOnTheAuditRuntimeReturnsTheJanuaryCohortRow:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Cohort":"HOLLOW COPPICE::WARBLER_GUILD","Site":"Hollow Coppice","Species":"WA-WHITETHROAT","WingBand":"MEDIUM_WINGED","MassG":16}]';
                  }#;
              }#
          ]
        },
        aWindowThatStartsAfterEveryCheckInstantAdmitsNothing:
        {
          serializationFormat: PURE_TDSOBJECT;
          keys: ['survey'];
          parameters:
          [
            fromInstant = %2026-03-01T00:00:00,
            toInstant = %2026-03-31T23:59:59
          ]
          asserts:
          [
            everyInstantComparisonOfTheConjunctionFails:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
