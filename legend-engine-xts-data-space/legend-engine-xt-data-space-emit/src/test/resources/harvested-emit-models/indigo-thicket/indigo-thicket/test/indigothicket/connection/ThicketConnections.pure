###Connection
RelationalDatabaseConnection test::indigothicket::connection::ThicketSurveyConnection
{
  store: test::indigothicket::store::ThicketDB;
  type: Snowflake;
  quoteIdentifiers: false;
  specification: Snowflake
  {
    name: 'THICKET_DB';
    account: 'thicket_ringing_account';
    warehouse: 'THICKET_SURVEY_WH';
    region: 'eu-west-1';
    cloudType: 'aws';
    accountType: MultiTenant;
    organization: 'thicket_org';
    role: 'THICKET_READER';
  };
  auth: OAuth
  {
    oauthKey: 'thicket_survey_oauth_key';
    scopeName: 'SESSION:ROLE:THICKET_READER';
  };
}

RelationalDatabaseConnection test::indigothicket::connection::ThicketAuditConnection
{
  store: test::indigothicket::store::ThicketDB;
  type: Snowflake;
  quoteIdentifiers: false;
  specification: Snowflake
  {
    name: 'THICKET_DB';
    account: 'thicket_ringing_account';
    warehouse: 'THICKET_AUDIT_WH';
    region: 'eu-west-1';
    cloudType: 'aws';
    accountType: MultiTenant;
    organization: 'thicket_org';
    role: 'THICKET_AUDITOR';
  };
  auth: OAuth
  {
    oauthKey: 'thicket_audit_oauth_key';
    scopeName: 'SESSION:ROLE:THICKET_AUDITOR';
  };
}
