###Relational
Database test::indigothicket::store::ThicketDB
(
  Schema thicket
  (
    Table ringing_site
    (
      site_code VARCHAR(20) PRIMARY KEY,
      site_name VARCHAR(80) NOT NULL,
      habitat_code VARCHAR(20) NOT NULL
    )
    Table ringing_record
    (
      record_code VARCHAR(20) PRIMARY KEY,
      site_code VARCHAR(20) NOT NULL,
      species_code VARCHAR(20) NOT NULL,
      wing_mm INTEGER NOT NULL,
      mass_g INTEGER NOT NULL,
      ringed_at TIMESTAMP NOT NULL,
      checked_at TIMESTAMP NOT NULL,
      retrap BIT NOT NULL,
      adult BIT NOT NULL
    )
    Table record_sighting
    (
      sighting_code VARCHAR(20) PRIMARY KEY,
      record_code VARCHAR(20) NOT NULL,
      observer_role VARCHAR(40) NOT NULL,
      sighting_note VARCHAR(200)
    )
  )

  Join Record_Site(thicket.ringing_record.site_code = thicket.ringing_site.site_code)
  Join Record_Sighting(thicket.ringing_record.record_code = thicket.record_sighting.record_code)
)
