###Pure
import test::indigothicket::domain::*;

Class test::indigothicket::domain::RingingSite
{
  siteCode: String[1];
  siteName: String[1];
  habitatCode: String[1];
}

Class test::indigothicket::domain::RecordSighting
{
  sightingCode: String[1];
  observerRole: String[1];
  sightingNote: String[0..1];
}

Class test::indigothicket::domain::RingingRecord
{
  recordCode: String[1];
  speciesCode: String[1];
  wingMm: Integer[1];
  massG: Integer[1];
  ringedAt: DateTime[1];
  checkedAt: DateTime[1];
  retrap: Boolean[1];
  adult: Boolean[1];
  site: RingingSite[1];
  sightings: RecordSighting[*];

  wingBand()
  {
    test::indigothicket::function::wingBand($this.wingMm)
  }: String[1];

  observerRoster()
  {
    $this.sightings->map(s|$s.observerRole)->removeDuplicates()->sort()->joinStrings('/')
  }: String[1];
}
