###Pure
function test::indigothicket::function::wingBand(wingMm: Integer[1]): String[1]
{
  if($wingMm >= 90, | 'LONG_WINGED', | if($wingMm >= 70, | 'MEDIUM_WINGED', | 'SHORT_WINGED'))
}

function test::indigothicket::function::guildOf(speciesCode: String[1]): String[1]
{
  if($speciesCode->startsWith('WA'), | 'WARBLER_GUILD', | if($speciesCode->startsWith('TI'), | 'TIT_GUILD', | 'OTHER_GUILD'))
}

function test::indigothicket::function::cohortKey(siteName: String[1], speciesCode: String[1]): String[1]
{
  $siteName->toUpper() + '::' + test::indigothicket::function::guildOf($speciesCode)
}
