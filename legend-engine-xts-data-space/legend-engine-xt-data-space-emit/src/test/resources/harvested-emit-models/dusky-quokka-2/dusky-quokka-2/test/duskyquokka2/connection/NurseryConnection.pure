###Connection
RelationalDatabaseConnection test::duskyquokka2::connection::NurseryConnection
{
  store: test::duskyquokka2::store::NurseryDB;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'NURSERY_PROPAGATION_DB';
    account: 'nursery_propagation_account';
    warehouse: 'NURSERY_PROPAGATION_WH';
    region: 'us-east-1';
    cloudType: 'aws';
    role: 'NURSERY_PROPAGATION_ROLE';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'nursery_propagation_reader';
    privateKeyVaultReference: 'nursery-propagation-private-key';
    passPhraseVaultReference: 'nursery-propagation-passphrase';
  };
}
