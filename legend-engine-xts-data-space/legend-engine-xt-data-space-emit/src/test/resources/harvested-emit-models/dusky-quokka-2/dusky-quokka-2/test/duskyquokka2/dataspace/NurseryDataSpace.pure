###DataSpace
DataSpace {meta::pure::profiles::doc.doc = 'Governed entry point over the glasshouse propagation and germination model.'} test::duskyquokka2::dataspace::NurseryDataSpace
{
  executionContexts:
  [
    {
      name: 'propagation';
      description: 'Propagation tier - the nursery relational store used for curation and test execution.';
      mapping: test::duskyquokka2::mapping::NurseryMapping;
      defaultRuntime: test::duskyquokka2::runtime::NurseryRuntime;
    }
  ];
  defaultExecutionContext: 'propagation';
  title: 'Glasshouse Propagation And Germination';
  description: 'A curated entry point over the glasshouse propagation domain - blocks, sown seedling trays, the grower crews looking after them and the germination viability readings - wiring the relational mapping, its runtime, the domain layout and the featured endpoints consumers should start from.';
  diagrams:
  [
    {
      title: 'Glasshouse Propagation Domain';
      diagram: test::duskyquokka2::diagram::NurseryDiagram;
    }
  ];
  elements:
  [
    test::duskyquokka2::domain
  ];
  executables:
  [
    {
      id: 1;
      title: 'Tray register';
      description: 'Featured endpoint returning the labelled tray register for a set of glasshouse zones.';
      executable: test::duskyquokka2::service::TrayRegisterService;
    },
    {
      id: 2;
      title: 'Viability watch';
      description: 'Featured endpoint returning the germination readings at or above a viability threshold.';
      executable: test::duskyquokka2::service::ViabilityWatchService;
    }
  ];
  supportInfo: Email {
    address: 'glasshouse-propagation@example.invalid';
  };
}
