###DataSpace
DataSpace <<test::sunlitridge5::domain::NurseryCatalog.curatedView>> {meta::pure::profiles::doc.doc = 'Governed entry point over the nursery register.', test::sunlitridge5::domain::NurseryCatalog.stewardTeam = 'Nursery Propagation', test::sunlitridge5::domain::NurseryCatalog.taxonomyNode = 'places/nursery/register'} test::sunlitridge5::dataspace::NurseryDataSpace
{
  executionContexts:
  [
    {
      name: 'greenhouse';
      description: 'Greenhouse tier pairing the nursery mapping with the greenhouse runtime.';
      mapping: test::sunlitridge5::mapping::NurseryMapping;
      defaultRuntime: test::sunlitridge5::runtime::NurseryGreenhouseRuntime;
    }
  ];
  defaultExecutionContext: 'greenhouse';
  title: 'Sunlit Nursery Register';
  description: 'Seedling trays, planting beds and the cultivar catalogue of the nursery.';
  elements:
  [
    test::sunlitridge5::domain::SeedlingTray,
    test::sunlitridge5::domain::PlantingBed,
    test::sunlitridge5::domain::Cultivar
  ];
  executables:
  [
    {
      id: 1;
      title: 'Tray roster by species';
      description: 'Trays of the propagated species on a processing date.';
      executable: test::sunlitridge5::service::TrayRosterBySpecies;
    },
    {
      id: 2;
      title: 'Bed roster as of';
      description: 'Planting beds on a processing date.';
      executable: test::sunlitridge5::service::BedRosterAsOf;
    }
  ];
}
