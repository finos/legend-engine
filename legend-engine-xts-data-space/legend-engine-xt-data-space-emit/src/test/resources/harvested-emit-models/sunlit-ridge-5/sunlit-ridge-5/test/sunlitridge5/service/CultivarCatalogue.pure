###Service
Service test::sunlitridge5::service::CultivarCatalogue
{
  pattern: '/sunlitridge5/cultivars';
  title: 'Sunlit Nursery - Cultivar Catalogue';
  ownership: DID { identifier: 'sunlit-nursery-register' };
  documentation: 'Lists every cultivar in the nursery catalogue.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: |test::sunlitridge5::domain::Cultivar.all()->project(
      [
        c|$c.cultivarCode,
        c|$c.commonName,
        c|$c.flowerColour,
        c|$c.hardinessZone
      ],
      [
        'Cultivar',
        'Name',
        'Colour',
        'Zone'
      ]
    );
    mapping: test::sunlitridge5::mapping::NurseryMapping;
    runtime: test::sunlitridge5::runtime::NurseryCatalogueRuntime;
  }
  testSuites:
  [
    cultivarSuite:
    {
      data:
      [
        connections:
        [
          catalogueDb:
            Relational
            #{
              catalogue.cultivar:
                'cultivar_code,common_name,flower_colour,hardiness_zone\n'+
                'CV-SALV-1,Meadow Sage,VIOLET,5\n';
            }#
        ]
      ]
      tests:
      [
        wholeCatalogue:
        {
          serializationFormat: PURE_TDSOBJECT;
          asserts:
          [
            everyCultivarListed:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Cultivar":"CV-SALV-1","Name":"Meadow Sage","Colour":"VIOLET","Zone":5}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
