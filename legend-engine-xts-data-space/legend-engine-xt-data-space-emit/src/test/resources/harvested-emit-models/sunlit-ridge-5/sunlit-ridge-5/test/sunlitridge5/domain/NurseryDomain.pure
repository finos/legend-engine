###Pure
import meta::pure::profiles::*;

Profile test::sunlitridge5::domain::NurseryCatalog
{
  stereotypes: [curatedView];
  tags: [stewardTeam, taxonomyNode];
}

Class <<temporal.processingtemporal>> {doc.doc = 'A tray of seedlings on a greenhouse bench, versioned as it was recorded.'} test::sunlitridge5::domain::SeedlingTray
{
  {doc.doc = 'Code that identifies the tray across its recorded versions.'} trayCode: String[1];
  {doc.doc = 'Species sown in the tray.'} speciesCode: String[1];
  {doc.doc = 'Greenhouse bench the tray sits on.'} benchCode: String[0..1];
  {doc.doc = 'Number of cells in the tray.'} cellCount: Integer[0..1];
  {doc.doc = 'Share of cells that germinated, in percent.'} germinationPct: Float[0..1];
  {doc.doc = 'Day the tray was sown.'} sownOn: StrictDate[0..1];
}

Class <<temporal.processingtemporal>> {doc.doc = 'An outdoor planting bed in the nursery field, versioned as it was recorded.'} test::sunlitridge5::domain::PlantingBed
{
  {doc.doc = 'Code that identifies the bed across its recorded versions.'} bedCode: String[1];
  {doc.doc = 'Kind of soil in the bed.'} soilKind: String[0..1];
  {doc.doc = 'Length of the bed in metres.'} bedLengthM: Float[0..1];
  {doc.doc = 'Number of plants growing in the bed.'} plantCount: Integer[0..1];
  {doc.doc = 'Moment the bed was last mulched.'} lastMulched: DateTime[0..1];
}

Class {doc.doc = 'A cultivar the nursery propagates, as listed in its catalogue.'} test::sunlitridge5::domain::Cultivar
{
  {doc.doc = 'Code of the cultivar.'} cultivarCode: String[1];
  {doc.doc = 'Common name of the cultivar.'} commonName: String[0..1];
  {doc.doc = 'Colour of the flowers.'} flowerColour: String[0..1];
  {doc.doc = 'Hardiness zone the cultivar survives in.'} hardinessZone: Integer[0..1];
}
