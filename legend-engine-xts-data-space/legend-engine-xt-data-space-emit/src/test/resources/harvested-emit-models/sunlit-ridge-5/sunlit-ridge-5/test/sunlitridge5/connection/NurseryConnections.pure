###Connection
RelationalDatabaseConnection test::sunlitridge5::connection::NurseryGreenhouseConnection
{
  store: test::sunlitridge5::store::NurseryDb;
  type: Snowflake;
  specification: Snowflake
  {
    name: 'SUNLIT_NURSERY_DB';
    account: 'sunlit_nursery_acct';
    warehouse: 'SUNLIT_NURSERY_GREENHOUSE_WH';
    region: 'us-east-1';
    cloudType: 'aws';
  };
  auth: SnowflakePublic
  {
    publicUserName: 'SUNLIT_NURSERY_GREENHOUSE_READER';
    privateKeyVaultReference: 'sunlitnursery.greenhouse.privateKey';
    passPhraseVaultReference: 'sunlitnursery.greenhouse.passPhrase';
  };
}

