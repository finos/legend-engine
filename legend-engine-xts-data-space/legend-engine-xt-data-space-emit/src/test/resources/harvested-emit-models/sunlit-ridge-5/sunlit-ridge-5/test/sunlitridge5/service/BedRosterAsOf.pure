###Service
Service test::sunlitridge5::service::BedRosterAsOf
{
  pattern: '/sunlitridge5/beds/{procDate}';
  title: 'Sunlit Nursery - Bed Roster As Of';
  ownership: DID { identifier: 'sunlit-nursery-register' };
  documentation: 'Lists every planting bed as recorded on the processing date.';
  autoActivateUpdates: false;
  execution: Single
  {
    query: {procDate: StrictDate[1]|test::sunlitridge5::domain::PlantingBed.all($procDate)->project(
      [
        b|$b.bedCode,
        b|$b.soilKind,
        b|$b.bedLengthM,
        b|$b.plantCount
      ],
      [
        'Bed',
        'Soil',
        'Length',
        'Plants'
      ]
    )};
    mapping: test::sunlitridge5::mapping::NurseryMapping;
    runtime: test::sunlitridge5::runtime::NurseryFieldRuntime;
  }
  testSuites:
  [
    bedRosterSuite:
    {
      data:
      [
        connections:
        [
          fieldDb:
            Relational
            #{
              field.planting_bed:
                'bed_code,in_z,out_z,soil_kind,bed_length_m,plant_count,last_mulched\n'+
                'BD-01,2026-02-01 00:00:00,9999-12-31 00:00:00,LOAM,12.5,140,2026-02-10 08:00:00\n'+
                'BD-02,2025-11-01 00:00:00,2026-03-01 00:00:00,SAND,8.0,60,2025-11-12 09:30:00\n';
            }#
        ]
      ]
      tests:
      [
        openBedOnly:
        {
          serializationFormat: PURE_TDSOBJECT;
          parameters:
          [
            procDate = %2026-04-01
          ]
          asserts:
          [
            closedBedDropped:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"Bed":"BD-01","Soil":"LOAM","Length":12.5,"Plants":140}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
